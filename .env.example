WEB_HOST_PORT=8090
DB_HOST=host.docker.internal
DB_PORT=1433
# Single physical database. Contexts remain isolated by schema and migration history.
DB_NAME=tesis_unified
DB_USER=sa
DB_PASS=CHANGE_ME
STORAGE_HOST_PATH=C:/sigepFiles-dev
EXTERNAL_APIS_BASE_URL=http://host.docker.internal:3000

# Generate a random signing key of at least 32 characters. Never commit .env.
JWT_KEY=CHANGE_ME_TO_A_RANDOM_KEY_AT_LEAST_32_CHARACTERS
JWT_ISSUER=tesisproject-local
JWT_AUDIENCE=tesisproject-local

API_HOST_PORT=8091

# Initial Unified superadmin: opt in once with real institutional IdAsp.
# Keep credentials only in .env; disable after successful provisioning.
BOOTSTRAP_SUPERADMIN_ENABLED=false
BOOTSTRAP_SUPERADMIN_ASP_USER_ID=
BOOTSTRAP_SUPERADMIN_EMAIL=
BOOTSTRAP_SUPERADMIN_USERNAME=
BOOTSTRAP_SUPERADMIN_PASSWORD=

# Runtime data migrations require both superadmin JWT and this independent secret.
ADMINISTRATIVE_OPERATIONS_ENABLED=false
ADMINISTRATIVE_OPERATIONS_SECRET=
