@using Microsoft.AspNetCore.Components.Routing
@namespace tesisproject.frontend.Layout
<div class="top-row navbar navbar-dark">
    <a class="navbar-brand" href="/">tesisproject.frontend</a>
    <button class="navbar-toggler" @onclick="ToggleNavMenu">
        <span class="navbar-toggler-icon"></span>
    </button>
</div>

<div class="nav-scroll @NavMenuCssClass">
    <nav class="nav flex-column">
        @foreach (var group in GroupedItems)
        {
            if (!string.IsNullOrWhiteSpace(group.Key))
            {
                <div class="nav-section">@group.Key</div>
            }

            @foreach (var item in group)
            {
                <NavLink class="nav-link"
                         href="@item.Href"
                         Match="@(item.Exact ? NavLinkMatch.All : NavLinkMatch.Prefix)">
                    @item.Text
                </NavLink>
            }
        }
    </nav>
</div>
