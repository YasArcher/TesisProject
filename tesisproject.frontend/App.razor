@using Microsoft.AspNetCore.Components.Authorization
@using tesisproject.frontend.Features.Auth.Components

<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData"
                                DefaultLayout="@(typeof(tesisproject.frontend.Layout.MainLayout))">
                <NotAuthorized>
                    <LayoutView Layout="@(typeof(tesisproject.frontend.Layout.AuthLayout))">
                        <AuthAccessGate />
                    </LayoutView>
                </NotAuthorized>
            </AuthorizeRouteView>
        </Found>

        <NotFound>
            <LayoutView Layout="@(typeof(tesisproject.frontend.Layout.MainLayout))">
                <p>Página no encontrada</p>
                <a href="/">Ir al sistema</a>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>
