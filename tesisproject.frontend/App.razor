@using Microsoft.AspNetCore.Components.Authorization
@using tesisproject.frontend.Features.Auth

<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <RouteView RouteData="@routeData"
                       DefaultLayout="@(typeof(tesisproject.frontend.Features.Management.Layout.MainLayout))" />
        </Found>

        <NotFound>
            <LayoutView Layout="@(typeof(tesisproject.frontend.Features.Management.Layout.MainLayout))">
                <p>Página no encontrada</p>
                <a href="/panel/principal">Ir al sistema</a>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>
