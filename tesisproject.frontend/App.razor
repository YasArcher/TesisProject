@using Microsoft.AspNetCore.Components.Authorization
@using tesisproject.frontend.Features.Auth

<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData"
                                DefaultLayout="@(typeof(tesisproject.frontend.Features.Management.Layout.MainLayout))">
                <NotAuthorized>
                    <RedirectToLogin />
                </NotAuthorized>
                <Authorizing>
                    <p>Verificando credenciales...</p>
                </Authorizing>
            </AuthorizeRouteView>
        </Found>

        <NotFound>
            <LayoutView Layout="@(typeof(tesisproject.frontend.Features.Management.Layout.MainLayout))">
                <p>Página no encontrada</p>
                <a href="/login">Ir a Login</a>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>
