@typeparam TItem
<div class="relative h-full min-h-0">
    <div class="bg-background border border-border rounded-xl shadow-lg shadow-[color-mix(in_srgb,var(--color-foreground)_10%,transparent)] overflow-hidden flex flex-col h-full min-h-0"
         style="@GetContainerStyle()">

        @if (Items is not null && Items.Any())
        {
            @if (ShowItemCount || !string.IsNullOrEmpty(Title))
            {
                <div class="px-6 py-4 bg-primary-subtle border-b border-border flex-shrink-0">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            @if (HeaderIcon is not null)
                            {
                                <span class="inline-flex items-center justify-center text-muted">
                                    @HeaderIcon
                                </span>
                            }

                            @if (!string.IsNullOrEmpty(Title))
                            {
                                <h3 class="text-sm font-semibold text-foreground">
                                    @Title
                                </h3>
                            }
                        </div>

                        @if (ShowItemCount)
                        {
                            var count = TotalCount ?? Items.Count();

                            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-primary-subtle text-foreground">
                                @count @(count == 1 ? "elemento" : "elementos")
                            </span>
                        }
                    </div>
                </div>
            }

            <div class="@GetScrollClasses() flex-1 min-h-0">
                <div class="p-4 sm:p-6">
                    <div class="@GridClasses">
                        @foreach (var item in Items)
                        {
                            <div class="transform transition-all duration-200 hover:scale-[1.02] hover:shadow-md rounded-lg">
                                @ChildContent(item)
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="flex flex-col items-center justify-center py-16 px-6 flex-1 min-h-0">
                <div class="w-16 h-16 mb-4 text-muted">
                    @if (EmptyStateIcon is not null)
                    {
                        @EmptyStateIcon
                    }
                    else
                    {
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-full h-full">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                                  d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                        </svg>
                    }
                </div>
                <h3 class="text-lg font-medium text-foreground mb-2">
                    @EmptyStateTitle
                </h3>
                <p class="text-sm text-muted text-center max-w-sm mb-6">
                    @EmptyStateDescription
                </p>
                @if (EmptyStateAction is not null)
                {
                    <div class="flex gap-3">
                        @EmptyStateAction
                    </div>
                }
            </div>
        }
    </div>

    @if (IsLoading)
    {
        <div class="absolute inset-0 bg-background/80 backdrop-blur-sm rounded-xl flex items-center justify-center z-10">
            <div class="flex items-center space-x-3">
                <div class="animate-spin rounded-full h-6 w-6 border-2 border-primary border-t-transparent"></div>
                <span class="text-sm font-medium text-foreground">Cargando...</span>
            </div>
        </div>
    }
</div>