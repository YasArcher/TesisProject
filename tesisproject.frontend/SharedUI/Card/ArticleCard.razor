@namespace tesisproject.frontend.SharedUI.Card
@using tesisproject.shared.DTOs.Articles
@using tesisproject.frontend.SharedUI

<div class="rounded-2xl border border-slate-200 bg-white shadow-sm p-4 flex flex-col gap-2">
    <div class="flex items-start justify-between gap-2">
        <div>
            <h3 class="text-sm font-semibold text-slate-900 line-clamp-2">@Article.Title</h3>
            <p class="text-[11px] text-slate-500 line-clamp-1">@Article.VenueName</p>
        </div>

        <Badge Text="@Article.PublicationStatusName"
               Variant="@(Article.PublicationStatusName == "Publicado" ? BadgeVariant.Success : BadgeVariant.Neutral)">
        </Badge>
    </div>

    @if (!string.IsNullOrWhiteSpace(Article.AuthorsSummary))
    {
        <p class="text-xs text-slate-500 line-clamp-2">
            @Article.AuthorsSummary
        </p>
    }

    <div class="flex justify-between items-center mt-2 text-[11px] text-slate-400">
        @if (!string.IsNullOrWhiteSpace(Article.ResearchLineName))
        {
            <span>@Article.ResearchLineName</span>
        }
        <span>@(Article.PublicationYear?.ToString() ?? "-")</span>
    </div>

    <div class="mt-3 flex justify-end">
        <ActionButton Text="Ver más"
                      Size="sm"
                      Variant="ButtonVariant.Outline"
                      Intent="ButtonIntent.Primary"
                      Icon="hero-eye"
                      OnClick="OnViewMore" />
    </div>
</div>

@code {
    [Parameter] public ArticleListItemDto Article { get; set; } = default!;
    [Parameter] public EventCallback OnViewMore { get; set; }
}
