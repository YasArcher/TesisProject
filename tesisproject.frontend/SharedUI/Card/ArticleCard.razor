@using tesisproject.shared.DTOs.Articles
@namespace tesisproject.frontend.SharedUI.Card

@if (Item is not null)
{
    <article class="@RootClasses" @onclick="HandleClick">
        <!-- Línea superior de estado -->
        <div class="@StatusBarClasses"></div>

        <div class="p-4 space-y-3">
            <!-- Estado + año -->
            <div class="flex items-center justify-between gap-2">
                <span class="@StatusPillClasses">
                    @DisplayStatus
                </span>

                @if (Item.Year.HasValue)
                {
                    <span class="text-[11px] font-semibold text-[#213635] bg-[#f2f2f2] px-2 py-0.5 rounded-full border border-[#d4d4d4]">
                        @Item.Year
                    </span>
                }
            </div>

            <!-- Título -->
            <div>
                <h3 class="text-[13px] font-semibold text-[#0a0c0d] leading-snug line-clamp-2">
                    @Item.Title
                </h3>
                @if (!string.IsNullOrWhiteSpace(Item.VenueName))
                {
                    <p class="mt-0.5 text-[11px] text-slate-500 line-clamp-1">
                        @Item.VenueName
                    </p>
                }
            </div>

            <!-- DOI + ISSN + Período -->
            <div class="grid grid-cols-1 gap-1.5 text-[11px]">
                @if (!string.IsNullOrWhiteSpace(Item.Doi))
                {
                    <div class="flex items-center gap-1 text-[#1c5052]">
                        <span class="inline-flex h-4 w-4 items-center justify-center rounded-full bg-[#348e91]/10 text-[10px] font-bold text-[#0a0c0d]">
                            D
                        </span>
                        <span class="truncate">DOI: @Item.Doi</span>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Item.Issn))
                {
                    <div class="flex items-center gap-1 text-[#4d1a1a]">
                        <span class="inline-flex h-4 w-4 items-center justify-center rounded-full bg-[#4d1a1a]/10 text-[10px] font-bold text-[#4d1a1a]">
                            I
                        </span>
                        <span class="truncate">ISSN: @Item.Issn</span>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Item.AcademicTermName))
                {
                    <div class="flex items-center gap-1 text-[#213635]">
                        <span class="inline-flex h-4 w-4 items-center justify-center rounded-full bg-[#213635]/10 text-[10px] font-bold text-[#213635]">
                            P
                        </span>
                        <span class="truncate">@Item.AcademicTermName</span>
                    </div>
                }
            </div>

            <!-- Resumen súper corto (opcional) -->
            @if (!string.IsNullOrWhiteSpace(Item.Abstract))
            {
                <p class="text-[11px] text-slate-500 line-clamp-3 leading-snug">
                    @Item.Abstract
                </p>
            }

            <!-- Footer -->
            <div class="mt-1 flex items-center justify-between">
                <div class="flex flex-wrap items-center gap-2 text-[10px]">
                    @if (Item.IsOpenAccess)
                    {
                        <span class="inline-flex items-center gap-1 rounded-full bg-emerald-50 px-2 py-0.5 font-medium text-emerald-700 border border-emerald-100">
                            <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
                            Open access
                        </span>
                    }

                    @if (Item.IsProjectResult)
                    {
                        <span class="inline-flex items-center gap-1 rounded-full bg-[#348e91]/10 px-2 py-0.5 font-medium text-[#1c5052] border border-[#348e91]/30">
                            Proyecto
                        </span>
                    }
                </div>

                <button type="button"
                        class="inline-flex items-center gap-1 rounded-full bg-[#348e91] px-3 py-1 text-[11px] font-semibold text-white shadow-sm hover:bg-[#1c5052] focus:outline-none focus:ring-2 focus:ring-[#348e91]/50"
                        @onclick:stopPropagation="true"
                        @onclick="HandleClick">
                    Ver más
                </button>
            </div>
        </div>
    </article>
}

@code {
    [Parameter] public ArticleListItemDto Item { get; set; } = default!;
    [Parameter] public EventCallback<ArticleListItemDto> OnViewMore { get; set; }

    private string StatusKey => (Item?.PublicationStatusName ?? string.Empty).Trim().ToUpperInvariant();

    private string DisplayStatus => StatusKey switch
    {
        "PUBLICADO" => "Publicado",
        "ACEPTADO" => "Aceptado",
        _ => "Sin estado"
    };

    // Fondo principal de la card: gris institucional + bordes suaves + acento teal
    private string RootClasses =>
        "group cursor-pointer rounded-2xl border border-[#d4d4d4] bg-[#f2f2f2] " +
        "shadow-sm hover:shadow-md transition overflow-hidden " +
        "ring-1 ring-transparent hover:ring-[#348e91]/60";

    // Barra superior con degradados por estado
    private string StatusBarClasses => StatusKey switch
    {
        "PUBLICADO" => "h-1.5 bg-gradient-to-r from-[#4d1a1a] via-[#800909] to-[#4d1a1a]",
        "ACEPTADO" => "h-1.5 bg-gradient-to-r from-[#1c5052] via-[#348e91] to-[#1c5052]",
        _ => "h-1.5 bg-gradient-to-r from-[#213635] via-[#4d1a1a]/70 to-[#213635]"
    };

    // Píldora de estado
    private string StatusPillClasses => StatusKey switch
    {
        "PUBLICADO" =>
            "inline-flex items-center gap-1 rounded-full bg-[#4d1a1a]/10 px-2 py-0.5 text-[11px] font-semibold text-[#4d1a1a]",
        "ACEPTADO" =>
            "inline-flex items-center gap-1 rounded-full bg-[#348e91]/10 px-2 py-0.5 text-[11px] font-semibold text-[#1c5052]",
        _ =>
            "inline-flex items-center gap-1 rounded-full bg-[#213635]/10 px-2 py-0.5 text-[11px] font-semibold text-[#213635]"
    };

    private async Task HandleClick()
    {
        if (OnViewMore.HasDelegate)
        {
            await OnViewMore.InvokeAsync(Item);
        }
    }
}
