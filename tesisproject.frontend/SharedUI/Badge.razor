@namespace tesisproject.frontend.SharedUI

<span class="@Css">@ChildContent</span>

@code {
    [Parameter] public string Tipo { get; set; } = "muted"; // primary|success|danger|muted
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string Css => Tipo switch
    {
        "primary" => "inline-flex items-center rounded-full px-2.5 py-1 text-xs bg-indigo-600/20 text-indigo-300 border border-indigo-700/40",
        "success" => "inline-flex items-center rounded-full px-2.5 py-1 text-xs bg-emerald-600/20 text-emerald-300 border border-emerald-700/40",
        "danger" => "inline-flex items-center rounded-full px-2.5 py-1 text-xs bg-rose-600/20 text-rose-200 border border-rose-700/40",
        _ => "inline-flex items-center rounded-full px-2.5 py-1 text-xs bg-slate-800 text-slate-300 border border-slate-700"
    };
}
