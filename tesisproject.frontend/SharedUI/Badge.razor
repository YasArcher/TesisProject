@namespace tesisproject.frontend.SharedUI
@using tesisproject.frontend.SharedUI

<span class="@CssClasses">
    @Text
</span>

@code {
    [Parameter] public string Text { get; set; } = string.Empty;
    [Parameter] public BadgeVariant Variant { get; set; } = BadgeVariant.Neutral;

    private string CssClasses =>
        Variant switch
        {
            BadgeVariant.Success =>
                "inline-flex items-center rounded-full bg-emerald-100 text-emerald-700 px-2 py-0.5 text-xs",
            BadgeVariant.Danger =>
                "inline-flex items-center rounded-full bg-red-100 text-red-700 px-2 py-0.5 text-xs",
            BadgeVariant.Warning =>
                "inline-flex items-center rounded-full bg-amber-100 text-amber-700 px-2 py-0.5 text-xs",
            BadgeVariant.NeutralSoft =>
                "inline-flex items-center rounded-full bg-slate-100 text-slate-700 px-2 py-0.5 text-xs",
            _ =>
                "inline-flex items-center rounded-full bg-slate-200 text-slate-700 px-2 py-0.5 text-xs",
        };
}
