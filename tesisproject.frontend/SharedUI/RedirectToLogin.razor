@namespace tesisproject.frontend.SharedUI
@code {
    [Inject] NavigationManager Nav { get; set; } = default!;
    [Inject] AuthenticationStateProvider AuthStateProvider { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        var target = state.User.Identity?.IsAuthenticated == true
            ? ResolveHome(state.User)
            : "/login";

        Nav.NavigateTo(target, forceLoad: true);
    }

    private static string ResolveHome(System.Security.Claims.ClaimsPrincipal user)
    {
        if (user.IsInRole("Admin") || user.IsInRole("Analyst") || user.IsInRole("WorkflowReviewerUodide")
            || user.IsInRole("WorkflowReviewerAreaTecnica") || user.IsInRole("WorkflowProcessorAreaTecnica")
            || user.IsInRole("ReportingViewer") || user.IsInRole("ReportingExporter")
            || user.IsInRole("ReportingAdvancedUser") || user.IsInRole("IntelligenceViewer")
            || user.IsInRole("IntelligenceTrainer"))
        {
            return "/panel/principal";
        }

        if (user.IsInRole("Author") || user.IsInRole("ArticleRegistrationUser") || user.IsInRole("WorkflowTrackingUser"))
        {
            return "/management/author-workspace";
        }

        return user.IsInRole("ExternalApiUser") ? "/management/externalapis" : "/perfilview";
    }
}
