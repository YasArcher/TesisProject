@using Microsoft.AspNetCore.Components
@using System.Linq
@using tesisproject.frontend.SharedUI.ActionButton
@using tesisproject.frontend.SharedUI.SearchInput
@using tesisproject.frontend.SharedUI.SelectInput
@using tesisproject.frontend.SharedUI.DateInput
@using tesisproject.frontend.SharedUI.TextInput


@* ============================================================
   FilterBar (Presentational Only)
   - Pure UI component. Receives all data via Config.
   - No service injections. No API calls inside.
   - Emits a normalized FilterQuery to parent via OnApply.
   - Parent is responsible for fetching options/data and mapping results.
   Supported controls: search, select, multiselect, daterange, numberrange, boolean
   ============================================================ *@

<div class="relative w-full">
    <!-- Header: Search + Actions (siempre visible) -->
    <div class="w-full bg-background border border-border rounded-xl p-3 md:p-4">
        <div class="flex flex-col md:flex-row md:items-center gap-3 md:gap-4">
            <div class="flex-1 min-w-0">
                <SearchInput Value="@_search"
                             ValueChanged="OnSearchChanged"
                             Placeholder="@GetSearchPlaceholder()"
                             DebounceMs="@GetDebounceMs()"
                             Class="w-full" />
            </div>
            <div class="flex items-center gap-2">
                <!-- Toggle filtros -->
                <ActionButton Text="Filtros"
                              Execute="ToggleExpanded"
                              Intent="ButtonIntent.Info"
                              Variant="@(_expanded ? ButtonVariant.Soft : ButtonVariant.Outline)"
                              Size="ButtonSize.Sm"
                              Class="px-3 py-2 rounded-lg flex items-center gap-2">

                    <Icon>
                        <svg class="w-4 h-4 transition-transform @(_expanded ? "rotate-180" : "")"
                             fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M19 9l-7 7-7-7" />
                        </svg>
                    </Icon>
                </ActionButton>

            </div>
        </div>
    </div>
    <!-- Filters Dropdown - Positioned absolutely -->
    @if (_expanded)
    {
        <div class="absolute top-full left-0 right-0 z-50 mt-2 bg-background border border-border rounded-xl shadow-xl backdrop-blur-sm"
             style="max-height: 28rem; overflow-y: auto;"
             @onmousedown:preventDefault="true"
             @onclick:stopPropagation="true">

            <div class="p-4">
                @* ZONA FILTROS (con groups) *@
                @if (Config?.Items is not null && Config.Items.Count > 0)
                {
                    var groupedItems = Config.Items
                    .GroupBy(i => i.GroupKey ?? "default")
                    .ToList();

                    @foreach (var group in groupedItems)
                    {
                        var first = group.First();
                        var hasGroupLabel = !string.IsNullOrWhiteSpace(first.GroupLabel);

                        <div class="mb-4 border border-border rounded-xl p-3 bg-page-bg/40">
                            @if (hasGroupLabel)
                            {
                                <div class="flex items-center justify-between mb-3">
                                    <h4 class="text-xs font-semibold text-muted uppercase tracking-wide">
                                        @first.GroupLabel
                                    </h4>
                                </div>
                            }

                            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3 md:gap-4">
                                @foreach (var item in group)
                                {
                                    <div class="space-y-1">
                                        <label class="text-xs font-medium text-muted">@item.Label</label>
                                        @RenderFilterControl(item)
                                        @if (!string.IsNullOrWhiteSpace(item.HelpText))
                                        {
                                            <div class="text-xs text-muted">@item.HelpText</div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }

                @* ZONA CHIPS + BOTONES *@
                <div class="border-t border-border pt-4 mt-3">
                    @if (Config?.ShowChips == true && _activeChips.Count > 0)
                    {
                        <div class="text-xs font-medium text-muted mb-2">Filtros activos:</div>
                    }

                    <div class="flex flex-wrap items-center justify-between gap-2">
                        <div class="flex flex-wrap gap-2">
                            @if (Config?.ShowChips == true && _activeChips.Count > 0)
                            {
                                @foreach (var chip in _activeChips)
                                {
                                    <span class="inline-flex items-center gap-2 px-2 py-1 text-xs rounded-full border border-border bg-primary-subtle">
                                        <span class="font-medium">@chip.Label:</span>
                                        <span>@chip.Value</span>
                                        <button class="text-muted hover:text-foreground"
                                                @onclick="() => RemoveChip(chip.Key)"
                                                @onclick:stopPropagation="true">
                                            ×
                                        </button>
                                    </span>
                                }
                            }
                        </div>

                        <div class="flex items-center gap-2">
                            <ActionButton Text="Limpiar"
                                          Execute="ClearAll"
                                          Intent="ButtonIntent.Neutral"
                                          Variant="ButtonVariant.Outline"
                                          Size="ButtonSize.Sm"
                                          Class="px-3 py-2 rounded-lg" />
                            <ActionButton Text="Aplicar"
                                          Execute="Apply"
                                          Intent="ButtonIntent.Accept"
                                          Variant="ButtonVariant.Filled"
                                          Size="ButtonSize.Sm"
                                          Class="px-3 py-2 rounded-lg" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Backdrop to close filters when clicking outside -->
    @if (_expanded)
    {
        <div class="fixed inset-0 z-40" @onclick="CloseFilters" @onclick:preventDefault="false"></div>
    }
</div>

@code {
    // ===================== Public API =====================
    [Parameter] public FilterBarConfig? Config { get; set; }
    [Parameter] public EventCallback<FilterQuery> OnApply { get; set; }
    [Parameter] public EventCallback OnClear { get; set; }
    [Parameter] public EventCallback<string?> OnSearchInstant { get; set; }

    // ===================== Internal State =====================
    private bool _expanded = false;
    private string _search = string.Empty;
    private readonly Dictionary<string, object?> _values = new();
    private readonly List<ChipItem> _activeChips = new();

    private bool IsResearchFilter(FilterItemDescriptor item)
    => item.Key.StartsWith("researchType_", StringComparison.OrdinalIgnoreCase);

    private bool IsSameResearchGroup(FilterItemDescriptor a, FilterItemDescriptor b)
    => IsResearchFilter(a)
       && IsResearchFilter(b)
       && string.Equals(a.GroupKey, b.GroupKey, StringComparison.Ordinal);



    protected override void OnInitialized()
    {
        if (Config is null) return;
        foreach (var it in Config.Items)
        {
            if (!_values.ContainsKey(it.Key)) _values[it.Key] = it.DefaultValue;
        }
        BuildChips();
    }

    private async Task OnSearchChanged(string s)
    {
        _search = s ?? string.Empty;

        // emite al padre inmediatamente y SIN tocar los demás filtros
        if (OnSearchInstant.HasDelegate)
            await OnSearchInstant.InvokeAsync(_search);
    }

    private void ToggleExpanded() => _expanded = !_expanded;

    private void CloseFilters() => _expanded = false;

    private async Task Apply()
    {
        try
        {
            var query = BuildQuery();

            // Aplicar filtros PRIMERO
            await OnApply.InvokeAsync(query);

            // Cerrar el dropdown DESPUÉS de aplicar filtros exitosamente
            _expanded = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error applying filters: {ex.Message}");
            // En caso de error, aún cerrar el dropdown
            _expanded = false;
            StateHasChanged();
        }
    }

    private async Task ClearAll()
    {
        _search = string.Empty;
        _values.Clear();
        _activeChips.Clear();
        if (Config is not null)
        {
            foreach (var it in Config.Items) _values[it.Key] = it.DefaultValue;
        }


        // notifica que el search queda vacío para que el padre refresque al instante
        if (OnSearchInstant.HasDelegate)
            await OnSearchInstant.InvokeAsync(_search);

        await OnClear.InvokeAsync();
        StateHasChanged();
    }

    private void RemoveChip(string key)
    {
        // 👇 Chips combinados de categorías de investigación, por grupo
        const string researchPrefix = "researchCategories_";

        if (key.StartsWith(researchPrefix, StringComparison.Ordinal))
        {
            var groupKey = key[researchPrefix.Length..]; // ej: "1", "2", "campos"

            if (Config?.Items is not null)
            {
                foreach (var it in Config.Items
                         .Where(i => i.EntityField == "ResearchCategoryId" &&
                                     string.Equals(i.GroupKey, groupKey, StringComparison.Ordinal)))
                {
                    if (_values.ContainsKey(it.Key))
                        _values[it.Key] = null;
                }
            }
        }
        else if (_values.ContainsKey(key))
        {
            _values[key] = null;
        }

        BuildChips();
        StateHasChanged();
    }



    // Helper methods for complex expressions
    private string GetSearchPlaceholder()
    {
        return Config?.SearchPlaceholder ?? "Search…";
    }

    private int GetDebounceMs()
    {
        return Config?.DebounceMs ?? 100;
    }

    private RenderFragment RenderFilterControl(FilterItemDescriptor item) => builder =>
    {
        var seq = 0;
        var type = (item.Type ?? "").ToLowerInvariant();
        _values.TryGetValue(item.Key, out var current);

        switch (type)
        {
            case "select":
                {
                    var options = item.Options ?? new List<OptionItem>();

                    // 🔹 Si es un filtro de categorías de investigación, filtramos según el padre
                    if (IsResearchFilter(item))
                    {
                        options = GetHierarchicalOptions(item, options);
                    }

                    // valor actual guardado en _values (string)
                    var currentValue = current as string ?? string.Empty;
                    var selectedOption = options.FirstOrDefault(o => o.Value == currentValue);

                    var selectType = typeof(SelectInput<OptionItem>);
                    builder.OpenComponent(seq++, selectType);
                    builder.AddAttribute(seq++, "Items", options);
                    builder.AddAttribute(seq++, "Value", selectedOption);
                    builder.AddAttribute(seq++, "ValueChanged",
                        EventCallback.Factory.Create<OptionItem?>(this, (OptionItem? opt) =>
                        {
                            _values[item.Key] = opt?.Value;

                            // 🔹 lógica jerárquica (padres + limpiar hijos)
                            if (IsResearchFilter(item))
                            {
                                HandleResearchSelectionChange(item, opt);
                            }

                            BuildChips();
                        }));
                    builder.AddAttribute(seq++, "GetText", (Func<OptionItem, string>)(o => o.Label ?? o.Value ?? string.Empty));
                    builder.AddAttribute(seq++, "GetKey", (Func<OptionItem, string>)(o => o.Value ?? string.Empty));
                    builder.AddAttribute(seq++, "Placeholder", item.Placeholder ?? "Select…");
                    builder.AddAttribute(seq++, "AllowClear", true);
                    builder.AddAttribute(seq++, "Size", SelectSize.Sm);
                    builder.CloseComponent();
                    break;
                }



            case "multiselect":
                builder.OpenElement(seq++, "select");
                builder.AddAttribute(seq++, "multiple", true);
                builder.AddAttribute(seq++, "class", "w-full px-3 py-2 rounded-lg border border-border bg-background");
                var selected = current as List<string> ?? new();
                builder.AddAttribute(seq++, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, e =>
                {
                    var v = e.Value?.ToString();
                    if (!string.IsNullOrWhiteSpace(v))
                    {
                        if (!selected.Contains(v)) selected.Add(v);
                        _values[item.Key] = selected;
                        BuildChips();
                    }
                }));
                if (item.Options is not null)
                {
                    foreach (var opt in item.Options)
                    {
                        builder.OpenElement(seq++, "option");
                        builder.AddAttribute(seq++, "value", opt.Value);
                        if (selected.Contains(opt.Value)) builder.AddAttribute(seq++, "selected", true);
                        builder.AddContent(seq++, opt.Label);
                        builder.CloseElement();
                    }
                }
                builder.CloseElement();
                break;

            case "daterange":
                {
                    // valor actual: string?[] { from, to } como ya lo usabas
                    string?[] range;
                    if (current is string?[] arr && arr.Length == 2)
                        range = arr;
                    else
                        range = new string?[2];

                    var fromStr = range[0];
                    var toStr = range[1];

                    DateOnly? fromDate = ParseDate(fromStr);
                    DateOnly? toDate = ParseDate(toStr);

                    builder.OpenElement(seq++, "div");
                    builder.AddAttribute(seq++, "class", "flex items-center gap-2");

                    // FROM
                    builder.OpenComponent(seq++, typeof(DateInput));
                    builder.AddAttribute(seq++, "Label", (string?)null); // ya tienes label fuera
                    builder.AddAttribute(seq++, "Value", fromDate);
                    builder.AddAttribute(seq++, "ValueChanged",
                        EventCallback.Factory.Create<DateOnly?>(this, async (DateOnly? newVal) =>
                        {
                            range[0] = newVal?.ToString("yyyy-MM-dd");
                            _values[item.Key] = range;
                            BuildChips();
                            await InvokeAsync(StateHasChanged);
                        }));
                    builder.AddAttribute(seq++, "Disabled", false);
                    builder.AddAttribute(seq++, "Required", false);
                    builder.CloseComponent();

                    // TO
                    builder.OpenComponent(seq++, typeof(DateInput));
                    builder.AddAttribute(seq++, "Label", (string?)null);
                    builder.AddAttribute(seq++, "Value", toDate);
                    builder.AddAttribute(seq++, "ValueChanged",
                        EventCallback.Factory.Create<DateOnly?>(this, async (DateOnly? newVal) =>
                        {
                            range[1] = newVal?.ToString("yyyy-MM-dd");
                            _values[item.Key] = range;
                            BuildChips();
                            await InvokeAsync(StateHasChanged);
                        }));
                    builder.AddAttribute(seq++, "Disabled", false);
                    builder.AddAttribute(seq++, "Required", false);
                    builder.CloseComponent();

                    builder.CloseElement(); // div
                    break;
                }

            case "numberrange":
                {
                    // Mantener el mismo modelo interno: string?[] { min, max }
                    string?[] range;
                    if (current is string?[] arr && arr.Length == 2)
                        range = arr;
                    else
                        range = new string?[2];

                    var minStr = range[0] ?? string.Empty;
                    var maxStr = range[1] ?? string.Empty;

                    builder.OpenElement(seq++, "div");
                    builder.AddAttribute(seq++, "class", "flex items-center gap-2");

                    // MIN
                    builder.OpenComponent(seq++, typeof(TextInput<string>));
                    builder.AddAttribute(seq++, "Label", (string?)null);
                    builder.AddAttribute(seq++, "Value", minStr);
                    builder.AddAttribute(seq++, "ValueChanged",
                        EventCallback.Factory.Create<string?>(this, async (string? newVal) =>
                        {
                            range[0] = newVal;
                            _values[item.Key] = range;
                            BuildChips();
                            await InvokeAsync(StateHasChanged);
                        }));
                    builder.AddAttribute(seq++, "InputType", "number");
                    builder.AddAttribute(seq++, "Placeholder", "Mín");
                    builder.AddAttribute(seq++, "Disabled", false);
                    builder.AddAttribute(seq++, "Required", false);
                    builder.CloseComponent();

                    // MAX
                    builder.OpenComponent(seq++, typeof(TextInput<string>));
                    builder.AddAttribute(seq++, "Label", (string?)null);
                    builder.AddAttribute(seq++, "Value", maxStr);
                    builder.AddAttribute(seq++, "ValueChanged",
                        EventCallback.Factory.Create<string?>(this, async (string? newVal) =>
                        {
                            range[1] = newVal;
                            _values[item.Key] = range;
                            BuildChips();
                            await InvokeAsync(StateHasChanged);
                        }));
                    builder.AddAttribute(seq++, "InputType", "number");
                    builder.AddAttribute(seq++, "Placeholder", "Máx");
                    builder.AddAttribute(seq++, "Disabled", false);
                    builder.AddAttribute(seq++, "Required", false);
                    builder.CloseComponent();

                    builder.CloseElement(); // div
                    break;
                }

            case "boolean":
                var isChecked = false;
                if (current is bool b) isChecked = b;
                builder.OpenElement(seq++, "label");
                builder.AddAttribute(seq++, "class", "inline-flex items-center gap-2 select-none");
                builder.OpenElement(seq++, "input");
                builder.AddAttribute(seq++, "type", "checkbox");
                builder.AddAttribute(seq++, "class", "w-4 h-4 rounded border border-border");
                builder.AddAttribute(seq++, "checked", isChecked);
                builder.AddAttribute(seq++, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, e =>
                {
                    _values[item.Key] = e.Value?.ToString()?.ToLowerInvariant() == "true";
                    BuildChips();
                }));
                builder.CloseElement();
                builder.AddContent(seq++, item.Placeholder ?? "Enabled");
                builder.CloseElement();
                break;

            default:
                builder.OpenElement(seq++, "div");
                builder.AddAttribute(seq++, "class", "text-xs text-muted");
                builder.AddContent(seq++, "Unsupported filter type: " + item.Type);
                builder.CloseElement();
                break;
        }
    };

    private static DateOnly? ParseDate(string? s)
    {
        if (string.IsNullOrWhiteSpace(s)) return null;
        return DateOnly.TryParse(s, out var d) ? d : null;
    }

    private static string? GetRangePart(object? val, int index)
    {
        if (val is string s) return s;
        if (val is string?[] arr && arr.Length > index) return arr[index];
        if (val is List<string?> list && list.Count > index) return list[index];
        return null;
    }

    private FilterQuery BuildQuery()
    {
        var q = new FilterQuery
        {
            Search = string.IsNullOrWhiteSpace(_search) ? null : _search,
            Sort = Config?.DefaultSort is not null ? new List<SortRule> { Config.DefaultSort } : null,
            Filters = new()
        };

        if (Config?.Items is null) return q;

        foreach (var it in Config.Items)
        {
            if (string.IsNullOrWhiteSpace(it.EntityField)) continue;
            if (!_values.TryGetValue(it.Key, out var val) || val is null) continue;

            var op = it.Operators?.FirstOrDefault() ?? InferDefaultOperator(it.Type);
            var rule = new FilterRule { Field = it.EntityField!, Operator = op };

            switch ((it.Type ?? "").ToLowerInvariant())
            {
                case "select":
                    rule.Value = val?.ToString();
                    break;
                case "multiselect":
                    rule.Value = val as List<string> ?? new List<string>();
                    break;
                case "daterange":
                case "numberrange":
                    if (val is string?[] arr && (arr[0] is not null || arr[1] is not null)) rule.Value = arr;
                    else if (val is List<string?> list && list.Count == 2) rule.Value = list.ToArray();
                    else continue;
                    break;
                case "boolean":
                    rule.Value = val;
                    break;
                default:
                    rule.Value = val;
                    break;
            }
            q.Filters.Add(rule);
        }
        BuildChips();
        return q;
    }

    private static string InferDefaultOperator(string? type) => type switch
    {
        "select" => "eq",
        "multiselect" => "in",
        "daterange" => "between",
        "numberrange" => "between",
        "boolean" => "eq",
        _ => "eq"
    };

    private void BuildChips()
    {
        _activeChips.Clear();
        if (Config?.Items is null) return;

        // 1) Chips normales (todo menos ResearchCategoryId)
        foreach (var it in Config.Items)
        {
            if (it.EntityField == "ResearchCategoryId") // 👈 los saltamos aquí
                continue;

            if (!_values.TryGetValue(it.Key, out var val) || val is null)
                continue;

            var display = GetDisplayValue(val, it);
            if (!string.IsNullOrWhiteSpace(display))
            {
                _activeChips.Add(new ChipItem
                {
                    Key = it.Key,
                    Label = it.Label,
                    Value = display!
                });
            }
        }

        // 2) Chips combinados por GRUPO para ResearchCategoryId
        var researchItems = Config.Items
            .Where(i => i.EntityField == "ResearchCategoryId")
            .ToList();

        if (researchItems.Count == 0)
            return;

        // Agrupamos por GroupKey (mismo grupo lógico: Áreas, Campos, etc.)
        var grouped = researchItems
            .GroupBy(i => i.GroupKey ?? "default");

        foreach (var group in grouped)
        {
            var groupKey = group.Key;
            var first = group.First();
            var groupLabel = first.GroupLabel ?? "Áreas de investigación";

            var parts = new List<string>();

            foreach (var it in group)
            {
                if (!_values.TryGetValue(it.Key, out var val) || val is null)
                    continue;

                var valueText = GetDisplayValue(val, it);
                if (string.IsNullOrWhiteSpace(valueText))
                    continue;

                // ej: "Dominio: Fortalecimiento social"
                var typeLabel = it.Label ?? string.Empty;
                parts.Add($"{typeLabel}: {valueText}");
            }

            if (parts.Count == 0)
                continue;

            _activeChips.Add(new ChipItem
            {
                // 👇 clave incluye el grupo, para poder borrarlo por separado
                Key = $"researchCategories_{groupKey}",
                Label = groupLabel,                             // ej: "ÁREAS DE INVESTIGACIÓN"
                Value = string.Join(" · ", parts)               // ej: "Dominio: X · Línea: Y"
            });
        }
    }


    private string? GetDisplayValue(object val, FilterItemDescriptor item)
    {
        // SELECT simple: mapear Value → Label
        if ((item.Type ?? "").ToLowerInvariant() == "select" && val is string sVal)
        {
            var label = item.Options?
                .FirstOrDefault(o => o.Value == sVal)?
                .Label;

            return !string.IsNullOrWhiteSpace(label) ? label : sVal;
        }

        // Lo demás igual que ya tenías
        return val switch
        {
            bool b => b ? (item.TrueLabel ?? "Yes") : (item.FalseLabel ?? "No"),
            List<string> list => string.Join(", ", ResolveLabels(item, list)),
            string?[] arr => string.Join(" – ", arr.Where(s => !string.IsNullOrWhiteSpace(s))),
            IList<string> ilist => string.Join(" – ", ilist.Where(s => !string.IsNullOrWhiteSpace(s))),
            _ => val?.ToString()
        };
    }


    private IEnumerable<string> ResolveLabels(FilterItemDescriptor it, List<string> values)
    {
        var opts = it.Options ?? new();
        foreach (var v in values)
        {
            var label = opts.FirstOrDefault(o => o.Value == v)?.Label ?? v;
            yield return label;
        }
    }
    private void HandleResearchSelectionChange(FilterItemDescriptor item, OptionItem? selected)
    {
        if (Config?.Items == null)
            return;

        var index = Config.Items.FindIndex(i => i.Key == item.Key);
        if (index < 0)
            return;

        // ============================
        // 1) Propagar selección hacia ARRIBA (padres, abuelos, etc.)
        // ============================

        // Empezamos con el padre inmediato del ítem seleccionado
        string? currentParentVal = selected?.ParentValue;

        for (int i = index - 1; i >= 0 && !string.IsNullOrWhiteSpace(currentParentVal); i--)
        {
            var parentDescriptor = Config.Items[i];

            // Solo filtros de investigación del MISMO grupo
            if (!IsSameResearchGroup(parentDescriptor, item))
            {
                // Si ya llegamos a otro grupo, salimos
                if (IsResearchFilter(parentDescriptor))
                    break;

                continue;
            }

            // Asignamos el valor del padre actual (ej: nivel 2)
            _values[parentDescriptor.Key] = currentParentVal;

            // Para subir otro nivel (abuelo), buscamos en las opciones del padre
            var parentOptions = parentDescriptor.Options ?? new List<OptionItem>();
            var parentOption = parentOptions.FirstOrDefault(o => o.Value == currentParentVal);

            // El ParentValue de esa opción es el ID del siguiente ancestro (ej: nivel 1)
            currentParentVal = parentOption?.ParentValue;
        }

        // ============================
        // 2) Limpiar niveles HIJOS (más profundos) del mismo grupo
        // ============================
        for (int i = index + 1; i < Config.Items.Count; i++)
        {
            var childDescriptor = Config.Items[i];

            if (!IsSameResearchGroup(childDescriptor, item))
            {
                if (IsResearchFilter(childDescriptor))
                    break; // ya entramos en otro grupo → dejamos de limpiar

                continue;
            }

            _values[childDescriptor.Key] = null;
        }
    }

    private List<OptionItem> GetHierarchicalOptions(FilterItemDescriptor item, List<OptionItem> baseOptions)
    {
        if (Config?.Items == null)
            return baseOptions;

        var index = Config.Items.FindIndex(i => i.Key == item.Key);
        if (index <= 0)
            return baseOptions;

        for (int i = index - 1; i >= 0; i--)
        {
            var parentDescriptor = Config.Items[i];

            if (!IsResearchFilter(parentDescriptor))
                continue;

            // si es de otro grupo, ya no seguimos buscando padres
            if (!IsSameResearchGroup(parentDescriptor, item))
                break;

            if (_values.TryGetValue(parentDescriptor.Key, out var parentValObj) &&
                parentValObj is string parentVal &&
                !string.IsNullOrWhiteSpace(parentVal))
            {
                return baseOptions
                    .Where(o => o.ParentValue == parentVal)
                    .ToList();
            }

            // encontramos el padre pero sin valor → mostramos todo
            break;
        }

        return baseOptions;
    }


}