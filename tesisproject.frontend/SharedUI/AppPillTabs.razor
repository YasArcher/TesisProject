@namespace tesisproject.frontend.SharedUI

<div class="flex bg-gray-100 rounded-lg p-1">
    @foreach (var tab in Tabs)
    {
        <button @onclick="() => OnTabChanged?.Invoke(tab.Id)"
                class="@GetTabClass(tab) px-3 py-2 rounded-md text-sm font-medium transition-colors">
            @if (!string.IsNullOrEmpty(tab.Icon))
            {
                <i class="@tab.Icon mr-2"></i>
            }
            @tab.Text
        </button>
    }
</div>

@code {
    [Parameter] public List<TabItem> Tabs { get; set; } = new();
    [Parameter] public string ActiveTab { get; set; } = string.Empty;
    [Parameter] public Action<string>? OnTabChanged { get; set; }
    [Parameter] public string? Class { get; set; }

    private string GetTabClass(TabItem tab)
    {
        return tab.Id == ActiveTab
            ? "bg-white text-[#7A1E19] shadow-sm"
            : "text-gray-500 hover:text-gray-700";
    }
}