@using Microsoft.AspNetCore.Components

<ul class="nav nav-pills @Class">
    @foreach (var tab in Items ?? Enumerable.Empty<AppPillTabs.PillTab>())
    {
        var active = tab.Active ? "active" : null;
        if (!string.IsNullOrWhiteSpace(tab.Href))
        {
            <li class="nav-item">
                <a class="nav-link @active" href="@tab.Href">
                    @if (!string.IsNullOrWhiteSpace(tab.Icon))
                    {
                        <span>@tab.Icon</span>
                    }
         @tab.Label
                </a>
            </li>
        }
        else
        {
            <li class="nav-item">
                <button type="button" class="nav-link @active" @onclick="() => Select(tab)">
                    @if (!string.IsNullOrWhiteSpace(tab.Icon))
                    {
                        <span>@tab.Icon</span>
                    }
         @tab.Label
                </button>
            </li>
        }
    }
</ul>

@code {
    [Parameter] public IEnumerable<PillTab>? Items { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public EventCallback<PillTab> OnSelect { get; set; }

    private Task Select(PillTab tab) => OnSelect.HasDelegate ? OnSelect.InvokeAsync(tab) : Task.CompletedTask;

    public class PillTab
    {
        public string Label { get; set; } = "";
        public string? Icon { get; set; }
        public bool Active { get; set; }
        public string? Href { get; set; }   // <- NUEVO: permite navegar
    }
}
