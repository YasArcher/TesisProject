<div class="rounded-lg border border-slate-200 bg-white px-3 py-2">
    <div class="text-xs uppercase tracking-wider text-slate-500">@Label</div>
    @if (IsLink && !string.IsNullOrWhiteSpace(Value))
    {
        <a href="@Value" target="_blank" rel="noopener" class="text-sm font-semibold text-brand-primary underline underline-offset-2">@Value</a>
    }
    else
    {
        <div class="text-sm font-semibold text-slate-800">@(!string.IsNullOrWhiteSpace(Value) ? Value : "—")</div>
    }
</div>

@code {
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Value { get; set; }
    [Parameter] public bool IsLink { get; set; }
}
