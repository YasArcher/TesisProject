@namespace tesisproject.frontend.SharedUI

<div class="app-metric-card @GetToneClass() @Class" data-tone="@Tone.ToLowerInvariant()">
    <div class="app-metric-card__label">@Label</div>
    <div class="app-metric-card__value">@Value</div>
    @if (!string.IsNullOrWhiteSpace(HelperText))
    {
        <div class="app-metric-card__helper">@HelperText</div>
    }
</div>

@code {
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public string? HelperText { get; set; }
    [Parameter] public string Tone { get; set; } = "default";
    [Parameter] public string? Class { get; set; }

    private string GetToneClass()
    {
        return Tone.ToLowerInvariant() switch
        {
            "accent" => "app-metric-card--accent",
            "warm" => "app-metric-card--warm",
            _ => "app-metric-card--default"
        };
    }
}
