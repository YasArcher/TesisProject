<div class="p-4 rounded-2 shadow-sm bg-white h-100">
    <div class="d-flex justify-content-between align-items-start">
        <div>
            <div class="text-muted small">@Title</div>
            <div class="h3 mb-0">@Value</div>
            @if (!string.IsNullOrWhiteSpace(DeltaLabel))
            {
                <div class="small mt-1 @DeltaClass">@DeltaLabel</div>
            }
        </div>
        <div style="font-size:28px" aria-hidden="true">@Icon</div>
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public string Icon { get; set; } = "📊";
    [Parameter] public string? DeltaLabel { get; set; }
    [Parameter] public string DeltaClass { get; set; } = "text-success";
}
