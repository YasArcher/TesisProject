@using tesisproject.frontend.Models.Articles 

<section class="rounded-3xl border border-slate-200/80 bg-white/95 shadow-sm">
    <header class="flex items-center gap-3 border-b border-slate-200/70 bg-gradient-to-r from-[#f9fafb] via-[#e6f0f0] to-white px-5 py-3">
        <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-[#213635]/10 text-[#213635]">
            <i class="bi bi-people"></i>
        </div>
        <div>
            <h2 class="text-sm md:text-base font-semibold text-slate-900">
                Participantes del artículo
            </h2>
            <p class="text-xs text-slate-500">
                Registre al menos tres autores con nombre completo. Puedes completar este bloque cuando desees.
            </p>
        </div>
    </header>

    <div class="space-y-4 px-5 py-5">
        @for (int i = 0; i < Article.Participants.Count; i++)
        {
            var index = i;
            <div class="participant-card rounded-2xl border px-4 py-4 @(index >= 3 ? "bg-amber-50/80 border-amber-200" : "bg-white")">
                <div class="mb-3 flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <div class="flex h-8 w-8 items-center justify-center rounded-full bg-[#1c5052] text-xs font-semibold text-white shadow-sm">
                            @(index + 1)
                        </div>
                        <span class="text-sm font-semibold text-slate-900">
                            Participante @(index + 1)
                        </span>
                        @if (index < 3)
                        {
                            <span class="rounded-full bg-[#800909] px-2 py-0.5 text-[11px] font-medium text-white">
                                Requerido
                            </span>
                        }
                    </div>

                    @if (index >= 3)
                    {
                        <button type="button"
                                @onclick="@(() => HandleRemoveClick(index))"
                                class="rounded-full p-1 text-rose-600 transition hover:bg-rose-50 hover:text-rose-700">
                            <i class="bi bi-trash text-sm"></i>
                        </button>
                    }
                </div>

                <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
                    <div>
                        <label class="mb-1.5 block text-sm font-medium text-slate-800">
                            Identificación
                        </label>
                        <InputText @bind-Value="Article.Participants[index].Identificacion"
                                   class="w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm shadow-sm outline-none transition focus:border-[#800909] focus:ring-2 focus:ring-[#800909]/20"
                                   placeholder="Cédula o ID" />
                    </div>

                    <div>
                        <label class="mb-1.5 block text-sm font-medium text-slate-800 @(index < 3 ? "required" : "")">
                            Nombre completo
                        </label>
                        <InputText @bind-Value="Article.Participants[index].Nombre"
                                   class="w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm shadow-sm outline-none transition focus:border-[#800909] focus:ring-2 focus:ring-[#800909]/20"
                                   placeholder="Nombre completo del participante" />
                        <ValidationMessage For="@(() => Article.Participants[index].Nombre)" class="validation-message" />
                    </div>

                    <div>
                        <label class="mb-1.5 block text-sm font-medium text-slate-800">
                            Participación
                        </label>
                        <InputText @bind-Value="Article.Participants[index].Participacion"
                                   class="w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm shadow-sm outline-none transition focus:border-[#800909] focus:ring-2 focus:ring-[#800909]/20"
                                   placeholder="Rol o participación" />
                    </div>
                </div>
            </div>
        }

        <button type="button"
                @onclick="HandleAddClick"
                class="inline-flex items-center gap-2 rounded-xl border border-dashed border-slate-300 bg-white/60 px-4 py-2 text-xs md:text-sm font-medium text-slate-700 shadow-sm transition hover:border-slate-400 hover:bg-slate-50">
            <i class="bi bi-plus-circle"></i>
            Agregar participante
        </button>
    </div>
</section>

@code {
    [Parameter] public ArticleViewModel Article { get; set; } = default!;

    [Parameter] public EventCallback OnAddParticipant { get; set; }
    [Parameter] public EventCallback<int> OnRemoveParticipant { get; set; }

    private Task HandleAddClick()
        => OnAddParticipant.HasDelegate
            ? OnAddParticipant.InvokeAsync()
            : Task.CompletedTask;

    private Task HandleRemoveClick(int index)
        => OnRemoveParticipant.HasDelegate
            ? OnRemoveParticipant.InvokeAsync(index)
            : Task.CompletedTask;
}
