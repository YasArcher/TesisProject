@using tesisproject.frontend.Models.Articles
@using tesisproject.shared.DTOs.Catalogs
@using tesisproject.frontend.Services.Interfaces
@inject ICatalogsService CatalogService

<section class="rounded-3xl border border-slate-200/80 bg-white/95 shadow-sm">
    <header class="flex items-center gap-3 border-b border-slate-200/70 bg-gradient-to-r from-[#f9fafb] via-[#eef2f7] to-white px-5 py-3">
        <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-[#1a2b2b]/10 text-[#1a2b2b]">
            <i class="bi bi-diagram-3"></i>
        </div>
        <div>
            <h2 class="text-sm md:text-base font-semibold text-slate-900">
                Clasificación académica
            </h2>
            <p class="text-xs text-slate-500">
                Período académico, estado y líneas de investigación asociadas.
            </p>
        </div>
    </header>

    <div class="space-y-6 px-5 py-5">
        <!-- Fila 1: período, estado, línea -->
        <div class="grid grid-cols-1 gap-5 md:grid-cols-3">
            <!-- Período académico -->
            <div>
                <label class="mb-1.5 block text-sm font-medium text-slate-800">
                    Período académico
                </label>
                <InputSelect TValue="int?" @bind-Value="Article.AcademicTermId"
                             class="w-full rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm shadow-sm outline-none transition focus:border-[#800909] focus:ring-2 focus:ring-[#800909]/20">
                    <option value="">Seleccionar período…</option>
                    @foreach (var term in AcademicTerms)
                    {
                        <option value="@term.Id">@term.Name</option>
                    }
                </InputSelect>
            </div>

            <!-- Estado de publicación (byte?) -->
            <div>
                <label class="mb-1.5 block text-sm font-medium text-slate-800">
                    Estado de publicación
                </label>
                <InputSelect TValue="byte?" @bind-Value="Article.PublicationStatusId"
                             class="w-full rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm shadow-sm outline-none transition focus:border-[#800909] focus:ring-2 focus:ring-[#800909]/20">
                    <option value="">Seleccionar estado…</option>
                    @foreach (var status in PublicationStatuses)
                    {
                        <option value="@status.Id">@status.Name</option>
                    }
                </InputSelect>
            </div>

            <!-- Línea de investigación -->
            <div>
                <label class="mb-1.5 block text-sm font-medium text-slate-800">
                    Línea de investigación
                </label>
                <InputSelect TValue="int?" @bind-Value="Article.ResearchLineId"
                             class="w-full rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm shadow-sm outline-none transition focus:border-[#800909] focus:ring-2 focus:ring-[#800909]/20">
                    <option value="">Seleccionar línea…</option>
                    @foreach (var line in ResearchLines)
                    {
                        <option value="@line.Id">@line.Name</option>
                    }
                </InputSelect>
            </div>
        </div>

        <!-- Clasificación OCDE -->
        <div class="border-t border-slate-200 pt-5">
            <h3 class="mb-3 text-sm font-semibold text-slate-900">
                Clasificación OCDE
            </h3>
            <div class="grid grid-cols-1 gap-5 md:grid-cols-3">
                <!-- CAMPO AMPLIO -->
                <div>
                    <label class="mb-1.5 block text-sm font-medium text-slate-800">
                        Campo amplio
                    </label>
                    <InputSelect TValue="int?" @bind-Value="Article.BroadFieldId"
                                 @onchange="BroadFieldChanged"
                                 class="w-full rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm shadow-sm outline-none transition focus:border-[#800909] focus:ring-2 focus:ring-[#800909]/20">
                        <option value="">Seleccionar campo amplio…</option>
                        @foreach (var field in BroadFields)
                        {
                            <option value="@field.Id">@field.Name</option>
                        }
                    </InputSelect>
                </div>

                <!-- CAMPO ESPECÍFICO -->
                <div>
                    <label class="mb-1.5 block text-sm font-medium text-slate-800">
                        Campo específico
                    </label>
                    <InputSelect TValue="int?" @bind-Value="Article.SpecificFieldId"
                                 @onchange="SpecificFieldChanged"
                                 disabled="@(Article.BroadFieldId == null)"
                                 class="w-full rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm shadow-sm outline-none transition disabled:cursor-not-allowed disabled:bg-slate-50 focus:border-[#800909] focus:ring-2 focus:ring-[#800909]/20">
                        <option value="">Seleccionar campo específico…</option>
                        @foreach (var field in SpecificFields)
                        {
                            <option value="@field.Id">@field.Name</option>
                        }
                    </InputSelect>
                </div>

                <!-- CAMPO DETALLADO -->
                <div>
                    <label class="mb-1.5 block text-sm font-medium text-slate-800">
                        Campo detallado
                    </label>
                    <InputSelect TValue="int?" @bind-Value="Article.DetailedFieldId"
                                 disabled="@(Article.SpecificFieldId == null)"
                                 class="w-full rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm shadow-sm outline-none transition disabled:cursor-not-allowed disabled:bg-slate-50 focus:border-[#800909] focus:ring-2 focus:ring-[#800909]/20">
                        <option value="">Seleccionar campo detallado…</option>
                        @foreach (var field in DetailedFields)
                        {
                            <option value="@field.Id">@field.Name</option>
                        }
                    </InputSelect>
                </div>
            </div>

            <!-- Debug -->
            <div class="mt-3 text-[11px] text-slate-500">
                [DEBUG HIJO] BroadFieldId=@(Article.BroadFieldId?.ToString() ?? "null")
                | SpecificFields=@SpecificFields.Count
                | SpecificFieldId=@(Article.SpecificFieldId?.ToString() ?? "null")
                | DetailedFields=@DetailedFields.Count
            </div>
        </div>
    </div>
</section>

@code {
    [Parameter] public ArticleViewModel Article { get; set; } = default!;

    [Parameter] public List<CatalogItemDto> AcademicTerms { get; set; } = new();
    [Parameter] public List<CatalogItemDto> PublicationStatuses { get; set; } = new();
    [Parameter] public List<CatalogItemDto> ResearchLines { get; set; } = new();
    [Parameter] public List<CatalogItemDto> BroadFields { get; set; } = new();

    // 🔹 Estas listas ahora las maneja EL HIJO
    [Parameter] public List<CatalogItemDto> SpecificFields { get; set; } = new();
    [Parameter] public List<CatalogItemDto> DetailedFields { get; set; } = new();

    // Carga inicial cuando se edita un artículo ya existente
    protected override async Task OnParametersSetAsync()
    {
        // Si viene un artículo existente con BroadFieldId y aún no hay SpecificFields cargados
        if (Article.BroadFieldId.HasValue && SpecificFields.Count == 0)
        {
            SpecificFields = await CatalogService.GetSpecificFieldsAsync(Article.BroadFieldId.Value);
        }

        // Si viene un artículo existente con SpecificFieldId y aún no hay DetailedFields cargados
        if (Article.SpecificFieldId.HasValue && DetailedFields.Count == 0)
        {
            DetailedFields = await CatalogService.GetDetailedFieldsAsync(Article.SpecificFieldId.Value);
        }
    }

    private async Task BroadFieldChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int broadFieldId))
        {
            Article.BroadFieldId = broadFieldId;
            Article.SpecificFieldId = null;
            Article.DetailedFieldId = null;

            // 🔹 Llamar al backend directamente desde el hijo
            SpecificFields = await CatalogService.GetSpecificFieldsAsync(broadFieldId);
            DetailedFields = new();
        }
        else
        {
            Article.BroadFieldId = null;
            Article.SpecificFieldId = null;
            Article.DetailedFieldId = null;
            SpecificFields = new();
            DetailedFields = new();
        }

        StateHasChanged();
    }

    private async Task SpecificFieldChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int specificFieldId))
        {
            Article.SpecificFieldId = specificFieldId;
            Article.DetailedFieldId = null;

            // 🔹 Llamar al backend para campos detallados
            DetailedFields = await CatalogService.GetDetailedFieldsAsync(specificFieldId);
        }
        else
        {
            Article.SpecificFieldId = null;
            Article.DetailedFieldId = null;
            DetailedFields = new();
        }

        StateHasChanged();
    }
}
