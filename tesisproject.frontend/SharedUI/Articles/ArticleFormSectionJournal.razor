@using tesisproject.frontend.Models.Articles
@using tesisproject.shared.DTOs.Catalogs

<section class="rounded-3xl border border-slate-200/80 bg-white/95 shadow-sm">
    <header class="flex items-center gap-3 border-b border-slate-200/70 bg-gradient-to-r from-[#f9fafb] via-[#f2f2f2] to-white px-5 py-3">
        <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-[#348e91]/10 text-[#348e91]">
            <i class="bi bi-journal"></i>
        </div>
        <div>
            <h2 class="text-sm md:text-base font-semibold text-slate-900">
                Información de la revista / evento e indexación
            </h2>
            <p class="text-xs text-slate-500">
                Datos de la revista o actas (proceedings), métricas e indexadores asociados.
            </p>
        </div>
    </header>

    <div class="space-y-6 px-5 py-5">

        <!-- REVISTA / ACTAS -->
        <div>
            <h3 class="mb-3 text-sm font-semibold text-slate-900">
                Revista o actas (proceedings)
            </h3>

            <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
                <div>
                    <label class="mb-1.5 block text-sm font-medium text-slate-800">
                        Nombre de la revista / actas
                    </label>
                    <InputText @bind-Value="Article.VenueName"
                               class="w-full rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm shadow-sm outline-none transition focus:border-[#800909] focus:ring-2 focus:ring-[#800909]/20"
                               placeholder="Ej. Revista X, Actas del Congreso Y" />
                    <ValidationMessage For="@(() => Article.VenueName)" class="validation-message" />
                </div>

                <div>
                    <label class="mb-1.5 block text-sm font-medium text-slate-800">
                        URL de la revista
                    </label>
                    <InputText @bind-Value="Article.JournalUrl"
                               class="w-full rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm shadow-sm outline-none transition focus:border-[#800909] focus:ring-2 focus:ring-[#800909]/20"
                               placeholder="https://revista-o-evento.com/articulo" />
                </div>

                <div>
                    <label class="mb-1.5 block text-sm font-medium text-slate-800">
                        Código ISSN
                    </label>
                    <InputText @bind-Value="Article.IssnCode"
                               class="w-full rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm shadow-sm outline-none transition focus:border-[#800909] focus:ring-2 focus:ring-[#800909]/20"
                               placeholder="0000-0000" />
                </div>

                <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
                    <div>
                        <label class="mb-1.5 block text-sm font-medium text-slate-800">
                            Volumen
                        </label>
                        <InputText @bind-Value="Article.VolumeNumber"
                                   class="w-full rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm shadow-sm outline-none transition focus:border-[#800909] focus:ring-2 focus:ring-[#800909]/20"
                                   placeholder="Ej. 12" />
                    </div>

                    <div>
                        <label class="mb-1.5 block text-sm font-medium text-slate-800">
                            Número / Issue
                        </label>
                        <InputText @bind-Value="Article.IssueNumber"
                                   class="w-full rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm shadow-sm outline-none transition focus:border-[#800909] focus:ring-2 focus:ring-[#800909]/20"
                                   placeholder="Ej. 3" />
                    </div>
                </div>
            </div>
        </div>

        <!-- CAMPOS DE EVENTO / PROCEEDINGS / GRUPO / FILIACIÓN -->
        <div class="border-t border-slate-200 pt-5">
            <h3 class="mb-3 text-sm font-semibold text-slate-900">
                Información del evento y grupo de investigación
            </h3>

            <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
                <div>
                    <label class="mb-1.5 block text-sm font-medium text-slate-800">
                        Proceedings / actas
                    </label>
                    <InputText @bind-Value="Article.Proceedings"
                               class="w-full rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm shadow-sm outline-none transition focus:border-[#800909] focus:ring-2 focus:ring-[#800909]/20"
                               placeholder="Ej. Proceedings of the XYZ Conference" />
                </div>

                <div>
                    <label class="mb-1.5 block text-sm font-medium text-slate-800">
                        Nombre del evento
                    </label>
                    <InputText @bind-Value="Article.EventName"
                               class="w-full rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm shadow-sm outline-none transition focus:border-[#800909] focus:ring-2 focus:ring-[#800909]/20"
                               placeholder="Ej. Congreso Internacional de..." />
                </div>

                <div>
                    <label class="mb-1.5 block text-sm font-medium text-slate-800">
                        Grupo de investigación / artículo
                    </label>
                    <InputText @bind-Value="Article.GroupName"
                               class="w-full rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm shadow-sm outline-none transition focus:border-[#800909] focus:ring-2 focus:ring-[#800909]/20"
                               placeholder="Ej. Grupo de Investigación en..." />
                </div>

                <div>
                    <label class="mb-1.5 block text-sm font-medium text-slate-800">
                        Filiación institucional
                    </label>
                    <InputText @bind-Value="Article.Filiacion"
                               class="w-full rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm shadow-sm outline-none transition focus:border-[#800909] focus:ring-2 focus:ring-[#800909]/20"
                               placeholder="Ej. Universidad Técnica de Ambato, DIDE" />
                </div>
            </div>
        </div>

        <!-- MÉTRICAS (SJR / QUARTIL) -->
        <div class="border-t border-slate-200 pt-5">
            <h3 class="mb-3 text-sm font-semibold text-slate-900">
                Métricas de calidad (SJR / Quartil)
            </h3>

            <div class="grid grid-cols-1 gap-5 md:grid-cols-3">
                <div>
                    <label class="mb-1.5 block text-sm font-medium text-slate-800">
                        Año de la métrica
                    </label>
                    <InputNumber @bind-Value="Article.MetricYear"
                                 class="w-full rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm shadow-sm outline-none transition focus:border-[#800909] focus:ring-2 focus:ring-[#800909]/20"
                                 placeholder="Ej. 2024" />
                </div>

                <div>
                    <label class="mb-1.5 block text-sm font-medium text-slate-800">
                        SJR
                    </label>
                    <InputNumber @bind-Value="Article.SJR"
                                 class="w-full rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm shadow-sm outline-none transition focus:border-[#800909] focus:ring-2 focus:ring-[#800909]/20"
                                 step="0.001"
                                 placeholder="Ej. 0.750" />
                </div>

                <div>
                    <label class="mb-1.5 block text-sm font-medium text-slate-800">
                        Quartil (Q1, Q2, Q3, Q4)
                    </label>
                    <InputText @bind-Value="Article.Quartile"
                               class="w-full rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm shadow-sm outline-none transition focus:border-[#800909] focus:ring-2 focus:ring-[#800909]/20"
                               placeholder="Ej. Q1" />
                </div>
            </div>
        </div>

        <!-- FUENTES DE INDEXACIÓN -->
        <div class="border-t border-slate-200 pt-5">
            <h3 class="mb-3 text-sm font-semibold text-slate-900">
                Fuentes de indexación
            </h3>

            @if (IndexingSources is null || IndexingSources.Count == 0)
            {
                <p class="text-xs text-slate-500">
                    No se encontraron fuentes de indexación configuradas.
                </p>
            }
            else
            {
                <div class="grid grid-cols-1 gap-2 md:grid-cols-2">
                    @foreach (var source in IndexingSources)
                    {
                        var isChecked = Article.IndexingSourceIds.Contains(source.Id);
                        <label class="flex items-center gap-2 rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-xs text-slate-700">
                            <input type="checkbox"
                                   class="h-4 w-4 rounded border-slate-300 text-[#800909] focus:ring-[#800909]"
                                   checked="@isChecked"
                                   @onchange="e => ToggleIndexingSource(source.Id, ((ChangeEventArgs)e).Value is bool b && b)" />
                            <span>@source.Name</span>
                        </label>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    [Parameter] public ArticleViewModel Article { get; set; } = default!;
    [Parameter] public List<CatalogItemDto> IndexingSources { get; set; } = new();

    private void ToggleIndexingSource(int sourceId, bool isChecked)
    {
        if (isChecked && !Article.IndexingSourceIds.Contains(sourceId))
        {
            Article.IndexingSourceIds.Add(sourceId);
        }
        else if (!isChecked && Article.IndexingSourceIds.Contains(sourceId))
        {
            Article.IndexingSourceIds.Remove(sourceId);
        }
    }
}
