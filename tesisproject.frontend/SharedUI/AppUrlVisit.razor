@namespace tesisproject.frontend.SharedUI
<div class="row g-3">
    <div class="@ColInputCss">
        @if (!string.IsNullOrWhiteSpace(Label))
        {
            <label class="form-label" for="@Id">@Label</label>
        }
        <input id="@Id" class="form-control" placeholder="@Placeholder"
               value="@Value" @oninput="OnInput" />
    </div>
    <div class="@ColButtonCss">
        <a class="btn btn-outline-primary w-100 @(string.IsNullOrWhiteSpace(Value) ? "disabled" : null)"
           target="_blank" rel="noopener"
           href="@(string.IsNullOrWhiteSpace(Value) ? "#" : Value)">
            @VisitText
        </a>
    </div>
</div>

@code {
    [Parameter] public string Id { get; set; } = Guid.NewGuid().ToString("N");
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Placeholder { get; set; } = "https://...";
    [Parameter] public string VisitText { get; set; } = "Visitar";

    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    [Parameter] public string ColInputCss { get; set; } = "col-12 col-md-9";
    [Parameter] public string ColButtonCss { get; set; } = "col-12 col-md-3 d-flex align-items-end";

    private async Task OnInput(ChangeEventArgs e)
    {
        Value = e.Value?.ToString();
        await ValueChanged.InvokeAsync(Value);
    }
}
