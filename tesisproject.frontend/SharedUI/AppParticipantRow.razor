@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@namespace tesisproject.frontend.SharedUI

<div class="app-glass-card rounded-2xl shadow-soft mb-2">
    <div class="p-3">
        <h6 class="text-uppercase small fw-semibold mb-3">
            Participante N°@Index.ToString("00")
        </h6>

        <div class="row g-2">
            <!-- Identificación -->
            <div class="col-12 col-md-4">
                <label class="form-label">Identificación</label>
                <InputText class="form-control"
                           @bind-Value="IdentificacionInternal" />
            </div>

            <!-- Nombre -->
            <div class="col-12 col-md-4">
                <label class="form-label">Nombre</label>
                <InputText class="form-control"
                           @bind-Value="NombreInternal" />
            </div>

            <!-- Participación -->
            <div class="col-12 col-md-4">
                <label class="form-label">Participación</label>
                <InputText class="form-control"
                           @bind-Value="ParticipacionInternal" />
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public int Index { get; set; } = 1;

    // Permite usar: @bind-Identificacion, @bind-Nombre, @bind-Participacion

    [Parameter] public string? Identificacion { get; set; }
    [Parameter] public EventCallback<string?> IdentificacionChanged { get; set; }

    [Parameter] public string? Nombre { get; set; }
    [Parameter] public EventCallback<string?> NombreChanged { get; set; }

    [Parameter] public string? Participacion { get; set; }
    [Parameter] public EventCallback<string?> ParticipacionChanged { get; set; }

    private string? IdentificacionInternal
    {
        get => Identificacion;
        set
        {
            if (Identificacion != value)
            {
                Identificacion = value;
                if (IdentificacionChanged.HasDelegate)
                    IdentificacionChanged.InvokeAsync(value);
            }
        }
    }

    private string? NombreInternal
    {
        get => Nombre;
        set
        {
            if (Nombre != value)
            {
                Nombre = value;
                if (NombreChanged.HasDelegate)
                    NombreChanged.InvokeAsync(value);
            }
        }
    }

    private string? ParticipacionInternal
    {
        get => Participacion;
        set
        {
            if (Participacion != value)
            {
                Participacion = value;
                if (ParticipacionChanged.HasDelegate)
                    ParticipacionChanged.InvokeAsync(value);
            }
        }
    }
}
