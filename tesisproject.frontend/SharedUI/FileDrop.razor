@namespace tesisproject.frontend.SharedUI
@using Microsoft.AspNetCore.Components.Forms

<div class="flex items-center justify-between gap-3 rounded-2xl border-2 border-dashed border-slate-700 bg-slate-900/40 p-4">
    <div class="space-y-1">
        <p class="text-slate-300 text-sm">Arrastra y suelta tu archivo aquí o usa el botón.</p>
        @if (!string.IsNullOrWhiteSpace(Detalle))
        {
            <p class="text-slate-500 text-xs">@Detalle</p>
        }
    </div>
    <div>
        <label class="inline-flex items-center justify-center rounded-xl bg-indigo-600 px-4 py-2 text-white font-medium cursor-pointer hover:bg-indigo-500">
            <span>Seleccionar archivo</span>
            <InputFile class="hidden" OnChange="OnChange" accept="@Accept" />
        </label>
    </div>
</div>

@code {
    [Parameter] public string? Detalle { get; set; }
    [Parameter] public string? Accept { get; set; } = ".json,application/json";
    [Parameter] public EventCallback<InputFileChangeEventArgs> OnChange { get; set; }
}
