@namespace tesisproject.frontend.SharedUI

<svg viewBox="0 0 600 @Height" preserveAspectRatio="none" class="w-full h-48 sm:h-56">
    @if (_points.Count > 1)
    {
        @if (_bandUp.Count == _points.Count && _bandLo.Count == _points.Count)
        {
            <path d="@BandPath" class="fill-indigo-500 opacity-20"></path>
        }
        <path d="@LinePath" class="stroke-indigo-500 fill-none" stroke-width="2"></path>
    }
    <line x1="0" y1="@Height" x2="600" y2="@Height" class="stroke-slate-700"></line>
</svg>

<div class="mt-2 grid grid-cols-4 sm:grid-cols-6 lg:grid-cols-8 gap-2 text-[10px] text-slate-400">
    @foreach (var (x, i) in Labels.Select((d, i) => (d, i)).Take(16))
    {
        <div class="truncate" title="@x">@x</div>
    }
</div>

@code {
    [Parameter] public IEnumerable<(DateTime X, double Y)> Serie { get; set; } = Enumerable.Empty<(DateTime, double)>();
    [Parameter] public IEnumerable<(DateTime X, double Lower, double Upper)>? Banda { get; set; }
    [Parameter] public int Height { get; set; } = 160;

    private List<(double x, double y)> _points = new();
    private List<(double x, double y)> _bandLo = new();
    private List<(double x, double y)> _bandUp = new();
    private List<string> Labels { get; set; } = new();

    private double minY, maxY;
    private string LinePath => BuildPath(_points);
    private string BandPath => BuildBand(_bandLo, _bandUp);

    protected override void OnParametersSet()
    {
        var s = Serie.OrderBy(p => p.X).ToList();
        _points.Clear(); _bandLo.Clear(); _bandUp.Clear(); Labels = new();
        if (!s.Any()) return;

        minY = Math.Min(s.Min(p => p.Y), Banda?.Any() == true ? Banda.Min(p => p.Lower) : s.Min(p => p.Y));
        maxY = Math.Max(s.Max(p => p.Y), Banda?.Any() == true ? Banda.Max(p => p.Upper) : s.Max(p => p.Y));
        if (Math.Abs(maxY - minY) < 1e-6) { maxY += 1; minY -= 1; }

        var minX = s.First().X;
        var maxX = s.Last().X;
        var spanX = (maxX - minX).TotalDays;
        if (spanX <= 0) spanX = 1;

        _points = s.Select(p => (x: MapX(p.X), y: MapY(p.Y))).ToList();
        Labels = s.Select(p => p.X.ToString("yyyy-MM")).ToList();

        if (Banda?.Any() == true)
        {
            var b = Banda.OrderBy(p => p.X).ToList();
            _bandLo = b.Select(p => (x: MapX(p.X), y: MapY(p.Lower))).ToList();
            _bandUp = b.Select(p => (x: MapX(p.X), y: MapY(p.Upper))).ToList();
        }

        double MapX(DateTime d) => ((d - minX).TotalDays / spanX) * 600.0;
        double MapY(double v) => Height - ((v - minY) / (maxY - minY)) * (Height - 12) - 6;
    }

    private static string BuildPath(List<(double x, double y)> pts)
    {
        if (pts.Count == 0) return "";
        var sb = new System.Text.StringBuilder($"M {pts[0].x:F1} {pts[0].y:F1}");
        for (int i = 1; i < pts.Count; i++) sb.Append($" L {pts[i].x:F1} {pts[i].y:F1}");
        return sb.ToString();
    }

    private static string BuildBand(List<(double x, double y)> lo, List<(double x, double y)> up)
    {
        if (lo.Count == 0 || up.Count == 0 || lo.Count != up.Count) return "";
        var sb = new System.Text.StringBuilder($"M {lo[0].x:F1} {lo[0].y:F1}");
        for (int i = 1; i < lo.Count; i++) sb.Append($" L {lo[i].x:F1} {lo[i].y:F1}");
        for (int i = up.Count - 1; i >= 0; i--) sb.Append($" L {up[i].x:F1} {up[i].y:F1}");
        sb.Append(" Z");
        return sb.ToString();
    }
}
