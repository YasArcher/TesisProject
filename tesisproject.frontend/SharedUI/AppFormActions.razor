@namespace tesisproject.frontend.SharedUI
<div class="d-flex gap-2 justify-content-end mt-2">
    @if (ShowCancel)
    {
        <button type="button" class="btn btn-light border" @onclick="OnCancel">@(CancelText ?? "Cancelar")</button>
    }
    <button type="submit" class="btn btn-primary">@((PrimaryText ?? "Guardar"))</button>
</div>

@code {
    [Parameter] public bool ShowCancel { get; set; } = true;
    [Parameter] public string? PrimaryText { get; set; }
    [Parameter] public string? CancelText { get; set; }

    [Parameter] public EventCallback OnCancel { get; set; }
}
