@namespace tesisproject.frontend.SharedUI.Table
@using ArticleDto = tesisproject.shared.DTOs.Articles.ArticleDto

@if (Items?.Any() != true)
{
    <div class="rounded-xl border border-amber-300 bg-amber-50 px-4 py-3 text-amber-800 shadow-sm">
        No hay datos para mostrar.
    </div>
}
else
{
    <div class="overflow-hidden rounded-2xl border border-slate-200 shadow-md">
        <div class="max-h-[65vh] overflow-auto">
            <table class="min-w-full border-collapse">
                <thead class="sticky top-0 z-10 bg-gradient-to-b from-indigo-50 to-white/60 backdrop-blur">
                    <tr class="text-left text-[11px] font-semibold uppercase tracking-wider text-indigo-900/90">
                        <th class="px-4 py-3">Id</th>
                        <th class="px-4 py-3">Título</th>
                        <th class="px-4 py-3">Revista</th>
                        <th class="px-4 py-3">Período</th>
                        <th class="px-4 py-3">Estado</th>
                        <th class="px-4 py-3">Fecha pub.</th>
                        <th class="px-4 py-3">SJR</th>
                        <th class="px-4 py-3"></th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-200">
                    @foreach (var a in Items!)
                    {
                        var id = a?.Id ?? 0;
                        var titulo = a?.Titulo ?? "—";
                        var revista = a?.NombreRevista ?? "—";
                        var periodo = a?.PeriodoAcademico ?? "—";
                        var estado = a?.Estado ?? "—";
                        var fpub = a?.FechaPublicacion?.ToString("yyyy-MM-dd") ?? "—";
                        var sjr = a?.SJR?.ToString("0.###") ?? "—";
                        var link = a?.LinkPublicacion;
                        var href = string.IsNullOrWhiteSpace(link) ? "#" : link;

                        <tr class="odd:bg-white even:bg-slate-50 hover:bg-slate-100">
                            <td class="whitespace-nowrap px-4 py-3 text-sm text-slate-800">@id</td>
                            <td class="max-w-[420px] truncate px-4 py-3 text-sm text-slate-900" title="@titulo">@titulo</td>
                            <td class="max-w-[260px] truncate px-4 py-3 text-sm text-slate-800" title="@revista">@revista</td>
                            <td class="whitespace-nowrap px-4 py-3 text-sm text-slate-800">@periodo</td>
                            <td class="whitespace-nowrap px-4 py-3 text-sm">
                                <span class="@BadgeColor(estado)">@estado</span>
                            </td>
                            <td class="whitespace-nowrap px-4 py-3 text-sm text-slate-800">@fpub</td>
                            <td class="whitespace-nowrap px-4 py-3 text-sm text-slate-800">@sjr</td>
                            <td class="whitespace-nowrap px-4 py-3">
                                <div class="flex justify-end gap-2">
                                    <button class="rounded-lg bg-[#7A1E19] px-3 py-1.5 text-xs font-medium text-white shadow-sm hover:bg-[#8C2A24]"
                                            @onclick="() => OnEdit.InvokeAsync(id)">
                                        Editar
                                    </button>
                                    <a class="rounded-lg border border-slate-200 px-3 py-1.5 text-xs font-medium text-slate-700 hover:bg-slate-50 shadow-sm
                                                      @(string.IsNullOrWhiteSpace(link) ? "pointer-events-none opacity-50" : "")"
                                       target="_blank" rel="noopener" href="@href">
                                        Ver
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    [Parameter] public IEnumerable<ArticleDto>? Items { get; set; }
    [Parameter] public EventCallback<int> OnEdit { get; set; }

    private static string BadgeColor(string? estado) => (estado ?? "").ToUpperInvariant() switch
    {
        "PUBLICADO" => "inline-flex items-center rounded-full bg-emerald-100 px-2 py-0.5 text-xs font-semibold text-emerald-700 ring-1 ring-emerald-200/60",
        "ACEPTADO" => "inline-flex items-center rounded-full bg-indigo-100  px-2 py-0.5 text-xs font-semibold text-indigo-700  ring-1 ring-indigo-200/60",
        "EN REVISIÓN" => "inline-flex items-center rounded-full bg-amber-100   px-2 py-0.5 text-xs font-semibold text-amber-700   ring-1 ring-amber-200/60",
        "RECHAZADO" => "inline-flex items-center rounded-full bg-rose-100    px-2 py-0.5 text-xs font-semibold text-rose-700    ring-1 ring-rose-200/60",
        _ => "inline-flex items-center rounded-full bg-slate-100   px-2 py-0.5 text-xs font-semibold text-slate-700   ring-1 ring-slate-200/60",
    };
}
