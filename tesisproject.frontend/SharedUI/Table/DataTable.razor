@typeparam TItem
@using tesisproject.frontend.SharedUI.ActionButton

<div class="w-full min-w-0 overflow-x-auto">
    <table class="min-w-full divide-y divide-border">
        <thead>
            <tr>
                @for (var i = 0; i < Columns.Count; i++)
                {
                    var col = Columns[i];
                    var sortable = col.Sortable;

                    <th scope="col"
                        class="sticky top-0 z-10 bg-primary-subtle px-4 py-3 text-left text-xs font-semibold text-foreground uppercase tracking-wider select-none"
                        style="@(string.IsNullOrWhiteSpace(col.Width) ? null : $"width:{col.Width}")">

                        <ActionButton Execute="@(() => OnHeaderClick(i))"
                                      Variant="ButtonVariant.Ghost"
                                      Size="ButtonSize.Sm"
                                      Disabled="@(!sortable)"
                                      Class="btn-primary-ghost inline-flex items-center gap-1 group px-0 py-0">
                            <ChildContent>
                                <span>@col.Title</span>
                                @if (sortable)
                                {
                                    <span class="text-muted group-hover:text-primary text-[10px]">
                                        @GetSortGlyph(i)
                                    </span>
                                }
                            </ChildContent>
                        </ActionButton>
                    </th>
                }
            </tr>
        </thead>

        <tbody class="bg-background divide-y divide-border">
            @if (ViewItems is null || !ViewItems.Any())
            {
                <tr class="odd:bg-primary-subtle hover:bg-primary-subtle-hover">
                    <td class="px-4 py-4 text-sm text-muted" colspan="@Columns.Count">@EmptyText</td>
                </tr>
            }
            else if (RowTemplate is not null)
            {
                @foreach (var item in ViewItems)
                {
                    <tr class="odd:bg-primary-subtle hover:bg-primary-subtle-hover">
                        @RowTemplate(item)
                    </tr>
                }
            }
            else
            {
                @foreach (var item in ViewItems)
                {
                    <tr class="odd:bg-primary-subtle hover:bg-primary-subtle-hover">
                        @for (var i = 0; i < Columns.Count; i++)
                        {
                            <td class="px-4 py-3 text-sm text-foreground align-middle">
                                @Columns[i].ValueSelector(item)
                            </td>
                        }
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@if (ShowPager)
{
    <nav class="mt-4 flex items-center justify-between" aria-label="Table pagination">
        <div class="text-sm text-muted">
            Page <span class="font-medium text-foreground">@CurrentPage</span>
            of <span class="font-medium text-foreground">@TotalPages</span>
        </div>

        <div class="inline-flex items-center gap-1">
            <ActionButton Execute="PrevPageAsync"
                          Variant="ButtonVariant.Outline"
                          Size="ButtonSize.Sm"
                          Disabled="@_isFirstPage"
                          Class="btn-primary-outline px-3 py-1.5 rounded-lg text-sm">
                <Icon>
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6">
                        <path fill-rule="evenodd" d="M7.72 12.53a.75.75 0 0 1 0-1.06l7.5-7.5a.75.75 0 1 1 1.06 1.06L9.31 12l6.97 6.97a.75.75 0 1 1-1.06 1.06l-7.5-7.5Z" clip-rule="evenodd" />
                    </svg>
                </Icon>
            </ActionButton>

            @foreach (var p in VisiblePages)
            {
                if (p == -1)
                {
                    <span class="px-2 text-muted">…</span>
                }
                else
                {
                    var isActive = p == CurrentPage;

                    <ActionButton Text="@p.ToString()"
                                  Execute="@( () => ChangePageAsync(p) )"
                                  Variant="@( isActive ? ButtonVariant.Filled : ButtonVariant.Outline )"
                                  Size="ButtonSize.Sm"
                                  Class="@( isActive ? "btn-primary-solid" : "btn-primary-outline" )"
                                  AdditionalAttributes="@(isActive ? new Dictionary<string, object>{{"aria-pressed","true"}} : null)" />
                }
            }

            <ActionButton Execute="NextPageAsync"
                          Variant="ButtonVariant.Outline"
                          Size="ButtonSize.Sm"
                          Disabled="@_isLastPage"
                          Class="btn-primary-outline px-3 py-1.5 rounded-lg text-sm">
                <Icon>
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6">
                        <path fill-rule="evenodd" d="M16.28 11.47a.75.75 0 0 1 0 1.06l-7.5 7.5a.75.75 0 0 1-1.06-1.06L14.69 12 7.72 5.03a.75.75 0 0 1 1.06-1.06l7.5 7.5Z" clip-rule="evenodd" />
                    </svg>
                </Icon>
            </ActionButton>
        </div>
    </nav>
}