@namespace tesisproject.frontend.SharedUI
@typeparam TItem

<div class="@TableContainerClass">
    <table class="@TableClass">
        <thead class="@HeaderClass">
            <tr>
                @foreach (var column in Columns)
                {
                    <th class="@GetHeaderCellClass(column)"
                        @onclick="@(() => SortByColumn(column))"
                        style="cursor: @(column.IsSortable ? "pointer" : "default")">
                        @column.Title
                        @if (column.IsSortable && SortedColumn == column.PropertyName)
                        {
                            <i class="bi @(SortAscending ? "bi-sort-down" : "bi-sort-up") ml-1"></i>
                        }
                    </th>
                }
            </tr>
        </thead>
        <tbody class="@BodyClass">
            @if (Items?.Any() == true)
            {
                @foreach (var item in SortedItems)
                {
                    <tr class="@GetRowClass(item)">
                        @foreach (var column in Columns)
                        {
                            <td class="@GetCellClass(column)">
                                @if (column.Template != null)
                                {
                                    @column.Template(item)
                                }
                                else
                                {
                                    @GetPropertyValue(item, column.PropertyName)
                                }
                            </td>
                        }
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="@Columns.Count" class="text-center py-8 text-gray-500">
                        <i class="bi bi-inbox text-4xl opacity-25 mb-2"></i>
                        <p>No se encontraron registros</p>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    [Parameter] public List<TItem>? Items { get; set; }
    [Parameter] public List<ColumnDefinition<TItem>> Columns { get; set; } = new();
    [Parameter] public bool IsStriped { get; set; }
    [Parameter] public bool IsHoverable { get; set; }
    [Parameter] public bool IsResponsive { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public Func<TItem, string>? RowClassFunc { get; set; }

    private string SortedColumn = string.Empty;
    private bool SortAscending = true;

    private IEnumerable<TItem> SortedItems
    {
        get
        {
            if (Items == null) return Enumerable.Empty<TItem>();
            if (string.IsNullOrEmpty(SortedColumn)) return Items;

            var property = typeof(TItem).GetProperty(SortedColumn);
            if (property == null) return Items;

            return SortAscending
                ? Items.OrderBy(x => property.GetValue(x))
                : Items.OrderByDescending(x => property.GetValue(x));
        }
    }

    private string TableContainerClass => $"{(IsResponsive ? "overflow-x-auto" : "")} {Class}";

    private string TableClass
    {
        get
        {
            var baseClass = "min-w-full divide-y divide-gray-200";
            return baseClass;
        }
    }

    private string HeaderClass => "bg-gray-50";

    private string BodyClass => "bg-white divide-y divide-gray-200";

    private string GetHeaderCellClass(ColumnDefinition<TItem> column)
    {
        var baseClass = "px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider";
        var sortableClass = column.IsSortable ? "hover:bg-gray-100 transition-colors" : "";
        return $"{baseClass} {sortableClass}";
    }

    private string GetRowClass(TItem item)
    {
        var baseClass = "";
        if (IsStriped) baseClass += " even:bg-gray-50";
        if (IsHoverable) baseClass += " hover:bg-gray-100 transition-colors";
        if (RowClassFunc != null) baseClass += $" {RowClassFunc(item)}";
        return baseClass.Trim();
    }

    private string GetCellClass(ColumnDefinition<TItem> column)
    {
        return "px-6 py-4 whitespace-nowrap text-sm text-gray-900";
    }

    private void SortByColumn(ColumnDefinition<TItem> column)
    {
        if (!column.IsSortable) return;

        if (SortedColumn == column.PropertyName)
        {
            SortAscending = !SortAscending;
        }
        else
        {
            SortedColumn = column.PropertyName;
            SortAscending = true;
        }
    }

    private string GetPropertyValue(TItem item, string propertyName)
    {
        if (string.IsNullOrEmpty(propertyName)) return string.Empty;

        var property = typeof(TItem).GetProperty(propertyName);
        return property?.GetValue(item)?.ToString() ?? string.Empty;
    }
}