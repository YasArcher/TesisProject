@typeparam TItem

<div class="w-full overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50 sticky top-0 z-10">
            <tr>
                @for (var i = 0; i < Columns.Count; i++)
                {
                    var col = Columns[i];
                    var sortable = col.Sortable;
                    <th scope="col"
                        class="px-4 py-3 text-left text-xs font-semibold text-gray-700 uppercase tracking-wider select-none"
                        style="@(string.IsNullOrWhiteSpace(col.Width) ? null : $"width:{col.Width}")">
                        <button type="button"
                                class="inline-flex items-center gap-1 group"
                                disabled="@(sortable ? null : true)"
                                @onclick="(() => OnHeaderClick(i))">
                            <span>@col.Title</span>
                            @if (sortable)
                            {
                                <span class="text-gray-400 group-hover:text-gray-600 text-[10px]">
                                    @GetSortGlyph(i)
                                </span>
                            }
                        </button>
                    </th>
                }
            </tr>
        </thead>

        <tbody class="bg-white divide-y divide-gray-100">
            @if (ViewItems is null || !ViewItems.Any())
            {
                <tr class="odd:bg-gray-50 hover:bg-gray-50">
                    <td class="px-4 py-4 text-sm text-gray-500" colspan="@Columns.Count">@EmptyText</td>
                </tr>
            }
            else if (RowTemplate is not null)
            {
                @foreach (var item in ViewItems)
                {
                    <tr class="odd:bg-gray-50 hover:bg-gray-50">
                        @RowTemplate(item)
                    </tr>
                }
            }
            else
            {
                @foreach (var item in ViewItems)
                {
                    <tr class="odd:bg-gray-50 hover:bg-gray-50">
                        @for (var i = 0; i < Columns.Count; i++)
                        {
                            <td class="px-4 py-3 text-sm text-gray-700 align-middle">
                                @Columns[i].ValueSelector(item)
                            </td>
                        }
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@if (ShowPager)
{
    <nav class="mt-4 flex items-center justify-between" aria-label="Table pagination">
        <div class="text-sm text-gray-600">
            Page <span class="font-medium">@CurrentPage</span> of <span class="font-medium">@TotalPages</span>
        </div>

        <div class="inline-flex items-center gap-1">
            <button class="px-3 py-1.5 border rounded-lg text-sm disabled:opacity-50"
                    disabled="@(_isFirstPage)"
                    @onclick="PrevPage">
                Prev
            </button>

            @foreach (var p in VisiblePages)
            {
                if (p == -1)
                {
                    <span class="px-2 text-gray-500">…</span>
                }
                else
                {
                    <button class="px-3 py-1.5 border rounded-lg text-sm
                                               @(p == CurrentPage ? "bg-gray-900 text-white border-gray-900" : "bg-white")"
                            @onclick="(() => ChangePage(p))">
                        @p
                    </button>
                }
            }

            <button class="px-3 py-1.5 border rounded-lg text-sm disabled:opacity-50"
                    disabled="@(_isLastPage)"
                    @onclick="NextPage">
                Next
            </button>
        </div>
    </nav>
}