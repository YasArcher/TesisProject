
<div class="@FieldClass">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label for="@Id" class="block text-sm font-medium text-gray-700 mb-2">
            @Label
            @if (Required)
            {
                <span class="text-red-500">*</span>
            }
        </label>
    }
    
    <div class="relative rounded-md shadow-sm">
        <select id="@Id"
                class="@SelectClass"
                @bind="SelectedValue"
                //agregar onchange
                disabled="@Disabled">
            @if (!string.IsNullOrEmpty(Placeholder))
            {
                <option value="">@Placeholder</option>
            }
            @foreach (var item in Items)
            {
                <option value="@item.Value">@item.Text</option>
            }
        </select>
        
        <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-2">
            <i class="bi bi-chevron-down text-gray-400"></i>
        </div>
    </div>
    
    @if (!string.IsNullOrEmpty(HelpText))
    {
        <p class="mt-1 text-sm text-gray-500">@HelpText</p>
    }
</div>

@code {
    [Parameter] public string? Id { get; set; } = Guid.NewGuid().ToString();
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public string? HelpText { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public SelectSize Size { get; set; } = SelectSize.Default;
    [Parameter] public string? Class { get; set; }
    [Parameter] public List<SelectItem> Items { get; set; } = new();
    [Parameter] public string? SelectedValue { get; set; }
    [Parameter] public EventCallback<string> SelectedValueChanged { get; set; }
    [Parameter] public EventCallback OnChange { get; set; }

    private string FieldClass => $"mb-4 {Class}".Trim();
    
    private string SelectClass
    {
        get
        {
            var baseClass = "block w-full rounded-lg border-gray-300 focus:ring-2 focus:ring-[#7A1E19] focus:border-transparent transition-colors appearance-none bg-white";
            var sizeClass = Size switch
            {
                SelectSize.Small => "py-1 px-3 text-sm",
                SelectSize.Default => "py-2 px-4",
                SelectSize.Large => "py-3 px-4 text-lg",
                _ => "py-2 px-4"
            };
            var disabledClass = Disabled ? "bg-gray-100 cursor-not-allowed" : "";
            return $"{baseClass} {sizeClass} {disabledClass}";
        }
    }

    public async Task HandleChange(ChangeEventArgs e)
    {
        SelectedValue = e.Value?.ToString();
        if (SelectedValueChanged.HasDelegate)
        {
            await SelectedValueChanged.InvokeAsync(SelectedValue);
        }
        if (OnChange.HasDelegate)
        {
            await OnChange.InvokeAsync(e);
        }
    }
}