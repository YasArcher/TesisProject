@namespace tesisproject.frontend.SharedUI

<div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden @Class">
    @if (!string.IsNullOrEmpty(Header) || HeaderContent != null)
    {
        <div class="bg-gradient-to-r from-gray-50 to-white px-6 py-4 border-b border-gray-200">
            @if (HeaderContent != null)
            {
                @HeaderContent
            }
            else
            {
                <h3 class="text-xl font-semibold text-gray-900 flex items-center">
                    @if (!string.IsNullOrEmpty(Icon))
                    {
                        <i class="@Icon mr-3 text-[#7A1E19]"></i>
                    }
                    @Header
                </h3>
            }
        </div>
    }

    @if (ChildContent != null)
    {
        <CardBody>
            @ChildContent
        </CardBody>
    }

    @if (Footer != null)
    {
        <CardFooter>
            @Footer
        </CardFooter>
    }
</div>

@code {
    [Parameter] public string? Header { get; set; }
    [Parameter] public string? Icon { get; set; }
    [Parameter] public RenderFragment? HeaderContent { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Footer { get; set; }
    [Parameter] public string? Class { get; set; }
}