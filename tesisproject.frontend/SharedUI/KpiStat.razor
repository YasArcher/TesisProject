@namespace tesisproject.frontend.SharedUI

<div class="rounded-2xl border border-slate-700 bg-slate-900/60 p-4">
    <div class="text-slate-400 text-sm">@Titulo</div>
    <div class="text-2xl font-semibold text-slate-100">@Valor</div>
    @if (!string.IsNullOrWhiteSpace(Detalle))
    {
        <div class="text-xs text-slate-400 mt-1">@Detalle</div>
    }
    @if (Progreso is not null)
    {
        <div class="mt-3 h-2 w-full rounded bg-slate-800 overflow-hidden">
            <div class="h-full bg-indigo-500" style="width:@Progreso%"></div>
        </div>
    }
</div>

@code {
    [Parameter] public string Titulo { get; set; } = "";
    [Parameter] public string Valor { get; set; } = "";
    [Parameter] public string? Detalle { get; set; }
    [Parameter] public double? Progreso { get; set; }
}
