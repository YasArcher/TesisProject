@using tesisproject.shared.DTOs.Articles

@if (IsOpen && Model is not null)
{
    <div class="fixed inset-0 bg-black/50 flex items-center justify-center z-50">
        <div class="bg-white rounded-2xl shadow-xl w-full max-w-3xl p-6">
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-lg font-semibold">Previsualización del artículo</h3>
                <button class="px-3 py-1 rounded-md border" @onclick="Close">Cerrar</button>
            </div>

            <div class="space-y-2">
                <div><strong>Título:</strong> @Model.Title</div>
                <div><strong>DOI:</strong> @Model.Doi</div>
                <div><strong>Año:</strong> @Model.Year</div>
                <div><strong>URL publicación:</strong> @Model.PublicationUrl</div>

                <div class="grid grid-cols-2 gap-3">
                    <div><strong>Open Access:</strong> @(Model.IsOpenAccess ? "Sí" : "No")</div>
                    <div><strong>Resultado de proyecto:</strong> @(Model.IsProjectResult ? "Sí" : "No")</div>
                </div>

                <div class="grid grid-cols-2 gap-3">
                    @if (Model.PublicationStatusId is not null)
                    {
                        <div><strong>Estado (ID):</strong> @Model.PublicationStatusId</div>
                    }

                    @if (Model.ResearchLineId is not null)
                    {
                        <div><strong>Línea (ID):</strong> @Model.ResearchLineId</div>
                    }
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div><strong>Revista:</strong> @Model.VenueName</div>
                    <div><strong>ISSN:</strong> @Model.IssnCode</div>
                    <div><strong>Volumen:</strong> @Model.VolumeNumber</div>
                    <div><strong>Número:</strong> @Model.IssueNumber</div>
                    <div><strong>SJR:</strong> @Model.Sjr</div>
                    <div><strong>Quartile:</strong> @Model.Quartile</div>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.EvidenceUrl))
                {
                    <div><strong>Evidencia:</strong> <a href="@Model.EvidenceUrl" target="_blank">@Model.EvidenceUrl</a></div>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public ArticleDetailDto? Model { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private Task Close() => OnClose.InvokeAsync();
}
