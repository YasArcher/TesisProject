@namespace tesisproject.frontend.SharedUI.Board
@using tesisproject.shared.DTOs.Articles
@using tesisproject.frontend.SharedUI
@using tesisproject.frontend.SharedUI.Card

<div class="flex flex-col bg-slate-50 rounded-2xl border border-slate-200 p-3 max-h-[70vh]">
    <div class="flex items-center justify-between mb-2">
        <div>
            <h3 class="text-xs font-semibold uppercase tracking-wide text-slate-500">@Title</h3>
            <p class="text-[11px] text-slate-400">@((Items?.Count() ?? 0)) artículos</p>
        </div>
    </div>

    <div class="mt-1 space-y-3 overflow-y-auto pr-1">
        @if (Items is null || !Items.Any())
        {
            <div class="text-xs text-slate-400 italic px-1 py-2">
                Sin artículos en esta columna.
            </div>
        }
        else
        {
            @foreach (var item in Items)
            {
                <AppCard class="shadow-sm border-l-4 border-emerald-400">
                    <CardBody>
                        <div class="text-sm font-semibold text-slate-900 line-clamp-2">
                            @item.Title
                        </div>
                        <div class="text-[11px] text-slate-500 mt-1 line-clamp-1">
                            @item.VenueName
                        </div>

                        <div class="mt-2 flex flex-wrap gap-1">
                            <Badge Text="@item.PublicationStatusName" Variant="BadgeVariant.Success" />
                            <Badge Text="@item.AcademicTermName" Variant="BadgeVariant.Neutral" />
                            <Badge Text="@((item.PublicationYear?.ToString() ?? "-"))" Variant="BadgeVariant.NeutralSoft" />
                        </div>

                        <div class="mt-3 flex justify-end">
                            <ActionButton Text="Ver más"
                                          Size="sm"
                                          Variant="ButtonVariant.Outline"
                                          Intent="ButtonIntent.Primary"
                                          Icon="hero-eye"
                                          OnClick="() => OnViewMore.InvokeAsync(item)" />
                        </div>
                    </CardBody>
                </AppCard>
            }
        }
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public IEnumerable<ArticleListItemDto>? Items { get; set; }
    [Parameter] public EventCallback<ArticleListItemDto> OnViewMore { get; set; }
}
