@using tesisproject.shared.DTOs.Reports
@using tesisproject.shared.DTOs.Catalogs    
@using System.Linq

<div class="bg-white border border-slate-200 rounded-2xl shadow-sm p-5">
    <div class="flex items-center justify-between mb-4">
        <div>
            <h3 class="text-lg font-semibold text-slate-800">Filtros avanzados</h3>
            <p class="text-sm text-slate-500">Aplica múltiples filtros para analizar datos específicos</p>
        </div>
        <button @onclick="ToggleFilters"
                class="inline-flex items-center gap-2 rounded-lg border border-slate-300 px-3 py-1.5 text-sm hover:bg-slate-50">
            <span class="material-icons text-base">@(_expanded ? "expand_less" : "expand_more")</span>
            @(_expanded ? "Contraer" : "Expandir")
        </button>
    </div>

    @if (_expanded)
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            <!-- Filtro de fechas -->
            <div class="space-y-3">
                <h4 class="text-sm font-medium text-slate-700 flex items-center gap-2">
                    <span class="material-icons text-base">calendar_today</span>
                    Fechas
                </h4>

                <div class="space-y-2">
                    <div>
                        <label class="block text-xs font-medium text-slate-600 mb-1">Nivel de fecha</label>
                        <select @bind="_selectedDateLevel"
                                class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm">
                            <option value="">Seleccionar nivel</option>
                            <option value="day">Día</option>
                            <option value="month">Mes</option>
                            <option value="quarter">Trimestre</option>
                            <option value="year">Año</option>
                            <option value="week">Semana</option>
                        </select>
                    </div>

                    <div>
                        <label class="block text-xs font-medium text-slate-600 mb-1">Fecha desde</label>
                        <input type="date" @bind="_dateFrom"
                               class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" />
                    </div>

                    <div>
                        <label class="block text-xs font-medium text-slate-600 mb-1">Fecha hasta</label>
                        <input type="date" @bind="_dateTo"
                               class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" />
                    </div>
                </div>
            </div>

            <!-- Filtro de dimensiones académicas -->
            <div class="space-y-3">
                <h4 class="text-sm font-medium text-slate-700 flex items-center gap-2">
                    <span class="material-icons text-base">school</span>
                    Dimensiones académicas
                </h4>

                <div class="space-y-2">
                    <div>
                        <label class="block text-xs font-medium text-slate-600 mb-1">Línea de investigación</label>
                        <select @bind="_selectedResearchLineId" multiple
                                class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm h-32">
                            <option value="">Seleccionar todas</option>
                            @foreach (var line in ResearchLines)
                            {
                                <option value="@line.Id">@line.Name</option>
                            }
                        </select>
                        <div class="text-xs text-slate-500 mt-1">
                            Mantén Ctrl para seleccionar múltiples
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-medium text-slate-600 mb-1">Campo amplio</label>
                        <select @bind="_selectedBroadFieldId" multiple
                                class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm h-24">
                            <option value="">Seleccionar todas</option>
                            @foreach (var field in BroadFields)
                            {
                                <option value="@field.Id">@field.Name</option>
                            }
                        </select>
                    </div>
                </div>
            </div>

            <!-- Filtro de características -->
            <div class="space-y-3">
                <h4 class="text-sm font-medium text-slate-700 flex items-center gap-2">
                    <span class="material-icons text-base">tune</span>
                    Características
                </h4>

                <div class="space-y-3">
                    <div>
                        <label class="block text-xs font-medium text-slate-600 mb-1">Open Access</label>
                        <select @bind="_openAccessFilter"
                                class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm">
                            <option value="">Todos</option>
                            <option value="true">Solo Open Access</option>
                            <option value="false">Solo no Open Access</option>
                        </select>
                    </div>

                    <div>
                        <label class="block text-xs font-medium text-slate-600 mb-1">Cuartiles</label>
                        <div class="flex flex-wrap gap-2">
                            @foreach (var quartile in new[] { "Q1", "Q2", "Q3", "Q4", "SIN_CUARTIL" })
                            {
                                <label class="inline-flex items-center">
                                    <input type="checkbox"
                                           checked="@(_selectedQuartiles?.Contains(quartile) ?? false)"
                                           @onchange="@((e) => ToggleQuartile(quartile, e.Value is bool isChecked && isChecked))"
                                           class="rounded border-slate-300 text-[#7A1E19]" />
                                    <span class="ml-1 text-sm">@quartile</span>
                                </label>
                            }
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-medium text-slate-600 mb-1">Índice en</label>
                        <select @bind="_selectedIndexingSourceId" multiple
                                class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm h-24">
                            <option value="">Seleccionar todas</option>
                            @foreach (var source in IndexingSources)
                            {
                                <option value="@source.Id">@source.Name</option>
                            }
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <!-- Botones de acción -->
        <div class="flex justify-between items-center mt-6 pt-4 border-t border-slate-200">
            <div class="text-sm text-slate-500">
                @if (ActiveFiltersCount > 0)
                {
                    <span class="inline-flex items-center gap-1 rounded-full bg-blue-100 px-3 py-1 text-blue-700">
                        <span class="material-icons text-sm">filter_alt</span>
                        @ActiveFiltersCount filtro(s) activo(s)
                    </span>
                }
            </div>
            <div class="flex gap-2">
                <button @onclick="ClearAllFilters"
                        class="inline-flex items-center gap-2 rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50">
                    <span class="material-icons text-sm">clear_all</span>
                    Limpiar todos
                </button>
                <button @onclick="ApplyFilters"
                        class="inline-flex items-center gap-2 rounded-lg bg-[#7A1E19] px-4 py-2 text-sm font-medium text-white hover:bg-[#681813]">
                    <span class="material-icons text-sm">filter_alt</span>
                    Aplicar filtros
                </button>
            </div>
        </div>
    }
</div>

@code {
    private bool _expanded = true;

    // Filtros de fecha
    private string? _selectedDateLevel;
    private DateTime? _dateFrom;
    private DateTime? _dateTo;

    // Filtros académicos
    private List<int> _selectedResearchLineIds = new();
    private int? _selectedResearchLineId;
    private List<int> _selectedBroadFieldIds = new();
    private int? _selectedBroadFieldId;

    // Filtros de características
    private string? _openAccessFilter;
    private List<string>? _selectedQuartiles;
    private List<int> _selectedIndexingSourceIds = new();
    private int? _selectedIndexingSourceId;

    // Catálogos
    [Parameter]
    public List<CatalogItemDto> ResearchLines { get; set; } = new();

    [Parameter]
    public List<CatalogItemDto> BroadFields { get; set; } = new();

    [Parameter]
    public List<CatalogItemDto> IndexingSources { get; set; } = new();

    [Parameter]
    public EventCallback<ArticlesDashboardFilterDto> OnFiltersChanged { get; set; }

    private int ActiveFiltersCount
    {
        get
        {
            int count = 0;
            if (_dateFrom.HasValue || _dateTo.HasValue) count++;
            if (!string.IsNullOrEmpty(_selectedDateLevel)) count++;
            if (_selectedResearchLineIds.Any()) count++;
            if (_selectedBroadFieldIds.Any()) count++;
            if (!string.IsNullOrEmpty(_openAccessFilter)) count++;
            if (_selectedQuartiles?.Any() == true) count++;
            if (_selectedIndexingSourceIds.Any()) count++;
            return count;
        }
    }

    private void ToggleFilters()
    {
        _expanded = !_expanded;
    }

    private void ToggleQuartile(string quartile, bool isChecked)
    {
        _selectedQuartiles ??= new List<string>();

        if (isChecked && !_selectedQuartiles.Contains(quartile))
        {
            _selectedQuartiles.Add(quartile);
        }
        else if (!isChecked && _selectedQuartiles.Contains(quartile))
        {
            _selectedQuartiles.Remove(quartile);
        }
    }

    private async Task ApplyFilters()
    {
        // Convertir filtros a DTO
        var filter = new ArticlesDashboardFilterDto
        {
            CreatedFrom = _dateFrom,
            CreatedTo = _dateTo,
            PublicationFrom = _dateFrom,
            PublicationTo = _dateTo,
            ResearchLineKeys = _selectedResearchLineIds.Any() ? _selectedResearchLineIds : null,
            FieldKeys = _selectedBroadFieldIds.Any() ? _selectedBroadFieldIds : null,
            IsOpenAccess = string.IsNullOrEmpty(_openAccessFilter) ? null : bool.Parse(_openAccessFilter),
            Quartiles = _selectedQuartiles?.Any() == true ? _selectedQuartiles : null,
            IndexingSourceKeys = _selectedIndexingSourceIds.Any() ? _selectedIndexingSourceIds : null
        };

        await OnFiltersChanged.InvokeAsync(filter);
    }

    private async Task ClearAllFilters()
    {
        _selectedDateLevel = null;
        _dateFrom = null;
        _dateTo = null;
        _selectedResearchLineIds.Clear();
        _selectedResearchLineId = null;
        _selectedBroadFieldIds.Clear();
        _selectedBroadFieldId = null;
        _openAccessFilter = null;
        _selectedQuartiles?.Clear();
        _selectedIndexingSourceIds.Clear();
        _selectedIndexingSourceId = null;

        // Aplicar filtros vacíos
        await OnFiltersChanged.InvokeAsync(new ArticlesDashboardFilterDto());
    }
}
