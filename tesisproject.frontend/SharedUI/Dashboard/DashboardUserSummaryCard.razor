<div class="rounded-2xl shadow-lg bg-gradient-to-r from-[#1c5052] to-[#800909] text-white p-5 min-w-[260px]">
    <div class="flex items-center justify-between">

        <!-- Usuario -->
        <div class="flex items-center gap-4">
            <div class="w-14 h-14 flex items-center justify-center rounded-full bg-white/20 border-2 border-white/30 font-bold text-lg">
                @Initials
            </div>

            <div>
                <p class="text-sm font-semibold">@UserName</p>
                <p class="text-xs opacity-80">@Role</p>
            </div>
        </div>

        <!-- Hora y fecha -->
        <div class="text-right">
            <div class="text-xl font-mono bg-black/20 px-3 py-1 rounded-lg">@Time</div>
            <div class="text-xs mt-1 opacity-80">@Date</div>
        </div>
    </div>
</div>

@code {
    [Parameter] public string UserName { get; set; } = "";
    [Parameter] public string Initials { get; set; } = "";
    [Parameter] public string Role { get; set; } = "";
    [Parameter] public string Time { get; set; } = "";
    [Parameter] public string Date { get; set; } = "";
    [Parameter] public string HeaderText { get; set; } = "";
}
