<div class="@($"flex items-center gap-4 p-4 border-l-4 rounded-xl {ContainerClass}")">

    <!-- Punto -->
    <div class="@($"w-2 h-2 rounded-full {DotClass}")"></div>

    <!-- Texto -->
    <div class="flex-1">
        <p class="@($"text-sm font-medium {TitleClass}")">@Title</p>
        <p class="@($"text-sm {DescriptionClass}")">@((MarkupString)Description)</p>
    </div>

    <span class="text-xs text-slate-500">@TimeAgo</span>
</div>

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Description { get; set; } = "";
    [Parameter] public string TimeAgo { get; set; } = "";

    [Parameter] public string ContainerClass { get; set; } = "";
    [Parameter] public string DotClass { get; set; } = "";
    [Parameter] public string TitleClass { get; set; } = "";
    [Parameter] public string DescriptionClass { get; set; } = "";
}
