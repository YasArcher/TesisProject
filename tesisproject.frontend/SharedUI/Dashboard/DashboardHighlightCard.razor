<div class="@($"rounded-2xl p-5 shadow-sm border {ContainerClass}")">
    <div class="flex items-start gap-4">
        <div class="@($"w-12 h-12 flex items-center justify-center rounded-xl {IconContainerClass}")">
            <i class="@IconCss"></i>
        </div>

        <div class="flex-1">
            <h3 class="@($"text-base font-semibold {TitleClass}")">@Title</h3>
            <p class="@($"text-sm mt-2 {DescriptionClass}")">@Description</p>
        </div>
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Description { get; set; } = "";
    [Parameter] public string IconCss { get; set; } = "";

    [Parameter] public string ContainerClass { get; set; } = "";
    [Parameter] public string IconContainerClass { get; set; } = "";
    [Parameter] public string TitleClass { get; set; } = "";
    [Parameter] public string DescriptionClass { get; set; } = "";
}
