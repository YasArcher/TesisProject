@using System.Linq.Expressions
@using tesisproject.shared.DTOs.Catalogs

<div class="flex flex-col gap-1">
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <label class="text-sm font-medium">@Label</label>
    }

    @if (Multiple)
    {
        <select multiple class="w-full rounded-md border px-3 py-2" @onchange="OnMultiChanged">
            @if (!string.IsNullOrWhiteSpace(Placeholder))
            {
                <option disabled>@Placeholder</option>
            }
            @if (Items != null)
            {
                @foreach (var it in Items)
                {
                    <option value="@it.Id" selected="@IsSelected(it.Id)">@it.Name</option>
                }
            }
        </select>
    }
    else
    {
        <InputSelect @bind-Value="Value" class="w-full rounded-md border px-3 py-2">
            @if (!string.IsNullOrWhiteSpace(Placeholder))
            {
                <option value="">@Placeholder</option>
            }
            @if (Items != null)
            {
                @foreach (var it in Items)
                {
                    <option value="@it.Id">@it.Name</option>
                }
            }
        </InputSelect>
    }

    @if (!string.IsNullOrWhiteSpace(HelpText))
    {
        <small class="text-xs text-slate-500">@HelpText</small>
    }
</div>

@code {
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? HelpText { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public bool Multiple { get; set; }

    [Parameter] public List<CatalogItemDto>? Items { get; set; }

    // Single select (para @bind-Value)
    [Parameter] public int? Value { get; set; }
    [Parameter] public EventCallback<int?> ValueChanged { get; set; }
    [Parameter] public Expression<Func<int?>>? ValueExpression { get; set; }

    // Multi select (para @bind-Values)
    [Parameter] public List<int> Values { get; set; } = new();
    [Parameter] public EventCallback<List<int>> ValuesChanged { get; set; }
    [Parameter] public Expression<Func<List<int>>>? ValuesExpression { get; set; }

    private bool IsSelected(int id) => Values?.Contains(id) == true;

    private async Task OnMultiChanged(ChangeEventArgs e)
    {
        var list = new List<int>();

        if (e.Value is string only && int.TryParse(only, out var one))
        {
            list.Add(one);
        }
        else if (e.Value is IEnumerable<string> many)
        {
            foreach (var s in many)
                if (int.TryParse(s, out var v))
                    list.Add(v);
        }

        Values = list.Distinct().ToList();
        await ValuesChanged.InvokeAsync(Values);
    }
}
