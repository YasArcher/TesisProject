@namespace tesisproject.frontend.SharedUI

<div class="bg-gradient-to-r from-[#7A1E19] to-[#9C4A3C] rounded-b-2xl shadow-lg mb-8 @BackgroundClass">
    <div class="px-6 py-8">
        <!-- Breadcrumb -->
        @if (!string.IsNullOrEmpty(Breadcrumb))
        {
            <nav class="flex items-center space-x-2 text-white/80 mb-4">
                @Breadcrumb
            </nav>
        }

        <!-- Title and Description -->
        <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between">
            <div class="flex-1">
                <div class="flex items-center space-x-4 mb-3">
                    @if (!string.IsNullOrEmpty(Icon))
                    {
                        <div class="w-12 h-12 bg-white/20 rounded-xl flex items-center justify-center">
                            <i class="@Icon text-white text-xl"></i>
                        </div>
                    }
                    <div>
                        <h1 class="text-3xl font-bold text-white">@Title</h1>
                        @if (!string.IsNullOrEmpty(Subtitle))
                        {
                            <p class="text-white/80 mt-1">@Subtitle</p>
                        }
                    </div>
                    @if (!string.IsNullOrEmpty(BadgeText))
                    {
                        <span class="bg-white/20 text-white px-3 py-1 rounded-full text-sm font-medium backdrop-blur-sm">
                            @BadgeText
                        </span>
                    }
                </div>
            </div>

            <!-- Actions -->
            @if (Actions != null)
            {
                <div class="mt-4 lg:mt-0">
                    @Actions
                </div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public string? Icon { get; set; }
    [Parameter] public string? BadgeText { get; set; }
    [Parameter] public string? Breadcrumb { get; set; }
    [Parameter] public string? BackgroundClass { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
}