@using tesisproject.frontend.SharedUI.ConfirmDialog

<button class="@BuildClass()"
        disabled="@(_isBusy || Disabled)"
        @attributes="AdditionalAttributes"
        @onclick="OnClickInternal">
    <span class="inline-flex items-center gap-2">
        @if (_isBusy)
        {
            <span class="animate-spin inline-block h-4 w-4 border-2 border-current border-t-transparent rounded-full"></span>
        }
        else if (Icon is not null)
        {
            @Icon
        }

        @if (!string.IsNullOrWhiteSpace(Text))
        {
            <span>@Text</span>
        }
        else
        {
            @ChildContent
        }
    </span>
</button>

@* OPTIMIZACIÓN: Solo renderiza ConfirmDialog cuando es necesario *@
@if (CanShowConfirmDialog())
{
    <ConfirmDialog IsOpen="@_showConfirmDialog"
                   Title="@ConfirmTitle"
                   Message="@ConfirmMessage"
                   Intent="@GetConfirmIntent()"
                   ConfirmText="@ConfirmButtonText"
                   CancelText="@CancelButtonText"
                   OnConfirm="() => OnConfirmDialogResult(true)"
                   OnCancel="() => OnConfirmDialogResult(false)" />
}