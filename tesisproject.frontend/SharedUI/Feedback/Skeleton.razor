@if (Shape is SkeletonShape.Circle)
{
    <div class="bg-skeleton animate-pulse motion-reduce:animate-none"
         style="width:@WidthPx;max-width:100%;height:@HeightPx;border-radius:9999px"
         aria-hidden="true" />
}
else
{
    <div class="bg-skeleton animate-pulse motion-reduce:animate-none @RoundedClass"
         style="width:@WidthPx;max-width:100%;height:@HeightPx"
         aria-hidden="true" />
}
