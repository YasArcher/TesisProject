@if (Shape is SkeletonShape.Circle)
{
    <div class="bg-gray-200 animate-pulse" style="width:@WidthPx;height:@HeightPx;border-radius:9999px" role="status" aria-label="loading" />
}
else
{
    <div class="bg-gray-200 animate-pulse @RoundedClass" style="width:@WidthPx;height:@HeightPx" role="status" aria-label="loading" />
}