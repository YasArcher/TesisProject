<div class="inline-flex items-center gap-3" role="status" aria-live="polite" aria-busy="true">
    <span class="inline-block border-4 border-gray-200 border-t-blue-500 rounded-full animate-spin" style="width:@SizePx;height:@SizePx"></span>
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <span class="text-sm text-gray-600">@Label</span>
    }
</div>