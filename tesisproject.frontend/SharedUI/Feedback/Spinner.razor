@namespace tesisproject.frontend.SharedUI

@if (Type == SpinnerType.Border)
{
    <div class="@SpinnerClass" role="status">
        <span class="sr-only">Cargando...</span>
    </div>
}
else if (Type == SpinnerType.Grow)
{
    <div class="@SpinnerClass" role="status">
        <span class="sr-only">Cargando...</span>
    </div>
}

@code {
    [Parameter] public SpinnerSize Size { get; set; } = SpinnerSize.Medium;
    [Parameter] public SpinnerType Type { get; set; } = SpinnerType.Border;
    [Parameter] public SpinnerColor Color { get; set; } = SpinnerColor.Primary;
    [Parameter] public string? Class { get; set; }

    private string SpinnerClass
    {
        get
        {
            var baseClass = Type == SpinnerType.Border ? "spinner-border" : "spinner-grow";

            var sizeClass = Size switch
            {
                SpinnerSize.Small => Type == SpinnerType.Border ? "spinner-border-sm" : "spinner-grow-sm",
                SpinnerSize.Large => "",
                _ => ""
            };

            var colorClass = Color switch
            {
                SpinnerColor.Primary => "text-[#7A1E19]",
                SpinnerColor.Secondary => "text-gray-600",
                SpinnerColor.Success => "text-green-600",
                SpinnerColor.Danger => "text-red-600",
                SpinnerColor.Warning => "text-yellow-600",
                SpinnerColor.Info => "text-blue-600",
                _ => "text-[#7A1E19]"
            };

            return $"{baseClass} {sizeClass} {colorClass} {Class}".Trim();
        }
    }
}