@namespace tesisproject.frontend.SharedUI.TextInput

<div class="flex flex-col gap-1">
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <label class="text-xs font-medium text-slate-700">
            @Label
            @if (Required)
            {
                <span class="text-red-500">*</span>
            }
        </label>
    }

    <input class="rounded-lg border px-3 py-2 text-sm
                  @(HasError ? "border-red-400 bg-red-50" : "border-slate-300 bg-white")
                  focus:outline-none focus:ring-2 focus:ring-slate-400/40"
           placeholder="@Placeholder"
           value="@Value"
           @oninput="OnInputChanged"
           disabled="@Disabled" />

    @if (!string.IsNullOrWhiteSpace(HelpText) || HasError)
    {
        <p class="text-[11px] mt-0.5 @(HasError ? "text-red-600" : "text-slate-400")">
            @(HasError? ErrorText : HelpText)
        </p>
    }
</div>
