<div class="w-full">
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <label class="block text-sm font-medium text-foreground mb-1">
            @Label
            @if (Required)
            {
                <span class="text-error">*</span>
            }
        </label>
    }
    <input type="@InputType"
           class="w-full rounded-md border border-border px-3 py-2 shadow-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary @(HasError ? "ring-2 ring-error border-error focus:ring-error focus:border-error" : "")"
           placeholder="@Placeholder"
           value="@_value"
           maxlength="@MaxLength"
           disabled="@Disabled"
           aria-invalid="@(HasError ? "true" : "false")"
           aria-required="@(Required ? "true" : "false")"
           @oninput="OnInputAsync" />
    @if (HasError)
    {
        <p class="mt-1 text-sm text-error">@ErrorMessage</p>
    }
    else if (!string.IsNullOrWhiteSpace(HelpText))
    {
        <p class="mt-1 text-sm text-muted">@HelpText</p>
    }
</div>