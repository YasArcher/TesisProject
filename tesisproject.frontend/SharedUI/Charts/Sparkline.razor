<svg width="100%" height="@Height" viewBox="0 0 100 @Height" preserveAspectRatio="none">
    <polyline fill="none" stroke="currentColor" stroke-width="2" points="@Points" />
</svg>

@code {
    [Parameter] public int[] Values { get; set; } = Array.Empty<int>();
    [Parameter] public int Height { get; set; } = 40;

    private string Points => BuildPoints();

    private string BuildPoints()
    {
        if (Values.Length == 0) return "";
        var min = Values.Min();
        var max = Math.Max(min + 1, Values.Max());
        double norm(int v) => (double)(v - min) / (max - min); // 0..1
        var step = 100.0 / Math.Max(1, Values.Length - 1);
        return string.Join(" ",
            Values.Select((v, i) => $"{i * step:0.###},{(1 - norm(v)) * Height:0.###}"));
    }
}
