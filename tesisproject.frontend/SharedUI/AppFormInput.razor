@typeparam T
@using System.Linq.Expressions

<div class="flex flex-col gap-1">
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <label class="text-sm font-medium">@Label</label>
    }

    @if (InputType == "number")
    {
        <InputNumber TValue="T" @bind-Value="Value" class="w-full rounded-md border px-3 py-2" />
    }
    else if (InputType == "date")
    {
        <InputDate TValue="T" @bind-Value="Value" class="w-full rounded-md border px-3 py-2" />
    }
    else
    {
        <InputText @bind-Value="TextValue" class="w-full rounded-md border px-3 py-2" />
    }

    @if (!string.IsNullOrWhiteSpace(HelpText))
    {
        <small class="text-xs text-slate-500">@HelpText</small>
    }
</div>

@code {
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? HelpText { get; set; }
    [Parameter] public string InputType { get; set; } = "text";

    // Requeridos por @bind-Value
    [Parameter] public T? Value { get; set; }
    [Parameter] public EventCallback<T?> ValueChanged { get; set; }
    [Parameter] public Expression<Func<T?>>? ValueExpression { get; set; }

    // Buffer para texto
    private string? TextValue
    {
        get => Value is null ? null : Value.ToString();
        set
        {
            if (typeof(T) == typeof(string))
            {
                ValueChanged.InvokeAsync((T?)(object?)value);
            }
            else
            {
                // Si alguien usa InputType="text" con un T no-string,
                // no intentamos convertir implícitamente para evitar errores.
                ValueChanged.InvokeAsync(default);
            }
        }
    }
}
