@typeparam TItem

@using tesisproject.frontend.SharedUI.ActionButton
@using tesisproject.frontend.SharedUI.Card

<Card Class="@BuildCardClass()"
      Interactive="true">
    <div class="flex flex-col">
        <button type="button"
                class="w-full p-3 text-left"
                @onclick="HandleSelect">
            <div class="flex items-start justify-between gap-2">
                <div class="flex-1 min-w-0">
                    <div class="flex items-center gap-2 mb-1.5">
                        <div class="w-2 h-2 rounded-full flex-shrink-0 @(IsActiveResolved ? "bg-secondary" : "bg-muted")"></div>
                        <span class="font-medium text-sm text-foreground truncate">@GetTitle(Item)</span>
                    </div>

                    @if (ItemMeta is not null)
                    {
                        <div class="flex items-center gap-1.5 flex-wrap">
                            @ItemMeta(Item)
                        </div>
                    }
                </div>

                @if (IsSelected)
                {
                    <svg class="h-5 w-5 text-primary flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z" />
                    </svg>
                }
            </div>
        </button>

        @if (ShowActionsResolved)
        {
            <div class="px-3 pb-3 flex items-center gap-2">
                @if (OnEditRequested.HasDelegate)
                {
                    <ActionButton Execute="HandleEdit"
                                  Intent="ButtonIntent.Neutral"
                                  Variant="ButtonVariant.Outline"
                                  Size="ButtonSize.Xs"
                                  Class="flex-1">
                        <Icon>
                            @if (EditIcon is not null)
                            {
                                @EditIcon
                            }
                            else
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6">
                                    <path d="M21.731 2.269a2.625 2.625 0 0 0-3.712 0l-1.157 1.157 3.712 3.712 1.157-1.157a2.625 2.625 0 0 0 0-3.712ZM19.513 8.199l-3.712-3.712-8.4 8.4a5.25 5.25 0 0 0-1.32 2.214l-.8 2.685a.75.75 0 0 0 .933.933l2.685-.8a5.25 5.25 0 0 0 2.214-1.32l8.4-8.4Z" />
                                    <path d="M5.25 5.25a3 3 0 0 0-3 3v10.5a3 3 0 0 0 3 3h10.5a3 3 0 0 0 3-3V13.5a.75.75 0 0 0-1.5 0v5.25a1.5 1.5 0 0 1-1.5 1.5H5.25a1.5 1.5 0 0 1-1.5-1.5V8.25a1.5 1.5 0 0 1 1.5-1.5h5.25a.75.75 0 0 0 0-1.5H5.25Z" />
                                </svg>
                            }
                        </Icon>
                    </ActionButton>
                }

                @if (OnDeleteRequested.HasDelegate)
                {
                    <ActionButton Execute="HandleDelete"
                                  Intent="ButtonIntent.Delete"
                                  Variant="ButtonVariant.Outline"
                                  Size="ButtonSize.Xs"
                                  ConfirmBeforeExecute="true"
                                  ConfirmMessage="@ResolveDeleteMessage()"
                                  Class="flex-1">
                        <Icon>
                            @if (DeleteIcon is not null)
                            {
                                @DeleteIcon
                            }
                            else
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6">
                                    <path fill-rule="evenodd" d="M16.5 4.478v.227a48.816 48.816 0 0 1 3.878.512.75.75 0 1 1-.256 1.478l-.209-.035-1.005 13.07a3 3 0 0 1-2.991 2.77H8.084a3 3 0 0 1-2.991-2.77L4.087 6.66l-.209.035a.75.75 0 0 1-.256-1.478A48.567 48.567 0 0 1 7.5 4.705v-.227c0-1.564 1.213-2.9 2.816-2.951a52.662 52.662 0 0 1 3.369 0c1.603.051 2.815 1.387 2.815 2.951Zm-6.136-1.452a51.196 51.196 0 0 1 3.273 0C14.39 3.05 15 3.684 15 4.478v.113a49.488 49.488 0 0 0-6 0v-.113c0-.794.609-1.428 1.364-1.452Zm-.355 5.945a.75.75 0 1 0-1.5.058l.347 9a.75.75 0 1 0 1.499-.058l-.346-9Zm5.48.058a.75.75 0 1 0-1.498-.058l-.347 9a.75.75 0 0 0 1.5.058l.345-9Z" clip-rule="evenodd" />
                                </svg>
                            }
                        </Icon>
                    </ActionButton>
                }
            </div>
        }
    </div>
</Card>

@code {
    [Parameter, EditorRequired] public TItem Item { get; set; } = default!;
    [Parameter] public bool IsSelected { get; set; }

    [Parameter, EditorRequired] public Func<TItem, string> GetTitle { get; set; } = default!;
    [Parameter] public Func<TItem, bool>? GetIsActive { get; set; }
    [Parameter] public Func<TItem, bool>? GetIsLocked { get; set; }
    [Parameter] public Func<TItem, string>? GetDeleteConfirmMessage { get; set; }

    [Parameter] public bool ShowActions { get; set; } = true;
    [Parameter] public bool AllowActionsWhenLocked { get; set; } = false;

    [Parameter] public EventCallback<TItem> OnSelected { get; set; }
    [Parameter] public EventCallback<TItem> OnEditRequested { get; set; }
    [Parameter] public EventCallback<TItem> OnDeleteRequested { get; set; }

    [Parameter] public RenderFragment<TItem>? ItemMeta { get; set; }
    [Parameter] public RenderFragment? EditIcon { get; set; }
    [Parameter] public RenderFragment? DeleteIcon { get; set; }

    private bool IsActiveResolved => GetIsActive?.Invoke(Item) ?? true;
    private bool IsLockedResolved => GetIsLocked?.Invoke(Item) ?? false;

    private bool ShowActionsResolved =>
        ShowActions &&
        (!IsLockedResolved || AllowActionsWhenLocked) &&
        (OnEditRequested.HasDelegate || OnDeleteRequested.HasDelegate);

    private string BuildCardClass()
        => IsSelected
            ? "border-primary bg-primary/5"
            : "border-border bg-background hover:border-primary/40 hover:bg-primary/5";

    private string ResolveDeleteMessage()
        => GetDeleteConfirmMessage?.Invoke(Item) ?? "¿Estás seguro de que deseas eliminar este elemento?";

    private Task HandleSelect() => OnSelected.InvokeAsync(Item);
    private Task HandleEdit() => OnEditRequested.InvokeAsync(Item);
    private Task HandleDelete() => OnDeleteRequested.InvokeAsync(Item);
}