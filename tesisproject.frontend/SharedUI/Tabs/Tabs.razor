<CascadingValue Value="this">
    <!-- Force child <Tab> to register before rendering headers -->
    <div hidden>@ChildContent</div>

    <div class="w-full">
        <!-- Tab list -->
        <div class="flex gap-1 md:gap-2" role="tablist" @onkeydown="HandleKeyDown">
            @for (int i = 0; i < _items.Count; i++)
            {
                var idx = i;
                var item = _items[idx];
                var isActive = item.Key == ActiveKey;
                var common = "px-3 md:px-4 py-2 text-sm font-medium focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-500 focus-visible:ring-offset-2 rounded-md transition";

                var classes = Variant switch
                {
                    TabVariant.Underline => $"{common} rounded-b-none border-b-2 {(isActive ? "border-sky-600 text-sky-700" : "border-transparent text-gray-600 hover:text-gray-800 hover:border-gray-300")}",
                    TabVariant.Pills => $"{common} {(isActive ? "bg-sky-600 text-white" : "bg-gray-100 text-gray-700 hover:bg-gray-200")}",
                    _ => common
                };

                <button @key="item.Key"
                        @ref="_tabRefs[item.Key]"
                        class="@classes"
                        id="tab-@item.Key"
                        role="tab"
                        aria-selected="@isActive"
                        aria-controls="panel-@item.Key"
                        tabindex="@(isActive ? 0 : -1)"
                        @onclick="(() => Activate(item.Key))">
                    @item.Title
                </button>
            }
        </div>

        <!-- Active panel -->
        <div class="mt-3">
            @if (_activeItem is not null)
            {
                <div id="panel-@_activeItem.Key" role="tabpanel" aria-labelledby="tab-@_activeItem.Key" class="outline-none">
                    @_activeItem.Content
                </div>
            }
        </div>
    </div>
</CascadingValue>
