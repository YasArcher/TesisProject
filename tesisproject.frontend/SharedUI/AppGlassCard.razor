@namespace tesisproject.frontend.SharedUI
<div class="app-glass-card rounded-2xl shadow-soft @Class">
    @if (!string.IsNullOrWhiteSpace(Title))
    {
        <div class="app-glass-head px-3 py-2 d-flex align-items-center">
            @if (!string.IsNullOrWhiteSpace(Icon))
            {
                <span class="me-2 app-glass-icon">@Icon</span>
            }
            <h6 class="m-0 text-uppercase small fw-semibold">@Title</h6>
        </div>
    }
    <div class="p-3">
        @ChildContent
    </div>
</div>

@code {
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Icon { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
