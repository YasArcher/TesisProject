@namespace tesisproject.frontend.SharedUI
<div class="app-section-card card border-0 rounded-2xl shadow-soft mb-3 @Class">
    <div class="card-header section-head d-flex align-items-center">
        @if (!string.IsNullOrWhiteSpace(Icon))
        {
            <div class="me-2 section-icon">@Icon</div>
        }
        <div>
            <h6 class="mb-0 text-uppercase fw-semibold small">@Title</h6>
            @if (!string.IsNullOrWhiteSpace(Subtitle))
            {
                <small class="opacity-75">@Subtitle</small>
            }
        </div>
    </div>
    <div class="card-body">
        @ChildContent
    </div>
</div>

@code {
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public string? Icon { get; set; } // usa emoji o texto corto
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
