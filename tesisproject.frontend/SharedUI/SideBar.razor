@using Microsoft.AspNetCore.Components.Routing
@namespace tesisproject.frontend.SharedUI

<div class="sidebar menu-bg h-100 d-flex flex-column @(_collapsed ? "is-collapsed" : null)">
    <!-- Branding -->
    <div class="sidebar-brand d-flex align-items-center justify-content-between px-3 py-3 border-bottom border-white-20">
        <div class="d-flex align-items-center brand-identity">
            <div class="brand-mark d-inline-flex align-items-center justify-content-center me-2">
                <span class="fw-bold">SI</span>
            </div>
            <div class="brand-text">
                <div class="brand-kicker">Plataforma</div>
                <div class="fw-semibold lh-1">Sistema Integrado</div>
                <small class="opacity-75 lh-1">de Documentación</small>
            </div>
        </div>
        <button type="button"
                class="btn btn-sm text-white bg-transparent opacity-75 btn-collapse"
                title="@(_collapsed ? "Expandir menú" : "Colapsar menú")"
                @onclick="Toggle">
            @if (_collapsed)
            {
                <span>»</span>
            }
            else
            {

                <span>«</span>
            }
        </button>
    </div>

    <!-- Nav -->
    <nav class="sidebar-nav flex-grow-1 px-2 py-3">
        <div class="accordion-group @(GroupClass(_openModules))">
            <button type="button" class="accordion-btn d-flex align-items-center gap-2 px-3 py-2 text-white-90"
                    @onclick="() => ToggleSection(nameof(_openModules))">
                <span class="icon">🗂️</span>
                <span class="label">Gestión académica</span>
                <span class="caret">▾</span>
            </button>

            <div class="accordion-panel">
                <ul class="nav flex-column ms-4 my-2 gap-1">
                    <li class="nav-item"><NavLink href="/panel/principal" Match="NavLinkMatch.Prefix" class="nav-link px-3 py-2 text-white-85" ActiveClass="active">Panel principal</NavLink></li>
                    <li class="nav-item"><NavLink href="/articulos/registrar" Match="NavLinkMatch.Prefix" class="nav-link px-3 py-2 text-white-85" ActiveClass="active">Registrar artículo</NavLink></li>
                    <li class="nav-item"><NavLink href="/configuration" class="nav-link px-3 py-2 text-white-85" ActiveClass="active">Configuración</NavLink></li>
                    <li class="nav-item"><NavLink href="/articulos/listado" class="nav-link px-3 py-2 text-white-85" ActiveClass="active">Listado de artículos</NavLink></li>
                    <li class="nav-item"><NavLink href="/management/exportinformation" class="nav-link px-3 py-2 text-white-85" ActiveClass="active">Carga masiva</NavLink></li>
                    <li class="nav-item"><NavLink href="/management/statisticalreports" class="nav-link px-3 py-2 text-white-85" ActiveClass="active">Reportería</NavLink></li>
                    <li class="nav-item"><NavLink href="/management/externalapis" class="nav-link px-3 py-2 text-white-85" ActiveClass="active">APIs externas</NavLink></li>
                    <li class="nav-item"><NavLink href="/management/backupsinformation" class="nav-link px-3 py-2 text-white-85" ActiveClass="active">Copias de seguridad</NavLink></li>
                    <li class="nav-item"><NavLink href="/test-api" class="nav-link px-3 py-2 text-white-85" ActiveClass="active">Centro de ayuda</NavLink></li>
                    <li class="nav-item"><NavLink href="/help/manual" class="nav-link px-3 py-2 text-white-85" ActiveClass="active">Manual de usuario</NavLink></li>
                    <li class="nav-item"><NavLink href="/perfilview" class="nav-link px-3 py-2 text-white-85" ActiveClass="active">Perfil</NavLink></li>
                    <li class="nav-item"><NavLink href="/ia" class="nav-link px-3 py-2 text-white-85" ActiveClass="active">Inteligencia artificial</NavLink></li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Footer -->
    <div class="mt-auto px-3 py-3 border-top border-white-20">
        <small class="opacity-75">&copy; @DateTime.Now.Year</small>
    </div>
</div>

@code {
    [Parameter] public EventCallback<bool> CollapseChanged { get; set; }

    private bool _collapsed = false;

    private bool _openModules = true;

    private async Task Toggle()
    {
        _collapsed = !_collapsed;
        await CollapseChanged.InvokeAsync(_collapsed);
    }

    private void ToggleSection(string key)
    {
        if (_collapsed) return;
        switch (key)
        {
            case nameof(_openModules): _openModules = !_openModules; break;
        }
        StateHasChanged();
    }

    private string GroupClass(bool open) => open ? "open" : "";
}
