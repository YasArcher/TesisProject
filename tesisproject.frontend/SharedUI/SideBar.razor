@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing
@namespace tesisproject.frontend.SharedUI
@implements IDisposable
@inject AuthenticationStateProvider AuthStateProvider

<div class="sidebar menu-bg h-100 d-flex flex-column @(_collapsed ? "is-collapsed" : null)">
    <div class="sidebar-brand d-flex align-items-center justify-content-between px-3 py-3 border-bottom border-white-20">
        <div class="d-flex align-items-center brand-identity">
            <div class="brand-mark d-inline-flex align-items-center justify-content-center me-2">
                <span class="fw-bold">SI</span>
            </div>
            <div class="brand-text">
                <div class="brand-kicker">Plataforma</div>
                <div class="fw-semibold lh-1">Sistema Integrado</div>
                <small class="opacity-75 lh-1">de Documentación</small>
            </div>
        </div>
        <button type="button"
                class="btn btn-sm text-white bg-transparent opacity-75 btn-collapse"
                title="@(_collapsed ? "Expandir menú" : "Colapsar menú")"
                @onclick="Toggle">
            @if (_collapsed)
            {
                <span>»</span>
            }
            else
            {
                <span>«</span>
            }
        </button>
    </div>

    <nav class="sidebar-nav flex-grow-1 px-2 py-3">
        @if (IsAdmin)
        {
            <div class="sidebar-admin-shortcut-wrap mb-3">
                <NavLink href="/management/security-administration" class="sidebar-admin-shortcut" ActiveClass="active">
                    <span class="icon">🔐</span>
                    <span class="label">Usuarios y roles</span>
                    <span class="badge">Admin</span>
                </NavLink>
            </div>
        }

        <div class="sidebar-nav-stack">
            @if (CanSeeArticlesGroup)
            {
                <ul class="nav flex-column gap-2 sidebar-direct-links">
                    <li class="nav-item">
                        <NavLink href="/panel/principal" Match="NavLinkMatch.Prefix" class="nav-link px-3 py-2 text-white-90" ActiveClass="active" title="Panel principal">
                            <span class="icon">⌂</span>
                            <span class="label">Panel principal</span>
                        </NavLink>
                    </li>
                </ul>
            }

            @if (CanSeeArticlesGroup)
            {
                <div class="accordion-group @(GroupClass(_openArticles))">
                    <button type="button" class="accordion-btn d-flex align-items-center gap-2 px-3 py-2 text-white-85"
                            title="Artículos"
                            @onclick="() => ToggleSection(nameof(_openArticles))">
                        <span class="icon">📝</span>
                        <span class="label">Artículos</span>
                        <span class="caret">▾</span>
                    </button>
                    <div class="accordion-panel">
                        <ul class="nav flex-column ms-4 my-2 gap-1">
                            @if (CanRegisterArticles)
                            {
                                <li class="nav-item"><NavLink href="/articulos/registrar" Match="NavLinkMatch.Prefix" class="nav-link px-3 py-2 text-white-85" ActiveClass="active" title="Registrar artículo"><span class="icon">✎</span><span class="label">Registrar artículo</span></NavLink></li>
                            }
                            @if (CanAccessWorkflow)
                            {
                                <li class="nav-item"><NavLink href="/management/workflow-review" Match="NavLinkMatch.Prefix" class="nav-link px-3 py-2 text-white-85" ActiveClass="active" title="Revisión de envíos"><span class="icon">✓</span><span class="label">Revisión de envíos</span></NavLink></li>
                            }
                            @if (CanManageConfiguration)
                            {
                                <li class="nav-item"><NavLink href="/configuration" class="nav-link px-3 py-2 text-white-85" ActiveClass="active" title="Configuración"><span class="icon">⚙</span><span class="label">Configuración</span></NavLink></li>
                            }
                            @if (CanRegisterArticles || IsAdmin)
                            {
                                <li class="nav-item"><NavLink href="/articulos/listado" class="nav-link px-3 py-2 text-white-85" ActiveClass="active" title="Listado de artículos"><span class="icon">≣</span><span class="label">Listado de artículos</span></NavLink></li>
                            }
                        </ul>
                    </div>
                </div>
            }

            @if (CanSeeImportGroup)
            {
                <div class="accordion-group @(GroupClass(_openImportFlow))">
                    <button type="button" class="accordion-btn d-flex align-items-center gap-2 px-3 py-2 text-white-85"
                            title="Captura e importación"
                            @onclick="() => ToggleSection(nameof(_openImportFlow))">
                        <span class="icon">📥</span>
                        <span class="label">Captura e importación</span>
                        <span class="caret">▾</span>
                    </button>
                    <div class="accordion-panel">
                        <ul class="nav flex-column ms-4 my-2 gap-1">
                            @if (CanManageConfiguration)
                            {
                                <li class="nav-item"><NavLink href="/management/registration-matrix" class="nav-link px-3 py-2 text-white-85" ActiveClass="active" title="Matriz de registro"><span class="icon">▦</span><span class="label">Matriz de registro</span></NavLink></li>
                                <li class="nav-item"><NavLink href="/management/exportinformation" class="nav-link px-3 py-2 text-white-85" ActiveClass="active" title="Carga masiva"><span class="icon">⇪</span><span class="label">Carga masiva</span></NavLink></li>
                                <li class="nav-item"><NavLink href="/management/externalapis" class="nav-link px-3 py-2 text-white-85" ActiveClass="active" title="APIs externas"><span class="icon">◎</span><span class="label">APIs externas</span></NavLink></li>
                            }
                            @if (IsAdmin)
                            {
                                <li class="nav-item"><NavLink href="/management/backupsinformation" class="nav-link px-3 py-2 text-white-85" ActiveClass="active" title="Copias de seguridad"><span class="icon">⛁</span><span class="label">Copias de seguridad</span></NavLink></li>
                            }
                        </ul>
                    </div>
                </div>
            }

            @if (CanSeeAnalysisGroup)
            {
                <div class="accordion-group @(GroupClass(_openAnalysis))">
                    <button type="button" class="accordion-btn d-flex align-items-center gap-2 px-3 py-2 text-white-85"
                            title="Reportes y análisis"
                            @onclick="() => ToggleSection(nameof(_openAnalysis))">
                        <span class="icon">📊</span>
                        <span class="label">Reportes y análisis</span>
                        <span class="caret">▾</span>
                    </button>
                    <div class="accordion-panel">
                        <ul class="nav flex-column ms-4 my-2 gap-1">
                            <li class="nav-item"><NavLink href="/management/statisticalreports" class="nav-link px-3 py-2 text-white-85" ActiveClass="active" title="Reportería"><span class="icon">◔</span><span class="label">Reportería</span></NavLink></li>
                            @if (CanManageConfiguration)
                            {
                                <li class="nav-item"><NavLink href="/ia" class="nav-link px-3 py-2 text-white-85" ActiveClass="active" title="Inteligencia artificial"><span class="icon">✦</span><span class="label">Inteligencia artificial</span></NavLink></li>
                            }
                        </ul>
                    </div>
                </div>
            }

            @if (IsAdmin)
            {
                <div class="accordion-group @(GroupClass(_openAdministration))">
                    <button type="button" class="accordion-btn d-flex align-items-center gap-2 px-3 py-2 text-white-85"
                            title="Control institucional"
                            @onclick="() => ToggleSection(nameof(_openAdministration))">
                        <span class="icon">🔐</span>
                        <span class="label">Control institucional</span>
                        <span class="caret">▾</span>
                    </button>
                    <div class="accordion-panel">
                        <ul class="nav flex-column ms-4 my-2 gap-1">
                            <li class="nav-item"><NavLink href="/management/security-administration" class="nav-link px-3 py-2 text-white-85" ActiveClass="active" title="Usuarios y roles"><span class="icon">⌘</span><span class="label">Usuarios y roles</span></NavLink></li>
                        </ul>
                    </div>
                </div>
            }

            <div class="accordion-group @(GroupClass(_openSupport))">
                <button type="button" class="accordion-btn d-flex align-items-center gap-2 px-3 py-2 text-white-85"
                        title="Soporte y cuenta"
                        @onclick="() => ToggleSection(nameof(_openSupport))">
                    <span class="icon">🛟</span>
                    <span class="label">Soporte y cuenta</span>
                    <span class="caret">▾</span>
                </button>
                <div class="accordion-panel">
                    <ul class="nav flex-column ms-4 my-2 gap-1">
                        <li class="nav-item"><NavLink href="/test-api" class="nav-link px-3 py-2 text-white-85" ActiveClass="active" title="Centro de ayuda"><span class="icon">?</span><span class="label">Centro de ayuda</span></NavLink></li>
                        <li class="nav-item"><NavLink href="/help/manual" class="nav-link px-3 py-2 text-white-85" ActiveClass="active" title="Manual de usuario"><span class="icon">☰</span><span class="label">Manual de usuario</span></NavLink></li>
                        <li class="nav-item"><NavLink href="/perfilview" class="nav-link px-3 py-2 text-white-85" ActiveClass="active" title="Perfil"><span class="icon">◉</span><span class="label">Perfil</span></NavLink></li>
                    </ul>
                </div>
            </div>
        </div>
    </nav>

    <div class="mt-auto px-3 py-3 border-top border-white-20">
        <small class="opacity-75">&copy; @DateTime.Now.Year</small>
    </div>
</div>

@code {
    [Parameter] public EventCallback<bool> CollapseChanged { get; set; }

    private bool _collapsed;
    private bool _openArticles = true;
    private bool _openImportFlow = true;
    private bool _openAnalysis = true;
    private bool _openAdministration = true;
    private bool _openSupport = true;

    private bool IsAdmin { get; set; }
    private bool IsAnalyst { get; set; }
    private bool IsAuthor { get; set; }
    private bool IsUodide { get; set; }
    private bool IsAreaTecnica { get; set; }

    private bool CanRegisterArticles => IsAdmin || IsAnalyst || IsAuthor;
    private bool CanAccessWorkflow => IsAdmin || IsAuthor || IsUodide || IsAreaTecnica;
    private bool CanManageConfiguration => IsAdmin || IsAnalyst;
    private bool CanSeeArticlesGroup => CanRegisterArticles || CanAccessWorkflow;
    private bool CanSeeImportGroup => CanManageConfiguration || IsAdmin;
    private bool CanSeeAnalysisGroup => IsAdmin || IsAnalyst || IsUodide || IsAreaTecnica;

    protected override async Task OnInitializedAsync()
    {
        await LoadRoleStateAsync();
        AuthStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
    }

    private async void OnAuthenticationStateChanged(Task<AuthenticationState> task)
    {
        await LoadRoleStateAsync(task);
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadRoleStateAsync(Task<AuthenticationState>? authStateTask = null)
    {
        var state = authStateTask is null
            ? await AuthStateProvider.GetAuthenticationStateAsync()
            : await authStateTask;

        var user = state.User;
        IsAdmin = user.IsInRole("Admin");
        IsAnalyst = user.IsInRole("Analyst");
        IsAuthor = user.IsInRole("Author");
        IsUodide = user.IsInRole("WorkflowReviewerUodide");
        IsAreaTecnica = user.IsInRole("WorkflowReviewerAreaTecnica") || user.IsInRole("WorkflowProcessorAreaTecnica");
    }

    private async Task Toggle()
    {
        _collapsed = !_collapsed;
        await CollapseChanged.InvokeAsync(_collapsed);
    }

    private void ToggleSection(string key)
    {
        if (_collapsed) return;
        switch (key)
        {
            case nameof(_openArticles): _openArticles = !_openArticles; break;
            case nameof(_openImportFlow): _openImportFlow = !_openImportFlow; break;
            case nameof(_openAnalysis): _openAnalysis = !_openAnalysis; break;
            case nameof(_openAdministration): _openAdministration = !_openAdministration; break;
            case nameof(_openSupport): _openSupport = !_openSupport; break;
        }
        StateHasChanged();
    }

    private string GroupClass(bool open) => open ? "open" : "";

    public void Dispose()
    {
        AuthStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
    }
}
