@* SideBar.razor *@
@using Microsoft.AspNetCore.Components.Routing
@using tesisproject.frontend.SharedUI.ActionButton

<div class="@SidebarShellClass">
    <div class="fusion-sidebar-topline">
        <span class="fusion-sidebar-system">Plataforma institucional</span>
        <span class="fusion-sidebar-badge">@(IsArticlePortal ? "Artículos" : "Proyectos")</span>
        @if (IsDesktop)
        {
            <button type="button"
                    class="fusion-sidebar-collapse"
                    title="@CollapseButtonLabel"
                    aria-label="@CollapseButtonLabel"
                    aria-pressed="@IsCollapsed"
                    @onclick="ToggleCollapsedAsync">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 6l-6 6 6 6" />
                </svg>
            </button>
        }
    </div>

    <div class="fusion-context-card">
        <span class="fusion-context-label">Vista activa</span>
        <strong>@(IsArticlePortal ? "Artículos" : "Proyectos")</strong>
        <small>@(IsArticlePortal ? "Registro, reportería e IA." : "Seguimiento y gestión operativa.")</small>
    </div>
    <nav class="fusion-sidebar-nav" aria-label="Navegacion principal">
        @foreach (var group in GroupedItems)
        {
            if (!string.IsNullOrWhiteSpace(group.Key))
            {
                <div class="fusion-section-heading">
                    <span></span>
                    <strong>@group.Key</strong>
                    <span></span>
                </div>
            }

            @foreach (var item in group)
            {
                var key = $"{group.Key ?? "root"}::{item.Text}::{item.Href ?? "nohref"}";
                var parentActive = item.HasChildren && IsChildActive(item);
                var expanded = item.HasChildren && !IsCollapsed && (IsExpanded(key) || parentActive);

                if (item.HasChildren)
                {
                    <div class="fusion-nav-group">
                        <button type="button"
                                class="fusion-nav-link fusion-nav-button @(parentActive ? "is-active" : null)" title="@item.Text"
                                @onclick="() => Toggle(key)"
                                aria-expanded="@expanded">
                            @if (!string.IsNullOrWhiteSpace(item.Icon))
                            {
                                <span class="fusion-nav-icon">
                                    @((MarkupString)item.Icon)
                                </span>
                            }

                            <span class="fusion-nav-text">@item.Text</span>

                            <span class="fusion-chevron @(expanded ? "is-expanded" : null)" aria-hidden="true">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                                    <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 0 1 .02-1.06L10.94 10 7.23 6.29a.75.75 0 1 1 1.06-1.06l4.24 4.24c.3.3.3.77 0 1.06l-4.24 4.24a.75.75 0 0 1-1.06.02Z" clip-rule="evenodd" />
                                </svg>
                            </span>
                        </button>

                        <div class="fusion-subnav @(expanded ? "is-expanded" : null)">
                            @foreach (var child in item.Children!.Where(IsVisible))
                            {
                                <NavLink class="fusion-nav-link fusion-nav-child"
                                         ActiveClass="is-active"
                                         href="@(child.Href!)"
                                         title="@child.Text"
                                         Match="@(child.Exact ? NavLinkMatch.All : NavLinkMatch.Prefix)"
                                         tabindex="@(expanded ? "0" : "-1")">
                                    @if (!string.IsNullOrWhiteSpace(child.Icon))
                                    {
                                        <span class="fusion-nav-icon">
                                            @((MarkupString)child.Icon)
                                        </span>
                                    }
                                    <span class="fusion-nav-text">@child.Text</span>
                                </NavLink>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <NavLink class="fusion-nav-link"
                             ActiveClass="is-active"
                             href="@(item.Href!)"
                             title="@item.Text"
                             Match="@(item.Exact ? NavLinkMatch.All : NavLinkMatch.Prefix)">
                        @if (!string.IsNullOrWhiteSpace(item.Icon))
                        {
                            <span class="fusion-nav-icon">
                                @((MarkupString)item.Icon)
                            </span>
                        }
                        <span class="fusion-nav-text">@item.Text</span>
                    </NavLink>
                }
            }
        }
    </nav>

    <div class="fusion-sidebar-footer">
        <div class="fusion-footer-status">
            <span class="fusion-footer-dot"></span>
            <div>
                <div class="fusion-footer-title">Plataforma activa</div>
                <small>@(IsArticlePortal ? "Produccion cientifica" : "Gestion de proyectos")</small>
            </div>
        </div>

        @if (CanUsePowerBi)
        {
            <ActionButton Text="Actualizar Power BI"
                          Intent="ButtonIntent.Warning"
                          Variant="ButtonVariant.Ghost"
                          Size="ButtonSize.Md"
                          Execute="RunDwEtlAsync"
                          Disabled="@_etlBusy"
                          ConfirmBeforeExecute="true"
                          ConfirmTitle="Actualizar Power BI"
                          ConfirmMessage="Vamos a actualizar la informacion para que Power BI muestre los datos mas recientes. ¿Deseas continuar?"
                          ConfirmButtonText="Actualizar"
                          CancelButtonText="Cancelar"
                          Class="w-full justify-center mt-3">
                <Icon>
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6">
                        <path fill-rule="evenodd" d="M5.625 1.5H9a3.75 3.75 0 0 1 3.75 3.75v1.875c0 1.036.84 1.875 1.875 1.875H16.5a3.75 3.75 0 0 1 3.75 3.75v7.875c0 1.035-.84 1.875-1.875 1.875H5.625a1.875 1.875 0 0 1-1.875-1.875V3.375c0-1.036.84-1.875 1.875-1.875ZM9.75 17.25a.75.75 0 0 0-1.5 0V18a.75.75 0 0 0 1.5 0v-.75Zm2.25-3a.75.75 0 0 1 .75.75v3a.75.75 0 0 1-1.5 0v-3a.75.75 0 0 1 .75-.75Zm3.75-1.5a.75.75 0 0 0-1.5 0V18a.75.75 0 0 0 1.5 0v-5.25Z" clip-rule="evenodd" />
                        <path d="M14.25 5.25a5.23 5.23 0 0 0-1.279-3.434 9.768 9.768 0 0 1 6.963 6.963A5.23 5.23 0 0 0 16.5 7.5h-1.875a.375.375 0 0 1-.375-.375V5.25Z" />
                    </svg>
                </Icon>
            </ActionButton>
        }

        @if (!string.IsNullOrWhiteSpace(_etlStatus))
        {
            <div class="fusion-footer-note">
                @_etlStatus
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(_etlError))
        {
            <div class="fusion-footer-error">
                @_etlError
            </div>
        }
    </div>
</div>
