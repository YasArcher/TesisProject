@page "/perfilview"
@attribute [Authorize]

@using System.IdentityModel.Tokens.Jwt
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using tesisproject.frontend.Services.Interfaces
@inject AuthenticationStateProvider AuthStateProvider
@inject IAuthClient AuthClient
@inject ITokenStore TokenStore
@inject NavigationManager NavManager

<PageTitle>Perfil</PageTitle>

<div class="app-page-shell profile-page py-4">
    <section class="profile-hero">
        <div class="profile-hero__inner">
            <div>
                <div class="profile-hero__kicker">Cuenta institucional</div>
                <div class="flex items-center gap-3">
                    <span class="profile-hero__icon">◉</span>
                    <h1 class="profile-hero__title">Perfil de usuario</h1>
                </div>
                <div class="profile-hero__copy">Información de la sesión autenticada y permisos visibles en el sistema.</div>
            </div>
            <button class="profile-hero__logout"
                    @onclick="LogoutAsync">
                Cerrar sesión
            </button>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="profile-alert profile-alert--error">
            @ErrorMessage
        </div>
    }

    <div class="profile-grid">
        <section class="profile-card">
            <div class="profile-card__identity">
                <div class="profile-card__avatar">
                    @Initials
                </div>
                <div>
                    <div class="profile-card__eyebrow flex items-center gap-2"><span class="profile-inline-icon">◎</span><span>Usuario autenticado</span></div>
                    <div class="profile-card__title">@FullName</div>
                    <div class="profile-card__subtle">@Email</div>
                </div>
            </div>

            <div class="profile-card__stats">
                <article class="profile-mini-card">
                    <div class="profile-mini-card__label">Identificador</div>
                    <div class="profile-mini-card__value">@UserId</div>
                </article>
                <article class="profile-mini-card">
                    <div class="profile-mini-card__label">Sesión</div>
                    <div class="profile-mini-card__value">@(IsAuthenticated ? "Activa" : "No autenticada")</div>
                </article>
            </div>
        </section>

        <section class="profile-card">
            <div class="profile-card__eyebrow flex items-center gap-2"><span class="profile-inline-icon">⌘</span><span>Roles activos</span></div>
            @if (Roles.Count == 0)
            {
                <div class="profile-card__subtle mt-3">Tu sesión actual no contiene roles visibles.</div>
            }
            else
            {
                <div class="profile-role-list">
                    @foreach (var role in Roles)
                    {
                        <span class="profile-role-pill">@role</span>
                    }
                </div>
            }

            <div class="profile-card__claims-title flex items-center gap-2"><span class="profile-inline-icon">▣</span><span>Claims visibles</span></div>
            <div class="profile-claims">
                @foreach (var claim in VisibleClaims)
                {
                    <div class="profile-claim-card">
                        <div class="profile-claim-card__type">@claim.Type</div>
                        <div class="profile-claim-card__value">@claim.Value</div>
                    </div>
                }
            </div>
        </section>
    </div>
</div>

@code {
    private bool IsAuthenticated { get; set; }
    private string UserId { get; set; } = "Sin identificar";
    private string Email { get; set; } = "Sin correo";
    private string FullName { get; set; } = "Usuario";
    private string Initials { get; set; } = "U";
    private string? ErrorMessage { get; set; }
    private List<string> Roles { get; set; } = [];
    private List<(string Type, string Value)> VisibleClaims { get; set; } = [];

    protected override async Task OnInitializedAsync()
    {
        await LoadProfileAsync();
    }

    private async Task LoadProfileAsync()
    {
        ErrorMessage = null;

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            IsAuthenticated = user.Identity?.IsAuthenticated == true;
            if (!IsAuthenticated)
            {
                NavManager.NavigateTo("/login", forceLoad: false);
                return;
            }

            UserId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? "Sin identificar";
            Email = user.FindFirst(ClaimTypes.Email)?.Value ?? "Sin correo";
            FullName = user.FindFirst("fullName")?.Value
                ?? user.FindFirst(ClaimTypes.GivenName)?.Value
                ?? user.FindFirst(ClaimTypes.Name)?.Value
                ?? Email;

            Initials = BuildInitials(FullName);
            Roles = user.Claims
                .Where(x => x.Type == ClaimTypes.Role)
                .Select(x => x.Value)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(x => x)
                .ToList();

            VisibleClaims = user.Claims
                .Where(x => x.Type is ClaimTypes.NameIdentifier or ClaimTypes.Name or ClaimTypes.Email or ClaimTypes.Role or "fullName")
                .Select(x => (x.Type, x.Value))
                .ToList();

            var me = await AuthClient.GetCurrentAsync();
            if (me is not null)
            {
                Email = string.IsNullOrWhiteSpace(me.Email) ? Email : me.Email;
                FullName = string.IsNullOrWhiteSpace(me.FullName) ? FullName : me.FullName;
                Initials = BuildInitials(FullName);
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"No pude cargar el perfil autenticado: {ex.Message}";
        }
    }

    private async Task LogoutAsync()
    {
        await TokenStore.ClearAsync();
        if (AuthStateProvider is JwtAuthStateProvider jwt)
        {
            jwt.NotifyUserChanged();
        }

        NavManager.NavigateTo("/login", forceLoad: false);
    }

    private static string BuildInitials(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "U";
        }

        var parts = value.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2
            ? $"{parts[0][0]}{parts[1][0]}".ToUpperInvariant()
            : parts[0][0].ToString().ToUpperInvariant();
    }
}
