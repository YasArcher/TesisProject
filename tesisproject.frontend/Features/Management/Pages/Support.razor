@page "/management/support"
@attribute [Authorize]

<PageTitle>Soporte</PageTitle>

<div class="app-page-shell min-h-screen bg-[#F5F7F8] px-4 py-6">
    <section class="mx-auto max-w-5xl rounded-[2rem] border border-[#A3B087]/40 bg-white p-6 shadow-sm">
        <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
            <div>
                <p class="text-xs font-black uppercase tracking-[0.22em] text-[#437057]">Soporte y cuenta</p>
                <h1 class="mt-2 text-3xl font-black tracking-tight text-[#313647]">Centro de ayuda institucional</h1>
                <p class="mt-3 max-w-2xl text-sm leading-6 text-[#495E57]">
                    Usa esta sección como punto de referencia para reportar incidencias del flujo de registro, revisión o procesamiento de artículos.
                </p>
            </div>
            <div class="rounded-2xl bg-[#FFF8D4] px-4 py-3 text-sm font-semibold text-[#495E57]">
                Estado del módulo: activo
            </div>
        </div>

        <div class="mt-6 grid gap-4 md:grid-cols-3">
            <article class="rounded-2xl border border-[#A3B087]/40 bg-[#F5F7F8] p-4">
                <div class="text-2xl">?</div>
                <h2 class="mt-3 text-base font-black text-[#313647]">Incidencias</h2>
                <p class="mt-2 text-sm leading-6 text-[#495E57]">Documenta el usuario, rol, lote o artículo y el mensaje mostrado por pantalla.</p>
            </article>
            <article class="rounded-2xl border border-[#A3B087]/40 bg-[#F5F7F8] p-4">
                <div class="text-2xl">✓</div>
                <h2 class="mt-3 text-base font-black text-[#313647]">Flujo</h2>
                <p class="mt-2 text-sm leading-6 text-[#495E57]">Verifica si el caso está en Autor, UODIDE o Área Técnica antes de reportarlo.</p>
            </article>
            <article class="rounded-2xl border border-[#A3B087]/40 bg-[#F5F7F8] p-4">
                <div class="text-2xl">i</div>
                <h2 class="mt-3 text-base font-black text-[#313647]">Contacto</h2>
                <p class="mt-2 text-sm leading-6 text-[#495E57]">Solicita apoyo al administrador del sistema o al responsable técnico institucional.</p>
            </article>
        </div>
    </section>
</div>
