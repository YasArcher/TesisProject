@page "/panel/principal"
@attribute [Authorize]

@using System.Threading
@using tesisproject.shared.DTOs.Articles
@using tesisproject.shared.DTOs.Catalogs
@using tesisproject.frontend.SharedUI.Dashboard
@using tesisproject.frontend.Services.Interfaces
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IArticlesClient ArticlesClient
@inject ICatalogsService CatalogsService
@implements IDisposable

<div class="min-h-[calc(100vh-80px)] bg-[#f2f2f2]">
    <div class="mx-auto max-w-[1400px] px-4 py-6 space-y-6">
        <!-- HERO: Título + tarjeta usuario/reloj -->
        <section class="rounded-3xl border border-slate-200/80 bg-white/95 px-5 py-4 shadow-lg shadow-slate-300/40 border-t-4 border-t-[#800909]">
            <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
                <!-- Título -->
                <div>
                    <h1 class="text-2xl md:text-3xl font-extrabold tracking-tight text-[#1c5052]">
                        Panel principal DIDE
                    </h1>
                    <p class="mt-1 text-sm md:text-base text-slate-600">
                        Dirección de Investigación y Desarrollo – Universidad Técnica de Ambato
                    </p>
                </div>

                <!-- Tarjeta usuario + reloj -->
                <div class="flex-shrink-0">
                    <DashboardUserSummaryCard UserName="@UserName"
                                             Initials="@Initials"
                                             Role="Investigador UTA"
                                             Time="@CurrentTime"
                                             Date="@CurrentDate"
                                             HeaderText="Sesión activa" />
                </div>
            </div>
        </section>

        <!-- KPIs (ahora con datos reales) -->
        <section class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-4">
            <DashboardKpiCard
                Title="Proyectos activos"
                Value="@(_kpisLoading ? "…" : KpiProjectsActive.ToString())"
                Description="Registrados en la DIDE"
                IconCss="bi bi-journal-text"
                ContainerClass="bg-white/95 border-slate-200"
                IconContainerClass="bg-[#1c5052]/10 text-[#1c5052]"
                TitleClass="text-slate-500"
                ValueClass="text-[#213635]"
                DescriptionClass="text-slate-500" />

            <DashboardKpiCard
                Title="Publicaciones"
                Value="@(_kpisLoading ? "…" : KpiPublications.ToString())"
                Description="Artículos registrados en el sistema"
                IconCss="bi bi-journal-check"
                ContainerClass="bg-emerald-50/80 border-emerald-100"
                IconContainerClass="bg-emerald-600/10 text-emerald-700"
                TitleClass="text-emerald-800/90"
                ValueClass="text-emerald-800"
                DescriptionClass="text-emerald-900/80" />

            <DashboardKpiCard
                Title="En ejecución"
                Value="@(_kpisLoading ? "…" : KpiInExecution.ToString())"
                Description="Artículos en estado ACEPTADO"
                IconCss="bi bi-clock-history"
                ContainerClass="bg-sky-50/80 border-sky-100"
                IconContainerClass="bg-sky-600/10 text-sky-700"
                TitleClass="text-sky-800/90"
                ValueClass="text-sky-800"
                DescriptionClass="text-sky-900/80" />

            <DashboardKpiCard
                Title="Nuevos este mes"
                Value="@(_kpisLoading ? "…" : KpiNewThisMonth.ToString())"
                Description="Artículos creados en el mes actual"
                IconCss="bi bi-graph-up-arrow"
                ContainerClass="bg-gradient-to-br from-[#800909]/4 via-white to-white border border-[#800909]/15"
                IconContainerClass="bg-[#800909]/15 text-[#800909]"
                TitleClass="text-[#4d1a1a]"
                ValueClass="text-[#800909]"
                DescriptionClass="text-[#4d1a1a]/80" />
        </section>

        <!-- Bloque central: video + galería -->
        <section class="grid grid-cols-1 gap-6 lg:grid-cols-2">
            <!-- Video institucional -->
            <article class="rounded-3xl border border-slate-200 bg-white/95 shadow-sm">
                <header class="border-b border-slate-200/70 bg-gradient-to-r from-[#1c5052]/8 via-white to-white px-5 py-4">
                    <h2 class="text-base md:text-lg font-semibold text-[#1c5052] flex items-center gap-2">
                        <span class="flex h-8 w-8 items-center justify-center rounded-xl bg-[#1c5052]/15 text-[#1c5052]">
                            <i class="bi bi-play-circle"></i>
                        </span>
                        Video institucional DIDE
                    </h2>
                    <p class="mt-1 text-xs md:text-sm text-slate-600">
                        Conoce la misión, visión y líneas de acción de la Dirección de Investigación y Desarrollo.
                    </p>
                </header>
                <div class="p-5">
                    <div class="flex aspect-video items-center justify-center rounded-2xl bg-gradient-to-br from-[#1c5052]/12 via-[#213635]/10 to-[#800909]/12">
                        <div class="text-center">
                            <button class="mx-auto mb-4 flex h-20 w-20 items-center justify-center rounded-full bg-gradient-to-r from-[#1c5052] to-[#800909] shadow-lg shadow-[#1c5052]/40">
                                <svg class="h-10 w-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
                                </svg>
                            </button>
                            <p class="text-xs md:text-sm text-slate-700">
                                Video institucional DIDE–UTA
                            </p>
                            <button class="mt-3 inline-flex items-center justify-center rounded-xl bg-gradient-to-r from-[#1c5052] to-[#800909] px-4 py-2 text-[11px] font-semibold uppercase tracking-wide text-white shadow-sm hover:from-[#213635] hover:to-[#800909]">
                                Ver video
                            </button>
                        </div>
                    </div>
                </div>
            </article>

            <!-- Galería / entorno DIDE -->
            <article class="rounded-3xl border border-slate-200 bg-white/95 shadow-sm">
                <header class="border-b border-slate-200/70 bg-gradient-to-r from-[#800909]/8 via-white to-white px-5 py-4">
                    <h2 class="text-base md:text-lg font-semibold text-[#800909] flex items-center gap-2">
                        <span class="flex h-8 w-8 items-center justify-center rounded-xl bg-[#800909]/15 text-[#800909]">
                            <i class="bi bi-image"></i>
                        </span>
                        Galería DIDE
                    </h2>
                    <p class="mt-1 text-xs md:text-sm text-slate-600">
                        Un vistazo a nuestras instalaciones, equipo y actividades institucionales.
                    </p>
                </header>
                <div class="p-5 space-y-4">
                    <div class="grid grid-cols-2 gap-3">
                        <div class="flex aspect-square items-center justify-center rounded-2xl bg-gradient-to-br from-[#1c5052] to-[#348e91] p-2 text-center text-xs font-semibold text-white">
                            Laboratorios de investigación
                        </div>
                        <div class="flex aspect-square items-center justify-center rounded-2xl bg-gradient-to-br from-[#800909] to-[#4d1a1a] p-2 text-center text-xs font-semibold text-white">
                            Equipo DIDE
                        </div>
                        <div class="flex aspect-square items-center justify-center rounded-2xl bg-gradient-to-br from-[#213635] to-[#0a0c0d] p-2 text-center text-xs font-semibold text-white">
                            Eventos académicos
                        </div>
                        <div class="flex aspect-square items-center justify-center rounded-2xl bg-gradient-to-br from-[#348e91] to-[#1c5052] p-2 text-center text-xs font-semibold text-white">
                            Proyectos en marcha
                        </div>
                    </div>

                    <button class="w-full inline-flex items-center justify-center rounded-xl border border-slate-300 bg-white px-4 py-2 text-[11px] font-semibold uppercase tracking-wide text-slate-700 shadow-sm hover:bg-slate-50">
                        Ver galería completa
                    </button>
                </div>
            </article>
        </section>

        <!-- Bloque informativo: capacidades y fortalezas -->
        <section class="rounded-3xl border border-slate-200 bg-white/95 px-5 py-5 shadow-sm">
            <div class="mb-4 flex items-center justify-between gap-3">
                <div>
                    <h2 class="text-base md:text-lg font-semibold text-[#213635]">
                        Capacidades y fortalezas de la DIDE
                    </h2>
                    <p class="text-xs md:text-sm text-slate-600">
                        Elementos claves que soportan la gestión de proyectos y publicaciones científicas.
                    </p>
                </div>
            </div>

            <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
                <DashboardHighlightCard
                    Title="Infraestructura"
                    Description="Laboratorios especializados, equipamiento y espacios diseñados para potenciar la investigación aplicada."
                    IconCss="bi bi-building"
                    ContainerClass="border-slate-200/80 bg-gradient-to-br from-[#f9fafb] via-white to-[#f3f4f6]"
                    IconContainerClass="bg-[#1c5052]/10 text-[#1c5052]"
                    TitleClass="text-[#1c5052]"
                    DescriptionClass="text-slate-600" />

                <DashboardHighlightCard
                    Title="Certificación"
                    Description="Procesos alineados con estándares de calidad y normativas nacionales e internacionales."
                    IconCss="bi bi-shield-check"
                    ContainerClass="border-emerald-100 bg-emerald-50/70"
                    IconContainerClass="bg-emerald-700/10 text-emerald-700"
                    TitleClass="text-emerald-800"
                    DescriptionClass="text-emerald-900/90" />

                <DashboardHighlightCard
                    Title="Innovación"
                    Description="Impulso a soluciones tecnológicas avanzadas y proyectos con impacto regional y nacional."
                    IconCss="bi bi-lightbulb"
                    ContainerClass="border-sky-100 bg-sky-50/70"
                    IconContainerClass="bg-sky-600/10 text-sky-700"
                    TitleClass="text-sky-800"
                    DescriptionClass="text-sky-900/90" />
            </div>
        </section>

        <!-- Actividad reciente -->
        <section class="rounded-3xl border border-slate-200 bg-white/95 px-5 py-5 shadow-sm">
            <header class="mb-3">
                <h2 class="text-base md:text-lg font-semibold text-[#800909]">
                    Actividad reciente DIDE
                </h2>
                <p class="text-xs md:text-sm text-slate-600">
                    Resumen de los últimos movimientos en proyectos y publicaciones científicas.
                </p>
            </header>

            <div class="space-y-3">
                <DashboardActivityItem
                    Title="Nuevo proyecto aprobado"
                    Description="&quot;Desarrollo de materiales compuestos sostenibles&quot;"
                    TimeAgo="Hace 2 días"
                    ContainerClass="border-l-[#800909] bg-[#800909]/5"
                    DotClass="bg-[#800909]"
                    TitleClass="text-[#800909]"
                    DescriptionClass="text-slate-700" />

                <DashboardActivityItem
                    Title="Publicación indexada"
                    Description="&quot;Análisis de eficiencia energética en procesos industriales&quot;"
                    TimeAgo="Hace 1 semana"
                    ContainerClass="border-l-emerald-600 bg-emerald-50"
                    DotClass="bg-emerald-600"
                    TitleClass="text-emerald-800"
                    DescriptionClass="text-slate-700" />

                <DashboardActivityItem
                    Title="Convenio internacional"
                    Description="Firma de acuerdo con universidad europea para investigación conjunta."
                    TimeAgo="Hace 2 semanas"
                    ContainerClass="border-l-sky-700 bg-sky-50"
                    DotClass="bg-sky-700"
                    TitleClass="text-sky-800"
                    DescriptionClass="text-slate-700" />
            </div>
        </section>
    </div>
</div>

@code {
    private string UserName = "Usuario";
    private string Initials = "U";
    private string CurrentTime = "00:00:00";
    private string CurrentDate = "01 de enero de 2024";
    private Timer? timer;

    // KPIs
    private bool _kpisLoading = true;
    private int KpiProjectsActive;
    private int KpiPublications;
    private int KpiInExecution;
    private int KpiNewThisMonth;

    protected override async Task OnInitializedAsync()
    {
        await LoadUserData();
        StartClock();
        await LoadKpisAsync();
    }

    private async Task LoadUserData()
    {
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity?.IsAuthenticated == true)
            {
                UserName = user.Identity.Name ?? "Usuario";
                Initials = GetInitials(UserName);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading user data: {ex.Message}");
        }
    }

    private async Task LoadKpisAsync()
    {
        try
        {
            _kpisLoading = true;

            var articlesTask = ArticlesClient.GetAllAsync();
            var projectsTask = CatalogsService.GetProjectsAsync();

            await Task.WhenAll(articlesTask, projectsTask);

            var articles = articlesTask.Result ?? new List<ArticleListItemDto>();
            var projects = projectsTask.Result ?? new List<CatalogItemDto>();

            // Proyectos activos (por ahora: total proyectos registrados)
            KpiProjectsActive = projects.Count;

            // Publicaciones = total artículos registrados
            KpiPublications = articles.Count;

            // En ejecución: artículos con estado ACEPATDO
            KpiInExecution = articles.Count(a =>
                (a.PublicationStatusName ?? string.Empty)
                    .Trim()
                    .ToUpperInvariant() == "ACEPTADO");

            // Nuevos este mes: según CreatedAt
            var now = DateTime.Now;
            KpiNewThisMonth = articles.Count(a =>
                a.CreatedAt.Year == now.Year &&
                a.CreatedAt.Month == now.Month);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cargando KPIs: {ex.Message}");
        }
        finally
        {
            _kpisLoading = false;
            StateHasChanged();
        }
    }

    private string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "U";

        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
        {
            return $"{parts[0][0]}{parts[1][0]}".ToUpperInvariant();
        }

        return parts[0][0].ToString().ToUpperInvariant();
    }

    private void StartClock()
    {
        UpdateClock();
        timer = new Timer(_ =>
        {
            InvokeAsync(UpdateClock);
        }, null, 1000, 1000);
    }

    private void UpdateClock()
    {
        var now = DateTime.Now;
        CurrentTime = now.ToString("HH:mm:ss");
        CurrentDate = now.ToString("dd 'de' MMMM 'de' yyyy",
            new System.Globalization.CultureInfo("es-ES"));
        StateHasChanged();
    }

    public void Dispose()
    {
        timer?.Dispose();
    }
}
