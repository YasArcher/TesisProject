@page "/panel/principal"
@attribute [Authorize]

@using System.Threading
@using tesisproject.frontend.Services.Interfaces
@using tesisproject.shared.DTOs.Articles
@using tesisproject.shared.DTOs.Catalogs
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IArticlesClient ArticlesClient
@inject ICatalogsService CatalogsService
@implements IDisposable

<div class="principal-shell">
    <div class="app-page-shell principal-shell__inner">
        <section class="principal-hero">
            <div class="principal-hero__copy">
                <span class="principal-chip">@Greeting</span>
                <h1 class="principal-hero__title">Centro de control de investigación y publicaciones</h1>
                <p class="principal-hero__subtitle">
                    Seguimiento operativo para registro, configuración dinámica, carga masiva y validación de información científica.
                </p>

                <div class="principal-hero__actions">
                    <a class="principal-action principal-action--solid" href="/articulos/registrar">
                        <span class="principal-action__icon">+</span>
                        <span>Registrar artículo</span>
                    </a>
                    <a class="principal-action principal-action--ghost" href="/management/exportinformation">
                        <span class="principal-action__icon">⇪</span>
                        <span>Ir a carga masiva</span>
                    </a>
                    <a class="principal-action principal-action--ghost" href="/management/externalapis">
                        <span class="principal-action__icon">↗</span>
                        <span>Consultar APIs externas</span>
                    </a>
                </div>
            </div>

            <aside class="principal-status-card">
                <div class="principal-status-card__head">
                    <div>
                        <div class="principal-status-card__label">Sesión operativa</div>
                        <div class="principal-status-card__user">@UserName</div>
                    </div>
                    <div class="principal-status-card__badge">En línea</div>
                </div>

                <div class="principal-status-card__clock">@CurrentTime</div>
                <div class="principal-status-card__date">@CurrentDate</div>

                <div class="principal-status-card__meta">
                    <div class="principal-mini-stat">
                        <span class="principal-mini-stat__label">Rol</span>
                        <strong>@UserRole</strong>
                    </div>
                    <div class="principal-mini-stat">
                        <span class="principal-mini-stat__label">Iniciales</span>
                        <strong>@Initials</strong>
                    </div>
                </div>
            </aside>
        </section>

        <section class="principal-kpis">
            @foreach (var metric in DashboardMetrics)
            {
                <article class="principal-kpi-card @(metric.Highlight ? "principal-kpi-card--highlight" : string.Empty)">
                    <div class="principal-kpi-card__top">
                        <span class="principal-kpi-card__label">@metric.Title</span>
                        <span class="principal-kpi-card__icon">@metric.Icon</span>
                    </div>
                    <div class="principal-kpi-card__value">@metric.Value</div>
                    <p class="principal-kpi-card__description">@metric.Description</p>
                    <div class="principal-kpi-card__foot">
                        <span class="principal-kpi-card__trend">@metric.Trend</span>
                    </div>
                </article>
            }
        </section>

        <section class="principal-grid">
            <article class="principal-panel principal-panel--spotlight">
                <div class="principal-panel__head">
                    <div>
                        <span class="principal-panel__eyebrow">Foco del momento</span>
                        <h2 class="principal-panel__title">@CurrentFocus.Title</h2>
                    </div>
                    <span class="principal-pulse"></span>
                </div>

                <p class="principal-panel__copy">@CurrentFocus.Description</p>

                <div class="principal-focus-list">
                    @foreach (var point in CurrentFocus.Bullets)
                    {
                        <div class="principal-focus-item">
                            <span class="principal-focus-item__dot"></span>
                            <span>@point</span>
                        </div>
                    }
                </div>
            </article>

            <article class="principal-panel">
                <div class="principal-panel__head">
                    <div>
                        <span class="principal-panel__eyebrow">Atajos</span>
                        <h2 class="principal-panel__title">Flujos principales</h2>
                    </div>
                </div>

                <div class="principal-shortcuts">
                    @foreach (var shortcut in QuickActions)
                    {
                        <a class="principal-shortcut" href="@shortcut.Href">
                            <div class="principal-shortcut__icon">@shortcut.Icon</div>
                            <div>
                                <div class="principal-shortcut__title">@shortcut.Title</div>
                                <div class="principal-shortcut__description">@shortcut.Description</div>
                            </div>
                        </a>
                    }
                </div>
            </article>
        </section>

        <section class="principal-grid principal-grid--balanced">
            <article class="principal-panel">
                <div class="principal-panel__head">
                    <div>
                        <span class="principal-panel__eyebrow">Pulso del sistema</span>
                        <h2 class="principal-panel__title">Indicadores operativos</h2>
                    </div>
                </div>

                <div class="principal-progress-list">
                    @foreach (var item in OperationalIndicators)
                    {
                        <div class="principal-progress-item">
                            <div class="principal-progress-item__meta">
                                <span>@item.Label</span>
                                <strong>@item.DisplayValue</strong>
                            </div>
                            <div class="principal-progress-item__bar">
                                <span style="width:@item.Percent%"></span>
                            </div>
                        </div>
                    }
                </div>
            </article>

            <article class="principal-panel">
                <div class="principal-panel__head">
                    <div>
                        <span class="principal-panel__eyebrow">Actividad</span>
                        <h2 class="principal-panel__title">Movimientos recientes</h2>
                    </div>
                </div>

                <div class="principal-activity">
                    @foreach (var activity in ActivityFeed)
                    {
                        <div class="principal-activity__item">
                            <div class="principal-activity__rail"></div>
                            <div class="principal-activity__content">
                                <div class="principal-activity__time">@activity.TimeAgo</div>
                                <div class="principal-activity__title">@activity.Title</div>
                                <div class="principal-activity__description">@activity.Description</div>
                            </div>
                        </div>
                    }
                </div>
            </article>
        </section>
    </div>
</div>

@code {
    private string UserName = "Usuario";
    private string Initials = "U";
    private string UserRole = "Investigador UTA";
    private string Greeting = "Bienvenido";
    private string CurrentTime = "00:00:00";
    private string CurrentDate = "01 de enero de 2024";
    private Timer? timer;

    private bool _kpisLoading = true;
    private int KpiProjectsActive;
    private int KpiPublications;
    private int KpiInExecution;
    private int KpiNewThisMonth;
    private int _focusIndex;

    private IReadOnlyList<DashboardMetric> DashboardMetrics => new[]
    {
        new DashboardMetric("Proyectos activos", _kpisLoading ? "..." : KpiProjectsActive.ToString(), "Panorama de iniciativas registradas", "↺", $"{Math.Max(KpiProjectsActive, 1)} frentes abiertos"),
        new DashboardMetric("Publicaciones", _kpisLoading ? "..." : KpiPublications.ToString(), "Volumen de artículos en el sistema", "⌘", $"{Math.Max(KpiPublications, 1)} artículos totales", true),
        new DashboardMetric("Aceptados", _kpisLoading ? "..." : KpiInExecution.ToString(), "Seguimiento de artículos en estado aceptado", "✓", $"{Math.Max(KpiInExecution, 1)} en seguimiento"),
        new DashboardMetric("Altas del mes", _kpisLoading ? "..." : KpiNewThisMonth.ToString(), "Movimientos recientes en el mes actual", "↑", $"{Math.Max(KpiNewThisMonth, 1)} registros recientes")
    };

    private IReadOnlyList<QuickAction> QuickActions => new[]
    {
        new QuickAction("Formulario dinámico", "Configura campos, formularios y reglas activas.", "/configuration", "⚙"),
        new QuickAction("Registro manual", "Trabaja sobre el formulario activo y mutable.", "/articulos/registrar", "✎"),
        new QuickAction("Carga masiva", "Valida staging, corrige filas y procesa lotes.", "/management/exportinformation", "⇪"),
        new QuickAction("Explorador externo", "Consulta DOI, autores y fuentes académicas.", "/management/externalapis", "◎")
    };

    private IReadOnlyList<FocusCard> FocusCards => new[]
    {
        new FocusCard("Formulario activo y mutable", "La configuración dinámica ya gobierna qué se renderiza en el registro y en la carga masiva.", new[] { "Ajusta campos obligatorios desde configuración.", "Activa un formulario nuevo sin tocar código.", "Usa el mismo contrato para registro y staging." }),
        new FocusCard("Calidad del dato antes de procesar", "El staging ya permite validar, corregir y revisar errores sin salir de la interfaz.", new[] { "Corrige filas con dependencias OCDE.", "Revalida desde la misma bandeja.", "Procesa solo cuando el lote esté consistente." }),
        new FocusCard("Conexión con fuentes externas", "Scopus y otros proveedores pueden servir como puerta de entrada para nuevos registros y cargas externas.", new[] { "Consulta por DOI, texto, autor o coautor.", "Enriquece metadata antes de registrar.", "Prepara el salto a staging externo." })
    };

    private FocusCard CurrentFocus => FocusCards[_focusIndex % FocusCards.Count];

    private IReadOnlyList<OperationalIndicator> OperationalIndicators => new[]
    {
        new OperationalIndicator("Cobertura de publicaciones", KpiPublications, Math.Max(KpiPublications + 4, 8)),
        new OperationalIndicator("Seguimiento de artículos aceptados", KpiInExecution, Math.Max(KpiPublications, 6)),
        new OperationalIndicator("Carga del mes", KpiNewThisMonth, Math.Max(KpiPublications, 5)),
        new OperationalIndicator("Relación proyectos/publicaciones", KpiProjectsActive, Math.Max(Math.Max(KpiPublications, KpiProjectsActive + 2), 6))
    };

    private IReadOnlyList<ActivityEntry> ActivityFeed => new[]
    {
        new ActivityEntry("Configuración de formularios", "El sistema puede alternar formularios activos sin romper el registro manual.", "Ahora"),
        new ActivityEntry("Carga masiva dinámica", "Staging, validación y corrección asistida listos para lotes más complejos.", "Hace poco"),
        new ActivityEntry("Fuentes externas", "El explorador ya consulta Scopus y transfiere resultados al registro.", "Reciente"),
        new ActivityEntry("Arquitectura consolidada", "El núcleo nuevo y el legado ya están separados físicamente para evolucionar con menos riesgo.", "Hoy")
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadUserData();
        StartClock();
        await LoadKpisAsync();
    }

    private async Task LoadUserData()
    {
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity?.IsAuthenticated == true)
            {
                UserName = user.Identity.Name ?? "Usuario";
                Initials = GetInitials(UserName);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading user data: {ex.Message}");
        }
    }

    private async Task LoadKpisAsync()
    {
        try
        {
            _kpisLoading = true;

            var articlesTask = ArticlesClient.GetAllAsync();
            var projectsTask = CatalogsService.GetProjectsAsync();

            await Task.WhenAll(articlesTask, projectsTask);

            var articles = articlesTask.Result ?? new List<ArticleListItemDto>();
            var projects = projectsTask.Result ?? new List<CatalogItemDto>();

            KpiProjectsActive = projects.Count;
            KpiPublications = articles.Count;
            KpiInExecution = articles.Count(a => (a.PublicationStatusName ?? string.Empty).Trim().ToUpperInvariant() == "ACEPTADO");

            var now = DateTime.Now;
            KpiNewThisMonth = articles.Count(a => a.CreatedAt.Year == now.Year && a.CreatedAt.Month == now.Month);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cargando KPIs: {ex.Message}");
        }
        finally
        {
            _kpisLoading = false;
            StateHasChanged();
        }
    }

    private static string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "U";

        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2
            ? $"{parts[0][0]}{parts[1][0]}".ToUpperInvariant()
            : parts[0][0].ToString().ToUpperInvariant();
    }

    private void StartClock()
    {
        UpdateClock();
        timer = new Timer(_ =>
        {
            InvokeAsync(() =>
            {
                UpdateClock();
                StateHasChanged();
            });
        }, null, 1000, 1000);
    }

    private void UpdateClock()
    {
        var now = DateTime.Now;
        CurrentTime = now.ToString("HH:mm:ss");
        CurrentDate = now.ToString("dd 'de' MMMM 'de' yyyy", new System.Globalization.CultureInfo("es-ES"));
        Greeting = now.Hour switch
        {
            var hour when hour < 12 => "Buenos días",
            var hour when hour < 18 => "Buenas tardes",
            _ => "Buenas noches"
        };

        if (now.Second % 8 == 0)
        {
            _focusIndex = (_focusIndex + 1) % FocusCards.Count;
        }
    }

    public void Dispose()
    {
        timer?.Dispose();
    }

    private sealed record DashboardMetric(string Title, string Value, string Description, string Icon, string Trend, bool Highlight = false);
    private sealed record QuickAction(string Title, string Description, string Href, string Icon);
    private sealed record FocusCard(string Title, string Description, IReadOnlyList<string> Bullets);
    private sealed record OperationalIndicator(string Label, int Value, int Total)
    {
        public int Percent => Total <= 0 ? 0 : Math.Clamp((int)Math.Round((double)Value / Total * 100), 0, 100);
        public string DisplayValue => $"{Value} / {Math.Max(Total, 1)}";
    }
    private sealed record ActivityEntry(string Title, string Description, string TimeAgo);
}
