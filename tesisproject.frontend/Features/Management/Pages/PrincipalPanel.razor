@page "/panel/principal"
@attribute [Authorize]
@inject AuthenticationStateProvider AuthenticationStateProvider

<div class="min-h-screen bg-gradient-to-br from-[#E3E2E1] to-[#f0f0f0] py-8 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
        <!-- Header con información del usuario y reloj mejorado -->
        <div class="mb-8">
            <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6">
                <div class="text-center lg:text-left">
                    <h1 class="text-3xl font-bold text-[#7A1E19]">Panel Principal DIDE</h1>
                    <p class="mt-2 text-lg text-[#5D4037]">Dirección de Investigación y Desarrollo - UTA</p>
                </div>

                <!-- Tarjeta de usuario y reloj modernizada -->
                <div class="bg-gradient-to-r from-[#7A1E19] to-[#9C4A3C] rounded-2xl shadow-lg p-6 text-white min-w-80 transform hover:scale-105 transition-transform duration-300">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center space-x-4">
                            <div class="flex-shrink-0">
                                <div class="w-14 h-14 bg-white/20 rounded-full flex items-center justify-center border-2 border-white/30">
                                    <span class="text-white font-bold text-lg">@Initials</span>
                                </div>
                            </div>
                            <div>
                                <p class="text-sm font-semibold text-white/90">@UserName</p>
                                <p class="text-xs text-white/70">Investigador UTA</p>
                            </div>
                        </div>
                        <div class="text-right">
                            <div class="text-2xl font-mono font-bold text-white bg-black/20 px-3 py-1 rounded-lg">@CurrentTime</div>
                            <div class="text-sm text-white/80 mt-1">@CurrentDate</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sección con degradado -->
        <div class="relative mb-8">
            <div class="absolute inset-0 bg-gradient-to-r from-[#7A1E19]/10 to-[#2E7D32]/10 rounded-2xl"></div>

            <!-- Estadísticas rápidas -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 relative z-10">
                <div class="bg-white rounded-2xl shadow-soft p-6 border-l-4 border-l-[#7A1E19] hover:shadow-lg transition-all duration-300">
                    <div class="flex items-center">
                        <div class="flex-shrink-0">
                            <div class="w-12 h-12 bg-[#7A1E19]/10 rounded-lg flex items-center justify-center">
                                <svg class="w-6 h-6 text-[#7A1E19]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                                </svg>
                            </div>
                        </div>
                        <div class="ml-4">
                            <p class="text-sm font-medium text-[#5D4037]">Proyectos Activos</p>
                            <p class="text-2xl font-bold text-[#7A1E19]">24</p>
                        </div>
                    </div>
                </div>

                <div class="bg-white rounded-2xl shadow-soft p-6 border-l-4 border-l-[#2E7D32] hover:shadow-lg transition-all duration-300">
                    <div class="flex items-center">
                        <div class="flex-shrink-0">
                            <div class="w-12 h-12 bg-[#2E7D32]/10 rounded-lg flex items-center justify-center">
                                <svg class="w-6 h-6 text-[#2E7D32]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                </svg>
                            </div>
                        </div>
                        <div class="ml-4">
                            <p class="text-sm font-medium text-[#5D4037]">Publicaciones</p>
                            <p class="text-2xl font-bold text-[#2E7D32]">156</p>
                        </div>
                    </div>
                </div>

                <div class="bg-white rounded-2xl shadow-soft p-6 border-l-4 border-l-[#1565C0] hover:shadow-lg transition-all duration-300">
                    <div class="flex items-center">
                        <div class="flex-shrink-0">
                            <div class="w-12 h-12 bg-[#1565C0]/10 rounded-lg flex items-center justify-center">
                                <svg class="w-6 h-6 text-[#1565C0]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                </svg>
                            </div>
                        </div>
                        <div class="ml-4">
                            <p class="text-sm font-medium text-[#5D4037]">En Ejecución</p>
                            <p class="text-2xl font-bold text-[#1565C0]">18</p>
                        </div>
                    </div>
                </div>

                <div class="bg-white rounded-2xl shadow-soft p-6 border-l-4 border-l-[#9C4A3C] hover:shadow-lg transition-all duration-300">
                    <div class="flex items-center">
                        <div class="flex-shrink-0">
                            <div class="w-12 h-12 bg-[#9C4A3C]/10 rounded-lg flex items-center justify-center">
                                <svg class="w-6 h-6 text-[#9C4A3C]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
                                </svg>
                            </div>
                        </div>
                        <div class="ml-4">
                            <p class="text-sm font-medium text-[#5D4037]">Nuevos Este Mes</p>
                            <p class="text-2xl font-bold text-[#9C4A3C]">7</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sección con degradado inverso -->
        <div class="relative mb-8">
            <div class="absolute inset-0 bg-gradient-to-l from-[#7A1E19]/5 to-[#2E7D32]/5 rounded-2xl"></div>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 relative z-10">
                <!-- Video destacado -->
                <div class="bg-white rounded-2xl shadow-soft overflow-hidden">
                    <div class="p-6 border-b border-gray-200 bg-gradient-to-r from-[#7A1E19]/5 to-transparent">
                        <h2 class="text-xl font-semibold text-[#7A1E19]">Video Institucional DIDE</h2>
                        <p class="mt-1 text-sm text-[#5D4037]">Conoce nuestra labor en investigación</p>
                    </div>
                    <div class="p-6">
                        <div class="bg-gradient-to-br from-[#7A1E19]/10 to-[#2E7D32]/10 rounded-lg aspect-video flex items-center justify-center">
                            <div class="text-center">
                                <div class="w-20 h-20 bg-gradient-to-r from-[#7A1E19] to-[#9C4A3C] rounded-full flex items-center justify-center mx-auto mb-4">
                                    <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path>
                                    </svg>
                                </div>
                                <p class="text-sm text-[#5D4037]">Video institucional DIDE-UTA</p>
                                <button class="mt-4 inline-flex items-center px-4 py-2 bg-gradient-to-r from-[#7A1E19] to-[#9C4A3C] border border-transparent rounded-md font-semibold text-xs text-white uppercase tracking-widest hover:from-[#8C2A24] hover:to-[#AB5A4C] focus:outline-none focus:ring-2 focus:ring-[#7A1E19] focus:ring-offset-2 transition ease-in-out duration-150">
                                    Ver video
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Galería de fotos DIDE -->
                <div class="bg-white rounded-2xl shadow-soft overflow-hidden">
                    <div class="p-6 border-b border-gray-200 bg-gradient-to-r from-[#2E7D32]/5 to-transparent">
                        <h2 class="text-xl font-semibold text-[#2E7D32]">Galería DIDE</h2>
                        <p class="mt-1 text-sm text-[#5D4037]">Nuestras instalaciones y actividades</p>
                    </div>
                    <div class="p-6">
                        <div class="grid grid-cols-2 gap-4">
                            <div class="aspect-square bg-gradient-to-br from-[#7A1E19] to-[#9C4A3C] rounded-lg flex items-center justify-center text-white font-semibold text-center p-2 text-sm">
                                Laboratorios de Investigación
                            </div>
                            <div class="aspect-square bg-gradient-to-br from-[#2E7D32] to-[#4CAF50] rounded-lg flex items-center justify-center text-white font-semibold text-center p-2 text-sm">
                                Equipo DIDE
                            </div>
                            <div class="aspect-square bg-gradient-to-br from-[#1565C0] to-[#42A5F5] rounded-lg flex items-center justify-center text-white font-semibold text-center p-2 text-sm">
                                Eventos Académicos
                            </div>
                            <div class="aspect-square bg-gradient-to-br from-[#5D4037] to-[#8D6E63] rounded-lg flex items-center justify-center text-white font-semibold text-center p-2 text-sm">
                                Proyectos en Marcha
                            </div>
                        </div>
                        <button class="w-full mt-4 inline-flex items-center justify-center px-4 py-2 bg-gradient-to-r from-[#2E7D32] to-[#4CAF50] border border-transparent rounded-md font-semibold text-xs text-white uppercase tracking-widest hover:from-[#1B5E20] hover:to-[#388E3C] focus:outline-none focus:ring-2 focus:ring-[#2E7D32] focus:ring-offset-2 transition ease-in-out duration-150">
                            Ver galería completa
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Cards informativas con degradado de fondo -->
        <div class="relative mb-8">
            <div class="absolute inset-0 bg-gradient-to-b from-[#7A1E19]/5 to-transparent rounded-2xl"></div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 relative z-10">
                <div class="bg-white rounded-2xl shadow-soft p-6 hover:shadow-lg transition-all duration-300">
                    <div class="flex items-start">
                        <div class="flex-shrink-0">
                            <div class="w-10 h-10 bg-[#7A1E19]/10 rounded-lg flex items-center justify-center">
                                <svg class="w-5 h-5 text-[#7A1E19]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
                                </svg>
                            </div>
                        </div>
                        <div class="ml-4">
                            <h3 class="text-lg font-semibold text-[#7A1E19]">Infraestructura</h3>
                            <p class="mt-2 text-sm text-[#5D4037]">Laboratorios especializados y equipos de última generación para investigación.</p>
                        </div>
                    </div>
                </div>

                <div class="bg-white rounded-2xl shadow-soft p-6 hover:shadow-lg transition-all duration-300">
                    <div class="flex items-start">
                        <div class="flex-shrink-0">
                            <div class="w-10 h-10 bg-[#2E7D32]/10 rounded-lg flex items-center justify-center">
                                <svg class="w-5 h-5 text-[#2E7D32]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
                                </svg>
                            </div>
                        </div>
                        <div class="ml-4">
                            <h3 class="text-lg font-semibold text-[#2E7D32]">Certificación</h3>
                            <p class="mt-2 text-sm text-[#5D4037]">Procesos avalados y certificados bajo estándares internacionales de calidad.</p>
                        </div>
                    </div>
                </div>

                <div class="bg-white rounded-2xl shadow-soft p-6 hover:shadow-lg transition-all duration-300">
                    <div class="flex items-start">
                        <div class="flex-shrink-0">
                            <div class="w-10 h-10 bg-[#1565C0]/10 rounded-lg flex items-center justify-center">
                                <svg class="w-5 h-5 text-[#1565C0]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                                </svg>
                            </div>
                        </div>
                        <div class="ml-4">
                            <h3 class="text-lg font-semibold text-[#1565C0]">Innovación</h3>
                            <p class="mt-2 text-sm text-[#5D4037]">Soluciones tecnológicas avanzadas para el desarrollo investigativo regional.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Últimas actividades con degradado -->
        <div class="relative">
            <div class="absolute inset-0 bg-gradient-to-t from-[#E3E2E1] to-transparent rounded-2xl"></div>

            <div class="bg-white rounded-2xl shadow-soft overflow-hidden relative z-10">
                <div class="p-6 border-b border-gray-200 bg-gradient-to-r from-[#7A1E19]/5 to-transparent">
                    <h2 class="text-xl font-semibold text-[#7A1E19]">Actividad Reciente DIDE</h2>
                    <p class="mt-1 text-sm text-[#5D4037]">Últimos proyectos y publicaciones</p>
                </div>
                <div class="p-6">
                    <div class="space-y-4">
                        <div class="flex items-center space-x-4 p-4 bg-[#7A1E19]/5 rounded-lg border-l-4 border-l-[#7A1E19]">
                            <div class="flex-shrink-0 w-2 h-2 bg-[#7A1E19] rounded-full"></div>
                            <div class="flex-1">
                                <p class="text-sm font-medium text-[#7A1E19]">Nuevo proyecto aprobado</p>
                                <p class="text-sm text-[#5D4037]">"Desarrollo de materiales compuestos sostenibles"</p>
                            </div>
                            <span class="text-sm text-[#9C4A3C]">Hace 2 días</span>
                        </div>
                        <div class="flex items-center space-x-4 p-4 bg-[#2E7D32]/5 rounded-lg border-l-4 border-l-[#2E7D32]">
                            <div class="flex-shrink-0 w-2 h-2 bg-[#2E7D32] rounded-full"></div>
                            <div class="flex-1">
                                <p class="text-sm font-medium text-[#2E7D32]">Publicación indexada</p>
                                <p class="text-sm text-[#5D4037]">"Análisis de eficiencia energética en procesos industriales"</p>
                            </div>
                            <span class="text-sm text-[#9C4A3C]">Hace 1 semana</span>
                        </div>
                        <div class="flex items-center space-x-4 p-4 bg-[#1565C0]/5 rounded-lg border-l-4 border-l-[#1565C0]">
                            <div class="flex-shrink-0 w-2 h-2 bg-[#1565C0] rounded-full"></div>
                            <div class="flex-1">
                                <p class="text-sm font-medium text-[#1565C0]">Convenio internacional</p>
                                <p class="text-sm text-[#5D4037]">Firma de acuerdo con universidad europea para investigación conjunta</p>
                            </div>
                            <span class="text-sm text-[#9C4A3C]">Hace 2 semanas</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string UserName = "Usuario";
    private string Initials = "U";
    private string CurrentTime = "00:00:00";
    private string CurrentDate = "01 de enero de 2024";
    private Timer? timer;

    protected override async Task OnInitializedAsync()
    {
        await LoadUserData();
        StartClock();
    }

    private async Task LoadUserData()
    {
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity?.IsAuthenticated == true)
            {
                UserName = user.Identity.Name ?? "Usuario";
                Initials = GetInitials(UserName);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading user data: {ex.Message}");
        }
    }

    private string GetInitials(string name)
    {
        if (string.IsNullOrEmpty(name)) return "U";

        var names = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (names.Length >= 2)
            return $"{names[0][0]}{names[1][0]}".ToUpper();

        return names[0][0].ToString().ToUpper();
    }

    private void StartClock()
    {
        UpdateClock();
        timer = new Timer(new TimerCallback(_ =>
        {
            InvokeAsync(UpdateClock);
            StateHasChanged();
        }), null, 1000, 1000);
    }

    private void UpdateClock()
    {
        var now = DateTime.Now;
        CurrentTime = now.ToString("HH:mm:ss");
        CurrentDate = now.ToString("dd 'de' MMMM 'de' yyyy",
            new System.Globalization.CultureInfo("es-ES"));
    }

    public void Dispose()
    {
        timer?.Dispose();
    }
}