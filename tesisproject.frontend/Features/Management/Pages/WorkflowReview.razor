        return normalized switch
        {
            "approved" => "rounded-full bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-700",
            "returned" => "rounded-full bg-amber-50 px-3 py-1 text-xs font-semibold text-amber-700",
            "submitted" => "rounded-full bg-sky-50 px-3 py-1 text-xs font-semibold text-sky-700",
            "inreview" => "rounded-full bg-violet-50 px-3 py-1 text-xs font-semibold text-violet-700",
            "assigned" => "rounded-full bg-indigo-50 px-3 py-1 text-xs font-semibold text-indigo-700",
            _ => "rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-700"
        };
    }

    private static string FormatDateTime(DateTime? value)
        => value.HasValue ? value.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm") : "Sin registro";

    private static string GetFriendlyWorkflowStatus(string? status)
    {
        var normalized = (status ?? string.Empty).Trim().ToLowerInvariant();
        return normalized switch
        {
            "submitted" => "En revisión",
            "inreview" => "En revisión activa",
            "returned" => "Devuelto con observaciones",
            "approved" => "Aprobado",
            "processed" => "Procesado",
            _ => string.IsNullOrWhiteSpace(status) ? "Sin estado" : status
        };
    }

    private string GetCurrentStageLabel()
        => !string.IsNullOrWhiteSpace(SelectedWorkflow?.CurrentStageName)
            ? $"Etapa actual: {SelectedWorkflow.CurrentStageName}"
            : "El workflow ya no tiene una etapa pendiente.";

    private string GetWorkflowProgressCaption()
    {
        if (SelectedInboxItem?.ProcessedRows > 0)
        {
            return "El envío ya fue integrado en la base principal.";
        }

        if (string.Equals(SelectedWorkflow?.Status, "Returned", StringComparison.OrdinalIgnoreCase))
        {
            return "El envío fue devuelto y espera ajustes del autor.";
        }

        if (string.Equals(SelectedWorkflow?.Status, "Approved", StringComparison.OrdinalIgnoreCase))
        {
            return SelectedInboxItem?.CanProcessBatch == true
                ? "La validación final fue completada y el envío puede procesarse."
                : "La validación actual fue completada.";
        }

        return "El envío continúa dentro del circuito de revisión.";
    }

    private string GetNextStepLabel()
    {
        if (CanProcessSelectedWorkflow)
        {
            return "Procesar el envío aprobado.";
        }

        if (CanClaimSelectedWorkflow)
        {
            return "Tomar la etapa para iniciar la revisión.";
        }

        if (CanApproveSelectedWorkflow)
        {
            return "Revisar, corregir y aprobar la etapa actual.";
        }

        if (CanReturnSelectedWorkflow)
        {
            return "Devolver con observaciones si hace falta corregir.";
        }

        if (SelectedInboxItem?.ProcessedRows > 0)
        {
            return "El proceso ya terminó correctamente.";
        }

        return "Esperando el siguiente movimiento del workflow.";
    }

    private string GetReviewerActionLead()
    {
        if (CanProcessSelectedWorkflow)
        {
            return "La validación ya terminó. Solo falta procesar la información aprobada.";
        }

        if (CanClaimSelectedWorkflow)
        {
            return "Primero toma la etapa para dejarla a tu cargo y luego continúa con la revisión.";
        }

        if (CanApproveSelectedWorkflow || CanReturnSelectedWorkflow)
        {
            return "Registra aquí tu nota y continúa con la decisión que corresponda.";
        }

        return "Este envío no tiene una acción pendiente para tu rol en este momento.";
    }

    private static string GetFriendlyActionName(string? actionType)
    {
        var normalized = (actionType ?? string.Empty).Trim().ToLowerInvariant();
        return normalized switch
        {
            "submitted" => "Envío a revisión",
            "claimed" => "Toma de etapa",
            "returned" => "Devolución con observaciones",
            "approved" => "Aprobación de etapa",
            _ => string.IsNullOrWhiteSpace(actionType) ? "Movimiento" : actionType
        };
    }

    private static string BuildApproveSuccessMessage(WorkflowBatchDetailDto updated)
    {
        if (string.Equals(updated.Status, "Approved", StringComparison.OrdinalIgnoreCase))
        {
            return "La etapa fue aprobada correctamente y el envío ya quedó listo para procesamiento final.";
        }

        if (!string.IsNullOrWhiteSpace(updated.CurrentStageGroupName))
        {
            return $"La etapa fue aprobada correctamente y el envío pasó a {updated.CurrentStageGroupName}.";
        }

        return "La etapa fue aprobada correctamente y el workflow avanzó a la siguiente validación.";
    }

    private sealed record PendingWorkflowAction(string Kind);
}
