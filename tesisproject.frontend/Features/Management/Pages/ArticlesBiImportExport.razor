                                        }
                                        else
                                        {
                                            <input class="mt-3 w-full rounded-xl border border-[#c9d7db] bg-white px-3 py-2 text-sm" value="@GetCorrectionValue(field.FieldId)" @oninput="async (args) => await HandleCorrectionValueChangedAsync(field, args.Value?.ToString())" placeholder="@field.HeaderKey" />
                                        }
                                        @if (GetCatalogSuggestions(field.FieldId).Any())
                                        {
                                            <div class="mt-2 text-xs text-[#2f4858]">Sugerencias: @string.Join(" | ", GetCatalogSuggestions(field.FieldId).Take(6).Select(x => x.Name))</div>
                                        }
                                        @if (TryGetExistingCell(field.FieldId) is { } existingCell)
                                        {
                                            <div class="mt-2 grid grid-cols-1 gap-2 text-xs md:grid-cols-2">
                                                <div class="rounded-xl bg-[#f4f8f9] px-3 py-2 text-slate-600">Raw actual: <span class="font-semibold text-slate-800">@existingCell.RawValue</span></div>
                                                <div class="rounded-xl bg-[#fff4e4] px-3 py-2 text-slate-600">Normalizado actual: <span class="font-semibold text-slate-800">@existingCell.NormalizedValue</span></div>
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(existingCell.ValidationMessage))
                                            {
                                                <div class="mt-2 text-xs text-rose-700">@existingCell.ValidationMessage</div>
                                            }
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
            <div class="rounded-[1.6rem] border border-[#ead8bd] bg-[#fffdf8] p-6 shadow-sm">
                <div>
                    <h4 class="text-base font-black text-[#8b5a16]">Errores y acciones</h4>
                    <div class="mt-4 rounded-3xl border border-[#ead8bd] bg-white px-4 py-4 text-sm text-slate-700">
                        <div class="font-semibold text-[#8b5a16]">Sugerencia</div>
                        <div class="mt-2">Corrige primero los campos marcados con error. Al guardar, el sistema vuelve a normalizar referencias, recalcula el staging y refresca el lote.</div>
                    </div>
                    @if (!SelectedPreviewRow.Errors.Any())
