    private void RequestUpload()
    {
        if (SelectedFile is null)
        {
            ShowFeedback("warning", "Archivo requerido", "Archivo requerido", "Primero selecciona un archivo para crear el lote.");
            return;
        }

        PendingAction = PendingBulkAction.Upload;
        PendingActionTitle = "Crear lote en staging";
        PendingActionMessage = $"Voy a subir '{SelectedFile.Name}' al staging para crear un nuevo lote de revisión.";
        PendingActionConfirmText = "Crear lote";
    }

    private async Task UploadAsync()
    {
        if (SelectedFile is null)
        {
            ShowFeedback("warning", "Archivo requerido", "Archivo requerido", "Primero selecciona un archivo para crear el lote.");
            return;
        }

        try
        {
            ClearMessages();
            IsUploading = true;
            CurrentBatch = await BulkImportClient.UploadAsync(SelectedFile, SelectedSourceType, UploadNotes);
            SelectedFile = null;
            UploadNotes = string.Empty;
            ResetPreviewFilters();
            SelectedPreviewRow = null;
            await LoadRecentBatchesAsync();
            if (CurrentBatch is not null)
            {
                ShowFeedback("success", "Staging creado", "Lote listo para revisión", $"El archivo se cargó al staging. Lote {CurrentBatch.Summary.BatchCode} con {CurrentBatch.Summary.TotalRows} fila(s) detectadas. Revisa la tabla, valida y procesa solo cuando el lote esté limpio.");
            }
        }
        catch (Exception ex)
        {
            ShowFeedback("error", "No pude subir el archivo", "Error al subir a staging", $"No pude subir el archivo al staging: {ex.Message}");
        }
        finally
        {
            IsUploading = false;
        }
    }

