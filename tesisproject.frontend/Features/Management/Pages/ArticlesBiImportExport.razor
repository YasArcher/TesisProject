    {
        IsCorrectionMode = false;
        RowModalErrorMessage = null;
        RowModalSuccessMessage = null;
        InitializeCorrectionValues();
    }

    private void InitializeCorrectionValues()
    {
        CorrectionValues = SelectedRowEditableFields.ToDictionary(
            field => field.FieldId,
            field => TryGetExistingCell(field.FieldId)?.RawValue,
            EqualityComparer<int>.Default);
    }

    private BulkImportRowCellDto? TryGetExistingCell(int fieldId)
        => SelectedPreviewRow?.Cells.FirstOrDefault(x => x.FieldId == fieldId);

    private List<CatalogItemDto> GetCatalogSuggestions(int fieldId)
        => CorrectionCatalogSuggestions.TryGetValue(fieldId, out var items) ? items : new List<CatalogItemDto>();

    private List<DynamicFieldOptionDto> GetDynamicOptions(int fieldId)
        => CorrectionDynamicOptions.TryGetValue(fieldId, out var items) ? items : new List<DynamicFieldOptionDto>();

    private BulkImportTemplateFieldDto? FindEditableFieldById(int fieldId)
    {
        var field = ArticleFields.Concat(ParticipantFields).FirstOrDefault(x => x.FieldId == fieldId);
        return field is null ? null : MapFieldCatalogToEditableField(field);
    }

    private static BulkImportTemplateFieldDto MapCellToEditableField(BulkImportRowCellDto cell)
        => new()
        {
            FieldId = cell.FieldId,
            EntityName = cell.EntityName,
            FieldKey = cell.FieldKey,
            FieldLabel = cell.FieldLabel,
            DataType = cell.ValueType ?? "string",
            HeaderKey = $"{cell.EntityName}.{cell.FieldKey}"
        };

    private static BulkImportTemplateFieldDto MapFieldCatalogToEditableField(FieldCatalogItemDto field)
        => new()
        {
            FieldId = field.FieldId,
            EntityName = field.EntityName,
            FieldKey = field.FieldKey,
            FieldLabel = field.FieldLabel,
            DataType = field.DataType,
            SourceType = field.SourceType,
            HeaderKey = $"{field.EntityName}.{field.FieldKey}|{field.FieldLabel}",
            IsRequired = field.IsRequired,
            IsDynamic = field.IsDynamic,
            HelpText = field.HelpText,
            Placeholder = field.Placeholder
        };

    private bool IsFieldInError(int fieldId)
        => SelectedPreviewRow?.Errors.Any(x => x.FieldId == fieldId) == true
            || TryGetExistingCell(fieldId)?.IsValid == false;

    private string? GetCorrectionValue(int fieldId)
        => CorrectionValues.TryGetValue(fieldId, out var value) ? value : null;

    private void SetCorrectionValue(int fieldId, string? value)
        => CorrectionValues[fieldId] = value;

    private async Task HandleCorrectionValueChangedAsync(BulkImportTemplateFieldDto field, string? value)
    {
        SetCorrectionValue(field.FieldId, value);

        if (field.FieldKey == "BroadFieldId")
        {
            var specificField = SelectedRowEditableFields.FirstOrDefault(x => x.FieldKey == "SpecificFieldId");
            var detailedField = SelectedRowEditableFields.FirstOrDefault(x => x.FieldKey == "DetailedFieldId");

            if (specificField is not null)
            {
                CorrectionValues[specificField.FieldId] = null;
                await LoadCatalogSuggestionsForFieldAsync(specificField);
            }

            if (detailedField is not null)
            {
                CorrectionValues[detailedField.FieldId] = null;
                await LoadCatalogSuggestionsForFieldAsync(detailedField);
            }
        }
        else if (field.FieldKey == "SpecificFieldId")
        {
            var detailedField = SelectedRowEditableFields.FirstOrDefault(x => x.FieldKey == "DetailedFieldId");
            if (detailedField is not null)
            {
                CorrectionValues[detailedField.FieldId] = null;
                await LoadCatalogSuggestionsForFieldAsync(detailedField);
            }
        }
    }

    private async Task LoadCorrectionMetadataAsync()
    {
        IsLoadingCorrectionMetadata = true;
        CorrectionCatalogSuggestions.Clear();
        CorrectionDynamicOptions.Clear();

        try
        {
            foreach (var field in SelectedRowEditableFields)
            {
                if (field.IsDynamic)
                {
                    var options = await FormConfigurationClient.GetFieldOptionsAsync(field.FieldId);
                    if (options.Any())
                    {
                        CorrectionDynamicOptions[field.FieldId] = options.Where(x => x.IsActive).OrderBy(x => x.DisplayOrder).ToList();
                    }
                }

                if (IsCatalogLikeField(field))
                {
                    await LoadCatalogSuggestionsForFieldAsync(field);
                }
            }
        }
        catch
        {
            // La corrección puede seguir funcionando aunque no logremos cargar sugerencias.
        }
        finally
        {
            IsLoadingCorrectionMetadata = false;
        }
    }

    private async Task LoadCatalogSuggestionsForFieldAsync(BulkImportTemplateFieldDto field)
    {
        var parentId = GetParentCatalogId(field);
        var items = await FormConfigurationClient.GetCatalogItemsByFieldAsync(field.FieldId, parentId);
        if (items.Any())
        {
            CorrectionCatalogSuggestions[field.FieldId] = items.OrderBy(x => x.Name).ToList();
        }
        else
        {
            CorrectionCatalogSuggestions.Remove(field.FieldId);
        }
    }

    private async Task SaveRowCorrectionsAsync()
    {
        if (CurrentBatch is null || SelectedPreviewRow is null)
        {
            return;
        }

        try
        {
            IsSavingCorrections = true;
            RowModalErrorMessage = null;
            RowModalSuccessMessage = null;

            var request = new BulkImportRowCorrectionRequest
            {
                RevalidateBatch = true,
                Cells = SelectedRowEditableFields
                    .Select(field => new BulkImportRowCorrectionCellDto
                    {
                        FieldId = field.FieldId,
                        RawValue = GetCorrectionValue(field.FieldId)
                    })
                    .ToList()
            };

            var result = await BulkImportClient.CorrectRowAsync(CurrentBatch.Summary.ImportBatchId, SelectedPreviewRow.ImportBatchRowId, request);
            if (result is null)
            {
                RowModalErrorMessage = "No recibí respuesta al guardar la corrección.";
                return;
            }

            CurrentBatch = result.Batch;
            await LoadRecentBatchesAsync();

            var refreshedRow = CurrentBatch.Rows.FirstOrDefault(x => x.ImportBatchRowId == SelectedPreviewRow.ImportBatchRowId);
            SelectedPreviewRow = refreshedRow;
            IsCorrectionMode = refreshedRow is not null && refreshedRow.Errors.Any();
            RowModalSuccessMessage = result.Message;
            ShowFeedback("success", "Corrección aplicada", "Corrección aplicada", result.Message);
            if (refreshedRow is null)
            {
                CloseRowModal();
            }
            else
            {
                InitializeCorrectionValues();
                if (IsCorrectionMode)
                {
                    await LoadCorrectionMetadataAsync();
                }
            }
        }
        catch (Exception ex)
        {
            RowModalErrorMessage = ex.Message;
        }
        finally
        {
            IsSavingCorrections = false;
        }
    }

    private bool IsCatalogLikeField(BulkImportTemplateFieldDto field)
        => !string.IsNullOrWhiteSpace(field.ReferenceTableName)
            || field.FieldKey is "AcademicTermId" or "PublicationStatusId" or "ResearchLineId" or "BroadFieldId" or "SpecificFieldId" or "DetailedFieldId";

    private int? GetParentCatalogId(BulkImportTemplateFieldDto field)
    {
        return field.FieldKey switch
        {
            "SpecificFieldId" => TryResolveFieldIntValue("BroadFieldId"),
            "DetailedFieldId" => TryResolveFieldIntValue("SpecificFieldId"),
            _ => null
        };
    }

    private int? TryResolveFieldIntValue(string fieldKey)
    {
        var editableField = SelectedRowEditableFields.FirstOrDefault(x => x.FieldKey == fieldKey);
        if (editableField is null)
        {
            return null;
        }

        var rawCandidate = GetCorrectionValue(editableField.FieldId);
        if (int.TryParse(rawCandidate, out var parsedFromRaw))
        {
            return parsedFromRaw;
        }

        var existingCell = TryGetExistingCell(editableField.FieldId);
        return int.TryParse(existingCell?.NormalizedValue, out var parsedNormalized) ? parsedNormalized : null;
    }

    private static bool IsBooleanField(BulkImportTemplateFieldDto field)
        => (field.DataType ?? string.Empty).Contains("bool", StringComparison.OrdinalIgnoreCase)
            || (field.DataType ?? string.Empty).Contains("bit", StringComparison.OrdinalIgnoreCase);

    private static bool IsDateField(BulkImportTemplateFieldDto field)
        => (field.DataType ?? string.Empty).Contains("date", StringComparison.OrdinalIgnoreCase)
            || (field.DataType ?? string.Empty).Contains("time", StringComparison.OrdinalIgnoreCase);

    private static bool IsNumericField(BulkImportTemplateFieldDto field)
    {
        var type = field.DataType ?? string.Empty;
        return type.Contains("int", StringComparison.OrdinalIgnoreCase)
            || type.Contains("short", StringComparison.OrdinalIgnoreCase)
            || type.Contains("decimal", StringComparison.OrdinalIgnoreCase)
            || type.Contains("numeric", StringComparison.OrdinalIgnoreCase)
            || type.Contains("double", StringComparison.OrdinalIgnoreCase)
            || type.Contains("float", StringComparison.OrdinalIgnoreCase);
    }

    private static string GetInputStep(BulkImportTemplateFieldDto field)
    {
        var type = field.DataType ?? string.Empty;
        return type.Contains("decimal", StringComparison.OrdinalIgnoreCase)
            || type.Contains("numeric", StringComparison.OrdinalIgnoreCase)
            || type.Contains("double", StringComparison.OrdinalIgnoreCase)
            || type.Contains("float", StringComparison.OrdinalIgnoreCase)
            ? "0.01"
            : "1";
    }

    private static BulkImportRowCellDto? FindCell(BulkImportRowPreviewDto row, string headerKey)
        => row.Cells.FirstOrDefault(x => $"{x.EntityName}.{x.FieldKey}".Equals(headerKey, StringComparison.OrdinalIgnoreCase));

    private static string GetDisplayValue(BulkImportRowCellDto cell)
        => string.IsNullOrWhiteSpace(cell.RawValue) ? (cell.NormalizedValue ?? string.Empty) : cell.RawValue ?? string.Empty;

    private static string GetNormalizedDisplayValue(BulkImportRowCellDto cell)
        => string.IsNullOrWhiteSpace(cell.NormalizedValue) ? (cell.RawValue ?? string.Empty) : cell.NormalizedValue ?? string.Empty;

    private static string GetRowStatusBadgeClass(string status)
    {
        return status.ToLowerInvariant() switch
        {
            "processed" => "rounded-full bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-700",
            "valid" => "rounded-full bg-sky-50 px-3 py-1 text-xs font-semibold text-sky-700",
            "validated" => "rounded-full bg-sky-50 px-3 py-1 text-xs font-semibold text-sky-700",
            "error" => "rounded-full bg-rose-50 px-3 py-1 text-xs font-semibold text-rose-700",
            _ => "rounded-full bg-amber-50 px-3 py-1 text-xs font-semibold text-amber-700"
        };
    }

    private bool MatchesPreviewFilter(BulkImportRowPreviewDto row)
    {
        if (PreviewErrorsOnly && !row.Errors.Any())
        {
            return false;
        }

        if (!string.Equals(PreviewStatusFilter, "all", StringComparison.OrdinalIgnoreCase)
            && !string.Equals(row.RowStatus, PreviewStatusFilter, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        if (string.IsNullOrWhiteSpace(PreviewSearchTerm))
        {
            return true;
        }

        var term = PreviewSearchTerm.Trim();

        if (row.RowNumber.ToString().Contains(term, StringComparison.OrdinalIgnoreCase)
            || row.RowStatus.Contains(term, StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        return row.Cells.Any(cell =>
                   cell.FieldKey.Contains(term, StringComparison.OrdinalIgnoreCase)
                   || cell.FieldLabel.Contains(term, StringComparison.OrdinalIgnoreCase)
                   || (cell.RawValue?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                   || (cell.NormalizedValue?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false))
               || row.Errors.Any(error =>
                   error.ErrorCode.Contains(term, StringComparison.OrdinalIgnoreCase)
                   || error.ErrorMessage.Contains(term, StringComparison.OrdinalIgnoreCase));
    }

    private static string GetPreviewCellClass(BulkImportRowCellDto? cell)
    {
        if (cell is null)
        {
            return "max-w-[16rem] px-4 py-3 text-slate-700";
        }

        return cell.IsValid
            ? "max-w-[16rem] bg-white px-4 py-3 text-slate-700"
            : "max-w-[16rem] bg-rose-50/80 px-4 py-3 text-rose-700";
    }

    private bool MatchesErrorFilter(BulkImportErrorDto error)
    {
        if (OnlyRowErrors && !error.ImportBatchRowId.HasValue)
        {
            return false;
        }

        if (!string.Equals(ErrorSeverityFilter, "all", StringComparison.OrdinalIgnoreCase)
            && !string.Equals(error.Severity, ErrorSeverityFilter, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        if (string.IsNullOrWhiteSpace(ErrorSearchTerm))
        {
            return true;
        }

        var term = ErrorSearchTerm.Trim();
        return error.ErrorCode.Contains(term, StringComparison.OrdinalIgnoreCase)
            || error.ErrorMessage.Contains(term, StringComparison.OrdinalIgnoreCase)
            || (error.FieldKey?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
            || (error.FieldLabel?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
            || (error.ImportBatchRowId?.ToString().Contains(term, StringComparison.OrdinalIgnoreCase) ?? false);
    }

    private bool MatchesCorrectionQueueFilter(BulkImportRowPreviewDto row)
    {
        if (string.IsNullOrWhiteSpace(CorrectionQueueSearchTerm))
        {
            return true;
        }

        var term = CorrectionQueueSearchTerm.Trim();
        if (row.RowNumber.ToString().Contains(term, StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        return row.Errors.Any(error =>
                   error.ErrorCode.Contains(term, StringComparison.OrdinalIgnoreCase)
                   || error.ErrorMessage.Contains(term, StringComparison.OrdinalIgnoreCase)
                   || (error.FieldKey?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                   || (error.FieldLabel?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false))
               || row.Cells.Any(cell =>
                   cell.FieldKey.Contains(term, StringComparison.OrdinalIgnoreCase)
                   || cell.FieldLabel.Contains(term, StringComparison.OrdinalIgnoreCase)
                   || (cell.RawValue?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                   || (cell.NormalizedValue?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false));
    }

    private string GetRowCorrectionSummary(BulkImportRowPreviewDto row)
    {
        if (!row.Errors.Any())
        {
            return "Fila lista para continuar.";
        }

        var distinctFields = row.Errors
            .Select(error => string.IsNullOrWhiteSpace(error.FieldLabel) ? error.ErrorCode : error.FieldLabel)
            .Distinct()
            .Take(3)
            .ToList();

        return $"Revisar {string.Join(", ", distinctFields)}.";
    }

    private List<string> GetRowErrorBadges(BulkImportRowPreviewDto row)
        => row.Errors
            .Select(error => !string.IsNullOrWhiteSpace(error.FieldLabel) ? error.FieldLabel! : error.ErrorCode)
            .Distinct()
            .Take(4)
            .ToList();

    private string GetBatchReviewHint()
    {
        if (CurrentBatch is null)
        {
            return "Sin lote";
        }

        if (CurrentBatch.Summary.ErrorRows > 0)
        {
            return "Revisar errores";
        }

        if (CurrentBatch.Summary.ValidRows > 0 && CurrentBatch.Summary.ProcessedRows == 0)
        {
            return "Listo para procesar";
        }

        if (CurrentBatch.Summary.ProcessedRows > 0)
        {
            return "Procesado";
        }

        return "Pendiente de validación";
    }

    private void ShowFeedback(string variant, string eyebrow, string title, string? message)
    {
        MessageTitle = title;
        ErrorMessage = variant == "error" ? message : null;
        SuccessMessage = variant == "success" ? message : null;
        WarningMessage = variant == "warning" ? message : null;
        FeedbackVariant = variant;
        FeedbackEyebrow = eyebrow;
        FeedbackTitle = title;
        FeedbackMessage = message;
        ShowFeedbackModal = true;
    }

    private Task CloseFeedbackModal()
    {
        ShowFeedbackModal = false;
        return Task.CompletedTask;
    }

    private void CancelPendingAction()
    {
        PendingAction = PendingBulkAction.None;
        PendingActionTitle = string.Empty;
        PendingActionMessage = string.Empty;
        PendingActionConfirmText = "Confirmar";
    }

    private async Task ConfirmPendingActionAsync()
    {
        var action = PendingAction;
        CancelPendingAction();

        switch (action)
        {
            case PendingBulkAction.Upload:
                await UploadAsync();
                break;
            case PendingBulkAction.Validate:
                await ValidateCurrentBatchAsync();
                break;
            case PendingBulkAction.Process:
                await ProcessCurrentBatchAsync();
                break;
        }
    }

    private string GetCurrentStageLabel()
    {
        if (CurrentBatch is null)
        {
            return "Sin lote";
        }

        if (CurrentBatch.Summary.ProcessedRows > 0)
        {
            return "Procesado";
        }

        if (CurrentBatch.Summary.Status.Equals("Validated", StringComparison.OrdinalIgnoreCase)
            || CurrentBatch.Summary.ValidRows > 0
            || CurrentBatch.Summary.ErrorRows > 0)
        {
            return "Validado";
        }

        return "Cargado";
    }

    private string GetStageStatusText(string stageKey)
    {
        return stageKey switch
        {
            "uploaded" => CurrentBatch is null ? "Pendiente" : "Listo",
            "validated" => CurrentBatch is null ? "Pendiente" : (CurrentBatch.Summary.ValidRows > 0 || CurrentBatch.Summary.ErrorRows > 0 || CurrentBatch.Summary.Status.Equals("Validated", StringComparison.OrdinalIgnoreCase) ? "Listo" : "Pendiente"),
            "processed" => CurrentBatch is not null && CurrentBatch.Summary.ProcessedRows > 0 ? "Listo" : "Pendiente",
            _ => "Pendiente"
        };
    }

    private string GetStageCardClass(string stageKey)
    {
        var isReady = GetStageStatusText(stageKey) == "Listo";
        return isReady
            ? "border-emerald-200 bg-emerald-50 text-emerald-900"
            : "border-[#d9e5e8] bg-white text-slate-700";
    }

    private string GetStageBadgeClass(string stageKey)
    {
        var isReady = GetStageStatusText(stageKey) == "Listo";
        return isReady
            ? "bg-emerald-100 text-emerald-700"
            : "bg-slate-100 text-slate-600";
    }

    private static string GetTemplateFieldInterpretation(BulkImportTemplateFieldDto field)
    {
        return field.FieldKey switch
        {
            "AcademicTermId" => "Acepta ID o nombre del periodo; se convierte al ID real.",
            "PublicationStatusId" => "Acepta ID o nombre del estado; se convierte al ID real.",
            "ResearchLineId" => "Acepta ID o nombre de la línea; se convierte al ID real.",
            "BroadFieldId" => "Acepta ID o nombre del campo amplio; se convierte al ID real.",
            "SpecificFieldId" => "Acepta ID, nombre o código; se convierte al ID real.",
            "DetailedFieldId" => "Acepta ID, nombre o código; se convierte al ID real.",
            "JournalName" => "Se usa para resolver o crear el venue del artículo.",
            "IssnCode" => "Refuerza la coincidencia del venue o ayuda a crearlo.",
            "Sjr" => "Se guarda como métrica decimal del venue.",
            "Quartile" => "Se guarda como métrica del venue, por ejemplo Q1.",
            _ when field.IsDynamic => "El sistema toma el valor y lo guarda como campo dinámico configurado.",
            _ when field.IsRequired => "Debe venir informado para que la fila pueda quedar válida.",
            _ => "Se interpreta según el tipo de dato configurado en FieldCatalog."
        };
    }

    private void ResetPreviewFilters()
    {
        PreviewSearchTerm = string.Empty;
        PreviewStatusFilter = "all";
        PreviewErrorsOnly = false;
        ShowNormalizedValues = false;
        ErrorSearchTerm = string.Empty;
        ErrorSeverityFilter = "all";
        OnlyRowErrors = false;
    }

    private void ClearMessages()
    {
        ErrorMessage = null;
        SuccessMessage = null;
        WarningMessage = null;
        MessageTitle = null;
    }

    private enum PendingBulkAction
    {
        None,
        Upload,
        Validate,
        Process
    }
}

