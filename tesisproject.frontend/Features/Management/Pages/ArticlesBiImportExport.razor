    private List<BatchErrorRowGroup> GroupedBatchErrors => FilteredBatchErrors
        .GroupBy(error => error.ImportBatchRowId)
        .Select(group =>
        {
            var row = group.Key.HasValue
                ? CurrentBatch?.Rows.FirstOrDefault(item => item.ImportBatchRowId == group.Key.Value)
                : null;

            return new BatchErrorRowGroup
            {
                ImportBatchRowId = group.Key,
                RowNumber = row?.RowNumber,
                ErrorCount = group.Count(item => item.Severity.Equals("Error", StringComparison.OrdinalIgnoreCase)),
                WarningCount = group.Count(item => item.Severity.Equals("Warning", StringComparison.OrdinalIgnoreCase)),
                Summary = string.Join(" | ", group.Select(item => item.ErrorCode).Distinct().Take(3)),
                Fields = string.Join(" | ", group
