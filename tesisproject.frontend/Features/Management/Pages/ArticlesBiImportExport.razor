    private HashSet<int> SelectedParticipantFieldIds = new();
    private List<BulkImportBatchSummaryDto> RecentBatches = new();
    private BulkImportBatchDetailDto? CurrentBatch;
    private BulkImportRowPreviewDto? SelectedPreviewRow;
    private ResolvedFormDto? ArticleForm;
    private ResolvedFormDto? ParticipantForm;
    private IBrowserFile? SelectedFile;
    private string SelectedSourceType = "Excel";
    private string UploadNotes = string.Empty;
    private string ArticleFieldSearchTerm = string.Empty;
    private string ParticipantFieldSearchTerm = string.Empty;
    private string PreviewSearchTerm = string.Empty;
    private string PreviewStatusFilter = "all";
    private string ErrorSearchTerm = string.Empty;
    private string ErrorSeverityFilter = "all";
    private string CorrectionQueueSearchTerm = string.Empty;
    private string CorrectionQueueSort = "row";
    private string? RowModalErrorMessage;
    private string? RowModalSuccessMessage;
    private bool PreviewErrorsOnly;
    private bool ShowNormalizedValues;
    private bool OnlyRowErrors;
    private bool IsLoadingCorrectionMetadata;
    private bool IsCorrectionMode;
    private bool IsSavingCorrections;
    private bool IsLoading = true;
    private bool IsGeneratingTemplate;
    private bool IsUploading;
    private bool IsValidatingBatch;
    private bool IsProcessingBatch;
    private string? ErrorMessage;
    private string? SuccessMessage;
    private string? WarningMessage;
    private string? MessageTitle;
    private bool ShowFeedbackModal;
    private string FeedbackVariant = "info";
    private string FeedbackEyebrow = "Estado";
    private string FeedbackTitle = string.Empty;
    private string? FeedbackMessage;
    private PendingBulkAction PendingAction = PendingBulkAction.None;
    private string PendingActionTitle = string.Empty;
    private string PendingActionMessage = string.Empty;
    private string PendingActionConfirmText = "Confirmar";

    private bool HasPendingAction => PendingAction != PendingBulkAction.None;

    private IEnumerable<FieldCatalogItemDto> FilteredArticleFields => ArticleFields.Where(field => Matches(field, ArticleFieldSearchTerm));
    private IEnumerable<FieldCatalogItemDto> FilteredParticipantFields => ParticipantFields.Where(field => Matches(field, ParticipantFieldSearchTerm));
    private List<string> OrderedPreviewHeaders => CurrentBatch?.Template is not null
        ? CurrentBatch.Template.ArticleFields
            .Concat(CurrentBatch.Template.ParticipantFields)
            .Select(x => $"{x.EntityName}.{x.FieldKey}")
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList()
        : CurrentBatch?.Rows
            .SelectMany(x => x.Cells)
            .Select(x => $"{x.EntityName}.{x.FieldKey}")
