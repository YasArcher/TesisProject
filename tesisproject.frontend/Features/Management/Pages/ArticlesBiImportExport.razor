        if (CurrentBatch is null)
        {
            return "Sin lote";
        }

        if (CurrentBatch.Summary.ErrorRows > 0)
        {
            return "Revisar errores";
        }

        if (CurrentBatch.Summary.ValidRows > 0 && CurrentBatch.Summary.ProcessedRows == 0)
        {
            return "Listo para procesar";
        }

        if (CurrentBatch.Summary.ProcessedRows > 0)
        {
            return "Procesado";
        }

        return "Pendiente de validación";
