    private IEnumerable<int> GetRequiredContractFieldIds()
    {
        if (CurrentBatch is null || string.IsNullOrWhiteSpace(CurrentBatch.Summary.SourceReference))
        {
            return Enumerable.Empty<int>();
        }

        try
        {
            using var document = System.Text.Json.JsonDocument.Parse(CurrentBatch.Summary.SourceReference);
            var root = document.RootElement;
            var result = new List<int>();

            if (root.TryGetProperty("RequiredArticleFieldIds", out var articleIds) && articleIds.ValueKind == System.Text.Json.JsonValueKind.Array)
            {
                result.AddRange(articleIds.EnumerateArray().Where(x => x.TryGetInt32(out _)).Select(x => x.GetInt32()));
            }

            if (root.TryGetProperty("RequiredParticipantFieldIds", out var participantIds) && participantIds.ValueKind == System.Text.Json.JsonValueKind.Array)
            {
                result.AddRange(participantIds.EnumerateArray().Where(x => x.TryGetInt32(out _)).Select(x => x.GetInt32()));
            }

            return result.Distinct().ToList();
        }
        catch
        {
            return Enumerable.Empty<int>();
        }
    }

    private string ResolveFieldLabel(int fieldId)
    {
        var templateField = TemplateFieldPreviewItems.FirstOrDefault(x => x.FieldId == fieldId);
        if (templateField is not null)
        {
            return templateField.FieldLabel;
        }

        var field = ArticleFields.Concat(ParticipantFields).FirstOrDefault(x => x.FieldId == fieldId);
        return field?.FieldLabel ?? $"Campo #{fieldId}";
    }

    private string GetRequiredContractSummary()
    {
        var labels = RequiredContractFieldLabels;
        if (!labels.Any())
        {
            return string.Empty;
        }

        return $"{labels.Count} campo(s) mínimos para poder procesar este lote.";
    }

    private string GetMissingRequiredSummary()
    {
        if (CurrentBatch is null)
        {
            return string.Empty;
        }

        var missingFields = CurrentBatch.Errors
            .Where(IsRequiredFieldError)
            .Select(error => !string.IsNullOrWhiteSpace(error.FieldLabel) ? error.FieldLabel! : error.ErrorCode)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        if (!missingFields.Any())
        {
            return string.Empty;
        }

        var preview = string.Join(", ", missingFields.Take(3));
        return missingFields.Count > 3
            ? $"{missingFields.Count} campo(s) faltan por completar. Ej.: {preview}."
            : $"Completa: {preview}.";
    }

    private static bool IsRequiredFieldError(BulkImportErrorDto error)
        => string.Equals(error.ErrorCode, "REQUIRED_FIELD", StringComparison.OrdinalIgnoreCase)
            || string.Equals(error.ErrorCode, "CLIENT_REQUIRED_FIELD", StringComparison.OrdinalIgnoreCase);

