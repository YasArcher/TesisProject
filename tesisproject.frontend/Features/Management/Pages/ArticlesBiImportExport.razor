    private bool MatchesErrorFilter(BulkImportErrorDto error)
    {
        if (OnlyRowErrors && !error.ImportBatchRowId.HasValue)
        {
            return false;
        }

        if (!string.Equals(ErrorSeverityFilter, "all", StringComparison.OrdinalIgnoreCase)
            && !string.Equals(error.Severity, ErrorSeverityFilter, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        if (string.IsNullOrWhiteSpace(ErrorSearchTerm))
        {
            return true;
        }

        var term = ErrorSearchTerm.Trim();
        return error.ErrorCode.Contains(term, StringComparison.OrdinalIgnoreCase)
            || error.ErrorMessage.Contains(term, StringComparison.OrdinalIgnoreCase)
            || (error.FieldKey?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
            || (error.FieldLabel?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
            || (error.ImportBatchRowId?.ToString().Contains(term, StringComparison.OrdinalIgnoreCase) ?? false);
    }

    private bool MatchesCorrectionQueueFilter(BulkImportRowPreviewDto row)
    {
        if (!string.Equals(CorrectionQueueFocus, "all", StringComparison.OrdinalIgnoreCase)
            && !row.Errors.Any(error =>
                string.Equals(error.FieldLabel, CorrectionQueueFocus, StringComparison.OrdinalIgnoreCase)
                || string.Equals(error.ErrorCode, CorrectionQueueFocus, StringComparison.OrdinalIgnoreCase)))
        {
            return false;
        }

        if (string.IsNullOrWhiteSpace(CorrectionQueueSearchTerm))
        {
            return true;
        }

        var term = CorrectionQueueSearchTerm.Trim();
        if (row.RowNumber.ToString().Contains(term, StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        return row.Errors.Any(error =>
                   error.ErrorCode.Contains(term, StringComparison.OrdinalIgnoreCase)
                   || error.ErrorMessage.Contains(term, StringComparison.OrdinalIgnoreCase)
                   || (error.FieldKey?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                   || (error.FieldLabel?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false))
               || row.Cells.Any(cell =>
                   cell.FieldKey.Contains(term, StringComparison.OrdinalIgnoreCase)
                   || cell.FieldLabel.Contains(term, StringComparison.OrdinalIgnoreCase)
                   || (cell.RawValue?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                   || (cell.NormalizedValue?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false));
    }

