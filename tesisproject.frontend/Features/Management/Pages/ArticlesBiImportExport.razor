    private BulkImportRowPreviewDto? GetPreviousErrorRow()
    {
        if (SelectedPreviewRow is null)
        {
            return null;
        }

        var index = ErrorRows.FindIndex(row => row.ImportBatchRowId == SelectedPreviewRow.ImportBatchRowId);
        return index > 0 ? ErrorRows[index - 1] : null;
    }

    private BulkImportRowPreviewDto? GetNextErrorRow()
    {
        if (SelectedPreviewRow is null)
        {
            return null;
        }

        var index = ErrorRows.FindIndex(row => row.ImportBatchRowId == SelectedPreviewRow.ImportBatchRowId);
        return index >= 0 && index + 1 < ErrorRows.Count ? ErrorRows[index + 1] : null;
    }

