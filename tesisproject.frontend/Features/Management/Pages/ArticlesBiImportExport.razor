        NormalizeErrorPagination();
        return Task.CompletedTask;
    }

    private Task HandleErrorPageSizeChanged(ChangeEventArgs args)
    {
        ErrorPageSize = ParsePositiveInt(args.Value?.ToString(), ErrorPageSize);
        ErrorCurrentPage = 1;
        NormalizeErrorPagination();
        return Task.CompletedTask;
    }

    private Task HandleErrorPageSizeSliderChanged(ChangeEventArgs args)
    {
        ErrorPageSize = ParsePositiveInt(args.Value?.ToString(), ErrorPageSize);
        ErrorCurrentPage = 1;
        NormalizeErrorPagination();
        return Task.CompletedTask;
    }

    private void GoToPreviousErrorPage()
    {
        if (ErrorCurrentPage > 1)
        {
            ErrorCurrentPage--;
        }
    }

    private void GoToNextErrorPage()
    {
        if (ErrorCurrentPage < ErrorTotalPages)
        {
            ErrorCurrentPage++;
        }
    }

    private void ClearCorrectionQueueFocus()
    {
        CorrectionQueueFocus = "all";
    }

    private string GetRowCorrectionSummary(BulkImportRowPreviewDto row)
    {
        if (!row.Errors.Any())
        {
            return "Fila lista para continuar.";
        }

        var distinctFields = row.Errors
            .Select(error => string.IsNullOrWhiteSpace(error.FieldLabel) ? error.ErrorCode : error.FieldLabel)
            .Distinct()
            .Take(3)
            .ToList();

        return $"Revisar {string.Join(", ", distinctFields)}.";
    }

    private List<string> GetRowErrorBadges(BulkImportRowPreviewDto row)
        => row.Errors
            .Select(error => !string.IsNullOrWhiteSpace(error.FieldLabel) ? error.FieldLabel! : error.ErrorCode)
            .Distinct()
            .Take(4)
            .ToList();

    private IReadOnlyList<string> GetRowErrorBadgesForQueue(BulkImportRowPreviewDto row)
        => GetRowErrorBadges(row);

    private int? GetCurrentErrorRowPosition()
    {
        if (SelectedPreviewRow is null)
        {
            return null;
        }

        var index = ErrorRows.FindIndex(row => row.ImportBatchRowId == SelectedPreviewRow.ImportBatchRowId);
        return index >= 0 ? index + 1 : null;
    }

    private async Task OpenErrorRowAsync(BulkImportErrorDto error)
    {
        if (CurrentBatch is null || !error.ImportBatchRowId.HasValue)
        {
            return;
        }

        var errorRow = TryFindRowByError(error);
        if (errorRow is null)
        {
            ExpandPreviewToWholeBatch(CurrentBatch.Summary.TotalRows);
            await OpenBatchAsync(CurrentBatch.Summary.ImportBatchId);
            errorRow = TryFindRowByError(error);
        }

        if (errorRow is not null)
        {
            ActiveBatchTab = "correction";
            await OpenCorrectionModalAsync(errorRow);
        }
        else
        {
            ShowFeedback("warning", "Fila no disponible", "No pude abrir la fila", "No encontré la fila asociada a ese error dentro del lote recargado.");
        }
    }

    private async Task OpenErrorRowByIdAsync(int rowId)
    {
        await OpenErrorRowAsync(new BulkImportErrorDto { ImportBatchRowId = rowId });
    }

    private BulkImportRowPreviewDto? TryFindRowByError(BulkImportErrorDto error)
        => !error.ImportBatchRowId.HasValue
            ? null
            : CurrentBatch?.Rows.FirstOrDefault(row => row.ImportBatchRowId == error.ImportBatchRowId.Value);

    private string GetBatchReviewHint()
