        var start = ((NormalizedErrorCurrentPage - 1) * ErrorPageSize) + 1;
        var end = Math.Min(start + ErrorPageSize - 1, GroupedBatchErrors.Count);
        return $"Mostrando grupos {start}-{end} de {GroupedBatchErrors.Count}.";
