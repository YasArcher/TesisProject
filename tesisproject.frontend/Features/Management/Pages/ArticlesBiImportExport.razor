    private void RequestValidateCurrentBatch()
    {
        if (CurrentBatch is null)
        {
            return;
        }

        PendingAction = PendingBulkAction.Validate;
        PendingActionTitle = $"Validar lote {CurrentBatch.Summary.BatchCode}";
        PendingActionMessage = "Voy a ejecutar la validación del staging para normalizar referencias y detectar errores fila por fila.";
        PendingActionConfirmText = "Validar lote";
    }

    private async Task ValidateCurrentBatchAsync()
    {
        if (CurrentBatch is null) return;
        try
        {
            ClearMessages();
            IsValidatingBatch = true;
            var batchId = CurrentBatch.Summary.ImportBatchId;
            var result = await BulkImportClient.ValidateBatchAsync(CurrentBatch.Summary.ImportBatchId);
            if (result is not null)
            {
                ExpandPreviewToWholeBatch(result.Batch.Summary.TotalRows);
                await OpenBatchAsync(batchId);
                SelectedPreviewRow = null;
                ShowFeedback("success", "Validación completada", "Lote validado", $"{result.Message} Filas válidas: {CurrentBatch.Summary.ValidRows}. Filas con error: {CurrentBatch.Summary.ErrorRows}. Usa los filtros del preview para enfocarte en lo pendiente.");
                ActiveBatchTab = CurrentBatch.Summary.ErrorRows > 0 ? "correction" : "preview";
                await LoadRecentBatchesAsync();
            }
        }
        catch (Exception ex)
        {
            ShowFeedback("error", "No pude validar el lote", "Error al validar", $"No pude validar el lote: {ex.Message}");
        }
        finally
        {
            IsValidatingBatch = false;
        }
    }

    private void RequestProcessCurrentBatch()
    {
        if (CurrentBatch is null)
        {
            return;
        }

        PendingAction = PendingBulkAction.Process;
        PendingActionTitle = $"Procesar lote {CurrentBatch.Summary.BatchCode}";
        PendingActionMessage = "Voy a persistir en el modelo híbrido todas las filas válidas del lote actual. Conviene hacerlo solo cuando los errores pendientes estén controlados.";
        PendingActionConfirmText = "Procesar lote";
    }

    private async Task ProcessCurrentBatchAsync()
    {
        if (CurrentBatch is null) return;
        try
        {
            ClearMessages();
            IsProcessingBatch = true;
            var batchId = CurrentBatch.Summary.ImportBatchId;
            var result = await BulkImportClient.ProcessBatchAsync(batchId);
            if (result is not null)
            {
                ExpandPreviewToWholeBatch(result.Batch.Summary.TotalRows);
                await OpenBatchAsync(batchId);
                SelectedPreviewRow = null;
                var processedRows = CurrentBatch.Summary.ProcessedRows;
                var processedBatchCode = CurrentBatch.Summary.BatchCode;
                ShowFeedback("success", "Procesamiento completado", "Lote procesado", $"{result.Message} Filas procesadas: {processedRows}. El staging conserva la trazabilidad para auditoría y revisión posterior. La pantalla se limpió para preparar una nueva carga después del lote {processedBatchCode}.");
                PrepareNextLoad();
                await LoadRecentBatchesAsync();
            }
        }
        catch (Exception ex)
        {
            ShowFeedback("error", "No pude procesar el lote", "Error al procesar", $"No pude procesar el lote: {ex.Message}");
        }
        finally
        {
            IsProcessingBatch = false;
        }
    }

    private static bool Matches(FieldCatalogItemDto field, string term)
    {
        if (string.IsNullOrWhiteSpace(term)) return true;
        var normalized = term.Trim();
        return field.FieldLabel.Contains(normalized, StringComparison.OrdinalIgnoreCase)
            || field.FieldKey.Contains(normalized, StringComparison.OrdinalIgnoreCase)
            || field.DataType.Contains(normalized, StringComparison.OrdinalIgnoreCase)
            || field.SourceType.Contains(normalized, StringComparison.OrdinalIgnoreCase);
    }

    private async Task DownloadTemplateFromBatchAsync()
    {
        if (CurrentBatch?.Template is null)
        {
            ShowFeedback("warning", "Sin plantilla", "Sin plantilla", "Este lote no tiene metadata suficiente para regenerar la plantilla.");
            return;
        }

        try
        {
            ClearMessages();
            IsGeneratingTemplate = true;
            var request = new BulkImportTemplateRequest
            {
                EntityName = CurrentBatch.Template.EntityName,
                SourceType = CurrentBatch.Summary.SourceType,
                UseActiveFormsWhenEmpty = false,
                ArticleFieldIds = CurrentBatch.Template.ArticleFields.Select(x => x.FieldId).ToList(),
                ParticipantFieldIds = CurrentBatch.Template.ParticipantFields.Select(x => x.FieldId).ToList(),
                TemplateName = $"plantilla_{CurrentBatch.Summary.BatchCode.ToLowerInvariant()}"
            };

            var file = await BulkImportClient.GenerateTemplateAsync(request);
            await ExportJs.DownloadFile(file.FileName, file.ContentType, file.Content);
            ShowFeedback("success", "Plantilla regenerada", "Plantilla regenerada", $"Se regeneró la plantilla del lote {CurrentBatch.Summary.BatchCode}.");
        }
        catch (Exception ex)
        {
            ShowFeedback("error", "No pude regenerar la plantilla", "Error al regenerar plantilla", $"No pude regenerar la plantilla del lote: {ex.Message}");
        }
        finally
        {
            IsGeneratingTemplate = false;
        }
    }

