        => CorrectionValues.TryGetValue(fieldId, out var value) ? value : null;

    private void SetCorrectionValue(int fieldId, string? value)
        => CorrectionValues[fieldId] = value;

    private async Task HandleCorrectionValueChangedAsync(BulkImportTemplateFieldDto field, string? value)
    {
        SetCorrectionValue(field.FieldId, value);

        if (field.FieldKey == "BroadFieldId")
        {
            var specificField = SelectedRowEditableFields.FirstOrDefault(x => x.FieldKey == "SpecificFieldId");
            var detailedField = SelectedRowEditableFields.FirstOrDefault(x => x.FieldKey == "DetailedFieldId");

            if (specificField is not null)
            {
                CorrectionValues[specificField.FieldId] = null;
                await LoadCatalogSuggestionsForFieldAsync(specificField);
            }

            if (detailedField is not null)
            {
                CorrectionValues[detailedField.FieldId] = null;
                await LoadCatalogSuggestionsForFieldAsync(detailedField);
            }
        }
        else if (field.FieldKey == "SpecificFieldId")
        {
            var detailedField = SelectedRowEditableFields.FirstOrDefault(x => x.FieldKey == "DetailedFieldId");
            if (detailedField is not null)
            {
                CorrectionValues[detailedField.FieldId] = null;
                await LoadCatalogSuggestionsForFieldAsync(detailedField);
            }
        }
    }

    private async Task LoadCorrectionMetadataAsync()
    {
        IsLoadingCorrectionMetadata = true;
        CorrectionCatalogSuggestions.Clear();
        CorrectionDynamicOptions.Clear();

        try
        {
            foreach (var field in SelectedRowEditableFields)
            {
                if (field.IsDynamic)
                {
                    var options = await FormConfigurationClient.GetFieldOptionsAsync(field.FieldId);
                    if (options.Any())
                    {
                        CorrectionDynamicOptions[field.FieldId] = options.Where(x => x.IsActive).OrderBy(x => x.DisplayOrder).ToList();
                    }
                }

                if (IsCatalogLikeField(field))
                {
                    await LoadCatalogSuggestionsForFieldAsync(field);
                }
            }
        }
        catch
        {
            // La corrección puede seguir funcionando aunque no logremos cargar sugerencias.
        }
        finally
        {
            IsLoadingCorrectionMetadata = false;
        }
    }

    private async Task LoadCatalogSuggestionsForFieldAsync(BulkImportTemplateFieldDto field)
    {
        var parentId = GetParentCatalogId(field);
        var items = await FormConfigurationClient.GetCatalogItemsByFieldAsync(field.FieldId, parentId);
        if (items.Any())
        {
            CorrectionCatalogSuggestions[field.FieldId] = items.OrderBy(x => x.Name).ToList();
        }
        else
        {
            CorrectionCatalogSuggestions.Remove(field.FieldId);
        }
    }

    private async Task SaveRowCorrectionsAsync()
        => await SaveRowCorrectionsAsync(false);

    private async Task SaveAndOpenNextErrorAsync()
        => await SaveRowCorrectionsAsync(true);

    private async Task SaveRowCorrectionsAsync(bool openNextError)
    {
        if (CurrentBatch is null || SelectedPreviewRow is null)
        {
            return;
        }

        try
        {
            IsSavingCorrections = true;
            RowModalErrorMessage = null;
            RowModalSuccessMessage = null;

            var request = new BulkImportRowCorrectionRequest
            {
                RevalidateBatch = true,
                Cells = SelectedRowEditableFields
                    .Select(field => new BulkImportRowCorrectionCellDto
                    {
                        FieldId = field.FieldId,
                        RawValue = GetCorrectionValue(field.FieldId)
                    })
                    .ToList()
            };

            var result = await BulkImportClient.CorrectRowAsync(CurrentBatch.Summary.ImportBatchId, SelectedPreviewRow.ImportBatchRowId, request);
            if (result is null)
            {
                RowModalErrorMessage = "No recibí respuesta al guardar la corrección.";
                return;
            }

            var batchId = CurrentBatch.Summary.ImportBatchId;
            var selectedRowId = SelectedPreviewRow.ImportBatchRowId;
            var previousNextErrorRow = openNextError ? GetNextErrorRow() : null;
            ExpandPreviewToWholeBatch(result.Batch.Summary.TotalRows);
            await OpenBatchAsync(batchId);
            await LoadRecentBatchesAsync();

            var refreshedRow = CurrentBatch?.Rows.FirstOrDefault(x => x.ImportBatchRowId == selectedRowId);
            SelectedPreviewRow = refreshedRow;
            IsCorrectionMode = refreshedRow is not null && refreshedRow.Errors.Any();
            RowModalSuccessMessage = result.Message;
            ShowFeedback("success", "Corrección aplicada", "Corrección aplicada", result.Message);
            if (refreshedRow is null)
            {
                CloseRowModal();
            }
            else
            {
                ActiveBatchTab = refreshedRow.Errors.Any() ? "correction" : "preview";
                InitializeCorrectionValues();
                if (IsCorrectionMode)
                {
                    await LoadCorrectionMetadataAsync();
                }
            }

            if (openNextError && previousNextErrorRow is not null)
            {
                var nextRowAfterRefresh = CurrentBatch?.Rows.FirstOrDefault(x => x.ImportBatchRowId == previousNextErrorRow.ImportBatchRowId);
                if (nextRowAfterRefresh is not null && nextRowAfterRefresh.Errors.Any())
                {
                    await OpenCorrectionModalAsync(nextRowAfterRefresh);
                }
                else if (GetNextErrorRow() is { } remainingNextError)
                {
                    await OpenCorrectionModalAsync(remainingNextError);
                }
            }
        }
        catch (Exception ex)
        {
            RowModalErrorMessage = ex.Message;
        }
        finally
        {
            IsSavingCorrections = false;
        }
    }

    private bool IsCatalogLikeField(BulkImportTemplateFieldDto field)
        => !string.IsNullOrWhiteSpace(field.ReferenceTableName)
            || field.FieldKey is "AcademicTermId" or "PublicationStatusId" or "ResearchLineId" or "BroadFieldId" or "SpecificFieldId" or "DetailedFieldId";

    private int? GetParentCatalogId(BulkImportTemplateFieldDto field)
    {
        return field.FieldKey switch
        {
            "SpecificFieldId" => TryResolveFieldIntValue("BroadFieldId"),
            "DetailedFieldId" => TryResolveFieldIntValue("SpecificFieldId"),
            _ => null
        };
    }

    private int? TryResolveFieldIntValue(string fieldKey)
    {
        var editableField = SelectedRowEditableFields.FirstOrDefault(x => x.FieldKey == fieldKey);
        if (editableField is null)
        {
            return null;
        }

        var rawCandidate = GetCorrectionValue(editableField.FieldId);
        if (int.TryParse(rawCandidate, out var parsedFromRaw))
        {
            return parsedFromRaw;
        }

        var existingCell = TryGetExistingCell(editableField.FieldId);
        return int.TryParse(existingCell?.NormalizedValue, out var parsedNormalized) ? parsedNormalized : null;
    }

    private static bool IsBooleanField(BulkImportTemplateFieldDto field)
        => (field.DataType ?? string.Empty).Contains("bool", StringComparison.OrdinalIgnoreCase)
            || (field.DataType ?? string.Empty).Contains("bit", StringComparison.OrdinalIgnoreCase);

    private static bool IsDateField(BulkImportTemplateFieldDto field)
        => (field.DataType ?? string.Empty).Contains("date", StringComparison.OrdinalIgnoreCase)
            || (field.DataType ?? string.Empty).Contains("time", StringComparison.OrdinalIgnoreCase);

    private static bool IsNumericField(BulkImportTemplateFieldDto field)
    {
        var type = field.DataType ?? string.Empty;
        return type.Contains("int", StringComparison.OrdinalIgnoreCase)
            || type.Contains("short", StringComparison.OrdinalIgnoreCase)
            || type.Contains("decimal", StringComparison.OrdinalIgnoreCase)
            || type.Contains("numeric", StringComparison.OrdinalIgnoreCase)
            || type.Contains("double", StringComparison.OrdinalIgnoreCase)
            || type.Contains("float", StringComparison.OrdinalIgnoreCase);
