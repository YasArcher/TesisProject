@page "/management/exportinformation"
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components
@using tesisproject.frontend.SharedUI
@using tesisproject.frontend.Utils
@using tesisproject.frontend.Features.Management.Components
@using tesisproject.shared.DTOs.Catalogs
@using tesisproject.shared.DTOs.Configuration
@using tesisproject.shared.DTOs.Imports

@inject IFormConfigurationClient FormConfigurationClient
@inject IBulkImportClient BulkImportClient
@inject ExportJsInterop ExportJs

<PageTitle>Carga masiva dinámica</PageTitle>

<div class="app-page-shell bulk-import-page">
    <div class="bulk-import-hero mb-3 rounded-[1.4rem] px-4 py-3 text-white shadow-lg">
        <div class="flex items-center justify-between gap-3">
            <div>
                <h1 class="text-xl font-black md:text-2xl">Carga masiva dinámica</h1>
            </div>
        </div>
    </div>

    <AppConfirmPanel Visible="@HasPendingAction"
                     Eyebrow="Confirmación operativa"
                     Title="@PendingActionTitle"
                     Message="@PendingActionMessage"
                     ConfirmText="@PendingActionConfirmText"
                     OnConfirm="ConfirmPendingActionAsync"
                     OnCancel="CancelPendingAction" />

    <AppStatusModal Visible="@ShowFeedbackModal"
                    Variant="@FeedbackVariant"
                    Eyebrow="@FeedbackEyebrow"
                    Title="@FeedbackTitle"
                    Message="@FeedbackMessage"
                    OnClose="CloseFeedbackModal" />

    @if (IsBatchBusy)
    {
        <div class="fixed inset-0 z-50 flex items-center justify-center bg-[#12343b]/40 px-4 backdrop-blur-[2px]">
            <div class="w-full max-w-lg rounded-[1.8rem] border border-white/30 bg-white p-6 shadow-2xl">
                <div class="flex items-start gap-4">
                    <div class="mt-1 h-10 w-10 animate-pulse rounded-full bg-gradient-to-r from-[#12343b] to-[#2f4858]"></div>
                    <div>
                        <div class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">Procesando lote</div>
                        <h2 class="mt-1 text-xl font-black text-[#12343b]">@GetBlockingOverlayTitle()</h2>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (IsLoading)
    {
        <div class="rounded-3xl border bg-white p-6 text-center text-slate-600 shadow-sm">Cargando configuración de campos y lotes recientes...</div>
    }
    else
    {
        <div class="mb-4 grid grid-cols-2 gap-3 xl:grid-cols-4">
            <div class="rounded-2xl border border-[#d9e5e8] bg-white px-4 py-3 shadow-sm">
                <div class="text-[11px] uppercase tracking-wide text-slate-500">Artículo</div>
                <div class="mt-1 text-xl font-black text-[#12343b]">@SelectedArticleFieldIds.Count</div>
                <div class="text-xs text-slate-500">selección</div>
            </div>
            <div class="rounded-2xl border border-[#ead8bd] bg-[#fffdf8] px-4 py-3 shadow-sm">
                <div class="text-[11px] uppercase tracking-wide text-slate-500">Participante</div>
                <div class="mt-1 text-xl font-black text-[#8b5a16]">@SelectedParticipantFieldIds.Count</div>
                <div class="text-xs text-slate-500">selección</div>
            </div>
            <div class="rounded-2xl border border-[#d9e5e8] bg-white px-4 py-3 shadow-sm">
                <div class="text-[11px] uppercase tracking-wide text-slate-500">Lote actual</div>
                <div class="mt-1 truncate text-sm font-black text-[#12343b]">@(CurrentBatch?.Summary.BatchCode ?? "Sin lote")</div>
                <div class="text-xs text-slate-500">staging</div>
            </div>
            <div class="rounded-2xl border border-[#d9e5e8] bg-white px-4 py-3 shadow-sm">
                <div class="text-[11px] uppercase tracking-wide text-slate-500">Recientes</div>
                <div class="mt-1 text-xl font-black text-[#2f4858]">@RecentBatches.Count</div>
                <div class="text-xs text-slate-500">lotes</div>
            </div>
        </div>

        <div class="grid grid-cols-1 gap-6 2xl:grid-cols-[1.15fr_0.85fr]">
            <section class="space-y-6">
                <BulkImportTemplateDesigner ArticleFields="FilteredArticleFields.ToList()"
                                            ParticipantFields="FilteredParticipantFields.ToList()"
                                            SelectedArticleFieldIds="SelectedArticleFieldIds"
                                            SelectedParticipantFieldIds="SelectedParticipantFieldIds"
                                            ArticleSearchTerm="ArticleFieldSearchTerm"
                                            ParticipantSearchTerm="ParticipantFieldSearchTerm"
                                            IsGeneratingTemplate="IsGeneratingTemplate"
                                            OnUseActiveForms="UseActiveFormsAsync"
                                            OnSelectRequiredOnly="SelectRequiredOnly"
                                            OnDownloadTemplate="DownloadTemplateAsync"
                                            ArticleSearchTermChanged="HandleArticleFieldSearchChanged"
                                            ParticipantSearchTermChanged="HandleParticipantFieldSearchChanged"
                                            OnArticleFieldToggled="HandleArticleFieldToggled"
                                            OnParticipantFieldToggled="HandleParticipantFieldToggled" />

                <BulkImportUploadPanel SelectedFile="SelectedFile"
                                       SelectedSourceType="SelectedSourceType"
                                       UploadNotes="UploadNotes"
                                       IsUploading="IsUploading"
                                       OnFileSelected="OnFileSelected"
                                       SelectedSourceTypeChanged="HandleSourceTypeChanged"
                                       UploadNotesChanged="HandleUploadNotesChanged"
                                       OnRequestUpload="RequestUpload" />

                <BulkImportRecentBatches Batches="RecentBatches"
                                         OnRefresh="LoadRecentBatchesAsync"
                                         OnOpenBatch="OpenRecentBatchAsync" />
            </section>

            <aside class="space-y-4 xl:sticky xl:top-4 xl:max-h-[calc(100vh-2rem)] xl:self-start xl:overflow-auto">
                <BulkImportCurrentBatchSidebar Batch="CurrentBatch"
                                               BatchReviewHint="@GetBatchReviewHint()"
                                               OperationalGuidance="@GetOperationalGuidance()"
                                               RequiredContractSummary="@GetRequiredContractSummary()"
                                               RequiredContractFields="RequiredContractFieldLabels"
                                               MissingRequiredSummary="@GetMissingRequiredSummary()"
                                               PreviewWindowLabel="@($"{CurrentPreviewRows} {GetPreviewCoverageLabel()}")"
                                               PreviewWindowSummary="@GetPreviewWindowSummary()"
                                               CurrentStageLabel="@GetCurrentStageLabel()"
                                               OperationStatusBadgeClass="@GetOperationStatusBadgeClass()"
                                               OperationStatusLabel="@GetOperationStatusLabel()"
                                               OperationStatusDetail="@GetOperationStatusDetail()"
                                               IsGeneratingTemplate="IsGeneratingTemplate"
                                               IsValidatingBatch="IsValidatingBatch"
                                               IsProcessingBatch="IsProcessingBatch"
                                               CanDownloadTemplate="@(CurrentBatch?.Template is not null)"
                                               CanProcess="@CanProcessCurrentBatch"
                                               StageCards="CurrentBatchStageCards"
                                               OnPrepareNextLoad="PrepareNextLoad"
                                               OnRefresh="RefreshCurrentBatchAsync"
                                               OnDownloadTemplate="DownloadTemplateFromBatchAsync"
                                               OnValidate="RequestValidateCurrentBatch"
                                               OnProcess="RequestProcessCurrentBatch" />
            </aside>
        </div>
        @if (CurrentBatch is not null)
        {
            <section class="mt-6 space-y-6">
                <div class="rounded-[1.6rem] border border-[#d9e5e8] bg-white p-3 shadow-sm">
                    <div class="flex flex-wrap gap-2">
                        <button class="@GetBatchTabClass("correction")" @onclick='() => SetActiveBatchTab("correction")'>Corrección (@ErrorRows.Count)</button>
                        <button class="@GetBatchTabClass("preview")" @onclick='() => SetActiveBatchTab("preview")'>Validación y preview (@CurrentBatch.Rows.Count)</button>
                        <button class="@GetBatchTabClass("errors")" @onclick='() => SetActiveBatchTab("errors")'>Errores (@FilteredBatchErrors.Count)</button>
                    </div>
                </div>

                @if (ActiveBatchTab == "correction")
                {
                <BulkImportCorrectionQueue ErrorRows="ErrorRows"
                                           FilteredErrorRows="FilteredErrorRows"
                                           CorrectionResolvedRows="CorrectionResolvedRows"
                                           SearchTerm="CorrectionQueueSearchTerm"
                                           SortMode="CorrectionQueueSort"
                                           Focus="CorrectionQueueFocus"
                                           ErrorGroups="CurrentCorrectionErrorGroups"
                                           RowSummarySelector="GetRowCorrectionSummary"
                                           RowBadgesSelector="GetRowErrorBadgesForQueue"
                                           OnOpenNextError="OpenNextErrorRowAsync"
                                           OnSearchChanged="HandleCorrectionQueueSearchChanged"
                                           OnSortChanged="HandleCorrectionQueueSortChanged"
                                           OnFocusChanged="HandleCorrectionQueueFocusChanged"
                                           OnClearFocus="ClearCorrectionQueueFocus"
                                           OnOpenRow="OpenCorrectionModalAsync" />
                }

                @if (ActiveBatchTab == "preview")
                {
                <BulkImportPreviewPanel HasRows="CurrentBatch.Rows.Any()"
                                        FilteredPreviewCount="FilteredPreviewRows.Count"
                                        PreviewSearchTerm="PreviewSearchTerm"
                                        PreviewStatusFilter="PreviewStatusFilter"
                                        PreviewErrorsOnly="PreviewErrorsOnly"
                                        ShowNormalizedValues="ShowNormalizedValues"
                                        CurrentPreviewRows="CurrentPreviewRows"
                                        PreviewRowOptions="PreviewRowOptions"
                                        PreviewPageSizeOptions="PreviewPageSizeOptions"
                                        PreviewPageSize="PreviewPageSize"
                                        PreviewTotalPages="PreviewTotalPages"
                                        NormalizedPreviewCurrentPage="NormalizedPreviewCurrentPage"
                                        BatchReviewHint="@GetBatchReviewHint()"
                                        OrderedPreviewHeaders="OrderedPreviewHeaders"
                                        ShowTemplateSummary="@(CurrentBatch.Template is not null)"
                                        TemplateFieldCount="TemplateFieldPreviewItems.Count"
                                        TemplateFieldPreviewItems="TemplateFieldPreviewItems"
                                        HasFilteredRows="FilteredPreviewRows.Any()"
                                        PreviewPaginationSummary="@GetPreviewPaginationSummary()"
                                        PagedPreviewRows="PagedPreviewRows"
                                        PreviewRowOptionLabelSelector="GetPreviewRowOptionLabel"
                                        PreviewPageSizeOptionLabelSelector="GetPreviewPageSizeOptionLabel"
                                        TemplateFieldInterpretationSelector="GetTemplateFieldInterpretation"
                                        FindCellSelector="FindCell"
                                        PreviewCellClassSelector="GetPreviewCellClass"
                                        DisplayValueSelector="GetDisplayValue"
                                        NormalizedDisplayValueSelector="GetNormalizedDisplayValue"
                                        RowStatusBadgeClassSelector="GetRowStatusBadgeClass"
                                        OnPreviewSearchChanged="HandlePreviewSearchChanged"
                                        OnPreviewStatusChanged="HandlePreviewStatusChanged"
                                        OnPreviewErrorsOnlyChanged="HandlePreviewErrorsOnlyChanged"
                                        OnShowNormalizedValuesChanged="HandleShowNormalizedValuesChanged"
                                        OnPreviewRowsChanged="HandlePreviewRowsChangedAsync"
                                        OnPreviewPageSizeChanged="HandlePreviewPageSizeChangedAsync"
                                        OnGoToPreviousPage="GoToPreviousPreviewPageAsync"
                                        OnGoToNextPage="GoToNextPreviewPageAsync"
                                        OnOpenRow="OpenRowModal"
                                        OnCorrectRow="OpenCorrectionModalAsync" />
                }

                @if (ActiveBatchTab == "errors")
                {
                <div class="rounded-[2rem] border border-[#d9e5e8] bg-white p-5 shadow-sm">
                    <div class="mb-4 flex items-center justify-between gap-3">
                        <div>
                            <h2 class="text-base font-black text-[#12343b] md:text-lg">Errores del lote</h2>
                            <p class="text-sm text-slate-500">Aquí se mezclan observaciones del parser, validación SQL y reglas adicionales del cliente.</p>
                        </div>
                        <span class="rounded-full bg-rose-50 px-3 py-1 text-xs font-semibold text-rose-700">@FilteredBatchErrors.Count error(es) visibles</span>
                    </div>

                    <div class="mb-4 grid grid-cols-1 gap-3 lg:grid-cols-[1.2fr_0.7fr_0.7fr]">
                        <input class="rounded-xl border border-[#c9d7db] bg-[#f7fafb] px-3 py-2 text-sm" placeholder="Buscar por código, campo o mensaje de error" value="@ErrorSearchTerm" @oninput="HandleErrorSearchChanged" />
                        <select class="rounded-xl border border-[#c9d7db] bg-white px-3 py-2 text-sm" value="@ErrorSeverityFilter" @onchange="HandleErrorSeverityChanged">
                            <option value="all">Todas las severidades</option>
                            <option value="Error">Error</option>
                            <option value="Warning">Warning</option>
                        </select>
                        <label class="inline-flex items-center gap-2 rounded-xl border border-[#d9e5e8] bg-white px-3 py-2 text-sm text-slate-700">
                            <input type="checkbox" checked="@OnlyRowErrors" @onchange="HandleOnlyRowErrorsChanged" />
                            Solo errores por fila
                        </label>
                    </div>

                    @if (!GroupedBatchErrors.Any())
                    {
                        <AppEmptyState Title="No hay errores registrados" Message="Eso normalmente significa que el lote todavía no fue validado o que la carga va bien." />
                    }
                    else
                    {
                        <div class="mb-4 flex flex-col gap-3 rounded-3xl border border-[#ead1d1] bg-rose-50/40 p-4 lg:flex-row lg:items-center lg:justify-between">
                            <div>
                                <div class="text-sm font-bold text-rose-800">Navegación de errores</div>
                                <div class="text-xs text-slate-500">@GetErrorPaginationSummary()</div>
                            </div>
                            <div class="flex flex-wrap items-center gap-3">
                                <label class="flex items-center gap-2 text-xs font-semibold text-rose-800">
                                    Filas por página
                                    <input type="range" min="5" max="@GetErrorPageSizeSliderMax()" step="5" value="@ErrorPageSize" @oninput="HandleErrorPageSizeSliderChanged" />
                                </label>
                                <select class="rounded-xl border border-[#ead1d1] bg-white px-3 py-2 text-sm" value="@ErrorPageSize" @onchange="HandleErrorPageSizeChanged">
                                    @foreach (var option in ErrorPageSizeOptions)
                                    {
                                        <option value="@option">@GetErrorPageSizeOptionLabel(option)</option>
                                    }
                                </select>
                                <button class="rounded-xl border border-[#ead1d1] bg-white px-3 py-2 text-sm font-semibold text-rose-800 disabled:opacity-50" disabled="@(NormalizedErrorCurrentPage <= 1)" @onclick="GoToPreviousErrorPage">Anterior</button>
                                <button class="rounded-xl border border-[#ead1d1] bg-white px-3 py-2 text-sm font-semibold text-rose-800 disabled:opacity-50" disabled="@(NormalizedErrorCurrentPage >= ErrorTotalPages)" @onclick="GoToNextErrorPage">Siguiente</button>
                            </div>
                        </div>
                        <div class="app-table-wrap max-h-[28rem] overflow-auto rounded-3xl border border-[#ead1d1]">
                            <table class="app-table-compact min-w-full divide-y divide-[#f1dede] text-sm">
                                <thead class="bg-rose-50">
                                    <tr>
                                        <th class="px-4 py-3 text-left font-semibold text-rose-800">Fila</th>
                                        <th class="px-4 py-3 text-left font-semibold text-rose-800">Errores</th>
                                        <th class="px-4 py-3 text-left font-semibold text-rose-800">Warnings</th>
                                        <th class="px-4 py-3 text-left font-semibold text-rose-800">Campos / códigos</th>
                                        <th class="px-4 py-3 text-left font-semibold text-rose-800">Resumen</th>
                                        <th class="px-4 py-3 text-left font-semibold text-rose-800">Acción</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-[#f8e9e9] bg-white">
                                    @foreach (var group in PagedBatchErrors)
                                    {
                                        <tr class="align-top">
                                            <td class="px-4 py-3 font-semibold text-rose-700">@(group.RowNumber?.ToString() ?? "-")</td>
                                            <td class="px-4 py-3 text-slate-700">@group.ErrorCount</td>
                                            <td class="px-4 py-3 text-slate-700">@group.WarningCount</td>
                                            <td class="px-4 py-3">
                                                <div class="font-semibold text-slate-700">@(string.IsNullOrWhiteSpace(group.Fields) ? "-" : group.Fields)</div>
                                                <div class="mt-1 text-xs text-slate-500">@(string.IsNullOrWhiteSpace(group.Summary) ? "-" : group.Summary)</div>
                                            </td>
                                            <td class="px-4 py-3 text-slate-700">
                                                @foreach (var message in group.Messages)
                                                {
                                                    <div class="mb-1 last:mb-0">@message</div>
                                                }
                                            </td>
                                            <td class="px-4 py-3">
                                                @if (group.ImportBatchRowId.HasValue)
                                                {
                                                    <button class="rounded-xl border border-[#e7c690] bg-[#fff4e4] px-3 py-2 text-xs font-semibold text-[#8b5a16]" @onclick="async () => await OpenErrorRowByIdAsync(group.ImportBatchRowId.Value)">Ir a fila</button>
                                                }
                                                else
                                                {
                                                    <span class="text-xs text-slate-400">Sin fila</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
                }
            </section>
        }
    }
</div>

@if (SelectedPreviewRow is not null)
{
    <AppConfirmPanel Visible="true"
                     Size="xl"
                     Eyebrow="Detalle de staging"
                     Title="@($"Fila {SelectedPreviewRow.RowNumber}")"
                     ConfirmText="Cerrar"
                     CancelText=""
                     OnConfirm="CloseRowModal"
                     OnCancel="CloseRowModal">
        <div class="grid grid-cols-1 gap-4 xl:grid-cols-[1.2fr_0.8fr]">
            <div class="rounded-[1.6rem] border border-[#d9e5e8] bg-white shadow-sm overflow-hidden">
                <div class="flex flex-col gap-3 border-b border-[#d9e5e8] bg-[#16324f] px-6 py-4 text-white md:flex-row md:items-center md:justify-between">
                    <div>
                        <div class="text-xs uppercase tracking-[0.2em] text-white/70">Detalle de staging</div>
                        <h3 class="text-xl font-black">Fila @SelectedPreviewRow.RowNumber</h3>
                    </div>
                    <div class="flex flex-wrap items-center gap-2">
                        @if (ErrorRows.Any())
                        {
                            <button class="rounded-xl border border-white/25 px-3 py-2 text-sm font-semibold disabled:opacity-50" disabled="@(GetPreviousErrorRow() is null)" @onclick="OpenPreviousErrorRowAsync">Anterior error</button>
                            <button class="rounded-xl border border-white/25 px-3 py-2 text-sm font-semibold disabled:opacity-50" disabled="@(GetNextErrorRow() is null)" @onclick="OpenNextErrorRowFromModalAsync">Siguiente error</button>
                        }
                        <button class="rounded-xl border border-white/25 px-3 py-2 text-sm font-semibold" @onclick="EnterCorrectionModeAsync">Corregir fila</button>
                    </div>
                </div>
                <div class="p-6">
                    <div class="mb-4 flex flex-wrap items-center gap-3">
                        <span class="@GetRowStatusBadgeClass(SelectedPreviewRow.RowStatus)">@SelectedPreviewRow.RowStatus</span>
                        <span class="rounded-full bg-[#eef5f6] px-3 py-1 text-xs font-semibold text-[#2f4858]">@SelectedPreviewRow.Cells.Count celdas</span>
                        <span class="rounded-full px-3 py-1 text-xs font-semibold @(IsCorrectionMode ? "bg-[#fff4e4] text-[#8b5a16]" : "bg-slate-100 text-slate-600")">@(IsCorrectionMode ? "Modo corrección" : "Solo lectura")</span>
                        @if (GetCurrentErrorRowPosition() is { } position)
                        {
                            <span class="rounded-full bg-rose-50 px-3 py-1 text-xs font-semibold text-rose-700">Error @position de @ErrorRows.Count</span>
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(RowModalErrorMessage))
                    {
                        <AppAlertBanner Class="mb-4" Variant="error" Title="No pude guardar la corrección" Message="@RowModalErrorMessage" />
                    }
                    @if (!string.IsNullOrWhiteSpace(RowModalSuccessMessage))
                    {
                        <AppAlertBanner Class="mb-4" Variant="success" Title="Corrección aplicada" Message="@RowModalSuccessMessage" />
                    }

                    @if (!IsCorrectionMode)
                    {
                        <div class="app-table-wrap rounded-3xl border border-[#d9e5e8]">
                            <table class="app-table-compact min-w-full divide-y divide-[#d9e5e8] text-sm">
                                <thead class="bg-[#f4f8f9]">
                                    <tr>
                                        <th class="px-4 py-3 text-left font-semibold text-[#12343b]">Campo</th>
                                        <th class="px-4 py-3 text-left font-semibold text-[#12343b]">Raw</th>
                                        <th class="px-4 py-3 text-left font-semibold text-[#12343b]">Normalizado</th>
                                        <th class="px-4 py-3 text-left font-semibold text-[#12343b]">Estado</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-[#eef3f5] bg-white">
                                    @foreach (var cell in SelectedPreviewRow.Cells)
                                    {
                                        <tr class="align-top">
                                            <td class="px-4 py-3">
                                                <div class="font-semibold text-[#12343b]">@cell.FieldLabel</div>
                                                <div class="text-xs text-slate-500">@cell.EntityName.@cell.FieldKey</div>
                                            </td>
                                            <td class="max-w-[14rem] break-words px-4 py-3 text-slate-700">@cell.RawValue</td>
                                            <td class="max-w-[14rem] break-words px-4 py-3 font-medium text-slate-900">@cell.NormalizedValue</td>
                                            <td class="px-4 py-3">
                                                <span class="rounded-full px-3 py-1 text-xs font-semibold @(cell.IsValid ? "bg-emerald-50 text-emerald-700" : "bg-rose-50 text-rose-700")">@(cell.IsValid ? "OK" : "Revisar")</span>
                                                @if (!string.IsNullOrWhiteSpace(cell.ValidationMessage))
                                                {
                                                    <div class="mt-2 text-xs @(cell.IsValid ? "text-amber-700" : "text-rose-700")">@cell.ValidationMessage</div>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="rounded-3xl border border-[#d9e5e8] bg-[#fcfefe] p-4">
                            <div class="mb-4">
                                <div class="font-bold text-[#12343b]">Editor asistido de fila</div>
                                <div class="text-sm text-slate-500">Ajusta los valores crudos y guarda. El sistema volverá a normalizar y revalidar el lote completo.</div>
                            </div>
                            @if (IsLoadingCorrectionMetadata)
                            {
                                <div class="mb-4 rounded-2xl border border-[#d9e5e8] bg-white px-4 py-3 text-sm text-slate-600">Cargando sugerencias y ayudas para esta fila...</div>
                            }
                            <div class="max-h-[32rem] space-y-3 overflow-auto pr-1">
                                @foreach (var field in SelectedRowEditableFields)
                                {
                                    var hasError = IsFieldInError(field.FieldId);
                                    <div class="rounded-2xl border px-4 py-4 @(hasError ? "border-rose-200 bg-rose-50/50" : "border-[#d9e5e8] bg-white")">
                                        <div class="flex flex-wrap items-center gap-2">
                                            <div class="font-semibold text-[#12343b]">@field.FieldLabel</div>
                                            <span class="rounded-full bg-[#eef5f6] px-2 py-0.5 text-[11px] font-semibold text-[#2f4858]">@field.EntityName.@field.FieldKey</span>
                                            @if (field.IsRequired)
                                            {
                                                <span class="rounded-full bg-rose-50 px-2 py-0.5 text-[11px] font-semibold text-rose-700">Obligatorio</span>
                                            }
                                            @if (field.IsDynamic)
                                            {
                                                <span class="rounded-full bg-[#fff4e4] px-2 py-0.5 text-[11px] font-semibold text-[#8b5a16]">Dinámico</span>
                                            }
                                        </div>
                                        <div class="mt-1 text-xs text-slate-500">@GetTemplateFieldInterpretation(field)</div>
                                        @if (GetDynamicOptions(field.FieldId).Any())
                                        {
                                            <select class="mt-3 w-full rounded-xl border border-[#c9d7db] bg-white px-3 py-2 text-sm" value="@GetCorrectionValue(field.FieldId)" @onchange="async (args) => await HandleCorrectionValueChangedAsync(field, args.Value?.ToString())">
                                                <option value="">Selecciona una opción</option>
                                                @foreach (var option in GetDynamicOptions(field.FieldId))
                                                {
                                                    <option value="@option.OptionValue">@option.OptionLabel</option>
                                                }
                                            </select>
                                        }
                                        else if (GetCatalogSuggestions(field.FieldId).Any())
                                        {
                                            var datalistId = $"field-suggestions-{field.FieldId}";
                                            <input list="@datalistId" class="mt-3 w-full rounded-xl border border-[#c9d7db] bg-white px-3 py-2 text-sm" value="@GetCorrectionValue(field.FieldId)" @oninput="async (args) => await HandleCorrectionValueChangedAsync(field, args.Value?.ToString())" placeholder="@field.HeaderKey" />
                                            <datalist id="@datalistId">
                                                @foreach (var item in GetCatalogSuggestions(field.FieldId))
                                                {
                                                    <option value="@item.Name"></option>
                                                }
                                            </datalist>
                                        }
                                        else if (IsBooleanField(field))
                                        {
                                            <select class="mt-3 w-full rounded-xl border border-[#c9d7db] bg-white px-3 py-2 text-sm" value="@GetCorrectionValue(field.FieldId)" @onchange="async (args) => await HandleCorrectionValueChangedAsync(field, args.Value?.ToString())">
                                                <option value="">Sin valor</option>
                                                <option value="Si">Sí</option>
                                                <option value="No">No</option>
                                            </select>
                                        }
                                        else if (IsDateField(field))
                                        {
                                            <input type="date" class="mt-3 w-full rounded-xl border border-[#c9d7db] bg-white px-3 py-2 text-sm" value="@GetCorrectionValue(field.FieldId)" @oninput="async (args) => await HandleCorrectionValueChangedAsync(field, args.Value?.ToString())" />
                                        }
