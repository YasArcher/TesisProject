    private void ShowFeedback(string variant, string eyebrow, string title, string? message)
    {
        MessageTitle = title;
        ErrorMessage = variant == "error" ? message : null;
        SuccessMessage = variant == "success" ? message : null;
        WarningMessage = variant == "warning" ? message : null;
        FeedbackVariant = variant;
        FeedbackEyebrow = eyebrow;
        FeedbackTitle = title;
        FeedbackMessage = message;
        ShowFeedbackModal = true;
    }

    private Task CloseFeedbackModal()
    {
        ShowFeedbackModal = false;
        return Task.CompletedTask;
    }

    private void CancelPendingAction()
    {
        PendingAction = PendingBulkAction.None;
        PendingActionTitle = string.Empty;
        PendingActionMessage = string.Empty;
        PendingActionConfirmText = "Confirmar";
    }

    private async Task ConfirmPendingActionAsync()
    {
        var action = PendingAction;
        CancelPendingAction();

        switch (action)
        {
            case PendingBulkAction.Upload:
                await UploadAsync();
                break;
            case PendingBulkAction.Validate:
                await ValidateCurrentBatchAsync();
                break;
            case PendingBulkAction.Process:
                await ProcessCurrentBatchAsync();
                break;
        }
    }

    private string GetCurrentStageLabel()
    {
        if (CurrentBatch is null)
        {
            return "Sin lote";
        }

        if (CurrentBatch.Summary.ProcessedRows > 0)
        {
            return "Procesado";
        }

        if (CurrentBatch.Summary.Status.Equals("Validated", StringComparison.OrdinalIgnoreCase)
            || CurrentBatch.Summary.ValidRows > 0
            || CurrentBatch.Summary.ErrorRows > 0)
        {
            return "Validado";
        }

        return "Cargado";
    }

    private string GetStageStatusText(string stageKey)
    {
        return stageKey switch
        {
            "uploaded" => CurrentBatch is null ? "Pendiente" : "Listo",
            "validated" => CurrentBatch is null ? "Pendiente" : (CurrentBatch.Summary.ValidRows > 0 || CurrentBatch.Summary.ErrorRows > 0 || CurrentBatch.Summary.Status.Equals("Validated", StringComparison.OrdinalIgnoreCase) ? "Listo" : "Pendiente"),
            "processed" => CurrentBatch is not null && CurrentBatch.Summary.ProcessedRows > 0 ? "Listo" : "Pendiente",
            _ => "Pendiente"
        };
    }

    private string GetStageCardClass(string stageKey)
    {
        var isReady = GetStageStatusText(stageKey) == "Listo";
        return isReady
            ? "border-emerald-200 bg-emerald-50 text-emerald-900"
            : "border-[#d9e5e8] bg-white text-slate-700";
    }

    private string GetStageBadgeClass(string stageKey)
    {
        var isReady = GetStageStatusText(stageKey) == "Listo";
        return isReady
            ? "bg-emerald-100 text-emerald-700"
            : "bg-slate-100 text-slate-600";
    }

    private static string GetTemplateFieldInterpretation(BulkImportTemplateFieldDto field)
    {
        return field.FieldKey switch
        {
            "AcademicTermId" => "Acepta ID o nombre del periodo; se convierte al ID real.",
            "PublicationStatusId" => "Acepta ID o nombre del estado; se convierte al ID real.",
            "ResearchLineId" => "Acepta ID o nombre de la línea; se convierte al ID real.",
            "BroadFieldId" => "Acepta ID o nombre del campo amplio; se convierte al ID real.",
            "SpecificFieldId" => "Acepta ID, nombre o código; se convierte al ID real.",
            "DetailedFieldId" => "Acepta ID, nombre o código; se convierte al ID real.",
            "JournalName" => "Se usa para resolver o crear el venue del artículo.",
            "IssnCode" => "Refuerza la coincidencia del venue o ayuda a crearlo.",
            "Sjr" => "Se guarda como métrica decimal del venue.",
            "Quartile" => "Se guarda como métrica del venue, por ejemplo Q1.",
            _ when field.IsDynamic => "El sistema toma el valor y lo guarda como campo dinámico configurado.",
            _ when field.IsRequired => "Debe venir informado para que la fila pueda quedar válida.",
            _ => "Se interpreta según el tipo de dato configurado en FieldCatalog."
        };
    }

    private void ResetPreviewFilters()
    {
        PreviewSearchTerm = string.Empty;
        PreviewStatusFilter = "all";
        PreviewErrorsOnly = false;
        ShowNormalizedValues = false;
        PreviewCurrentPage = 1;
        ErrorSearchTerm = string.Empty;
        ErrorSeverityFilter = "all";
        OnlyRowErrors = false;
        CorrectionQueueFocus = "all";
    }

    private void NormalizePreviewPagination()
    {
        PreviewCurrentPage = NormalizedPreviewCurrentPage;
    }

    private void NormalizeErrorPagination()
    {
        ErrorCurrentPage = NormalizedErrorCurrentPage;
    }

    private static int ParsePositiveInt(string? value, int fallback)
        => int.TryParse(value, out var parsed) && parsed > 0 ? parsed : fallback;

    private void ClearMessages()
    {
        ErrorMessage = null;
        SuccessMessage = null;
        WarningMessage = null;
        MessageTitle = null;
    }

    private enum PendingBulkAction
    {
        None,
        Upload,
        Validate,
        Process
    }

