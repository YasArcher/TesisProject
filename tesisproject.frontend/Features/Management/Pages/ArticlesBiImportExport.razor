    private List<BulkImportRowPreviewDto> FilteredPreviewRows => CurrentBatch?.Rows
        .Where(MatchesPreviewFilter)
        .ToList() ?? new List<BulkImportRowPreviewDto>();
    private List<BulkImportRowPreviewDto> ErrorRows => CurrentBatch?.Rows
        .Where(row => row.Errors.Any() || string.Equals(row.RowStatus, "Error", StringComparison.OrdinalIgnoreCase))
        .OrderBy(row => row.RowNumber)
        .ToList() ?? new List<BulkImportRowPreviewDto>();
    private List<BulkImportRowPreviewDto> FilteredErrorRows => ErrorRows
        .Where(MatchesCorrectionQueueFilter)
        .OrderBy(row => CorrectionQueueSort == "errors" ? -row.Errors.Count : row.RowNumber)
        .ThenBy(row => row.RowNumber)
        .ToList();
    private List<BulkImportErrorDto> FilteredBatchErrors => CurrentBatch?.Errors
        .Where(MatchesErrorFilter)
        .ToList() ?? new List<BulkImportErrorDto>();
    private List<(string Key, string Label, string Helper)> BatchStages => new()
    {
        ("uploaded", "Carga al staging", "El archivo ya fue interpretado y quedó almacenado en ImportBatch e ImportBatchRow."),
        ("validated", "Validación", "Se aplican reglas del modelo, resolución de referencias y checks adicionales del cliente."),
        ("processed", "Procesamiento", "Solo las filas limpias pasan al modelo híbrido definitivo.")
    };
    private List<BulkImportTemplateFieldDto> TemplateFieldPreviewItems => CurrentBatch?.Template is null
        ? new List<BulkImportTemplateFieldDto>()
        : CurrentBatch.Template.ArticleFields.Concat(CurrentBatch.Template.ParticipantFields).ToList();
    private List<BulkImportTemplateFieldDto> SelectedRowEditableFields
    {
        get
        {
            if (SelectedPreviewRow is null)
            {
                return new List<BulkImportTemplateFieldDto>();
            }

            var result = new List<BulkImportTemplateFieldDto>();

            if (CurrentBatch?.Template is not null)
            {
                result.AddRange(CurrentBatch.Template.ArticleFields);
                result.AddRange(CurrentBatch.Template.ParticipantFields);
            }

            result.AddRange(SelectedPreviewRow.Cells.Select(MapCellToEditableField));

            var missingErrorFields = SelectedPreviewRow.Errors
                .Where(error => error.FieldId.HasValue && result.All(field => field.FieldId != error.FieldId.Value))
                .Select(error => FindEditableFieldById(error.FieldId!.Value))
                .Where(field => field is not null)
                .Cast<BulkImportTemplateFieldDto>();

            result.AddRange(missingErrorFields);

            return result
                .GroupBy(field => field.FieldId)
                .Select(group => group.First())
                .OrderBy(field => field.EntityName)
                .ThenBy(field => field.FieldLabel)
                .ToList();
        }
    }
    private Dictionary<int, string?> CorrectionValues = new();
    private Dictionary<int, List<CatalogItemDto>> CorrectionCatalogSuggestions = new();
    private Dictionary<int, List<DynamicFieldOptionDto>> CorrectionDynamicOptions = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        if (InitialBatchId.HasValue && InitialBatchId.Value > 0)
        {
            await OpenBatchAsync(InitialBatchId.Value);
        }
    }

    private async Task LoadAsync()
    {
        try
        {
            IsLoading = true;
            ClearMessages();
            ArticleFields = await FormConfigurationClient.GetFieldsAsync("Article");
            ParticipantFields = await FormConfigurationClient.GetFieldsAsync("ArticleParticipant");
            ArticleForm = await FormConfigurationClient.GetResolvedFormAsync("ArticleManualForm");
            ParticipantForm = await FormConfigurationClient.GetResolvedFormAsync("ArticleParticipantForm");
            await UseActiveFormsAsync();
            await LoadRecentBatchesAsync();
        }
        catch (Exception ex)
        {
            ShowFeedback("error", "No pude cargar la pantalla", "Error de carga", $"No pude cargar la configuración de carga masiva: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
        }
    }

    private Task UseActiveFormsAsync()
    {
        SelectedArticleFieldIds = ArticleForm?.Sections.SelectMany(x => x.Fields).Select(x => x.FieldId).ToHashSet() ?? new HashSet<int>();
        SelectedParticipantFieldIds = ParticipantForm?.Sections.SelectMany(x => x.Fields).Select(x => x.FieldId).ToHashSet() ?? new HashSet<int>();
        return Task.CompletedTask;
    }

    private void SelectRequiredOnly()
    {
        SelectedArticleFieldIds = ArticleFields.Where(x => x.IsRequired).Select(x => x.FieldId).ToHashSet();
        SelectedParticipantFieldIds = ParticipantFields.Where(x => x.IsRequired).Select(x => x.FieldId).ToHashSet();
    }

    private void ToggleArticleField(int fieldId, object? value) => ToggleSelection(SelectedArticleFieldIds, fieldId, value);
    private void ToggleParticipantField(int fieldId, object? value) => ToggleSelection(SelectedParticipantFieldIds, fieldId, value);

    private static void ToggleSelection(HashSet<int> set, int fieldId, object? value)
    {
        var isChecked = value as bool? == true;
        if (isChecked) set.Add(fieldId); else set.Remove(fieldId);
    }

    private async Task DownloadTemplateAsync()
    {
        try
        {
            ClearMessages();
            IsGeneratingTemplate = true;
            if (SelectedArticleFieldIds.Count == 0 && SelectedParticipantFieldIds.Count == 0)
            {
                ShowFeedback("warning", "Plantilla incompleta", "Plantilla incompleta", "Selecciona al menos un campo antes de generar la plantilla.");
                return;
            }

            var request = new BulkImportTemplateRequest
            {
                EntityName = "Article",
                SourceType = SelectedSourceType,
                UseActiveFormsWhenEmpty = false,
                ArticleFieldIds = SelectedArticleFieldIds.OrderBy(x => x).ToList(),
                ParticipantFieldIds = SelectedParticipantFieldIds.OrderBy(x => x).ToList(),
                TemplateName = "carga_masiva_articulos"
            };

            var file = await BulkImportClient.GenerateTemplateAsync(request);
            await ExportJs.DownloadFile(file.FileName, file.ContentType, file.Content);
            ShowFeedback("success", "Plantilla lista", "Plantilla generada", "La plantilla dinámica se descargó correctamente.");
        }
        catch (Exception ex)
        {
            ShowFeedback("error", "No pude generar la plantilla", "Error de descarga", $"No pude generar la plantilla: {ex.Message}");
        }
        finally
        {
            IsGeneratingTemplate = false;
        }
    }

