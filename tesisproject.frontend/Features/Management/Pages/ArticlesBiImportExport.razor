@page "/management/exportinformation"
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components
@using tesisproject.frontend.SharedUI
@using tesisproject.frontend.Utils
@using tesisproject.shared.DTOs.Catalogs
@using tesisproject.shared.DTOs.Configuration
@using tesisproject.shared.DTOs.Imports

@inject IFormConfigurationClient FormConfigurationClient
@inject IBulkImportClient BulkImportClient
@inject ExportJsInterop ExportJs

<PageTitle>Carga masiva dinámica</PageTitle>

<div class="app-page-shell bulk-import-page">
    <div class="bulk-import-hero mb-4 rounded-[1.6rem] p-4 text-white shadow-lg">
        <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
            <div>
                <h1 class="text-2xl font-black md:text-3xl">Carga masiva dinámica</h1>
            </div>
        </div>
    </div>

    <AppConfirmPanel Visible="@HasPendingAction"
                     Eyebrow="Confirmación operativa"
                     Title="@PendingActionTitle"
                     Message="@PendingActionMessage"
                     ConfirmText="@PendingActionConfirmText"
                     OnConfirm="ConfirmPendingActionAsync"
                     OnCancel="CancelPendingAction" />

    <AppStatusModal Visible="@ShowFeedbackModal"
                    Variant="@FeedbackVariant"
                    Eyebrow="@FeedbackEyebrow"
                    Title="@FeedbackTitle"
                    Message="@FeedbackMessage"
                    OnClose="CloseFeedbackModal" />

    @if (IsLoading)
    {
        <div class="rounded-3xl border bg-white p-6 text-center text-slate-600 shadow-sm">Cargando configuración de campos y lotes recientes...</div>
    }
    else
    {
        <div class="mb-6 grid grid-cols-1 gap-4 lg:grid-cols-4">
            <AppMetricCard Label="Campos de artículo" Value="@SelectedArticleFieldIds.Count.ToString()" HelperText="seleccionados para la plantilla" Tone="accent" />
            <AppMetricCard Label="Campos de participante" Value="@SelectedParticipantFieldIds.Count.ToString()" HelperText="incluidos en el lote" Tone="warm" />
            <AppMetricCard Label="Lote actual" Value="@(CurrentBatch?.Summary.BatchCode ?? "Sin lote")" HelperText="preview y estados del staging" Tone="default" />
            <AppMetricCard Label="Lotes recientes" Value="@RecentBatches.Count.ToString()" HelperText="historial rápido para retomar" Tone="accent" />
        </div>

        <div class="grid grid-cols-1 gap-6 2xl:grid-cols-[1.15fr_0.85fr]">
            <section class="space-y-6">
                <div class="rounded-[1.6rem] border border-[#d9e5e8] bg-white p-4 shadow-sm">
                    <div class="mb-4 flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
                        <h2 class="text-base font-black text-[#12343b] md:text-lg">1. Diseñar plantilla</h2>
                        <div class="flex flex-wrap gap-2">
                            <button class="rounded-xl border border-[#c7d6da] bg-white px-4 py-2 text-sm font-semibold text-[#12343b]" @onclick="UseActiveFormsAsync">Usar formularios activos</button>
                            <button class="rounded-xl border border-[#e2c695] bg-[#fff3de] px-4 py-2 text-sm font-semibold text-[#8b5a16]" @onclick="SelectRequiredOnly">Solo obligatorios</button>
                            <button class="rounded-xl bg-gradient-to-r from-[#12343b] to-[#2f4858] px-4 py-2 text-sm font-semibold text-white disabled:opacity-60" disabled="@IsGeneratingTemplate" @onclick="DownloadTemplateAsync">@(IsGeneratingTemplate ? "Generando..." : "Descargar plantilla")</button>
                        </div>
                    </div>

                    <div class="mb-4 grid grid-cols-1 gap-3 md:grid-cols-2">
                        <input class="w-full rounded-xl border border-[#c9d7db] bg-[#f7fafb] px-3 py-2 text-sm" placeholder="Buscar campos de artículo" @bind="ArticleFieldSearchTerm" @bind:event="oninput" />
                        <input class="w-full rounded-xl border border-[#e1d1b0] bg-[#fffaf2] px-3 py-2 text-sm" placeholder="Buscar campos de participante" @bind="ParticipantFieldSearchTerm" @bind:event="oninput" />
                    </div>

                    <div class="grid grid-cols-1 gap-5 lg:grid-cols-2">
                        <div class="rounded-3xl border border-[#d9e5e8] bg-[#f8fbfc] p-3.5">
                            <div class="mb-3 flex items-center justify-between">
                                <div>
                                    <h3 class="font-bold text-[#12343b]">Campos de artículo</h3>
                                </div>
                                <span class="rounded-full bg-white px-3 py-1 text-xs font-semibold text-[#2f4858]">@SelectedArticleFieldIds.Count seleccionados</span>
                            </div>
                            <div class="max-h-[28rem] space-y-2 overflow-auto pr-1">
                                @if (!FilteredArticleFields.Any())
                                {
                                    <AppEmptyState Title="Sin coincidencias" Message="Prueba otra búsqueda para encontrar campos de artículo." />
                                }
                                else
                                {
                                    @foreach (var field in FilteredArticleFields)
                                    {
                                        <label class="flex cursor-pointer items-start gap-3 rounded-2xl border border-[#d9e5e8] bg-white px-4 py-3 transition hover:border-[#8cb0b8] hover:shadow-sm">
                                            <input type="checkbox" class="mt-1 h-4 w-4 rounded border-slate-300 text-[#12343b]" checked="@SelectedArticleFieldIds.Contains(field.FieldId)" @onchange="(args) => ToggleArticleField(field.FieldId, args.Value)" />
                                            <div class="min-w-0 flex-1">
                                                <div class="flex flex-wrap items-center gap-2">
                                                    <span class="font-semibold text-[#12343b]">@field.FieldLabel</span>
                                                    <span class="rounded-full bg-[#eef5f6] px-2 py-0.5 text-[11px] font-semibold text-[#2f4858]">@field.FieldKey</span>
                                                    @if (field.IsDynamic)
                                                    {
                                                        <span class="rounded-full bg-[#fff1d6] px-2 py-0.5 text-[11px] font-semibold text-[#8b5a16]">Dinámico</span>
                                                    }
                                                    @if (field.IsRequired)
                                                    {
                                                        <span class="rounded-full bg-rose-50 px-2 py-0.5 text-[11px] font-semibold text-rose-700">Obligatorio</span>
                                                    }
                                                </div>
                                                <div class="mt-1 text-xs text-slate-500">@field.DataType · @field.SourceType</div>
                                            </div>
                                        </label>
                                    }
                                }
                            </div>
                        </div>

                        <div class="rounded-3xl border border-[#ead8bd] bg-[#fffdf8] p-3.5">
                            <div class="mb-3 flex items-center justify-between">
                                <div>
                                    <h3 class="font-bold text-[#8b5a16]">Campos de participante</h3>
                                </div>
                                <span class="rounded-full bg-white px-3 py-1 text-xs font-semibold text-[#8b5a16]">@SelectedParticipantFieldIds.Count seleccionados</span>
                            </div>
                            <div class="max-h-[28rem] space-y-2 overflow-auto pr-1">
                                @if (!FilteredParticipantFields.Any())
                                {
                                    <AppEmptyState Title="Sin coincidencias" Message="Prueba otra búsqueda para encontrar campos de participante." />
                                }
                                else
                                {
                                    @foreach (var field in FilteredParticipantFields)
                                    {
                                        <label class="flex cursor-pointer items-start gap-3 rounded-2xl border border-[#ead8bd] bg-white px-4 py-3 transition hover:border-[#d9ba86] hover:shadow-sm">
                                            <input type="checkbox" class="mt-1 h-4 w-4 rounded border-slate-300 text-[#c17c2f]" checked="@SelectedParticipantFieldIds.Contains(field.FieldId)" @onchange="(args) => ToggleParticipantField(field.FieldId, args.Value)" />
                                            <div class="min-w-0 flex-1">
                                                <div class="flex flex-wrap items-center gap-2">
                                                    <span class="font-semibold text-[#8b5a16]">@field.FieldLabel</span>
                                                    <span class="rounded-full bg-[#fff4e4] px-2 py-0.5 text-[11px] font-semibold text-[#8b5a16]">@field.FieldKey</span>
                                                </div>
                                                <div class="mt-1 text-xs text-slate-500">@field.DataType · @field.SourceType</div>
                                            </div>
                                        </label>
                                    }
                                }
                            </div>
                        </div>
                    </div>
                </div>
                <div class="rounded-[1.6rem] border border-[#d9e5e8] bg-white p-4 shadow-sm">
                    <div class="mb-4 flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
                        <h2 class="text-base font-black text-[#12343b] md:text-lg">2. Subir archivo al staging</h2>
                        <span class="rounded-full bg-[#eef5f6] px-3 py-1 text-xs font-semibold text-[#2f4858]">Estados: Pending · Validated · Processed · Error</span>
                    </div>

                    <div class="grid grid-cols-1 gap-4 lg:grid-cols-[0.75fr_0.25fr]">
                        <div class="rounded-3xl border-2 border-dashed border-[#c7d6da] bg-[#f8fbfc] p-4">
                            <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
                                <div>
                                    <div class="font-semibold text-[#12343b]">Archivo de carga</div>
                                </div>
                                <InputFile OnChange="OnFileSelected" accept=".xlsx,.xls,.csv" class="block text-sm text-slate-600" />
                            </div>

                            @if (SelectedFile is not null)
                            {
                                <div class="mt-4 rounded-2xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800">
                                    Archivo seleccionado: <span class="font-semibold">@SelectedFile.Name</span> · @((SelectedFile.Size / 1024.0).ToString("F1")) KB
                                </div>
                            }
                        </div>

                        <div class="space-y-3 rounded-3xl border border-[#ead8bd] bg-[#fffdf8] p-4">
                            <label class="block text-sm font-semibold text-[#8b5a16]">Fuente</label>
                            <select class="w-full rounded-xl border border-[#e1d1b0] bg-white px-3 py-2 text-sm" @bind="SelectedSourceType">
                                <option value="Excel">Excel</option>
                                <option value="Csv">CSV</option>
                                <option value="Manual">Manual</option>
                            </select>
                            <label class="block text-sm font-semibold text-[#8b5a16]">Notas</label>
                            <textarea class="min-h-[4.5rem] w-full rounded-xl border border-[#e1d1b0] bg-white px-3 py-2 text-sm" @bind="UploadNotes" placeholder="Describe el objetivo del lote o el subconjunto que estás cargando."></textarea>
                            <button class="w-full rounded-xl bg-gradient-to-r from-[#c17c2f] to-[#d08d46] px-4 py-2.5 text-sm font-semibold text-white disabled:opacity-60" disabled="@(SelectedFile is null || IsUploading)" @onclick="RequestUpload">@(IsUploading ? "Subiendo..." : "Crear lote en staging")</button>
                        </div>
                    </div>
                </div>

                <div class="rounded-[1.6rem] border border-[#d9e5e8] bg-white p-4 shadow-sm">
                    <div class="mb-4 flex items-center justify-between gap-3">
                        <h2 class="text-base font-black text-[#12343b] md:text-lg">3. Lotes recientes</h2>
                        <button class="rounded-xl border border-[#c7d6da] bg-white px-4 py-2 text-sm font-semibold text-[#12343b]" @onclick="LoadRecentBatchesAsync">Actualizar</button>
                    </div>

                    @if (!RecentBatches.Any())
                    {
                        <AppEmptyState Title="Aún no hay lotes recientes" Message="Cuando subas el primer archivo, aquí verás el historial rápido para retomarlo." />
                    }
                    else
                    {
                        <div class="grid grid-cols-1 gap-3 lg:grid-cols-2">
                            @foreach (var batch in RecentBatches)
                            {
                                <button class="rounded-3xl border border-[#d9e5e8] bg-[#f8fbfc] p-4 text-left transition hover:border-[#8cb0b8] hover:shadow-sm" @onclick="() => OpenBatchAsync(batch.ImportBatchId)">
                                    <div class="flex items-start justify-between gap-3">
                                        <div>
                                            <div class="font-semibold text-[#12343b]">@batch.BatchCode</div>
                                            <div class="mt-1 text-xs text-slate-500">@batch.FileName</div>
                                        </div>
                                        <span class="rounded-full bg-white px-3 py-1 text-xs font-semibold text-[#2f4858]">@batch.Status</span>
                                    </div>
                                    <div class="mt-3 grid grid-cols-3 gap-2 text-xs text-slate-500">
                                        <div>Total: <span class="font-semibold text-slate-700">@batch.TotalRows</span></div>
                                        <div>Errores: <span class="font-semibold text-rose-700">@batch.ErrorRows</span></div>
                                        <div>Procesadas: <span class="font-semibold text-emerald-700">@batch.ProcessedRows</span></div>
                                    </div>
                                </button>
                            }
                        </div>
                    }
                </div>
            </section>

            <aside class="space-y-6 xl:sticky xl:top-6 xl:self-start">
                <div class="rounded-[1.6rem] border border-[#d9e5e8] bg-white p-4 shadow-sm">
                    <div class="mb-4 flex items-center justify-between gap-3">
                        <h2 class="text-base font-black text-[#12343b] md:text-lg">Lote actual</h2>
                        @if (CurrentBatch is not null)
                        {
                            <button class="rounded-xl border border-[#c7d6da] bg-white px-3 py-2 text-sm font-semibold text-[#12343b]" @onclick="RefreshCurrentBatchAsync">Refrescar</button>
                        }
                    </div>

                    @if (CurrentBatch is null)
                    {
                        <AppEmptyState Title="Todavía no hay un lote abierto" Message="Descarga una plantilla, súbela y aquí aparecerá la previsualización con los estados reales del staging." />
                    }
                    else
                    {
                        <div class="space-y-3 text-sm">
                            <div class="rounded-2xl bg-[#f4f8f9] px-4 py-3">
                                <div class="text-xs uppercase tracking-wide text-slate-500">Código</div>
                                <div class="mt-1 font-semibold text-[#12343b]">@CurrentBatch.Summary.BatchCode</div>
                            </div>
                            <div class="grid grid-cols-2 gap-3">
                                <div class="rounded-2xl bg-[#eef5f6] px-4 py-3">
                                    <div class="text-xs uppercase tracking-wide text-slate-500">Estado</div>
                                    <div class="mt-1 text-lg font-black text-[#2f4858]">@CurrentBatch.Summary.Status</div>
                                </div>
                                <div class="rounded-2xl bg-[#fff4e4] px-4 py-3">
                                    <div class="text-xs uppercase tracking-wide text-slate-500">Filas</div>
                                    <div class="mt-1 text-lg font-black text-[#c17c2f]">@CurrentBatch.Summary.TotalRows</div>
                                </div>
                            </div>
                            <div class="grid grid-cols-3 gap-3 text-center">
                                <div class="rounded-2xl border border-[#d9e5e8] bg-white px-3 py-3">
                                    <div class="text-xs text-slate-500">Valid</div>
                                    <div class="text-lg font-black text-emerald-700">@CurrentBatch.Summary.ValidRows</div>
                                </div>
                                <div class="rounded-2xl border border-[#d9e5e8] bg-white px-3 py-3">
                                    <div class="text-xs text-slate-500">Error</div>
                                    <div class="text-lg font-black text-rose-700">@CurrentBatch.Summary.ErrorRows</div>
                                </div>
                                <div class="rounded-2xl border border-[#d9e5e8] bg-white px-3 py-3">
                                    <div class="text-xs text-slate-500">Processed</div>
                                    <div class="text-lg font-black text-[#12343b]">@CurrentBatch.Summary.ProcessedRows</div>
                                </div>
                            </div>
                            <div class="rounded-3xl border border-[#d9e5e8] bg-[#f8fbfc] p-4">
                                <div class="mb-3 flex items-center justify-between gap-3">
                                    <div class="text-sm font-bold text-[#12343b]">Ruta del lote</div>
                                    <span class="rounded-full bg-white px-3 py-1 text-xs font-semibold text-[#2f4858]">@GetCurrentStageLabel()</span>
                                </div>
                                <div class="grid grid-cols-1 gap-3 md:grid-cols-3">
                                    @foreach (var stage in BatchStages)
                                    {
                                        <div class="rounded-2xl border px-4 py-3 @GetStageCardClass(stage.Key)">
                                            <div class="flex items-center justify-between gap-3">
                                                <div class="font-semibold">@stage.Label</div>
                                                <span class="rounded-full px-2 py-0.5 text-[11px] font-semibold @GetStageBadgeClass(stage.Key)">@GetStageStatusText(stage.Key)</span>
                                            </div>
                                            <div class="mt-2 text-xs opacity-80">@stage.Helper</div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="mt-5 flex flex-col gap-3">
                            <button class="rounded-xl border border-[#d7c19c] bg-[#fff4e4] px-4 py-2.5 text-sm font-semibold text-[#8b5a16] disabled:opacity-60" disabled="@(CurrentBatch.Template is null || IsGeneratingTemplate)" @onclick="DownloadTemplateFromBatchAsync">@(IsGeneratingTemplate ? "Generando..." : "Re-descargar plantilla del lote")</button>
                            <button class="rounded-xl border border-[#c7d6da] bg-white px-4 py-2.5 text-sm font-semibold text-[#12343b] disabled:opacity-60" disabled="@IsValidatingBatch" @onclick="RequestValidateCurrentBatch">@(IsValidatingBatch ? "Validando..." : "Validar lote")</button>
                            <button class="rounded-xl bg-gradient-to-r from-[#12343b] to-[#2f4858] px-4 py-2.5 text-sm font-semibold text-white disabled:opacity-60" disabled="@(CurrentBatch.Summary.TotalRows == 0 || IsProcessingBatch)" @onclick="RequestProcessCurrentBatch">@(IsProcessingBatch ? "Procesando..." : "Procesar lote")</button>
                        </div>
                    }
                </div>
            </aside>
        </div>
        @if (CurrentBatch is not null)
        {
            <section class="mt-6 space-y-6">
                <div class="rounded-[2rem] border border-[#ead8bd] bg-white p-5 shadow-sm">
                    <div class="mb-4 flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
                        <div>
                            <h2 class="text-base font-black text-[#8b5a16] md:text-lg">Bandeja de corrección</h2>
                            <p class="text-sm text-slate-500">Trabaja fila por fila sobre los pendientes reales del lote y salta directo al editor asistido.</p>
                        </div>
                        <div class="flex flex-wrap gap-2">
                            <button class="rounded-xl border border-[#e7c690] bg-[#fff4e4] px-4 py-2 text-sm font-semibold text-[#8b5a16] disabled:opacity-60" disabled="@(!ErrorRows.Any())" @onclick="OpenNextErrorRowAsync">Abrir siguiente error</button>
                            <span class="rounded-full bg-rose-50 px-3 py-2 text-xs font-semibold text-rose-700">@ErrorRows.Count fila(s) con error</span>
                        </div>
                    </div>

                    @if (!ErrorRows.Any())
                    {
                        <AppEmptyState Title="No hay filas pendientes de corrección" Message="Cuando un lote tenga errores, aquí verás una cola directa para revisarlos uno por uno." />
                    }
                    else
                    {
                        <div class="mb-4 grid grid-cols-1 gap-3 lg:grid-cols-[1.2fr_0.8fr]">
                            <input class="rounded-xl border border-[#e1d1b0] bg-[#fffaf2] px-3 py-2 text-sm" placeholder="Buscar por fila, valor o mensaje de error" @bind="CorrectionQueueSearchTerm" @bind:event="oninput" />
                            <select class="rounded-xl border border-[#e1d1b0] bg-white px-3 py-2 text-sm" @bind="CorrectionQueueSort">
                                <option value="row">Ordenar por fila</option>
                                <option value="errors">Más errores primero</option>
                            </select>
                        </div>

                        <div class="grid grid-cols-1 gap-3 xl:grid-cols-2">
                            @foreach (var row in FilteredErrorRows)
                            {
                                <button class="rounded-3xl border border-[#ead8bd] bg-[#fffdf8] p-4 text-left transition hover:border-[#d9ba86] hover:shadow-sm" @onclick="async () => await OpenCorrectionModalAsync(row)">
                                    <div class="flex items-start justify-between gap-3">
                                        <div>
                                            <div class="font-semibold text-[#8b5a16]">Fila @row.RowNumber</div>
                                            <div class="mt-1 text-xs text-slate-500">@GetRowCorrectionSummary(row)</div>
                                        </div>
                                        <span class="rounded-full bg-rose-50 px-3 py-1 text-xs font-semibold text-rose-700">@row.Errors.Count error(es)</span>
                                    </div>
                                    <div class="mt-3 flex flex-wrap gap-2">
                                        @foreach (var badge in GetRowErrorBadges(row))
                                        {
                                            <span class="rounded-full bg-white px-2 py-1 text-[11px] font-semibold text-slate-600">@badge</span>
                                        }
                                    </div>
                                </button>
                            }
                        </div>
                    }
                </div>

                <div class="rounded-[2rem] border border-[#d9e5e8] bg-white p-5 shadow-sm">
                    <div class="mb-4 flex items-center justify-between gap-3">
                        <div>
                            <h2 class="text-base font-black text-[#12343b] md:text-lg">Previsualización del lote</h2>
                            <p class="text-sm text-slate-500">Vista tipo hoja para revisar lo subido, detectar errores y abrir el detalle completo por fila.</p>
                        </div>
                        <span class="rounded-full bg-[#eef5f6] px-3 py-1 text-xs font-semibold text-[#2f4858]">@FilteredPreviewRows.Count filas visibles</span>
                    </div>

                    @if (!CurrentBatch.Rows.Any())
                    {
                        <AppEmptyState Title="El lote no tiene filas cargadas" Message="Revisa la plantilla y vuelve a subir el archivo si esperabas ver información aquí." />
                    }
                    else
                    {
                        <div class="mb-4 grid grid-cols-1 gap-3 lg:grid-cols-[1.2fr_0.7fr_0.7fr_0.8fr]">
                            <input class="rounded-xl border border-[#c9d7db] bg-[#f7fafb] px-3 py-2 text-sm" placeholder="Buscar valor, campo o contenido dentro del preview" @bind="PreviewSearchTerm" @bind:event="oninput" />
                            <select class="rounded-xl border border-[#c9d7db] bg-white px-3 py-2 text-sm" @bind="PreviewStatusFilter">
                                <option value="all">Todos los estados</option>
                                <option value="pending">Pending</option>
                                <option value="valid">Valid</option>
                                <option value="processed">Processed</option>
                                <option value="error">Error</option>
                            </select>
                            <label class="inline-flex items-center gap-2 rounded-xl border border-[#d9e5e8] bg-white px-3 py-2 text-sm text-slate-700">
                                <input type="checkbox" @bind="PreviewErrorsOnly" />
                                Solo filas con errores
                            </label>
                            <label class="inline-flex items-center gap-2 rounded-xl border border-[#d9e5e8] bg-white px-3 py-2 text-sm text-slate-700">
                                <input type="checkbox" @bind="ShowNormalizedValues" />
                                Ver normalizados
                            </label>
                        </div>

                        <div class="mb-4 grid grid-cols-1 gap-3 md:grid-cols-3">
                            <div class="rounded-2xl bg-[#f4f8f9] px-4 py-3 text-sm text-slate-600">
                                Columnas visibles: <span class="font-bold text-[#12343b]">@OrderedPreviewHeaders.Count</span>
                            </div>
                            <div class="rounded-2xl bg-[#fff4e4] px-4 py-3 text-sm text-slate-600">
                                Modo de celda: <span class="font-bold text-[#8b5a16]">@(ShowNormalizedValues ? "Normalizado" : "Raw")</span>
                            </div>
                            <div class="rounded-2xl bg-[#eef5f6] px-4 py-3 text-sm text-slate-600">
                                Revisión rápida: <span class="font-bold text-[#2f4858]">@GetBatchReviewHint()</span>
                            </div>
                        </div>

                        @if (CurrentBatch.Template is not null)
                        {
                            <div class="mb-4 rounded-3xl border border-[#d9e5e8] bg-[#fcfefe] p-4">
                                <div class="mb-3 flex items-center justify-between gap-3">
                                    <div>
                                        <div class="font-bold text-[#12343b]">Cómo interpreta esta plantilla</div>
                                        <div class="text-xs text-slate-500">El sistema acepta nombres, códigos o IDs según el campo y los normaliza antes de validar.</div>
                                    </div>
                                    <span class="rounded-full bg-[#eef5f6] px-3 py-1 text-xs font-semibold text-[#2f4858]">@((CurrentBatch.Template.ArticleFields.Count + CurrentBatch.Template.ParticipantFields.Count)) columnas en plantilla</span>
                                </div>
                        <div class="app-table-wrap rounded-2xl border border-[#e6eef0]">
                                    <table class="app-table-compact min-w-full divide-y divide-[#e6eef0] text-sm">
                                        <thead class="bg-[#f4f8f9]">
                                            <tr>
                                                <th class="px-4 py-3 text-left font-semibold text-[#12343b]">Campo</th>
                                                <th class="px-4 py-3 text-left font-semibold text-[#12343b]">Encabezado</th>
                                                <th class="px-4 py-3 text-left font-semibold text-[#12343b]">Tipo</th>
                                                <th class="px-4 py-3 text-left font-semibold text-[#12343b]">Lectura sugerida</th>
                                            </tr>
                                        </thead>
                                        <tbody class="divide-y divide-[#eef3f5] bg-white">
                                            @foreach (var templateField in TemplateFieldPreviewItems)
                                            {
                                                <tr>
                                                    <td class="px-4 py-3">
                                                        <div class="font-semibold text-[#12343b]">@templateField.FieldLabel</div>
                                                        <div class="text-xs text-slate-500">@templateField.EntityName.@templateField.FieldKey</div>
                                                    </td>
                                                    <td class="px-4 py-3 font-mono text-xs text-slate-700">@templateField.HeaderKey</td>
                                                    <td class="px-4 py-3 text-slate-600">@templateField.DataType</td>
                                                    <td class="px-4 py-3 text-slate-600">@GetTemplateFieldInterpretation(templateField)</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        }

                        @if (!FilteredPreviewRows.Any())
                        {
                            <AppEmptyState Title="No hay filas que coincidan con el filtro actual" Message="Prueba otro criterio o limpia los filtros para volver a ver todo el staging." />
                        }
                        else
                        {
                        <div class="app-table-wrap rounded-3xl border border-[#d9e5e8]">
                            <table class="app-table-compact min-w-full divide-y divide-[#d9e5e8] text-sm">
                                <thead class="bg-[#f4f8f9]">
                                    <tr>
                                        <th class="sticky left-0 z-10 bg-[#f4f8f9] px-4 py-3 text-left font-semibold text-[#12343b]">Fila</th>
                                        <th class="sticky left-[4.5rem] z-10 bg-[#f4f8f9] px-4 py-3 text-left font-semibold text-[#12343b]">Estado</th>
                                        @foreach (var header in OrderedPreviewHeaders)
                                        {
                                            <th class="px-4 py-3 text-left font-semibold text-[#12343b]">@header</th>
                                        }
                                        <th class="px-4 py-3 text-left font-semibold text-[#12343b]">Errores</th>
                                        <th class="px-4 py-3 text-left font-semibold text-[#12343b]">Detalle</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-[#eef3f5] bg-white">
                                    @foreach (var row in FilteredPreviewRows)
                                    {
                                        <tr class="align-top">
                                            <td class="sticky left-0 bg-white px-4 py-3 font-semibold text-slate-700">@row.RowNumber</td>
                                            <td class="sticky left-[4.5rem] bg-white px-4 py-3">
                                                <span class="@GetRowStatusBadgeClass(row.RowStatus)">@row.RowStatus</span>
                                            </td>
                                            @foreach (var header in OrderedPreviewHeaders)
                                            {
                                                var cell = FindCell(row, header);
                                                <td class="@GetPreviewCellClass(cell)">
                                                    @if (cell is null)
                                                    {
                                                        <span class="text-slate-300">-</span>
                                                    }
                                                    else
                                                    {
                                                        <div class="truncate font-medium @(cell.IsValid ? "text-slate-700" : "text-rose-700")" title="@(ShowNormalizedValues ? cell.NormalizedValue : cell.RawValue)">
                                                            @(ShowNormalizedValues ? GetNormalizedDisplayValue(cell) : GetDisplayValue(cell))
                                                        </div>
                                                        @if (!cell.IsValid && !string.IsNullOrWhiteSpace(cell.ValidationMessage))
                                                        {
                                                            <div class="mt-1 text-[11px] text-rose-600">@cell.ValidationMessage</div>
                                                        }
                                                    }
                                                </td>
                                            }
                                            <td class="px-4 py-3">
                                                @if (row.Errors.Any())
                                                {
                                                    <span class="rounded-full bg-rose-50 px-3 py-1 text-xs font-semibold text-rose-700">@row.Errors.Count error(es)</span>
                                                }
                                                else
                                                {
                                                    <span class="rounded-full bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-700">Sin errores</span>
                                                }
                                            </td>
                                            <td class="px-4 py-3">
                                                <div class="flex flex-wrap gap-2">
                                                    <button class="rounded-xl border border-[#c7d6da] bg-white px-3 py-2 text-xs font-semibold text-[#12343b]" @onclick="() => OpenRowModal(row)">Ver fila</button>
                                                    @if (row.Errors.Any())
                                                    {
                                                        <button class="rounded-xl border border-[#e7c690] bg-[#fff4e4] px-3 py-2 text-xs font-semibold text-[#8b5a16]" @onclick="async () => await OpenCorrectionModalAsync(row)">Corregir</button>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        }
                    }
                </div>

                <div class="rounded-[2rem] border border-[#d9e5e8] bg-white p-5 shadow-sm">
                    <div class="mb-4 flex items-center justify-between gap-3">
                        <div>
                            <h2 class="text-base font-black text-[#12343b] md:text-lg">Errores del lote</h2>
                            <p class="text-sm text-slate-500">Aquí se mezclan observaciones del parser, validación SQL y reglas adicionales del cliente.</p>
                        </div>
                        <span class="rounded-full bg-rose-50 px-3 py-1 text-xs font-semibold text-rose-700">@FilteredBatchErrors.Count error(es) visibles</span>
                    </div>

                    <div class="mb-4 grid grid-cols-1 gap-3 lg:grid-cols-[1.2fr_0.7fr_0.7fr]">
                        <input class="rounded-xl border border-[#c9d7db] bg-[#f7fafb] px-3 py-2 text-sm" placeholder="Buscar por código, campo o mensaje de error" @bind="ErrorSearchTerm" @bind:event="oninput" />
                        <select class="rounded-xl border border-[#c9d7db] bg-white px-3 py-2 text-sm" @bind="ErrorSeverityFilter">
                            <option value="all">Todas las severidades</option>
                            <option value="Error">Error</option>
                            <option value="Warning">Warning</option>
                        </select>
                        <label class="inline-flex items-center gap-2 rounded-xl border border-[#d9e5e8] bg-white px-3 py-2 text-sm text-slate-700">
                            <input type="checkbox" @bind="OnlyRowErrors" />
                            Solo errores por fila
                        </label>
                    </div>

                    @if (!FilteredBatchErrors.Any())
                    {
                        <AppEmptyState Title="No hay errores registrados" Message="Eso normalmente significa que el lote todavía no fue validado o que la carga va bien." />
                    }
                    else
                    {
                        <div class="app-table-wrap rounded-3xl border border-[#ead1d1]">
                            <table class="app-table-compact min-w-full divide-y divide-[#f1dede] text-sm">
                                <thead class="bg-rose-50">
                                    <tr>
                                        <th class="px-4 py-3 text-left font-semibold text-rose-800">Código</th>
                                        <th class="px-4 py-3 text-left font-semibold text-rose-800">Severidad</th>
                                        <th class="px-4 py-3 text-left font-semibold text-rose-800">Fila</th>
                                        <th class="px-4 py-3 text-left font-semibold text-rose-800">Campo</th>
                                        <th class="px-4 py-3 text-left font-semibold text-rose-800">Mensaje</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-[#f8e9e9] bg-white">
                                    @foreach (var error in FilteredBatchErrors)
                                    {
                                        <tr class="align-top">
                                            <td class="px-4 py-3 font-semibold text-rose-700">@error.ErrorCode</td>
                                            <td class="px-4 py-3">
                                                <span class="rounded-full px-2 py-1 text-xs font-semibold @(error.Severity.Equals("Warning", StringComparison.OrdinalIgnoreCase) ? "bg-amber-50 text-amber-700" : "bg-rose-50 text-rose-700")">@error.Severity</span>
                                            </td>
                                            <td class="px-4 py-3 text-slate-600">@(error.ImportBatchRowId?.ToString() ?? "-")</td>
                                            <td class="px-4 py-3 text-slate-600">@(string.IsNullOrWhiteSpace(error.FieldLabel) ? "-" : $"{error.FieldLabel} ({error.FieldKey})")</td>
                                            <td class="px-4 py-3 text-slate-700">@error.ErrorMessage</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </section>
        }
    }
</div>

@if (SelectedPreviewRow is not null)
{
    <AppConfirmPanel Visible="true"
                     Size="xl"
                     Eyebrow="Detalle de staging"
                     Title="@($"Fila {SelectedPreviewRow.RowNumber}")"
                     ConfirmText="Cerrar"
                     CancelText=""
                     OnConfirm="CloseRowModal"
                     OnCancel="CloseRowModal">
        <div class="grid grid-cols-1 gap-4 xl:grid-cols-[1.2fr_0.8fr]">
            <div class="rounded-[1.6rem] border border-[#d9e5e8] bg-white shadow-sm overflow-hidden">
                <div class="flex flex-col gap-3 border-b border-[#d9e5e8] bg-[#16324f] px-6 py-4 text-white md:flex-row md:items-center md:justify-between">
                    <div>
                        <div class="text-xs uppercase tracking-[0.2em] text-white/70">Detalle de staging</div>
                        <h3 class="text-xl font-black">Fila @SelectedPreviewRow.RowNumber</h3>
                    </div>
                    <div class="flex flex-wrap items-center gap-2">
                        @if (ErrorRows.Any())
                        {
                            <button class="rounded-xl border border-white/25 px-3 py-2 text-sm font-semibold disabled:opacity-50" disabled="@(GetPreviousErrorRow() is null)" @onclick="OpenPreviousErrorRowAsync">Anterior error</button>
                            <button class="rounded-xl border border-white/25 px-3 py-2 text-sm font-semibold disabled:opacity-50" disabled="@(GetNextErrorRow() is null)" @onclick="OpenNextErrorRowFromModalAsync">Siguiente error</button>
                        }
                        <button class="rounded-xl border border-white/25 px-3 py-2 text-sm font-semibold" @onclick="EnterCorrectionModeAsync">Corregir fila</button>
                    </div>
                </div>
                <div class="p-6">
                    <div class="mb-4 flex flex-wrap items-center gap-3">
                        <span class="@GetRowStatusBadgeClass(SelectedPreviewRow.RowStatus)">@SelectedPreviewRow.RowStatus</span>
                        <span class="rounded-full bg-[#eef5f6] px-3 py-1 text-xs font-semibold text-[#2f4858]">@SelectedPreviewRow.Cells.Count celdas</span>
                        <span class="rounded-full px-3 py-1 text-xs font-semibold @(IsCorrectionMode ? "bg-[#fff4e4] text-[#8b5a16]" : "bg-slate-100 text-slate-600")">@(IsCorrectionMode ? "Modo corrección" : "Solo lectura")</span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(RowModalErrorMessage))
                    {
                        <AppAlertBanner Class="mb-4" Variant="error" Title="No pude guardar la corrección" Message="@RowModalErrorMessage" />
                    }
                    @if (!string.IsNullOrWhiteSpace(RowModalSuccessMessage))
                    {
                        <AppAlertBanner Class="mb-4" Variant="success" Title="Corrección aplicada" Message="@RowModalSuccessMessage" />
                    }

                    @if (!IsCorrectionMode)
                    {
                        <div class="app-table-wrap rounded-3xl border border-[#d9e5e8]">
                            <table class="app-table-compact min-w-full divide-y divide-[#d9e5e8] text-sm">
                                <thead class="bg-[#f4f8f9]">
                                    <tr>
                                        <th class="px-4 py-3 text-left font-semibold text-[#12343b]">Campo</th>
                                        <th class="px-4 py-3 text-left font-semibold text-[#12343b]">Raw</th>
                                        <th class="px-4 py-3 text-left font-semibold text-[#12343b]">Normalizado</th>
                                        <th class="px-4 py-3 text-left font-semibold text-[#12343b]">Estado</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-[#eef3f5] bg-white">
                                    @foreach (var cell in SelectedPreviewRow.Cells)
                                    {
                                        <tr class="align-top">
                                            <td class="px-4 py-3">
                                                <div class="font-semibold text-[#12343b]">@cell.FieldLabel</div>
                                                <div class="text-xs text-slate-500">@cell.EntityName.@cell.FieldKey</div>
                                            </td>
                                            <td class="max-w-[14rem] break-words px-4 py-3 text-slate-700">@cell.RawValue</td>
                                            <td class="max-w-[14rem] break-words px-4 py-3 font-medium text-slate-900">@cell.NormalizedValue</td>
                                            <td class="px-4 py-3">
                                                <span class="rounded-full px-3 py-1 text-xs font-semibold @(cell.IsValid ? "bg-emerald-50 text-emerald-700" : "bg-rose-50 text-rose-700")">@(cell.IsValid ? "OK" : "Revisar")</span>
                                                @if (!string.IsNullOrWhiteSpace(cell.ValidationMessage))
                                                {
                                                    <div class="mt-2 text-xs @(cell.IsValid ? "text-amber-700" : "text-rose-700")">@cell.ValidationMessage</div>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="rounded-3xl border border-[#d9e5e8] bg-[#fcfefe] p-4">
                            <div class="mb-4">
                                <div class="font-bold text-[#12343b]">Editor asistido de fila</div>
                                <div class="text-sm text-slate-500">Ajusta los valores crudos y guarda. El sistema volverá a normalizar y revalidar el lote completo.</div>
                            </div>
                            @if (IsLoadingCorrectionMetadata)
                            {
                                <div class="mb-4 rounded-2xl border border-[#d9e5e8] bg-white px-4 py-3 text-sm text-slate-600">Cargando sugerencias y ayudas para esta fila...</div>
                            }
                            <div class="max-h-[32rem] space-y-3 overflow-auto pr-1">
                                @foreach (var field in SelectedRowEditableFields)
                                {
                                    var hasError = IsFieldInError(field.FieldId);
                                    <div class="rounded-2xl border px-4 py-4 @(hasError ? "border-rose-200 bg-rose-50/50" : "border-[#d9e5e8] bg-white")">
                                        <div class="flex flex-wrap items-center gap-2">
                                            <div class="font-semibold text-[#12343b]">@field.FieldLabel</div>
                                            <span class="rounded-full bg-[#eef5f6] px-2 py-0.5 text-[11px] font-semibold text-[#2f4858]">@field.EntityName.@field.FieldKey</span>
                                            @if (field.IsRequired)
                                            {
                                                <span class="rounded-full bg-rose-50 px-2 py-0.5 text-[11px] font-semibold text-rose-700">Obligatorio</span>
                                            }
                                            @if (field.IsDynamic)
                                            {
                                                <span class="rounded-full bg-[#fff4e4] px-2 py-0.5 text-[11px] font-semibold text-[#8b5a16]">Dinámico</span>
                                            }
                                        </div>
                                        <div class="mt-1 text-xs text-slate-500">@GetTemplateFieldInterpretation(field)</div>
                                        @if (GetDynamicOptions(field.FieldId).Any())
                                        {
                                            <select class="mt-3 w-full rounded-xl border border-[#c9d7db] bg-white px-3 py-2 text-sm" value="@GetCorrectionValue(field.FieldId)" @onchange="async (args) => await HandleCorrectionValueChangedAsync(field, args.Value?.ToString())">
                                                <option value="">Selecciona una opción</option>
                                                @foreach (var option in GetDynamicOptions(field.FieldId))
                                                {
                                                    <option value="@option.OptionValue">@option.OptionLabel</option>
                                                }
                                            </select>
                                        }
                                        else if (GetCatalogSuggestions(field.FieldId).Any())
                                        {
                                            var datalistId = $"field-suggestions-{field.FieldId}";
                                            <input list="@datalistId" class="mt-3 w-full rounded-xl border border-[#c9d7db] bg-white px-3 py-2 text-sm" value="@GetCorrectionValue(field.FieldId)" @oninput="async (args) => await HandleCorrectionValueChangedAsync(field, args.Value?.ToString())" placeholder="@field.HeaderKey" />
                                            <datalist id="@datalistId">
                                                @foreach (var item in GetCatalogSuggestions(field.FieldId))
                                                {
                                                    <option value="@item.Name"></option>
                                                }
                                            </datalist>
                                        }
                                        else if (IsBooleanField(field))
                                        {
                                            <select class="mt-3 w-full rounded-xl border border-[#c9d7db] bg-white px-3 py-2 text-sm" value="@GetCorrectionValue(field.FieldId)" @onchange="async (args) => await HandleCorrectionValueChangedAsync(field, args.Value?.ToString())">
                                                <option value="">Sin valor</option>
                                                <option value="Si">Sí</option>
                                                <option value="No">No</option>
                                            </select>
                                        }
                                        else if (IsDateField(field))
                                        {
                                            <input type="date" class="mt-3 w-full rounded-xl border border-[#c9d7db] bg-white px-3 py-2 text-sm" value="@GetCorrectionValue(field.FieldId)" @oninput="async (args) => await HandleCorrectionValueChangedAsync(field, args.Value?.ToString())" />
                                        }
                                        else if (IsNumericField(field))
                                        {
                                            <input type="number" step="@GetInputStep(field)" class="mt-3 w-full rounded-xl border border-[#c9d7db] bg-white px-3 py-2 text-sm" value="@GetCorrectionValue(field.FieldId)" @oninput="async (args) => await HandleCorrectionValueChangedAsync(field, args.Value?.ToString())" placeholder="@field.HeaderKey" />
                                        }
                                        else
                                        {
                                            <input class="mt-3 w-full rounded-xl border border-[#c9d7db] bg-white px-3 py-2 text-sm" value="@GetCorrectionValue(field.FieldId)" @oninput="async (args) => await HandleCorrectionValueChangedAsync(field, args.Value?.ToString())" placeholder="@field.HeaderKey" />
                                        }
                                        @if (GetCatalogSuggestions(field.FieldId).Any())
                                        {
                                            <div class="mt-2 text-xs text-[#2f4858]">Sugerencias: @string.Join(" | ", GetCatalogSuggestions(field.FieldId).Take(6).Select(x => x.Name))</div>
                                        }
                                        @if (TryGetExistingCell(field.FieldId) is { } existingCell)
                                        {
                                            <div class="mt-2 grid grid-cols-1 gap-2 text-xs md:grid-cols-2">
                                                <div class="rounded-xl bg-[#f4f8f9] px-3 py-2 text-slate-600">Raw actual: <span class="font-semibold text-slate-800">@existingCell.RawValue</span></div>
                                                <div class="rounded-xl bg-[#fff4e4] px-3 py-2 text-slate-600">Normalizado actual: <span class="font-semibold text-slate-800">@existingCell.NormalizedValue</span></div>
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(existingCell.ValidationMessage))
                                            {
                                                <div class="mt-2 text-xs text-rose-700">@existingCell.ValidationMessage</div>
                                            }
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
            <div class="rounded-[1.6rem] border border-[#ead8bd] bg-[#fffdf8] p-6 shadow-sm">
                <div>
                    <h4 class="text-base font-black text-[#8b5a16]">Errores y acciones</h4>
                    <div class="mt-4 rounded-3xl border border-[#ead8bd] bg-white px-4 py-4 text-sm text-slate-700">
                        <div class="font-semibold text-[#8b5a16]">Sugerencia</div>
                        <div class="mt-2">Corrige primero los campos marcados con error. Al guardar, el sistema vuelve a normalizar referencias, recalcula el staging y refresca el lote.</div>
                    </div>
                    @if (!SelectedPreviewRow.Errors.Any())
                    {
                        <div class="mt-4 rounded-3xl border border-emerald-200 bg-emerald-50 px-4 py-4 text-sm text-emerald-800">Esta fila no tiene errores persistidos en el lote.</div>
                    }
                    else
                    {
                        <div class="mt-4 space-y-3">
                            @foreach (var error in SelectedPreviewRow.Errors)
                            {
                                <div class="rounded-3xl border border-rose-200 bg-rose-50 px-4 py-4 text-sm">
                                    <div class="font-semibold text-rose-700">@error.ErrorCode</div>
                                    <div class="mt-2 text-rose-900">@error.ErrorMessage</div>
                                    @if (!string.IsNullOrWhiteSpace(error.FieldLabel))
                                    {
                                        <div class="mt-2 text-xs text-rose-700">Campo: @error.FieldLabel (@error.FieldKey)</div>
                                    }
                                </div>
                            }
                        </div>
                    }

                    @if (IsCorrectionMode)
                    {
                        <div class="mt-6 space-y-3">
                            <button class="w-full rounded-xl bg-gradient-to-r from-[#12343b] to-[#2f4858] px-4 py-3 text-sm font-semibold text-white disabled:opacity-60" disabled="@IsSavingCorrections" @onclick="SaveRowCorrectionsAsync">@(IsSavingCorrections ? "Guardando y validando..." : "Guardar correcciones y revalidar lote")</button>
                            <button class="w-full rounded-xl border border-[#d9e5e8] bg-white px-4 py-3 text-sm font-semibold text-slate-700" @onclick="CancelCorrectionMode">Cancelar edición</button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </AppConfirmPanel>
}

@code {
    [SupplyParameterFromQuery(Name = "batchId")]
    public int? InitialBatchId { get; set; }

    private List<FieldCatalogItemDto> ArticleFields = new();
    private List<FieldCatalogItemDto> ParticipantFields = new();
