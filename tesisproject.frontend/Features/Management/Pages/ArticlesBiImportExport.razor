                                <div class="rounded-3xl border border-rose-200 bg-rose-50 px-4 py-4 text-sm">
                                    <div class="flex flex-wrap items-center gap-2">
                                        <div class="font-semibold text-rose-700">@error.ErrorCode</div>
                                        @if (IsRequiredFieldError(error))
                                        {
                                            <span class="rounded-full bg-white px-2 py-0.5 text-[11px] font-semibold text-rose-700">Campo obligatorio</span>
