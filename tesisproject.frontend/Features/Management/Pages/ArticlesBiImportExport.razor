    private int GetErrorPageSizeSliderMax()
        => Math.Max(5, ((Math.Max(ErrorPageSizeOptions.DefaultIfEmpty(10).Max(), 5) + 4) / 5) * 5);

    private void SetActiveBatchTab(string tabKey)
