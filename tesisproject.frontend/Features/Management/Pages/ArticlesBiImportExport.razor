    private void ExpandPreviewToWholeBatch(int totalRows)
    {
        CurrentPreviewRows = Math.Max(25, totalRows);
        PreviewPageSize = Math.Max(10, totalRows);
        PreviewCurrentPage = 1;
    }

    private string GetOperationalGuidance()
    {
        if (CurrentBatch is null)
        {
            return "Abre o crea un lote para ver aquí el siguiente paso recomendado.";
        }

        if (CurrentBatch.Summary.ErrorRows > 0)
        {
            return "Conviene corregir primero las filas fallidas antes de procesar el lote.";
        }

        if (CurrentBatch.Summary.ValidRows > 0 && CurrentBatch.Summary.ProcessedRows == 0)
        {
            return "El lote ya pasó validación y está listo para persistirse en el modelo híbrido.";
        }

        if (CurrentBatch.Summary.TotalRows > 0)
        {
            return "Revisa el preview y lanza la validación para detectar referencias y reglas pendientes.";
        }

        return "Este lote todavía no tiene filas listas para revisión.";
    }

