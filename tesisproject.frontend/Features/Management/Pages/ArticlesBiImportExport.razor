                                    }
                                </div>
                            }
                        </div>
                    }

                    @if (IsCorrectionMode)
                    {
                        <div class="mt-6 space-y-3">
                            <button class="w-full rounded-xl bg-gradient-to-r from-[#12343b] to-[#2f4858] px-4 py-3 text-sm font-semibold text-white disabled:opacity-60" disabled="@IsSavingCorrections" @onclick="SaveRowCorrectionsAsync">@(IsSavingCorrections ? "Guardando y validando..." : "Guardar correcciones y revalidar lote")</button>
                            <button class="w-full rounded-xl border border-[#c17c2f] bg-[#fff4e4] px-4 py-3 text-sm font-semibold text-[#8b5a16] disabled:opacity-60" disabled="@(!CanSaveAndMoveNext || IsSavingCorrections)" @onclick="SaveAndOpenNextErrorAsync">@(IsSavingCorrections ? "Guardando..." : "Guardar y siguiente error")</button>
                            <button class="w-full rounded-xl border border-[#d9e5e8] bg-white px-4 py-3 text-sm font-semibold text-slate-700" @onclick="CancelCorrectionMode">Cancelar edición</button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </AppConfirmPanel>
}

