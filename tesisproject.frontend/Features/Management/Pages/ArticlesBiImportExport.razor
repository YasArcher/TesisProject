    private bool MatchesPreviewFilter(BulkImportRowPreviewDto row)
    {
        if (PreviewErrorsOnly && !row.Errors.Any())
        {
            return false;
        }

        if (!string.Equals(PreviewStatusFilter, "all", StringComparison.OrdinalIgnoreCase)
            && !string.Equals(row.RowStatus, PreviewStatusFilter, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        if (string.IsNullOrWhiteSpace(PreviewSearchTerm))
        {
            return true;
        }

        var term = PreviewSearchTerm.Trim();

        if (row.RowNumber.ToString().Contains(term, StringComparison.OrdinalIgnoreCase)
            || row.RowStatus.Contains(term, StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        return row.Cells.Any(cell =>
                   cell.FieldKey.Contains(term, StringComparison.OrdinalIgnoreCase)
                   || cell.FieldLabel.Contains(term, StringComparison.OrdinalIgnoreCase)
                   || (cell.RawValue?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                   || (cell.NormalizedValue?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false))
               || row.Errors.Any(error =>
                   error.ErrorCode.Contains(term, StringComparison.OrdinalIgnoreCase)
                   || error.ErrorMessage.Contains(term, StringComparison.OrdinalIgnoreCase));
    }

    private static string GetPreviewCellClass(BulkImportRowCellDto? cell)
    {
        if (cell is null)
        {
            return "max-w-[16rem] px-4 py-3 text-slate-700";
        }

        return cell.IsValid
            ? "max-w-[16rem] bg-white px-4 py-3 text-slate-700"
            : "max-w-[16rem] bg-rose-50/80 px-4 py-3 text-rose-700";
    }

