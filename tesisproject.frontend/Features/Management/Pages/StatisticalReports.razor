@page "/management/statisticalreports"
@using Microsoft.AspNetCore.Components.Authorization
@using tesisproject.frontend.Features.Management.Components
@using tesisproject.frontend.Services.Interfaces
@using tesisproject.shared.DTOs.Reports

<PageTitle>Reportes estadísticos</PageTitle>

<div class="reports-page flex flex-col gap-6 h-full px-3 py-4 md:px-6 md:py-6">
    @if (IsInstitutionalBlockingBusy)
    {
        <div class="reports-dw-blocking-loader" role="status" aria-live="polite">
            <div class="reports-dw-blocking-loader__surface">
                <div class="reports-dw-blocking-loader__orbit">
                    <span></span>
                    <i class="bi bi-database-check"></i>
                </div>
                <div>
                    <p>@InstitutionalBlockingBusyTitle</p>
                    <h2>Un momento, estamos preparando la información</h2>
                    <span>@InstitutionalBlockingBusyMessage</span>
                </div>
            </div>
        </div>
    }

    <section class="reports-dw-panel">
        <ReportInstitutionalPanelHeader IsInitialLoading="@(_isLoadingInstitutionalReporting && _institutionalDashboard is null)"
                                        ShowUnavailableState="@(!string.IsNullOrWhiteSpace(_institutionalReportingError) && _institutionalDashboard is null)"
                                        IsRefreshing="@_isRefreshingInstitutionalReporting"
                                        IsRunningEtl="@_isRunningInstitutionalEtl"
                                        IsBusy="@IsInstitutionalBlockingBusy"
                                        EtlStatusClass="@GetEtlStatusClass(_institutionalDashboard?.Health.LastEtlStatus)"
                                        EtlStatusLabel="@GetInstitutionalStatusLabel(_institutionalDashboard?.Health.LastEtlStatus)"
                                        OnRunEtl="RunEtlAndReload" />

        @if (!string.IsNullOrWhiteSpace(_institutionalReportingError))
        {
            <div class="reports-dw-panel__notice">
                @_institutionalReportingError
            </div>
        }

        @if (_institutionalDashboard is not null)
        {
            <ReportInstitutionalKpiSlider Dashboard="@_institutionalDashboard"
                                          LastEtlLabel="@FormatEtlDate(_institutionalDashboard?.Health.LastEtlFinishedAt)"
                                          ScopeLabel="@InstitutionalScopeLabel" />
        }
    </section>

    @if ((!_isLoadingInstitutionalReporting || _institutionalDashboard is not null)
        && _institutionalDashboard is not null
        && HasInstitutionalReportingData)
    {
        <ReportInstitutionalSectionTabs Dashboard="@_institutionalDashboard"
                                        ActiveTab="@_institutionalReportTab"
                                        AuthorSubtitle="@AuthorTabSubtitle"
                                        OnTabSelected="SelectInstitutionalReportTabAsync" />
    }

    <button class="reports-dw-floating-filter"
            type="button"
            aria-label="Abrir filtros"
            title="Filtros"
            disabled="@IsInstitutionalBlockingBusy"
            @onclick="ToggleInstitutionalFilters">
        <i class="bi bi-sliders2-vertical"></i>
        <span>Filtros</span>
    </button>

    <button class="reports-dw-floating-pdf"
            type="button"
            aria-label="Generar PDF"
            title="Generar PDF"
            disabled="@(!CanOpenPdfComposer)"
            @onclick="OpenPdfComposer">
        <i class="bi bi-file-earmark-pdf"></i>
        <span>PDF</span>
    </button>

    <button class="reports-dw-floating-excel"
            type="button"
            aria-label="Exportar Excel"
            title="Exportar Excel"
            disabled="@(!CanExportExcel)"
            @onclick="DownloadExcelAsync">
        <i class="bi bi-file-earmark-excel"></i>
        <span>@(_isExportingExcel ? "..." : "Excel")</span>
    </button>

    @if (_showInstitutionalFilters)
    {
        <div class="reports-filter-drawer" aria-label="Panel de filtros">
            <button class="reports-filter-drawer__backdrop"
                    type="button"
                    aria-label="Cerrar filtros"
                    @onclick="ToggleInstitutionalFilters"></button>

            <aside class="reports-filter-drawer__surface reports-dw-filter-drawer-panel">
                <ReportInstitutionalFilters Filter="@_institutionalFilter"
                                            Dashboard="@_institutionalDashboard"
                                            ShowFilters="true"
                                            IsBusy="@IsInstitutionalBlockingBusy"
                                            IsRefreshing="@_isRefreshingInstitutionalReporting"
                                            ScopeLabel="@InstitutionalScopeLabel"
                                            DataPulseLabel="@InstitutionalDataPulseLabel"
                                            LastLoadedLabel="@InstitutionalLastLoadedLabel"
                                            OnToggleFilters="ToggleInstitutionalFilters"
                                            OnClearFilters="ClearInstitutionalFiltersAsync"
                                            OnApplyFilters="ApplyInstitutionalFiltersAsync" />
            </aside>
        </div>
    }

    @if (!_isLoadingInstitutionalReporting
        && _institutionalDashboard is not null
        && !HasInstitutionalReportingData)
    {
        <section class="reports-dw-empty-state">
            <span class="reports-dw-empty-state__icon">
                <i class="bi bi-inbox"></i>
            </span>
            <div>
                <h2>Sin artículos académicos para mostrar</h2>
                <p>
                    Todavía no existen artículos académicos dentro de los filtros seleccionados. Cuando se registren artículos y se actualice la información, este tablero mostrará indicadores institucionales reales.
                </p>
            </div>
        </section>
    }
    else if ((!_isLoadingInstitutionalReporting || _institutionalDashboard is not null)
        && _institutionalDashboard is not null
        && HasInstitutionalReportingData)
    {
        @if (_institutionalReportTab == "overview")
        {
            <section class="reports-dw-content-shell">
                <section class="reports-dw-analytics-grid @(_isRefreshingInstitutionalReporting ? "reports-dw-analytics-grid--refreshing" : string.Empty)">
                    @if (_isRefreshingInstitutionalReporting)
                    {
                        <div class="reports-dw-refresh-overlay">
                            <i class="bi bi-arrow-repeat"></i>
                            Actualizando indicadores filtrados...
                        </div>
                    }

                    <ReportProductionOverviewBlock Dashboard="@_institutionalDashboard" />

                    <ReportQualityMetricsBlock Dashboard="@_institutionalDashboard" />

                    <ReportPeopleConcentrationBlock Dashboard="@_institutionalDashboard" />

                    <ReportSpecificArticleBlocks Dashboard="@_institutionalDashboard"
                                                 ScopeLabel="@InstitutionalScopeLabel"
                                                 PediIiitScopeLabel="@PediIiitScopeLabel"
                                                 TddTotalScopeLabel="@TddTotalScopeLabel" />

                    <ReportWorkflowDetailBlock Dashboard="@_institutionalDashboard" />
                </section>
            </section>
        }
        else if (_institutionalReportTab == "participation")
        {
            <section class="reports-dw-content-shell">
                <ReportParticipationPanel Dashboard="@_institutionalDashboard"
                                          ParticipationScopeLabel="@ParticipationScopeLabel" />
            </section>
        }
        else if (_institutionalReportTab == "dashboard")
        {
            <section class="reports-dw-content-shell">
                <ReportUniversalDashboardPanel Dashboard="@_institutionalDashboard"
                                               ScopeLabel="@InstitutionalScopeLabel" />
            </section>
        }
        else
        {
            <section class="reports-dw-content-shell">
                @if (!string.IsNullOrWhiteSpace(_authorReportingError))
                {
                    <div class="@(_authorDashboardUsingFallback ? "reports-dw-info-card" : "reports-dw-error-card")">
                        <i class="bi @(_authorDashboardUsingFallback ? "bi-info-circle" : "bi-exclamation-triangle")"></i>
                        <div>
                            <strong>@(_authorDashboardUsingFallback ? "Resumen autoral disponible" : "No pude cargar autores")</strong>
                            <span>@_authorReportingError</span>
                        </div>
                    </div>
                }

                <ReportAuthorAnalyticsPanel Dashboard="@_authorReportingDashboard"
                                            IsBusy="@_isLoadingAuthorReporting"
                                            IsFallbackSummary="@_authorDashboardUsingFallback"
                                            ScopeLabel="@InstitutionalScopeLabel" />
            </section>
        }
    }

    <ReportPdfComposerModal @key="_pdfComposerRenderKey"
                            Visible="@_showPdfComposer"
                            Selection="@_pdfComposerSelection"
                            IsGeneratingPreview="@_pdfComposerState.IsGeneratingPreview"
                            CanDownload="@CanDownloadPdf"
                            IsPreviewCurrent="@IsPdfPreviewCurrent"
                            PreviewBase64="@_pdfComposerState.PreviewBase64"
                            PreviewError="@_pdfComposerState.PreviewError"
                            GeneratedAtLabel="@_pdfComposerState.GeneratedAtLabel"
                            OnClose="ClosePdfComposer"
                            OnGeneratePreview="GeneratePdfPreviewAsync"
                            OnDownload="DownloadPdfAsync"
                            OnSelectionChanged="HandlePdfSelectionChanged" />

</div>
