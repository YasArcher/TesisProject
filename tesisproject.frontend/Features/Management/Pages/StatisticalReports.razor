@page "/management/statisticalreports"
@using tesisproject.frontend.Services.Interfaces
@using tesisproject.shared.DTOs.Reports
@inject IInsightsService Insights
@inject IApiClient ApiClient
<PageTitle>Reportes estadísticos</PageTitle>

<div class="flex flex-col gap-4 h-full">

    <!-- Título + descripción -->
    <div class="flex flex-col gap-1">
        <h1 class="text-2xl font-semibold text-slate-800">
            Reportes estadísticos de artículos
        </h1>
        <p class="text-sm text-slate-500">
            Visualiza indicadores clave, distribución por año, área de conocimiento y líneas de investigación.
        </p>
    </div>


    <!-- Sección de filtros (horizontal) -->
    <div class="bg-white/90 shadow-sm rounded-xl border border-slate-200 px-4 py-3 flex flex-wrap items-end gap-4">
        <div class="flex flex-col">
            <label class="text-xs font-semibold text-slate-500 uppercase tracking-wide">
                Año mínimo
            </label>
            <input type="number"
                   class="mt-1 rounded-lg border border-slate-300 px-3 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-[#7A1E19]/60 focus:border-[#7A1E19]"
                   @bind="_filterMinYear"
                   @bind:event="oninput" />
        </div>

        <div class="flex flex-col">
            <label class="text-xs font-semibold text-slate-500 uppercase tracking-wide">
                Año máximo
            </label>
            <input type="number"
                   class="mt-1 rounded-lg border border-slate-300 px-3 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-[#7A1E19]/60 focus:border-[#7A1E19]"
                   @bind="_filterMaxYear"
                   @bind:event="oninput" />
        </div>

        <div class="ml-auto flex items-center gap-2">
            <a class="inline-flex items-center gap-2 rounded-lg bg-emerald-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-emerald-700 disabled:opacity-60"
               href="@GetExportPdfUrl()"
               target="_blank">
                <span class="material-icons text-sm">picture_as_pdf</span>
                Exportar reporte (PDF)
            </a>

            <button class="inline-flex items-center gap-2 rounded-lg bg-slate-700 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-slate-800 disabled:opacity-60"
                    @onclick="RunEtlAndReload"
                    disabled="@_isLoading">
                <span class="material-icons text-sm">sync</span>
                Actualizar datos (ETL)
            </button>

            <button class="inline-flex items-center gap-2 rounded-lg bg-[#7A1E19] px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-[#681813] disabled:opacity-60"
                    @onclick="ApplyFilters"
                    disabled="@_isLoading">
                <span class="material-icons text-sm">filter_alt</span>
                Aplicar filtros
            </button>
        </div>

    </div>

    <!-- Sección de KPIs -->
    <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4">
        <!-- Total artículos -->
        <div class="bg-white/90 border border-slate-200 rounded-xl shadow-sm px-4 py-3 flex flex-col gap-1">
            <span class="text-xs font-semibold text-slate-500 uppercase tracking-wide">Total de artículos</span>
            <span class="text-2xl font-bold text-slate-800">
                @_kpis?.TotalArticles ?? 0
            </span>
            <span class="text-xs text-slate-400">
                Registrados en el sistema
            </span>
        </div>

        <!-- Publicados este año -->
        <div class="bg-white/90 border border-slate-200 rounded-xl shadow-sm px-4 py-3 flex flex-col gap-1">
            <span class="text-xs font-semibold text-slate-500 uppercase tracking-wide">Publicados este año</span>
            <span class="text-2xl font-bold text-slate-800">
                @_kpis?.PublishedThisYear ?? 0
            </span>
            <span class="text-xs text-slate-400">
                Según la fecha de publicación
            </span>
        </div>

        <!-- Q1 + Q2 -->
        <div class="bg-white/90 border border-slate-200 rounded-xl shadow-sm px-4 py-3 flex flex-col gap-1">
            <span class="text-xs font-semibold text-slate-500 uppercase tracking-wide">Artículos Q1 + Q2</span>
            <span class="text-2xl font-bold text-slate-800">
                @_kpis?.Q1Q2Count ?? 0
            </span>
            <span class="text-xs text-slate-400">
                Según métricas del venue
            </span>
        </div>

        <!-- Open Access / Indexados -->
        <div class="bg-white/90 border border-slate-200 rounded-xl shadow-sm px-4 py-3 flex flex-col gap-1">
            <span class="text-xs font-semibold text-slate-500 uppercase tracking-wide">Open Access / Scopus</span>
            <span class="text-sm font-semibold text-slate-800">
                OA: @_kpis?.OpenAccessCount ?? 0
            </span>
            <span class="text-xs text-slate-500">
                Indexados en Scopus: @_kpis?.IndexedInScopusCount ?? 0
            </span>
        </div>
    </div>

    <!-- Contenido principal: "gráficas" / tablas -->
    <div class="flex-1 flex flex-col gap-4 overflow-y-auto pb-4">

        @if (_isLoading)
        {
            <div class="flex items-center justify-center py-16 text-slate-500 text-sm">
                Cargando datos de reportería...
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="bg-red-50 border border-red-200 text-red-700 text-sm rounded-lg px-4 py-3">
                @_errorMessage
            </div>
        }
        else
        {
            <!-- Artículos por año -->
            <section class="bg-white/90 border border-slate-200 rounded-xl shadow-sm px-4 py-4">
                <div class="flex items-center justify-between mb-3">
                    <div>
                        <h2 class="text-base font-semibold text-slate-800">Distribución por año</h2>
                        <p class="text-xs text-slate-500">
                            Artículos creados en el sistema por año (según filtros aplicados).
                        </p>
                    </div>
                </div>

                @if (_filteredByYear.Count == 0)
                {
                    <p class="text-xs text-slate-400">No hay datos para el rango de años seleccionado.</p>
                }
                else
                {
                    <!-- Mini gráfica de barras -->
                    <div class="space-y-2 mb-4">
                        @foreach (var item in _filteredByYear)
                        {
                            <div class="flex items-center gap-2">
                                <span class="w-16 text-xs text-slate-500">@item.Year</span>
                                <div class="flex-1 bg-slate-100 rounded-full h-3 overflow-hidden">
                                    <div class="h-3 rounded-full bg-[#7A1E19]"
                                         style="width:@GetYearBarWidth(item)"></div>
                                </div>
                                <span class="w-10 text-xs text-slate-700 text-right">@item.Count</span>
                            </div>
                        }
                    </div>

                    <div class="overflow-x-auto">
                        <table class="min-w-full text-sm">
                            <!-- (deja aquí tu tabla tal como ya la tienes) -->
                        </table>
                    </div>
                }

            </section>

            <!-- Artículos por área de conocimiento -->
            <section class="bg-white/90 border border-slate-200 rounded-xl shadow-sm px-4 py-4">
                <div class="flex items-center justify-between mb-3">
                    <div>
                        <h2 class="text-base font-semibold text-slate-800">Distribución por área de conocimiento</h2>
                        <p class="text-xs text-slate-500">
                            Conteo de artículos por área amplia, específica y detallada.
                        </p>
                    </div>
                </div>

                @if (_byField.Count == 0)
                {
                    <p class="text-xs text-slate-400">No hay datos de áreas de conocimiento disponibles.</p>
                }
                else
                {
                    <div class="overflow-x-auto max-h-80">
                        <table class="min-w-full text-sm">
                            <thead class="border-b border-slate-200 sticky top-0 bg-white">
                                <tr class="text-left text-xs font-semibold text-slate-500 uppercase">
                                    <th class="py-2 pr-4">Área amplia</th>
                                    <th class="py-2 pr-4">Área específica</th>
                                    <th class="py-2 pr-4">Área detallada</th>
                                    <th class="py-2 pr-4 text-right">Artículos</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in _byField)
                                {
                                    <tr class="border-b border-slate-100 last:border-b-0">
                                        <td class="py-1.5 pr-4 text-slate-700">@item.BroadFieldName</td>
                                        <td class="py-1.5 pr-4 text-slate-700">@item.SpecificFieldName</td>
                                        <td class="py-1.5 pr-4 text-slate-700">@item.DetailedFieldName</td>
                                        <td class="py-1.5 pr-4 text-right font-semibold text-slate-800">@item.Count</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>

            <!-- Artículos por línea de investigación -->
            <section class="bg-white/90 border border-slate-200 rounded-xl shadow-sm px-4 py-4">
                <div class="flex items-center justify-between mb-3">
                    <div>
                        <h2 class="text-base font-semibold text-slate-800">Distribución por línea de investigación</h2>
                        <p class="text-xs text-slate-500">
                            Conteo de artículos asociados a cada línea de investigación de la DIDE.
                        </p>
                    </div>
                </div>

                @if (_byResearchLine.Count == 0)
                {
                    <p class="text-xs text-slate-400">No hay datos de líneas de investigación disponibles.</p>
                }
                else
                {
                    <div class="overflow-x-auto">
                        <table class="min-w-full text-sm">
                            <thead class="border-b border-slate-200">
                                <tr class="text-left text-xs font-semibold text-slate-500 uppercase">
                                    <th class="py-2 pr-4">Línea de investigación</th>
                                    <th class="py-2 pr-4 text-right">Artículos</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in _byResearchLine)
                                {
                                    <tr class="border-b border-slate-100 last:border-b-0">
                                        <td class="py-1.5 pr-4 text-slate-700">@item.ResearchLineName</td>
                                        <td class="py-1.5 pr-4 text-right font-semibold text-slate-800">@item.Count</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>
        }
    </div>
</div>

@code {
    private bool _isLoading = true;
    private string? _errorMessage;

    private ArticlesKpiSummaryDto? _kpis;
    private List<ArticlesByYearDto> _allByYear = new();
    private List<ArticlesByYearDto> _filteredByYear = new();
    private List<ArticlesByFieldDto> _byField = new();
    private List<ArticlesByResearchLineDto> _byResearchLine = new();

    // Filtros
    private int? _filterMinYear;
    private int? _filterMaxYear;
    private int _maxYearCount;

    private string GetYearBarWidth(ArticlesByYearDto item)
    {
        if (_maxYearCount <= 0)
            return "0%";

        var percent = (int)Math.Round(item.Count * 100.0 / _maxYearCount);
        return $"{percent}%";
    }
    private string GetExportPdfUrl()
    {
        var parts = new List<string>();

        if (_filterMinYear.HasValue)
            parts.Add($"minYear={_filterMinYear.Value}");

        if (_filterMaxYear.HasValue)
            parts.Add($"maxYear={_filterMaxYear.Value}");

        var query = parts.Count > 0 ? "?" + string.Join("&", parts) : string.Empty;

        // Ruta relativa al backend
        return $"api/reports/articles/statistics/pdf{query}";
    }
    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            // Llamamos a todos los endpoints de reportería
            _kpis = await Insights.GetArticlesKpiSummaryAsync();
            _allByYear = await Insights.GetArticlesByYearAsync();
            _byField = await Insights.GetArticlesByFieldAsync();
            _byResearchLine = await Insights.GetArticlesByResearchLineAsync();

            // Valores iniciales para filtros de año (mínimo y máximo detectados)
            if (_allByYear.Count > 0)
            {
                var min = _allByYear.Min(x => x.Year);
                var max = _allByYear.Max(x => x.Year);
                _filterMinYear = min;
                _filterMaxYear = max;
            }

            ApplyFilters();
        }
        catch (Exception ex)
        {
            _errorMessage = "Ocurrió un error al cargar los datos de reportería. " +
                            "Por favor, verifica la conexión con el servidor o ejecuta primero el ETL.";
            Console.Error.WriteLine(ex);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void ApplyFilters()
    {
        if (_allByYear.Count == 0)
        {
            _filteredByYear = new List<ArticlesByYearDto>();
            _maxYearCount = 0;
            return;
        }

        var minYear = _filterMinYear ?? _allByYear.Min(x => x.Year);
        var maxYear = _filterMaxYear ?? _allByYear.Max(x => x.Year);

        if (minYear > maxYear)
        {
            var tmp = minYear;
            minYear = maxYear;
            maxYear = tmp;
        }

        _filteredByYear = _allByYear
            .Where(x => x.Year >= minYear && x.Year <= maxYear)
            .OrderBy(x => x.Year)
            .ToList();

        _maxYearCount = _filteredByYear.Count > 0
            ? _filteredByYear.Max(x => x.Count)
            : 0;
    }

    private async Task RunEtlAndReload()
    {
        _isLoading = true;
        _errorMessage = null;
        StateHasChanged();
        try
        {
            // Ejecuta el ETL completo en el backend
            await ApiClient.PostAsync<object, object>(
                "api/bi/etl/full",
                new { });

            // Vuelve a cargar los datos del DW
            await OnInitializedAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = "No se pudo ejecutar el ETL desde la interfaz. " +
                            "Verifica el backend o consulta al administrador.";
            Console.Error.WriteLine(ex);
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

}
