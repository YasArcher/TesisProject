    private ArticleParticipantAggregateDto BuildParticipantRequest(DynamicParticipantState participant)
    {
        var dto = new ArticleParticipantAggregateDto
        {
            Index = participant.Index,
            DynamicFields = BuildDynamicValues(participant.Sections)
        };

        foreach (var field in participant.Sections.SelectMany(x => x.Fields).Where(x => !x.Definition.IsDynamic))
        {
            switch (field.Definition.FieldKey)
            {
                case "Index": dto.Index = field.IntValue ?? dto.Index; break;
                case "Identificacion": dto.Identificacion = field.TextValue; break;
                case "Nombre": dto.Nombre = field.TextValue ?? string.Empty; break;
                case "Participacion": dto.Participacion = field.TextValue; break;
                case "ParticipantType": dto.ParticipantType = string.IsNullOrWhiteSpace(field.OptionValue) ? field.TextValue : field.OptionValue; break;
                case "InstitutionalPersonId": dto.InstitutionalPersonId = field.CatalogValue ?? field.IntValue; break;
                case "IsPrimaryAuthor": dto.IsPrimaryAuthor = field.BoolValue ?? false; break;
                case "Email": dto.Email = field.TextValue; break;
                case "Orcid": dto.Orcid = field.TextValue; break;
                case "Affiliation": dto.Affiliation = field.TextValue; break;
                case "ExternalAuthorId": dto.ExternalAuthorId = field.TextValue; break;
            }
        }

        return dto;
    }

    private static List<DynamicFieldValueInputDto> BuildDynamicValues(List<DynamicSectionState> sections)
    {
        return sections
            .SelectMany(x => x.Fields)
            .Where(x => x.Definition.IsDynamic && HasValue(x))
            .Select(field => new DynamicFieldValueInputDto
            {
                FieldId = field.Definition.FieldId,
                FieldKey = field.Definition.FieldKey,
                ValueString = !string.IsNullOrWhiteSpace(field.OptionValue) ? field.OptionValue : field.TextValue,
                ValueInt = field.CatalogValue ?? field.IntValue,
                ValueDecimal = field.DecimalValue,
                ValueDate = field.DateValue,
                ValueBit = field.BoolValue,
                ValueJson = field.JsonValue
            })
            .ToList();
    }

    private string? ValidateForm()
    {
        var articleValidation = ValidateScope(ArticleSections, "artículo");
        if (!string.IsNullOrWhiteSpace(articleValidation)) return articleValidation;
        if (Participants.Count == 0) return "Debe registrar al menos un participante.";

        foreach (var participant in Participants)
        {
            var validation = ValidateScope(participant.Sections, $"participante {participant.Index}");
            if (!string.IsNullOrWhiteSpace(validation)) return validation;
        }

        return null;
    }

    private static string? ValidateScope(List<DynamicSectionState> sections, string scopeLabel)
    {
        foreach (var field in sections.SelectMany(x => x.Fields).Where(x => x.Definition.IsRequired))
        {
            if (!HasValue(field))
            {
                return $"El campo requerido '{field.Definition.FieldLabel}' no fue informado para {scopeLabel}.";
            }
        }

        return null;
    }
    private void AddParticipant()
    {
        if (ParticipantForm is null) return;

        var participant = new DynamicParticipantState
        {
            Index = Participants.Count + 1,
            Sections = BuildSections(ParticipantForm)
        };

        foreach (var field in participant.Sections.SelectMany(x => x.Fields).Where(x => x.Definition.FieldKey == "Index"))
        {
            field.IntValue = participant.Index;
        }

        Participants.Add(participant);
        _ = LoadCatalogsAsync(participant.Sections);
    }

    private void RemoveParticipant(int index)
    {
        var participant = Participants.FirstOrDefault(x => x.Index == index);
        if (participant is null) return;

        Participants.Remove(participant);
        for (var i = 0; i < Participants.Count; i++)
        {
            Participants[i].Index = i + 1;
            foreach (var field in Participants[i].Sections.SelectMany(x => x.Fields).Where(x => x.Definition.FieldKey == "Index"))
            {
                field.IntValue = Participants[i].Index;
            }
        }
    }

