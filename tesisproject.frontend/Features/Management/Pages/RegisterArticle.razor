@page "/articulos/registrar"
@page "/articulos/editar/{ArticleId:int}"

@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@using tesisproject.frontend.Models.Articles
@using tesisproject.frontend.Utils
@using tesisproject.shared.DTOs.Catalogs
@using tesisproject.frontend.Services.Interfaces
@using tesisproject.frontend.SharedUI.Articles

@inject IArticlesClient ArticlesService
@inject IVenuesClient VenuesService
@inject ICatalogsService CatalogService
@inject NavigationManager NavManager
@inject IJSRuntime JS

<PageTitle>@Title</PageTitle>

<div class="min-h-[calc(100vh-80px)] bg-[#f2f2f2]">
    <div class="mx-auto max-w-[1400px] px-4 pb-10 pt-4">

        <!-- HERO / ENCABEZADO SUPERIOR -->
        <div class="mb-6 rounded-3xl border border-slate-200/80 bg-gradient-to-r from-[#1a2b2b] via-[#4d1a1a] to-[#800909] px-6 py-6 shadow-lg shadow-slate-400/60">
            <!-- Breadcrumb -->
            <nav class="mb-3 flex flex-wrap items-center gap-2 text-xs text-white/80">
                <a href="/" class="inline-flex items-center gap-1 hover:text-white transition-colors">
                    <i class="bi bi-house"></i>
                    <span class="hidden sm:inline">Inicio</span>
                </a>
                <span class="text-white/50">/</span>
                <a href="/articulos/listado" class="hover:text-white transition-colors">
                    Artículos
                </a>
                <span class="text-white/50">/</span>
                <span class="font-medium text-white">
                    @(ArticleId > 0 ? "Editar" : "Registrar")
                </span>
            </nav>

            <!-- Título + acciones -->
            <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
                <!-- Título + descripción -->
                <div class="flex flex-1 flex-col gap-2">
                    <div class="flex items-center gap-3">
                        <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-white/15 shadow-sm">
                            <i class="bi @(ArticleId > 0 ? "bi-pencil-square" : "bi-file-earmark-plus") text-2xl text-white"></i>
                        </div>
                        <div>
                            <h1 class="text-2xl md:text-3xl font-extrabold tracking-tight text-white">
                                @Title
                            </h1>
                            <p class="mt-1 text-xs md:text-sm text-white/80 max-w-xl">
                                @(ArticleId > 0
                                    ? "Modifica los datos del artículo existente y actualiza su información académica."
                                    : "Completa los datos clave del artículo científico en las distintas pestañas del formulario.")
                            </p>
                        </div>
                    </div>

                    <div class="mt-2 flex flex-wrap items-center gap-2 text-[11px] text-white/80">
                        <span class="inline-flex items-center gap-1 rounded-full bg-black/20 px-3 py-1 backdrop-blur-sm">
                            <i class="bi bi-journal-text text-[13px]"></i>
                            <span class="uppercase tracking-wide">
                                @(ArticleId > 0 ? "Edición de registro existente" : "Nuevo registro")
                            </span>
                        </span>

                        @if (Article.Year.HasValue)
                        {
                            <span class="inline-flex items-center gap-1 rounded-full bg-white/10 px-3 py-1">
                                <i class="bi bi-calendar-event"></i>
                                Año de publicación: <strong>@Article.Year</strong>
                            </span>
                        }

                        @if (Article.Participants?.Count > 0)
                        {
                            <span class="inline-flex items-center gap-1 rounded-full bg-white/10 px-3 py-1">
                                <i class="bi bi-people"></i>
                                Autores: <strong>@Article.Participants.Count</strong>
                            </span>
                        }
                    </div>
                </div>

                <!-- Acciones rápidas -->
                <div class="flex flex-wrap justify-end gap-3">
                    <button type="button"
                            @onclick="Cancel"
                            class="inline-flex items-center gap-2 rounded-xl border border-white/40 bg-white/10 px-4 py-2 text-xs md:text-sm font-medium text-white shadow-sm backdrop-blur-sm transition hover:bg-white/20">
                        <i class="bi bi-arrow-left"></i>
                        Volver al listado
                    </button>

                    @if (ArticleId > 0)
                    {
                        <button type="button"
                                onclick="location.reload()"
                                class="inline-flex items-center gap-2 rounded-xl border border-white/40 bg-white/10 px-4 py-2 text-xs md:text-sm font-medium text-white shadow-sm backdrop-blur-sm transition hover:bg-white/20">
                            <i class="bi bi-arrow-clockwise"></i>
                            Recargar
                        </button>
                    }
                </div>
            </div>
        </div>

        <!-- CONTENIDO PRINCIPAL -->
        <div class="grid grid-cols-1 gap-6 xl:grid-cols-3">
            <!-- SECCIÓN FORMULARIO -->
            <div class="xl:col-span-2 space-y-6">

                <!-- Mensajes -->
                @if (!string.IsNullOrEmpty(successMessage))
                {
                    <div class="flex items-start gap-3 rounded-2xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-900 shadow-sm">
                        <i class="bi bi-check-circle-fill mt-0.5 text-lg text-emerald-500"></i>
                        <div class="flex-1">@successMessage</div>
                        <button type="button"
                                @onclick="() => successMessage = string.Empty"
                                class="text-emerald-600 hover:text-emerald-800">
                            <i class="bi bi-x-lg text-xs"></i>
                        </button>
                    </div>
                }

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="flex items-start gap-3 rounded-2xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-900 shadow-sm">
                        <i class="bi bi-exclamation-triangle-fill mt-0.5 text-lg text-rose-500"></i>
                        <div class="flex-1">@errorMessage</div>
                        <button type="button"
                                @onclick="() => errorMessage = string.Empty"
                                class="text-rose-600 hover:text-rose-800">
                            <i class="bi bi-x-lg text-xs"></i>
                        </button>
                    </div>
                }

                <EditForm Model="Article"
                          OnValidSubmit="HandleValidSubmit"
                          OnInvalidSubmit="HandleInvalidSubmit">
                    <DataAnnotationsValidator />

                    <!-- Resumen de validación global -->
                    <ValidationSummary class="mb-3 text-xs text-rose-700" />

                    <!-- PESTAÑAS DEL FORMULARIO -->
                    <ArticleFormTabs ActiveTab="_activeTab"
                                     ActiveTabChanged="SetTab" />

                    <div class="space-y-6">
                        @if (_activeTab == ArticleFormTab.General)
                        {
                            <ArticleFormSectionGeneral Article="Article"
                                                       Projects="Projects" />
                        }

                        @if (_activeTab == ArticleFormTab.Academic)
                        {
                            <!-- SECCIÓN ACADÉMICA DIRECTA -->
                            <section class="rounded-3xl border border-slate-200/80 bg-white/95 shadow-sm">
                                <header class="flex items-center gap-3 border-b border-slate-200/70 bg-gradient-to-r from-[#f9fafb] via-[#eef2f7] to-white px-5 py-3">
                                    <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-[#1a2b2b]/10 text-[#1a2b2b]">
                                        <i class="bi bi-diagram-3"></i>
                                    </div>
                                    <div>
                                        <h2 class="text-sm md:text-base font-semibold text-slate-900">
                                            Clasificación académica
                                        </h2>
                                        <p class="text-xs text-slate-500">
                                            Período académico, estado y líneas de investigación asociadas.
                                        </p>
                                    </div>
                                </header>

                                <div class="space-y-6 px-5 py-5">
                                    <!-- Fila 1: período, estado, línea -->
                                    <div class="grid grid-cols-1 gap-5 md:grid-cols-3">
                                        <!-- Período académico -->
                                        <div>
                                            <label class="mb-1.5 block text-sm font-medium text-slate-800">
                                                Período académico
                                            </label>
                                            <InputSelect TValue="int?" @bind-Value="Article.AcademicTermId"
                                                         class="w-full rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm shadow-sm outline-none transition focus:border-[#800909] focus:ring-2 focus:ring-[#800909]/20">
                                                <option value="">Seleccionar período…</option>
                                                @foreach (var term in AcademicTerms)
                                                {
                                                    <option value="@term.Id">@term.Name</option>
                                                }
                                            </InputSelect>
                                        </div>

                                        <!-- Estado de publicación (byte?) -->
                                        <div>
                                            <label class="mb-1.5 block text-sm font-medium text-slate-800">
                                                Estado de publicación
                                            </label>
                                            <InputSelect TValue="byte?" @bind-Value="Article.PublicationStatusId"
                                                         class="w-full rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm shadow-sm outline-none transition focus:border-[#800909] focus:ring-2 focus:ring-[#800909]/20">
                                                <option value="">Seleccionar estado…</option>
                                                @foreach (var status in PublicationStatuses)
                                                {
                                                    <option value="@status.Id">@status.Name</option>
                                                }
                                            </InputSelect>
                                        </div>

                                        <!-- Línea de investigación -->
                                        <div>
                                            <label class="mb-1.5 block text-sm font-medium text-slate-800">
                                                Línea de investigación
                                            </label>
                                            <InputSelect TValue="int?" @bind-Value="Article.ResearchLineId"
                                                         class="w-full rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm shadow-sm outline-none transition focus:border-[#800909] focus:ring-2 focus:ring-[#800909]/20">
                                                <option value="">Seleccionar línea…</option>
                                                @foreach (var line in ResearchLines)
                                                {
                                                    <option value="@line.Id">@line.Name</option>
                                                }
                                            </InputSelect>
                                        </div>
                                    </div>

                                    <!-- Clasificación OCDE -->
                                    <div class="border-t border-slate-200 pt-5">
                                        <h3 class="mb-3 text-sm font-semibold text-slate-900">
                                            Clasificación OCDE
                                        </h3>
                                        <div class="grid grid-cols-1 gap-5 md:grid-cols-3">
                                            <!-- CAMPO AMPLIO -->
                                            <div>
                                                <label class="mb-1.5 block text-sm font-medium text-slate-800">
                                                    Campo amplio
                                                </label>
                                                <InputSelect TValue="int?"
                                                             @bind-Value="Article.BroadFieldId"
                                                             @bind-Value:after="OnBroadFieldChanged"
                                                             class="w-full rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm shadow-sm outline-none transition focus:border-[#800909] focus:ring-2 focus:ring-[#800909]/20">
                                                    <option value="">Seleccionar campo amplio…</option>
                                                    @foreach (var field in BroadFields)
                                                    {
                                                        <option value="@field.Id">@field.Name</option>
                                                    }
                                                </InputSelect>
                                            </div>

                                            <!-- CAMPO ESPECÍFICO -->
                                            <div>
                                                <label class="mb-1.5 block text-sm font-medium text-slate-800">
                                                    Campo específico
                                                </label>
                                                <InputSelect TValue="int?"
                                                             @bind-Value="Article.SpecificFieldId"
                                                             @bind-Value:after="OnSpecificFieldChanged"
                                                             disabled="@(Article.BroadFieldId == null)"
                                                             class="w-full rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm shadow-sm outline-none transition disabled:cursor-not-allowed disabled:bg-slate-50 focus:border-[#800909] focus:ring-2 focus:ring-[#800909]/20">
                                                    <option value="">Seleccionar campo específico…</option>
                                                    @foreach (var field in SpecificFields)
                                                    {
                                                        <option value="@field.Id">@field.Name</option>
                                                    }
                                                </InputSelect>
                                            </div>

                                            <!-- CAMPO DETALLADO -->
                                            <div>
                                                <label class="mb-1.5 block text-sm font-medium text-slate-800">
                                                    Campo detallado
                                                </label>
                                                <InputSelect TValue="int?"
                                                             @bind-Value="Article.DetailedFieldId"
                                                             disabled="@(Article.SpecificFieldId == null)"
                                                             class="w-full rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm shadow-sm outline-none transition disabled:cursor-not-allowed disabled:bg-slate-50 focus:border-[#800909] focus:ring-2 focus:ring-[#800909]/20">
                                                    <option value="">Seleccionar campo detallado…</option>
                                                    @foreach (var field in DetailedFields)
                                                    {
                                                        <option value="@field.Id">@field.Name</option>
                                                    }
                                                </InputSelect>
                                            </div>
                                        </div>

                                        <!-- Debug rápido -->
                                        <div class="mt-3 text-[11px] text-slate-500">
                                            [DEBUG PADRE] BroadFieldId=@(Article.BroadFieldId?.ToString() ?? "null")
                                            | SpecificFields=@SpecificFields.Count
                                            | SpecificFieldId=@(Article.SpecificFieldId?.ToString() ?? "null")
                                            | DetailedFields=@DetailedFields.Count
                                        </div>
                                    </div>
                                </div>
                            </section>
                        }

                        @if (_activeTab == ArticleFormTab.Journal)
                        {
                            <ArticleFormSectionJournal Article="Article"
                                                       IndexingSources="IndexingSources" />
                        }

                        @if (_activeTab == ArticleFormTab.Participants)
                        {
                            <ArticleFormSectionParticipants Article="Article"
                                                            OnAddParticipant="AddParticipant"
                                                            OnRemoveParticipant="RemoveParticipant" />
                        }

                        <!-- Botones de acción -->
                        <section class="rounded-3xl border border-slate-200/80 bg-white/95 px-5 py-4 shadow-sm">
                            <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                                <button type="button"
                                        @onclick="Cancel"
                                        class="inline-flex items-center gap-2 rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 shadow-sm transition hover:bg-slate-50">
                                    <i class="bi bi-arrow-left"></i>
                                    Cancelar
                                </button>

                                <button type="submit"
                                        disabled="@isLoading"
                                        class="inline-flex items-center justify-center gap-2 rounded-xl bg-[#800909] px-6 py-2.5 text-sm font-semibold text-white shadow-md transition hover:bg-[#661111] disabled:cursor-not-allowed disabled:opacity-60">
                                    @if (isLoading)
                                    {
                                        <i class="bi bi-arrow-repeat animate-spin"></i>
                                        <span>Guardando…</span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-check-lg"></i>
                                        <span>@(ArticleId > 0 ? "Actualizar artículo" : "Registrar artículo")</span>
                                    }
                                </button>
                            </div>
                        </section>
                    </div>
                </EditForm>
            </div>

            <!-- SECCIÓN RESUMEN / VISTA PREVIA -->
            <aside class="xl:col-span-1">
                <div class="sticky top-6 space-y-5">
                    <!-- Resumen del artículo -->
                    <section class="rounded-3xl border border-slate-200/80 bg-white/95 shadow-sm">
                        <header class="bg-gradient-to-r from-[#348e91] via-[#1c5052] to-[#0a0c0d] px-5 py-3">
                            <h3 class="flex items-center gap-2 text-sm font-semibold text-white">
                                <i class="bi bi-card-checklist"></i>
                                Resumen del artículo
                            </h3>
                        </header>
                        <div class="space-y-3 px-5 py-4">
                            <div class="flex items-center justify-between rounded-xl bg-slate-50 px-3 py-2 text-xs">
                                <span class="font-medium text-slate-700">Estado del formulario</span>
                                <span class="rounded-full bg-emerald-100 px-3 py-0.5 text-[11px] font-semibold text-emerald-800">
                                    @(ArticleId > 0 ? "Edición" : "Nuevo registro")
                                </span>
                            </div>

                            <div class="grid grid-cols-2 gap-2 text-xs">
                                <div class="rounded-xl bg-slate-50 px-3 py-2">
                                    <span class="block text-[11px] text-slate-500">Participantes</span>
                                    <span class="text-base font-semibold text-[#800909]">@Article.Participants.Count</span>
                                </div>
                                <div class="rounded-xl bg-slate-50 px-3 py-2">
                                    <span class="block text-[11px] text-slate-500">Fuentes indexación</span>
                                    <span class="text-base font-semibold text-[#800909]">@Article.IndexingSourceIds.Count</span>
                                </div>
                            </div>

                            <div class="rounded-xl bg-slate-50 px-3 py-3 text-xs text-slate-600">
                                <p class="mb-1 font-medium text-slate-800">Progreso sugerido</p>
                                <ul class="space-y-0.5 list-disc list-inside">
                                    <li class="@(string.IsNullOrWhiteSpace(Article.Title) ? "text-amber-700" : "text-emerald-700")">
                                        Título del artículo
                                    </li>
                                    <li class="@(Article.Participants.Count < 3 || Article.Participants.Take(3).Any(p => string.IsNullOrWhiteSpace(p.Nombre)) ? "text-amber-700" : "text-emerald-700")">
                                        Mínimo 3 participantes con nombre
                                    </li>
                                    <li class="@(Article.AcademicTermId is null || Article.PublicationStatusId is null ? "text-amber-700" : "text-emerald-700")">
                                        Período y estado de publicación
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </section>

                    <!-- Vista previa -->
                    <section class="rounded-3xl border border-slate-200/80 bg-white/95 shadow-sm">
                        <header class="border-b border-slate-200 bg-gradient-to-r from-[#f2f2f2] via-[#e6f0f0] to-white px-5 py-3">
                            <h3 class="flex items-center gap-2 text-sm font-semibold text-slate-900">
                                <i class="bi bi-eye"></i>
                                Vista previa
                            </h3>
                        </header>
                        <div class="article-preview px-5 py-4">
                            @if (string.IsNullOrEmpty(Article.Title))
                            {
                                <div class="flex flex-col items-center justify-center py-8 text-center text-slate-400">
                                    <i class="bi bi-file-text mb-3 text-4xl opacity-30"></i>
                                    <p class="text-xs">
                                        Completa la información básica para visualizar un resumen del artículo.
                                    </p>
                                </div>
                            }
                            else
                            {
                                <div class="space-y-4 text-sm">
                                    <div>
                                        <h4 class="mb-1 line-clamp-3 text-base font-semibold text-slate-900">
                                            @Article.Title
                                        </h4>
                                        @if (!string.IsNullOrEmpty(Article.VenueName))
                                        {
                                            <p class="flex items-center gap-1 text-xs text-slate-600">
                                                <i class="bi bi-journal"></i>
                                                @Article.VenueName
                                            </p>
                                        }
                                        @if (Article.Year.HasValue)
                                        {
                                            <p class="flex items-center gap-1 text-xs text-slate-600">
                                                <i class="bi bi-calendar"></i>
                                                Año: @Article.Year
                                            </p>
                                        }
                                        @if (!string.IsNullOrEmpty(Article.Doi))
                                        {
                                            <p class="flex items-center gap-1 text-xs text-slate-600">
                                                <i class="bi bi-link-45deg"></i>
                                                DOI: @Article.Doi
                                            </p>
                                        }
                                    </div>

                                    @if (Article.Participants.Any(p => !string.IsNullOrEmpty(p.Nombre)))
                                    {
                                        <div>
                                            <h5 class="mb-1 text-xs font-semibold text-slate-800">
                                                Autores
                                            </h5>
                                            <div class="flex flex-wrap gap-1.5">
                                                @foreach (var participant in Article.Participants.Take(3).Where(p => !string.IsNullOrEmpty(p.Nombre)))
                                                {
                                                    <span class="inline-flex items-center rounded-full bg-[#348e91]/10 px-2 py-0.5 text-[11px] font-medium text-[#1c5052]">
                                                        @participant.Nombre
                                                    </span>
                                                }
                                                @if (Article.Participants.Count > 3)
                                                {
                                                    <span class="inline-flex items-center rounded-full bg-slate-100 px-2 py-0.5 text-[11px] text-slate-600">
                                                        +@(Article.Participants.Count - 3) más
                                                    </span>
                                                }
                                            </div>
                                        </div>
                                    }

                                    <div>
                                        <h5 class="mb-1 text-xs font-semibold text-slate-800">
                                            Características
                                        </h5>
                                        <div class="flex flex-wrap gap-1.5">
                                            @if (Article.IsProjectResult)
                                            {
                                                <span class="inline-flex items-center rounded-full bg-emerald-100 px-2 py-0.5 text-[11px] font-medium text-emerald-800">
                                                    Proyecto
                                                </span>
                                            }
                                            @if (Article.HasInterculturalComponent)
                                            {
                                                <span class="inline-flex items-center rounded-full bg-amber-100 px-2 py-0.5 text-[11px] font-medium text-amber-800">
                                                    Intercultural
                                                </span>
                                            }
                                            @if (Article.IsOpenAccess)
                                            {
                                                <span class="inline-flex items-center rounded-full bg-purple-100 px-2 py-0.5 text-[11px] font-medium text-purple-800">
                                                    Open Access
                                                </span>
                                            }
                                            @if (!Article.IsProjectResult && !Article.HasInterculturalComponent && !Article.IsOpenAccess)
                                            {
                                                <span class="text-[11px] text-slate-500">
                                                    Sin características especiales marcadas.
                                                </span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </section>
                </div>
            </aside>
        </div>
    </div>
</div>

@code {
    private ArticleFormTab _activeTab = ArticleFormTab.General;

    private void SetTab(ArticleFormTab tab) => _activeTab = tab;

    [Parameter] public int ArticleId { get; set; }

    private ArticleViewModel Article { get; set; } = new();
    private bool isLoading = false;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;

    // Catálogos
    private List<CatalogItemDto> AcademicTerms { get; set; } = new();
    private List<CatalogItemDto> PublicationStatuses { get; set; } = new();
    private List<CatalogItemDto> ResearchLines { get; set; } = new();
    private List<CatalogItemDto> BroadFields { get; set; } = new();
    private List<CatalogItemDto> SpecificFields { get; set; } = new();
    private List<CatalogItemDto> DetailedFields { get; set; } = new();
    private List<CatalogItemDto> Projects { get; set; } = new();
    private List<CatalogItemDto> IndexingSources { get; set; } = new();
    private string Title => ArticleId > 0 ? "Editar artículo" : "Registrar nuevo artículo";

    protected override async Task OnInitializedAsync()
    {
        await LoadCatalogs();
        if (ArticleId > 0)
        {
            await LoadArticle();
        }
        else
        {
            // Inicializar con 3 participantes por defecto
            while (Article.Participants.Count < 3)
            {
                Article.Participants.Add(new ArticleParticipantVm { Index = Article.Participants.Count + 1 });
            }
        }
    }

    private async Task LoadCatalogs()
    {
        try
        {
            var academicTermsTask = CatalogService.GetAcademicTermsAsync();
            var publicationStatusesTask = CatalogService.GetPublicationStatusesAsync();
            var researchLinesTask = CatalogService.GetResearchLinesAsync();
            var broadFieldsTask = CatalogService.GetBroadFieldsAsync();
            var projectsTask = CatalogService.GetProjectsAsync();
            var indexingSourcesTask = CatalogService.GetIndexingSourcesAsync();

            await Task.WhenAll(
                academicTermsTask,
                publicationStatusesTask,
                researchLinesTask,
                broadFieldsTask,
                projectsTask,
                indexingSourcesTask
            );

            AcademicTerms = await academicTermsTask;
            PublicationStatuses = await publicationStatusesTask;
            ResearchLines = await researchLinesTask;
            BroadFields = await broadFieldsTask;
            Projects = await projectsTask;
            IndexingSources = await indexingSourcesTask;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error cargando catálogos: {ex.Message}";
        }
    }

    private async Task LoadArticle()
    {
        try
        {
            isLoading = true;
            var articleDto = await ArticlesService.GetByIdAsync(ArticleId);
            if (articleDto != null)
            {
                Article = ArticlesMapper.ToViewModel(articleDto);

                // Cargar campos específicos según el campo amplio ya guardado
                if (Article.BroadFieldId.HasValue)
                {
                    SpecificFields = await CatalogService.GetSpecificFieldsAsync(Article.BroadFieldId.Value);
                }
                else
                {
                    SpecificFields = new();
                }

                // Cargar campos detallados según el campo específico ya guardado
                if (Article.SpecificFieldId.HasValue)
                {
                    DetailedFields = await CatalogService.GetDetailedFieldsAsync(Article.SpecificFieldId.Value);
                }
                else
                {
                    DetailedFields = new();
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error cargando artículo: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleValidSubmit()
    {
        try
        {
            isLoading = true;
            errorMessage = string.Empty;
            successMessage = string.Empty;

            // Validar participantes requeridos
            var requiredParticipants = Article.Participants.Take(3);
            if (requiredParticipants.Any(p => string.IsNullOrWhiteSpace(p.Nombre)))
            {
                errorMessage = "Los primeros 3 participantes deben tener nombre completo.";
                isLoading = false;
                _activeTab = ArticleFormTab.Participants;
                return;
            }

            if (ArticleId > 0)
            {
                // 🔹 Aquí se hace el UPDATE
                await ArticlesService.UpdateAsync(ArticleId, Article.ToUpdateRequest());
                successMessage = "Artículo actualizado correctamente.";
            }
            else
            {
                var newId = await ArticlesService.CreateAsync(Article.ToCreateRequest());
                Article.Id = newId;
                successMessage = "Artículo registrado correctamente.";
            }

            await Task.Delay(2000);
            NavManager.NavigateTo("/articulos/listado");
        }
        catch (Exception ex)
        {
            errorMessage = $"Error guardando artículo: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void HandleInvalidSubmit(EditContext editContext)
    {
        isLoading = false;

        // Mensaje general arriba del formulario
        errorMessage = "Hay errores de validación en el formulario. Revisa los campos resaltados.";

        // (Opcional) Log rápido en consola para ver qué está fallando
        Console.WriteLine("[HandleInvalidSubmit] Errores de validación:");
        foreach (var msg in editContext.GetValidationMessages())
        {
            Console.WriteLine($" - {msg}");
        }
    }

    // 🔹 Se llama automáticamente DESPUÉS de cambiar Article.BroadFieldId
    private async Task OnBroadFieldChanged()
    {
        Console.WriteLine($"[BIND AFTER] OnBroadFieldChanged => BroadFieldId={Article.BroadFieldId}");

        var broadFieldId = Article.BroadFieldId;

        Article.SpecificFieldId = null;
        Article.DetailedFieldId = null;

        if (broadFieldId.HasValue)
        {
            SpecificFields = await CatalogService.GetSpecificFieldsAsync(broadFieldId.Value);
        }
        else
        {
            SpecificFields = new();
        }

        DetailedFields = new();
        StateHasChanged();
    }

    // 🔹 Se llama automáticamente DESPUÉS de cambiar Article.SpecificFieldId
    private async Task OnSpecificFieldChanged()
    {
        Console.WriteLine($"[BIND AFTER] OnSpecificFieldChanged => SpecificFieldId={Article.SpecificFieldId}");

        var specificFieldId = Article.SpecificFieldId;

        Article.DetailedFieldId = null;

        if (specificFieldId.HasValue)
        {
            DetailedFields = await CatalogService.GetDetailedFieldsAsync(specificFieldId.Value);
        }
        else
        {
            DetailedFields = new();
        }

        StateHasChanged();
    }

    private void AddParticipant()
    {
        Article.Participants.Add(new ArticleParticipantVm { Index = Article.Participants.Count + 1 });
        StateHasChanged();
    }

    private void RemoveParticipant(int index)
    {
        if (Article.Participants.Count > 3)
        {
            Article.Participants.RemoveAt(index);
            for (int i = 0; i < Article.Participants.Count; i++)
            {
                Article.Participants[i].Index = i + 1;
            }
            StateHasChanged();
        }
    }

    private void Cancel()
    {
        NavManager.NavigateTo("/articulos/listado");
    }
}
