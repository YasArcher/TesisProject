    private RenderFragment FieldFragment(DynamicFieldState field, List<DynamicSectionState> scope) => builder =>
    {
        var seq = 0;
        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "flex flex-col gap-1.5");
        builder.OpenElement(seq++, "label");
        builder.AddAttribute(seq++, "class", "text-sm font-semibold text-[#12343b]");
        builder.AddContent(seq++, field.Definition.FieldLabel);
        if (field.Definition.IsRequired) builder.AddMarkupContent(seq++, " <span class=\"text-rose-600\">*</span>");
        builder.CloseElement();

        if (NeedsCatalogItems(field))
        {
            builder.OpenElement(seq++, "select");
            builder.AddAttribute(seq++, "class", "w-full rounded-xl border border-[#c9d7db] bg-white px-3 py-2 text-sm shadow-sm outline-none");
            builder.AddAttribute(seq++, "value", BindConverter.FormatValue(field.CatalogValue));
            builder.AddAttribute(seq++, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, e => OnCatalogChangedAsync(field, scope, e)));
            builder.OpenElement(seq++, "option"); builder.AddAttribute(seq++, "value", ""); builder.AddContent(seq++, field.Definition.Placeholder ?? "Seleccionar..."); builder.CloseElement();
            foreach (var option in field.CatalogItems)
            {
                builder.OpenElement(seq++, "option"); builder.AddAttribute(seq++, "value", option.Id); builder.AddContent(seq++, option.Name); builder.CloseElement();
            }
            builder.CloseElement();
        }
        else if (HasStaticOptions(field))
        {
            builder.OpenElement(seq++, "select");
            builder.AddAttribute(seq++, "class", "w-full rounded-xl border border-[#c9d7db] bg-white px-3 py-2 text-sm shadow-sm outline-none");
            builder.AddAttribute(seq++, "value", BindConverter.FormatValue(field.OptionValue));
            builder.AddAttribute(seq++, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, e => field.OptionValue = e.Value?.ToString()));
            builder.OpenElement(seq++, "option"); builder.AddAttribute(seq++, "value", ""); builder.AddContent(seq++, field.Definition.Placeholder ?? "Seleccionar..."); builder.CloseElement();
            foreach (var option in field.Definition.Options.OrderBy(x => x.DisplayOrder))
            {
                builder.OpenElement(seq++, "option"); builder.AddAttribute(seq++, "value", option.OptionValue); builder.AddContent(seq++, option.OptionLabel); builder.CloseElement();
            }
            builder.CloseElement();
        }
        else if (IsBoolField(field))
        {
            builder.OpenElement(seq++, "label");
            builder.AddAttribute(seq++, "class", "inline-flex items-center gap-3 rounded-xl border border-[#d8e3e6] bg-[#f7fbfc] px-3 py-2.5 text-sm text-slate-700");
            builder.OpenElement(seq++, "input"); builder.AddAttribute(seq++, "type", "checkbox"); builder.AddAttribute(seq++, "checked", field.BoolValue ?? false); builder.AddAttribute(seq++, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, e => field.BoolValue = e.Value is bool current ? current : e.Value?.ToString() == "true")); builder.CloseElement();
            builder.AddContent(seq++, field.Definition.HelpText ?? "Marcar si aplica");
            builder.CloseElement();
        }
        else if (IsDateField(field))
        {
            builder.OpenElement(seq++, "input"); builder.AddAttribute(seq++, "type", "date"); builder.AddAttribute(seq++, "class", "w-full rounded-xl border border-[#c9d7db] bg-white px-3 py-2 text-sm shadow-sm"); builder.AddAttribute(seq++, "value", field.DateValue?.ToString("yyyy-MM-dd")); builder.AddAttribute(seq++, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, e => field.DateValue = DateTime.TryParse(e.Value?.ToString(), out var parsed) ? parsed : null)); builder.CloseElement();
        }
        else if (IsIntField(field))
        {
            builder.OpenElement(seq++, "input"); builder.AddAttribute(seq++, "type", "number"); builder.AddAttribute(seq++, "class", "w-full rounded-xl border border-[#c9d7db] bg-white px-3 py-2 text-sm shadow-sm"); builder.AddAttribute(seq++, "value", field.IntValue?.ToString()); builder.AddAttribute(seq++, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, e => field.IntValue = int.TryParse(e.Value?.ToString(), out var parsed) ? parsed : null)); builder.CloseElement();
        }
        else if (IsDecimalField(field))
        {
            builder.OpenElement(seq++, "input"); builder.AddAttribute(seq++, "type", "number"); builder.AddAttribute(seq++, "step", "0.01"); builder.AddAttribute(seq++, "class", "w-full rounded-xl border border-[#c9d7db] bg-white px-3 py-2 text-sm shadow-sm"); builder.AddAttribute(seq++, "value", field.DecimalValue?.ToString(System.Globalization.CultureInfo.InvariantCulture)); builder.AddAttribute(seq++, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, e => field.DecimalValue = decimal.TryParse(e.Value?.ToString(), out var parsed) ? parsed : null)); builder.CloseElement();
        }
        else
        {
            builder.OpenElement(seq++, "input"); builder.AddAttribute(seq++, "type", string.Equals(field.Definition.FieldKey, "Email", StringComparison.OrdinalIgnoreCase) ? "email" : "text"); builder.AddAttribute(seq++, "class", "w-full rounded-xl border border-[#c9d7db] bg-white px-3 py-2 text-sm shadow-sm"); builder.AddAttribute(seq++, "placeholder", field.Definition.Placeholder); if (field.Definition.MaxLength.HasValue) builder.AddAttribute(seq++, "maxlength", field.Definition.MaxLength.Value); builder.AddAttribute(seq++, "value", field.TextValue); builder.AddAttribute(seq++, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, e => field.TextValue = e.Value?.ToString())); builder.CloseElement();
        }

        if (!string.IsNullOrWhiteSpace(field.Definition.HelpText) && !IsBoolField(field))
        {
            builder.OpenElement(seq++, "div"); builder.AddAttribute(seq++, "class", "text-xs text-slate-500"); builder.AddContent(seq++, field.Definition.HelpText); builder.CloseElement();
        }

        builder.CloseElement();
    };

    private async Task OnCatalogChangedAsync(DynamicFieldState field, List<DynamicSectionState> scope, ChangeEventArgs e)
    {
        field.CatalogValue = int.TryParse(e.Value?.ToString(), out var parsed) ? parsed : null;
        await HandleDependenciesAsync(field, scope);
        StateHasChanged();
    }

    private async Task HandleDependenciesAsync(DynamicFieldState changedField, List<DynamicSectionState> scope)
    {
        var allFields = scope.SelectMany(x => x.Fields).ToList();
        if (changedField.Definition.FieldKey == "BroadFieldId")
        {
            var specific = allFields.FirstOrDefault(x => x.Definition.FieldKey == "SpecificFieldId");
            var detailed = allFields.FirstOrDefault(x => x.Definition.FieldKey == "DetailedFieldId");
            if (specific is not null)
            {
                specific.CatalogValue = null;
                specific.CatalogItems = changedField.CatalogValue.HasValue ? await FormConfigurationClient.GetCatalogItemsByFieldAsync(specific.Definition.FieldId, changedField.CatalogValue) : new List<CatalogItemDto>();
            }
            if (detailed is not null)
            {
                detailed.CatalogValue = null;
                detailed.CatalogItems = new List<CatalogItemDto>();
            }
        }
        else if (changedField.Definition.FieldKey == "SpecificFieldId")
        {
            var detailed = allFields.FirstOrDefault(x => x.Definition.FieldKey == "DetailedFieldId");
            if (detailed is not null)
            {
                detailed.CatalogValue = null;
                detailed.CatalogItems = changedField.CatalogValue.HasValue ? await FormConfigurationClient.GetCatalogItemsByFieldAsync(detailed.Definition.FieldId, changedField.CatalogValue) : new List<CatalogItemDto>();
            }
        }
    }
    private static bool HasValue(DynamicFieldState field)
    {
        if (NeedsCatalogItems(field)) return field.CatalogValue.HasValue;
        if (HasStaticOptions(field)) return !string.IsNullOrWhiteSpace(field.OptionValue);
        if (IsBoolField(field)) return field.BoolValue.HasValue;
        if (IsIntField(field)) return field.IntValue.HasValue;
        if (IsDecimalField(field)) return field.DecimalValue.HasValue;
        if (IsDateField(field)) return field.DateValue.HasValue;
        if (string.Equals(field.Definition.DataType, "json", StringComparison.OrdinalIgnoreCase)) return !string.IsNullOrWhiteSpace(field.JsonValue);
        return !string.IsNullOrWhiteSpace(field.TextValue);
    }

    private static bool IsVisibleField(DynamicFieldState field) => field.Definition.IsVisible && field.Definition.IsEditable;
    private static bool HasStaticOptions(DynamicFieldState field) => field.Definition.Options?.Count > 0;
    private static bool NeedsCatalogItems(DynamicFieldState field) => string.Equals(field.Definition.SourceType, "CatalogReference", StringComparison.OrdinalIgnoreCase) || string.Equals(field.Definition.DataType, "fk", StringComparison.OrdinalIgnoreCase);
    private static bool IsBoolField(DynamicFieldState field) => string.Equals(field.Definition.DataType, "bool", StringComparison.OrdinalIgnoreCase) || string.Equals(field.Definition.DataType, "bit", StringComparison.OrdinalIgnoreCase);
    private static bool IsIntField(DynamicFieldState field) => string.Equals(field.Definition.DataType, "int", StringComparison.OrdinalIgnoreCase);
    private static bool IsDecimalField(DynamicFieldState field) => string.Equals(field.Definition.DataType, "decimal", StringComparison.OrdinalIgnoreCase);
    private static bool IsDateField(DynamicFieldState field) => string.Equals(field.Definition.DataType, "date", StringComparison.OrdinalIgnoreCase) || string.Equals(field.Definition.DataType, "datetime", StringComparison.OrdinalIgnoreCase);
    private static bool IsDependentCatalogField(DynamicFieldState field) => field.Definition.FieldKey is "SpecificFieldId" or "DetailedFieldId";
    private static string GetFieldColumnClass(DynamicFieldState field) => field.Definition.ColumnSpan.GetValueOrDefault() >= 2 ? "md:col-span-2" : "md:col-span-1";
    private IEnumerable<DynamicSectionState> GetFilteredArticleSections()
    {
        var term = SectionSearchTerm.Trim();
        if (string.IsNullOrWhiteSpace(term))
        {
            return ArticleSections;
        }

        return ArticleSections.Where(section =>
            section.GroupName.Contains(term, StringComparison.OrdinalIgnoreCase) ||
            section.Fields.Any(field =>
                field.Definition.FieldLabel.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                field.Definition.FieldKey.Contains(term, StringComparison.OrdinalIgnoreCase)));
    }

