    private static string GetSectionAnchor(string groupName)
    {
        if (string.IsNullOrWhiteSpace(groupName))
        {
            return "section-general";
        }

        var slug = new string(groupName
            .Trim()
            .ToLowerInvariant()
            .Select(ch => char.IsLetterOrDigit(ch) ? ch : '-')
            .ToArray());

        while (slug.Contains("--", StringComparison.Ordinal))
        {
            slug = slug.Replace("--", "-", StringComparison.Ordinal);
        }

        return $"section-{slug.Trim('-')}";
    }

    private string GetPreviewTitle()
    {
        var titleField = ArticleSections.SelectMany(x => x.Fields).FirstOrDefault(x => x.Definition.FieldKey == "Title");
        return string.IsNullOrWhiteSpace(titleField?.TextValue) ? "Sin título todavía" : titleField.TextValue!;
    }

    private IEnumerable<string> GetParticipantNames()
    {
        return Participants
            .Select(participant => participant.Sections.SelectMany(x => x.Fields).FirstOrDefault(x => x.Definition.FieldKey == "Nombre")?.TextValue)
            .Where(x => !string.IsNullOrWhiteSpace(x))!
            .Cast<string>();
    }

    private static string GetParticipantDisplayName(DynamicParticipantState participant)
    {
        var name = participant.Sections
            .SelectMany(x => x.Fields)
            .FirstOrDefault(x => x.Definition.FieldKey == "Nombre")
            ?.TextValue;

        return string.IsNullOrWhiteSpace(name) ? "Sin nombre todavía" : name!;
    }

    private static string GetParticipantCompletionLabel(DynamicParticipantState participant)
        => GetCompletionLabel(participant.Sections.SelectMany(x => x.Fields));

    private static string GetParticipantStateBadgeLabel(DynamicParticipantState participant)
        => GetSectionStateBadgeLabel(participant.Sections.SelectMany(x => x.Fields));

    private static string GetParticipantStateBadgeClass(DynamicParticipantState participant)
        => GetSectionStateBadgeClass(participant.Sections.SelectMany(x => x.Fields));

    private int GetVisibleFieldCount()
        => GetVisibleFieldCount(ArticleSections) + Participants.Sum(participant => GetVisibleFieldCount(participant.Sections));

    private static int GetVisibleFieldCount(IEnumerable<DynamicSectionState> sections)
        => sections.Sum(section => section.Fields.Count(IsVisibleField));

    private int GetCompletedVisibleFieldCount()
        => GetCompletedVisibleFieldCount(ArticleSections) + Participants.Sum(participant => GetCompletedVisibleFieldCount(participant.Sections));

    private static int GetCompletedVisibleFieldCount(IEnumerable<DynamicSectionState> sections)
        => sections.SelectMany(section => section.Fields).Count(field => IsVisibleField(field) && HasValue(field));

    private int GetMissingRequiredTotalCount()
        => GetMissingRequiredCount(ArticleSections) + Participants.Sum(participant => GetMissingRequiredCount(participant.Sections));

    private string GetParticipantsCompletionSummary()
    {
        if (Participants.Count == 0)
        {
            return "Sin participantes";
        }

        var completed = Participants.Count(participant => GetMissingRequiredCount(participant.Sections) == 0);
        return $"{completed}/{Participants.Count} completos";
    }

    private IReadOnlyList<int> GetAllowedArticleMatrixFieldIds()
        => GetAllowedMatrixFieldIds(ArticleForm);

    private IReadOnlyList<int> GetAllowedParticipantMatrixFieldIds()
        => GetAllowedMatrixFieldIds(ParticipantForm);

    private static IReadOnlyList<int> GetAllowedMatrixFieldIds(ResolvedFormDto? form)
    {
        if (form is null)
        {
            return [];
        }

        return form.Sections
            .OrderBy(section => section.DisplayOrder)
            .SelectMany(section => section.Fields.OrderBy(field => field.DisplayOrder))
            .Where(field => field.IsVisible)
            .Select(field => field.FieldId)
            .Distinct()
            .ToList();
    }

    private async Task LoadUiStateAsync()
    {
        var state = await LocalStorage.GetItemAsync<RegisterArticleUiState>("ui.register-article.state");
        if (state is null)
        {
            return;
        }

        SectionSearchTerm = state.SectionSearchTerm ?? string.Empty;
        ExpandedArticleSections = state.ExpandedArticleSections?.ToHashSet(StringComparer.OrdinalIgnoreCase) ?? new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        IsParticipantsPanelExpanded = state.IsParticipantsPanelExpanded;
    }

    private async Task PersistUiStateAsync()
    {
        await LocalStorage.SetItemAsync("ui.register-article.state", new RegisterArticleUiState
        {
            SectionSearchTerm = SectionSearchTerm,
            ExpandedArticleSections = ExpandedArticleSections.ToList(),
            IsParticipantsPanelExpanded = IsParticipantsPanelExpanded
        });
    }

    private async Task ClearSectionSearchAsync()
    {
        SectionSearchTerm = string.Empty;
        await PersistUiStateAsync();
    }

    private async Task ExpandAllArticleSectionsAsync()
    {
        ExpandedArticleSections = ArticleSections
            .Select(x => x.GroupName)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .ToHashSet(StringComparer.OrdinalIgnoreCase);
        await PersistUiStateAsync();
    }

    private async Task CollapseAllArticleSectionsAsync()
    {
        ExpandedArticleSections.Clear();
        await PersistUiStateAsync();
    }

    private bool HasStatusMessage
        => !string.IsNullOrWhiteSpace(ErrorMessage)
           || !string.IsNullOrWhiteSpace(SuccessMessage)
           || !string.IsNullOrWhiteSpace(WarningMessage);

    private string CurrentStatusVariant
        => !string.IsNullOrWhiteSpace(ErrorMessage) ? "error"
         : !string.IsNullOrWhiteSpace(WarningMessage) ? "warning"
         : "success";

    private string CurrentStatusTitle
        => !string.IsNullOrWhiteSpace(ErrorMessage) ? "No pude completar el registro"
         : !string.IsNullOrWhiteSpace(WarningMessage) ? "Revisa este punto"
         : "Acción completada";

    private string CurrentStatusMessage
        => !string.IsNullOrWhiteSpace(ErrorMessage) ? ErrorMessage
         : !string.IsNullOrWhiteSpace(WarningMessage) ? WarningMessage
         : SuccessMessage;

    private Task CloseStatusModal()
    {
        ErrorMessage = string.Empty;
        SuccessMessage = string.Empty;
        WarningMessage = string.Empty;
        return Task.CompletedTask;
    }

    private void GoBack() => NavManager.NavigateTo("/articulos/listado");

    private void GoToArticlesList() => NavManager.NavigateTo("/articulos/listado");

    private void GoToConfiguration() => NavManager.NavigateTo("/configuration");

    private void GoToBulkImport()
    {
        if (IsAdminExperience)
        {
            GoToRegistrationMatrix();
            return;
        }

        CurrentMode = RegisterArticleMode.Mass;
    }

    private void GoToRegistrationMatrix() => NavManager.NavigateTo("/management/registration-matrix");

    private sealed class RegisterArticleUiState
    {
        public string? SectionSearchTerm { get; set; }
        public List<string>? ExpandedArticleSections { get; set; }
        public bool IsParticipantsPanelExpanded { get; set; } = true;
    }

    private enum RegisterArticleMode
    {
        Single,
        Mass
    }
}

