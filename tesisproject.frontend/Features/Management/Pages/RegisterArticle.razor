    private static string GetCompletionLabel(IEnumerable<DynamicFieldState> fields)
    {
        var requiredFields = fields.Where(x => x.Definition.IsRequired && IsVisibleField(x)).ToList();
        if (requiredFields.Count == 0)
        {
            return "Sin obligatorios";
        }

        var completed = requiredFields.Count(HasValue);
        return $"{completed}/{requiredFields.Count} obligatorios";
    }

    private static string GetSectionStateBadgeLabel(IEnumerable<DynamicFieldState> fields)
    {
        var visibleFields = fields.Where(IsVisibleField).ToList();
        if (visibleFields.Count == 0)
        {
            return "Sin campos";
        }

        var completedVisible = visibleFields.Count(HasValue);
        if (completedVisible == 0)
        {
            return "Pendiente";
        }

        if (completedVisible == visibleFields.Count)
        {
            return "Completa";
        }

        return "En progreso";
    }

    private static string GetSectionStateBadgeClass(IEnumerable<DynamicFieldState> fields)
        => GetSectionStateBadgeLabel(fields) switch
        {
            "Completa" => "rounded-full bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-700",
            "En progreso" => "rounded-full bg-amber-50 px-3 py-1 text-xs font-semibold text-amber-700",
            "Sin campos" => "rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-500",
            _ => "rounded-full bg-[#e6f0f2] px-3 py-1 text-xs font-semibold text-[#2f4858]"
        };

    private static int GetMissingRequiredCount(IEnumerable<DynamicSectionState> sections)
