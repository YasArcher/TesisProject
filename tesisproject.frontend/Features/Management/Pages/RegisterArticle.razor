
@page "/articulos/registrar"
@page "/articulos/editar/{ArticleId:int}"

@using Blazored.LocalStorage
@using Microsoft.AspNetCore.Components
@using tesisproject.frontend.Models.Configuration
@using tesisproject.frontend.SharedUI
@using tesisproject.shared.DTOs.Articles
@using tesisproject.shared.DTOs.Catalogs
@using tesisproject.shared.DTOs.Configuration
@using tesisproject.shared.DTOs.ExternalApis

@inject IFormConfigurationClient FormConfigurationClient
@inject IApiClient ApiClient
@inject ILocalStorageService LocalStorage
@inject NavigationManager NavManager

<PageTitle>Registro dinámico</PageTitle>

<div class="app-page-shell register-article-page">
    <div class="register-article-hero mb-4 rounded-[1.6rem] p-4 text-white shadow-lg">
        <div class="flex flex-col gap-4 xl:flex-row xl:items-center xl:justify-between">
            <div>
                <h1 class="text-2xl font-black md:text-3xl">Registro dinámico de artículos</h1>
            </div>
            <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 xl:flex xl:flex-wrap">
                <button class="rounded-xl border border-white/40 bg-white/10 px-4 py-2 text-sm font-semibold" @onclick="GoBack">Volver</button>
                <button class="rounded-xl border border-white/40 bg-white/10 px-4 py-2 text-sm font-semibold" @onclick="ReloadFormsFromConfigurationAsync">Recargar formulario</button>
                <button class="rounded-xl bg-[#f4b860] px-4 py-2 text-sm font-semibold text-[#12343b] sm:col-span-2 xl:col-auto" @onclick="AddParticipant">Agregar participante</button>
            </div>
        </div>
    </div>

    <AppStatusModal Visible="@HasStatusMessage"
                    Variant="@CurrentStatusVariant"
                    Eyebrow="Registro dinámico"
                    Title="@CurrentStatusTitle"
                    Message="@CurrentStatusMessage"
                    OnClose="CloseStatusModal" />
    <AppConfirmPanel
                     Visible="@PendingRemoveParticipantIndex.HasValue"
                     Title="@($"Quitar participante {PendingRemoveParticipantIndex}")"
                     Message="Se eliminarán los datos cargados para ese participante antes de guardar."
                     OnCancel="CancelRemoveParticipant"
                     OnConfirm="ConfirmRemoveParticipant" />

    @if (IsLoading)
    {
        <div class="rounded-3xl border bg-white p-6 text-center text-slate-600 shadow-sm">Cargando formularios y catálogos...</div>
    }
    else if (ArticleSections.Count == 0)
    {
        <div class="rounded-3xl border bg-white p-6 text-center text-slate-600 shadow-sm">No existe un formulario activo para `ArticleManualForm`.</div>
    }
    else
    {
        <div class="mb-5 rounded-[1.8rem] border border-[#d7e1e4] bg-gradient-to-br from-[#f3f8f9] via-white to-[#fff9f0] p-4 shadow-sm">
            <div class="grid grid-cols-1 gap-3 xl:grid-cols-[1.25fr_0.75fr]">
                <div class="space-y-3">
                    <div class="grid grid-cols-2 gap-3">
                        <div class="rounded-2xl border border-[#d9e5e8] bg-white/90 px-4 py-3 shadow-sm">
                            <div class="text-[11px] uppercase tracking-[0.18em] text-slate-500">Secciones activas</div>
                            <div class="mt-1 text-lg font-black text-[#12343b]">@ArticleSections.Count</div>
                            <div class="text-xs text-slate-500">formulario: @(ArticleForm?.FormName ?? "Sin formulario")</div>
                        </div>
                        <div class="rounded-2xl border border-[#d9e5e8] bg-white/90 px-4 py-3 shadow-sm">
                            <div class="text-[11px] uppercase tracking-[0.18em] text-slate-500">Campos visibles</div>
                            <div class="mt-1 text-lg font-black text-[#12343b]">@GetVisibleFieldCount()</div>
                            <div class="text-xs text-slate-500">entre artículo y participantes</div>
                        </div>
                        <div class="rounded-2xl border border-[#e8d2ac] bg-[#fffaf2] px-4 py-3 shadow-sm">
                            <div class="text-[11px] uppercase tracking-[0.18em] text-slate-500">Capturados</div>
                            <div class="mt-1 text-lg font-black text-[#8b5a16]">@GetCompletedVisibleFieldCount()</div>
                            <div class="text-xs text-slate-500">campos con valor registrado</div>
                        </div>
                        <div class="rounded-2xl border border-[#ead8bd] bg-[#fffdf8] px-4 py-3 shadow-sm">
                            <div class="text-[11px] uppercase tracking-[0.18em] text-slate-500">Pendientes</div>
                            <div class="mt-1 text-lg font-black text-[#c17c2f]">@GetMissingRequiredTotalCount()</div>
                            <div class="text-xs text-slate-500">obligatorios aún por completar</div>
                        </div>
                    </div>

                    <div class="rounded-2xl border border-[#cfe0e4] bg-gradient-to-r from-[#eef5f6] to-white p-3">
                        <div class="mb-2 flex items-center justify-between gap-3">
                            <div>
                                <div class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Explorador del formulario</div>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(SectionSearchTerm))
                            {
                                <button class="rounded-xl border border-[#c9d7db] bg-white px-3 py-2 text-xs font-semibold text-[#12343b]" @onclick="ClearSectionSearchAsync">Limpiar</button>
                            }
                        </div>
                        <div class="flex flex-col gap-3 lg:flex-row">
                            <input class="w-full rounded-xl border border-[#c9d7db] bg-white px-3 py-2.5 text-sm shadow-sm"
                                   placeholder="Buscar sección o campo"
                                   @bind="SectionSearchTerm"
                                   @bind:event="oninput"
                                   @bind:after="PersistUiStateAsync" />
                            <button class="rounded-xl border border-[#c9d7db] bg-white px-4 py-2 text-sm font-semibold text-[#12343b]" @onclick="ExpandAllArticleSectionsAsync">Expandir</button>
                            <button class="rounded-xl border border-[#c9d7db] bg-white px-4 py-2 text-sm font-semibold text-[#12343b]" @onclick="CollapseAllArticleSectionsAsync">Contraer</button>
                        </div>
                        <div class="mt-3 flex flex-wrap gap-2 text-xs">
                            <span class="rounded-full bg-white px-3 py-1.5 font-semibold text-[#12343b]">@GetFilteredArticleSections().Count() secciones visibles</span>
                            <span class="rounded-full bg-white px-3 py-1.5 font-semibold text-[#2f4858]">@GetVisibleFieldCount(ArticleSections) campos de artículo</span>
                            <span class="rounded-full bg-[#fff4e4] px-3 py-1.5 font-semibold text-[#8b5a16]">@Participants.Count participante(s)</span>
                        </div>
                    </div>
                </div>
                <div class="grid grid-cols-1 gap-2 sm:grid-cols-2 xl:grid-cols-1">
                    <button class="rounded-2xl border border-[#d9e5e8] bg-white/90 px-4 py-3 text-left shadow-sm transition hover:border-[#8cb0b8]" @onclick="GoToConfiguration">
                        <div class="text-xs uppercase tracking-[0.16em] text-slate-500">Configuración</div>
                        <div class="mt-1 text-sm font-bold text-[#12343b]">Campos y formularios</div>
                    </button>
                    <button class="rounded-2xl border border-[#ead8bd] bg-[#fffdf8] px-4 py-3 text-left shadow-sm transition hover:border-[#d9ba86]" @onclick="GoToBulkImport">
                        <div class="text-xs uppercase tracking-[0.16em] text-slate-500">Carga masiva</div>
                        <div class="mt-1 text-sm font-bold text-[#8b5a16]">Abrir importación</div>
                    </button>
                    <button class="rounded-2xl border border-[#d9e5e8] bg-white/90 px-4 py-3 text-left shadow-sm transition hover:border-[#8cb0b8] sm:col-span-2 xl:col-span-1" @onclick="GoToArticlesList">
                        <div class="text-xs uppercase tracking-[0.16em] text-slate-500">Listado</div>
                        <div class="mt-1 text-sm font-bold text-[#12343b]">Volver a artículos</div>
                    </button>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 gap-5 xl:grid-cols-[minmax(0,1.6fr)_minmax(20rem,0.95fr)]">
            <div class="space-y-4 xl:max-h-[calc(100vh-11rem)] xl:overflow-y-auto xl:pr-2">
                @if (!GetFilteredArticleSections().Any())
                {
                    <AppEmptyState Class="rounded-[2rem] px-6 py-10 text-center shadow-sm" Title="No encontramos secciones o campos con ese criterio" Message="Prueba con otra palabra o limpia la búsqueda para volver a ver todo el formulario." />
                }
                else
                {
                    @foreach (var sectionState in GetFilteredArticleSections())
                    {
                        <section id="@GetSectionAnchor(sectionState.GroupName)" class="scroll-mt-24 rounded-[1.6rem] border border-[#d9e5e8] bg-white shadow-sm shadow-slate-200/40">
                            <div class="border-b bg-gradient-to-r from-[#f4f8f9] to-[#fff7ef] px-4 py-3">
                                <button type="button" class="flex w-full items-center justify-between gap-3 text-left" @onclick="() => ToggleArticleSectionAsync(sectionState.GroupName)">
                                    <div>
                                        <h2 class="text-[15px] font-bold text-[#12343b]">@sectionState.GroupName</h2>
                                        <p class="mt-1 text-xs text-slate-500">@GetVisibleFields(sectionState).Count() campos visibles</p>
                                    </div>
                                    <div class="flex items-center gap-2">
                                        <span class="@GetSectionStateBadgeClass(sectionState.Fields)">@GetSectionStateBadgeLabel(sectionState.Fields)</span>
                                        <span class="rounded-full bg-[#fff1d6] px-3 py-1 text-xs font-semibold text-[#8b5a16]">@GetCompletionLabel(sectionState.Fields)</span>
                                        <span class="rounded-full bg-white px-3 py-1 text-xs font-semibold text-slate-600">@(IsArticleSectionExpanded(sectionState.GroupName) ? "Ocultar" : "Mostrar")</span>
                                    </div>
                                </button>
                            </div>
                            @if (IsArticleSectionExpanded(sectionState.GroupName))
                            {
                                <div class="grid grid-cols-1 gap-3 px-4 py-4 md:grid-cols-2">
                                    @foreach (var field in GetVisibleFields(sectionState))
                                    {
                                        <div class="@GetFieldCardClass(field)">
                                            @FieldFragment(field, ArticleSections)
                                        </div>
                                    }
                                </div>
                            }
                        </section>
                    }
                }

                <section id="participants-panel" class="rounded-[1.6rem] border border-[#ead8bd] bg-white shadow-sm shadow-slate-200/40">
                    <header class="border-b bg-gradient-to-r from-[#fff8ed] to-[#fff2df] px-4 py-3">
                        <div class="flex items-center justify-between gap-3">
                            <button type="button" class="flex items-center gap-3 text-left" @onclick="ToggleParticipantsPanelAsync">
                                <div>
                                    <h2 class="text-[15px] font-bold text-[#7a4b17]">Participantes</h2>
                                </div>
                                <span class="rounded-full bg-white px-3 py-1 text-xs font-semibold text-[#8b5a16]">@(IsParticipantsPanelExpanded ? "Ocultar" : "Mostrar")</span>
                            </button>
                            <button class="rounded-xl bg-[#12343b] px-4 py-2 text-sm font-semibold text-white" @onclick="AddParticipant">Agregar</button>
                        </div>
                    </header>
                    @if (IsParticipantsPanelExpanded)
                    {
                    <div class="space-y-3 px-4 py-4">
                        @foreach (var participant in Participants)
                        {
                            <article class="rounded-[1.4rem] border border-[#ead8bd] bg-[#fffdf8] p-3.5">
                                <details open="@(participant.Index == 1)">
                                    <summary class="cursor-pointer list-none">
                                        <div class="flex items-center justify-between gap-3">
                                            <div>
                                                <h3 class="font-bold text-[#8b5a16]">Participante @participant.Index</h3>
                                                <p class="mt-1 text-xs text-slate-500">@GetParticipantDisplayName(participant)</p>
                                            </div>
                                            <div class="flex items-center gap-2">
                                                <span class="rounded-full bg-[#fff1d6] px-3 py-1 text-xs font-semibold text-[#8b5a16]">@participant.Sections.Sum(x => GetVisibleFields(x).Count()) campos</span>
                                                <span class="@GetParticipantStateBadgeClass(participant)">@GetParticipantStateBadgeLabel(participant)</span>
                                                <span class="rounded-full bg-white px-3 py-1 text-xs font-semibold text-[#2f4858]">@GetParticipantCompletionLabel(participant)</span>
                                                @if (Participants.Count > 1)
                                                {
                                                    <button class="rounded-xl border border-rose-200 bg-rose-50 px-3 py-1.5 text-xs font-semibold text-rose-700" @onclick="() => RequestRemoveParticipant(participant.Index)">Quitar</button>
                                                }
                                            </div>
                                        </div>
                                    </summary>

                                    <div class="mt-4 space-y-4">
                                        @foreach (var sectionState in participant.Sections)
                                        {
                                            <details class="rounded-2xl border border-[#e8edf0] bg-white p-3.5" open>
                                                <summary class="cursor-pointer text-sm font-semibold text-[#12343b]">
                                                    <span>@sectionState.GroupName</span>
                                                    <span class="ml-2 rounded-full bg-[#eef5f6] px-2 py-1 text-[11px] font-semibold text-[#2f4858]">@GetCompletionLabel(sectionState.Fields)</span>
                                                </summary>
                                                <div class="mt-3 grid grid-cols-1 gap-3 md:grid-cols-2">
                                                    @foreach (var field in GetVisibleFields(sectionState))
                                                    {
                                                        <div class="@GetFieldCardClass(field)">
                                                            @FieldFragment(field, participant.Sections)
                                                        </div>
                                                    }
                                                </div>
                                            </details>
                                        }
                                    </div>
                                </details>
                            </article>
                        }
                    </div>
                    }
                </section>
            </div>

            <aside class="space-y-4 xl:sticky xl:top-4 xl:max-h-[calc(100vh-2rem)] xl:self-start xl:overflow-y-auto">
                <section class="rounded-[1.8rem] border border-[#d9e5e8] bg-gradient-to-br from-[#f7fbfc] via-white to-[#fff8ef] shadow-sm shadow-slate-200/50" id="save-panel">
                    <header class="border-b bg-gradient-to-r from-[#12343b] to-[#2f4858] px-4 py-4 text-white">
                        <div class="flex items-center justify-between gap-3">
                            <div>
                                <h2 class="text-base font-bold">Registro del artículo</h2>
                            </div>
                            <span class="rounded-full bg-white/10 px-3 py-1 text-xs font-semibold">@(IsSaving ? "Guardando" : "Edición activa")</span>
                        </div>
                    </header>
                    <div class="space-y-3 px-4 py-4 text-sm">
                        <div class="grid grid-cols-2 gap-2">
                            <button class="rounded-xl border border-rose-200 bg-rose-50 px-3 py-2 text-sm font-semibold text-rose-700" @onclick="GoBack">Cancelar</button>
                            <button class="rounded-xl bg-gradient-to-r from-[#12343b] to-[#2f4858] px-3 py-2 text-sm font-semibold text-white shadow-md disabled:opacity-60" disabled="@IsSaving" @onclick="SaveAsync">@(IsSaving ? "Guardando..." : "Registrar")</button>
                            <button class="rounded-xl border border-sky-200 bg-sky-50 px-3 py-2 text-sm font-semibold text-sky-700" @onclick="ReloadFormsFromConfigurationAsync">Recargar</button>
                            <button class="rounded-xl border border-[#ead8bd] bg-[#fff7eb] px-3 py-2 text-sm font-semibold text-[#8b5a16]" @onclick="GoBack">Volver</button>
                        </div>

                        <div class="grid grid-cols-2 gap-3">
                            <div class="rounded-2xl bg-[#eef5f6] px-4 py-3">
                                <div class="text-xs uppercase tracking-wide text-slate-500">Campos</div>
                                <div class="mt-1 text-lg font-black text-[#2f4858]">@GetVisibleFieldCount()</div>
                            </div>
                            <div class="rounded-2xl bg-[#fff4e4] px-4 py-3">
                                <div class="text-xs uppercase tracking-wide text-slate-500">Registrados</div>
                                <div class="mt-1 text-lg font-black text-[#c17c2f]">@GetCompletedVisibleFieldCount()</div>
                            </div>
                        </div>
                        <div class="grid grid-cols-2 gap-3">
                            <div class="rounded-2xl bg-white px-4 py-3 border border-[#d9e5e8]">
                                <div class="text-xs uppercase tracking-wide text-slate-500">Obligatorios pendientes</div>
                                <div class="mt-1 text-lg font-black text-[#b45309]">@GetMissingRequiredTotalCount()</div>
                            </div>
                            <div class="rounded-2xl bg-white px-4 py-3 border border-[#d9e5e8]">
                                <div class="text-xs uppercase tracking-wide text-slate-500">Participantes</div>
                                <div class="mt-1 text-lg font-black text-[#12343b]">@Participants.Count</div>
                            </div>
                        </div>
                        <div class="rounded-2xl bg-[#f4f8f9] px-4 py-3">
                            <div class="text-xs uppercase tracking-wide text-slate-500">Formulario</div>
                            <div class="mt-1 font-semibold text-[#12343b]">@ArticleForm?.FormName</div>
                            <div class="mt-1 text-xs text-slate-500">@ArticleSections.Count secciones activas</div>
                        </div>
                        <div class="rounded-2xl bg-gradient-to-br from-[#12343b] to-[#2f4858] px-4 py-4 text-white">
                            <div class="text-xs uppercase tracking-[0.25em] text-white/70">Vista previa</div>
                            <div class="mt-2 text-base font-bold">@GetPreviewTitle()</div>
                            <div class="mt-3 space-y-2 text-xs text-white/80">
                                @foreach (var name in GetParticipantNames())
                                {
                                    <div class="rounded-xl bg-white/10 px-3 py-2">@name</div>
                                }
                                @if (!GetParticipantNames().Any())
                                {
                                    <div class="rounded-xl bg-white/10 px-3 py-2">Sin participantes con nombre todavía.</div>
                                }
                            </div>
                        </div>
                        <div class="rounded-2xl border border-[#d9e5e8] bg-[#fafcfd] px-4 py-4">
                            <div class="text-xs uppercase tracking-[0.25em] text-slate-500">Estado del registro</div>
                            <div class="mt-3 space-y-2 text-sm">
                                <div class="flex items-center justify-between rounded-xl bg-white px-3 py-2">
                                    <span class="text-slate-600">Artículo</span>
                                    <span class="font-semibold text-[#12343b]">@GetCompletionLabel(ArticleSections.SelectMany(x => x.Fields))</span>
                                </div>
                                <div class="flex items-center justify-between rounded-xl bg-white px-3 py-2">
                                    <span class="text-slate-600">Participantes</span>
                                    <span class="font-semibold text-[#12343b]">@GetParticipantsCompletionSummary()</span>
                                </div>
                            </div>
                        </div>
                        <div class="rounded-2xl border border-[#d9e5e8] bg-[#fafcfd] px-4 py-4">
                            <div class="text-xs uppercase tracking-[0.25em] text-slate-500">Accesos rápidos</div>
                            <div class="app-chip-row mt-3">
                                @foreach (var sectionState in GetFilteredArticleSections().Take(6))
                                {
                                    <a class="rounded-full bg-[#e9f1f3] px-3 py-1.5 text-xs font-semibold text-[#12343b]" href="#@GetSectionAnchor(sectionState.GroupName)">@sectionState.GroupName</a>
                                }
                                <a class="rounded-full bg-[#fff1d6] px-3 py-1.5 text-xs font-semibold text-[#8b5a16]" href="#participants-panel">Participantes</a>
                                <button type="button" class="rounded-full bg-[#eef5f6] px-3 py-1.5 text-xs font-semibold text-[#12343b]" @onclick="GoToConfiguration">Configuración</button>
                                <button type="button" class="rounded-full bg-[#fff1d6] px-3 py-1.5 text-xs font-semibold text-[#8b5a16]" @onclick="GoToBulkImport">Carga masiva</button>
                                <button type="button" class="rounded-full bg-[#eef5f6] px-3 py-1.5 text-xs font-semibold text-[#12343b]" @onclick="GoToArticlesList">Listado</button>
                            </div>
                        </div>
                    </div>
                </section>
            </aside>
        </div>
    }
</div>

@code {
    [Parameter] public int ArticleId { get; set; }

    private ResolvedFormDto? ArticleForm { get; set; }
    private ResolvedFormDto? ParticipantForm { get; set; }
    private List<DynamicSectionState> ArticleSections { get; set; } = new();
    private List<DynamicParticipantState> Participants { get; set; } = new();
    private string SectionSearchTerm { get; set; } = string.Empty;
    private int? PendingRemoveParticipantIndex { get; set; }
    private HashSet<string> ExpandedArticleSections { get; set; } = new(StringComparer.OrdinalIgnoreCase);
    private bool IsParticipantsPanelExpanded { get; set; } = true;
    private bool IsLoading { get; set; } = true;
    private bool IsSaving { get; set; }
    private string ErrorMessage { get; set; } = string.Empty;
    private string SuccessMessage { get; set; } = string.Empty;
    private string WarningMessage { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadUiStateAsync();
        await LoadFormsAsync();
    }

    private async Task LoadFormsAsync()
    {
        IsLoading = true;
        try
        {
            var articleTask = FormConfigurationClient.GetActiveResolvedFormAsync("Article", "ArticleManualForm");
            var participantTask = FormConfigurationClient.GetActiveResolvedFormAsync("ArticleParticipant", "ArticleParticipantForm");
            await Task.WhenAll(articleTask, participantTask);

            ArticleForm = articleTask.Result;
            ParticipantForm = participantTask.Result;

            if (ArticleForm is null)
            {
                ErrorMessage = "No se encontró un formulario activo para Article.";
                return;
            }

            ArticleSections = BuildSections(ArticleForm);
            InitializeExpandedSections();
            await LoadCatalogsAsync(ArticleSections);
            Participants.Clear();

            if (ParticipantForm is not null)
            {
                AddParticipant();
            }

            await ApplyExternalDraftAsync();

            _ = await LocalStorage.GetItemAsync<long?>("ui.form-configuration.version");

            if (ArticleId > 0)
            {
                WarningMessage = "La edición dinámica todavía no está implementada. El flujo funcional de este sprint es registro manual nuevo.";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"No fue posible cargar la configuración dinámica: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private List<DynamicSectionState> BuildSections(ResolvedFormDto form)
    {
        return form.Sections
            .OrderBy(x => x.DisplayOrder)
            .Select(section => new DynamicSectionState
            {
                GroupName = section.GroupName,
                DisplayOrder = section.DisplayOrder,
                Fields = section.Fields.OrderBy(x => x.DisplayOrder).Select(CreateFieldState).ToList()
            })
            .ToList();
    }

    private DynamicFieldState CreateFieldState(ResolvedFormFieldDto field)
    {
        var state = new DynamicFieldState { Definition = field };

        if (!string.IsNullOrWhiteSpace(field.DefaultValue))
        {
            if (IsBoolField(state) && bool.TryParse(field.DefaultValue, out var defaultBool)) state.BoolValue = defaultBool;
            else if (IsIntField(state) && int.TryParse(field.DefaultValue, out var defaultInt)) state.IntValue = defaultInt;
            else if (IsDecimalField(state) && decimal.TryParse(field.DefaultValue, out var defaultDecimal)) state.DecimalValue = defaultDecimal;
            else if (IsDateField(state) && DateTime.TryParse(field.DefaultValue, out var defaultDate)) state.DateValue = defaultDate;
            else state.TextValue = field.DefaultValue;
        }

        return state;
    }

    private async Task LoadCatalogsAsync(List<DynamicSectionState> sections)
    {
        foreach (var field in sections.SelectMany(x => x.Fields))
        {
            if (!NeedsCatalogItems(field))
            {
                continue;
            }

            if (IsDependentCatalogField(field))
            {
                field.CatalogItems = new List<CatalogItemDto>();
                continue;
            }

            field.CatalogItems = await FormConfigurationClient.GetCatalogItemsByFieldAsync(field.Definition.FieldId);
        }
    }
    private async Task SaveAsync()
    {
        ErrorMessage = string.Empty;
        SuccessMessage = string.Empty;

        if (ArticleId > 0)
        {
            ErrorMessage = "La edición del registro dinámico aún no está habilitada.";
            return;
        }

        var validationError = ValidateForm();
        if (!string.IsNullOrWhiteSpace(validationError))
        {
            ErrorMessage = validationError;
            return;
        }

        try
        {
            IsSaving = true;

            var request = new RegisterArticleAggregateRequest
            {
                FormKey = ArticleForm?.FormKey,
                Article = BuildArticleCore(),
                Venue = BuildVenueRequest(),
                VenueMetric = BuildVenueMetricRequest(),
                DynamicFields = BuildDynamicValues(ArticleSections),
                Participants = Participants.Select(BuildParticipantRequest).ToList()
            };

            var result = await ApiClient.PostAsync<RegisterArticleAggregateRequest, RegisterArticleAggregateResponse>("api/articles/aggregate", request);

            if (result is null)
            {
                ErrorMessage = "El backend no devolvió un resultado al guardar el artículo.";
                return;
            }

            SuccessMessage = $"Artículo registrado correctamente con Id {result.ArticleId}.";
            await ResetFormAsync();
        }
        catch (Exception ex)
        {
            ErrorMessage = $"No fue posible guardar el artículo: {ex.Message}";
        }
        finally
        {
            IsSaving = false;
        }
    }

    private async Task ResetFormAsync()
    {
        if (ArticleForm is not null)
        {
            ArticleSections = BuildSections(ArticleForm);
            InitializeExpandedSections();
            await LoadCatalogsAsync(ArticleSections);
        }

        Participants.Clear();
        if (ParticipantForm is not null)
        {
            AddParticipant();
        }
    }

    private async Task ApplyExternalDraftAsync()
    {
        var draft = await LocalStorage.GetItemAsync<ExternalArticleRegistrationDraftDto>("external-api.register-draft");
        if (draft is null || draft.Article is null)
        {
            return;
        }

        await LocalStorage.RemoveItemAsync("external-api.register-draft");

        SetTextField("Title", draft.Article.Title);
        SetTextField("Doi", draft.Article.Doi);
        SetIntField("Year", draft.Article.PublicationYear);
        SetTextField("PublicationUrl", draft.Article.SourceUrl);
        SetTextField("ExternalSource", draft.ProviderName);
        SetTextField("ExternalId", draft.Article.ExternalId);
        SetTextField("JournalName", draft.Article.JournalName);
        SetTextField("IssnCode", draft.Article.IssnCode);
        SetTextField("JournalUrl", draft.Article.JournalUrl);
        SetTextField("VolumeNumber", draft.Article.Volume);
        SetTextField("IssueNumber", draft.Article.Issue);

        if (Participants.Count == 0 && ParticipantForm is not null)
        {
            AddParticipant();
        }

        var authorNames = draft.Article.AuthorNames?.Where(x => !string.IsNullOrWhiteSpace(x)).ToList()
            ?? new List<string>();

        if (authorNames.Count == 0 && !string.IsNullOrWhiteSpace(draft.Article.Authors))
        {
            authorNames = draft.Article.Authors
                .Split(new[] { ';', ',' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Where(x => !string.IsNullOrWhiteSpace(x))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList();
        }

        if (authorNames.Count > 0 && ParticipantForm is not null)
        {
            Participants.Clear();
            for (var i = 0; i < authorNames.Count; i++)
            {
                AddParticipant();
                SetParticipantTextField(Participants[i], "Nombre", authorNames[i]);
                SetParticipantBoolField(Participants[i], "IsPrimaryAuthor", i == 0);
                SetParticipantTextField(Participants[i], "ParticipantType", "Autor externo");
            }
        }

        SuccessMessage = $"Se cargó un borrador desde {draft.ProviderName}. Revisa los datos y completa lo que falte antes de guardar.";
    }

