    private ArticleAggregateCoreDto BuildArticleCore()
    {
        var dto = new ArticleAggregateCoreDto();
        foreach (var field in ArticleSections.SelectMany(x => x.Fields).Where(x => !x.Definition.IsDynamic))
        {
            switch (field.Definition.FieldKey)
            {
                case "Title": dto.Title = field.TextValue; break;
                case "Doi": dto.Doi = field.TextValue; break;
                case "Year": dto.Year = field.IntValue.HasValue ? (short?)field.IntValue.Value : null; break;
                case "PublishedAt": dto.PublishedAt = field.DateValue; break;
                case "PageCount": dto.PageCount = field.IntValue; break;
                case "PublicationUrl": dto.PublicationUrl = field.TextValue; break;
                case "IsProjectResult": dto.IsProjectResult = field.BoolValue ?? false; break;
                case "HasInterculturalComponent": dto.HasInterculturalComponent = field.BoolValue ?? false; break;
                case "ProceedingsName": dto.ProceedingsName = field.TextValue; break;
                case "Proceedings": dto.Proceedings = field.TextValue; break;
                case "EventName": dto.EventName = field.TextValue; break;
                case "GroupName": dto.GroupName = field.TextValue; break;
                case "Filiacion": dto.Filiacion = field.TextValue; break;
                case "AcademicTermId": dto.AcademicTermId = field.CatalogValue; break;
                case "PublicationStatusId": dto.PublicationStatusId = field.CatalogValue.HasValue ? (byte?)field.CatalogValue.Value : null; break;
                case "ResearchLineId": dto.ResearchLineId = field.CatalogValue; break;
                case "BroadFieldId": dto.BroadFieldId = field.CatalogValue; break;
                case "SpecificFieldId": dto.SpecificFieldId = field.CatalogValue; break;
                case "DetailedFieldId": dto.DetailedFieldId = field.CatalogValue; break;
                case "IsOpenAccess": dto.IsOpenAccess = field.BoolValue ?? false; break;
                case "ExternalSource": dto.ExternalSource = field.TextValue; break;
                case "ExternalId": dto.ExternalId = field.TextValue; break;
            }
        }

        return dto;
    }

