    }

    private async Task ApplyExternalDraftAsync()
    {
        var draft = await LocalStorage.GetItemAsync<ExternalArticleRegistrationDraftDto>("external-api.register-draft");
        if (draft is null || draft.Article is null)
        {
            return;
        }

        await LocalStorage.RemoveItemAsync("external-api.register-draft");

        SetTextField("Title", draft.Article.Title);
        SetTextField("Doi", draft.Article.Doi);
        SetIntField("Year", draft.Article.PublicationYear);
        SetTextField("PublicationUrl", draft.Article.SourceUrl);
        SetTextField("ExternalSource", draft.ProviderName);
        SetTextField("ExternalId", draft.Article.ExternalId);
        SetTextField("JournalName", draft.Article.JournalName);
        SetTextField("IssnCode", draft.Article.IssnCode);
        SetTextField("JournalUrl", draft.Article.JournalUrl);
        SetTextField("VolumeNumber", draft.Article.Volume);
        SetTextField("IssueNumber", draft.Article.Issue);

        if (Participants.Count == 0 && ParticipantForm is not null)
        {
            AddParticipant();
        }

        var authorNames = draft.Article.AuthorNames?.Where(x => !string.IsNullOrWhiteSpace(x)).ToList()
            ?? new List<string>();

        if (authorNames.Count == 0 && !string.IsNullOrWhiteSpace(draft.Article.Authors))
        {
            authorNames = draft.Article.Authors
                .Split(new[] { ';', ',' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Where(x => !string.IsNullOrWhiteSpace(x))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList();
        }

        if (authorNames.Count > 0 && ParticipantForm is not null)
        {
            Participants.Clear();
            for (var i = 0; i < authorNames.Count; i++)
            {
                AddParticipant();
                SetParticipantTextField(Participants[i], "Nombre", authorNames[i]);
                SetParticipantBoolField(Participants[i], "IsPrimaryAuthor", i == 0);
                SetParticipantTextField(Participants[i], "ParticipantType", "Autor externo");
            }
        }

        SuccessMessage = $"Se cargó un borrador desde {draft.ProviderName}. Revisa los datos y completa lo que falte antes de guardar.";
    }

