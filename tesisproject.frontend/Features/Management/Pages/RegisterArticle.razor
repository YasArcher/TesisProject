@page "/articulos/registrar"

<AppHeroHeader Title="Artículos Científicos" Subtitle="Registro">
    <Actions>
        <a class="btn btn-light" type="button" @onclick="OnCancel" disabled="@saving">Borrador</a>
        <button class="btn btn-primary" type="submit" form="article-form" disabled="@saving">
            @(saving ? "Guardando..." : "Guardar")
        </button>
    </Actions>
</AppHeroHeader>

<AppPillTabs Class="mb-3" Items="@Tabs" />
@if (!string.IsNullOrWhiteSpace(serverError))
{
    <div class="alert alert-danger">@serverError</div>
}
@if (!string.IsNullOrWhiteSpace(serverOk))
{
    <div class="alert alert-success">@serverOk</div>
}

<EditForm Id="article-form" Model="@Model" OnValidSubmit="@OnSave">
    <DataAnnotationsValidator />
    <ValidationSummary class="alert alert-warning rounded-2 mt-0 mb-3" />

    <div class="row g-4">
        <!-- ===== Columna principal ===== -->
        <div class="col-12 col-lg-8">

            <!-- 0) PERÍODO ACADÉMICO -->
            <AppGlassCard Title="Período Académico" Icon="📅" Class="mb-3">
                <div class="row g-3">
                    <AppFormSelect Label="Período" Id="periodo"
                                   ColCss="col-12 col-md-6"
                                   Placeholder="Seleccione…"
                                   Options="@Catalogs.PeriodoOptions"
                                   @bind-Value="Model.PeriodoAcademico" />

                    <AppFormInput Label="Año" Id="anio"
                                  Type="number" Placeholder="2025"
                                  ColCss="col-12 col-md-6"
                                  @bind-Value="Model.Anio" />
                </div>
            </AppGlassCard>

            <!-- 1) IDENTIFICACIÓN Y REVISTA -->
            <AppGlassCard Title="Identificación y Revista" Icon="📑" Class="mb-3">
                <div class="row g-3">
                    <AppFormInput Label="Código Publicación" Id="codPublicacion"
                                  Placeholder="DOI o código interno"
                                  ColCss="col-12 col-md-6"
                                  @bind-Value="Model.CodigoPublicacion" />
                    <AppFormInput Label="Código ISSN" Id="issn"
                                  Placeholder="1234-5678"
                                  ColCss="col-12 col-md-6"
                                  @bind-Value="Model.CodigoISSN" />

                    <AppFormTextarea Label="Título Publicación" Id="titulo"
                                     Rows="3" ColCss="col-12"
                                     Placeholder="Escribe el título…"
                                     @bind-Value="Model.Titulo" />

                    <AppFormInput Label="Nombre revista" Id="revista"
                                  Placeholder="Journal of…"
                                  ColCss="col-12 col-md-6"
                                  @bind-Value="Model.NombreRevista" />

                    <AppFormInput Label="Volumen Revista" Id="VolRevista"
                                  Placeholder="79"
                                  ColCss="col-12 col-md-3"
                                  @bind-Value="Model.VolumenRevista" />

                    <AppFormInput Label="Número revista" Id="numRevista"
                                  Placeholder="42(3)"
                                  ColCss="col-12 col-md-3"
                                  @bind-Value="Model.NumeroRevista" />

                    <AppFormInput Label="Número de páginas" Id="numPaginas"
                                  Placeholder="12"
                                  ColCss="col-12 col-md-3"
                                  @bind-Value="Model.NumeroPaginas" />

                    <AppFormInput Label="SJR (SCImago)" Id="sjr"
                                  Type="number" Placeholder="0.000"
                                  ColCss="col-12 col-md-3"
                                  @bind-Value="Model.SJR" />
                    <AppFormInput Label="Fecha Publicación" Id="fechaPub"
                                  Type="date"
                                  ColCss="col-12 col-md-6"
                                  @bind-Value="Model.FechaPublicacion" />
                </div>
            </AppGlassCard>

            <!-- 2) CLASIFICACIÓN / INDEXACIÓN / QUARTIL -->
            <AppGlassCard Title="Clasificación e Indexación" Icon="🧭" Class="mb-3">
                <div class="row g-3">
                    <AppFormSelect Label="Base datos indexado" Id="baseIndex"
                                   ColCss="col-12 col-md-4"
                                   Options="@Catalogs.BaseDatosOptions"
                                   @bind-Value="Model.BaseDatos" />
                    <AppFormSelect Label="Campo Amplio" Id="campoAmplio"
                                   ColCss="col-12 col-md-4"
                                   Options="@Catalogs.CampoAmplioOptions"
                                   @bind-Value="Model.CampoAmplio" />
                    <AppFormSelect Label="Campo Específico" Id="campoEspecifico"
                                   ColCss="col-12 col-md-4"
                                   Options="@Catalogs.CampoEspecificoOptions"
                                   @bind-Value="Model.CampoEspecifico" />
                    <AppFormSelect Label="Campo Detallado" Id="campoDetallado"
                                   ColCss="col-12"
                                   Options="@Catalogs.CampoDetalladoOptions"
                                   @bind-Value="Model.CampoDetallado" />
                    <AppFormSelect Label="Quartil" Id="quartil"
                                   ColCss="col-12 col-md-6"
                                   Options="@Catalogs.QuartilOptions"
                                   @bind-Value="Model.Quartil" />
                    <AppFormInput Label="Filiación" Id="filiacion"
                                  Placeholder="Universidad Nacional de Colombia"
                                  ColCss="col-12 col-md-6"
                                  @bind-Value="Model.Filiacion" />
                </div>
            </AppGlassCard>

            <!-- 3) ESTADO & ACCESO -->
            <AppGlassCard Title="Estado & Acceso" Icon="🏷️" Class="mb-3">
                <div class="row g-3">
                    <AppFormSelect Label="Estado" Id="estado"
                                   ColCss="col-12 col-md-6"
                                   Options="@Catalogs.EstadoOptions"
                                   @bind-Value="Model.Estado" />
                    <AppFormSelect Label="Acceso Abierto" Id="openAccess"
                                   ColCss="col-12 col-md-6"
                                   Options="@Catalogs.OpenAccessOptions"
                                   @bind-Value="Model.AccesoAbierto" />
                </div>
            </AppGlassCard>

            <!-- 4) ENLACES -->
            <AppGlassCard Title="Enlaces" Icon="🔗" Class="mb-3">
                <div class="row g-3">
                    <div class="col-12">
                        <AppUrlVisit Label="Link Publicación" Id="linkPub"
                                     @bind-Value="Model.LinkPublicacion" />
                    </div>
                    <div class="col-12">
                        <AppUrlVisit Label="Link Revista" Id="linkRev"
                                     @bind-Value="Model.EnlaceRevista" />
                    </div>
                </div>
            </AppGlassCard>

            <!-- 5) PARTICIPANTES 1..5 -->
            <AppGlassCard Title="Participantes" Icon="👥">
                <AppParticipantRow Index="1"
                                   @bind-Identificacion="Model.Identificacion1"
                                   @bind-Nombre="Model.Nombre1"
                                   @bind-Participacion="Model.Participacion1" />
                <AppParticipantRow Index="2"
                                   @bind-Identificacion="Model.Identificacion2"
                                   @bind-Nombre="Model.Nombre2"
                                   @bind-Participacion="Model.Participacion2" />
                <AppParticipantRow Index="3"
                                   @bind-Identificacion="Model.Identificacion3"
                                   @bind-Nombre="Model.Nombre3"
                                   @bind-Participacion="Model.Participacion3" />
                <AppParticipantRow Index="4"
                                   @bind-Identificacion="Model.Identificacion4"
                                   @bind-Nombre="Model.Nombre4"
                                   @bind-Participacion="Model.Participacion4" />
                <AppParticipantRow Index="5"
                                   @bind-Identificacion="Model.Identificacion5"
                                   @bind-Nombre="Model.Nombre5"
                                   @bind-Participacion="Model.Participacion5" />
            </AppGlassCard>

        </div>

        <!-- ===== Aside (resumen) ===== -->
        <div class="col-12 col-lg-4">
            <div class="sticky-aside">
                <AppGlassCard Title="Resumen" Icon="🔎" Class="mb-3">
                    <div class="mb-2">
                        <div class="text-muted small mb-1">Título</div>
                        <div class="fw-semibold">@(!string.IsNullOrWhiteSpace(Model.Titulo) ? Model.Titulo : "—")</div>
                    </div>
                    <div class="small text-muted">Período: @(Model.PeriodoAcademico ?? "—")</div>
                    <div class="small text-muted">ISSN: @(Model.CodigoISSN ?? "—")</div>
                    <div class="small text-muted mb-2">SJR: @(Model.SJR ?? "—")</div>

                    <div class="d-flex flex-wrap gap-2 mt-2" aria-label="Resumen de metadatos">
                        <span class="summary-chip"><span class="dot @GetAccessDot()" aria-hidden="true"></span> Acceso: @(Model.AccesoAbierto ?? "—")</span>
                        <span class="summary-chip"><span class="dot @GetEstadoDot()" aria-hidden="true"></span> Estado: @(Model.Estado ?? "—")</span>
                        <span class="summary-chip"><span class="dot dot-primary" aria-hidden="true"></span> BD: @(Model.BaseDatos ?? "—")</span>
                    </div>

                    <div class="mt-3 d-flex gap-2">
                        <a class="btn btn-sm btn-outline-primary @((string.IsNullOrWhiteSpace(Model.LinkPublicacion) ? "disabled" : null))"
                           target="_blank" rel="noopener"
                           href="@(string.IsNullOrWhiteSpace(Model.LinkPublicacion) ? "#" : Model.LinkPublicacion)">
                            Ver publicación
                        </a>
                        <a class="btn btn-sm btn-outline-secondary @((string.IsNullOrWhiteSpace(Model.EnlaceRevista) ? "disabled" : null))"
                           target="_blank" rel="noopener"
                           href="@(string.IsNullOrWhiteSpace(Model.EnlaceRevista) ? "#" : Model.EnlaceRevista)">
                            Ver revista
                        </a>
                    </div>
                </AppGlassCard>
            </div>
        </div><!-- ACCIONES (dentro del formulario, siempre visibles) -->
        <div class="col-12">
            <div class="form-actions-sticky d-flex justify-content-end gap-2" role="toolbar" aria-label="Acciones del formulario">
                <button type="button" class="btn btn-light border" @onclick="OnCancel" disabled="@saving">
                    Cancelar
                </button>
                <button type="submit" class="btn btn-primary" disabled="@saving">
                    @(saving ? "Guardando..." : "Guardar")
                </button>
            </div>
        </div>

    </div>
</EditForm>
