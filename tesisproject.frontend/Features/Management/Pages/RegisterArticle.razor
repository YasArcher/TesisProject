
@page "/articulos/registrar"
@page "/articulos/editar/{ArticleId:int}"
@attribute [Authorize(Roles = "Admin,Analyst,Author")]

@using Blazored.LocalStorage
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@using tesisproject.frontend.Features.Management.Components
@using tesisproject.frontend.Models.Configuration
@using tesisproject.frontend.SharedUI
@using tesisproject.shared.DTOs.Articles
@using tesisproject.shared.DTOs.Catalogs
@using tesisproject.shared.DTOs.Configuration
@using tesisproject.shared.DTOs.ExternalApis
@using tesisproject.shared.DTOs.Imports

@inject IFormConfigurationClient FormConfigurationClient
@inject IApiClient ApiClient
@inject ILocalStorageService LocalStorage
@inject IJSRuntime JS
@inject NavigationManager NavManager
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Registro dinámico</PageTitle>

<div class="app-page-shell app-shell-warm register-article-page">
    <section class="mb-5 rounded-[1.8rem] border border-[var(--app-border-subtle)] bg-white p-3 shadow-sm">
        <div class="register-mode-tabs register-generic-tabs" role="tablist" aria-label="Modalidades de registro">
            <button type="button"
                    role="tab"
                    aria-selected="@(CurrentMode == RegisterArticleMode.Single)"
                    class="register-mode-tab register-generic-tab @(CurrentMode == RegisterArticleMode.Single ? "register-mode-tab--active" : null)"
                    @onclick="() => SetMode(RegisterArticleMode.Single)">
                Registro individual
            </button>
            <button type="button"
                    role="tab"
                    aria-selected="@(!IsAdminExperience && CurrentMode == RegisterArticleMode.Mass)"
                    class="register-mode-tab register-generic-tab @(!IsAdminExperience && CurrentMode == RegisterArticleMode.Mass ? "register-mode-tab--active" : null)"
                    @onclick="OpenSecondaryRegistrationMode">
                @(IsAdminExperience ? "Matriz de registro" : "Registro en masa")
            </button>
        </div>
    </section>

    <AppStatusModal Visible="@HasStatusMessage"
                    Variant="@CurrentStatusVariant"
                    Eyebrow="Registro dinámico"
                    Title="@CurrentStatusTitle"
                    Message="@CurrentStatusMessage"
                    OnClose="CloseStatusModal" />
    <AppConfirmPanel
                     Visible="@PendingRemoveParticipantIndex.HasValue"
                     Title="@($"Quitar participante {PendingRemoveParticipantIndex}")"
                     Message="Se eliminarán los datos cargados para ese participante antes de guardar."
                     OnCancel="CancelRemoveParticipant"
                     OnConfirm="ConfirmRemoveParticipant" />

    @if (IsLoading)
    {
        <div class="rounded-3xl border bg-white p-6 text-center text-slate-600 shadow-sm">Cargando formularios y catálogos...</div>
    }
    else if (ArticleSections.Count == 0)
    {
        <div class="rounded-3xl border bg-white p-6 text-center text-slate-600 shadow-sm">No existe un formulario activo para `ArticleManualForm`.</div>
    }
    else
    {
        @if (CurrentMode == RegisterArticleMode.Single)
        {
            <section class="mb-4 rounded-[2rem] border border-[var(--app-border-subtle)] bg-white p-4 shadow-sm">
                <div class="grid grid-cols-1 gap-4 xl:grid-cols-[1.25fr_0.75fr]">
                    <div class="space-y-4">
                        <div>
                            <div class="text-[11px] font-semibold uppercase tracking-[0.18em] text-[var(--app-text-soft)]">Formulario institucional</div>
                            <h2 class="text-lg font-black text-[var(--app-heading)]">Registro individual de artículos</h2>
                            <p class="mt-1 text-sm text-[var(--app-text-muted)]">Completa un artículo a la vez y luego envíalo a revisión. El formulario responde únicamente a la configuración activa del sistema.</p>
                        </div>
                        <div class="register-top-metrics">
                            <div class="register-top-metric register-top-metric--primary">
                                <div class="register-top-metric__eyebrow">Estructura activa</div>
                                <div class="register-top-metric__value">@ArticleSections.Count</div>
                                <div class="register-top-metric__label">secciones disponibles</div>
                            </div>
                            <div class="register-top-metric">
                                <div class="register-top-metric__eyebrow">Campos visibles</div>
                                <div class="register-top-metric__value">@GetVisibleFieldCount()</div>
                                <div class="register-top-metric__label">incluye participantes</div>
                            </div>
                            <div class="register-top-metric register-top-metric--accent">
                                <div class="register-top-metric__eyebrow">Completados</div>
                                <div class="register-top-metric__value">@GetCompletedVisibleFieldCount()</div>
                                <div class="register-top-metric__label">con valor registrado</div>
                            </div>
                            <div class="register-top-metric register-top-metric--warm">
                                <div class="register-top-metric__eyebrow">Pendientes</div>
                                <div class="register-top-metric__value">@GetMissingRequiredTotalCount()</div>
                                <div class="register-top-metric__label">obligatorios por completar</div>
                            </div>
                        </div>
                    </div>
                    <div class="register-toolbar-panel">
                        <div class="text-[11px] font-semibold uppercase tracking-[0.18em] text-[var(--app-text-soft)]">Explorador del formulario</div>
                        <div class="mt-3 flex flex-col gap-3">
                            <input class="w-full rounded-xl border border-[var(--app-border-subtle)] bg-white px-3 py-2.5 text-sm shadow-sm"
                                   placeholder="Buscar sección o campo"
                                   value="@SectionSearchTerm"
                                   @oninput="OnSearchInputChanged" />
                            <div class="flex flex-wrap gap-2">
                                <button class="rounded-xl border border-[var(--app-border-subtle)] bg-white px-4 py-2 text-sm font-semibold text-[var(--app-heading)]" @onclick="ExpandAllArticleSectionsAsync">Expandir</button>
                                <button class="rounded-xl border border-[var(--app-border-subtle)] bg-white px-4 py-2 text-sm font-semibold text-[var(--app-heading)]" @onclick="CollapseAllArticleSectionsAsync">Contraer</button>
                                @if (!string.IsNullOrWhiteSpace(SectionSearchTerm))
                                {
                                    <button class="rounded-xl border border-[var(--app-border-subtle)] bg-[var(--app-surface-soft)] px-4 py-2 text-sm font-semibold text-[var(--app-heading)]" @onclick="ClearSectionSearchAsync">Limpiar</button>
                                }
                            </div>
                            <div class="flex flex-wrap gap-2 text-xs">
                                <span class="app-inline-chip">@GetVisibleFieldCount(ArticleSections) campos de artículo</span>
                                <span class="app-inline-chip app-inline-chip--warm">@Participants.Count participante(s)</span>
                                <span class="app-inline-chip">@(ArticleForm?.FormName ?? "Sin formulario")</span>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <nav class="register-section-tabs" aria-label="Navegación rápida del formulario">
                @foreach (var item in IndividualSectionTabs)
                {
                    <button type="button"
                            class="register-section-tab @(item.IsWarmAccent ? "register-section-tab--warm" : null)"
                            @onclick="() => ScrollToSectionAsync(item.Target)">
                        @item.Label
                    </button>
                }
            </nav>

            <div class="register-single-layout">
                <div class="register-form-shell space-y-4">
                    @if (!GetFilteredArticleSections().Any())
                    {
                        <AppEmptyState Class="rounded-[2rem] px-6 py-10 text-center shadow-sm" Title="No encontramos secciones o campos con ese criterio" Message="Prueba con otra palabra o limpia la búsqueda para volver a ver todo el formulario." />
                    }
                    else
                    {
                        @foreach (var sectionState in GetFilteredArticleSections())
                        {
                        <section id="@GetSectionAnchor(sectionState.GroupName)" class="register-form-section scroll-mt-24 rounded-[1.6rem] border border-[#d9e5e8] bg-white shadow-sm shadow-slate-200/40">
                            <div class="register-form-section__header border-b bg-gradient-to-r from-[#f4f8f9] to-[#fff7ef] px-4 py-3">
                                <button type="button" class="flex w-full items-center justify-between gap-3 text-left" @onclick="() => ToggleArticleSectionAsync(sectionState.GroupName)">
                                    <div>
                                        <div class="register-form-section__eyebrow">Sección del artículo</div>
                                        <h2 class="text-[15px] font-bold text-[#12343b]">@sectionState.GroupName</h2>
                                        <p class="mt-1 text-xs text-slate-500">@GetVisibleFields(sectionState).Count() campos visibles</p>
                                    </div>
                                    <div class="flex items-center gap-2">
                                        <span class="@GetSectionStateBadgeClass(sectionState.Fields)">@GetSectionStateBadgeLabel(sectionState.Fields)</span>
                                        <span class="rounded-full bg-[#fff1d6] px-3 py-1 text-xs font-semibold text-[#8b5a16]">@GetCompletionLabel(sectionState.Fields)</span>
                                        <span class="rounded-full bg-white px-3 py-1 text-xs font-semibold text-slate-600">@(IsArticleSectionExpanded(sectionState.GroupName) ? "Ocultar" : "Mostrar")</span>
                                    </div>
                                </button>
                            </div>
                            @if (IsArticleSectionExpanded(sectionState.GroupName))
                            {
                                <div class="grid grid-cols-1 gap-3 px-4 py-4 md:grid-cols-2 xl:grid-cols-3">
                                    @foreach (var field in GetVisibleFields(sectionState))
                                    {
                                        <div class="@GetFieldCardClass(field)">
                                            @FieldFragment(field, ArticleSections)
                                        </div>
                                    }
                                </div>
                            }
                        </section>
                        }
                    }

                    <section id="participants-panel" class="register-participants-section rounded-[1.6rem] border border-[#ead8bd] bg-white shadow-sm shadow-slate-200/40">
                    <header class="register-participants-section__header border-b bg-gradient-to-r from-[#fff8ed] to-[#fff2df] px-4 py-3">
                        <div class="flex items-center justify-between gap-3">
                            <button type="button" class="flex items-center gap-3 text-left" @onclick="ToggleParticipantsPanelAsync">
                                <div>
                                    <div class="register-form-section__eyebrow register-form-section__eyebrow--warm">Autores y coautores</div>
                                    <h2 class="text-[15px] font-bold text-[#7a4b17]">Participantes</h2>
                                </div>
                                <span class="rounded-full bg-white px-3 py-1 text-xs font-semibold text-[#8b5a16]">@(IsParticipantsPanelExpanded ? "Ocultar" : "Mostrar")</span>
                            </button>
                            <button class="rounded-xl bg-[#12343b] px-4 py-2 text-sm font-semibold text-white" @onclick="AddParticipant">Agregar</button>
                        </div>
                    </header>
                    @if (IsParticipantsPanelExpanded)
                    {
                    <div class="space-y-3 px-4 py-4">
                        @foreach (var participant in Participants)
                        {
                            <article class="register-participant-card rounded-[1.4rem] border border-[#ead8bd] bg-[#fffdf8] p-3.5">
                                <details open="@(participant.Index == 1)">
                                    <summary class="cursor-pointer list-none">
                                        <div class="flex items-center justify-between gap-3">
                                            <div>
                                                <div class="register-participant-card__eyebrow">Ficha de participante</div>
                                                <h3 class="font-bold text-[#8b5a16]">Participante @participant.Index</h3>
                                                <p class="mt-1 text-xs text-slate-500">@GetParticipantDisplayName(participant)</p>
                                            </div>
                                            <div class="flex items-center gap-2">
                                                <span class="rounded-full bg-[#fff1d6] px-3 py-1 text-xs font-semibold text-[#8b5a16]">@participant.Sections.Sum(x => GetVisibleFields(x).Count()) campos</span>
                                                <span class="@GetParticipantStateBadgeClass(participant)">@GetParticipantStateBadgeLabel(participant)</span>
                                                <span class="rounded-full bg-white px-3 py-1 text-xs font-semibold text-[#2f4858]">@GetParticipantCompletionLabel(participant)</span>
                                                @if (Participants.Count > 1)
                                                {
                                                    <button class="rounded-xl border border-rose-200 bg-rose-50 px-3 py-1.5 text-xs font-semibold text-rose-700" @onclick="() => RequestRemoveParticipant(participant.Index)">Quitar</button>
                                                }
                                            </div>
                                        </div>
                                    </summary>

                                    <div class="mt-4 space-y-4">
                                        @foreach (var sectionState in participant.Sections)
                                        {
                                            <details class="rounded-2xl border border-[#e8edf0] bg-white p-3.5" open>
                                                <summary class="cursor-pointer text-sm font-semibold text-[#12343b]">
                                                    <span>@sectionState.GroupName</span>
                                                    <span class="ml-2 rounded-full bg-[#eef5f6] px-2 py-1 text-[11px] font-semibold text-[#2f4858]">@GetCompletionLabel(sectionState.Fields)</span>
                                                </summary>
                                                <div class="mt-3 grid grid-cols-1 gap-3 md:grid-cols-2 xl:grid-cols-3">
                                                    @foreach (var field in GetVisibleFields(sectionState))
                                                    {
                                                        <div class="@GetFieldCardClass(field)">
                                                            @FieldFragment(field, participant.Sections)
                                                        </div>
                                                    }
                                                </div>
                                            </details>
                                        }
                                    </div>
                                </details>
                            </article>
                        }
                    </div>
                    }
                    </section>
                </div>
            </div>

            <button type="button" class="register-summary-trigger" title="Resumen del registro" aria-label="Abrir resumen del registro" @onclick="OpenSummaryDrawer">
                <span class="register-summary-trigger__icon" aria-hidden="true">
                    <span class="register-summary-trigger__sheet">
                        <span class="register-summary-trigger__line"></span>
                        <span class="register-summary-trigger__line"></span>
                        <span class="register-summary-trigger__line"></span>
                    </span>
                </span>
            </button>

            <div class="register-summary-overlay @(IsSummaryDrawerOpen ? "register-summary-overlay--open" : null)" @onclick="CloseSummaryDrawer"></div>
            <div class="register-summary-drawer @(IsSummaryDrawerOpen ? "register-summary-drawer--open" : null)" aria-hidden="@(!IsSummaryDrawerOpen)">
                <div class="register-summary-drawer__header">
                    <div>
                        <div class="text-[11px] font-semibold uppercase tracking-[0.18em] text-white/70">Resumen del registro</div>
                        <h3 class="mt-1 text-lg font-black text-white">Control del artículo actual</h3>
                    </div>
                    <button type="button" class="register-summary-drawer__close" @onclick="CloseSummaryDrawer">Cerrar</button>
                </div>
                <div class="register-summary-drawer__body">
                    <RegisterArticleSidebarPanel IsSaving="IsSaving"
                                                 OnCancel="GoBack"
                                                 OnSave="SaveAsync"
                                                 OnSubmitForReview="SubmitForReviewAsync"
                                                 OnReset="ClearFormAsync"
                                                 OnReload="ReloadFormsFromConfigurationAsync"
                                                 OnBack="GoBack"
                                                 ShowSaveButton="false"
                                                 ShowReloadButton="false"
                                                 ShowBackButton="false"
                                                 ShowResetButton="true"
                                                 SubmitLabel="Enviar a revisión"
                                                 CancelLabel="Cancelar"
                                                 ResetLabel="Limpiar formulario"
                                                 PanelTitle="Resumen del registro"
                                                 VisibleFieldCount="@GetVisibleFieldCount()"
                                                 CompletedFieldCount="@GetCompletedVisibleFieldCount()"
                                                 MissingRequiredCount="@GetMissingRequiredTotalCount()"
                                                 ParticipantsCount="@Participants.Count"
                                                 FormName="@(ArticleForm?.FormName ?? "Sin formulario")"
                                                 ArticleSectionsCount="@ArticleSections.Count"
                                                 PreviewTitle="@GetPreviewTitle()"
                                                 ParticipantNames="@GetParticipantNames().ToList()"
                                                 ArticleCompletionLabel="@GetCompletionLabel(ArticleSections.SelectMany(x => x.Fields))"
                                                 ParticipantsCompletionSummary="@GetParticipantsCompletionSummary()"
                                                 QuickAccessItems="@QuickAccessItems"
                                                 OnQuickAction="HandleQuickActionAsync" />
                </div>
            </div>
        }
        else
        {
            <AuthorRegistrationMatrixPanel AllowedArticleFieldIds="@GetAllowedArticleMatrixFieldIds()"
                                           AllowedParticipantFieldIds="@GetAllowedParticipantMatrixFieldIds()"
                                           MatrixName="Registro masivo de artículos del autor"
                                           OnSubmitted="HandleMassRegistrationSubmittedAsync" />
        }
    }
</div>

@code {
    [Parameter] public int ArticleId { get; set; }

    private ResolvedFormDto? ArticleForm { get; set; }
    private ResolvedFormDto? ParticipantForm { get; set; }
    private List<DynamicSectionState> ArticleSections { get; set; } = new();
    private List<DynamicParticipantState> Participants { get; set; } = new();
    private string SectionSearchTerm { get; set; } = string.Empty;
    private int? PendingRemoveParticipantIndex { get; set; }
    private HashSet<string> ExpandedArticleSections { get; set; } = new(StringComparer.OrdinalIgnoreCase);
    private bool IsParticipantsPanelExpanded { get; set; } = true;
    private bool IsLoading { get; set; } = true;
    private bool IsSaving { get; set; }
    private bool IsSummaryDrawerOpen { get; set; }
    private bool IsAdminExperience { get; set; }
    private RegisterArticleMode CurrentMode { get; set; } = RegisterArticleMode.Single;
    private string ErrorMessage { get; set; } = string.Empty;
    private string SuccessMessage { get; set; } = string.Empty;
    private string WarningMessage { get; set; } = string.Empty;
    private IReadOnlyList<RegisterArticleQuickAccessItem> QuickAccessItems =>
        GetFilteredArticleSections()
            .Take(6)
            .Select(sectionState => new RegisterArticleQuickAccessItem
            {
                Label = sectionState.GroupName,
                Target = GetSectionAnchor(sectionState.GroupName)
            })
            .Concat([
                new RegisterArticleQuickAccessItem
                {
                    Label = "Participantes",
                    Target = "participants-panel",
                    IsWarmAccent = true
                },
                new RegisterArticleQuickAccessItem
                {
                    Label = "Configuración",
                    Target = "configuration",
                    IsButton = true
                },
                new RegisterArticleQuickAccessItem
                {
                    Label = IsAdminExperience ? "Matriz de registro" : "Registro en masa",
                    Target = "mass-registration",
                    IsButton = true,
                    IsWarmAccent = true
                },
                new RegisterArticleQuickAccessItem
                {
                    Label = "Listado",
                    Target = "articles-list",
                    IsButton = true
                }
            ])
            .ToList();

    private IReadOnlyList<RegisterArticleQuickAccessItem> IndividualSectionTabs =>
        GetFilteredArticleSections()
            .Select(sectionState => new RegisterArticleQuickAccessItem
            {
                Label = sectionState.GroupName,
                Target = GetSectionAnchor(sectionState.GroupName)
            })
            .Concat([
                new RegisterArticleQuickAccessItem
                {
                    Label = "Participantes",
                    Target = "participants-panel",
                    IsWarmAccent = true
                }
            ])
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadRoleStateAsync();
        await LoadUiStateAsync();
        await LoadFormsAsync();
    }

    private async Task LoadRoleStateAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        IsAdminExperience = state.User.IsInRole("Admin");
    }

    private async Task UpdateSectionSearchTermAsync(string value)
    {
        SectionSearchTerm = value;
        await PersistUiStateAsync();
    }

    private async Task ScrollToSectionAsync(string target)
    {
        if (string.IsNullOrWhiteSpace(target))
        {
            return;
        }

        await JS.InvokeVoidAsync("registerArticleScrollToSection", target);
    }

    private Task OnSearchInputChanged(ChangeEventArgs args)
        => UpdateSectionSearchTermAsync(Convert.ToString(args.Value) ?? string.Empty);

    private Task HandleQuickActionAsync(string target)
    {
        switch (target)
        {
            case "configuration":
                GoToConfiguration();
                break;
            case "mass-registration":
                GoToBulkImport();
                break;
            case "articles-list":
                GoToArticlesList();
                break;
        }

        return Task.CompletedTask;
    }

    private void SetMode(RegisterArticleMode mode)
    {
        if (mode == RegisterArticleMode.Mass && IsAdminExperience)
        {
            GoToRegistrationMatrix();
            return;
        }

        CurrentMode = mode;
        if (mode == RegisterArticleMode.Mass)
        {
            IsSummaryDrawerOpen = false;
        }
    }

    private void OpenSecondaryRegistrationMode()
    {
        if (IsAdminExperience)
        {
            GoToRegistrationMatrix();
            return;
        }

        SetMode(RegisterArticleMode.Mass);
    }

    private async Task HandleMassRegistrationSubmittedAsync(string message)
    {
        ErrorMessage = string.Empty;
        WarningMessage = string.Empty;
        SuccessMessage = message;
        CurrentMode = RegisterArticleMode.Mass;
        await InvokeAsync(StateHasChanged);
    }

    private void OpenSummaryDrawer() => IsSummaryDrawerOpen = true;
    private void CloseSummaryDrawer() => IsSummaryDrawerOpen = false;

    private async Task LoadFormsAsync()
    {
        IsLoading = true;
        try
        {
            var articleTask = FormConfigurationClient.GetActiveResolvedFormAsync("Article", "ArticleManualForm");
            var participantTask = FormConfigurationClient.GetActiveResolvedFormAsync("ArticleParticipant", "ArticleParticipantForm");
            await Task.WhenAll(articleTask, participantTask);

            ArticleForm = articleTask.Result;
            ParticipantForm = participantTask.Result;

            if (ArticleForm is null)
            {
                ErrorMessage = "No se encontró un formulario activo para Article.";
                return;
            }

            ArticleSections = BuildSections(ArticleForm);
            InitializeExpandedSections();
            await LoadCatalogsAsync(ArticleSections);
            Participants.Clear();

            if (ParticipantForm is not null)
            {
                AddParticipant();
            }

            await ApplyExternalDraftAsync();

            _ = await LocalStorage.GetItemAsync<long?>("ui.form-configuration.version");

            if (ArticleId > 0)
            {
                WarningMessage = "La edición dinámica todavía no está implementada. El flujo funcional de este sprint es registro manual nuevo.";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"No fue posible cargar la configuración dinámica: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private List<DynamicSectionState> BuildSections(ResolvedFormDto form)
    {
        return form.Sections
            .OrderBy(x => x.DisplayOrder)
            .Select(section => new DynamicSectionState
            {
                GroupName = section.GroupName,
                DisplayOrder = section.DisplayOrder,
                Fields = section.Fields.OrderBy(x => x.DisplayOrder).Select(CreateFieldState).ToList()
            })
            .ToList();
    }

    private DynamicFieldState CreateFieldState(ResolvedFormFieldDto field)
    {
        var state = new DynamicFieldState { Definition = field };

        if (!string.IsNullOrWhiteSpace(field.DefaultValue))
        {
            if (IsBoolField(state) && bool.TryParse(field.DefaultValue, out var defaultBool)) state.BoolValue = defaultBool;
            else if (IsIntField(state) && int.TryParse(field.DefaultValue, out var defaultInt)) state.IntValue = defaultInt;
            else if (IsDecimalField(state) && decimal.TryParse(field.DefaultValue, out var defaultDecimal)) state.DecimalValue = defaultDecimal;
            else if (IsDateField(state) && DateTime.TryParse(field.DefaultValue, out var defaultDate)) state.DateValue = defaultDate;
            else state.TextValue = field.DefaultValue;
        }

        return state;
    }

    private async Task LoadCatalogsAsync(List<DynamicSectionState> sections)
    {
        foreach (var field in sections.SelectMany(x => x.Fields))
        {
            if (!NeedsCatalogItems(field))
            {
                continue;
            }

            if (IsDependentCatalogField(field))
            {
                field.CatalogItems = new List<CatalogItemDto>();
                continue;
            }

            field.CatalogItems = await FormConfigurationClient.GetCatalogItemsByFieldAsync(field.Definition.FieldId);
        }
    }
    private async Task SaveAsync()
    {
        if (!await PrepareSubmissionAsync())
        {
            return;
        }

        try
        {
            IsSaving = true;

            var request = BuildRegisterRequest();
            var result = await ApiClient.PostAsync<RegisterArticleAggregateRequest, RegisterArticleAggregateResponse>("api/articles/aggregate", request);

            if (result is null)
            {
                ErrorMessage = "El backend no devolvió un resultado al guardar el artículo.";
                return;
            }

            SuccessMessage = $"Artículo registrado correctamente con Id {result.ArticleId}.";
            await ResetFormAsync();
        }
        catch (Exception ex)
        {
            ErrorMessage = $"No fue posible guardar el artículo: {ex.Message}";
        }
        finally
        {
            IsSaving = false;
        }
    }

    private async Task SubmitForReviewAsync()
    {
        if (!await PrepareSubmissionAsync())
        {
            return;
        }

        try
        {
            IsSaving = true;

            var request = BuildRegisterRequest();
            var result = await ApiClient.PostAsync<RegisterArticleAggregateRequest, BulkImportActionResultDto>("api/articles/aggregate/submit-for-review", request);

            if (result?.Batch?.Summary is null)
            {
                ErrorMessage = "El backend no devolvió el lote de revisión esperado.";
                return;
            }

            SuccessMessage = $"Envío enviado a revisión correctamente. Lote {result.Batch.Summary.BatchCode} creado para staging.";
            WarningMessage = result.Message;
            await ResetFormAsync();
        }
        catch (Exception ex)
        {
            ErrorMessage = $"No fue posible enviar el artículo a revisión: {ex.Message}";
        }
        finally
        {
            IsSaving = false;
        }
    }

    private Task<bool> PrepareSubmissionAsync()
    {
        ErrorMessage = string.Empty;
        SuccessMessage = string.Empty;
        WarningMessage = string.Empty;

        if (ArticleId > 0)
        {
            ErrorMessage = "La edición del registro dinámico aún no está habilitada.";
            return Task.FromResult(false);
        }

        var validationError = ValidateForm();
        if (!string.IsNullOrWhiteSpace(validationError))
        {
            ErrorMessage = validationError;
            return Task.FromResult(false);
        }

        return Task.FromResult(true);
    }

    private RegisterArticleAggregateRequest BuildRegisterRequest()
    {
        return new RegisterArticleAggregateRequest
        {
            FormKey = ArticleForm?.FormKey,
            Article = BuildArticleCore(),
            Venue = BuildVenueRequest(),
            VenueMetric = BuildVenueMetricRequest(),
