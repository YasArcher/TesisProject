    private static bool ContainsIgnoreCase(string? value, string term)
        => !string.IsNullOrWhiteSpace(value) && value.Contains(term, StringComparison.OrdinalIgnoreCase);

    private async Task SetActiveTabAsync(string tabName)
    {
        ActiveTab = tabName;
        await PersistUiStateAsync();
    }

    private async Task LoadUiStateAsync()
    {
        var state = await LocalStorage.GetItemAsync<ConfigurationUiState>("ui.configuration.state");
        if (state is null)
        {
            return;
        }

        ActiveTab = string.IsNullOrWhiteSpace(state.ActiveTab) ? ActiveTab : state.ActiveTab;
        FormSearchTerm = state.FormSearchTerm ?? string.Empty;
        FieldSearchTerm = state.FieldSearchTerm ?? string.Empty;
        CatalogSearchTerm = state.CatalogSearchTerm ?? string.Empty;
        OptionSearchTerm = state.OptionSearchTerm ?? string.Empty;
        SelectedCatalogKey = string.IsNullOrWhiteSpace(state.SelectedCatalogKey) || string.Equals(state.SelectedCatalogKey, "venues", StringComparison.OrdinalIgnoreCase)
            ? SelectedCatalogKey
            : state.SelectedCatalogKey;
        SelectedFormId = state.SelectedFormId;
        SelectedDynamicFieldId = state.SelectedDynamicFieldId;
    }

    private async Task PersistUiStateAsync()
    {
        await LocalStorage.SetItemAsync("ui.configuration.state", new ConfigurationUiState
        {
            ActiveTab = ActiveTab,
            FormSearchTerm = FormSearchTerm,
            FieldSearchTerm = FieldSearchTerm,
            CatalogSearchTerm = CatalogSearchTerm,
            OptionSearchTerm = OptionSearchTerm,
            SelectedCatalogKey = SelectedCatalogKey,
            SelectedFormId = SelectedFormId,
            SelectedDynamicFieldId = SelectedDynamicFieldId
        });
    }

    private async Task NotifyFormConfigurationChangedAsync()
        => await LocalStorage.SetItemAsync("ui.form-configuration.version", DateTimeOffset.UtcNow.ToUnixTimeMilliseconds());

    private bool HasStatusMessage => !string.IsNullOrWhiteSpace(ErrorMessage) || !string.IsNullOrWhiteSpace(Message);

    private string CurrentStatusVariant => !string.IsNullOrWhiteSpace(ErrorMessage) ? "error" : "success";

    private string CurrentStatusTitle => !string.IsNullOrWhiteSpace(ErrorMessage) ? "No pude completar la acción" : "Cambio aplicado";

    private string CurrentStatusMessage => !string.IsNullOrWhiteSpace(ErrorMessage) ? ErrorMessage : Message;

    private Task CloseStatusModal()
    {
        ErrorMessage = string.Empty;
        Message = string.Empty;
        return Task.CompletedTask;
    }

    private enum PendingConfigAction
    {
        None,
        DeleteForm,
        DeleteFormField,
        DeleteFieldOption
    }

    private sealed class ConfigurationUiState
    {
        public string ActiveTab { get; set; } = "forms";
        public string? FormSearchTerm { get; set; }
        public string? FieldSearchTerm { get; set; }
        public string? CatalogSearchTerm { get; set; }
        public string? OptionSearchTerm { get; set; }
        public string? SelectedCatalogKey { get; set; }
        public int? SelectedFormId { get; set; }
        public int? SelectedDynamicFieldId { get; set; }
    }
}
