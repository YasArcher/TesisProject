    private void RequestDeleteSelectedForm()
    {
        if (SelectedForm is null) return;

        PendingAction = PendingConfigAction.DeleteForm;
        PendingFormId = SelectedForm.FormId;
        PendingConfirmationTitle = $"Eliminar formulario '{SelectedForm.FormName}'";
        PendingConfirmationMessage = "Se eliminará el formulario y sus asignaciones actuales. Esta acción afecta la configuración visible del registro.";
    }

    private void RequestDeleteFormField(FormFieldAdminDto field)
    {
        if (!SelectedFormId.HasValue) return;

        PendingAction = PendingConfigAction.DeleteFormField;
        PendingFormId = SelectedFormId.Value;
        PendingFormFieldId = field.FormFieldId;
        PendingConfirmationTitle = $"Quitar campo '{field.FieldLabel}'";
        PendingConfirmationMessage = "El campo dejará de renderizarse en este formulario, pero no se eliminará del catálogo general.";
    }

    private void RequestDeleteFieldOption(DynamicFieldOptionDto option)
    {
        if (!SelectedDynamicFieldId.HasValue) return;

        PendingAction = PendingConfigAction.DeleteFieldOption;
        PendingFieldId = SelectedDynamicFieldId.Value;
        PendingOptionId = option.DynamicFieldOptionId;
        PendingConfirmationTitle = $"Eliminar opción '{option.OptionLabel}'";
        PendingConfirmationMessage = "La opción dejará de estar disponible para selección en el campo dinámico actual.";
    }

    private async Task ConfirmPendingActionAsync()
    {
        await RunActionAsync(async () =>
        {
            switch (PendingAction)
            {
                case PendingConfigAction.DeleteForm:
                    await FormConfigurationClient.DeleteFormAsync(PendingFormId);
                    Message = "Formulario eliminado correctamente.";
                    SelectedForm = null;
                    SelectedFormId = null;
                    SelectedFormKey = null;
                    SelectedFormFields = new List<FormFieldAdminDto>();
                    await ReloadAsync();
                    await NotifyFormConfigurationChangedAsync();
                    break;

                case PendingConfigAction.DeleteFormField:
                    await FormConfigurationClient.DeleteFormFieldAsync(PendingFormId, PendingFormFieldId);
                    Message = "Campo desasignado del formulario.";
                    SelectedFormFields = await FormConfigurationClient.GetFormFieldsAsync(PendingFormId);
                    await NotifyFormConfigurationChangedAsync();
                    break;

                case PendingConfigAction.DeleteFieldOption:
                    await FormConfigurationClient.DeleteFieldOptionAsync(PendingFieldId, PendingOptionId);
                    Message = "Opción eliminada correctamente.";
                    DynamicFieldOptions = await FormConfigurationClient.GetFieldOptionsAsync(PendingFieldId);
                    optionDisplayState = DynamicFieldOptions.ToDictionary(x => x.DynamicFieldOptionId, x => x.IsActive);
                    break;
            }

            CancelPendingConfirmation();
        });
    }

    private void CancelPendingConfirmation()
    {
        PendingAction = PendingConfigAction.None;
        PendingConfirmationTitle = string.Empty;
        PendingConfirmationMessage = string.Empty;
        PendingFormId = 0;
        PendingFormFieldId = 0;
        PendingFieldId = 0;
        PendingOptionId = 0;
    }

