    private void ResetQueryStateForProvider(bool useSampleValues)
    {
        if (SelectedProvider is null)
        {
            QueryMode = "general";
            QueryText = string.Empty;
            InstitutionName = string.Empty;
            PrimaryAuthor = string.Empty;
            RestrictAuthorToInstitution = false;
            return;
        }

        var isScopus = string.Equals(SelectedProvider.ProviderKey, "scopus", StringComparison.OrdinalIgnoreCase);
        if (!isScopus && QueryMode is "author" or "affiliation")
        {
            QueryMode = "general";
        }

        if (QueryMode == "doi")
        {
            QueryText = useSampleValues ? "10.1038/nphys1170" : string.Empty;
            RestrictAuthorToInstitution = false;
        }
        else if (QueryMode == "affiliation")
        {
            QueryText = string.Empty;
            RestrictAuthorToInstitution = true;
        }
        else if (QueryMode == "author")
        {
            QueryText = string.Empty;
        }
        else
        {
            QueryText = useSampleValues
                ? SelectedProvider.ProviderKey switch
                {
                    "scopus" => "TITLE-ABS-KEY(machine learning)",
                    "crossref" => "machine learning in education",
                    "openalex" => "artificial intelligence higher education",
                    "semantic-scholar" => "deep learning scientific articles",
                    _ => "scientific article search"
                }
                : string.Empty;
        }

        if (isScopus)
        {
            InstitutionName = QueryMode == "affiliation" || RestrictAuthorToInstitution
                ? DefaultInstitutionName
                : string.Empty;
            PrimaryAuthor = useSampleValues ? "Ruben Nogales" : string.Empty;
        }
        else
        {
            InstitutionName = string.Empty;
            PrimaryAuthor = string.Empty;
            RestrictAuthorToInstitution = false;
        }
    }

    private void EnsureValidQueryModeForProvider()
    {
        if (SelectedProvider is null)
        {
            QueryMode = "general";
            return;
        }

        var isScopus = string.Equals(SelectedProvider.ProviderKey, "scopus", StringComparison.OrdinalIgnoreCase);
        if (!isScopus && QueryMode is "author" or "affiliation")
        {
            QueryMode = "general";
        }
    }

    private async Task RunQueryAsync()
    {
        if (SelectedProvider is null)
        {
            ErrorMessage = "Selecciona un proveedor antes de ejecutar la consulta.";
            return;
        }

        try
        {
            IsRunningQuery = true;
            ErrorMessage = null;
            SuccessMessage = null;
            ResultsSearchText = string.Empty;
            FilterOnlyWithDoi = false;
            FilterOnlyOpenAccess = false;

            if (string.Equals(SelectedProvider.ProviderKey, "scopus", StringComparison.OrdinalIgnoreCase))
            {
                if (QueryMode == "author" && string.IsNullOrWhiteSpace(PrimaryAuthor))
                {
                    ErrorMessage = "Debes escribir el autor principal antes de consultar Scopus.";
                    return;
                }

            }

            LastResult = await ExternalApiExplorerClient.QueryAsync(new ExternalApiQueryRequest
            {
                ProviderKey = SelectedProvider.ProviderKey,
                QueryText = QueryText.Trim(),
                QueryMode = QueryMode,
                InstitutionName = GetRequestInstitutionName(),
                PrimaryAuthor = PrimaryAuthor.Trim(),
                SelectedAuthorId = SelectedAuthorId,
                SelectedAffiliationId = SelectedAffiliationId,
                MaxResults = MaxResults
            });
            LastExecutedQueryMode = QueryMode;
            LastExecutedQueryText = QueryText.Trim();
            LastExecutedPrimaryAuthor = PrimaryAuthor.Trim();
            LastExecutedInstitutionName = GetRequestInstitutionName() ?? string.Empty;
            ResultsPage = 1;
            await SaveRecentQueryAsync();

            if (LastResult is not null)
            {
                SuccessMessage = $"{LastResult.Message} Artículos detectados: {LastResult.Articles.Count}.";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsRunningQuery = false;
        }
    }

