    private bool MatchesResultsSearch(ExternalArticlePreviewDto article)
    {
        if (string.IsNullOrWhiteSpace(ResultsSearchText))
        {
            return true;
        }

        var term = ResultsSearchText.Trim();
        return Contains(article.Title, term)
               || Contains(article.Doi, term)
               || Contains(article.JournalName, term)
               || Contains(article.Authors, term)
               || Contains(article.Publisher, term)
               || Contains(article.DocumentType, term);
    }

    private static bool Contains(string? source, string value)
        => !string.IsNullOrWhiteSpace(source)
           && source.Contains(value, StringComparison.OrdinalIgnoreCase);

    private async Task SaveRecentQueryAsync()
    {
        if (SelectedProvider is null)
        {
            return;
        }

        var item = new ExternalApiQuerySidebar.ExternalApiRecentQueryItem
        {
            ProviderKey = SelectedProvider.ProviderKey,
            ProviderName = SelectedProvider.DisplayName,
            QueryMode = QueryMode,
            QueryText = QueryText,
            InstitutionName = GetRequestInstitutionName() ?? string.Empty,
            PrimaryAuthor = PrimaryAuthor,
            MaxResults = MaxResults,
            ExecutedAtLabel = DateTime.Now.ToString("dd/MM/yyyy HH:mm")
        };

        RecentQueries = RecentQueries
            .Where(existing => !(string.Equals(existing.ProviderKey, item.ProviderKey, StringComparison.OrdinalIgnoreCase)
                                 && string.Equals(existing.QueryMode, item.QueryMode, StringComparison.OrdinalIgnoreCase)
                                 && string.Equals(existing.QueryText, item.QueryText, StringComparison.Ordinal)
                                 && string.Equals(existing.PrimaryAuthor, item.PrimaryAuthor, StringComparison.Ordinal)
                                 && string.Equals(existing.InstitutionName, item.InstitutionName, StringComparison.Ordinal)))
            .Prepend(item)
            .Take(8)
            .ToList();

        await LocalStorage.SetItemAsync(RecentQueriesStorageKey, RecentQueries);
    }

    private async Task HandleResolutionCandidateSelectionAsync(ExternalApiResultsPanel.ExternalApiResolutionSelectionRequest selection)
    {
        if (selection is null || string.IsNullOrWhiteSpace(selection.CandidateId))
        {
            return;
        }

        switch (selection.Target)
        {
            case "author":
                SelectedAuthorId = selection.CandidateId;
                if (!string.IsNullOrWhiteSpace(selection.DisplayName))
                {
                    PrimaryAuthor = selection.DisplayName;
                }
                break;
            case "affiliation":
                SelectedAffiliationId = selection.CandidateId;
                if (!string.IsNullOrWhiteSpace(selection.DisplayName))
                {
                    InstitutionName = selection.DisplayName;
                }
                break;
            default:
                return;
        }

        await RunQueryAsync();
    }

