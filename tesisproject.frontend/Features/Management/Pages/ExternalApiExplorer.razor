    private async Task SendToRegisterAsync(ExternalArticlePreviewDto article)
    {
        if (LastResult is null)
        {
            ErrorMessage = "Primero ejecuta una consulta válida antes de enviar un artículo al registro.";
            return;
        }

        var draftArticle = article;
        if (SelectedProvider is not null)
        {
            try
            {
                var enriched = await ExternalApiExplorerClient.EnrichArticleAsync(SelectedProvider.ProviderKey, article);
                if (enriched is not null)
                {
                    draftArticle = enriched;
                }
            }
            catch
            {
                draftArticle = article;
            }
        }

        await LocalStorage.SetItemAsync("external-api.register-draft", new ExternalArticleRegistrationDraftDto
        {
            ProviderKey = LastResult.ProviderKey,
            ProviderName = LastResult.ProviderName,
            QueryMode = QueryMode,
            Article = draftArticle
        });

        NavManager.NavigateTo("/articulos/registrar");
    }

