    private async Task PrepareInstitutionalDatasetAsync()
    {
        if (!CanUseScopusInstitutionalDataset)
        {
            ErrorMessage = "Selecciona Scopus antes de preparar el dataset institucional.";
            return;
        }

        try
        {
            IsLoadingInstitutionalDataset = true;
            ErrorMessage = null;
            SuccessMessage = null;

            InstitutionalDatasetResult = await ExternalApiExplorerClient.QueryAsync(new ExternalApiQueryRequest
            {
                ProviderKey = "scopus",
                QueryMode = "affiliation",
                InstitutionName = DefaultInstitutionName,
                MaxResults = 0
            });

            if (InstitutionalDatasetResult is not null)
            {
                SuccessMessage = $"{InstitutionalDatasetResult.Message} Dataset preliminar: {InstitutionalDatasetArticles.Length} artículo(s) listos para descarga.";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"No pude preparar el dataset institucional: {ex.Message}";
        }
        finally
        {
            IsLoadingInstitutionalDataset = false;
        }
    }

    private async Task DownloadInstitutionalDatasetCsvAsync()
    {
        if (!InstitutionalDatasetArticles.Any())
        {
            ErrorMessage = "Primero prepara el dataset institucional antes de descargarlo.";
            return;
        }

        var rows = new List<string>
        {
            "Titulo,DOI,Revista,Anio,Autores,Fuente,FechaPublicacion"
        };

        rows.AddRange(InstitutionalDatasetArticles.Select(article => string.Join(",",
            ExternalApiExplorerPageHelper.EscapeCsv(article.Title),
            ExternalApiExplorerPageHelper.EscapeCsv(article.Doi),
            ExternalApiExplorerPageHelper.EscapeCsv(article.JournalName),
            ExternalApiExplorerPageHelper.EscapeCsv(article.PublicationYear?.ToString()),
            ExternalApiExplorerPageHelper.EscapeCsv(article.Authors),
            ExternalApiExplorerPageHelper.EscapeCsv(article.ExternalSource),
            ExternalApiExplorerPageHelper.EscapeCsv(article.PublicationDate))));

        await ExportJs.ExportCsv($"dataset-uta-scopus-{DateTime.Now:yyyyMMdd-HHmm}.csv", string.Join(Environment.NewLine, rows));
    }

    private async Task DownloadInstitutionalDatasetJsonAsync()
    {
        if (!InstitutionalDatasetArticles.Any())
        {
            ErrorMessage = "Primero prepara el dataset institucional antes de descargarlo.";
            return;
        }

        var payload = JsonSerializer.Serialize(InstitutionalDatasetArticles, new JsonSerializerOptions
        {
            WriteIndented = true
        });

        await ExportJs.DownloadFile(
            $"dataset-uta-scopus-{DateTime.Now:yyyyMMdd-HHmm}.json",
            "application/json",
            System.Text.Encoding.UTF8.GetBytes(payload));
    }

    private string GetArticleSelectionKey(ExternalArticlePreviewDto article)
    {
        var baseId = !string.IsNullOrWhiteSpace(article.ExternalId)
            ? article.ExternalId
            : !string.IsNullOrWhiteSpace(article.Doi)
                ? article.Doi
                : $"{article.Title}|{article.PublicationYear}|{article.JournalName}";

        var providerKey = SelectedProvider?.ProviderKey ?? LastResult?.ProviderKey ?? "unknown";
        return $"{providerKey}::{baseId}";
    }

    private bool IsArticleSelected(ExternalArticlePreviewDto article)
        => SelectedExternalArticles.ContainsKey(GetArticleSelectionKey(article));

    private void ToggleArticleSelection(ExternalArticlePreviewDto article, object? value)
    {
        var isChecked = value is bool boolValue && boolValue;
        var key = GetArticleSelectionKey(article);

        if (isChecked)
        {
            SelectedExternalArticles[key] = new SelectedExternalArticleItem
            {
                Key = key,
                ProviderKey = SelectedProvider?.ProviderKey ?? LastResult?.ProviderKey ?? string.Empty,
                ProviderName = SelectedProvider?.DisplayName ?? LastResult?.ProviderName ?? string.Empty,
                Article = article
            };
        }
        else
        {
            SelectedExternalArticles.Remove(key);
        }
    }

