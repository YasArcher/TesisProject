    private Task HandleQueryModeChangedAsync(string value)
    {
        QueryMode = string.IsNullOrWhiteSpace(value) ? "general" : value;
        ErrorMessage = null;
        SuccessMessage = null;
        LastResult = null;
        ResultsPage = 1;
