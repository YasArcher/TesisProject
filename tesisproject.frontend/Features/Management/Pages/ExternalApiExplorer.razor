@page "/management/externalapis"
@using Blazored.LocalStorage
@using tesisproject.frontend.Features.Management.Components
@using tesisproject.frontend.SharedUI
@using tesisproject.shared.DTOs.ExternalApis
@using tesisproject.shared.DTOs.Imports
@inject IExternalApiExplorerClient ExternalApiExplorerClient
@inject IBulkImportClient BulkImportClient
@inject ILocalStorageService LocalStorage
@inject NavigationManager NavManager

<PageTitle>Explorador de APIs externas</PageTitle>

<div class="app-page-shell external-api-page">
    <div class="external-api-hero mb-5 rounded-[1.8rem] p-5 text-white shadow-sm">
        <div class="flex flex-col gap-5 lg:flex-row lg:items-center lg:justify-between">
            <div class="flex items-start gap-4">
                <div class="external-api-hero__icon">
                    <i class="bi bi-cloud-arrow-down"></i>
                </div>
                <div>
                    <div class="text-xs font-semibold uppercase tracking-[0.24em] text-white/70">Conectores académicos</div>
                    <h1 class="mt-1 text-2xl font-black md:text-3xl">Explorador de APIs externas</h1>
                    <p class="mt-2 max-w-2xl text-sm leading-6 text-white/78">
                        Consulta proveedores académicos, revisa metadatos y envía artículos seleccionados al staging sin salir del flujo institucional.
                    </p>
                </div>
            </div>
            <div class="external-api-hero__badges">
                <span><i class="bi bi-search"></i> Búsqueda asistida</span>
                <span><i class="bi bi-database-check"></i> Staging conectado</span>
                <span><i class="bi bi-filetype-json"></i> JSON auditable</span>
            </div>
        </div>
    </div>

    <AppStatusModal Visible="@HasStatusMessage"
                    Variant="@CurrentStatusVariant"
                    Eyebrow="APIs externas"
                    Title="@CurrentStatusTitle"
                    Message="@CurrentStatusMessage"
                    OnClose="CloseStatusModal" />
    <ExternalApiArticleDetailPanel Article="SelectedArticleDetail" OnClose="CloseArticleDetail" />

    @if (IsLoading)
    {
        <div class="rounded-3xl border border-[#dbe6ef] bg-white p-6 text-center text-slate-600 shadow-sm">Cargando proveedores externos...</div>
    }
    else
    {
        <div class="external-api-workspace grid grid-cols-1 gap-6 xl:grid-cols-[0.88fr_1.12fr]">
            <ExternalApiQuerySidebar Providers="Providers"
                                     SelectedProvider="SelectedProvider"
                                     QueryMode="QueryMode"
                                     QueryModeChanged="@(value => QueryMode = value)"
                                     MaxResults="MaxResults"
                                     MaxResultsChanged="@(value => MaxResults = value)"
                                     QueryText="QueryText"
                                     QueryTextChanged="@(value => QueryText = value)"
                                     InstitutionName="InstitutionName"
                                     InstitutionNameChanged="@(value => InstitutionName = value)"
                                     PrimaryAuthor="PrimaryAuthor"
                                     PrimaryAuthorChanged="@(value => PrimaryAuthor = value)"
                                     CoAuthor="CoAuthor"
                                     CoAuthorChanged="@(value => CoAuthor = value)"
                                     IsRunningQuery="IsRunningQuery"
                                     OnSelectProvider="SelectProvider"
                                     OnRunQuery="RunQueryAsync"
                                     OnUseSample="UseQuerySample" />

            <ExternalApiResultsPanel Result="LastResult"
                                     QueryMode="QueryMode"
                                     CurrentResults="CurrentResults"
                                     ResultsPage="ResultsPage"
                                     TotalResultsPages="TotalResultsPages"
                                     ResultsPageSize="ResultsPageSize"
                                     ResultsPageSizeChanged="ChangeResultsPageSizeAsync"
                                     OnPreviousPage="PreviousResultsPage"
                                     OnNextPage="NextResultsPage"
                                     SelectedArticles="SelectedArticleLookup"
                                     IsArticleSelected="IsArticleSelected"
                                     OnToggleSelection="HandleArticleSelectionChanged"
                                     OnRemoveSelectedArticle="RemoveSelectedArticle"
                                     OnClearSelectedArticles="ClearSelectedArticles"
                                     OnSendSelectedToStaging="SendSelectedToStagingAsync"
                                     IsSendingSelectionToStaging="IsSendingSelectionToStaging"
                                     OnOpenDetail="OpenArticleDetail"
                                     OnSendToRegister="SendToRegisterAsync"
                                     OnSendToStaging="SendToStagingAsync"
                                     IsSendingToStaging="IsSendingToStaging"
                                     FormattedJsonPreview="GetFormattedJsonPreview()" />
        </div>
    }
</div>

@code {
    private sealed class SelectedExternalArticleItem
    {
        public string Key { get; set; } = string.Empty;
        public string ProviderKey { get; set; } = string.Empty;
        public string ProviderName { get; set; } = string.Empty;
        public ExternalArticlePreviewDto Article { get; set; } = new();
    }

    private List<ExternalApiProviderDto> Providers = new();
    private ExternalApiProviderDto? SelectedProvider;
    private ExternalApiQueryResultDto? LastResult;
    private string QueryText = string.Empty;
    private string QueryMode = "general";
    private string InstitutionName = string.Empty;
    private string PrimaryAuthor = string.Empty;
    private string CoAuthor = string.Empty;
    private int MaxResults = 10;
    private bool IsLoading = true;
    private bool IsRunningQuery;
    private bool IsSendingToStaging;
    private bool IsSendingSelectionToStaging;
    private string? ErrorMessage;
    private string? SuccessMessage;
    private ExternalArticlePreviewDto? SelectedArticleDetail;
    private Dictionary<string, SelectedExternalArticleItem> SelectedExternalArticles { get; set; } = new();
    private int ResultsPage { get; set; } = 1;
    private int ResultsPageSize { get; set; } = 10;
    private IReadOnlyDictionary<string, ExternalArticlePreviewDto> SelectedArticleLookup =>
        SelectedExternalArticles.ToDictionary(item => item.Key, item => item.Value.Article);

    private List<ExternalArticlePreviewDto> CurrentResults =>
        LastResult?.Articles
            .Skip((ResultsPage - 1) * ResultsPageSize)
            .Take(ResultsPageSize)
            .ToList()
        ?? new List<ExternalArticlePreviewDto>();

    private int TotalResultsPages =>
        LastResult is null || LastResult.Articles.Count == 0
            ? 1
            : (int)Math.Ceiling(LastResult.Articles.Count / (double)ResultsPageSize);

    private string GetFormattedJsonPreview()
    {
        if (string.IsNullOrWhiteSpace(LastResult?.RawResponsePreview))
        {
            return string.Empty;
        }

        try
        {
            using var document = System.Text.Json.JsonDocument.Parse(LastResult.RawResponsePreview);
            return System.Text.Json.JsonSerializer.Serialize(document.RootElement, new System.Text.Json.JsonSerializerOptions
            {
                WriteIndented = true
            });
        }
        catch
        {
            return LastResult.RawResponsePreview ?? string.Empty;
        }
    }

    private async Task OpenArticleDetail(ExternalArticlePreviewDto article)
    {
        SelectedArticleDetail = article;

        if (SelectedProvider is null)
        {
            return;
        }

        try
        {
            var enriched = await ExternalApiExplorerClient.EnrichArticleAsync(SelectedProvider.ProviderKey, article);
            if (enriched is not null)
            {
                SelectedArticleDetail = enriched;
            }
        }
        catch
        {
            SelectedArticleDetail = article;
        }
    }

    private void CloseArticleDetail()
    {
        SelectedArticleDetail = null;
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Providers = await ExternalApiExplorerClient.GetProvidersAsync();
            SelectedProvider = Providers.FirstOrDefault();
        }
        catch (Exception ex)
        {
            ErrorMessage = $"No pude cargar los proveedores externos: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void SelectProvider(ExternalApiProviderDto provider)
    {
        var previousProviderKey = SelectedProvider?.ProviderKey;
        SelectedProvider = provider;
        ErrorMessage = null;
        SuccessMessage = null;
        LastResult = null;
        ResultsPage = 1;

        if (!string.Equals(previousProviderKey, provider.ProviderKey, StringComparison.OrdinalIgnoreCase))
        {
            SelectedExternalArticles.Clear();
        }

        UseQuerySample();
    }

    private void UseQuerySample()
    {
        if (SelectedProvider is null)
        {
            return;
        }

        QueryText = QueryMode == "doi"
            ? "10.1038/nphys1170"
            : SelectedProvider.ProviderKey switch
            {
                "scopus" => "TITLE-ABS-KEY(machine learning)",
                "crossref" => "machine learning in education",
                "openalex" => "artificial intelligence higher education",
                "semantic-scholar" => "deep learning scientific articles",
                _ => "scientific article search"
            };

        if (string.Equals(SelectedProvider.ProviderKey, "scopus", StringComparison.OrdinalIgnoreCase))
        {
            PrimaryAuthor = "Juan Perez";
            CoAuthor = "Maria Garcia";
            InstitutionName = "Universidad Técnica de Ambato";
        }
        else
        {
            PrimaryAuthor = string.Empty;
            CoAuthor = string.Empty;
            InstitutionName = string.Empty;
        }

        if (QueryMode == "affiliation")
        {
            QueryText = string.Empty;
        }
    }

    private async Task RunQueryAsync()
    {
        if (SelectedProvider is null)
        {
            ErrorMessage = "Selecciona un proveedor antes de ejecutar la consulta.";
            return;
        }

        try
        {
            IsRunningQuery = true;
            ErrorMessage = null;
            SuccessMessage = null;
            LastResult = await ExternalApiExplorerClient.QueryAsync(new ExternalApiQueryRequest
            {
                ProviderKey = SelectedProvider.ProviderKey,
                QueryText = QueryText,
                QueryMode = QueryMode,
                InstitutionName = InstitutionName,
                PrimaryAuthor = PrimaryAuthor,
                CoAuthor = CoAuthor,
                MaxResults = MaxResults
            });
            ResultsPage = 1;

            if (LastResult is not null)
            {
                SuccessMessage = $"{LastResult.Message} Artículos detectados: {LastResult.Articles.Count}.";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsRunningQuery = false;
        }
    }

    private async Task SendToRegisterAsync(ExternalArticlePreviewDto article)
    {
        if (LastResult is null)
        {
            ErrorMessage = "Primero ejecuta una consulta válida antes de enviar un artículo al registro.";
            return;
        }

        var draftArticle = article;
        if (SelectedProvider is not null)
        {
            try
            {
                var enriched = await ExternalApiExplorerClient.EnrichArticleAsync(SelectedProvider.ProviderKey, article);
                if (enriched is not null)
                {
                    draftArticle = enriched;
                }
            }
            catch
            {
                draftArticle = article;
            }
        }

        await LocalStorage.SetItemAsync("external-api.register-draft", new ExternalArticleRegistrationDraftDto
        {
            ProviderKey = LastResult.ProviderKey,
            ProviderName = LastResult.ProviderName,
            QueryMode = QueryMode,
            Article = draftArticle
        });

        NavManager.NavigateTo("/articulos/registrar");
    }

    private string GetArticleSelectionKey(ExternalArticlePreviewDto article)
    {
        var baseId = !string.IsNullOrWhiteSpace(article.ExternalId)
            ? article.ExternalId
            : !string.IsNullOrWhiteSpace(article.Doi)
                ? article.Doi
                : $"{article.Title}|{article.PublicationYear}|{article.JournalName}";

        var providerKey = SelectedProvider?.ProviderKey ?? LastResult?.ProviderKey ?? "unknown";
        return $"{providerKey}::{baseId}";
    }

    private bool IsArticleSelected(ExternalArticlePreviewDto article)
        => SelectedExternalArticles.ContainsKey(GetArticleSelectionKey(article));

    private void ToggleArticleSelection(ExternalArticlePreviewDto article, object? value)
    {
        var isChecked = value is bool boolValue && boolValue;
        var key = GetArticleSelectionKey(article);

        if (isChecked)
        {
            SelectedExternalArticles[key] = new SelectedExternalArticleItem
            {
                Key = key,
                ProviderKey = SelectedProvider?.ProviderKey ?? LastResult?.ProviderKey ?? string.Empty,
                ProviderName = SelectedProvider?.DisplayName ?? LastResult?.ProviderName ?? string.Empty,
                Article = article
            };
        }
        else
        {
            SelectedExternalArticles.Remove(key);
        }
    }

    private Task HandleArticleSelectionChanged((ExternalArticlePreviewDto Article, bool IsSelected) change)
    {
        ToggleArticleSelection(change.Article, change.IsSelected);
        return Task.CompletedTask;
    }

    private void RemoveSelectedArticle(string key)
    {
        SelectedExternalArticles.Remove(key);
    }

    private void ClearSelectedArticles()
    {
        SelectedExternalArticles.Clear();
    }

    private async Task SendSelectedToStagingAsync()
    {
        if (!SelectedExternalArticles.Any())
        {
            ErrorMessage = "Selecciona al menos un artículo antes de enviarlo a staging.";
            return;
        }

        try
        {
            IsSendingSelectionToStaging = true;
            ErrorMessage = null;
            SuccessMessage = null;

            var selectedItems = SelectedExternalArticles.Values.ToList();
            if (selectedItems.Select(x => x.ProviderKey).Distinct(StringComparer.OrdinalIgnoreCase).Count() > 1)
            {
                throw new InvalidOperationException("La selección incluye artículos de distintos proveedores. Envía cada proveedor en un lote separado.");
            }

            var providerKey = selectedItems.First().ProviderKey;
            var providerName = selectedItems.First().ProviderName;

            var stagingArticles = new List<ExternalArticlePreviewDto>();
            foreach (var selected in selectedItems)
            {
                var stagingArticle = selected.Article;
                try
                {
                    var enriched = await ExternalApiExplorerClient.EnrichArticleAsync(selected.ProviderKey, selected.Article);
                    if (enriched is not null)
                    {
                        stagingArticle = enriched;
                    }
                }
                catch
                {
                    stagingArticle = selected.Article;
                }

                stagingArticles.Add(stagingArticle);
            }

            var result = await BulkImportClient.CreateBatchFromExternalArticlesAsync(new ExternalArticlesImportRequest
            {
                ProviderKey = providerKey,
                ProviderName = providerName,
                Notes = "Lote externo creado desde la selección múltiple del explorador.",
                ValidateAfterCreate = true,
                Articles = stagingArticles
            });

            if (result?.Batch?.Summary?.ImportBatchId > 0)
            {
                SuccessMessage = $"Se enviaron {stagingArticles.Count} artículo(s) a staging en el lote {result.Batch.Summary.BatchCode}.";
                SelectedExternalArticles.Clear();
                NavManager.NavigateTo($"/management/exportinformation?batchId={result.Batch.Summary.ImportBatchId}");
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"No fue posible enviar la selección a staging: {ex.Message}";
        }
        finally
        {
            IsSendingSelectionToStaging = false;
        }
    }

    private async Task SendToStagingAsync(ExternalArticlePreviewDto article)
    {
        if (LastResult is null)
        {
            ErrorMessage = "Primero ejecuta una consulta válida antes de enviar un artículo al staging.";
            return;
        }

        try
        {
            IsSendingToStaging = true;
            ErrorMessage = null;
            SuccessMessage = null;

            var stagingArticle = article;
            if (SelectedProvider is not null)
            {
                var enriched = await ExternalApiExplorerClient.EnrichArticleAsync(SelectedProvider.ProviderKey, article);
                if (enriched is not null)
                {
                    stagingArticle = enriched;
                }
            }

            var result = await BulkImportClient.CreateBatchFromExternalArticleAsync(new ExternalArticleImportRequest
            {
                ProviderKey = LastResult.ProviderKey,
                ProviderName = LastResult.ProviderName,
                Notes = $"Lote externo creado desde el explorador. QueryMode={QueryMode}",
                ValidateAfterCreate = true,
                Article = stagingArticle
            });

            if (result?.Batch?.Summary?.ImportBatchId > 0)
            {
                SuccessMessage = $"{result.Message} Lote #{result.Batch.Summary.ImportBatchId} listo para revisión.";
                NavManager.NavigateTo($"/management/exportinformation?batchId={result.Batch.Summary.ImportBatchId}");
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"No fue posible enviar el artículo al staging: {ex.Message}";
        }
        finally
        {
            IsSendingToStaging = false;
        }
    }

    private Task ResetResultsPageAsync()
    {
        ResultsPage = 1;
        return Task.CompletedTask;
    }

    private Task ChangeResultsPageSizeAsync(int pageSize)
    {
        ResultsPageSize = pageSize;
        return ResetResultsPageAsync();
    }

    private void PreviousResultsPage()
    {
        if (ResultsPage > 1)
        {
            ResultsPage--;
        }
    }

    private void NextResultsPage()
    {
        if (ResultsPage < TotalResultsPages)
        {
            ResultsPage++;
        }
    }

    private bool HasStatusMessage => !string.IsNullOrWhiteSpace(ErrorMessage) || !string.IsNullOrWhiteSpace(SuccessMessage);

    private string CurrentStatusVariant => !string.IsNullOrWhiteSpace(ErrorMessage) ? "error" : "success";

    private string CurrentStatusTitle => !string.IsNullOrWhiteSpace(ErrorMessage) ? "No pude completar la operación" : "Consulta completada";

    private string CurrentStatusMessage => !string.IsNullOrWhiteSpace(ErrorMessage) ? ErrorMessage! : SuccessMessage ?? string.Empty;

    private Task CloseStatusModal()
    {
        ErrorMessage = null;
        SuccessMessage = null;
        return Task.CompletedTask;
    }
}
