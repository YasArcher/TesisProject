@page "/management/externalapis"
@attribute [Authorize(Roles = "Admin,Analyst,Author,ExternalApiUser")]
@using Blazored.LocalStorage
@using tesisproject.frontend.Features.Management.Components
@using tesisproject.frontend.SharedUI
@using tesisproject.frontend.Utils
@using tesisproject.shared.DTOs.ExternalApis
@using tesisproject.shared.DTOs.Imports
@using System.Text.Json
@inject IExternalApiExplorerClient ExternalApiExplorerClient
@inject IBulkImportClient BulkImportClient
@inject ILocalStorageService LocalStorage
@inject NavigationManager NavManager
@inject ExportJsInterop ExportJs

<PageTitle>Explorador de APIs externas</PageTitle>

<div class="app-page-shell external-api-page">
    <div class="external-api-hero mb-5 rounded-[1.8rem] p-5 text-white shadow-sm">
        <div class="flex flex-col gap-5 lg:flex-row lg:items-center lg:justify-between">
            <div class="flex items-start gap-4">
                <div class="external-api-hero__icon">
                    <i class="bi bi-cloud-arrow-down"></i>
                </div>
                <div>
                    <div class="text-xs font-semibold uppercase tracking-[0.24em] text-white/70">Conectores académicos</div>
                    <h1 class="mt-1 text-2xl font-black md:text-3xl">Explorador de APIs externas</h1>
                    <p class="mt-2 max-w-2xl text-sm leading-6 text-white/78">
                        Consulta, valida y prepara artículos desde bases académicas.
                    </p>
                </div>
            </div>
            <div class="external-api-hero__badges">
                <span><i class="bi bi-search"></i> Búsqueda asistida</span>
                <span><i class="bi bi-filetype-json"></i> Resultado auditable</span>
            </div>
        </div>
    </div>

    <div class="external-api-command-bar mb-5 grid grid-cols-1 gap-3 lg:grid-cols-3">
        <div class="external-api-command-bar__card">
            <span><i class="bi bi-diagram-3"></i></span>
            <div>
                <small>Proveedor activo</small>
                <strong>@(SelectedProvider?.DisplayName ?? "Sin selección")</strong>
                <p>@GetProviderStatusText()</p>
            </div>
        </div>
        <div class="external-api-command-bar__card">
            <span><i class="bi bi-sliders2"></i></span>
            <div>
                <small>Modo de búsqueda</small>
                <strong>@GetCurrentModeLabel()</strong>
                <p>@GetCurrentModeSummaryText()</p>
            </div>
        </div>
        <div class="external-api-command-bar__card">
            <span><i class="bi bi-collection"></i></span>
            <div>
                <small>Selección actual</small>
                <strong>@SelectedExternalArticles.Count artículo(s)</strong>
                <p>@GetSelectionSummaryText()</p>
            </div>
        </div>
    </div>

    <section class="external-api-institutional-panel mb-5 rounded-[1.8rem] border border-[rgba(67,86,99,0.12)] bg-white/95 p-5 shadow-sm">
        <div class="grid grid-cols-1 gap-4 xl:grid-cols-[1.1fr_0.9fr]">
            <div class="space-y-3">
                <div class="inline-flex items-center gap-2 rounded-full bg-[#eef5fb] px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.18em] text-[#295173]">
                    <i class="bi bi-building-check"></i>
                    Exploración institucional
                </div>
                <div>
                    <h2 class="text-lg font-black text-[#102642]">Producción Scopus de la Universidad Técnica de Ambato</h2>
                    <p class="mt-2 text-sm leading-6 text-slate-600">Dataset institucional por filiación UTA.</p>
                </div>
                <div class="flex flex-wrap gap-2 text-xs">
                    <span class="rounded-full bg-[#fff8d4] px-3 py-1.5 font-semibold text-[#7a5b00]">Filiación UTA</span>
                    <span class="rounded-full bg-[#eef6ff] px-3 py-1.5 font-semibold text-[#295173]">CSV / JSON</span>
                </div>
            </div>
            <div class="external-api-institutional-panel__actions">
                <div class="rounded-3xl border border-[#dbe6ef] bg-[linear-gradient(135deg,#fbfdff_0%,#fffdf3_100%)] p-4">
                    <div class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Dataset institucional UTA</div>
                    <button class="mt-4 inline-flex items-center gap-2 rounded-2xl bg-[linear-gradient(135deg,#313647_0%,#2f5249_100%)] px-4 py-3 text-sm font-semibold text-[#fff8d4] shadow-sm disabled:cursor-not-allowed disabled:opacity-60"
                            type="button"
                            disabled="@(!CanUseScopusInstitutionalDataset)"
                            @onclick="OpenInstitutionalDatasetModal">
                        <i class="bi bi-cloud-download"></i>
                        Abrir dataset institucional
                    </button>
                    @if (!CanUseScopusInstitutionalDataset)
                    {
                        <div class="mt-2 text-xs text-slate-500">Selecciona primero el proveedor Scopus para habilitar esta herramienta.</div>
                    }
                </div>
            </div>
        </div>
    </section>

    <AppStatusModal Visible="@HasStatusMessage"
                    Variant="@CurrentStatusVariant"
                    Eyebrow="APIs externas"
                    Title="@CurrentStatusTitle"
                    Message="@CurrentStatusMessage"
                    OnClose="CloseStatusModal" />
    <AppConfirmPanel Visible="@IsStagingConfirmVisible"
                     Eyebrow="Confirmar envío"
                     Title="@StagingConfirmTitle"
                     Message="@StagingConfirmMessage"
                     ConfirmText="@StagingConfirmActionLabel"
                     CancelText="Cancelar"
                     OnConfirm="ConfirmStagingSendAsync"
                     OnCancel="CloseStagingConfirmAsync" />
    <ExternalApiArticleDetailPanel Article="SelectedArticleDetail" OnClose="CloseArticleDetail" />

    @if (IsInstitutionalDatasetModalVisible)
    {
        <div class="external-api-dataset-modal-backdrop">
            <section class="external-api-dataset-modal" role="dialog" aria-modal="true" aria-labelledby="external-api-dataset-title">
                <div class="external-api-dataset-modal__header">
                    <div>
                        <div class="text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-500">Scopus institucional</div>
                        <h2 id="external-api-dataset-title" class="mt-1 text-xl font-black text-[#102642]">Dataset preliminar UTA</h2>
                        <p class="mt-2 text-sm text-slate-600">Artículos recuperados por filiación UTA.</p>
                    </div>
                    <button type="button" class="external-api-dataset-modal__close" @onclick="CloseInstitutionalDatasetModal">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>

                <div class="external-api-dataset-modal__body">
                    <div class="external-api-dataset-modal__metrics">
                        <article>
                            <small>Proveedor</small>
                            <strong>Scopus</strong>
                            <p>Fuente institucional activa.</p>
                        </article>
                        <article>
                            <small>Cobertura</small>
                            <strong>Filiación UTA</strong>
                            <p>Español e inglés.</p>
                        </article>
                        <article>
                            <small>Registros listos</small>
                            <strong>@InstitutionalDatasetArticles.Length</strong>
                            <p>Artículos disponibles en la vista previa actual.</p>
                        </article>
                    </div>

                    <div class="external-api-dataset-modal__panel">
                        <div class="external-api-dataset-modal__panel-copy">
                            <div class="text-sm font-bold text-[#102642]">Preparar dataset institucional completo</div>
                            <div class="text-xs text-slate-500">Busca todo y luego habilita la descarga.</div>
                        </div>
                        <button type="button"
                                class="external-api-dataset-modal__primary"
                                disabled="@IsLoadingInstitutionalDataset"
                                @onclick="PrepareInstitutionalDatasetAsync">
                            @(IsLoadingInstitutionalDataset ? "Buscando todos los artículos..." : "Preparar dataset completo")
                        </button>
                    </div>

                    @if (InstitutionalDatasetResult is not null)
                    {
                        <div class="external-api-dataset-modal__result">
                            <div class="flex flex-wrap items-center justify-between gap-3">
                                <div>
                                    <div class="text-sm font-bold text-[#102642]">Vista previa lista</div>
                                    <div class="text-xs text-slate-500">@GetInstitutionalDatasetSummary()</div>
                                    <div class="mt-2 inline-flex items-center gap-2 rounded-full bg-[#eef6ff] px-3 py-1 text-[11px] font-semibold text-[#295173]">
                                        <i class="bi bi-building-check"></i>
                                        Dataset generado por filiación UTA en Scopus
                                    </div>
                                </div>
                                <div class="flex flex-wrap gap-2">
                                    <button type="button" class="external-api-dataset-modal__secondary" @onclick="DownloadInstitutionalDatasetCsvAsync">Descargar CSV</button>
                                    <button type="button" class="external-api-dataset-modal__secondary" @onclick="DownloadInstitutionalDatasetJsonAsync">Descargar JSON</button>
                                    <button type="button"
                                            class="external-api-dataset-modal__secondary disabled:cursor-not-allowed disabled:opacity-60"
                                            disabled="@(!InstitutionalDatasetArticles.Any() || IsSendingInstitutionalDatasetToStaging)"
                                            @onclick="SendInstitutionalDatasetToStagingAsync">
                                        @(IsSendingInstitutionalDatasetToStaging ? "Enviando dataset..." : "Enviar dataset a staging")
                                    </button>
                                </div>
                            </div>

                            <div class="mt-4 grid grid-cols-1 gap-3 xl:grid-cols-2">
                                @foreach (var article in InstitutionalDatasetArticles.Take(6))
                                {
                                    <div class="rounded-2xl border border-[#e5edf4] bg-[#fbfdff] px-4 py-3">
                                        <div class="text-sm font-bold text-[#102642]">@article.Title</div>
                                        <div class="mt-2 flex flex-wrap gap-2 text-[11px]">
                                            @if (!string.IsNullOrWhiteSpace(article.Authors))
                                            {
                                                <span class="rounded-full bg-[#eef6ff] px-2 py-1 font-semibold text-[#295173]">@article.Authors</span>
                                            }
                                            @if (article.PublicationYear.HasValue)
                                            {
                                                <span class="rounded-full bg-slate-100 px-2 py-1 font-semibold text-slate-600">@article.PublicationYear</span>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(article.JournalName))
                                            {
                                                <span class="rounded-full bg-[#fff4e4] px-2 py-1 font-semibold text-[#8b5a16]">@article.JournalName</span>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </section>
        </div>
    }

    @if (IsBusyOverlayVisible)
    {
        <div class="external-api-overlay" role="status" aria-live="polite" aria-busy="true">
            <div class="external-api-overlay__card">
                <div class="external-api-overlay__spinner"></div>
                <div class="external-api-overlay__eyebrow">@CurrentBusyEyebrow</div>
                <h3>@CurrentBusyTitle</h3>
                <p>@CurrentBusyMessage</p>
            </div>
        </div>
    }

    @if (LastResult is not null)
    {
        <div class="mb-5 rounded-[1.6rem] border border-[#dbe6ef] bg-white/95 p-4 shadow-sm">
            <div class="flex flex-wrap items-start justify-between gap-3">
                <div>
                    <div class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Última consulta</div>
                    <div class="mt-1 text-base font-black text-[#102642]">@LastResult.ProviderName · @GetExecutedModeLabel()</div>
                    <div class="mt-1 text-sm text-slate-600">@GetLastResultSummary()</div>
                </div>
                <span class="rounded-full bg-[#eef5fb] px-3 py-1 text-xs font-semibold text-[#295173]">@LastResultPreviewArticles.Length artículo(s)</span>
            </div>

            @if (LastResultPreviewArticles.Any())
            {
                <div class="mt-4 grid grid-cols-1 gap-3 xl:grid-cols-2">
                    @foreach (var article in LastResultPreviewArticles.Take(4))
                    {
                        <div class="rounded-2xl border border-[#e5edf4] bg-[#fbfdff] px-4 py-3" @key="GetLastResultArticleKey(article)">
                            <div class="text-sm font-bold text-[#102642]">@(string.IsNullOrWhiteSpace(article.Title) ? "Artículo sin título visible" : article.Title)</div>
                            <div class="mt-2 flex flex-wrap gap-2 text-[11px]">
                                @if (!string.IsNullOrWhiteSpace(article.Authors))
                                {
                                    <span class="rounded-full bg-[#eef6ff] px-2 py-1 font-semibold text-[#295173]">@article.Authors</span>
                                }
                                @if (article.PublicationYear.HasValue)
                                {
                                    <span class="rounded-full bg-slate-100 px-2 py-1 font-semibold text-slate-600">@article.PublicationYear</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(article.JournalName))
                                {
                                    <span class="rounded-full bg-[#fff4e4] px-2 py-1 font-semibold text-[#8b5a16]">@article.JournalName</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(article.Doi))
                                {
                                    <span class="rounded-full bg-[#eaf7ee] px-2 py-1 font-semibold text-emerald-700">@article.Doi</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }

    @if (IsLoading)
    {
        <div class="rounded-3xl border border-[#dbe6ef] bg-white p-6 text-center text-slate-600 shadow-sm">Cargando proveedores externos...</div>
    }
    else
    {
        <div class="external-api-workspace grid grid-cols-1 gap-6 xl:grid-cols-[0.88fr_1.12fr]">
            <div class="external-api-sidebar-shell">
                <ExternalApiQuerySidebar Providers="@Providers"
                                         SelectedProvider="@SelectedProvider"
                                         QueryMode="@QueryMode"
                                         QueryModeChanged="HandleQueryModeChangedAsync"
                                         MaxResults="@MaxResults"
                                         MaxResultsChanged="@(value => MaxResults = value)"
                                         QueryText="@QueryText"
                                         QueryTextChanged="HandleQueryTextChangedAsync"
                                         InstitutionName="@InstitutionName"
                                         InstitutionNameChanged="HandleInstitutionNameChangedAsync"
                                         PrimaryAuthor="@PrimaryAuthor"
                                         PrimaryAuthorChanged="HandlePrimaryAuthorChangedAsync"
                                         RestrictAuthorToInstitution="@RestrictAuthorToInstitution"
                                         RestrictAuthorToInstitutionChanged="HandleRestrictAuthorToInstitutionChangedAsync"
                                         RecentQueries="@RecentQueries"
                                         OnApplyRecentQuery="ApplyRecentQueryAsync"
                                         OnClearRecentQueries="ClearRecentQueriesAsync"
                                         IsRunningQuery="@IsRunningQuery"
                                         OnSelectProvider="SelectProvider"
                                         OnRunQuery="RunQueryAsync"
                                         OnClearSearch="ClearSearchAsync" />
            </div>

            <div class="external-api-results-shell">
                <ExternalApiResultsPanel Result="@LastResult"
                                         QueryMode="@LastExecutedQueryMode"
                                         QueryText="@LastExecutedQueryText"
                                         PrimaryAuthor="@LastExecutedPrimaryAuthor"
                                         InstitutionName="@LastExecutedInstitutionName"
                                         SelectedAuthorId="@SelectedAuthorId"
                                         SelectedAffiliationId="@SelectedAffiliationId"
                                         HasManualResolutionSelection="@HasManualResolutionSelection"
                                         ResultsSearchText="@ResultsSearchText"
                                         ResultsSearchTextChanged="HandleResultsSearchChangedAsync"
                                         FilterOnlyWithDoi="@FilterOnlyWithDoi"
                                         FilterOnlyWithDoiChanged="HandleOnlyWithDoiChangedAsync"
                                         FilterOnlyOpenAccess="@FilterOnlyOpenAccess"
                                         FilterOnlyOpenAccessChanged="HandleOnlyOpenAccessChangedAsync"
                                         OnSelectResolutionCandidate="HandleResolutionCandidateSelectionAsync"
                                         OnClearResolutionSelection="ClearResolutionSelectionAsync"
                                         CurrentResults="@CurrentResults"
                                         TotalFilteredResultsCount="@FilteredResults.Count"
                                         ResultsPage="@ResultsPage"
                                         TotalResultsPages="@TotalResultsPages"
                                         ResultsPageSize="@ResultsPageSize"
                                         ResultsPageSizeChanged="ChangeResultsPageSizeAsync"
                                         OnPreviousPage="PreviousResultsPage"
                                         OnNextPage="NextResultsPage"
                                         SelectedArticles="@SelectedArticleLookup"
                                         IsArticleSelected="@IsArticleSelected"
                                         OnToggleSelection="HandleArticleSelectionChanged"
                                         OnRemoveSelectedArticle="RemoveSelectedArticle"
                                         OnClearSelectedArticles="ClearSelectedArticles"
                                         OnSendSelectedToStaging="SendSelectedToStagingAsync"
                                         IsSendingSelectionToStaging="@IsSendingSelectionToStaging"
                                         OnOpenDetail="OpenArticleDetail"
                                         OnSendToRegister="SendToRegisterAsync"
                                         OnSendToStaging="SendToStagingAsync"
                                         IsSendingToStaging="@IsSendingToStaging"
                                         FormattedJsonPreview="@GetFormattedJsonPreview()" />
            </div>
        </div>
    }
</div>

@code {
    private sealed class SelectedExternalArticleItem
    {
        public string Key { get; set; } = string.Empty;
        public string ProviderKey { get; set; } = string.Empty;
        public string ProviderName { get; set; } = string.Empty;
        public ExternalArticlePreviewDto Article { get; set; } = new();
    }

    private List<ExternalApiProviderDto> Providers = new();
    private ExternalApiProviderDto? SelectedProvider;
    private ExternalApiQueryResultDto? LastResult;
    private string QueryText = string.Empty;
    private string QueryMode = "general";
    private string InstitutionName = string.Empty;
    private string PrimaryAuthor = string.Empty;
    private bool RestrictAuthorToInstitution;
    private int MaxResults = 10;
    private bool IsLoading = true;
    private bool IsRunningQuery;
    private bool IsSendingToStaging;
    private bool IsSendingSelectionToStaging;
    private bool IsSendingInstitutionalDatasetToStaging;
    private bool IsStagingConfirmVisible;
    private string? ErrorMessage;
    private string? SuccessMessage;
    private ExternalArticlePreviewDto? SelectedArticleDetail;
    private Dictionary<string, SelectedExternalArticleItem> SelectedExternalArticles { get; set; } = new();
    private List<ExternalApiQuerySidebar.ExternalApiRecentQueryItem> RecentQueries { get; set; } = new();
    private ExternalArticlePreviewDto? PendingSingleStagingArticle;
    private bool PendingSelectionStagingSend;
    private bool PendingInstitutionalDatasetStagingSend;
    private string ResultsSearchText = string.Empty;
    private bool FilterOnlyWithDoi;
    private bool FilterOnlyOpenAccess;
    private string? SelectedAuthorId;
    private string? SelectedAffiliationId;
    private int ResultsPage { get; set; } = 1;
    private int ResultsPageSize { get; set; } = 10;
    private string LastExecutedQueryMode = "general";
    private string LastExecutedQueryText = string.Empty;
    private string LastExecutedPrimaryAuthor = string.Empty;
    private string LastExecutedInstitutionName = string.Empty;
    private bool IsInstitutionalDatasetModalVisible;
    private bool IsLoadingInstitutionalDataset;
    private ExternalApiQueryResultDto? InstitutionalDatasetResult;
    private const string DefaultInstitutionName = "Universidad Técnica de Ambato";
    private const string RecentQueriesStorageKey = "external-api.recent-queries";
    private IReadOnlyDictionary<string, ExternalArticlePreviewDto> SelectedArticleLookup =>
        SelectedExternalArticles.ToDictionary(item => item.Key, item => item.Value.Article);
    private ExternalArticlePreviewDto[] LastResultPreviewArticles =>
        ExternalApiExplorerPageHelper.BuildPreviewArticles(LastResult);
    private ExternalArticlePreviewDto[] InstitutionalDatasetArticles =>
        ExternalApiExplorerPageHelper.BuildPreviewArticles(InstitutionalDatasetResult);
    private bool CanUseScopusInstitutionalDataset =>
        string.Equals(SelectedProvider?.ProviderKey, "scopus", StringComparison.OrdinalIgnoreCase);

    private List<ExternalArticlePreviewDto> EffectiveResultArticles =>
        LastResultPreviewArticles.ToList();

    private List<ExternalArticlePreviewDto> FilteredResults =>
        EffectiveResultArticles
            .Where(article => MatchesResultsSearch(article))
            .Where(article => !FilterOnlyWithDoi || !string.IsNullOrWhiteSpace(article.Doi))
            .Where(article => !FilterOnlyOpenAccess || article.IsOpenAccess == true)
            .ToList();

    private List<ExternalArticlePreviewDto> CurrentResults
    {
        get
        {
            var filtered = FilteredResults;
            var safePage = Math.Max(1, Math.Min(ResultsPage, TotalResultsPages));
            return filtered
                .Skip((safePage - 1) * ResultsPageSize)
                .Take(ResultsPageSize)
                .ToList();
        }
    }

    private int TotalResultsPages =>
        FilteredResults.Count == 0
            ? 1
            : (int)Math.Ceiling(FilteredResults.Count / (double)ResultsPageSize);

    private bool HasManualResolutionSelection =>
        !string.IsNullOrWhiteSpace(SelectedAuthorId)
        || !string.IsNullOrWhiteSpace(SelectedAffiliationId);

    private bool IsBusyOverlayVisible => IsLoading || IsRunningQuery || IsSendingToStaging || IsSendingSelectionToStaging || IsSendingInstitutionalDatasetToStaging || IsLoadingInstitutionalDataset;
    private string StagingConfirmTitle => PendingSelectionStagingSend
        ? "Enviar selección de artículos a staging"
        : PendingInstitutionalDatasetStagingSend
            ? "Enviar dataset institucional a staging"
        : "Enviar artículo a staging";
    private string StagingConfirmActionLabel => PendingSelectionStagingSend
        ? "Enviar selección"
        : PendingInstitutionalDatasetStagingSend
            ? "Enviar dataset"
        : "Enviar artículo";
    private string StagingConfirmMessage => PendingSelectionStagingSend
        ? $"Se generará un lote con {SelectedExternalArticles.Count} artículo(s) seleccionados. Mientras se procesa el envío no podrás seguir interactuando con esta pantalla."
        : PendingInstitutionalDatasetStagingSend
            ? $"Se generará un lote en staging con {InstitutionalDatasetArticles.Length} artículo(s) recuperados por filiación Universidad Técnica de Ambato. Luego podrás validar y corregir antes del registro definitivo."
        : "Se enviará este artículo al staging institucional para revisión técnica posterior. ¿Deseas continuar?";

    private string CurrentBusyEyebrow => IsLoading
        ? "Preparando módulo"
        : IsLoadingInstitutionalDataset
            ? "Preparando dataset"
        : IsRunningQuery
            ? "Consultando proveedor"
        : IsSendingInstitutionalDatasetToStaging
            ? "Enviando dataset"
        : "Procesando envío";

    private string CurrentBusyTitle => IsLoading
        ? "Estamos cargando los conectores académicos"
        : IsLoadingInstitutionalDataset
            ? "Estamos reuniendo los artículos institucionales"
        : IsRunningQuery
            ? "Estamos consultando la fuente seleccionada"
        : IsSendingInstitutionalDatasetToStaging
            ? "Estamos creando el lote institucional en staging"
        : "Estamos enviando artículos al staging";

    private string CurrentBusyMessage => IsLoading
        ? "Espera un momento mientras dejamos listo el módulo con sus proveedores, ayudas visuales y paneles de resultados."
        : IsLoadingInstitutionalDataset
            ? "Estamos recorriendo Scopus y consolidando el dataset de la Universidad Técnica de Ambato. Por ahora bloqueamos la pantalla para evitar acciones duplicadas."
        : IsRunningQuery
            ? "No necesitas hacer nada más por ahora. Estamos resolviendo la consulta, leyendo la respuesta y preparando los artículos mapeables."
        : IsSendingInstitutionalDatasetToStaging
            ? "Estamos enviando los artículos institucionales recuperados a staging para que sean validados antes del registro definitivo."
        : "Mantendremos esta pantalla protegida hasta completar el envío para evitar acciones duplicadas o inconsistencias.";

    private static string GetLastResultArticleKey(ExternalArticlePreviewDto article)
        => !string.IsNullOrWhiteSpace(article.ExternalId)
            ? article.ExternalId
            : !string.IsNullOrWhiteSpace(article.Doi)
                ? article.Doi
                : $"{article.Title}|{article.PublicationYear}|{article.JournalName}";

    private string GetFormattedJsonPreview()
    {
        if (string.IsNullOrWhiteSpace(LastResult?.RawResponsePreview))
        {
            return string.Empty;
        }

        try
        {
            using var document = System.Text.Json.JsonDocument.Parse(LastResult.RawResponsePreview);
            return System.Text.Json.JsonSerializer.Serialize(document.RootElement, new System.Text.Json.JsonSerializerOptions
            {
                WriteIndented = true
            });
        }
        catch
        {
            return LastResult.RawResponsePreview ?? string.Empty;
        }
    }

    private async Task OpenArticleDetail(ExternalArticlePreviewDto article)
    {
        SelectedArticleDetail = article;

        if (SelectedProvider is null)
        {
            return;
        }

        try
        {
            var enriched = await ExternalApiExplorerClient.EnrichArticleAsync(SelectedProvider.ProviderKey, article);
            if (enriched is not null)
            {
                SelectedArticleDetail = enriched;
            }
        }
        catch
        {
            SelectedArticleDetail = article;
        }
    }

    private void CloseArticleDetail()
    {
        SelectedArticleDetail = null;
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Providers = await ExternalApiExplorerClient.GetProvidersAsync();
            RecentQueries = await LocalStorage.GetItemAsync<List<ExternalApiQuerySidebar.ExternalApiRecentQueryItem>>(RecentQueriesStorageKey) ?? new();
            SelectedProvider = null;
            ResetQueryStateForProvider(useSampleValues: false);
        }
        catch (Exception ex)
        {
            ErrorMessage = $"No pude cargar los proveedores externos: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void SelectProvider(ExternalApiProviderDto provider)
    {
        var previousProviderKey = SelectedProvider?.ProviderKey;
        SelectedProvider = provider;
        EnsureValidQueryModeForProvider();
        ErrorMessage = null;
        SuccessMessage = null;
        LastResult = null;
        InstitutionalDatasetResult = null;
        ResultsPage = 1;
        SelectedAuthorId = null;
        SelectedAffiliationId = null;

        if (!string.Equals(previousProviderKey, provider.ProviderKey, StringComparison.OrdinalIgnoreCase))
        {
            SelectedExternalArticles.Clear();
        }

        ResetQueryStateForProvider(useSampleValues: false);
    }

    private async Task ApplyRecentQueryAsync(ExternalApiQuerySidebar.ExternalApiRecentQueryItem query)
    {
        var provider = Providers.FirstOrDefault(item =>
            string.Equals(item.ProviderKey, query.ProviderKey, StringComparison.OrdinalIgnoreCase));

        if (provider is not null)
        {
            SelectProvider(provider);
        }

        QueryMode = string.IsNullOrWhiteSpace(query.QueryMode) ? "general" : query.QueryMode;
        EnsureValidQueryModeForProvider();
        QueryText = query.QueryText ?? string.Empty;
        InstitutionName = query.InstitutionName ?? string.Empty;
        PrimaryAuthor = query.PrimaryAuthor ?? string.Empty;
        RestrictAuthorToInstitution = !string.IsNullOrWhiteSpace(InstitutionName)
            && string.Equals(QueryMode, "author", StringComparison.OrdinalIgnoreCase);
        SelectedAuthorId = null;
        SelectedAffiliationId = null;
        MaxResults = query.MaxResults >= 0 ? query.MaxResults : 10;
        ResultsPage = 1;
        LastResult = null;
        ErrorMessage = null;
        SuccessMessage = null;
        await InvokeAsync(StateHasChanged);
    }

