@page "/management/bi"
@attribute [Authorize]
@using tesisproject.frontend.SharedUI.Charts
@using tesisproject.frontend.SharedUI.Kpi
@inject tesisproject.frontend.Utils.ExportJsInterop Exporter

<AppHeroHeader Title="Inteligencia de Negocio" Subtitle="Resumen y Reportes">
    <Actions>
        <div class="btn-group">
            <button class="btn btn-light" @onclick="ExportCsv" title="Exportar a CSV">
                <i class="export-icon">📥</i> Exportar CSV
            </button>
            <button class="btn btn-primary" @onclick="Print" title="Imprimir / Guardar como PDF">
                <i class="print-icon">🖨️</i> Imprimir / PDF
            </button>
        </div>
    </Actions>
</AppHeroHeader>

<div class="container-fluid" id="bi-root">
    <!-- KPIs -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-md-3">
            <KpiCard Title="Artículos"
                     Value="@Vm.TotalArticles.ToString("N0")"
                     Icon="📄"
                     DeltaLabel="@Vm.YoYLabel"
                     DeltaClass="@Vm.YoYClass"
                     CardClass="kpi-card kpi-card-hover" />
        </div>
        <div class="col-12 col-md-3">
            <KpiCard Title="Acceso Abierto"
                     Value="@($"{Vm.OpenAccessPct:P0}")"
                     Icon="🔓"
                     CardClass="kpi-card kpi-card-hover" />
        </div>
        <div class="col-12 col-md-3">
            <KpiCard Title="SCOPUS"
                     Value="@Vm.ByDb.Scopus.ToString("N0")"
                     Icon="🧭"
                     CardClass="kpi-card kpi-card-hover" />
        </div>
        <div class="col-12 col-md-3">
            <KpiCard Title="WoS"
                     Value="@Vm.ByDb.Wos.ToString("N0")"
                     Icon="🧪"
                     CardClass="kpi-card kpi-card-hover" />
        </div>
    </div>

    <div class="row g-4">
        <!-- Tendencia mensual -->
        <div class="col-12 col-lg-6">
            <AppGlassCard Title="Producción mensual" Icon="📈" CardClass="chart-card">
                <BarChart Labels="@Vm.MonthLabels" Values="@Vm.MonthCounts" Height="240" />
                <div class="chart-footer">
                    <i class="info-icon">ℹ️</i> Últimos 12 meses
                </div>
            </AppGlassCard>
        </div>

        <!-- Distribución por campo -->
        <div class="col-12 col-lg-6">
            <AppGlassCard Title="Distribución por Campo Amplio" Icon="🧭" CardClass="chart-card">
                <PieDonut Items="@Vm.ByField" Height="240" />
                <div class="distribution-list">
                    @foreach (var kv in Vm.ByField)
                    {
                        <div class="distribution-item">
                            <span class="field-name">@kv.Key</span>
                            <span class="field-value">@kv.Value</span>
                        </div>
                    }
                </div>
            </AppGlassCard>
        </div>

        <!-- Sparklines Top Revistas -->
        <div class="col-12">
            <AppGlassCard Title="Top Revistas (último año)" Icon="🏆" CardClass="chart-card">
                <div class="row g-3">
                    @foreach (var j in Vm.TopJournals)
                    {
                        <div class="col-12 col-md-6 col-xl-3">
                            <div class="journal-card">
                                <div class="journal-header">
                                    <div class="journal-name" title="@j.Name">@j.Name</div>
                                    <span class="journal-badge" title="Total en 12 meses">@j.Total</span>
                                </div>
                                <div class="sparkline-container">
                                    <Sparkline Values="@j.Months" Height="56" />
                                </div>
                                <div class="journal-footer">
                                    <i class="calendar-icon">📅</i> últimos 12 meses
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </AppGlassCard>
        </div>
    </div>
</div>

@code {
    private DashboardVm Vm = DashboardVm.Sample();

    private async Task ExportCsv()
    {
        try
        {
            var lines = new List<string> { "Mes,Articulos" };
            for (int i = 0; i < Vm.MonthLabels.Length; i++)
                lines.Add($"{Vm.MonthLabels[i]},{Vm.MonthCounts[i]}");
            var csv = string.Join("\n", lines);
            await Exporter.ExportCsv("bi-resumen.csv", csv);
        }
        catch { }
    }

    private async Task Print()
    {
        try { await Exporter.PrintSection("bi-root"); }
        catch { }
    }

    private sealed class DashboardVm
    {
        public int TotalArticles { get; set; }
        public double OpenAccessPct { get; set; }
        public string YoYLabel { get; set; } = "";
        public string YoYClass { get; set; } = "text-success";
        public (int Scopus, int Wos) ByDb { get; set; }
        public string[] MonthLabels { get; set; } = Array.Empty<string>();
        public int[] MonthCounts { get; set; } = Array.Empty<int>();
        public Dictionary<string, int> ByField { get; set; } = new();
        public List<JournalSeries> TopJournals { get; set; } = new();

        public static DashboardVm Sample()
        {
            var labels = Enumerable.Range(0, 12)
                .Select(i => DateTime.Now.AddMonths(-11 + i).ToString("MMM"))
                .ToArray();

            var rnd = new Random();
            int[] Series(int basev) => Enumerable.Range(0, 12)
                .Select(_ => Math.Max(0, rnd.Next(basev - 2, basev + 3))).ToArray();

            return new DashboardVm
            {
                TotalArticles = 248,
                OpenAccessPct = 0.62,
                YoYLabel = "▲ +14% vs. año anterior",
                YoYClass = "text-success",
                ByDb = (Scopus: 146, Wos: 102),
                MonthLabels = labels,
                MonthCounts = Series(18),
                ByField = new()
                {
                    ["Ciencias naturales"] = 58,
                    ["TIC"] = 52,
                    ["Salud y bienestar"] = 41,
                    ["Ingeniería"] = 37,
                    ["C. Sociales"] = 35,
                    ["Otros"] = 25
                },
                TopJournals = new()
                {
                    new JournalSeries("Journal A", Series(6)),
                    new JournalSeries("Journal B", Series(5)),
                    new JournalSeries("Journal C", Series(4)),
                    new JournalSeries("Journal D", Series(3)),
                }
            };
        }
    }

    private sealed record JournalSeries(string Name, int[] Months)
    {
        public int Total => Months.Sum();
    }
}
