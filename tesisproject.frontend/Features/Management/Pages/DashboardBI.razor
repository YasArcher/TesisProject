@page "/management/bi"
@using tesisproject.frontend.SharedUI.Charts
@using tesisproject.frontend.SharedUI.Kpi
@inject tesisproject.frontend.Utils.ExportJsInterop Exporter

<AppHeroHeader Title="Inteligencia de Negocio" Subtitle="Resumen y Reportes">
    <Actions>
        <div class="btn-group">
            <button class="btn btn-light" @onclick="() => ExportCsv()">Exportar CSV</button>
            <button class="btn btn-primary" @onclick="() => Print()">Imprimir / PDF</button>
        </div>
    </Actions>
</AppHeroHeader>

<div class="container-fluid" id="bi-root">
    <!-- KPIs -->
    <div class="row g-3 mb-3">
        <div class="col-12 col-md-3"><KpiCard Title="Artículos" Value="@Vm.TotalArticles.ToString("N0")" Icon="📄" DeltaLabel="@Vm.YoYLabel" DeltaClass="@Vm.YoYClass" /></div>
        <div class="col-12 col-md-3"><KpiCard Title="Acceso Abierto" Value="@($"{Vm.OpenAccessPct:P0}")" Icon="🔓" /></div>
        <div class="col-12 col-md-3"><KpiCard Title="SCOPUS" Value="@Vm.ByDb.Scopus.ToString("N0")" Icon="🧭" /></div>
        <div class="col-12 col-md-3"><KpiCard Title="WoS" Value="@Vm.ByDb.Wos.ToString("N0")" Icon="🧪" /></div>
    </div>

    <div class="row g-3">
        <!-- Tendencia mensual -->
        <div class="col-12 col-lg-6">
            <AppGlassCard Title="Producción mensual" Icon="📈">
                <BarChart Labels="@Vm.MonthLabels" Values="@Vm.MonthCounts" Height="220" />
                <div class="text-muted small mt-2">Últimos 12 meses</div>
            </AppGlassCard>
        </div>

        <!-- Distribución por campo -->
        <div class="col-12 col-lg-6">
            <AppGlassCard Title="Distribución por Campo Amplio" Icon="🧭">
                <PieDonut Items="@Vm.ByField" Height="220" />
                <ul class="small mt-3">
                    @foreach (var kv in Vm.ByField)
                    {
                        <li><strong>@kv.Key</strong>: @kv.Value</li>
                    }
                </ul>
            </AppGlassCard>
        </div>

        <!-- Sparklines Top Revistas -->
        <div class="col-12">
            <AppGlassCard Title="Top Revistas (último año)" Icon="🏆">
                <div class="row g-3">
                    @foreach (var j in Vm.TopJournals)
                    {
                        <div class="col-12 col-md-6 col-xl-3">
                            <div class="p-3 bg-white rounded-2 shadow-sm h-100">
                                <div class="d-flex justify-content-between">
                                    <div class="fw-semibold">@j.Name</div>
                                    <span class="badge text-bg-light">@j.Total</span>
                                </div>
                                <div class="mt-2">
                                    <Sparkline Values="@j.Months" Height="48" />
                                </div>
                                <div class="small text-muted mt-2">últimos 12 meses</div>
                            </div>
                        </div>
                    }
                </div>
            </AppGlassCard>
        </div>
    </div>
</div>

@code {
    // -------- VM de ejemplo (mock local) --------
    private DashboardVm Vm = DashboardVm.Sample();

    private async Task ExportCsv()
    {
        // CSV simple: puedes cambiar el dataset a lo que necesites
        var lines = new List<string> { "Mes,Articulos" };
        for (int i = 0; i < Vm.MonthLabels.Length; i++)
            lines.Add($"{Vm.MonthLabels[i]},{Vm.MonthCounts[i]}");
        var csv = string.Join("\n", lines);
        await Exporter.ExportCsv("bi-resumen.csv", csv);
    }

    private async Task Print() => await Exporter.PrintSection("bi-root");

    // --------- Tipos auxiliares (mock) ----------
    private sealed class DashboardVm
    {
        public int TotalArticles { get; set; }
        public double OpenAccessPct { get; set; }
        public string YoYLabel { get; set; } = "";
        public string YoYClass { get; set; } = "text-success";
        public (int Scopus, int Wos) ByDb { get; set; }
        public string[] MonthLabels { get; set; } = Array.Empty<string>();
        public int[] MonthCounts { get; set; } = Array.Empty<int>();
        public Dictionary<string,int> ByField { get; set; } = new();
        public List<JournalSeries> TopJournals { get; set; } = new();

        public static DashboardVm Sample()
        {
            var labels = Enumerable.Range(0, 12).Select(i => DateTime.Now.AddMonths(-11+i).ToString("MMM")).ToArray();
            var rnd = new Random();
            int[] series(int basev) => Enumerable.Range(0, 12).Select(_ => rnd.Next(basev-2, basev+3)).Select(v => Math.Max(0,v)).ToArray();

            return new DashboardVm
            {
                TotalArticles   = 248,
                OpenAccessPct   = 0.62,
                YoYLabel        = "▲ +14% vs. año anterior",
                YoYClass        = "text-success",
                ByDb            = (Scopus: 146, Wos: 102),
                MonthLabels     = labels,
                MonthCounts     = series(18),
                ByField         = new()
                {
                    ["Ciencias naturales"] = 58,
                    ["TIC"] = 52,
                    ["Salud y bienestar"] = 41,
                    ["Ingeniería"] = 37,
                    ["C. Sociales"] = 35,
                    ["Otros"] = 25
                },
                TopJournals = new()
                {
                    new JournalSeries("Journal A", series(6)),
                    new JournalSeries("Journal B", series(5)),
                    new JournalSeries("Journal C", series(4)),
                    new JournalSeries("Journal D", series(3)),
                }
            };
        }
    }

    private sealed record JournalSeries(string Name, int[] Months)
    {
        public int Total => Months.Sum();
    }
}
