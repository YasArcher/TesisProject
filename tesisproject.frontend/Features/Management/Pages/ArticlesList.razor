@page "/articulos/listado"
@attribute [Authorize]

@using System.Linq
@using tesisproject.shared.DTOs.Articles
@using tesisproject.frontend.Services.Interfaces
@using tesisproject.frontend.SharedUI
@using tesisproject.frontend.SharedUI.Board
@using tesisproject.frontend.SharedUI.Modal
@using tesisproject.frontend.SharedUI.ConfirmDialog
@using tesisproject.frontend.SharedUI.Table
@using tesisproject.frontend.SharedUI.Filters
@using tesisproject.frontend.SharedUI.Toolbar

@inject IArticlesClient ArticlesClient
@inject NavigationManager Nav

<div class="min-h-[calc(100vh-80px)] bg-[#f2f2f2]">
    <div class="mx-auto max-w-[1400px] px-4 pb-10 pt-4">

        <!-- BLOQUE SUPERIOR: TÍTULO + KPIs + BARRA ESTADO -->
        <div class="mb-5 rounded-3xl border border-slate-200/80 bg-gradient-to-br from-white via-[#f7f7f7] to-[#e9f0f0] px-5 py-4 shadow-lg shadow-slate-300/50 border-t-4 border-t-[#800909] space-y-4">

            <!-- TÍTULO / DESCRIPCIÓN -->
            <div class="flex flex-col gap-1 pb-1 border-b border-slate-200/70">
                <h1 class="text-xl md:text-2xl font-extrabold tracking-tight text-[#1a2b2b]">
                    Artículos registrados
                </h1>
                <p class="text-xs md:text-sm text-slate-600">
                    Consulta, filtra y administra los artículos almacenados en la DIDE.
                </p>
            </div>

            <!-- KPIs SUPERIORES -->
            @if (!_isLoading && _allArticles.Any())
            {
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 pt-1">
                    <!-- Total filtrados -->
                    <div class="rounded-2xl bg-white/95 border border-slate-200 px-4 py-3 shadow-sm flex flex-col gap-1">
                        <span class="text-[11px] font-semibold uppercase tracking-wide text-slate-500">
                            Total filtrados
                        </span>
                        <span class="text-xl font-extrabold text-[#332222]">
                            @_filteredArticles.Count
                        </span>
                        <span class="text-[11px] text-slate-500">
                            De @_allArticles.Count artículos registrados
                        </span>
                    </div>

                    <!-- Publicados -->
                    <div class="rounded-2xl bg-gradient-to-br from-[#4d1a1a]/12 via-[#4d1a1a]/5 to-white border border-[#4d1a1a]/30 px-4 py-3 shadow-sm flex flex-col gap-1">
                        <span class="text-[11px] font-semibold uppercase tracking-wide text-[#4d1a1a]">
                            Publicados
                        </span>
                        <span class="text-xl font-extrabold text-[#4d1a1a]">
                            @_allArticles.Count(a => GetStatusKey(a) == "PUBLICADO")
                        </span>
                        <span class="text-[11px] text-[#4d1a1a]/80">
                            Estado final publicado
                        </span>
                    </div>

                    <!-- Aceptados -->
                    <div class="rounded-2xl bg-gradient-to-br from-[#1a2b2b]/12 via-[#1a2b2b]/5 to-white border border-[#1a2b2b]/30 px-4 py-3 shadow-sm flex flex-col gap-1">
                        <span class="text-[11px] font-semibold uppercase tracking-wide text-[#1a2b2b]">
                            Aceptados
                        </span>
                        <span class="text-xl font-extrabold text-[#1a2b2b]">
                            @_allArticles.Count(a => GetStatusKey(a) == "ACEPTADO")
                        </span>
                        <span class="text-[11px] text-[#1a2b2b]/80">
                            En fase previa a publicación
                        </span>
                    </div>

                    <!-- Sin estado -->
                    <div class="rounded-2xl bg-gradient-to-br from-[#332222]/10 via-[#332222]/5 to-white border border-[#332222]/25 px-4 py-3 shadow-sm flex flex-col gap-1">
                        <span class="text-[11px] font-semibold uppercase tracking-wide text-[#332222]">
                            Sin estado
                        </span>
                        <span class="text-xl font-extrabold text-[#332222]">
                            @_allArticles.Count(a => GetStatusKey(a) == "SIN ESTADO")
                        </span>
                        <span class="text-[11px] text-[#332222]/80">
                            Pendientes de clasificación
                        </span>
                    </div>
                </div>
            }

            <!-- BARRA DE ESTADO (PUBLICADO / ACEPTADO / SIN ESTADO) -->
            <div class="pt-1">
                <ArticleStatusFilterBar StatusOptions="StatusOptions"
                                        @bind-SelectedStatus="StatusFilter" />
            </div>
        </div>

        <!-- MENSAJES DE ESTADO -->
        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="rounded-2xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700 shadow-sm">
                @_errorMessage
            </div>
        }
        else if (_isLoading)
        {
            <div class="rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-700 shadow-sm">
                Cargando artículos…
            </div>
        }
        else if (!_filteredArticles.Any())
        {
            <div class="rounded-2xl border border-slate-200 bg-white px-4 py-10 text-center shadow-sm">
                <p class="text-sm font-medium text-slate-700">
                    No se encontraron artículos con los criterios seleccionados.
                </p>
                <p class="mt-1 text-xs text-slate-500">
                    Prueba cambiando el texto de búsqueda o limpiando los filtros.
                </p>
            </div>
        }
        else
        {
            <!-- TOOLBAR DE BÚSQUEDA + VISTA + ACCIONES (justo encima del tablero/tabla) -->
            <div class="mb-3 rounded-2xl border border-slate-200 bg-white/95 px-4 py-3 shadow-sm">
                <ArticleListToolbar Title=""
                                    Subtitle=""
                                    @bind-SearchText="SearchText"
                                    @bind-IsCardsView="IsCardsView"
                                    OnReload="ReloadAsync"
                                    OnNew="GoToNew"
                                    IsBusy="_isLoading"
                                    SearchPlaceholder="Buscar por título, revista, DOI…" />
            </div>

            <!-- TOOLBAR DE PAGINADO SUPERIOR -->
            <div class="flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-slate-200 bg-white/90 px-4 py-2.5 shadow-sm">
                <div class="text-sm text-slate-700">
                    Mostrando
                    <span class="font-semibold">@PageStart</span>–<span class="font-semibold">@PageEnd</span>
                    de
                    <span class="font-semibold">@_filteredArticles.Count</span>
                    artículos
                </div>

                <div class="flex items-center gap-3">
                    <label class="text-xs text-slate-600">Por página</label>
                    <select class="rounded-lg border border-slate-300 bg-white px-2 py-1.5 text-xs shadow-sm"
                            @bind="_pageSize"
                            @bind:after="PageSizeChanged">
                        @foreach (var s in _pageSizeOptions)
                        {
                            <option value="@s">@s</option>
                        }
                    </select>

                    <AppPager Class="ml-2"
                              Page="@_page"
                              TotalPages="@TotalPages"
                              OnPrev="PrevPage"
                              OnNext="NextPage" />
                </div>
            </div>

            <!-- CONTENIDO PRINCIPAL: KANBAN O TABLA -->
            <div class="mt-4 rounded-3xl bg-gradient-to-b from-[#f2f2f2] via-[#e6f0f0] to-[#f2f2f2] border border-[#d4d4d4] px-4 py-4 shadow-sm">
                @if (_view == ViewMode.Cards)
                {
                    <ArticleKanbanBoard Items="PagedItems"
                                        OnViewMore="OpenDetails" />
                }
                else
                {
                    <ArticleListTable Items="PagedItems"
                                      OnViewMore="OpenDetails"
                                      OnEdit="GoToEdit"
                                      OnDelete="AskDeleteById" />
                }
            </div>

            <!-- PAGINADOR INFERIOR -->
            <AppPager Class="mt-4"
                      Page="@_page"
                      TotalPages="@TotalPages"
                      OnPrev="PrevPage"
                      OnNext="NextPage" />
        }
    </div>
</div>

<!-- MODAL DETALLES -->
<ArticleDetailsModal Visible="@_isDetailsOpen"
                     Summary="@_selectedArticle"
                     Detail="@_selectedDetail"
                     IsLoading="@_isDetailLoading"
                     OnClose="CloseDetails"
                     OnOpenDocument="OpenDocumentAsync"
                     OnEdit="@(() => { if (_selectedArticle is not null) GoToEdit(_selectedArticle.Id); })"
                     OnDelete="@(() => { if (_selectedArticle is not null) AskDelete(_selectedArticle); })" />

<!-- DIÁLOGO CONFIRMACIÓN ELIMINACIÓN -->
<ConfirmDialog @ref="_confirmDelete"
               Title="Eliminar artículo"
               ConfirmText="Eliminar"
               CancelText="Cancelar"
               Variant="ConfirmVariant.Danger"
               OnConfirm="ConfirmDeleteAsync">
    ¿Estás seguro de que deseas eliminar el artículo
    <strong>@_articleToDeleteTitle</strong>? Esta acción no se puede deshacer.
</ConfirmDialog>

@code {
    private enum ViewMode
    {
        Cards,
        Table
    }

    private List<ArticleListItemDto> _allArticles = new();
    private List<ArticleListItemDto> _filteredArticles = new();

    private bool _isLoading = true;
    private string? _errorMessage;

    // Filtros internos
    private string? _searchText;
    private string? _statusFilter;

    // Bindings para toolbar y barra de estado
    private string? SearchText
    {
        get => _searchText;
        set
        {
            _searchText = value;
            ApplyFilters();
        }
    }

    private string? StatusFilter
    {
        get => _statusFilter;
        set
        {
            _statusFilter = value;
            ApplyFilters();
        }
    }

    // Vista actual
    private ViewMode _view = ViewMode.Cards;
    private bool IsCardsView
    {
        get => _view == ViewMode.Cards;
        set => _view = value ? ViewMode.Cards : ViewMode.Table;
    }

    // Paginación
    private int _page = 1;
    private int _pageSize = 3;
    private readonly int[] _pageSizeOptions = new[] { 3, 6, 9, 12, 15 };

    private int TotalPages => Math.Max(1, (int)Math.Ceiling((double)_filteredArticles.Count / _pageSize));
    private int PageStart => _filteredArticles.Count == 0 ? 0 : ((_page - 1) * _pageSize) + 1;
    private int PageEnd => Math.Min(_filteredArticles.Count, _page * _pageSize);

    private IEnumerable<ArticleListItemDto> PagedItems =>
        _filteredArticles
            .Skip((_page - 1) * _pageSize)
            .Take(_pageSize);

    // Modal detalle
    private ArticleListItemDto? _selectedArticle;
    private ArticleDetailDto? _selectedDetail;
    private bool _isDetailsOpen;
    private bool _isDetailLoading;

    // Eliminar
    private ArticleListItemDto? _articleToDelete;
    private string _articleToDeleteTitle => _articleToDelete?.Title ?? string.Empty;
    private ConfirmDialog? _confirmDelete;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            _allArticles = await ArticlesClient.GetAllAsync() ?? new List<ArticleListItemDto>();
            ApplyFilters();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private void ApplyFilters()
    {
        IEnumerable<ArticleListItemDto> query = _allArticles;

        if (!string.IsNullOrWhiteSpace(SearchText))
        {
            var q = SearchText.Trim().ToLowerInvariant();
            query = query.Where(a =>
                (!string.IsNullOrWhiteSpace(a.Title) && a.Title.ToLower().Contains(q)) ||
                (!string.IsNullOrWhiteSpace(a.VenueName) && a.VenueName.ToLower().Contains(q)) ||
                (!string.IsNullOrWhiteSpace(a.Doi) && a.Doi.ToLower().Contains(q)));
        }

        if (!string.IsNullOrWhiteSpace(StatusFilter))
        {
            query = query.Where(a => GetStatusKey(a) == StatusFilter);
        }

        _filteredArticles = query
            .OrderByDescending(a => GetStatusKey(a))
            .ThenByDescending(a => a.Year)
            .ThenBy(a => a.Title)
            .ToList();

        _page = 1;
        StateHasChanged();
    }

    private IEnumerable<string> StatusOptions =>
        _allArticles
            .Select(a => GetStatusKey(a))
            .Distinct()
            .Where(s => !string.IsNullOrWhiteSpace(s))
            .OrderBy(s => s);

    private string GetStatusKey(ArticleListItemDto a)
    {
        var s = a.PublicationStatusName ?? string.Empty;
        s = s.Trim().ToUpperInvariant();
        return s switch
        {
            "PUBLICADO" => "PUBLICADO",
            "ACEPTADO" => "ACEPTADO",
            _ => "SIN ESTADO"
        };
    }

    private void PrevPage()
    {
        if (_page > 1)
            _page--;
    }

    private void NextPage()
    {
        if (_page < TotalPages)
            _page++;
    }

    private void PageSizeChanged()
    {
        _page = 1;
    }

    private async Task ReloadAsync() => await LoadAsync();

    private void GoToNew() => Nav.NavigateTo("/articulos/registrar");

    private void OpenDetails(ArticleListItemDto item)
    {
        _selectedArticle = item;
        _isDetailsOpen = true;
        _ = LoadDetailAsync(item.Id);
    }

    private async Task LoadDetailAsync(int id)
    {
        _isDetailLoading = true;
        _selectedDetail = null;

        try
        {
            _selectedDetail = await ArticlesClient.GetByIdAsync(id);
        }
        finally
        {
            _isDetailLoading = false;
            StateHasChanged();
        }
    }

    private void CloseDetails()
    {
        _isDetailsOpen = false;
        _selectedArticle = null;
        _selectedDetail = null;
    }

    private void GoToEdit(int id)
    {
        Nav.NavigateTo($"/articulos/registrar{id}");
    }

    private async Task OpenDocumentAsync()
    {
        if (_selectedDetail is null && _selectedArticle is not null)
        {
            await LoadDetailAsync(_selectedArticle.Id);
        }

        var url = _selectedDetail?.EvidenceUrl
                  ?? _selectedDetail?.PublicationUrl
                  ?? _selectedDetail?.JournalUrl;

        if (!string.IsNullOrWhiteSpace(url))
        {
            Nav.NavigateTo(url!, true);
        }
    }

    private void AskDelete(ArticleListItemDto item)
    {
        _articleToDelete = item;
        _confirmDelete?.Show();
    }

    private void AskDeleteById(int id)
    {
        var item = _filteredArticles.FirstOrDefault(a => a.Id == id)
                   ?? _allArticles.FirstOrDefault(a => a.Id == id);

        if (item is not null)
        {
            AskDelete(item);
        }
    }

    private async Task ConfirmDeleteAsync()
    {
        if (_articleToDelete is null)
            return;

        await ArticlesClient.DeleteAsync(_articleToDelete.Id);

        _allArticles.RemoveAll(a => a.Id == _articleToDelete.Id);
        ApplyFilters();

        if (_selectedArticle?.Id == _articleToDelete.Id)
        {
            CloseDetails();
        }

        _articleToDelete = null;
    }
}
