@page "/analytics/prediction"
@attribute [Authorize]
@using System.Linq

<AppHeroHeader Title="Recommendation & Prediction" Subtitle="Analytics Workbench">
    <Actions>
        <button class="btn btn-light" @onclick="OnExportCsv">Export CSV</button>
        <button class="btn btn-outline-secondary" @onclick="OnExportPdf">Export PDF</button>
        <button class="btn btn-primary" @onclick="OnGenerateReport">Generate Report</button>
    </Actions>
</AppHeroHeader>

<AppPillTabs Class="mb-3" Items="@Tabs" />

<div class="row g-4">
    <!-- ===== MAIN COLUMN ===== -->
    <div class="col-12 col-xxl-8">
        <!-- 1) DATA SELECTION -->
        <AppGlassCard Title="Data Selection" Icon="🧱" Class="mb-3">
            <div class="row g-3">
                <AppFormSelect Label="Source Dataset"
                               Placeholder="Choose…"
                               ColCss="col-12 col-md-6"
                               Options="@(DatasetOptions.Select(o => o.Value))"
                               @bind-Value="UI.State.Dataset" />

                <AppFormSelect Label="Time Window"
                               Placeholder="Choose…"
                               ColCss="col-12 col-md-6"
                               Options="@(TimeWindowOptions.Select(o => o.Value))"
                               @bind-Value="UI.State.TimeWindow" />

                <AppFormSelect Label="Filter by Research Group"
                               Placeholder="All groups"
                               ColCss="col-12 col-md-6"
                               Options="@(GroupOptions.Select(o => o.Value))"
                               @bind-Value="UI.State.GroupID" />

                <AppFormSelect Label="Filter by Journal"
                               Placeholder="All journals"
                               ColCss="col-12 col-md-6"
                               Options="@(JournalOptions.Select(o => o.Value))"
                               @bind-Value="UI.State.JournalID" />
            </div>
        </AppGlassCard>

        <!-- 2) TARGET & FEATURES -->
        <AppGlassCard Title="Target & Features" Icon="🎯" Class="mb-3">
            <div class="row g-3">
                <AppFormSelect Label="Target to Predict"
                               Placeholder="Select the target variable"
                               ColCss="col-12 col-md-6"
                               Options="@(TargetOptions.Select(o => o.Value))"
                               @bind-Value="UI.State.Target" />

                <AppFormSelect Label="Feature Presets"
                               Placeholder="Pick a preset"
                               ColCss="col-12 col-md-6"
                               Options="@(FeaturePresetOptions.Select(o => o.Value))"
                               @bind-Value="UI.State.FeaturePreset"
                               OnChange="OnFeaturePresetChanged" />

                <div class="col-12">
                    <label class="form-label">Selected Features</label>
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var f in UI.SelectedFeatures)
                        {
                            <span class="badge bg-light text-dark border">
                                @f <button type="button" class="btn btn-sm btn-link ps-2" @onclick="@(() => RemoveFeature(f))">✕</button>
                            </span>
                        }
                        <div class="d-inline-block">
                            <input class="form-control form-control-sm" placeholder="Add feature…" @bind="UI.FeatureToAdd" />
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="AddFeature">Add</button>
                    </div>
                    <div class="form-text">Tip: combine structured fields (IndexDatabase, SJR, Year, Group, Project, DetailedField, etc.).</div>
                </div>
            </div>
        </AppGlassCard>

        <!-- 3) MODEL CANDIDATES -->
        <AppGlassCard Title="Model Candidates" Icon="🤖" Class="mb-3">
            <div class="row g-3">
                <div class="col-12 col-md-6">
                    <div class="card h-100 border-0 shadow-sm">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <h6 class="card-title mb-0">Baseline (Linear)</h6>
                                <input type="checkbox" class="form-check-input" @bind="UI.Models.Linear.Selected" />
                            </div>
                            <div class="small text-muted mb-2">Fast baseline for numeric targets (e.g., SJR).</div>
                            <div class="row g-2">
                                <div class="col-6">
                                    <!-- usar string para evitar EventCallback<int> -->
                                    <AppFormInput Label="Train Split (%)" Type="number" @bind-Value="UI.Models.Linear.TrainSplitText" />
                                </div>
                                <div class="col-6">
                                    <AppFormSelect Label="Normalization"
                                                   Options="@(YesNoOptions.Select(o => o.Value))"
                                                   @bind-Value="UI.Models.Linear.Normalize" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-md-6">
                    <div class="card h-100 border-0 shadow-sm">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <h6 class="card-title mb-0">Random Forest</h6>
                                <input type="checkbox" class="form-check-input" @bind="UI.Models.Forest.Selected" />
                            </div>
                            <div class="small text-muted mb-2">Robust to outliers, handles mixed features.</div>
                            <div class="row g-2">
                                <div class="col-6">
                                    <AppFormInput Label="Trees" Type="number" @bind-Value="UI.Models.Forest.TreesText" />
                                </div>
                                <div class="col-6">
                                    <AppFormSelect Label="Max Depth"
                                                   Options="@(DepthOptions.Select(o => o.Value))"
                                                   @bind-Value="UI.Models.Forest.MaxDepth" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-md-6">
                    <div class="card h-100 border-0 shadow-sm">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <h6 class="card-title mb-0">Gradient Boosting</h6>
                                <input type="checkbox" class="form-check-input" @bind="UI.Models.Boosting.Selected" />
                            </div>
                            <div class="small text-muted mb-2">Strong performance for tabular datasets.</div>
                            <div class="row g-2">
                                <div class="col-6">
                                    <AppFormInput Label="Estimators" Type="number" @bind-Value="UI.Models.Boosting.EstimatorsText" />
                                </div>
                                <div class="col-6">
                                    <AppFormInput Label="Learning Rate" Type="number" Step="0.01" @bind-Value="UI.Models.Boosting.LearningRateText" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-md-6">
                    <div class="card h-100 border-0 shadow-sm">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <h6 class="card-title mb-0">Classifier (Logistic/KNN)</h6>
                                <input type="checkbox" class="form-check-input" @bind="UI.Models.Classifier.Selected" />
                            </div>
                            <div class="small text-muted mb-2">Use when target is categorical (e.g., Status).</div>
                            <div class="row g-2">
                                <div class="col-6">
                                    <AppFormSelect Label="Algorithm"
                                                   Options="@(ClassifierOptions.Select(o => o.Value))"
                                                   @bind-Value="UI.Models.Classifier.Algorithm" />
                                </div>
                                <div class="col-6">
                                    <AppFormInput Label="CV Folds" Type="number" @bind-Value="UI.Models.Classifier.CVText" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2 mt-3">
                <button class="btn btn-outline-secondary" @onclick="OnPreviewData">Preview Data</button>
                <button class="btn btn-primary" @onclick="OnTrain">Train & Evaluate</button>
            </div>
        </AppGlassCard>

        <!-- 4) RESULTS & EXPLAINABILITY -->
        <AppGlassCard Title="Results & Explainability" Icon="📈" Class="mb-3">
            <div class="row g-3">
                <div class="col-12 col-xl-6">
                    <div class="card h-100 border-0 shadow-sm">
                        <div class="card-body">
                            <h6 class="card-title">Metrics</h6>
                            <div class="row text-center g-3">
                                <div class="col-4">
                                    <div class="small text-muted">R² / F1</div>
                                    <div class="display-6">@UI.Metrics.Main.ToString("0.000")</div>
                                </div>
                                <div class="col-4">
                                    <div class="small text-muted">MAE / Acc</div>
                                    <div class="display-6">@UI.Metrics.Secondary.ToString("0.000")</div>
                                </div>
                                <div class="col-4">
                                    <div class="small text-muted">RMSE / AUC</div>
                                    <div class="display-6">@UI.Metrics.Tertiary.ToString("0.000")</div>
                                </div>
                            </div>
                            <div class="small text-muted mt-2">* Metrics change depending on regression vs. classification.</div>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-xl-6">
                    <div class="card h-100 border-0 shadow-sm">
                        <div class="card-body">
                            <h6 class="card-title">Top Feature Importances</h6>
                            <ul class="list-unstyled mb-0">
                                @foreach (var (name, score) in UI.TopFeatures)
                                {
                                    <li class="mb-2">
                                        <div class="d-flex justify-content-between">
                                            <span>@name</span>
                                            <span class="text-muted">@($"{score:0.00}")</span>
                                        </div>
                                        <div class="progress" style="height: 6px;">
                                            <div class="progress-bar" role="progressbar" style="width: @(Math.Min(score * 10, 100))%"></div>
                                        </div>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- Charts placeholders -->
                <div class="col-12 col-xl-6">
                    <div class="card h-100 border-0 shadow-sm">
                        <div class="card-body">
                            <h6 class="card-title">Predicted vs. Actual</h6>
                            <div class="chart-placeholder border rounded-3 d-flex align-items-center justify-content-center" style="height: 260px;">
                                <span class="text-muted">[Chart Placeholder]</span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-xl-6">
                    <div class="card h-100 border-0 shadow-sm">
                        <div class="card-body">
                            <h6 class="card-title">Residuals / Confusion Matrix</h6>
                            <div class="chart-placeholder border rounded-3 d-flex align-items-center justify-content-center" style="height: 260px;">
                                <span class="text-muted">[Chart Placeholder]</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </AppGlassCard>

        <!-- 5) DATA PREVIEW -->
        <AppGlassCard Title="Data Preview" Icon="🧾">
            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <thead>
                        <tr class="text-muted">
                            @foreach (var col in UI.Preview.Columns)
                            {
                                <th>@col</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in UI.Preview.Rows)
                        {
                            <tr>
                                @foreach (var cell in row)
                                {
                                    <td>@cell</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </AppGlassCard>
    </div>

    <!-- ===== ASIDE ===== -->
    <div class="col-12 col-xxl-4">
        <div class="sticky-aside">
            <AppGlassCard Title="Run Summary" Icon="🔎" Class="mb-3">
                <div class="small text-muted">Dataset</div>
                <div class="fw-semibold mb-2">@UI.State.Dataset ?? "—"</div>

                <div class="small text-muted">Target</div>
                <div class="fw-semibold mb-2">@UI.State.Target ?? "—"</div>

                <div class="small text-muted">Features</div>
                <div class="d-flex flex-wrap gap-2">
                    @if (UI.SelectedFeatures.Count == 0)
                    {
                        <span class="text-muted">—</span>
                    }
                    else
                    {
                        @foreach (var f in UI.SelectedFeatures)
                        {
                            <span class="badge bg-primary-subtle text-primary border">@f</span>
                        }
                    }
                </div>

                <hr />
                <div class="small text-muted">Selected Models</div>
                <ul class="small mb-0">
                    @foreach (var m in GetSelectedModels())
                    {
                        <li>@m</li>
                    }
                </ul>
            </AppGlassCard>

            <AppGlassCard Title="Quick Actions" Icon="⚡">
                <div class="d-grid gap-2">
                    <button class="btn btn-light border" @onclick="OnSaveSetup">Save Setup</button>
                    <button class="btn btn-outline-secondary" @onclick="OnLoadSetup">Load Setup</button>
                    <button class="btn btn-primary" @onclick="OnTrain">Train Now</button>
                </div>
            </AppGlassCard>
        </div>
    </div>
</div>

@code {
    /* ===== Tabs ===== */
    private IEnumerable<AppPillTabs.PillTab> Tabs => new[]
    {
        new AppPillTabs.PillTab{ Label="Workbench", Icon="🧪", Active=true },
        new AppPillTabs.PillTab{ Label="Models",   Icon="🤖" },
        new AppPillTabs.PillTab{ Label="Reports",  Icon="📊" }
    };

    /* ===== Options (solo UI) ===== */
    private readonly List<OptionItem> DatasetOptions = new()
    {
        new("Publications (All)","pub_all"),
        new("Publications (Last 3 Years)","pub_3y"),
        new("Publications (SJR ≥ 0.5)","pub_sjr05")
    };

    private readonly List<OptionItem> TimeWindowOptions = new()
    {
        new("All time","all"),
        new("Last year","1y"),
        new("Last 3 years","3y"),
        new("Custom","custom")
    };

    private readonly List<OptionItem> GroupOptions = new()
    {
        new("All",""),
        new("Group A","1"),
        new("Group B","2"),
        new("Group C","3")
    };

    private readonly List<OptionItem> JournalOptions = new()
    {
        new("All",""),
        new("Journal of X","10"),
        new("Computing Letters","11"),
        new("Science Today","12")
    };

    private readonly List<OptionItem> TargetOptions = new()
    {
        new("SJR (numeric regression)","SJR"),
        new("Status (classification)","StatusID"),
        new("Publication probability (binary)","IsPublished"),
        new("Time-to-publish (months)","TimeToPublish")
    };

    private readonly List<OptionItem> FeaturePresetOptions = new()
    {
        new("Minimal (IndexDB + Year)","minimal"),
        new("Content (Fields + Journal)","content"),
        new("Institutional (Group + Project)","institution"),
        new("Everything","all")
    };

    private readonly List<OptionItem> YesNoOptions = new()
    {
        new("Yes","yes"), new("No","no")
    };

    private readonly List<OptionItem> DepthOptions = new()
    {
        new("Auto","auto"), new("3","3"), new("5","5"), new("10","10")
    };

    private readonly List<OptionItem> ClassifierOptions = new()
    {
        new("Logistic Regression","logit"), new("K-Nearest Neighbors","knn")
    };

    /* ===== UI State ===== */
    private UIState UI { get; set; } = new();

    protected override void OnInitialized()
    {
        // preview de ejemplo
        UI.Preview = new PreviewTable
        {
            Columns = new() { "PublicationCode", "Title", "SJR", "StatusID", "PublicationDate" },
            Rows = new()
            {
                new() { "PUB-2025-001", "AI for Research", "0.621", "3", "2025-03-10" },
                new() { "PUB-2025-002", "Statistics & Quality", "0.480", "2", "2025-02-01" },
                new() { "PUB-2025-003", "Health Data Mining", "0.712", "3", "2025-01-20" },
            }
        };

        UI.TopFeatures = new() { ("IndexDatabaseID", 8.2), ("DetailedFieldID", 7.5), ("JournalID", 6.1), ("GroupID", 5.4) };

        // seed strings para inputs numéricos
        UI.Models.Linear.TrainSplitText = UI.Models.Linear.TrainSplit.ToString();
        UI.Models.Forest.TreesText = UI.Models.Forest.Trees.ToString();
        UI.Models.Boosting.EstimatorsText = UI.Models.Boosting.Estimators.ToString();
        UI.Models.Boosting.LearningRateText = UI.Models.Boosting.LearningRate.ToString("0.##");
        UI.Models.Classifier.CVText = UI.Models.Classifier.CV.ToString();
    }

    /* ===== Actions (solo UI) ===== */
    private void OnPreviewData() { /* placeholder */ }

    private void OnTrain()
    {
        // sincronizar strings -> numéricos con tolerancia
        if (int.TryParse(UI.Models.Linear.TrainSplitText, out var trainSplit)) UI.Models.Linear.TrainSplit = trainSplit;
        if (int.TryParse(UI.Models.Forest.TreesText, out var trees)) UI.Models.Forest.Trees = trees;
        if (int.TryParse(UI.Models.Boosting.EstimatorsText, out var est)) UI.Models.Boosting.Estimators = est;
        if (double.TryParse(UI.Models.Boosting.LearningRateText, out var lr)) UI.Models.Boosting.LearningRate = lr;
        if (int.TryParse(UI.Models.Classifier.CVText, out var cv)) UI.Models.Classifier.CV = cv;

        // placeholders de métricas e importancias
        UI.Metrics = new(0.812, 0.354, 0.621);
        UI.TopFeatures = UI.TopFeatures.OrderByDescending(x => x.Importance).ToList();
    }

    private void OnExportCsv() { /* placeholder */ }
    private void OnExportPdf() { /* placeholder */ }
    private void OnGenerateReport() { /* placeholder */ }
    private void OnSaveSetup() { /* placeholder */ }
    private void OnLoadSetup() { /* placeholder */ }

    // handler compatible con EventCallback (no genérico)
    private void OnFeaturePresetChanged(string? newValue)
    {
        UI.State.FeaturePreset = newValue;
        ApplyPreset();
    }

    private void ApplyPreset()
    {
        UI.SelectedFeatures.Clear();
        switch (UI.State.FeaturePreset)
        {
            case "minimal":
                UI.SelectedFeatures.AddRange(new[] { "IndexDatabaseID", "Year" });
                break;
            case "content":
                UI.SelectedFeatures.AddRange(new[] { "BroadFieldID", "SpecificFieldID", "DetailedFieldID", "JournalID" });
                break;
            case "institution":
                UI.SelectedFeatures.AddRange(new[] { "GroupID", "ProjectID" });
                break;
            case "all":
                UI.SelectedFeatures.AddRange(new[] { "IndexDatabaseID", "Year", "BroadFieldID", "SpecificFieldID", "DetailedFieldID", "JournalID", "GroupID", "ProjectID", "AuthorsCount" });
                break;
        }
    }

    private void AddFeature()
    {
        var f = (UI.FeatureToAdd ?? "").Trim();
        if (!string.IsNullOrWhiteSpace(f) && !UI.SelectedFeatures.Contains(f))
            UI.SelectedFeatures.Add(f);
        UI.FeatureToAdd = string.Empty;
    }

    private void RemoveFeature(string f) => UI.SelectedFeatures.Remove(f);

    private IEnumerable<string> GetSelectedModels()
    {
        if (UI.Models.Linear.Selected) yield return "Baseline (Linear)";
        if (UI.Models.Forest.Selected) yield return "Random Forest";
        if (UI.Models.Boosting.Selected) yield return "Gradient Boosting";
        if (UI.Models.Classifier.Selected) yield return $"Classifier ({UI.Models.Classifier.Algorithm ?? "-"})";
    }

    /* ===== Types ===== */
    record OptionItem(string Label, string Value);

    sealed class UIState
    {
        public State State { get; set; } = new();
        public string? FeatureToAdd { get; set; }
        public List<string> SelectedFeatures { get; } = new();

        public Models Models { get; set; } = new();
        public Metrics Metrics { get; set; } = new(0, 0, 0);

        public PreviewTable Preview { get; set; } = new();

        public List<(string Name, double Importance)> TopFeatures { get; set; } = new();

        public string? Dataset { get; set; } // opcional
    }

    sealed class PreviewTable
    {
        public List<string> Columns { get; set; } = new();
        public List<List<string>> Rows { get; set; } = new();
    }

    sealed class State
    {
        public string? Dataset { get; set; }
        public string? TimeWindow { get; set; }
        public string? GroupID { get; set; }
        public string? JournalID { get; set; }
        public string? Target { get; set; }
        public string? FeaturePreset { get; set; }
    }

    sealed class Models
    {
        public LinearModel Linear { get; set; } = new();
        public ForestModel Forest { get; set; } = new();
        public BoostingModel Boosting { get; set; } = new();
        public ClassifierModel Classifier { get; set; } = new();
    }

    sealed class LinearModel
    {
        public bool Selected { get; set; } = true;

        // valor real
        public int TrainSplit { get; set; } = 80;
        // binding seguro (string)
        public string TrainSplitText { get; set; } = "80";

        public string? Normalize { get; set; } = "yes";
    }

    sealed class ForestModel
    {
        public bool Selected { get; set; }

        public int Trees { get; set; } = 200;
        public string TreesText { get; set; } = "200";

        public string? MaxDepth { get; set; } = "auto";
    }

    sealed class BoostingModel
    {
        public bool Selected { get; set; }

        public int Estimators { get; set; } = 300;
        public string EstimatorsText { get; set; } = "300";

        public double LearningRate { get; set; } = 0.05;
        public string LearningRateText { get; set; } = "0.05";
    }

    sealed class ClassifierModel
    {
        public bool Selected { get; set; }

        public string? Algorithm { get; set; } = "logit";

        public int CV { get; set; } = 5;
        public string CVText { get; set; } = "5";
    }

    sealed record Metrics(double Main, double Secondary, double Tertiary);
}
