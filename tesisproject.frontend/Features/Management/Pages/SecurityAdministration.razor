@page "/management/security-administration"
@attribute [Authorize(Roles = "Admin")]
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using tesisproject.frontend.Services.Platform.Auth
@using tesisproject.shared.DTOs.Auth
@inject IIdentityAdministrationClient IdentityAdministrationClient

<PageTitle>Usuarios y roles</PageTitle>

<div class="module-shell app-page-shell app-shell-warm py-4 security-admin-page">
    <section class="module-hero module-hero--blue mb-4">
        <div class="d-flex flex-column gap-3 flex-lg-row justify-content-between align-items-lg-center">
            <div>
                <div class="module-kicker">Administración institucional</div>
                <div class="d-flex align-items-center gap-3">
                    <span class="security-hero__icon">⌘</span>
                    <h1 class="h3 mb-1">Usuarios y roles</h1>
                </div>
                <p class="mb-0 text-white-75">Organiza accesos, responsabilidades y permisos operativos del sistema.</p>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <button class="btn btn-outline-light fw-semibold" @onclick="OpenCreateRoleModal">
                    Nuevo perfil
                </button>
                <button class="btn btn-light fw-semibold" @onclick="OpenCreateUserModal">
                    Nuevo usuario
                </button>
                <button class="btn btn-light fw-semibold" @onclick="ReloadAsync" disabled="@IsBusy">
                    @(IsBusy ? "Actualizando..." : "Actualizar panel")
                </button>
            </div>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="alert alert-danger shadow-sm">@ErrorMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(SuccessMessage))
    {
        <div class="alert alert-success shadow-sm">@SuccessMessage</div>
    }

    <section class="security-command-center mb-4">
        <div class="security-command-center__stats">
            <article class="security-mini-stat">
                <span class="security-mini-stat__icon">◉</span>
                <span>
                    <strong>@Users.Count</strong>
                    <small>usuarios</small>
                </span>
            </article>
            <article class="security-mini-stat">
                <span class="security-mini-stat__icon">⌘</span>
                <span>
                    <strong>@Roles.Count</strong>
                    <small>roles</small>
                </span>
            </article>
            <article class="security-mini-stat security-mini-stat--warm">
                <span class="security-mini-stat__icon">✓</span>
                <span>
                    <strong>@Users.Count(x => !x.IsLockedOut)</strong>
                    <small>activos</small>
                </span>
            </article>
        </div>
        <div class="security-command-center__actions">
            <button type="button" class="security-pill-action security-pill-action--primary" @onclick="OpenCreateUserModal">+ Usuario</button>
            <button type="button" class="security-pill-action" @onclick="OpenCreateRoleModal"># Perfil</button>
        </div>
    </section>

    <section class="security-workspace">
        <div class="security-workspace__tabs" role="tablist" aria-label="Administración de accesos">
            <button type="button" class="@GetSecurityTabClass("users")" @onclick='() => SetSecurityTab("users")'>
                <span>Usuarios</span>
                <small>@FilteredUsers.Count()</small>
            </button>
            <button type="button" class="@GetSecurityTabClass("roles")" @onclick='() => SetSecurityTab("roles")'>
                <span>Roles</span>
                <small>@Roles.Count</small>
            </button>
            <button type="button" class="@GetSecurityTabClass("permissions")" @onclick='() => SetSecurityTab("permissions")'>
                <span>Permisos</span>
                <small>@(SelectedUser is null ? "Elegir usuario" : "Editando")</small>
            </button>
        </div>

        @if (ActiveSecurityTab == "users")
        {
            <div class="security-panel">
                <div class="security-panel__header">
                    <div>
                        <div class="security-admin-card__eyebrow">Directorio operativo</div>
                        <h2 class="h5 mb-1">Usuarios registrados</h2>
                        <p class="text-muted mb-0">Busca una cuenta y selecciónala para ajustar sus permisos.</p>
                    </div>
                    <div class="security-filter-bar">
                        <input class="security-filter-input" placeholder="Buscar por nombre o correo" @bind="UserSearchTerm" @bind:event="oninput" />
                        <select class="security-filter-select" @bind="RoleFilter">
                            <option value="">Todos los roles</option>
                            @foreach (var role in Roles)
                            {
                                <option value="@role.Name">@GetRoleDisplayName(role.Name)</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="security-user-grid">
                    @if (!FilteredUsers.Any())
                    {
                        <div class="security-empty-state">No encontramos usuarios con los filtros actuales.</div>
                    }
                    else
                    {
                        @foreach (var user in FilteredUsers)
                        {
                            <button type="button"
                                    class="security-user-card @(SelectedUser?.UserId == user.UserId ? "security-user-card--selected" : null)"
                                    @onclick="() => SelectUserAndOpenPermissions(user)">
                                <div class="security-user-card__header">
                                    <div class="security-user-avatar">@GetInitials(user)</div>
                                    <div class="security-user-card__identity">
                                        <div class="security-user-card__name">@GetUserDisplayName(user)</div>
                                        <div class="security-user-card__email">@user.Email</div>
                                    </div>
                                    <span class="security-status-pill @(user.IsLockedOut ? "security-status-pill--danger" : null)">
                                        @(user.IsLockedOut ? "Bloqueado" : "Activo")
                                    </span>
                                </div>
                                <div class="security-user-card__roles">
                                    @foreach (var role in user.Roles.Take(3))
                                    {
                                        <span class="security-role-chip">@GetRoleDisplayName(role)</span>
                                    }
                                    @if (user.Roles.Count() > 3)
                                    {
                                        <span class="security-role-chip security-role-chip--muted">+@(user.Roles.Count() - 3)</span>
                                    }
                                </div>
                            </button>
                        }
                    }
                </div>
            </div>
        }
        else if (ActiveSecurityTab == "roles")
        {
            <div class="security-panel">
                <div class="security-panel__header">
                    <div>
                        <div class="security-admin-card__eyebrow">Mapa de responsabilidades</div>
                        <h2 class="h5 mb-1">Roles del sistema</h2>
                        <p class="text-muted mb-0">Vista resumida de los perfiles que ordenan el flujo institucional.</p>
                    </div>
                    <button class="security-pill-action" @onclick="ToggleAdvancedRoleEditor">
                        @(ShowAdvancedRoleEditor ? "Ocultar códigos" : "Ver códigos internos")
                    </button>
                </div>

                <div class="security-role-grid">
                    @foreach (var role in Roles)
                    {
                        <article class="security-role-card">
                            <div class="security-role-card__top">
                                <span class="security-role-card__icon">@GetRoleIcon(role.Name)</span>
                                <span class="security-role-card__count">@role.UserCount usuario(s)</span>
                            </div>
                            <div class="security-role-card__title">@GetRoleDisplayName(role.Name)</div>
                            @if (ShowAdvancedRoleEditor)
                            {
                                <div class="security-role-card__code">@role.Name</div>
                            }
                            <div class="security-role-card__description">@GetRoleDescription(role.Name)</div>
                            <div class="security-capability-list">
                                @foreach (var capability in GetRoleCapabilities(role.Name))
                                {
                                    <span class="@GetCapabilityClass(capability.Key)">
                                        <i class="@capability.Icon"></i>
                                        @capability.Label
                                    </span>
                                }
                            </div>
                        </article>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="security-panel security-panel--permissions">
                <div class="security-panel__header">
                    <div>
                        <div class="security-admin-card__eyebrow">Asignación de permisos</div>
                        <h2 class="h5 mb-1">Responsabilidades del usuario</h2>
                        <p class="text-muted mb-0">Modifica solo los roles necesarios para mantener limpio el acceso operativo.</p>
                    </div>
                    @if (SelectedUser is not null)
                    {
                        <button class="security-pill-action security-pill-action--primary" @onclick="SaveSelectedUserRolesAsync" disabled="@IsBusy">
                            @(IsBusy ? "Guardando..." : "Guardar permisos")
                        </button>
                    }
                </div>

                @if (SelectedUser is null)
                {
                    <div class="security-empty-state security-empty-state--large">Selecciona un usuario desde la pestaña Usuarios para administrar sus permisos.</div>
                }
                else
                {
                    <div class="security-permission-layout">
                        <aside class="security-selected-user">
                            <div class="security-user-avatar security-user-avatar--large">@GetInitials(SelectedUser)</div>
                            <div class="security-selected-user__name">@GetUserDisplayName(SelectedUser)</div>
                            <div class="security-selected-user__email">@SelectedUser.Email</div>
                            <div class="security-user-card__roles">
                                @foreach (var role in SelectedUserRoles)
                                {
                                    <span class="security-role-chip">@GetRoleDisplayName(role)</span>
                                }
                            </div>
                            <div class="security-selected-user__capabilities">
                                <small>Acciones habilitadas</small>
                                <div class="security-capability-list security-capability-list--compact">
                                    @foreach (var capability in SelectedUserCapabilities)
                                    {
                                        <span class="@GetCapabilityClass(capability.Key)">
                                            <i class="@capability.Icon"></i>
                                            @capability.Label
                                        </span>
                                    }
                                </div>
                            </div>
                        </aside>

                        <div class="security-permission-grid">
                            @foreach (var role in Roles)
                            {
                                <label class="security-role-option">
                                    <div class="security-role-option__main">
                                        <span class="security-role-card__icon">@GetRoleIcon(role.Name)</span>
                                        <span>
                                            <span class="security-role-option__title">@GetRoleDisplayName(role.Name)</span>
                                            <span class="security-role-option__description">@GetRoleDescription(role.Name)</span>
                                            <span class="security-capability-list security-capability-list--inline">
                                                @foreach (var capability in GetRoleCapabilities(role.Name))
                                                {
                                                    <span class="@GetCapabilityClass(capability.Key)">
                                                        <i class="@capability.Icon"></i>
                                                        @capability.Label
                                                    </span>
                                                }
                                            </span>
                                        </span>
                                    </div>
                                    <input type="checkbox"
                                           class="form-check-input"
                                           checked="@SelectedUserRoles.Contains(role.Name)"
                                           @onchange="args => ToggleSelectedUserRole(role.Name, args.Value as bool?)" />
                                </label>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </section>

    @if (ShowCreateUserModal)
    {
        <div class="security-admin-modal-backdrop" @onclick="CloseCreateUserModalAsync">
            <div class="security-admin-modal" @onclick:stopPropagation="true">
                <div class="security-admin-modal__header">
                    <div>
                        <div class="security-admin-card__eyebrow">Nuevo acceso</div>
                        <h2 class="h4 mb-1">Registrar usuario</h2>
                        <p class="text-muted mb-0">Completa los datos básicos y selecciona las responsabilidades iniciales.</p>
                    </div>
                    <button type="button" class="security-admin-modal__close" @onclick="CloseCreateUserModalAsync">×</button>
                </div>

                <EditForm Model="CreateUserModel" OnValidSubmit="CreateUserAsync">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-danger small mb-3" />

                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label class="form-label">Correo institucional</label>
                            <InputText @bind-Value="CreateUserModel.Email" class="form-control" placeholder="usuario@uta.edu.ec" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label">Contraseña temporal</label>
                            <InputText @bind-Value="CreateUserModel.Password" type="password" class="form-control" placeholder="Asignar contraseña inicial" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Nombre completo</label>
                            <InputText @bind-Value="CreateUserModel.FullName" class="form-control" placeholder="Nombre del funcionario o docente" />
                        </div>
                    </div>

                    <div class="mt-4">
                        <label class="form-label d-block">Responsabilidades iniciales</label>
                        <div class="security-modal-role-grid">
                            @foreach (var role in Roles)
                            {
                                <label class="security-role-option">
                                    <div>
                                        <div class="security-role-option__title">@GetRoleDisplayName(role.Name)</div>
                                        <div class="security-role-option__description">@GetRoleDescription(role.Name)</div>
                                        <div class="security-capability-list security-capability-list--inline">
                                            @foreach (var capability in GetRoleCapabilities(role.Name))
                                            {
                                                <span class="@GetCapabilityClass(capability.Key)">
                                                    <i class="@capability.Icon"></i>
                                                    @capability.Label
                                                </span>
                                            }
                                        </div>
                                    </div>
                                    <input type="checkbox"
                                           class="form-check-input"
                                           checked="@CreateUserRoles.Contains(role.Name)"
                                           @onchange="args => ToggleCreateUserRole(role.Name, args.Value as bool?)" />
                                </label>
                            }
                        </div>
                    </div>

                    <div class="security-admin-modal__actions">
                        <button type="button" class="btn btn-outline-secondary" @onclick="CloseCreateUserModalAsync">Cancelar</button>
                        <button type="submit" class="btn btn-primary" disabled="@IsBusy">@(IsBusy ? "Creando..." : "Crear usuario")</button>
                    </div>
                </EditForm>
            </div>
        </div>
    }

    @if (ShowCreateRoleModal)
    {
        <div class="security-admin-modal-backdrop" @onclick="CloseCreateRoleModalAsync">
            <div class="security-admin-modal security-admin-modal--compact" @onclick:stopPropagation="true">
                <div class="security-admin-modal__header">
                    <div>
                        <div class="security-admin-card__eyebrow">Edición avanzada</div>
                        <h2 class="h4 mb-1">Crear perfil</h2>
                        <p class="text-muted mb-0">Usa esta opción solo cuando necesites un perfil nuevo no cubierto por los perfiles actuales.</p>
                    </div>
                    <button type="button" class="security-admin-modal__close" @onclick="CloseCreateRoleModalAsync">×</button>
                </div>

                <EditForm Model="CreateRoleModel" OnValidSubmit="CreateRoleAsync">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-danger small mb-3" />

                    <div class="mb-3">
                        <label class="form-label">Nombre interno del perfil</label>
                        <InputText @bind-Value="CreateRoleModel.Name" class="form-control" placeholder="Ejemplo: WorkflowAuditorInterno" />
                    </div>

                    <div class="security-admin-note">
                        Este editor está pensado para ampliaciones controladas del sistema. Los perfiles institucionales habituales ya están disponibles en el panel principal.
                    </div>

                    <div class="security-admin-modal__actions">
                        <button type="button" class="btn btn-outline-secondary" @onclick="CloseCreateRoleModalAsync">Cancelar</button>
                        <button type="submit" class="btn btn-primary" disabled="@IsBusy">@(IsBusy ? "Creando..." : "Crear perfil")</button>
                    </div>
                </EditForm>
            </div>
        </div>
    }
</div>

@code {
    private readonly List<IdentityUserListItemDto> Users = [];
    private readonly List<IdentityRoleListItemDto> Roles = [];
    private readonly HashSet<string> CreateUserRoles = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> SelectedUserRoles = new(StringComparer.OrdinalIgnoreCase);
    private static readonly IReadOnlyList<RoleCapability> EmptyCapabilities = [];

    private CreateUserFormModel CreateUserModel { get; set; } = new();
    private CreateRoleFormModel CreateRoleModel { get; set; } = new();
    private IdentityUserListItemDto? SelectedUser { get; set; }
    private bool ShowAdvancedRoleEditor { get; set; }
    private bool ShowCreateUserModal { get; set; }
    private bool ShowCreateRoleModal { get; set; }
    private bool IsBusy { get; set; }
    private string? ErrorMessage { get; set; }
    private string? SuccessMessage { get; set; }
    private string ActiveSecurityTab { get; set; } = "users";
    private string UserSearchTerm { get; set; } = string.Empty;
    private string RoleFilter { get; set; } = string.Empty;

    private IEnumerable<IdentityUserListItemDto> FilteredUsers
        => Users.Where(user =>
        {
            var matchesText = string.IsNullOrWhiteSpace(UserSearchTerm)
                || GetUserDisplayName(user).Contains(UserSearchTerm, StringComparison.OrdinalIgnoreCase)
                || (user.Email?.Contains(UserSearchTerm, StringComparison.OrdinalIgnoreCase) ?? false);

            var matchesRole = string.IsNullOrWhiteSpace(RoleFilter)
                || user.Roles.Any(role => string.Equals(role, RoleFilter, StringComparison.OrdinalIgnoreCase));

            return matchesText && matchesRole;
        });

    private IReadOnlyList<RoleCapability> SelectedUserCapabilities
        => SelectedUserRoles
            .SelectMany(GetRoleCapabilities)
            .GroupBy(x => x.Key, StringComparer.OrdinalIgnoreCase)
            .Select(g => g.First())
            .OrderBy(x => x.SortOrder)
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        SuccessMessage = null;
        ErrorMessage = null;
        IsBusy = true;
        try
        {
            var roles = await IdentityAdministrationClient.GetRolesAsync();
            var users = await IdentityAdministrationClient.GetUsersAsync();

            Roles.Clear();
            Roles.AddRange(roles.OrderBy(x => GetRoleDisplayName(x.Name)));

            Users.Clear();
            Users.AddRange(users.OrderBy(x => x.FullName).ThenBy(x => x.Email));

            if (SelectedUser is not null)
            {
                SelectedUser = Users.FirstOrDefault(x => x.UserId == SelectedUser.UserId);
                SyncSelectedUserRoles();
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"No pude cargar la administración de accesos: {ex.Message}";
        }
        finally
        {
            IsBusy = false;
        }
    }

    private Task OpenCreateUserModal()
    {
        ErrorMessage = null;
        SuccessMessage = null;
        ShowCreateUserModal = true;
        return Task.CompletedTask;
    }

    private async Task CreateUserAsync()
    {
        ErrorMessage = null;
        SuccessMessage = null;
        IsBusy = true;
        try
        {
            var user = await IdentityAdministrationClient.CreateUserAsync(new CreateIdentityUserRequest(
                CreateUserModel.Email,
                CreateUserModel.Password,
                CreateUserModel.FullName,
                CreateUserRoles.ToArray()));

            CreateUserModel = new();
            CreateUserRoles.Clear();
            SuccessMessage = $"El usuario {user.Email} fue creado correctamente.";
            ShowCreateUserModal = false;
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsBusy = false;
        }
    }

    private Task OpenCreateRoleModal()
    {
        ErrorMessage = null;
        SuccessMessage = null;
        ShowCreateRoleModal = true;
        return Task.CompletedTask;
    }

    private async Task CreateRoleAsync()
    {
        ErrorMessage = null;
        SuccessMessage = null;
        IsBusy = true;
        try
        {
            var role = await IdentityAdministrationClient.CreateRoleAsync(new CreateIdentityRoleRequest(CreateRoleModel.Name));
            CreateRoleModel = new();
            SuccessMessage = $"El rol {GetRoleDisplayName(role.Name)} ya quedó disponible para asignación.";
            ShowCreateRoleModal = false;
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsBusy = false;
        }
    }

    private Task CloseCreateUserModalAsync()
    {
        ShowCreateUserModal = false;
        return Task.CompletedTask;
    }

    private Task CloseCreateRoleModalAsync()
    {
        ShowCreateRoleModal = false;
        return Task.CompletedTask;
    }

    private void SelectUser(IdentityUserListItemDto user)
    {
        SelectedUser = user;
        SyncSelectedUserRoles();
    }

    private void SelectUserAndOpenPermissions(IdentityUserListItemDto user)
    {
        SelectUser(user);
        ActiveSecurityTab = "permissions";
    }

    private void SetSecurityTab(string tab)
    {
        ActiveSecurityTab = tab;
    }

    private void SyncSelectedUserRoles()
    {
        SelectedUserRoles.Clear();
        if (SelectedUser is null)
        {
            return;
        }

        foreach (var role in SelectedUser.Roles)
        {
            SelectedUserRoles.Add(role);
        }
    }

    private void ToggleCreateUserRole(string roleName, bool? isChecked)
    {
        if (isChecked == true)
        {
            CreateUserRoles.Add(roleName);
        }
        else
        {
            CreateUserRoles.Remove(roleName);
        }
    }

    private void ToggleSelectedUserRole(string roleName, bool? isChecked)
    {
        if (isChecked == true)
        {
            SelectedUserRoles.Add(roleName);
        }
        else
        {
            SelectedUserRoles.Remove(roleName);
        }
    }

    private async Task SaveSelectedUserRolesAsync()
    {
        if (SelectedUser is null)
        {
            return;
        }

        ErrorMessage = null;
        SuccessMessage = null;
        IsBusy = true;
        try
        {
            var updated = await IdentityAdministrationClient.UpdateUserRolesAsync(
                SelectedUser.UserId,
                new UpdateIdentityUserRolesRequest(SelectedUserRoles.ToArray()));

            SelectedUser = updated;
            SuccessMessage = $"Los permisos de {updated.Email} fueron actualizados correctamente.";
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsBusy = false;
        }
    }

    private void ToggleAdvancedRoleEditor()
    {
        ShowAdvancedRoleEditor = !ShowAdvancedRoleEditor;
    }

    private static string GetRoleDisplayName(string roleName)
        => roleName switch
        {
            "Admin" => "Administrador",
            "Analyst" => "Analista",
            "Author" => "Autor",
            "WorkflowReviewerUodide" => "Revisor UODIDE",
            "WorkflowReviewerAreaTecnica" => "Revisor Área Técnica",
            "WorkflowProcessorAreaTecnica" => "Procesador Área Técnica",
            _ => roleName
        };

    private static string GetRoleDescription(string roleName)
        => roleName switch
        {
            "Admin" => "Administra usuarios, accesos, seguridad y la operación general del sistema.",
            "Analyst" => "Gestiona configuración, catálogos, formularios y módulos operativos de apoyo.",
            "Author" => "Registra artículos y da seguimiento a sus observaciones y validaciones.",
            "WorkflowReviewerUodide" => "Realiza la validación inicial institucional y puede corregir la información registrada.",
            "WorkflowReviewerAreaTecnica" => "Ejecuta la validación técnica final antes del procesamiento definitivo.",
            "WorkflowProcessorAreaTecnica" => "Procesa el envío aprobado hacia la base principal del sistema.",
            _ => "Perfil disponible para asignación dentro del sistema."
        };

    private static IReadOnlyList<RoleCapability> GetRoleCapabilities(string roleName)
        => roleName switch
        {
            "Admin" =>
            [
                Capability("security"), Capability("register"), Capability("directSave"),
                Capability("matrix"), Capability("bulk"), Capability("externalApis"),
                Capability("reporting"), Capability("configuration"), Capability("workflow"),
                Capability("process")
            ],
            "Analyst" =>
            [
                Capability("register"), Capability("directSave"), Capability("matrix"),
                Capability("bulk"), Capability("externalApis"), Capability("reporting"),
                Capability("configuration")
            ],
            "Author" =>
            [
                Capability("register"), Capability("matrix"), Capability("externalApis"),
                Capability("workflowTracking")
            ],
            "WorkflowReviewerUodide" =>
            [
                Capability("workflow"), Capability("bulk")
            ],
            "WorkflowReviewerAreaTecnica" =>
            [
                Capability("workflow"), Capability("bulk"), Capability("reporting")
            ],
            "WorkflowProcessorAreaTecnica" =>
            [
                Capability("workflow"), Capability("process"), Capability("bulk"), Capability("reporting")
            ],
            _ => EmptyCapabilities
        };

    private static RoleCapability Capability(string key)
        => key switch
        {
            "security" => new(key, "Usuarios y roles", "bi bi-shield-lock", 10),
            "register" => new(key, "Registro", "bi bi-pencil-square", 20),
            "directSave" => new(key, "Guardado directo", "bi bi-database-check", 30),
            "matrix" => new(key, "Matriz", "bi bi-grid-3x3-gap", 40),
            "bulk" => new(key, "Carga masiva", "bi bi-upload", 50),
            "externalApis" => new(key, "APIs externas", "bi bi-cloud-arrow-down", 60),
            "reporting" => new(key, "Reportería / IA", "bi bi-bar-chart", 70),
            "configuration" => new(key, "Configuración", "bi bi-gear", 80),
            "workflow" => new(key, "Revisión workflow", "bi bi-diagram-3", 90),
            "workflowTracking" => new(key, "Seguimiento workflow", "bi bi-eye", 100),
            "process" => new(key, "Procesamiento", "bi bi-check2-circle", 110),
            _ => new(key, key, "bi bi-dot", 999)
        };

    private static string GetCapabilityClass(string key)
        => key switch
        {
            "security" => "security-capability security-capability--danger",
            "directSave" or "process" => "security-capability security-capability--strong",
            "reporting" or "externalApis" => "security-capability security-capability--analysis",
            "bulk" or "matrix" => "security-capability security-capability--capture",
            "workflow" or "workflowTracking" => "security-capability security-capability--workflow",
            _ => "security-capability"
        };

    private string GetSecurityTabClass(string tab)
        => string.Equals(ActiveSecurityTab, tab, StringComparison.OrdinalIgnoreCase)
            ? "security-workspace-tab security-workspace-tab--active"
            : "security-workspace-tab";

    private static string GetRoleIcon(string roleName)
        => roleName switch
        {
            "Admin" => "A",
            "Analyst" => "D",
            "Author" => "AU",
            "WorkflowReviewerUodide" => "U",
            "WorkflowReviewerAreaTecnica" => "T",
            "WorkflowProcessorAreaTecnica" => "P",
            _ => "#"
        };

    private static string GetUserDisplayName(IdentityUserListItemDto user)
        => string.IsNullOrWhiteSpace(user.FullName) ? user.Email : user.FullName;

    private static string GetInitials(IdentityUserListItemDto user)
    {
        var source = GetUserDisplayName(user);
        if (string.IsNullOrWhiteSpace(source))
        {
            return "U";
        }

        var parts = source
            .Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Take(2)
            .Select(x => char.ToUpperInvariant(x[0]))
            .ToArray();

        return parts.Length == 0 ? "U" : new string(parts);
    }

