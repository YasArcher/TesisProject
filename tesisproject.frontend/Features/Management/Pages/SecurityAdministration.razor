    private void SyncSelectedUserRoles()
    {
        SelectedUserRoles.Clear();
        if (SelectedUser is null)
        {
            return;
        }

        foreach (var role in SelectedUser.Roles)
        {
            SelectedUserRoles.Add(NormalizeAssignableRole(role));
        }
    }

    private void ToggleCreateUserRole(string roleName, bool? isChecked)
    {
        if (isChecked == true)
        {
            CreateUserRoles.Add(roleName);
        }
        else
        {
            CreateUserRoles.Remove(roleName);
        }
    }

    private void ToggleSelectedUserRole(string roleName, bool? isChecked)
    {
        if (isChecked == true)
        {
            SelectedUserRoles.Add(roleName);
        }
        else
        {
            SelectedUserRoles.Remove(roleName);
        }
    }

    private async Task SaveSelectedUserRolesAsync()
    {
        if (SelectedUser is null)
        {
            return;
        }

        ErrorMessage = null;
        SuccessMessage = null;
        IsBusy = true;
        try
        {
            var updated = await IdentityAdministrationClient.UpdateUserRolesAsync(
                SelectedUser.UserId,
                new UpdateIdentityUserRolesRequest(SelectedUserRoles.ToArray()));

            SelectedUser = updated;
            SuccessMessage = $"Los permisos de {updated.Email} fueron actualizados correctamente.";
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsBusy = false;
        }
    }

