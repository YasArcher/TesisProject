@page "/management/security-administration"
@attribute [Authorize(Roles = "Admin,SecurityAdministrator,RoleManager")]
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using tesisproject.frontend.Services.Interfaces
@using tesisproject.frontend.Services.Platform.Auth
@using tesisproject.shared.DTOs.Auth
@using tesisproject.shared.DTOs.Workflow
@inject IIdentityAdministrationClient IdentityAdministrationClient
@inject IRegistrationWorkflowSettingsClient RegistrationWorkflowSettingsClient

<PageTitle>Usuarios y roles</PageTitle>

<div class="module-shell app-page-shell app-shell-warm py-4 security-admin-page">
    <section class="module-hero module-hero--blue security-hero mb-4">
        <div class="security-hero__layout">
            <div class="security-hero__content">
                <span class="security-hero__icon">⌘</span>
                <div>
                    <div class="module-kicker security-hero__kicker">Administración institucional</div>
                    <h1 class="security-hero__title">Usuarios y roles</h1>
                    <p class="security-hero__copy">Administra cuentas internas, responsabilidades operativas y permisos del personal que gestiona el sistema.</p>
                </div>
            </div>
            <div class="security-hero__side">
                <div class="security-hero__badges" aria-label="Resumen del módulo">
                    <span>@Users.Count cuenta(s) interna(s)</span>
                    <span>@Roles.Count rol(es)</span>
                    <span>@Users.Count(x => !x.IsLockedOut) activo(s)</span>
                </div>
                <div class="security-hero__actions">
                <button class="security-hero-button security-hero-button--ghost" @onclick="OpenCreateRoleModal">
                    Nuevo perfil
                </button>
                <button class="security-hero-button security-hero-button--primary" @onclick="OpenCreateUserModal">
                    Nueva cuenta
                </button>
                <button class="security-hero-button security-hero-button--soft" @onclick="ReloadAsync" disabled="@IsBusy">
                    @(IsBusy ? "Actualizando..." : "Actualizar panel")
                </button>
                </div>
            </div>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="alert alert-danger shadow-sm">@ErrorMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(SuccessMessage))
    {
        <div class="alert alert-success shadow-sm">@SuccessMessage</div>
    }

    <section class="security-command-center mb-4">
        <div class="security-command-center__stats">
            <article class="security-mini-stat">
                <span class="security-mini-stat__icon">◉</span>
                <span>
                    <strong>@Users.Count</strong>
                    <small>cuentas internas</small>
                </span>
            </article>
            <article class="security-mini-stat">
                <span class="security-mini-stat__icon">⌘</span>
                <span>
                    <strong>@Roles.Count</strong>
                    <small>roles</small>
                </span>
            </article>
            <article class="security-mini-stat security-mini-stat--warm">
                <span class="security-mini-stat__icon">✓</span>
                <span>
                    <strong>@Users.Count(x => !x.IsLockedOut)</strong>
                    <small>activos</small>
                </span>
            </article>
        </div>
        <div class="security-flow-panel">
            <div class="security-flow-panel__copy">
                <span class="security-flow-panel__kicker">Flujo institucional</span>
                <strong>@RegistrationWorkflowSettings.EntryModeLabel</strong>
                <small>@RegistrationWorkflowDescription</small>
            </div>
            <div class="security-flow-panel__controls">
                <select class="security-flow-select" @bind="SelectedRegistrationEntryMode" aria-label="Modo de registro">
                    @foreach (var option in RegistrationWorkflowSettings.EntryModeOptions)
                    {
                        <option value="@option.Value">@option.Label</option>
                    }
                </select>
                <button type="button" class="security-pill-action security-pill-action--primary" @onclick="SaveRegistrationWorkflowSettingsAsync" disabled="@IsBusy">
                    Guardar flujo
                </button>
            </div>
        </div>
        <div class="security-command-center__actions">
            <button type="button" class="security-pill-action security-pill-action--primary" @onclick="OpenCreateUserModal">+ Cuenta</button>
            <button type="button" class="security-pill-action" @onclick="OpenCreateRoleModal"># Perfil</button>
        </div>
    </section>

    <section class="security-workspace">
        <div class="security-workspace__tabs" role="tablist" aria-label="Administración de accesos">
            <button type="button" class="@GetSecurityTabClass("users")" @onclick='() => SetSecurityTab("users")'>
                <span>Cuentas</span>
                <small>@FilteredUsers.Count()</small>
            </button>
            <button type="button" class="@GetSecurityTabClass("roles")" @onclick='() => SetSecurityTab("roles")'>
                <span>Roles</span>
                <small>@Roles.Count</small>
            </button>
            <button type="button" class="@GetSecurityTabClass("permissions")" @onclick='() => SetSecurityTab("permissions")'>
                <span>Permisos</span>
                <small>@(SelectedUser is null ? "Elegir cuenta" : "Editando")</small>
            </button>
        </div>

        @if (ActiveSecurityTab == "users")
        {
            <div class="security-panel">
                <div class="security-panel__header">
                    <div>
                        <div class="security-admin-card__eyebrow">Directorio operativo</div>
                        <h2 class="h5 mb-1">Cuentas internas registradas</h2>
                        <p class="text-muted mb-0">Busca personal operativo de la dirección y selecciona una cuenta para ajustar sus permisos.</p>
                    </div>
                    <div class="security-filter-bar">
                        <input class="security-filter-input" placeholder="Buscar por nombre o correo" @bind="UserSearchTerm" @bind:event="oninput" />
                        <select class="security-filter-select" @bind="RoleFilter">
                            <option value="">Todos los roles</option>
                            @foreach (var role in Roles)
                            {
                                <option value="@role.Name">@GetRoleDisplayName(role.Name)</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="security-context-note">
                    <strong>Alcance del panel:</strong>
                    este listado no representa el padrón completo de autores de la universidad. Los autores institucionales pueden validarse desde el directorio o API universitaria y recibir el rol Autor al acceder.
                </div>

                <div class="security-user-grid">
                    @if (!FilteredUsers.Any())
                    {
                        <div class="security-empty-state">No encontramos cuentas internas con los filtros actuales.</div>
                    }
                    else
                    {
                        @foreach (var user in FilteredUsers)
                        {
                            <button type="button"
                                    class="security-user-card @(SelectedUser?.UserId == user.UserId ? "security-user-card--selected" : null)"
                                    @onclick="() => SelectUserAndOpenPermissions(user)">
                                <div class="security-user-card__header">
                                    <div class="security-user-avatar">@GetInitials(user)</div>
                                    <div class="security-user-card__identity">
                                        <div class="security-user-card__name">@GetUserDisplayName(user)</div>
                                        <div class="security-user-card__email">@user.Email</div>
                                    </div>
                                    <span class="security-status-pill @(user.IsLockedOut ? "security-status-pill--danger" : null)">
                                        @(user.IsLockedOut ? "Bloqueado" : "Activo")
                                    </span>
                                </div>
                                <div class="security-user-card__roles">
                                    @foreach (var role in user.Roles.Take(3))
                                    {
                                        <span class="security-role-chip">@GetRoleDisplayName(role)</span>
                                    }
                                    @if (user.Roles.Count() > 3)
                                    {
                                        <span class="security-role-chip security-role-chip--muted">+@(user.Roles.Count() - 3)</span>
                                    }
                                </div>
                            </button>
                        }
                    }
                </div>
            </div>
        }
        else if (ActiveSecurityTab == "roles")
        {
            <div class="security-panel">
                <div class="security-panel__header">
                    <div>
                        <div class="security-admin-card__eyebrow">Mapa de responsabilidades</div>
                        <h2 class="h5 mb-1">Roles y permisos operativos</h2>
                        <p class="text-muted mb-0">Vista resumida de responsabilidades internas y permisos funcionales asignables.</p>
                    </div>
                    <button class="security-pill-action" @onclick="ToggleAdvancedRoleEditor">
                        @(ShowAdvancedRoleEditor ? "Ocultar códigos" : "Ver códigos internos")
                    </button>
                </div>

                <div class="security-group-tabs" role="tablist" aria-label="Grupos de roles">
                    @foreach (var groupName in AvailableRoleGroups)
                    {
                        <button type="button"
                                class="@GetRoleGroupTabClass(ActiveRoleGroup, groupName)"
                                @onclick="() => ActiveRoleGroup = groupName">
                            <span>@GetRoleGroupTitle(groupName)</span>
                            <small>@GetRolesForGroup(groupName).Count()</small>
                        </button>
                    }
                </div>

                <div class="security-role-sections">
                    @foreach (var group in GroupRoles(Roles).Where(x => x.Key == ActiveRoleGroup))
                    {
                        <section class="security-role-section">
                            <div class="security-role-section__header">
                                <div>
                                    <span class="security-admin-card__eyebrow">@group.Key</span>
                                    <h3>@GetRoleGroupTitle(group.Key)</h3>
                                </div>
                                <span>@group.Count() rol(es)</span>
                            </div>
                            <div class="security-role-grid">
                                @foreach (var role in group)
                                {
                                    <article class="security-role-card">
                                        <div class="security-role-card__top">
                                            <span class="security-role-card__icon">@GetRoleIcon(role.Name)</span>
                                            <span class="security-role-card__count">@GetRoleCountLabel(role)</span>
                                        </div>
                                        <div class="security-role-card__title">@GetRoleDisplayName(role.Name)</div>
                                        @if (ShowAdvancedRoleEditor)
                                        {
                                            <div class="security-role-card__code">@role.Name</div>
                                        }
                                        <div class="security-role-card__description">@GetRoleDescription(role.Name)</div>
                                        <div class="security-capability-list">
                                            @foreach (var capability in GetRoleCapabilities(role.Name))
                                            {
                                                <span class="@GetCapabilityClass(capability.Key)">
                                                    <i class="@capability.Icon"></i>
                                                    @capability.Label
                                                </span>
                                            }
                                        </div>
                                    </article>
                                }
                            </div>
                        </section>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="security-panel security-panel--permissions">
                <div class="security-panel__header">
                    <div>
                        <div class="security-admin-card__eyebrow">Asignación de permisos</div>
                        <h2 class="h5 mb-1">Responsabilidades de la cuenta interna</h2>
                        <p class="text-muted mb-0">Modifica solo los permisos necesarios para mantener limpio el acceso operativo.</p>
                    </div>
                    @if (SelectedUser is not null)
                    {
                        <button class="security-pill-action security-pill-action--primary" @onclick="SaveSelectedUserRolesAsync" disabled="@IsBusy">
                            @(IsBusy ? "Guardando..." : "Guardar permisos")
                        </button>
                    }
                </div>

                @if (SelectedUser is null)
                {
                    <div class="security-empty-state security-empty-state--large">Selecciona una cuenta interna desde la pestaña Cuentas para administrar sus permisos.</div>
                }
                else
                {
                    <div class="security-permission-layout">
                        <aside class="security-selected-user">
                            <div class="security-user-avatar security-user-avatar--large">@GetInitials(SelectedUser)</div>
                            <div class="security-selected-user__name">@GetUserDisplayName(SelectedUser)</div>
                            <div class="security-selected-user__email">@SelectedUser.Email</div>
                            <div class="security-user-card__roles">
                                @foreach (var role in SelectedUserRoles)
                                {
                                    <span class="security-role-chip">@GetRoleDisplayName(role)</span>
                                }
                            </div>
                            <div class="security-selected-user__capabilities">
                                <small>Acciones habilitadas</small>
                                <div class="security-capability-list security-capability-list--compact">
                                    @foreach (var capability in SelectedUserCapabilities)
                                    {
                                        <span class="@GetCapabilityClass(capability.Key)">
                                            <i class="@capability.Icon"></i>
                                            @capability.Label
                                        </span>
                                    }
                                </div>
                            </div>
                        </aside>

                        <div class="security-permission-sections">
                            <div class="security-group-tabs security-group-tabs--stacked" role="tablist" aria-label="Grupos de permisos">
                                @foreach (var groupName in AvailableRoleGroups)
                                {
                                    <button type="button"
                                            class="@GetRoleGroupTabClass(ActivePermissionGroup, groupName)"
                                            @onclick="() => ActivePermissionGroup = groupName">
                                        <span>@GetRoleGroupTitle(groupName)</span>
                                        <small>@GetRolesForGroup(groupName).Count()</small>
                                    </button>
                                }
                            </div>

                            @foreach (var group in GroupRoles(Roles).Where(x => x.Key == ActivePermissionGroup))
                            {
                                <section class="security-role-section security-role-section--compact">
                                    <div class="security-role-section__header">
                                        <div>
                                            <span class="security-admin-card__eyebrow">@group.Key</span>
                                            <h3>@GetRoleGroupTitle(group.Key)</h3>
                                        </div>
                                    </div>
                                    <div class="security-permission-grid">
                                        @foreach (var role in group)
                                        {
                                            <label class="security-role-option">
                                                <div class="security-role-option__main">
                                                    <span class="security-role-card__icon">@GetRoleIcon(role.Name)</span>
                                                    <span>
                                                        <span class="security-role-option__title">@GetRoleDisplayName(role.Name)</span>
                                                        <span class="security-role-option__description">@GetRoleDescription(role.Name)</span>
                                                        <span class="security-capability-list security-capability-list--inline">
                                                            @foreach (var capability in GetRoleCapabilities(role.Name))
                                                            {
                                                                <span class="@GetCapabilityClass(capability.Key)">
                                                                    <i class="@capability.Icon"></i>
                                                                    @capability.Label
                                                                </span>
                                                            }
                                                        </span>
                                                    </span>
                                                </div>
                                                <input type="checkbox"
                                                       class="form-check-input"
                                                       checked="@SelectedUserRoles.Contains(role.Name)"
                                                       @onchange="args => ToggleSelectedUserRole(role.Name, args.Value as bool?)" />
                                            </label>
                                        }
                                    </div>
                                </section>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </section>

    @if (ShowCreateUserModal)
    {
        <div class="security-admin-modal-backdrop" @onclick="CloseCreateUserModalAsync">
            <div class="security-admin-modal" @onclick:stopPropagation="true">
                <div class="security-admin-modal__header">
                    <div>
                        <div class="security-admin-card__eyebrow">Nuevo acceso</div>
                        <h2 class="h4 mb-1">Registrar cuenta interna</h2>
                        <p class="text-muted mb-0">Completa los datos del personal operativo y selecciona sus responsabilidades iniciales.</p>
                    </div>
                    <button type="button" class="security-admin-modal__close" @onclick="CloseCreateUserModalAsync">×</button>
                </div>

                <EditForm Model="CreateUserModel" OnValidSubmit="CreateUserAsync">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-danger small mb-3" />

                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label class="form-label">Correo institucional</label>
                            <InputText @bind-Value="CreateUserModel.Email" class="form-control" placeholder="usuario@uta.edu.ec" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label">Contraseña temporal</label>
                            <InputText @bind-Value="CreateUserModel.Password" type="password" class="form-control" placeholder="Asignar contraseña inicial" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Nombre completo</label>
                            <InputText @bind-Value="CreateUserModel.FullName" class="form-control" placeholder="Nombre del funcionario interno" />
                        </div>
                    </div>

                    <div class="security-context-note security-context-note--compact mt-3">
                        El rol Autor institucional puede aplicarse a personas validadas por el directorio universitario. No es necesario crear aquí todas las cuentas de autores de la universidad.
                    </div>

                    <div class="mt-4">
                        <label class="form-label d-block">Responsabilidades iniciales</label>
                        <div class="security-modal-role-grid">
                            @foreach (var role in Roles)
                            {
                                <label class="security-role-option">
                                    <div>
                                        <div class="security-role-option__title">@GetRoleDisplayName(role.Name)</div>
                                        <div class="security-role-option__description">@GetRoleDescription(role.Name)</div>
                                        <div class="security-capability-list security-capability-list--inline">
                                            @foreach (var capability in GetRoleCapabilities(role.Name))
                                            {
                                                <span class="@GetCapabilityClass(capability.Key)">
                                                    <i class="@capability.Icon"></i>
                                                    @capability.Label
                                                </span>
                                            }
                                        </div>
                                    </div>
                                    <input type="checkbox"
                                           class="form-check-input"
                                           checked="@CreateUserRoles.Contains(role.Name)"
                                           @onchange="args => ToggleCreateUserRole(role.Name, args.Value as bool?)" />
                                </label>
                            }
                        </div>
                    </div>

                    <div class="security-admin-modal__actions">
                        <button type="button" class="btn btn-outline-secondary" @onclick="CloseCreateUserModalAsync">Cancelar</button>
                        <button type="submit" class="btn btn-primary" disabled="@IsBusy">@(IsBusy ? "Creando..." : "Crear cuenta")</button>
                    </div>
                </EditForm>
            </div>
        </div>
    }

    @if (ShowCreateRoleModal)
    {
        <div class="security-admin-modal-backdrop" @onclick="CloseCreateRoleModalAsync">
            <div class="security-admin-modal security-admin-modal--compact" @onclick:stopPropagation="true">
                <div class="security-admin-modal__header">
                    <div>
                        <div class="security-admin-card__eyebrow">Edición avanzada</div>
                        <h2 class="h4 mb-1">Crear perfil</h2>
                        <p class="text-muted mb-0">Usa esta opción solo cuando necesites un perfil nuevo no cubierto por los perfiles actuales.</p>
                    </div>
                    <button type="button" class="security-admin-modal__close" @onclick="CloseCreateRoleModalAsync">×</button>
                </div>

                <EditForm Model="CreateRoleModel" OnValidSubmit="CreateRoleAsync">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-danger small mb-3" />

                    <div class="mb-3">
                        <label class="form-label">Nombre interno del perfil</label>
                        <InputText @bind-Value="CreateRoleModel.Name" class="form-control" placeholder="Ejemplo: WorkflowAuditorInterno" />
                    </div>

                    <div class="security-admin-note">
                        Este editor está pensado para ampliaciones controladas del sistema. Los perfiles institucionales habituales ya están disponibles en el panel principal.
                    </div>

                    <div class="security-admin-modal__actions">
                        <button type="button" class="btn btn-outline-secondary" @onclick="CloseCreateRoleModalAsync">Cancelar</button>
                        <button type="submit" class="btn btn-primary" disabled="@IsBusy">@(IsBusy ? "Creando..." : "Crear perfil")</button>
                    </div>
                </EditForm>
            </div>
        </div>
    }
</div>

@code {
    private readonly List<IdentityUserListItemDto> Users = [];
    private readonly List<IdentityRoleListItemDto> Roles = [];
    private readonly HashSet<string> CreateUserRoles = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> SelectedUserRoles = new(StringComparer.OrdinalIgnoreCase);
    private static readonly IReadOnlyList<RoleCapability> EmptyCapabilities = [];
    private const string LegacyAreaTecnicaProcessorRole = "WorkflowProcessorAreaTecnica";
    private const string AreaTecnicaReviewerRole = "WorkflowReviewerAreaTecnica";

    private CreateUserFormModel CreateUserModel { get; set; } = new();
    private CreateRoleFormModel CreateRoleModel { get; set; } = new();
    private IdentityUserListItemDto? SelectedUser { get; set; }
    private bool ShowAdvancedRoleEditor { get; set; }
    private bool ShowCreateUserModal { get; set; }
    private bool ShowCreateRoleModal { get; set; }
    private bool IsBusy { get; set; }
    private string? ErrorMessage { get; set; }
    private string? SuccessMessage { get; set; }
    private string ActiveSecurityTab { get; set; } = "users";
    private string ActiveRoleGroup { get; set; } = "Perfiles institucionales";
    private string ActivePermissionGroup { get; set; } = "Perfiles institucionales";
    private string UserSearchTerm { get; set; } = string.Empty;
    private string RoleFilter { get; set; } = string.Empty;
    private RegistrationWorkflowSettingsDto RegistrationWorkflowSettings { get; set; } = BuildDefaultRegistrationWorkflowSettings();
    private string SelectedRegistrationEntryMode { get; set; } = RegistrationEntryModes.AuthorAndUodide;
    private string RegistrationWorkflowDescription
        => RegistrationWorkflowSettings.EntryModeOptions.FirstOrDefault(x => x.Value == SelectedRegistrationEntryMode)?.Description
           ?? RegistrationWorkflowSettings.Description;

    private IEnumerable<IdentityUserListItemDto> FilteredUsers
        => Users.Where(user =>
        {
            var matchesText = string.IsNullOrWhiteSpace(UserSearchTerm)
                || GetUserDisplayName(user).Contains(UserSearchTerm, StringComparison.OrdinalIgnoreCase)
                || (user.Email?.Contains(UserSearchTerm, StringComparison.OrdinalIgnoreCase) ?? false);

            var matchesRole = string.IsNullOrWhiteSpace(RoleFilter)
                || user.Roles.Any(role => string.Equals(role, RoleFilter, StringComparison.OrdinalIgnoreCase));

            return matchesText && matchesRole;
        });

    private IReadOnlyList<string> AvailableRoleGroups
        => GroupRoles(Roles).Select(x => x.Key).ToList();

    private IReadOnlyList<RoleCapability> SelectedUserCapabilities
        => SelectedUserRoles
            .SelectMany(GetRoleCapabilities)
            .GroupBy(x => x.Key, StringComparer.OrdinalIgnoreCase)
            .Select(g => g.First())
            .OrderBy(x => x.SortOrder)
            .ToList();

    private static IEnumerable<IGrouping<string, IdentityRoleListItemDto>> GroupRoles(IEnumerable<IdentityRoleListItemDto> roles)
        => roles
            .GroupBy(role => GetRoleGroup(role.Name))
            .OrderBy(group => GetRoleGroupOrder(group.Key))
            .ThenBy(group => group.Key);

    private IEnumerable<IdentityRoleListItemDto> GetRolesForGroup(string group)
        => Roles.Where(role => string.Equals(GetRoleGroup(role.Name), group, StringComparison.OrdinalIgnoreCase));

    private static string GetRoleGroupTabClass(string activeGroup, string group)
        => string.Equals(activeGroup, group, StringComparison.OrdinalIgnoreCase)
            ? "security-group-tab security-group-tab--active"
            : "security-group-tab";

    private static string GetRoleGroupTitle(string group)
        => group switch
        {
            "Perfiles institucionales" => "Responsabilidad institucional",
            "Registro" => "Captura y registro",
            "Workflow" => "Revisión y seguimiento",
            "Reportería e IA" => "Análisis, reportes e inteligencia",
            "Configuración" => "Configuración operativa",
            "Seguridad" => "Administración de accesos",
            _ => "Otros permisos"
        };

    private static int GetRoleGroupOrder(string group)
        => group switch
        {
            "Perfiles institucionales" => 10,
            "Registro" => 20,
            "Workflow" => 30,
            "Reportería e IA" => 40,
            "Configuración" => 50,
            "Seguridad" => 60,
            _ => 999
        };

    private static string GetRoleGroup(string roleName)
        => roleName switch
        {
            "Admin" or "Analyst" or "Author" or "WorkflowReviewerUodide" or "WorkflowReviewerAreaTecnica" or "WorkflowProcessorAreaTecnica" => "Perfiles institucionales",
            "ArticleRegistrationUser" or "RegistrationMatrixUser" or "DirectArticleSaveUser" or "BulkImportUser" or "ExternalApiUser" => "Registro",
            "WorkflowTrackingUser" => "Workflow",
            "ReportingViewer" or "ReportingExporter" or "ReportingAdvancedUser" or "IntelligenceViewer" or "IntelligenceTrainer" => "Reportería e IA",
            "ConfigurationManager" or "CatalogManager" => "Configuración",
            "SecurityAdministrator" or "RoleManager" => "Seguridad",
            _ => "Otros"
        };

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        SuccessMessage = null;
        ErrorMessage = null;
        IsBusy = true;
        try
        {
            var roles = await IdentityAdministrationClient.GetRolesAsync();
            var users = await IdentityAdministrationClient.GetUsersAsync();
            RegistrationWorkflowSettings = await RegistrationWorkflowSettingsClient.GetAsync()
                ?? BuildDefaultRegistrationWorkflowSettings();
            SelectedRegistrationEntryMode = RegistrationWorkflowSettings.EntryMode;

            Roles.Clear();
            Roles.AddRange(roles
                .Where(x => !IsLegacyAreaTecnicaProcessorRole(x.Name))
                .OrderBy(x => GetRoleDisplayName(x.Name)));

            EnsureActiveRoleGroups();

            Users.Clear();
            Users.AddRange(users.OrderBy(x => x.FullName).ThenBy(x => x.Email));

            if (SelectedUser is not null)
            {
                SelectedUser = Users.FirstOrDefault(x => x.UserId == SelectedUser.UserId);
                SyncSelectedUserRoles();
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"No pude cargar la administración de accesos: {ex.Message}";
        }
        finally
        {
            IsBusy = false;
        }
    }

    private void EnsureActiveRoleGroups()
    {
        var groups = AvailableRoleGroups;
        if (groups.Count == 0)
        {
            ActiveRoleGroup = "Perfiles institucionales";
            ActivePermissionGroup = "Perfiles institucionales";
            return;
        }

        if (!groups.Contains(ActiveRoleGroup, StringComparer.OrdinalIgnoreCase))
        {
            ActiveRoleGroup = groups[0];
        }

        if (!groups.Contains(ActivePermissionGroup, StringComparer.OrdinalIgnoreCase))
        {
            ActivePermissionGroup = groups[0];
        }
    }

