@page "/management/exportinformation"
@attribute [Authorize]

<h3>Seccion para exportacion de datos</h3>
<button @onclick="TestSpecific">Probar Specific 3</button>

@code {
    [Inject] ICatalogsService CatalogService { get; set; } = default!;

    private async Task TestSpecific()
    {
        var list = await CatalogService.GetSpecificFieldsAsync(3);
        Console.WriteLine($"SpecificFields(3) = {list.Count}");
    }
}

