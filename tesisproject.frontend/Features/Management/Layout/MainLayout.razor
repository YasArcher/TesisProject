@namespace tesisproject.frontend.Features.Management.Layout
@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using System.Globalization
@using System.Threading
@using tesisproject.frontend.SharedUI
@using tesisproject.frontend.Services.Interfaces
@using tesisproject.frontend.Services.Auth
@inject AuthenticationStateProvider AuthStateProvider
@inject ITokenStore TokenStore
@inject IAuthClient AuthClient
@inject NavigationManager NavManager

<div class="app-shell @(mobileMenuOpen ? "menu-open" : null) @(sidebarCollapsed ? "sidebar-collapsed" : null)">
    <aside class="layout-aside menu-bg text-white @(mobileMenuOpen ? "mobile-open" : null) @(sidebarCollapsed ? "collapsed" : null)" @onclick:stopPropagation="true">
        <SideBar @ref="sidebarComponent" CollapseChanged="HandleSidebarCollapseChanged" />
    </aside>

    @if (mobileMenuOpen)
    {
        <button type="button" class="mobile-backdrop" @onclick="CloseMobileMenu" aria-label="Cerrar menú lateral"></button>
    }

    <div class="layout-main" @onclick="CloseMobileMenu">
        <header class="brand-header text-white shadow-sm">
            <div class="brand-header-inner d-flex align-items-center justify-content-between gap-3 px-3 px-lg-4 py-3">
                <button class="btn btn-sm btn-outline-light d-lg-none mobile-menu-btn"
                        @onclick:stopPropagation="true"
                        @onclick="ToggleMobileMenu"
                        aria-label="Abrir menú lateral">
                    <span>☰</span>
                </button>

                <div class="fw-semibold brand-title">SISTEMA INTEGRADO</div>

                <div class="brand-user-tools">
                    @if (IsAuthenticated)
                    {
                        <div class="brand-clock-chip">
                            <div class="brand-clock-chip__time">@HeaderCurrentTime</div>
                            <div class="brand-clock-chip__date">@HeaderCurrentDate</div>
                        </div>

                        <div class="brand-user-chip">
                            <div class="brand-user-chip__avatar">@UserInitials</div>
                            <div class="brand-user-chip__body">
                                <div class="brand-user-chip__label">Sesión activa</div>
                                <div class="brand-user-chip__name">@DisplayName</div>
                                @if (!string.IsNullOrWhiteSpace(PrimaryRole))
                                {
                                    <div class="brand-user-chip__role">@PrimaryRole</div>
                                }
                            </div>
                        </div>

                        <button type="button"
                                class="btn btn-sm btn-outline-light brand-logout-btn"
                                @onclick:stopPropagation="true"
                                @onclick="LogoutAsync">
                            Cerrar sesión
                        </button>
                    }
                    else
                    {
                        <div class="d-lg-none" style="width: 40px;"></div>
                    }
                </div>
            </div>
        </header>

        <main class="flex-grow-1 app-main-content">
            @Body
        </main>

        <footer class="app-footer text-center py-2">
            <small>© @DateTime.Now.Year - Sistema Integrado</small>
        </footer>
    </div>
</div>

@if (ShouldShowAuthorTermsGate)
{
    <div class="layout-terms-backdrop">
        <section class="layout-terms-card" role="dialog" aria-modal="true" aria-labelledby="layout-terms-title">
            <div class="layout-terms-card__badge">Acuerdo institucional</div>
            <h2 id="layout-terms-title" class="layout-terms-card__title">Términos para el uso de información académica</h2>
            <p class="layout-terms-card__lead">
                Para continuar, confirma que aceptas el tratamiento de la información registrada en el sistema. Esta aceptación se guardará con fecha y versión para mantener trazabilidad institucional.
            </p>

            <div class="layout-terms-grid">
                <article>
                    <span>01</span>
                    <strong>Información verificada</strong>
                    <p>Registrarás datos académicos reales, verificables y relacionados con tu producción científica.</p>
                </article>
                <article>
                    <span>02</span>
                    <strong>Uso institucional</strong>
                    <p>La información podrá utilizarse para revisión, validación, reportería e indicadores institucionales.</p>
                </article>
                <article>
                    <span>03</span>
                    <strong>Acceso por roles</strong>
                    <p>Los datos serán tratados por personal autorizado según el flujo de revisión definido.</p>
                </article>
            </div>

            <label class="layout-terms-check">
                <input type="checkbox" @bind="HasConfirmedTermsRead" />
                <span>He leído y acepto los términos y condiciones para el manejo de información académica.</span>
            </label>

            @if (!string.IsNullOrWhiteSpace(TermsErrorMessage))
            {
                <div class="layout-terms-error">@TermsErrorMessage</div>
            }

            <div class="layout-terms-actions">
                <button type="button" class="layout-terms-actions__secondary" @onclick="LogoutAsync">Salir</button>
                <button type="button"
                        class="layout-terms-actions__primary"
                        disabled="@(!HasConfirmedTermsRead || IsAcceptingTerms)"
                        @onclick="AcceptTermsAsync">
                    @(IsAcceptingTerms ? "Registrando aceptación..." : "Aceptar y continuar")
                </button>
            </div>

            <div class="layout-terms-footer">Versión de términos: @TermsVersion</div>
        </section>
    </div>
}

@code {
    private bool mobileMenuOpen;
    private bool sidebarCollapsed;
    private SideBar? sidebarComponent;
    private bool IsAuthenticated;
    private string DisplayName { get; set; } = "Usuario";
    private string UserInitials { get; set; } = "U";
    private string? PrimaryRole { get; set; }
    private string HeaderCurrentTime { get; set; } = "00:00:00";
    private string HeaderCurrentDate { get; set; } = "01 abril 2026";
    private AuthMeResponse? CurrentUser { get; set; }
    private bool HasConfirmedTermsRead { get; set; }
    private bool IsAcceptingTerms { get; set; }
    private string TermsErrorMessage { get; set; } = string.Empty;
    private const string TermsVersion = "2026-04";
    private Timer? _clockTimer;

    protected override async Task OnInitializedAsync()
    {
        await LoadUserStateAsync();
        StartClock();
        AuthStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
    }

    private void ToggleMobileMenu()
    {
        mobileMenuOpen = !mobileMenuOpen;
    }

    private void CloseMobileMenu()
    {
        if (mobileMenuOpen)
        {
            mobileMenuOpen = false;
        }
    }

    private void HandleSidebarCollapseChanged(bool collapsed)
    {
        sidebarCollapsed = collapsed;
    }

    private async void OnAuthenticationStateChanged(Task<AuthenticationState> task)
    {
        await LoadUserStateAsync(task);
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadUserStateAsync(Task<AuthenticationState>? authStateTask = null)
    {
        var state = authStateTask is null
            ? await AuthStateProvider.GetAuthenticationStateAsync()
            : await authStateTask;

        var user = state.User;
        IsAuthenticated = user.Identity?.IsAuthenticated == true;

        if (!IsAuthenticated)
        {
            DisplayName = "Usuario";
            UserInitials = "U";
            PrimaryRole = null;
            CurrentUser = null;
            HasConfirmedTermsRead = false;
            TermsErrorMessage = string.Empty;
            return;
        }

        CurrentUser = await TryLoadCurrentUserAsync();

        DisplayName = CurrentUser?.FullName
            ?? user.FindFirst("fullName")?.Value
            ?? user.FindFirst(ClaimTypes.Name)?.Value
            ?? user.FindFirst(ClaimTypes.Email)?.Value
            ?? "Usuario";
        UserInitials = GetInitials(DisplayName);

        var roles = CurrentUser?.Roles?.Length > 0
            ? CurrentUser.Roles
            : user.Claims
                .Where(x => x.Type == ClaimTypes.Role)
                .Select(x => x.Value)
                .ToArray();

        PrimaryRole = roles
            .Select(GetRoleDisplayName)
            .FirstOrDefault();
    }

    private async Task<AuthMeResponse?> TryLoadCurrentUserAsync()
    {
        try
        {
            return await AuthClient.GetCurrentAsync();
        }
        catch
        {
            return null;
        }
    }

    private bool ShouldShowAuthorTermsGate
        => IsAuthenticated
           && CurrentUser?.HasAcceptedTerms != true
           && CurrentUser?.Roles?.Any(x => string.Equals(x, "Author", StringComparison.OrdinalIgnoreCase)) == true
           && CurrentUser?.Roles?.Any(x =>
               string.Equals(x, "Admin", StringComparison.OrdinalIgnoreCase) ||
               string.Equals(x, "Analyst", StringComparison.OrdinalIgnoreCase)) != true;

    private async Task AcceptTermsAsync()
    {
        if (!HasConfirmedTermsRead)
        {
            TermsErrorMessage = "Debes confirmar la lectura de los términos para continuar.";
            return;
        }

        try
        {
            IsAcceptingTerms = true;
            TermsErrorMessage = string.Empty;
            CurrentUser = await AuthClient.AcceptTermsAsync(new AcceptTermsRequest { TermsVersion = TermsVersion });

            if (CurrentUser?.HasAcceptedTerms != true)
            {
                TermsErrorMessage = "No pude registrar la aceptación. Inténtalo nuevamente.";
                return;
            }

            HasConfirmedTermsRead = false;
        }
        catch (Exception ex)
        {
            TermsErrorMessage = $"No pude registrar la aceptación: {ex.Message}";
        }
        finally
        {
            IsAcceptingTerms = false;
        }
    }

    private async Task LogoutAsync()
    {
        await TokenStore.ClearAsync();
        if (AuthStateProvider is JwtAuthStateProvider jwt)
        {
            jwt.NotifyUserChanged();
        }

        mobileMenuOpen = false;
        NavManager.NavigateTo("/login", forceLoad: false);
    }

    private void StartClock()
    {
        UpdateClock();
        _clockTimer?.Dispose();
        _clockTimer = new Timer(_ =>
        {
            InvokeAsync(() =>
            {
                UpdateClock();
                StateHasChanged();
            });
        }, null, 1000, 1000);
    }

    private void UpdateClock()
    {
        var now = DateTime.Now;
        HeaderCurrentTime = now.ToString("HH:mm:ss");
        HeaderCurrentDate = now.ToString("dd MMM yyyy", new CultureInfo("es-ES"));
    }

    private static string GetInitials(string displayName)
    {
        if (string.IsNullOrWhiteSpace(displayName))
        {
            return "U";
        }

        var parts = displayName
            .Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

        return parts.Length switch
        {
            >= 2 => $"{char.ToUpperInvariant(parts[0][0])}{char.ToUpperInvariant(parts[1][0])}",
            1 => char.ToUpperInvariant(parts[0][0]).ToString(),
            _ => "U"
        };
    }

    private static string GetRoleDisplayName(string role)
        => role switch
        {
            "Admin" => "Administrador",
            "Analyst" => "Analista",
            "Author" => "Autor",
            "WorkflowReviewerUodide" => "Revisor UODIDE",
            "WorkflowReviewerAreaTecnica" => "Revisor Área Técnica",
            "WorkflowProcessorAreaTecnica" => "Revisor Área Técnica",
            "ExternalApiUser" => "APIs externas",
            "ArticleRegistrationUser" => "Registro de artículos",
            "RegistrationMatrixUser" => "Matriz de registro",
            "DirectArticleSaveUser" => "Guardado directo",
            "BulkImportUser" => "Carga masiva",
            "ReportingViewer" => "Reportería",
            "ReportingExporter" => "Exportación de reportes",
            "ReportingAdvancedUser" => "Reportería avanzada",
            "IntelligenceViewer" => "Inteligencia IA",
            "IntelligenceTrainer" => "Entrenamiento IA",
            "ConfigurationManager" => "Configuración",
            "CatalogManager" => "Catálogos",
            "WorkflowTrackingUser" => "Seguimiento workflow",
            "SecurityAdministrator" => "Seguridad",
            "RoleManager" => "Gestión de roles",
            _ => role
        };

    public void Dispose()
    {
        _clockTimer?.Dispose();
        AuthStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
    }
}
