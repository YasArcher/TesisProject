@namespace tesisproject.frontend.Features.Management.Layout
@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@using tesisproject.frontend.SharedUI
@implements IDisposable

<AuthorizeView>
    <Authorized>
        <div class="app-shell">
            <!-- Sidebar fijo -->
            <aside class="layout-aside menu-bg text-white @sidebarClass" @ref="sidebarElement">
                <SideBar @ref="sidebarComponent" />
            </aside>

            <!-- Contenido principal -->
            <div class="layout-main @mainContentClass" @onclick="CloseMobileMenu">
                <header class="brand-header text-white shadow-sm">
                    <div class="d-flex align-items-center justify-content-between px-4 py-3">
                        <button class="btn btn-sm btn-outline-light d-lg-none mobile-menu-btn"
                                @onclick="ToggleMobileMenu">
                            <span>☰</span>
                        </button>

                        <div class="fw-semibold">SISTEMA INTEGRADO</div>

                        <div class="d-lg-none" style="width: 40px;"></div>
                    </div>
                </header>

                <main class="flex-grow-1 p-4">
                    @Body
                </main>

                <footer class="app-footer text-center py-2">
                    <small>© @DateTime.Now.Year — Sistema Integrado</small>
                </footer>
            </div>
        </div>
    </Authorized>

    <Authorizing>
        <div class="d-flex justify-content-center align-items-center" style="min-height: 60vh;">
            <div class="text-muted">Cargando…</div>
        </div>
    </Authorizing>

    <NotAuthorized>
        @Body
    </NotAuthorized>
</AuthorizeView>

@code {
    private bool mobileMenuOpen = false;
    private string sidebarClass = "sidebar-expanded";
    private string mainContentClass = "sidebar-expanded";
    private ElementReference sidebarElement;
    private SideBar? sidebarComponent;
    private Timer? sidebarCheckTimer;

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        // ❗ Se removió toda referencia a JS porque no existía la función JS
        return Task.CompletedTask;
    }

    private void ToggleMobileMenu()
    {
        mobileMenuOpen = !mobileMenuOpen;
        UpdateSidebarClasses();
    }

    private void CloseMobileMenu()
    {
        if (mobileMenuOpen)
        {
            mobileMenuOpen = false;
            UpdateSidebarClasses();
        }
    }

    private void UpdateSidebarClasses()
    {
        if (mobileMenuOpen)
        {
            sidebarClass = "mobile-open sidebar-expanded";
            mainContentClass = "sidebar-expanded";
        }
        else
        {
            sidebarClass = "sidebar-expanded";
            mainContentClass = "sidebar-expanded";
        }
    }

    public void Dispose()
    {
        sidebarCheckTimer?.Dispose();
    }
}
