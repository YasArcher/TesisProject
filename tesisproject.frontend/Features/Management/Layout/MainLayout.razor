@namespace tesisproject.frontend.Features.Management.Layout
@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using tesisproject.frontend.SharedUI
@using tesisproject.frontend.Services.Interfaces
@using tesisproject.frontend.Services.Auth
@inject AuthenticationStateProvider AuthStateProvider
@inject ITokenStore TokenStore
@inject NavigationManager NavManager

<div class="app-shell @(mobileMenuOpen ? "menu-open" : null) @(sidebarCollapsed ? "sidebar-collapsed" : null)">
    <aside class="layout-aside menu-bg text-white @(mobileMenuOpen ? "mobile-open" : null) @(sidebarCollapsed ? "collapsed" : null)" @onclick:stopPropagation="true">
        <SideBar @ref="sidebarComponent" CollapseChanged="HandleSidebarCollapseChanged" />
    </aside>

    @if (mobileMenuOpen)
    {
        <button type="button" class="mobile-backdrop" @onclick="CloseMobileMenu" aria-label="Cerrar menú lateral"></button>
    }

    <div class="layout-main" @onclick="CloseMobileMenu">
        <header class="brand-header text-white shadow-sm">
            <div class="brand-header-inner d-flex align-items-center justify-content-between gap-3 px-3 px-lg-4 py-3">
                <button class="btn btn-sm btn-outline-light d-lg-none mobile-menu-btn"
                        @onclick:stopPropagation="true"
                        @onclick="ToggleMobileMenu"
                        aria-label="Abrir menú lateral">
                    <span>☰</span>
                </button>

                <div class="fw-semibold brand-title">SISTEMA INTEGRADO</div>

                <div class="brand-user-tools">
                    @if (IsAuthenticated)
                    {
                        <div class="brand-user-chip">
                            <div class="brand-user-chip__name">@DisplayName</div>
                            @if (!string.IsNullOrWhiteSpace(PrimaryRole))
                            {
                                <div class="brand-user-chip__role">@PrimaryRole</div>
                            }
                        </div>

                        <button type="button"
                                class="btn btn-sm btn-outline-light brand-logout-btn"
                                @onclick:stopPropagation="true"
                                @onclick="LogoutAsync">
                            Cerrar sesión
                        </button>
                    }
                    else
                    {
                        <div class="d-lg-none" style="width: 40px;"></div>
                    }
                </div>
            </div>
        </header>

        <main class="flex-grow-1 app-main-content">
            @Body
        </main>

        <footer class="app-footer text-center py-2">
            <small>© @DateTime.Now.Year - Sistema Integrado</small>
        </footer>
    </div>
</div>

@code {
    private bool mobileMenuOpen;
    private bool sidebarCollapsed;
    private SideBar? sidebarComponent;
    private bool IsAuthenticated;
    private string DisplayName { get; set; } = "Usuario";
    private string? PrimaryRole { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadUserStateAsync();
        AuthStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
    }

    private void ToggleMobileMenu()
    {
        mobileMenuOpen = !mobileMenuOpen;
    }

    private void CloseMobileMenu()
    {
        if (mobileMenuOpen)
        {
            mobileMenuOpen = false;
        }
    }

    private void HandleSidebarCollapseChanged(bool collapsed)
    {
        sidebarCollapsed = collapsed;
    }

    private async void OnAuthenticationStateChanged(Task<AuthenticationState> task)
    {
        await LoadUserStateAsync(task);
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadUserStateAsync(Task<AuthenticationState>? authStateTask = null)
    {
        var state = authStateTask is null
            ? await AuthStateProvider.GetAuthenticationStateAsync()
            : await authStateTask;

        var user = state.User;
        IsAuthenticated = user.Identity?.IsAuthenticated == true;

        if (!IsAuthenticated)
        {
            DisplayName = "Usuario";
            PrimaryRole = null;
            return;
        }

        DisplayName = user.FindFirst("fullName")?.Value
            ?? user.FindFirst(ClaimTypes.Name)?.Value
            ?? user.FindFirst(ClaimTypes.Email)?.Value
            ?? "Usuario";

        PrimaryRole = user.Claims
            .Where(x => x.Type == ClaimTypes.Role)
            .Select(x => GetRoleDisplayName(x.Value))
            .FirstOrDefault();
    }

    private async Task LogoutAsync()
    {
        await TokenStore.ClearAsync();
        if (AuthStateProvider is JwtAuthStateProvider jwt)
        {
            jwt.NotifyUserChanged();
        }

        mobileMenuOpen = false;
        NavManager.NavigateTo("/login", forceLoad: false);
    }

    private static string GetRoleDisplayName(string role)
        => role switch
        {
            "Admin" => "Administrador",
            "Analyst" => "Analista",
            "Author" => "Autor",
            "WorkflowReviewerUodide" => "Revisor UODIDE",
            "WorkflowReviewerAreaTecnica" => "Revisor Área Técnica",
            "WorkflowProcessorAreaTecnica" => "Procesador Área Técnica",
            _ => role
        };

    public void Dispose()
    {
        AuthStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
    }
}
