@namespace tesisproject.frontend.Features.Management.Layout
@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@using tesisproject.frontend.SharedUI
@implements IDisposable

<AuthorizeView>
    <Authorized>
        <div class="app-shell">
            <!-- Sidebar fijo -->
            <aside class="layout-aside menu-bg text-white @sidebarClass" @ref="sidebarElement">
                <SideBar @ref="sidebarComponent" />
            </aside>

            <!-- Contenido principal con scroll independiente -->
            <div class="layout-main @mainContentClass" @onclick="CloseMobileMenu">
                <header class="brand-header text-white shadow-sm">
                    <div class="d-flex align-items-center justify-content-between px-4 py-3">
                        <!-- Botón menú móvil -->
                        <button class="btn btn-sm btn-outline-light d-lg-none mobile-menu-btn"
                                @onclick="ToggleMobileMenu">
                            <span>☰</span>
                        </button>

                        <div class="fw-semibold">SISTEMA INTEGRADO</div>

                        <!-- Espacio balance para móviles -->
                        <div class="d-lg-none" style="width: 40px;"></div>
                    </div>
                </header>

                <main class="flex-grow-1 p-4">
                    @Body
                </main>

                <footer class="app-footer text-center py-2">
                    <small>© @DateTime.Now.Year — Sistema Integrado</small>
                </footer>
            </div>
        </div>
    </Authorized>

    <Authorizing>
        <div class="d-flex justify-content-center align-items-center" style="min-height: 60vh;">
            <div class="text-muted">Cargando…</div>
        </div>
    </Authorizing>

    <NotAuthorized>
        @Body
    </NotAuthorized>
</AuthorizeView>

@code {
    private bool mobileMenuOpen = false;
    private string sidebarClass = "sidebar-expanded";
    private string mainContentClass = "sidebar-expanded";
    private ElementReference sidebarElement;
    private SideBar? sidebarComponent;
    private Timer? sidebarCheckTimer;
    private DotNetObjectReference<MainLayout>? objRef;

    [Inject] private IJSRuntime JSRuntime { get; set; } = default!;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await InitializeSidebarObserver();
            StartSidebarCheckTimer();
        }
    }

    private void ToggleMobileMenu()
    {
        mobileMenuOpen = !mobileMenuOpen;
        UpdateSidebarClasses();
        StateHasChanged();
    }

    private void CloseMobileMenu()
    {
        if (mobileMenuOpen)
        {
            mobileMenuOpen = false;
            UpdateSidebarClasses();
            StateHasChanged();
        }
    }

    private void UpdateSidebarClasses()
    {
        if (mobileMenuOpen)
        {
            sidebarClass = "mobile-open sidebar-expanded";
            mainContentClass = "sidebar-expanded";
        }
        else
        {
            // Verificar estado del sidebar
            CheckSidebarState();
        }
    }

    private async Task InitializeSidebarObserver()
    {
        objRef = DotNetObjectReference.Create(this);
        await JSRuntime.InvokeVoidAsync("registerSidebarLayoutListener", objRef);
    }

    [JSInvokable]
    public void OnSidebarLayoutStateChanged(bool collapsed)
    {
        if (collapsed)
        {
            sidebarClass = "sidebar-collapsed";
            mainContentClass = "sidebar-collapsed";
        }
        else
        {
            sidebarClass = "sidebar-expanded";
            mainContentClass = "sidebar-expanded";
        }
        StateHasChanged();
    }

    private void StartSidebarCheckTimer()
    {
        sidebarCheckTimer = new Timer(_ =>
        {
            InvokeAsync(CheckSidebarState);
        }, null, 1000, 1000);
    }

    private void CheckSidebarState()
    {
        try
        {
        }
        catch
        {
        }
    }

    public void Dispose()
    {
        sidebarCheckTimer?.Dispose();
        objRef?.Dispose();

        try
        {
            _ = JSRuntime.InvokeVoidAsync("unregisterSidebarLayoutListener");
        }
        catch
        {
        }
    }
}