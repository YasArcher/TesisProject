@using tesisproject.shared.DTOs.Reports

<div class="reports-dw-panel__grid">
    <article class="reports-dw-card reports-dw-card--gold">
        <span><i class="bi bi-journals"></i></span>
        <small>Total de artículos</small>
        <strong>@((Dashboard?.ScientificProduction.TotalArticles ?? 0).ToString("N0"))</strong>
        <em>General o filtrado</em>
    </article>

    <article class="reports-dw-card reports-dw-card--green">
        <span><i class="bi bi-unlock"></i></span>
        <small>Open Access</small>
        <strong>@((Dashboard?.ScientificProduction.OpenAccessArticles ?? 0).ToString("N0"))</strong>
        <em>Acceso abierto</em>
    </article>

    <article class="reports-dw-card reports-dw-card--blue">
        <span><i class="bi bi-folder-check"></i></span>
        <small>Resultado de proyecto</small>
        <strong>@((Dashboard?.ScientificProduction.ProjectResultArticles ?? 0).ToString("N0"))</strong>
        <em>Vinculados a proyectos</em>
    </article>

    <article class="reports-dw-card reports-dw-card--ink">
        <span><i class="bi bi-globe-americas"></i></span>
        <small>Interculturalidad</small>
        <strong>@((Dashboard?.ScientificProduction.InterculturalArticles ?? 0).ToString("N0"))</strong>
        <em>Componente intercultural</em>
    </article>

    <article class="reports-dw-card reports-dw-card--green reports-dw-card--coverage">
        <span><i class="bi bi-building"></i></span>
        <small>Revistas visibles</small>
        <strong>@((Dashboard?.FilterOptions.Venues.Count ?? 0).ToString("N0"))</strong>
        <em>Cobertura del filtro</em>
    </article>

    <article class="reports-dw-card reports-dw-card--blue reports-dw-card--coverage">
        <span><i class="bi bi-signpost-2"></i></span>
        <small>Líneas visibles</small>
        <strong>@((Dashboard?.FilterOptions.ResearchLines.Count ?? 0).ToString("N0"))</strong>
        <em>Cobertura del filtro</em>
    </article>

    <article class="reports-dw-card reports-dw-card--gold reports-dw-card--coverage">
        <span><i class="bi bi-mortarboard"></i></span>
        <small>Facultades visibles</small>
        <strong>@((Dashboard?.FilterOptions.Faculties.Count ?? 0).ToString("N0"))</strong>
        <em>Cobertura del filtro</em>
    </article>

    <article class="reports-dw-card reports-dw-card--ink reports-dw-card--coverage">
        <span><i class="bi bi-database-check"></i></span>
        <small>Bases visibles</small>
        <strong>@((Dashboard?.FilterOptions.IndexingSources.Count ?? 0).ToString("N0"))</strong>
        <em>Cobertura del filtro</em>
    </article>
</div>

<div class="reports-dw-inline-note reports-dw-inline-note--soft">
    Producción arriba. Cobertura del filtro en las últimas cuatro tarjetas.
</div>

<div class="reports-dw-panel__footer">
    <span>
        <i class="bi bi-clock-history"></i>
        Actualizado: @LastEtlLabel
    </span>
    <span>
        <i class="bi bi-activity"></i>
        Alcance: @ScopeLabel
    </span>
</div>

@code {
    [Parameter] public InstitutionalReportingDashboardDto? Dashboard { get; set; }
    [Parameter] public string LastEtlLabel { get; set; } = "Sin actualización";
    [Parameter] public string ScopeLabel { get; set; } = "Vista general institucional";
}
