@using tesisproject.shared.DTOs.Reports

<div class="reports-dw-slider-intro">
    <span>
        <i class="bi bi-stars"></i>
        Lectura rápida del tablero
    </span>
    <small>Desliza horizontalmente para revisar los indicadores principales sin saturar la pantalla.</small>
</div>

<div class="reports-dw-panel__grid">
    <article class="reports-dw-card reports-dw-card--gold">
        <span><i class="bi bi-journals"></i></span>
        <small>Total de artículos</small>
        <strong>@((Dashboard?.ScientificProduction.TotalArticles ?? 0).ToString("N0"))</strong>
        <em>Total dentro del periodo y filtros seleccionados</em>
    </article>

    <article class="reports-dw-card reports-dw-card--green">
        <span><i class="bi bi-diagram-3"></i></span>
        <small>Campo amplio destacado</small>
        <strong>@TopBroadFieldLabel</strong>
        <em>Campo amplio con mayor cantidad de artículos</em>
    </article>

    <article class="reports-dw-card reports-dw-card--blue">
        <span><i class="bi bi-diagram-2"></i></span>
        <small>Campo específico destacado</small>
        <strong>@TopSpecificFieldLabel</strong>
        <em>Campo específico con mayor producción registrada</em>
    </article>

    <article class="reports-dw-card reports-dw-card--ink">
        <span><i class="bi bi-bezier"></i></span>
        <small>Campo detallado destacado</small>
        <strong>@TopDetailedFieldLabel</strong>
        <em>Campo detallado más representativo del filtro aplicado</em>
    </article>

    <article class="reports-dw-card reports-dw-card--green">
        <span><i class="bi bi-building"></i></span>
        <small>Revista destacada</small>
        <strong>@TopVenueLabel</strong>
        <em>Revista con mayor concentración</em>
    </article>

    <article class="reports-dw-card reports-dw-card--blue">
        <span><i class="bi bi-signpost-2"></i></span>
        <small>Línea destacada</small>
        <strong>@TopResearchLineLabel</strong>
        <em>Línea de investigación con más artículos</em>
    </article>

    <article class="reports-dw-card reports-dw-card--gold">
        <span><i class="bi bi-award"></i></span>
        <small>Cuartil destacado</small>
        <strong>@TopQuartileLabel</strong>
        <em>Concentración según la categoría de la revista</em>
    </article>

    <article class="reports-dw-card reports-dw-card--ink">
        <span><i class="bi bi-calendar-range"></i></span>
        <small>Periodo analizado</small>
        <strong>@PeriodLabel</strong>
        <em>Agrupación anual, mensual y diaria del tablero</em>
    </article>
</div>

<div class="reports-dw-panel__footer">
    <span>
        <i class="bi bi-calendar-range"></i>
        Calendario institucional listo
    </span>
    <span>
        <i class="bi bi-clock-history"></i>
        Última actualización: @LastEtlLabel
    </span>
    <span>
        <i class="bi bi-layers"></i>
        Registros procesados: @((Dashboard?.LoadQuality.TotalRows ?? 0).ToString("N0"))
    </span>
    <span>
        <i class="bi bi-activity"></i>
        Vista: @ScopeLabel
    </span>
</div>

@code {
    [Parameter] public InstitutionalReportingDashboardDto? Dashboard { get; set; }
    [Parameter] public string TopBroadFieldLabel { get; set; } = "Sin dato";
    [Parameter] public string TopSpecificFieldLabel { get; set; } = "Sin dato";
    [Parameter] public string TopDetailedFieldLabel { get; set; } = "Sin dato";
    [Parameter] public string TopVenueLabel { get; set; } = "Sin dato";
    [Parameter] public string TopResearchLineLabel { get; set; } = "Sin dato";
    [Parameter] public string TopQuartileLabel { get; set; } = "Sin dato";
    [Parameter] public string PeriodLabel { get; set; } = "Sin periodo";
    [Parameter] public string LastEtlLabel { get; set; } = "Sin actualización";
    [Parameter] public string ScopeLabel { get; set; } = "Vista general institucional";
}
