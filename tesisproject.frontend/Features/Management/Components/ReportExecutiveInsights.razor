@using tesisproject.shared.DTOs.Reports

<section class="reports-dw-insights-panel">
    <div class="reports-dw-insights-panel__header">
        <span><i class="bi bi-lightbulb"></i></span>
        <div>
            <small>Resumen ejecutivo</small>
            <h2>Lectura estratégica del reporte filtrado</h2>
            <p>Conclusiones rápidas para orientar la interpretación de la producción científica.</p>
        </div>
    </div>

    <div class="reports-dw-insights-grid">
        @foreach (var insight in Insights)
        {
            <article class="reports-dw-insight-card">
                <span><i class="@insight.IconClass"></i></span>
                <div>
                    <small>@insight.Label</small>
                    <strong>@insight.Value</strong>
                    <p>@insight.Helper</p>
                </div>
            </article>
        }
    </div>
</section>

@code {
    [Parameter] public InstitutionalReportingDashboardDto? Dashboard { get; set; }
    [Parameter] public string ScopeLabel { get; set; } = "Vista general institucional";

    private IReadOnlyList<InsightItem> Insights =>
    [
        new(
            "Alcance",
            ScopeLabel,
            $"{Dashboard?.ScientificProduction.TotalArticles.ToString("N0") ?? "0"} artículos dentro de la selección actual.",
            "bi bi-funnel"),
        new(
            "Facultad dominante",
            TopFacultyLabel,
            "Facultad con mayor producción dentro del filtro aplicado.",
            "bi bi-mortarboard"),
        new(
            "Base de datos dominante",
            TopIndexingLabel,
            "Fuente de indexación con mayor presencia en el reporte.",
            "bi bi-database-check"),
        new(
            "Revista destacada",
            TopVenueLabel,
            "Revista con mayor concentración de artículos registrados.",
            "bi bi-building"),
        new(
            "Cuartil destacado",
            TopQuartileLabel,
            "Clasificación editorial con mayor concentración de artículos.",
            "bi bi-award"),
        new(
            "Acceso abierto",
            OpenAccessLabel,
            "Participación de artículos open access dentro de la selección.",
            "bi bi-unlock"),
        new(
            "Trazabilidad autoral",
            AuthorTraceLabel,
            "Cobertura de artículos conectados con autores en el DW.",
            "bi bi-person-lines-fill"),
        new(
            "Calidad de carga",
            LoadQualityLabel,
            "Filas exitosas frente al total procesado en staging.",
            "bi bi-shield-check"),
        new(
            "Workflow",
            WorkflowSignalLabel,
            "Balance entre aprobaciones, devoluciones y duración promedio.",
            "bi bi-diagram-3")
    ];

    private string TopFacultyLabel => BuildTopLabel(
        Dashboard?.ParticipationSummary.ByFaculty.Select(x => (x.Name, x.TotalArticles)),
        "Sin facultad");

    private string TopIndexingLabel => BuildTopLabel(
        Dashboard?.ParticipationSummary.ByIndexingSource.Select(x => (x.Name, x.TotalArticles)),
        "Sin base de datos");

    private string TopVenueLabel => BuildTopLabel(
        Dashboard?.ArticlesByVenue.Select(x => (x.VenueName, x.TotalArticles)),
        "Sin revista");

    private string TopQuartileLabel => BuildTopLabel(
        Dashboard?.ArticlesByQuartile.Select(x => (x.Name, x.TotalArticles)),
        "Sin cuartil");

    private string OpenAccessLabel
    {
        get
        {
            var total = Dashboard?.ScientificProduction.TotalArticles ?? 0;
            if (total <= 0)
            {
                return "Sin artículos";
            }

            var openAccess = Dashboard?.ScientificProduction.OpenAccessArticles ?? 0;
            return $"{BuildPercent(openAccess, total)}% · {openAccess:N0}";
        }
    }

    private string AuthorTraceLabel
    {
        get
        {
            var total = Dashboard?.ScientificProduction.TotalArticles ?? 0;
            if (total <= 0)
            {
                return "Sin artículos";
            }

            var traced = Dashboard?.AuthorTraceCoverage.ArticlesWithAuthorTrace ?? 0;
            return $"{BuildPercent(traced, total)}% · {traced:N0}";
        }
    }

    private string LoadQualityLabel
    {
        get
        {
            var total = Dashboard?.LoadQuality.TotalRows ?? 0;
            if (total <= 0)
            {
                return "Sin lotes";
            }

            var successful = Dashboard?.LoadQuality.SuccessfulRows ?? 0;
            return $"{BuildPercent(successful, total)}% · {successful:N0}";
        }
    }

    private string WorkflowSignalLabel
    {
        get
        {
            var workflow = Dashboard?.Workflow;
            if (workflow is null || workflow.TotalStageExecutions <= 0)
            {
                return "Sin etapas";
            }

            var duration = workflow.AvgStageDurationSeconds.HasValue
                ? FormatDuration(workflow.AvgStageDurationSeconds.Value)
                : "sin duración";

            return $"{workflow.ApprovedStages:N0} aprob. · {workflow.ReturnedStages:N0} dev. · {duration}";
        }
    }

    private static string BuildTopLabel(IEnumerable<(string Name, int Total)>? source, string fallback)
    {
        var item = source?
            .Where(x => x.Total > 0)
            .OrderByDescending(x => x.Total)
            .FirstOrDefault();

        if (item is null || item.Value.Total <= 0)
        {
            return fallback;
        }

        return $"{Shorten(item.Value.Name, 34)} · {item.Value.Total:N0}";
    }

    private static int BuildPercent(int value, int total)
    {
        if (total <= 0)
        {
            return 0;
        }

        return (int)Math.Round(Math.Max(0, Math.Min(100, value * 100m / total)));
    }

    private static string FormatDuration(decimal seconds)
    {
        if (seconds < 60)
        {
            return $"{seconds:N0}s";
        }

        if (seconds < 3600)
        {
            return $"{seconds / 60:N1}min";
        }

        return $"{seconds / 3600:N1}h";
    }

    private static string Shorten(string? value, int maxLength)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "Sin dato";
        }

        var text = value.Trim();
        return text.Length <= maxLength ? text : text[..Math.Max(0, maxLength - 1)] + "...";
    }

    private sealed record InsightItem(string Label, string Value, string Helper, string IconClass);
}
