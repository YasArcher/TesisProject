@using tesisproject.shared.DTOs.Catalogs

<div class="report-select-filter flex flex-col">
    <label class="text-xs font-semibold text-slate-500 uppercase tracking-wide mb-1">Revista</label>
    <select class="rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-[#7A1E19]/70 focus:border-[#7A1E19]"
            value="@Value"
            @onchange="HandleChanged">
        <option value="0">Todos</option>
        @foreach (var item in Items)
        {
            <option value="@item.Id">@item.Name</option>
        }
    </select>
</div>

@code {
    [Parameter] public int Value { get; set; }
    [Parameter] public EventCallback<int> ValueChanged { get; set; }
    [Parameter] public IReadOnlyList<VenueCatalogItemDto> Items { get; set; } = [];

    private Task HandleChanged(ChangeEventArgs args)
        => ValueChanged.InvokeAsync(int.TryParse(Convert.ToString(args.Value), out var value) ? value : 0);
}
