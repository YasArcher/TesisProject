<section class="reports-dw-toolbar">
    <div class="reports-dw-toolbar__title">
        <span><i class="bi bi-activity"></i></span>
        <div>
            <strong>Vista institucional</strong>
            <small>Estado de la lectura actual</small>
        </div>
    </div>
    <div class="reports-dw-toolbar__meta">
        <span>
            <small>Alcance</small>
            <strong><i class="bi bi-grid-1x2"></i>@ScopeLabel</strong>
        </span>
        <span>
            <small>Última carga</small>
            <strong><i class="bi bi-clock-history"></i>@LastLoadedLabel</strong>
        </span>
    </div>
</section>

@code {
    [Parameter] public string ScopeLabel { get; set; } = "Vista general institucional";
    [Parameter] public string LastLoadedLabel { get; set; } = "Sin lectura reciente";
}
