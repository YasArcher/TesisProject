@using tesisproject.shared.DTOs.Reports

<div id="reports-block-production" class="reports-dw-section-heading">
    <span><i class="bi bi-graph-up-arrow"></i></span>
    <div>
        <small>Producción</small>
        <h2>Producción y ritmo temporal</h2>
        <p>Volumen y evolución del resultado actual.</p>
    </div>
</div>

@if (HasTemporalSummary)
{
    <div class="reports-dw-inline-note reports-dw-inline-note--soft">
        Vista resumida: hasta 12 meses y 12 días recientes.
    </div>
}

<ReportChartCard Title="Producción por año"
                 Description="Tendencia del resultado actual."
                 Tooltip="Ayuda a identificar crecimiento, estabilización o caída de la producción visible en el filtro."
                 HasData="@(Dashboard?.ArticlesByYear.Count > 0)"
                 EmptyMessage="No hay distribución anual disponible."
                 ChartId="chart-production-year"
                 Height="@ProductionTrendHeight"
                 Option="@ProductionTrendOption"
                 Accent="blue"
                 Density="primary" />

<article class="reports-dw-chart-card reports-dw-chart-card--green">
    <ReportCardHeader IconClass="bi bi-pie-chart"
                      Title="Open Access"
                      Description="Proporción abierta del resultado." />
    <div class="reports-dw-donut-layout">
        <div class="reports-dw-donut" style="@OpenAccessDonutStyle">
            <span>@OpenAccessPercent%</span>
        </div>
        <div class="reports-dw-donut-legend">
            <strong>@((Dashboard?.ScientificProduction.OpenAccessArticles ?? 0).ToString("N0")) OA</strong>
            <span>@(((Dashboard?.ScientificProduction.TotalArticles ?? 0) - (Dashboard?.ScientificProduction.OpenAccessArticles ?? 0)).ToString("N0")) no OA</span>
        </div>
    </div>
</article>

<ReportChartCard Title="Artículos por cuartil"
                 Description="Volumen absoluto del resultado por cuartil."
                 Tooltip="Muestra cuántos artículos visibles caen en cada cuartil dentro del resultado filtrado."
                 HasData="@(Dashboard?.ArticlesByQuartile.Count > 0)"
                 EmptyMessage="Sin cuartiles vinculados a artículos."
                 ChartId="chart-production-quartiles"
                 Height="320px"
                 Option="@QuartileArticlesChartOption"
                 Accent="gold"
                 Density="compact" />

<article class="reports-dw-chart-card reports-dw-chart-card--wide reports-dw-chart-card--ink">
    <ReportCardHeader IconClass="bi bi-calendar3"
                      Title="Ritmo de registro"
                      Description="Cadencia reciente del resultado.">
        <div class="reports-dw-card-meta">
            <span><i class="bi bi-arrows"></i> Navegación temporal</span>
        </div>
    </ReportCardHeader>
    <div class="reports-dw-subtabs">
        <button type="button"
                class="@(ProductionPeriodView == "months" ? "reports-dw-subtab reports-dw-subtab--active" : "reports-dw-subtab")"
                @onclick="@(() => ProductionPeriodView = "months")">
            Meses
        </button>
        <button type="button"
                class="@(ProductionPeriodView == "days" ? "reports-dw-subtab reports-dw-subtab--active" : "reports-dw-subtab")"
                @onclick="@(() => ProductionPeriodView = "days")">
            Días
        </button>
    </div>

    @if (ProductionPeriodView == "months")
    {
        <ReportChartCard Title="Últimos meses"
                         Description="Comparativo mensual reciente."
                         HasData="@(RecentMonthItems.Count > 0)"
                         EmptyMessage="Sin distribución mensual disponible."
                         ChartId="chart-production-months"
                         Height="320px"
                         Option="@ProductionMonthsChartOption"
                         Accent="blue"
                         Density="compact" />
    }
    else
    {
        <ReportChartCard Title="Días con registro"
                         Description="Actividad diaria reciente."
                         HasData="@(RecentDayItems.Count > 0)"
                         EmptyMessage="Sin distribución diaria disponible."
                         ChartId="chart-production-days"
                         Height="320px"
                         Option="@ProductionDaysChartOption"
                         Accent="sage"
                         Density="compact" />
    }
</article>

@code {
    [Parameter] public InstitutionalReportingDashboardDto? Dashboard { get; set; }
    private string ProductionPeriodView { get; set; } = "months";

    private bool HasTemporalSummary =>
        (Dashboard?.ArticlesByMonth.Count ?? 0) > 12
        || (Dashboard?.ArticlesByDay.Count ?? 0) > 12;

    private IReadOnlyList<ReportingSummaryItemDto> RecentMonthItems =>
        Dashboard?.ArticlesByMonth.TakeLast(12).ToList() ?? [];

    private IReadOnlyList<ReportingSummaryItemDto> RecentDayItems =>
        Dashboard?.ArticlesByDay
            .Take(12)
            .OrderBy(x => x.Name)
            .ToList() ?? [];

    private string ProductionTrendHeight =>
        ReportChartOptionsFactory.GetChartHeight(Dashboard?.ArticlesByYear.Count ?? 0);

    private object? ProductionTrendOption =>
        ReportChartOptionsFactory.BuildTrend(Dashboard?.ArticlesByYear);

    private object? QuartileArticlesChartOption =>
        ReportChartOptionsFactory.BuildSummaryDonut(Dashboard?.ArticlesByQuartile, "Cuartiles");

    private object? ProductionMonthsChartOption =>
        ReportChartOptionsFactory.BuildVerticalBar(
            RecentMonthItems.Select(x => x.Name).ToArray(),
            RecentMonthItems.Select(x => x.TotalArticles).ToArray(),
            "Artículos",
            "#435663",
            true);

    private object? ProductionDaysChartOption =>
        ReportChartOptionsFactory.BuildVerticalBar(
            RecentDayItems.Select(x => x.Name).ToArray(),
            RecentDayItems.Select(x => x.TotalArticles).ToArray(),
            "Artículos",
            "#97B067",
            true);

    private int MaxArticlesByYear =>
        Math.Max(1, Dashboard?.ArticlesByYear.Select(x => x.Count).DefaultIfEmpty(0).Max() ?? 0);

    private int MaxQuartileArticles =>
        Math.Max(1, Dashboard?.ArticlesByQuartile.Select(x => x.TotalArticles).DefaultIfEmpty(0).Max() ?? 0);

    private int MaxMonthArticles =>
        Math.Max(1, Dashboard?.ArticlesByMonth.Select(x => x.TotalArticles).DefaultIfEmpty(0).Max() ?? 0);

    private int MaxDayArticles =>
        Math.Max(1, Dashboard?.ArticlesByDay.Select(x => x.TotalArticles).DefaultIfEmpty(0).Max() ?? 0);

    private int OpenAccessPercent =>
        (Dashboard?.ScientificProduction.TotalArticles ?? 0) <= 0
            ? 0
            : (int)Math.Round((Dashboard!.ScientificProduction.OpenAccessArticles / (double)Dashboard.ScientificProduction.TotalArticles) * 100);

    private string OpenAccessDonutStyle =>
        $"background: conic-gradient(#97b067 0 {OpenAccessPercent}%, rgba(67, 86, 99, 0.12) {OpenAccessPercent}% 100%);";

    private static string GetBarWidth(int value, int maxValue)
    {
        if (maxValue <= 0 || value <= 0)
        {
            return "0%";
        }

        var percent = Math.Clamp((value / (double)maxValue) * 100, 4, 100);
        return $"{percent:0.##}%";
    }
}
