<section class="reports-dw-presets" aria-label="Plantillas de reportería DIDE">
    <div class="reports-dw-presets__title">
        <span><i class="bi bi-file-earmark-ruled"></i></span>
        <div>
            <strong>Plantillas de reporte</strong>
            <small>@ActivePresetLabel</small>
        </div>
    </div>

    <div class="reports-dw-presets__actions">
        @foreach (var preset in Presets)
        {
            <button class="@GetButtonClass(preset.Key)"
                    type="button"
                    disabled="@IsBusy"
                    title="@preset.Description"
                    @onclick="() => OnPresetSelected.InvokeAsync(preset.Key)">
                <i class="@preset.Icon"></i>
                <span>@preset.Label</span>
            </button>
        }
    </div>
</section>

@code {
    [Parameter] public string? ActivePreset { get; set; }
    [Parameter] public bool IsBusy { get; set; }
    [Parameter] public EventCallback<string> OnPresetSelected { get; set; }

    private string ActivePresetLabel
        => string.IsNullOrWhiteSpace(ActivePreset)
            ? "Selecciona un formato para preparar el PDF con secciones sugeridas."
            : $"Formato activo: {GetPresetLabel(ActivePreset)}";

    private static IReadOnlyList<ReportPresetItem> Presets { get; } =
    [
        new("pedi-quarter", "PEDI IV trimestre", "bi bi-calendar3-range", "Resumen trimestral con participación, periodo, campos, autores y PEDI IIIT."),
        new("tdd-management", "TDD informe gestión", "bi bi-clipboard-data", "Informe de gestión con participación, TDD Total, periodo, autores y artículos."),
        new("pedi-iiit", "PEDI IIIT", "bi bi-grid-1x2", "Detalle específico PEDI IIIT con filtros, indicadores y artículos incluidos."),
        new("tdd-total", "TDD Total", "bi bi-table", "Detalle TDD Total con filtros, indicadores, participación y artículos incluidos.")
    ];

    private string GetButtonClass(string key)
        => string.Equals(ActivePreset, key, StringComparison.OrdinalIgnoreCase)
            ? "reports-dw-preset-button reports-dw-preset-button--active"
            : "reports-dw-preset-button";

    private static string GetPresetLabel(string key)
        => Presets.FirstOrDefault(x => string.Equals(x.Key, key, StringComparison.OrdinalIgnoreCase))?.Label
        ?? "plantilla personalizada";

    private sealed record ReportPresetItem(string Key, string Label, string Icon, string Description);
}
