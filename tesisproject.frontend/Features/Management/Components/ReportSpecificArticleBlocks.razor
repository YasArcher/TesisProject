@using tesisproject.shared.DTOs.Reports

<div id="reports-block-pedi" class="reports-dw-section-heading reports-dw-section-heading--gold">
    <span><i class="bi bi-table"></i></span>
    <div>
        <small>Bloque específico</small>
        <h2>PEDI IIIT</h2>
        <p>Detalle filtrable por fecha de publicación, proyecto de investigación, base de datos y cuartil.</p>
    </div>
</div>

<article class="reports-dw-chart-card reports-dw-chart-card--wide">
    <ReportCardHeader IconClass="bi bi-database-check"
                      Title="PEDI IIIT"
                      Description="Título de artículo, base de datos, enlace de publicación y mes de publicación.">
        <div class="reports-dw-card-meta">
            <span><i class="bi bi-list-check"></i> @PediIiitScopeLabel</span>
            <span><i class="bi bi-funnel"></i> @ScopeLabel</span>
        </div>
    </ReportCardHeader>
    <div class="reports-dw-table-wrap">
        @if ((Dashboard?.PediIiitArticles.Count ?? 0) == 0)
        {
            <ReportEmptyState Title="Sin artículos para PEDI IIIT"
                              Message="No hay artículos que coincidan con los filtros actuales para este bloque."
                              IconClass="bi bi-database-x" />
        }
        else
        {
            <table class="reports-dw-table">
                <thead>
                    <tr>
                        <th>Título de artículo</th>
                        <th>Base de datos</th>
                        <th>Enlace</th>
                        <th>Mes de publicación</th>
                        <th>Proyecto</th>
                        <th>Cuartil</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var article in Dashboard!.PediIiitArticles.Take(20))
                    {
                        <tr>
                            <td class="reports-dw-table-title">@article.Title</td>
                            <td><span class="reports-dw-pill reports-dw-pill--db">@article.IndexingSourceName</span></td>
                            <td>
                                @if (string.IsNullOrWhiteSpace(article.PublicationUrl))
                                {
                                    <span>Sin enlace</span>
                                }
                                else
                                {
                                    <a href="@article.PublicationUrl" target="_blank" rel="noopener noreferrer">Abrir publicación</a>
                                }
                            </td>
                            <td>@article.PublicationMonth</td>
                            <td><span class="@(article.IsProjectResult ? "reports-dw-pill reports-dw-pill--yes" : "reports-dw-pill")">@(article.IsProjectResult ? "Sí" : "No")</span></td>
                            <td><span class="reports-dw-pill reports-dw-pill--quartile">@article.Quartile</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</article>

<div id="reports-block-tdd" class="reports-dw-section-heading reports-dw-section-heading--sage">
    <span><i class="bi bi-clipboard-data"></i></span>
    <div>
        <small>Bloque específico</small>
        <h2>TDD Total</h2>
        <p>Detalle por publicación, base de datos, cuartil, facultad y mes.</p>
    </div>
</div>

<article class="reports-dw-chart-card reports-dw-chart-card--wide">
    <ReportCardHeader IconClass="bi bi-journal-text"
                      Title="TDD Total"
                      Description="Información estratégica filtrable desde el panel superior: fechas, facultad, base de datos, revista y cuartil.">
        <div class="reports-dw-card-meta">
            <span><i class="bi bi-table"></i> @TddTotalScopeLabel</span>
            <span><i class="bi bi-building"></i> @((Dashboard?.ParticipationSummary.ByFaculty.Count ?? 0).ToString("N0")) facultades</span>
        </div>
    </ReportCardHeader>
    <div class="reports-dw-table-wrap">
        @if ((Dashboard?.TddTotalArticles.Count ?? 0) == 0)
        {
            <ReportEmptyState Title="Sin publicaciones para TDD Total"
                              Message="No hay publicaciones que coincidan con los filtros actuales para este bloque."
                              IconClass="bi bi-journal-x" />
        }
        else
        {
            <table class="reports-dw-table">
                <thead>
                    <tr>
                        <th>Título de publicación</th>
                        <th>Base de datos</th>
                        <th>Cuartil</th>
                        <th>Facultad</th>
                        <th>Mes</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var article in Dashboard!.TddTotalArticles.Take(24))
                    {
                        <tr>
                            <td class="reports-dw-table-title">@article.Title</td>
                            <td><span class="reports-dw-pill reports-dw-pill--db">@article.IndexingSourceName</span></td>
                            <td><span class="reports-dw-pill reports-dw-pill--quartile">@article.Quartile</span></td>
                            <td>@article.Faculty</td>
                            <td>@article.PublicationMonth</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</article>

<article class="reports-dw-chart-card">
    <ReportCardHeader IconClass="bi bi-building"
                      Title="Conteo de artículos por facultad"
                      Description="Resumen directo para lectura ejecutiva dentro del bloque específico.">
        <div class="reports-dw-card-meta">
            <span><i class="bi bi-pie-chart"></i> @ParticipationScopeLabel</span>
        </div>
    </ReportCardHeader>
    <div class="reports-dw-bars reports-dw-bars--compact">
        @foreach (var item in Dashboard?.ParticipationSummary.ByFaculty.Take(9) ?? [])
        {
            <div class="reports-dw-bar-row">
                <span title="@item.Name">@item.Name</span>
                <div class="reports-dw-bar-track">
                    <div class="reports-dw-bar-fill reports-dw-bar-fill--sage" style="width:@GetBarWidth(item.TotalArticles, MaxFacultyArticles)"></div>
                </div>
                <strong>@item.TotalArticles</strong>
            </div>
        }
    </div>
</article>

@code {
    [Parameter] public InstitutionalReportingDashboardDto? Dashboard { get; set; }
    [Parameter] public string ScopeLabel { get; set; } = "Vista general institucional";
    [Parameter] public string PediIiitScopeLabel { get; set; } = string.Empty;
    [Parameter] public string TddTotalScopeLabel { get; set; } = string.Empty;
    [Parameter] public string ParticipationScopeLabel { get; set; } = string.Empty;

    private int MaxFacultyArticles =>
        Math.Max(1, Dashboard?.ParticipationSummary.ByFaculty.Select(x => x.TotalArticles).DefaultIfEmpty(0).Max() ?? 0);

    private static string GetBarWidth(int value, int maxValue)
    {
        if (maxValue <= 0 || value <= 0)
        {
            return "0%";
        }

        var percent = Math.Clamp((value / (double)maxValue) * 100, 4, 100);
        return $"{percent:0.##}%";
    }
}
