@using tesisproject.shared.DTOs.Reports

<div id="reports-block-pedi" class="reports-dw-section-heading reports-dw-section-heading--gold">
    <span><i class="bi bi-table"></i></span>
    <div>
        <small>Bloque específico</small>
        <h2>PEDI IIIT</h2>
        <p>Artículos para PEDI IIIT.</p>
    </div>
</div>

@if (HasSpecificSummaryTrim)
{
    <div class="reports-dw-inline-note reports-dw-inline-note--soft">
        Las filas incluyen indexaciones y pendientes.
    </div>
}

<article class="reports-dw-chart-card reports-dw-chart-card--wide">
    <ReportCardHeader IconClass="bi bi-database-check"
                      Title="PEDI IIIT"
                      Description="Detalle reportable.">
        <div class="reports-dw-card-meta">
            <span><i class="bi bi-list-check"></i> @PediIiitScopeLabel</span>
            <span><i class="bi bi-funnel"></i> @ScopeLabel</span>
        </div>
    </ReportCardHeader>
    <div class="reports-dw-subtabs">
        <button type="button"
                class="@(PediView == "summary" ? "reports-dw-subtab reports-dw-subtab--active" : "reports-dw-subtab")"
                @onclick="@(() => PediView = "summary")">
            Resumen
        </button>
        <button type="button"
                class="@(PediView == "table" ? "reports-dw-subtab reports-dw-subtab--active" : "reports-dw-subtab")"
                @onclick="@(() => PediView = "table")">
            Tabla
        </button>
    </div>
    @if ((Dashboard?.PediIiitArticles.Count ?? 0) == 0)
    {
        <ReportEmptyState Title="Sin artículos para PEDI IIIT"
                          Message="No hay artículos que coincidan con los filtros actuales para este bloque."
                          IconClass="bi bi-database-x" />
    }
    else if (PediView == "summary")
    {
        <div class="reports-dw-micro-grid">
            <article class="reports-dw-micro-card">
                <small>Artículos únicos</small>
                <strong>@PediUniqueArticleCount.ToString("N0")</strong>
                <span>Artículos registrados en el resultado</span>
            </article>
            <article class="reports-dw-micro-card">
                <small>Filas reportables</small>
                <strong>@((Dashboard?.PediIiitArticles.Count ?? 0).ToString("N0"))</strong>
                <span>Indexación o pendiente</span>
            </article>
            <article class="reports-dw-micro-card">
                <small>Sin indexación</small>
                <strong>@PediMissingIndexingCount.ToString("N0")</strong>
                <span>Requieren completar base</span>
            </article>
            <article class="reports-dw-micro-card">
                <small>Resultado de proyecto</small>
                <strong>@((Dashboard?.PediIiitArticles.Count(x => x.IsProjectResult) ?? 0).ToString("N0"))</strong>
                <span>Publicaciones vinculadas a proyectos</span>
            </article>
            <article class="reports-dw-micro-card">
                <small>Bases visibles</small>
                <strong>@((Dashboard?.PediIiitArticles.Select(x => x.IndexingSourceName).Distinct(StringComparer.OrdinalIgnoreCase).Count() ?? 0).ToString("N0"))</strong>
                <span>Fuentes de indexación presentes</span>
            </article>
        </div>
        <div class="reports-dw-inline-note reports-dw-inline-note--soft">
            Las barras resumen filas reportables; un artículo puede aparecer más de una vez si está en varias bases.
        </div>
        <div class="reports-dw-bars reports-dw-bars--compact">
            @foreach (var item in (Dashboard?.PediIiitArticles ?? [])
                .GroupBy(x => string.IsNullOrWhiteSpace(x.Quartile) ? "Sin cuartil" : x.Quartile)
                .Select(g => new { Name = g.Key, Total = g.Count() })
                .OrderByDescending(x => x.Total))
            {
                <div class="reports-dw-bar-row">
                    <span>@item.Name</span>
                    <div class="reports-dw-bar-track">
                        <div class="reports-dw-bar-fill reports-dw-bar-fill--gold" style="width:@GetBarWidth(item.Total, MaxPediQuartileCount)"></div>
                    </div>
                    <strong>@item.Total</strong>
                </div>
            }
        </div>
    }
    else
    {
        <div class="reports-dw-table-wrap">
            <table class="reports-dw-table">
                <thead>
                    <tr>
                        <th>Título de artículo</th>
                        <th>Base de datos</th>
                        <th class="reports-dw-col--mobile-hide">Revista / ISSN</th>
                        <th class="reports-dw-col--mobile-hide">DOI</th>
                        <th class="reports-dw-col--tablet-hide">Autor</th>
                        <th class="reports-dw-col--tablet-hide">Línea de investigación</th>
                        <th class="reports-dw-col--tablet-hide">Facultad</th>
                        <th class="reports-dw-col--tablet-hide">Mes de publicación</th>
                        <th class="reports-dw-col--mobile-hide">Proyecto</th>
                        <th class="reports-dw-col--mobile-hide">Nombre proyecto</th>
                        <th class="reports-dw-col--mobile-hide">Intercultural</th>
                        <th>Cuartil</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var article in Dashboard!.PediIiitArticles)
                    {
                        <tr>
                            <td class="reports-dw-table-title">@article.Title</td>
                            <td><span class="reports-dw-pill reports-dw-pill--db">@article.IndexingSourceName</span></td>
                            <td class="reports-dw-col--mobile-hide">
                                <span>@article.VenueName</span>
                                <small>@(string.IsNullOrWhiteSpace(article.Issn) ? "Sin ISSN" : article.Issn)</small>
                            </td>
                            <td class="reports-dw-col--mobile-hide">
                                @if (string.IsNullOrWhiteSpace(article.Doi))
                                {
                                    <span>Sin DOI</span>
                                }
                                else
                                {
                                    <span>@article.Doi</span>
                                }
                            </td>
                            <td class="reports-dw-col--tablet-hide">
                                <span>@article.AuthorName</span>
                                <small>@(string.IsNullOrWhiteSpace(article.AuthorIdentification) ? article.ParticipantType : article.AuthorIdentification)</small>
                            </td>
                            <td class="reports-dw-col--tablet-hide">@article.Career</td>
                            <td class="reports-dw-col--tablet-hide">@article.Faculty</td>
                            <td class="reports-dw-col--tablet-hide">@article.PublicationMonth</td>
                            <td class="reports-dw-col--mobile-hide"><span class="@(article.IsProjectResult ? "reports-dw-pill reports-dw-pill--yes" : "reports-dw-pill")">@(article.IsProjectResult ? "Sí" : "No")</span></td>
                            <td class="reports-dw-col--mobile-hide">@GetProjectNameLabel(article)</td>
                            <td class="reports-dw-col--mobile-hide"><span class="@(article.HasInterculturalComponent ? "reports-dw-pill reports-dw-pill--yes" : "reports-dw-pill")">@(article.HasInterculturalComponent ? "Sí" : "No")</span></td>
                            <td><span class="reports-dw-pill reports-dw-pill--quartile">@article.Quartile</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</article>

<div id="reports-block-tdd" class="reports-dw-section-heading reports-dw-section-heading--sage">
    <span><i class="bi bi-clipboard-data"></i></span>
    <div>
        <small>Bloque específico</small>
        <h2>TDD Total</h2>
        <p>Publicaciones para TDD Total.</p>
    </div>
</div>

<article class="reports-dw-chart-card reports-dw-chart-card--wide">
    <ReportCardHeader IconClass="bi bi-journal-text"
                      Title="TDD Total"
                      Description="Detalle reportable.">
        <div class="reports-dw-card-meta">
            <span><i class="bi bi-table"></i> @TddTotalScopeLabel</span>
            <span><i class="bi bi-building"></i> @((Dashboard?.ParticipationSummary.ByFaculty.Count ?? 0).ToString("N0")) facultades</span>
        </div>
    </ReportCardHeader>
    <div class="reports-dw-subtabs">
        <button type="button"
                class="@(TddView == "summary" ? "reports-dw-subtab reports-dw-subtab--active" : "reports-dw-subtab")"
                @onclick="@(() => TddView = "summary")">
            Resumen
        </button>
        <button type="button"
                class="@(TddView == "table" ? "reports-dw-subtab reports-dw-subtab--active" : "reports-dw-subtab")"
                @onclick="@(() => TddView = "table")">
            Tabla
        </button>
    </div>
    @if ((Dashboard?.TddTotalArticles.Count ?? 0) == 0)
    {
        <ReportEmptyState Title="Sin publicaciones para TDD Total"
                          Message="No hay publicaciones que coincidan con los filtros actuales para este bloque."
                          IconClass="bi bi-journal-x" />
    }
    else if (TddView == "summary")
    {
        <div class="reports-dw-micro-grid">
            <article class="reports-dw-micro-card">
                <small>Artículos únicos</small>
                <strong>@TddUniqueArticleCount.ToString("N0")</strong>
                <span>Publicaciones registradas</span>
            </article>
            <article class="reports-dw-micro-card">
                <small>Filas reportables</small>
                <strong>@((Dashboard?.TddTotalArticles.Count ?? 0).ToString("N0"))</strong>
                <span>Indexación o pendiente</span>
            </article>
            <article class="reports-dw-micro-card">
                <small>Sin indexación</small>
                <strong>@TddMissingIndexingCount.ToString("N0")</strong>
                <span>Requieren completar base</span>
            </article>
            <article class="reports-dw-micro-card">
                <small>Facultades visibles</small>
                <strong>@((Dashboard?.TddTotalArticles.Select(x => x.Faculty).Distinct(StringComparer.OrdinalIgnoreCase).Count() ?? 0).ToString("N0"))</strong>
                <span>Con producción en el resultado</span>
            </article>
            <article class="reports-dw-micro-card">
                <small>Bases visibles</small>
                <strong>@((Dashboard?.TddTotalArticles.Select(x => x.IndexingSourceName).Distinct(StringComparer.OrdinalIgnoreCase).Count() ?? 0).ToString("N0"))</strong>
                <span>Indexaciones presentes</span>
            </article>
        </div>
        <div class="reports-dw-inline-note reports-dw-inline-note--soft">
            Las barras resumen filas reportables; un artículo puede aparecer más de una vez si está en varias bases.
        </div>
        <div class="reports-dw-bars reports-dw-bars--compact">
            @foreach (var item in (Dashboard?.TddTotalArticles ?? [])
                .GroupBy(x => string.IsNullOrWhiteSpace(x.Faculty) ? "Sin facultad" : x.Faculty)
                .Select(g => new { Name = g.Key, Total = g.Count() })
                .OrderByDescending(x => x.Total))
            {
                <div class="reports-dw-bar-row">
                    <span>@item.Name</span>
                    <div class="reports-dw-bar-track">
                        <div class="reports-dw-bar-fill reports-dw-bar-fill--sage" style="width:@GetBarWidth(item.Total, MaxTddFacultyCount)"></div>
                    </div>
                    <strong>@item.Total</strong>
                </div>
            }
        </div>
    }
    else
    {
        <div class="reports-dw-table-wrap">
            <table class="reports-dw-table">
                <thead>
                    <tr>
                        <th>Título de publicación</th>
                        <th>Base de datos</th>
                        <th class="reports-dw-col--mobile-hide">Revista / ISSN</th>
                        <th class="reports-dw-col--mobile-hide">Autor</th>
                        <th>Cuartil</th>
                        <th class="reports-dw-col--tablet-hide">Facultad</th>
                        <th class="reports-dw-col--mobile-hide">Resultado proyecto</th>
                        <th class="reports-dw-col--mobile-hide">Nombre proyecto</th>
                        <th class="reports-dw-col--mobile-hide">Mes</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var article in Dashboard!.TddTotalArticles)
                    {
                        <tr>
                            <td class="reports-dw-table-title">@article.Title</td>
                            <td><span class="reports-dw-pill reports-dw-pill--db">@article.IndexingSourceName</span></td>
                            <td class="reports-dw-col--mobile-hide">
                                <span>@article.VenueName</span>
                                <small>@(string.IsNullOrWhiteSpace(article.Issn) ? "Sin ISSN" : article.Issn)</small>
                            </td>
                            <td class="reports-dw-col--mobile-hide">
                                <span>@article.AuthorName</span>
                                <small>@article.ParticipantType</small>
                            </td>
                            <td><span class="reports-dw-pill reports-dw-pill--quartile">@article.Quartile</span></td>
                            <td class="reports-dw-col--tablet-hide">@article.Faculty</td>
                            <td class="reports-dw-col--mobile-hide"><span class="@(article.IsProjectResult ? "reports-dw-pill reports-dw-pill--yes" : "reports-dw-pill")">@(article.IsProjectResult ? "Sí" : "No")</span></td>
                            <td class="reports-dw-col--mobile-hide">@GetProjectNameLabel(article)</td>
                            <td class="reports-dw-col--mobile-hide">@article.PublicationMonth</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</article>

@code {
    [Parameter] public InstitutionalReportingDashboardDto? Dashboard { get; set; }
    [Parameter] public string ScopeLabel { get; set; } = "Vista general institucional";
    [Parameter] public string PediIiitScopeLabel { get; set; } = string.Empty;
    [Parameter] public string TddTotalScopeLabel { get; set; } = string.Empty;
    private string PediView { get; set; } = "summary";
    private string TddView { get; set; } = "summary";

    private bool HasSpecificSummaryTrim =>
        (Dashboard?.PediIiitArticles.Count ?? 0) > 20
        || (Dashboard?.TddTotalArticles.Count ?? 0) > 24;

    private int PediUniqueArticleCount => CountUniqueArticles(Dashboard?.PediIiitArticles);

    private int TddUniqueArticleCount => CountUniqueArticles(Dashboard?.TddTotalArticles);

    private int PediMissingIndexingCount => CountMissingIndexing(Dashboard?.PediIiitArticles);

    private int TddMissingIndexingCount => CountMissingIndexing(Dashboard?.TddTotalArticles);

    private int MaxPediQuartileCount =>
        Math.Max(1, Dashboard?.PediIiitArticles
            .GroupBy(x => string.IsNullOrWhiteSpace(x.Quartile) ? "Sin cuartil" : x.Quartile)
            .Select(g => g.Count())
            .DefaultIfEmpty(0)
            .Max() ?? 0);

    private int MaxTddFacultyCount =>
        Math.Max(1, Dashboard?.TddTotalArticles
            .GroupBy(x => string.IsNullOrWhiteSpace(x.Faculty) ? "Sin facultad" : x.Faculty)
            .Select(g => g.Count())
            .DefaultIfEmpty(0)
            .Max() ?? 0);

    private static string GetBarWidth(int value, int maxValue)
    {
        if (maxValue <= 0 || value <= 0)
        {
            return "0%";
        }

        var percent = Math.Clamp((value / (double)maxValue) * 100, 4, 100);
        return $"{percent:0.##}%";
    }

    private static string GetProjectNameLabel(ReportingArticleIndexingDetailDto article)
        => article.IsProjectResult
            ? string.IsNullOrWhiteSpace(article.ProjectName) ? "Sin registrar" : article.ProjectName
            : "-";

    private static int CountUniqueArticles(IEnumerable<ReportingArticleIndexingDetailDto>? articles)
        => articles?
            .Select(x => x.ArticleId)
            .Where(x => x > 0)
            .Distinct()
            .Count() ?? 0;

    private static int CountMissingIndexing(IEnumerable<ReportingArticleIndexingDetailDto>? articles)
        => articles?.Count(x => string.Equals(x.IndexingSourceName, "Sin indexación", StringComparison.OrdinalIgnoreCase)) ?? 0;
}
