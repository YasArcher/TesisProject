@using tesisproject.shared.DTOs.Reports

<div id="reports-block-workflow" class="reports-dw-section-heading reports-dw-section-heading--workflow">
    <span><i class="bi bi-signpost-split"></i></span>
    <div>
        <small>Bloque 04</small>
        <h2>Seguimiento del flujo y detalle consultable</h2>
        <p>Seguimiento de revisión, revistas con métricas y artículos recientes que componen el filtro actual.</p>
    </div>
</div>

<article class="reports-dw-chart-card">
    <ReportCardHeader IconClass="bi bi-signpost"
                      Title="Revisión reciente"
                      Description="Últimos procesos de revisión visibles en la reportería." />

    @if ((Dashboard?.WorkflowCurrentStages.Count ?? 0) == 0)
    {
        <ReportEmptyState Title="Sin procesos de revisión"
                          Message="No existen procesos de revisión visibles para los filtros actuales."
                          IconClass="bi bi-signpost-split" />
    }
    else
    {
        <div class="reports-dw-workflow-list">
            @foreach (var item in Dashboard!.WorkflowCurrentStages.Take(6))
            {
                <div class="reports-dw-workflow-item">
                    <strong>Lote @item.BatchId</strong>
                    <span>@item.StageName · @(item.StageStatus ?? "Sin estado")</span>
                </div>
            }
        </div>
    }
</article>

<article class="reports-dw-chart-card reports-dw-chart-card--wide">
    <ReportCardHeader IconClass="bi bi-building"
                      Title="Revistas y métricas recientes"
                      Description="Artículos por revista académica, con SJR, CiteScore, HIndex y cuartil disponibles." />
    <div class="reports-dw-table-wrap">
        @if ((Dashboard?.ArticlesByVenue.Count ?? 0) == 0)
        {
            <ReportEmptyState Title="Sin revistas para mostrar"
                              Message="No hay revistas académicas vinculadas a los artículos filtrados."
                              IconClass="bi bi-building-x" />
        }
        else
        {
            <table class="reports-dw-table">
                <thead>
                    <tr>
                        <th>Revista</th>
                        <th>Tipo</th>
                        <th>Artículos</th>
                        <th>Métricas recientes</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var venue in Dashboard?.ArticlesByVenue.Take(8) ?? [])
                    {
                        var metric = Dashboard?.VenueMetricsByYear.FirstOrDefault(x => x.VenueName == venue.VenueName);
                        <tr>
                            <td>@venue.VenueName</td>
                            <td>@venue.VenueType</td>
                            <td>@venue.TotalArticles</td>
                            <td>
                                @if (metric is null)
                                {
                                    <span>Sin métricas</span>
                                }
                                else
                                {
                                    <span>@metric.Year · @(metric.Quartile ?? "S/C") · SJR @metric.Sjr · CiteScore @metric.CiteScore · H @metric.HIndex</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</article>

<article class="reports-dw-chart-card reports-dw-chart-card--wide">
    <ReportCardHeader IconClass="bi bi-journal-richtext"
                      Title="Artículos recientes filtrados"
                      Description="Vista informativa de los artículos incluidos en el reporte actual." />
    <div class="reports-dw-table-wrap">
        @if ((Dashboard?.RecentArticles.Count ?? 0) == 0)
        {
            <ReportEmptyState Title="Sin artículos recientes"
                              Message="No hay artículos recientes para el filtro actual."
                              IconClass="bi bi-journal-x" />
        }
        else
        {
            <table class="reports-dw-table">
                <thead>
                    <tr>
                        <th>Título</th>
                        <th>Año</th>
                        <th>Estado</th>
                        <th>Línea</th>
                        <th>Revista</th>
                        <th>OA</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var article in Dashboard?.RecentArticles.Take(12) ?? [])
                    {
                        <tr>
                            <td>@article.Title</td>
                            <td>@article.Year</td>
                            <td>@(article.PublicationStatus ?? "Sin estado")</td>
                            <td>@(article.ResearchLine ?? "Sin línea")</td>
                            <td>@(article.VenueName ?? "Sin revista")</td>
                            <td>@(article.IsOpenAccess ? "Sí" : "No")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</article>

@code {
    [Parameter] public InstitutionalReportingDashboardDto? Dashboard { get; set; }
}
