@if (Visible)
{
    <div class="reports-pdf-modal fixed inset-0 z-40 flex items-center justify-center bg-black/40">
        <div class="reports-pdf-modal__surface reports-pdf-preview-shell bg-white rounded-2xl shadow-xl w-[90vw] h-[90vh] max-w-5xl flex flex-col overflow-hidden">
            <div class="reports-pdf-preview-header">
                <div class="reports-pdf-preview-title">
                    <span><i class="bi bi-file-earmark-pdf"></i></span>
                    <div>
                        <strong>Previsualización de reporte PDF</strong>
                        <small>Vista previa institucional según los filtros actuales.</small>
                    </div>
                </div>
                <div class="flex items-center gap-2">
                    @if (!string.IsNullOrEmpty(PdfPreviewDataUrl))
                    {
                        <a href="@PdfPreviewDataUrl"
                           download="@DownloadFileName"
                           class="reports-pdf-preview-download">
                            <i class="bi bi-download"></i>
                            Descargar
                        </a>
                    }
                    <button type="button"
                            class="reports-pdf-preview-close"
                            @onclick="OnClose">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
            </div>

            <div class="reports-pdf-preview-body flex-1 bg-slate-100">
                @if (IsGenerating || string.IsNullOrEmpty(PdfPreviewDataUrl))
                {
                    <div class="reports-pdf-preview-loading">
                        <span><i class="bi bi-file-earmark-arrow-down"></i></span>
                        <strong>Preparando el reporte</strong>
                        <small>Estamos generando una vista previa con la información filtrada.</small>
                    </div>
                }
                else
                {
                    <iframe src="@PdfPreviewDataUrl"
                            class="w-full h-full border-0"></iframe>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public bool IsGenerating { get; set; }
    [Parameter] public string? PdfPreviewDataUrl { get; set; }
    [Parameter] public string DownloadFileName { get; set; } = "Reporte_Estadistico_Articulos.pdf";
    [Parameter] public EventCallback OnClose { get; set; }
}
