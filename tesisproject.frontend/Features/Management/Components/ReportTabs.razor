<div class="reports-tabs mb-4 border-b border-slate-200">
    <nav class="flex gap-2 text-sm">
        <button type="button"
                class="@GetTabButtonClass("dashboard")"
                @onclick="OnDashboardSelected">
            Resumen gráfico
        </button>

        <button type="button"
                class="@GetTabButtonClass("detail")"
                @onclick="OnDetailSelected">
            Vista detallada (tabla)
        </button>
    </nav>
</div>

@code {
    [Parameter] public string ActiveTab { get; set; } = "dashboard";
    [Parameter] public EventCallback OnDashboardSelected { get; set; }
    [Parameter] public EventCallback OnDetailSelected { get; set; }

    private string GetTabButtonClass(string tabKey)
        => string.Equals(ActiveTab, tabKey, StringComparison.OrdinalIgnoreCase)
            ? "rounded-full bg-[#313647] px-4 py-2 text-sm font-semibold text-[#fff8d4] shadow-sm"
            : "rounded-full border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50";
}
