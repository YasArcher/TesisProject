<section class="reports-dw-filter-summary">
    <div class="reports-dw-filter-summary__title">
        <span><i class="bi bi-funnel"></i></span>
        <div>
            <strong>Filtros activos</strong>
            <small>@SummaryLabel</small>
        </div>
    </div>

    @if (Chips.Count == 0)
    {
        <div class="reports-dw-filter-summary__empty">
            <i class="bi bi-check2-circle"></i>
            Consolidado institucional completo
        </div>
    }
    else
    {
        <div class="reports-dw-filter-chips">
            @foreach (var chip in Chips)
            {
                <span>
                    <small>@chip.Label</small>
                    <strong>@chip.Value</strong>
                </span>
            }
        </div>
    }
</section>

@code {
    [Parameter] public IReadOnlyList<(string Label, string Value)> Chips { get; set; } = Array.Empty<(string Label, string Value)>();
    [Parameter] public string SummaryLabel { get; set; } = "Sin segmentación adicional";
}
