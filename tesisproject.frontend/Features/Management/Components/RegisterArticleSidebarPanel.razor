@using tesisproject.frontend.Features.Management.Components

<aside class="space-y-4 xl:sticky xl:top-4 xl:max-h-[calc(100vh-2rem)] xl:self-start xl:overflow-y-auto">
    <section class="rounded-[1.8rem] border border-[#d9e5e8] bg-gradient-to-br from-[#f7fbfc] via-white to-[#fff8ef] shadow-sm shadow-slate-200/50" id="save-panel">
        <header class="border-b bg-gradient-to-r from-[#12343b] to-[#2f4858] px-4 py-4 text-white">
            <div class="flex items-center justify-between gap-3">
                <div>
                    <h2 class="text-base font-bold">Registro del artículo</h2>
                </div>
                <span class="rounded-full bg-white/10 px-3 py-1 text-xs font-semibold">@(IsSaving ? "Guardando" : "Edición activa")</span>
            </div>
        </header>
        <div class="space-y-3 px-4 py-4 text-sm">
            <div class="grid grid-cols-2 gap-2">
                <button class="rounded-xl border border-rose-200 bg-rose-50 px-3 py-2 text-sm font-semibold text-rose-700" @onclick="OnCancel">Cancelar</button>
                <button class="rounded-xl bg-gradient-to-r from-[#12343b] to-[#2f4858] px-3 py-2 text-sm font-semibold text-white shadow-md disabled:opacity-60"
                        disabled="@IsSaving"
                        @onclick="OnSave">
                    @(IsSaving ? "Guardando..." : "Registrar")
                </button>
                <button class="rounded-xl border border-emerald-200 bg-emerald-50 px-3 py-2 text-sm font-semibold text-emerald-700 disabled:opacity-60"
                        disabled="@IsSaving"
                        @onclick="OnSubmitForReview">
                    @(IsSaving ? "Enviando..." : "Enviar a revisión")
                </button>
                <button class="rounded-xl border border-sky-200 bg-sky-50 px-3 py-2 text-sm font-semibold text-sky-700" @onclick="OnReload">Recargar</button>
                <button class="rounded-xl border border-[#ead8bd] bg-[#fff7eb] px-3 py-2 text-sm font-semibold text-[#8b5a16]" @onclick="OnBack">Volver</button>
            </div>

            <div class="grid grid-cols-2 gap-3">
                <div class="rounded-2xl bg-[#eef5f6] px-4 py-3">
                    <div class="text-xs uppercase tracking-wide text-slate-500">Campos</div>
                    <div class="mt-1 text-lg font-black text-[#2f4858]">@VisibleFieldCount</div>
                </div>
                <div class="rounded-2xl bg-[#fff4e4] px-4 py-3">
                    <div class="text-xs uppercase tracking-wide text-slate-500">Registrados</div>
                    <div class="mt-1 text-lg font-black text-[#c17c2f]">@CompletedFieldCount</div>
                </div>
            </div>
            <div class="grid grid-cols-2 gap-3">
                <div class="rounded-2xl border border-[#d9e5e8] bg-white px-4 py-3">
                    <div class="text-xs uppercase tracking-wide text-slate-500">Obligatorios pendientes</div>
                    <div class="mt-1 text-lg font-black text-[#b45309]">@MissingRequiredCount</div>
                </div>
                <div class="rounded-2xl border border-[#d9e5e8] bg-white px-4 py-3">
                    <div class="text-xs uppercase tracking-wide text-slate-500">Participantes</div>
                    <div class="mt-1 text-lg font-black text-[#12343b]">@ParticipantsCount</div>
                </div>
            </div>
            <div class="rounded-2xl bg-[#f4f8f9] px-4 py-3">
                <div class="text-xs uppercase tracking-wide text-slate-500">Formulario</div>
                <div class="mt-1 font-semibold text-[#12343b]">@FormName</div>
                <div class="mt-1 text-xs text-slate-500">@ArticleSectionsCount secciones activas</div>
            </div>
            <div class="rounded-2xl bg-gradient-to-br from-[#12343b] to-[#2f4858] px-4 py-4 text-white">
                <div class="text-xs uppercase tracking-[0.25em] text-white/70">Vista previa</div>
                <div class="mt-2 text-base font-bold">@PreviewTitle</div>
                <div class="mt-3 space-y-2 text-xs text-white/80">
                    @if (ParticipantNames.Any())
                    {
                        @foreach (var name in ParticipantNames)
                        {
                            <div class="rounded-xl bg-white/10 px-3 py-2">@name</div>
                        }
                    }
                    else
                    {
                        <div class="rounded-xl bg-white/10 px-3 py-2">Sin participantes con nombre todavía.</div>
                    }
                </div>
            </div>
            <div class="rounded-2xl border border-[#d9e5e8] bg-[#fafcfd] px-4 py-4">
                <div class="text-xs uppercase tracking-[0.25em] text-slate-500">Estado del registro</div>
                <div class="mt-3 space-y-2 text-sm">
                    <div class="flex items-center justify-between rounded-xl bg-white px-3 py-2">
                        <span class="text-slate-600">Artículo</span>
                        <span class="font-semibold text-[#12343b]">@ArticleCompletionLabel</span>
                    </div>
                    <div class="flex items-center justify-between rounded-xl bg-white px-3 py-2">
                        <span class="text-slate-600">Participantes</span>
                        <span class="font-semibold text-[#12343b]">@ParticipantsCompletionSummary</span>
                    </div>
                </div>
            </div>
            <div class="rounded-2xl border border-[#d9e5e8] bg-[#fafcfd] px-4 py-4">
                <div class="text-xs uppercase tracking-[0.25em] text-slate-500">Accesos rápidos</div>
                <div class="app-chip-row mt-3">
                    @foreach (var item in QuickAccessItems)
                    {
                        @if (item.IsButton)
                        {
                            <button type="button"
                                    class="@GetChipClass(item)"
                                    @onclick="() => HandleQuickActionAsync(item.Target)">
                                @item.Label
                            </button>
                        }
                        else
                        {
                            <a class="@GetChipClass(item)" href="#@item.Target">@item.Label</a>
                        }
                    }
                </div>
            </div>
        </div>
    </section>
</aside>

@code {
    [Parameter] public bool IsSaving { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback OnSubmitForReview { get; set; }
    [Parameter] public EventCallback OnReload { get; set; }
    [Parameter] public EventCallback OnBack { get; set; }
    [Parameter] public int VisibleFieldCount { get; set; }
    [Parameter] public int CompletedFieldCount { get; set; }
    [Parameter] public int MissingRequiredCount { get; set; }
    [Parameter] public int ParticipantsCount { get; set; }
    [Parameter] public string FormName { get; set; } = "Sin formulario";
    [Parameter] public int ArticleSectionsCount { get; set; }
    [Parameter] public string PreviewTitle { get; set; } = string.Empty;
    [Parameter] public IReadOnlyList<string> ParticipantNames { get; set; } = [];
    [Parameter] public string ArticleCompletionLabel { get; set; } = string.Empty;
    [Parameter] public string ParticipantsCompletionSummary { get; set; } = string.Empty;
    [Parameter] public IReadOnlyList<RegisterArticleQuickAccessItem> QuickAccessItems { get; set; } = [];
    [Parameter] public EventCallback<string> OnQuickAction { get; set; }

    private static string GetChipClass(RegisterArticleQuickAccessItem item)
        => item.IsWarmAccent
            ? "rounded-full bg-[#fff1d6] px-3 py-1.5 text-xs font-semibold text-[#8b5a16]"
            : "rounded-full bg-[#eef5f6] px-3 py-1.5 text-xs font-semibold text-[#12343b]";

    private Task HandleQuickActionAsync(string target)
        => OnQuickAction.InvokeAsync(target);
}
