@using tesisproject.frontend.Features.Management.Components

<div class="mb-5 rounded-[1.8rem] border border-[#d7e1e4] bg-gradient-to-br from-[#f3f8f9] via-white to-[#fff9f0] p-4 shadow-sm">
    <div class="grid grid-cols-1 gap-3 xl:grid-cols-[1.25fr_0.75fr]">
        <div class="space-y-3">
            <div class="grid grid-cols-2 gap-3">
                <div class="rounded-2xl border border-[#d9e5e8] bg-white/90 px-4 py-3 shadow-sm">
                    <div class="text-[11px] uppercase tracking-[0.18em] text-slate-500">Secciones activas</div>
                    <div class="mt-1 text-lg font-black text-[#12343b]">@ArticleSectionsCount</div>
                    <div class="text-xs text-slate-500">formulario: @FormName</div>
                </div>
                <div class="rounded-2xl border border-[#d9e5e8] bg-white/90 px-4 py-3 shadow-sm">
                    <div class="text-[11px] uppercase tracking-[0.18em] text-slate-500">Campos visibles</div>
                    <div class="mt-1 text-lg font-black text-[#12343b]">@VisibleFieldCount</div>
                    <div class="text-xs text-slate-500">entre artículo y participantes</div>
                </div>
                <div class="rounded-2xl border border-[#e8d2ac] bg-[#fffaf2] px-4 py-3 shadow-sm">
                    <div class="text-[11px] uppercase tracking-[0.18em] text-slate-500">Capturados</div>
                    <div class="mt-1 text-lg font-black text-[#8b5a16]">@CompletedFieldCount</div>
                    <div class="text-xs text-slate-500">campos con valor registrado</div>
                </div>
                <div class="rounded-2xl border border-[#ead8bd] bg-[#fffdf8] px-4 py-3 shadow-sm">
                    <div class="text-[11px] uppercase tracking-[0.18em] text-slate-500">Pendientes</div>
                    <div class="mt-1 text-lg font-black text-[#c17c2f]">@MissingRequiredCount</div>
                    <div class="text-xs text-slate-500">obligatorios aún por completar</div>
                </div>
            </div>

            <div class="rounded-2xl border border-[#cfe0e4] bg-gradient-to-r from-[#eef5f6] to-white p-3">
                <div class="mb-2 flex items-center justify-between gap-3">
                    <div>
                        <div class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Explorador del formulario</div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(SectionSearchTerm))
                    {
                        <button class="rounded-xl border border-[#c9d7db] bg-white px-3 py-2 text-xs font-semibold text-[#12343b]" @onclick="OnClearSearch">Limpiar</button>
                    }
                </div>
                <div class="flex flex-col gap-3 lg:flex-row">
                    <input class="w-full rounded-xl border border-[#c9d7db] bg-white px-3 py-2.5 text-sm shadow-sm"
                           placeholder="Buscar sección o campo"
                           value="@SectionSearchTerm"
                           @oninput="OnSearchInputChanged" />
                    <button class="rounded-xl border border-[#c9d7db] bg-white px-4 py-2 text-sm font-semibold text-[#12343b]" @onclick="OnExpandAll">Expandir</button>
                    <button class="rounded-xl border border-[#c9d7db] bg-white px-4 py-2 text-sm font-semibold text-[#12343b]" @onclick="OnCollapseAll">Contraer</button>
                </div>
                <div class="mt-3 flex flex-wrap gap-2 text-xs">
                    <span class="rounded-full bg-white px-3 py-1.5 font-semibold text-[#12343b]">@VisibleSectionsCount secciones visibles</span>
                    <span class="rounded-full bg-white px-3 py-1.5 font-semibold text-[#2f4858]">@ArticleOnlyVisibleFieldCount campos de artículo</span>
                    <span class="rounded-full bg-[#fff4e4] px-3 py-1.5 font-semibold text-[#8b5a16]">@ParticipantsCount participante(s)</span>
                </div>
            </div>
        </div>
        <div class="grid grid-cols-1 gap-2 sm:grid-cols-2 xl:grid-cols-1">
            <button class="rounded-2xl border border-[#d9e5e8] bg-white/90 px-4 py-3 text-left shadow-sm transition hover:border-[#8cb0b8]" @onclick="OnGoToConfiguration">
                <div class="text-xs uppercase tracking-[0.16em] text-slate-500">Configuración</div>
                <div class="mt-1 text-sm font-bold text-[#12343b]">Campos y formularios</div>
            </button>
            <button class="rounded-2xl border border-[#ead8bd] bg-[#fffdf8] px-4 py-3 text-left shadow-sm transition hover:border-[#d9ba86]" @onclick="OnGoToBulkImport">
                <div class="text-xs uppercase tracking-[0.16em] text-slate-500">Registro en masa</div>
                <div class="mt-1 text-sm font-bold text-[#8b5a16]">Abrir matriz del autor</div>
            </button>
            <button class="rounded-2xl border border-[#d9e5e8] bg-white/90 px-4 py-3 text-left shadow-sm transition hover:border-[#8cb0b8] sm:col-span-2 xl:col-span-1" @onclick="OnGoToArticlesList">
                <div class="text-xs uppercase tracking-[0.16em] text-slate-500">Listado</div>
                <div class="mt-1 text-sm font-bold text-[#12343b]">Volver a artículos</div>
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter] public int ArticleSectionsCount { get; set; }
    [Parameter] public string FormName { get; set; } = "Sin formulario";
    [Parameter] public int VisibleFieldCount { get; set; }
    [Parameter] public int CompletedFieldCount { get; set; }
    [Parameter] public int MissingRequiredCount { get; set; }
    [Parameter] public string SectionSearchTerm { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> SectionSearchTermChanged { get; set; }
    [Parameter] public EventCallback OnClearSearch { get; set; }
    [Parameter] public EventCallback OnExpandAll { get; set; }
    [Parameter] public EventCallback OnCollapseAll { get; set; }
    [Parameter] public int VisibleSectionsCount { get; set; }
    [Parameter] public int ArticleOnlyVisibleFieldCount { get; set; }
    [Parameter] public int ParticipantsCount { get; set; }
    [Parameter] public EventCallback OnGoToConfiguration { get; set; }
    [Parameter] public EventCallback OnGoToBulkImport { get; set; }
    [Parameter] public EventCallback OnGoToArticlesList { get; set; }

    private Task OnSearchInputChanged(ChangeEventArgs args)
        => SectionSearchTermChanged.InvokeAsync(Convert.ToString(args.Value) ?? string.Empty);
}
