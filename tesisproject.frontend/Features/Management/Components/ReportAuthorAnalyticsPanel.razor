    private void ClearPublicationFilters()
    {
        _selectedPublicationSource = null;
        _selectedPublicationQuartile = null;
        _selectedPublicationRole = null;
    }

    private void ClearSelectedCoauthor()
    {
        _selectedCoauthorKey = null;
    }

    private void FocusSelectedCoauthorAsAuthor()
    {
        if (SelectedCoauthor is not null)
        {
            FocusAuthor(SelectedCoauthor.CoauthorKey);
        }
    }

    private bool CanFocusCoauthor(int coauthorKey) =>
        Dashboard?.Authors.Any(x => x.AuthorKey == coauthorKey) == true;

    private void FocusAuthor(int authorKey)
    {
        if (!CanFocusCoauthor(authorKey))
        {
            return;
        }

        _selectedAuthorKey = authorKey;
        _selectedCoauthorKey = null;
        ClearPublicationFilters();
        AuthorSpotlightView = "summary";
    }

    private static ReportBarItem ToBarItem(ReportingSummaryItemDto item)
        => new(item.Name, item.TotalArticles, item.Name);

    private static IReadOnlyList<AuthorPublicationDto> DeduplicateAuthorPublications(IEnumerable<AuthorPublicationDto> publications)
    {
        return publications
            .GroupBy(x => x.ArticleId)
            .Select(g => g
                .OrderByDescending(x => x.IsPrimaryAuthor)
                .ThenByDescending(x => x.PublishedDate ?? x.CreatedDate)
                .ThenBy(x => x.Title)
                .First())
            .ToList();
    }

    private IEnumerable<AuthorPublicationDto> ApplyPublicationSort(IEnumerable<AuthorPublicationDto> publications)
    {
        return _selectedPublicationSort switch
        {
            "oldest" => publications
                .OrderBy(x => x.PublishedDate ?? x.CreatedDate)
                .ThenBy(x => x.Title),
            "quartile" => publications
                .OrderBy(x => NormalizeValue(x.Quartile, "Sin cuartil"))
                .ThenByDescending(x => x.PublishedDate ?? x.CreatedDate)
                .ThenBy(x => x.Title),
            "source" => publications
                .OrderBy(x => NormalizeValue(x.IndexingSourceName, "Sin base"))
                .ThenByDescending(x => x.PublishedDate ?? x.CreatedDate)
                .ThenBy(x => x.Title),
            "venue" => publications
                .OrderBy(x => NormalizeValue(x.VenueName, "Sin revista"))
                .ThenByDescending(x => x.PublishedDate ?? x.CreatedDate)
                .ThenBy(x => x.Title),
            _ => publications
                .OrderByDescending(x => x.PublishedDate ?? x.CreatedDate)
                .ThenBy(x => x.Title)
        };
    }

    private IEnumerable<AuthorCoauthorDto> ApplyCoauthorSort(IEnumerable<AuthorCoauthorDto> coauthors)
    {
        return _selectedCoauthorSort switch
        {
            "name" => coauthors
                .OrderBy(x => x.CoauthorName)
                .ThenByDescending(x => x.SharedArticles),
            "affiliation" => coauthors
                .OrderBy(x => NormalizeValue(x.CoauthorAffiliation, "Sin filiación"))
                .ThenBy(x => x.CoauthorName)
                .ThenByDescending(x => x.SharedArticles),
            _ => coauthors
                .OrderByDescending(x => x.SharedArticles)
                .ThenBy(x => x.CoauthorName)
        };
    }

    private bool MatchesSelectedPublicationSource(AuthorPublicationDto publication) =>
        string.IsNullOrWhiteSpace(_selectedPublicationSource)
        || NormalizeValue(publication.IndexingSourceName, string.Empty)
            .Equals(_selectedPublicationSource, StringComparison.OrdinalIgnoreCase);

    private bool MatchesSelectedPublicationQuartile(AuthorPublicationDto publication) =>
        string.IsNullOrWhiteSpace(_selectedPublicationQuartile)
        || NormalizeValue(publication.Quartile, string.Empty)
            .Equals(_selectedPublicationQuartile, StringComparison.OrdinalIgnoreCase);

    private bool MatchesSelectedPublicationRole(AuthorPublicationDto publication) =>
        string.IsNullOrWhiteSpace(_selectedPublicationRole)
        || (_selectedPublicationRole.Equals("primary", StringComparison.OrdinalIgnoreCase) && publication.IsPrimaryAuthor)
        || (_selectedPublicationRole.Equals("coauthor", StringComparison.OrdinalIgnoreCase) && !publication.IsPrimaryAuthor);

    private bool MatchesTimelineRange(AuthorPublicationDto publication)
    {
        if (_selectedTimelineRange.Equals("all", StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        var referenceDate = publication.PublishedDate ?? publication.CreatedDate;
        if (!referenceDate.HasValue)
        {
            return false;
        }

        var months = _selectedTimelineRange.Equals("12m", StringComparison.OrdinalIgnoreCase) ? -12 : -24;
        return referenceDate.Value >= DateTime.Today.AddMonths(months);
    }

    private static bool IsRecentPublication(AuthorPublicationDto publication)
    {
        var referenceDate = publication.PublishedDate ?? publication.CreatedDate;
        if (!referenceDate.HasValue)
        {
            return false;
        }

        return referenceDate.Value >= DateTime.Today.AddMonths(-24);
    }

    private static string GetDominantPublicationValue(
        IEnumerable<AuthorPublicationDto> publications,
        Func<AuthorPublicationDto, string> selector,
        string fallback)
    {
        return publications
            .Select(selector)
            .Select(x => NormalizeValue(x, string.Empty))
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .GroupBy(x => x, StringComparer.OrdinalIgnoreCase)
            .OrderByDescending(g => g.Count())
            .ThenBy(g => g.Key)
            .Select(g => g.Key)
            .FirstOrDefault() ?? fallback;
    }

    private static string NormalizeValue(string? value, string fallback) =>
        string.IsNullOrWhiteSpace(value) ? fallback : value.Trim();

    private static string GetBarWidth(int value, int maxValue)
    {
        if (maxValue <= 0 || value <= 0)
        {
            return "0%";
        }

        var percent = Math.Clamp((value / (double)maxValue) * 100, 4, 100);
        return $"{percent:0.##}%";
    }

    private static string Shorten(string? text, int maxLength)
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            return "Sin dato";
        }

        var value = text.Trim();
        return value.Length <= maxLength ? value : $"{value[..Math.Max(0, maxLength - 1)]}...";
    }
