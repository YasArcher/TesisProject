        _selectedPublicationQuartile = string.IsNullOrWhiteSpace(raw) ? null : raw.Trim();
    }

    private void OnSelectedPublicationRoleChanged(ChangeEventArgs args)
    {
        var raw = args.Value?.ToString();
        _selectedPublicationRole = string.IsNullOrWhiteSpace(raw) ? null : raw.Trim();
    }

    private void OnSelectedPublicationSortChanged(ChangeEventArgs args)
    {
        var raw = args.Value?.ToString();
        _selectedPublicationSort = string.IsNullOrWhiteSpace(raw) ? "recent" : raw.Trim();
    }

    private void OnSelectedCoauthorSortChanged(ChangeEventArgs args)
    {
        var raw = args.Value?.ToString();
        _selectedCoauthorSort = string.IsNullOrWhiteSpace(raw) ? "shared" : raw.Trim();
    }

    private void OnSelectedTimelineRangeChanged(ChangeEventArgs args)
