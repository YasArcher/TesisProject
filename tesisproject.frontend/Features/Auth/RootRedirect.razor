@page "/"
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider

@code {
    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var target = authState.User.Identity?.IsAuthenticated == true
            ? ResolveHome(authState.User)
            : "/login";

        Nav.NavigateTo(target, forceLoad: false);
    }

    private static string ResolveHome(System.Security.Claims.ClaimsPrincipal user)
    {
        if (CanSeePrincipalPanel(user))
        {
            return "/panel/principal";
        }

        if (user.IsInRole("Author") || user.IsInRole("ArticleRegistrationUser") || user.IsInRole("WorkflowTrackingUser"))
        {
            return "/management/author-workspace";
        }

        if (user.IsInRole("ExternalApiUser"))
        {
            return "/management/externalapis";
        }

        return "/perfilview";
    }

    private static bool CanSeePrincipalPanel(System.Security.Claims.ClaimsPrincipal user)
        => user.IsInRole("Admin")
           || user.IsInRole("Analyst")
           || user.IsInRole("WorkflowReviewerUodide")
           || user.IsInRole("WorkflowReviewerAreaTecnica")
           || user.IsInRole("WorkflowProcessorAreaTecnica")
           || user.IsInRole("ReportingViewer")
           || user.IsInRole("ReportingExporter")
           || user.IsInRole("ReportingAdvancedUser")
           || user.IsInRole("IntelligenceViewer")
           || user.IsInRole("IntelligenceTrainer");
}
