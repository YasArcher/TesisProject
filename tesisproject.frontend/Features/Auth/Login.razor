@page "/login"
@attribute [AllowAnonymous]
@layout tesisproject.frontend.Features.Management.Layout.AuthLayout

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using tesisproject.frontend.Services.Interfaces
@using tesisproject.shared.DTOs.Auth
@inject NavigationManager Nav
@inject IAuthClient Auth
@inject AuthenticationStateProvider AuthStateProvider
@inject Blazored.Toast.Services.IToastService Toast

<PageTitle>Ingreso institucional</PageTitle>

<div class="login-card">
    <div class="login-card__brand">
        <img src="/images/logo-uta.png" alt="Universidad Técnica de Ambato" class="login-card__brand-logo" />
        <div>
            <div class="login-card__brand-kicker">UTA</div>
            <div class="login-card__brand-title">Acceso institucional</div>
        </div>
    </div>

    <div class="login-card__header">
        <h1>Inicia sesión</h1>
        <p>Usa tus credenciales para ingresar al sistema y acceder al panel correspondiente a tu rol.</p>
    </div>

    <EditForm Model="_model" OnValidSubmit="HandleLogin">
        <DataAnnotationsValidator />
        <ValidationSummary class="login-card__validation" />

        <div class="login-card__field">
            <label>Correo institucional</label>
            <div class="login-card__input-shell">
                <span class="login-card__input-icon">✉</span>
                <InputText
                    @bind-Value="_model.Email"
                    class="login-card__input"
                    placeholder="usuario@uta.edu.ec" />
            </div>
        </div>

        <div class="login-card__field">
            <label>Contraseña</label>
            <div class="login-card__input-shell">
                <span class="login-card__input-icon">🔒</span>
                <InputText
                    @bind-Value="_model.Password"
                    type="@(ShowPassword ? "text" : "password")"
                    class="login-card__input login-card__input--password"
                    placeholder="Ingresa tu contraseña" />
                <button type="button" class="login-card__toggle" @onclick="TogglePassword">
                    @(ShowPassword ? "Ocultar" : "Ver")
                </button>
            </div>
        </div>

        <div class="login-card__meta">
            <span>Acceso protegido con JWT</span>
            <span>Sesión institucional</span>
        </div>

        <button class="login-card__submit" disabled="@_busy">
            @if (_busy)
            {
                <span>Ingresando…</span>
            }
            else
            {
                <span>Ingresar al sistema</span>
            }
        </button>
    </EditForm>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="login-card__error">@_error</div>
    }
</div>

@code {
    private LoginVm _model = new();
    private bool _busy;
    private bool ShowPassword { get; set; }
    private string? _error;

    private async Task HandleLogin()
    {
        _error = null;
        _busy = true;
        try
        {
            var res = await Auth.LoginAsync(new LoguinRequest(_model.Email, _model.Password));
            if (res is null || string.IsNullOrWhiteSpace(res.AccessToken))
            {
                _error = "No pude iniciar sesión con esas credenciales.";
                Toast.ShowError(_error);
                return;
            }

            if (AuthStateProvider is JwtAuthStateProvider jwt)
            {
                jwt.NotifyUserChanged();
            }

            await Task.Yield();
            Nav.NavigateTo("/panel/principal", forceLoad: false);
        }
        catch
        {
            _error = "No se pudo contactar al servidor de autenticación.";
            Toast.ShowError(_error);
        }
        finally
        {
            _busy = false;
        }
    }

    private void TogglePassword()
    {
        ShowPassword = !ShowPassword;
    }

    public class LoginVm
    {
        [Required, EmailAddress] public string Email { get; set; } = "";
        [Required, MinLength(6)] public string Password { get; set; } = "";
    }
}
