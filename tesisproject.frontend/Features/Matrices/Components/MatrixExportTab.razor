        {
            return new ExportTemplateCreateRequestDTO
            {
                Key = Key.Trim(),
                Name = Name.Trim(),
                TargetSystem = TargetSystem,
                Version = Version,
                IsDefault = IsDefault,
                IsActive = IsActive,
                Columns = Columns
                    .OrderBy(c => c.OrderIndex)
                    .Select(c => new ExportTemplateColumnUpsertDTO
                    {
                        FieldId = c.FieldId,
                        TargetHeader = c.TargetHeader,
                        OrderIndex = c.OrderIndex,
                        IsRequired = c.IsRequired,
