@page "/articulos/listado"
@attribute [Authorize]

@using System.Linq
@using tesisproject.shared.DTOs.Articles
@using tesisproject.frontend.Services.Interfaces
@using tesisproject.frontend.Features.Articles.Components
@using tesisproject.frontend.SharedUI
@using tesisproject.frontend.SharedUI.ConfirmDialog

@inject IArticlesClient ArticlesClient
@inject NavigationManager Nav

<PageTitle>Artículos registrados</PageTitle>

<div class="article-list-page min-h-[calc(100vh-80px)]">
    <div class="mx-auto max-w-[1400px] px-4 pb-10 pt-4">

        <section class="article-list-hero mb-5">
            <div class="article-list-hero__content">
                <div class="article-list-hero__icon">
                    <i class="bi bi-journal-text"></i>
                </div>
                <div>
                    <div class="text-xs font-semibold uppercase tracking-[0.24em] text-white/70">Repositorio institucional</div>
                    <h1 class="mt-1 text-2xl font-black tracking-tight text-white md:text-3xl">
                        Artículos registrados
                    </h1>
                    <p class="mt-2 max-w-3xl text-sm leading-6 text-white/78">
                        Consulta, filtra y administra los artículos almacenados en la DIDE con una vista clara para revisión operativa.
                    </p>
                </div>
            </div>

            @if (!_isLoading && _allArticles.Any())
            {
                <div class="article-list-kpis">
                    <div class="article-list-kpi">
                        <span>Total filtrados</span>
                        <strong>@_filteredArticles.Count</strong>
                        <small>De @_allArticles.Count registros</small>
                    </div>
                    <div class="article-list-kpi article-list-kpi--gold">
                        <span>Publicados</span>
                        <strong>@_allArticles.Count(a => GetStatusKey(a) == "PUBLICADO")</strong>
                        <small>Estado final</small>
                    </div>
                    <div class="article-list-kpi article-list-kpi--sage">
                        <span>Aceptados</span>
                        <strong>@_allArticles.Count(a => GetStatusKey(a) == "ACEPTADO")</strong>
                        <small>Previo a publicación</small>
                    </div>
                    <div class="article-list-kpi article-list-kpi--muted">
                        <span>Sin estado</span>
                        <strong>@_allArticles.Count(a => GetStatusKey(a) == "SIN ESTADO")</strong>
                        <small>Por clasificar</small>
                    </div>
                </div>
            }
        </section>

        <section class="article-list-status-panel mb-4">
            <div>
                <div class="article-list-section-eyebrow">Segmentación rápida</div>
                <h2>Estados de publicación</h2>
            </div>
            <div class="article-list-status-panel__filters">
                <ArticleStatusFilterBar StatusOptions="@StatusOptions"
                                        @bind-SelectedStatus="StatusFilter" />
            </div>
        </section>

        <!-- MENSAJES DE ESTADO / CONTENIDO -->
        <AppStatusModal Visible="@_showStatusModal"
                        Variant="@_statusVariant"
                        Eyebrow="Artículos"
                        Title="@_statusTitle"
                        Message="@_statusMessage"
                        OnClose="CloseStatusModal" />

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="rounded-2xl border border-rose-200 bg-rose-50/40 px-4 py-3 text-sm text-rose-700 shadow-sm">
                Ocurrió un problema al cargar el listado.
            </div>
        }
        else if (_isLoading)
        {
            <div class="rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-700 shadow-sm">
                Cargando artículos…
            </div>
        }
        else if (!_filteredArticles.Any() && _view == ViewMode.Table)
        {
            <!-- Solo en vista TABLA ocultamos la tabla y mostramos el mensaje -->
            <div class="rounded-2xl border border-slate-200 bg-white px-4 py-10 text-center shadow-sm">
                <p class="text-sm font-medium text-slate-700">
                    No se encontraron artículos con los criterios seleccionados.
                </p>
                <p class="mt-1 text-xs text-slate-500">
                    Prueba cambiando el texto de búsqueda o limpiando los filtros.
                </p>
            </div>
        }
        else
        {
            <div class="article-list-control-panel mb-4">
                <div class="article-list-control-panel__toolbar">
                    <ArticleListToolbar Title=""
                                        Subtitle=""
                                        @bind-SearchText="SearchText"
                                        @bind-IsCardsView="IsCardsView"
                                        OnReload="ReloadAsync"
                                        OnNew="GoToNew"
                                        IsBusy="@_isLoading"
                                        SearchPlaceholder="Buscar por título, revista, DOI…" />
                </div>
                <button type="button"
                        class="article-list-bi-button"
                        @onclick="@(() => Nav.NavigateTo("/management/exportinformation"))">
                    <i class="bi bi-diagram-3"></i>
                    <span>Ir a carga masiva</span>
                </button>
            </div>

            <div class="article-list-pagination-card">
                @if (_view == ViewMode.Table)
                {
                    <div class="text-sm text-[#45474b]">
                        Mostrando
                        <span class="font-semibold">@PageStart</span>–<span class="font-semibold">@PageEnd</span>
                        de
                        <span class="font-semibold">@_filteredArticles.Count</span>
                        artículos
                    </div>

                    <div class="flex items-center gap-3">
                        <label class="text-xs text-slate-600">Por página</label>
                        <select class="rounded-lg border border-[#d9dfd1] bg-white px-2 py-1.5 text-xs shadow-sm"
                                @bind="_pageSize"
                                @bind:after="PageSizeChanged">
                            @foreach (var s in _pageSizeOptions)
                            {
                                <option value="@s">@s</option>
                            }
                        </select>

                        <AppPager Class="ml-2"
                                  Page="@_page"
                                  TotalPages="@TotalPages"
                                  OnPrev="PrevPage"
                                  OnNext="NextPage" />
                    </div>
                }
                else
                {
                    <div class="text-sm text-[#45474b]">
                        Mostrando
                        <span class="font-semibold">@_filteredArticles.Count</span>
                        artículos en vista tablero 
                    </div>
                }
            </div>

            <div class="article-list-content-card mt-4">
                @if (_view == ViewMode.Cards)
                {
                    <ArticleKanbanBoard Items="@_filteredArticles"
                                        OnViewMore="OpenDetails" />
                }
                else
                {
                    <ArticleListTable Items="@PagedItems"
                                      OnViewMore="OpenDetails"
                                      OnEdit="GoToEdit"
                                      OnDelete="AskDeleteById" />
                }
            </div>

            <!-- PAGINADOR INFERIOR (solo en vista tabla) -->
            @if (_view == ViewMode.Table)
            {
                <AppPager Class="mt-4"
                          Page="@_page"
                          TotalPages="@TotalPages"
                          OnPrev="PrevPage"
                          OnNext="NextPage" />
            }
        }
    </div>
</div>

<!-- MODAL DETALLES -->
<ArticleDetailsModal Visible="@_isDetailsOpen"
                     Summary="@_selectedArticle"
                     Detail="@_selectedDetail"
                     IsLoading="@_isDetailLoading"
                     OnClose="CloseDetails"
                     OnOpenDocument="OpenDocumentAsync"
                     OnEdit="@(() => { if (_selectedArticle is not null) GoToEdit(_selectedArticle.Id); })"
                     OnDelete="@(() => { if (_selectedArticle is not null) AskDelete(_selectedArticle); })" />

<!-- DIÁLOGO CONFIRMACIÓN ELIMINACIÓN -->
<ConfirmDialog @ref="_confirmDelete"
               Title="Eliminar artículo"
               ConfirmText="Eliminar"
               CancelText="Cancelar"
               Variant="ConfirmVariant.Danger"
               OnConfirm="ConfirmDeleteAsync">
    ¿Estás seguro de que deseas eliminar el artículo
    <strong>@_articleToDeleteTitle</strong>? Esta acción no se puede deshacer.
</ConfirmDialog>

@code {
    private enum ViewMode
    {
        Cards,
        Table
    }

    private List<ArticleListItemDto> _allArticles = new();
    private List<ArticleListItemDto> _filteredArticles = new();

    private bool _isLoading = true;
    private string? _errorMessage;
    private bool _showStatusModal;
    private string _statusVariant = "info";
    private string _statusTitle = string.Empty;
    private string? _statusMessage;

    // Filtros internos
    private string? _searchText;
    private string? _statusFilter;

    // Bindings para toolbar y barra de estado
    private string? SearchText
    {
        get => _searchText;
        set
        {
            _searchText = value;
            ApplyFilters();
        }
    }

    private string? StatusFilter
    {
        get => _statusFilter;
        set
        {
            _statusFilter = value;
            ApplyFilters();
        }
    }

    // Vista actual
    private ViewMode _view = ViewMode.Cards;
    private bool IsCardsView
    {
        get => _view == ViewMode.Cards;
        set => _view = value ? ViewMode.Cards : ViewMode.Table;
    }

    // Paginación (solo para tabla)
    private int _page = 1;
    private int _pageSize = 6;
    private readonly int[] _pageSizeOptions = new[] { 6, 12, 24, 32 };

    private int TotalPages => Math.Max(1, (int)Math.Ceiling((double)_filteredArticles.Count / _pageSize));
    private int PageStart => _filteredArticles.Count == 0 ? 0 : ((_page - 1) * _pageSize) + 1;
    private int PageEnd => Math.Min(_filteredArticles.Count, _page * _pageSize);

    private IEnumerable<ArticleListItemDto> PagedItems =>
        _filteredArticles
            .Skip((_page - 1) * _pageSize)
            .Take(_pageSize);

    // Modal detalle
    private ArticleListItemDto? _selectedArticle;
    private ArticleDetailDto? _selectedDetail;
    private bool _isDetailsOpen;
    private bool _isDetailLoading;

    // Eliminar
    private ArticleListItemDto? _articleToDelete;
    private string _articleToDeleteTitle => _articleToDelete?.Title ?? string.Empty;
    private ConfirmDialog? _confirmDelete;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            _allArticles = await ArticlesClient.GetAllAsync() ?? new List<ArticleListItemDto>();
            ApplyFilters();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
            ShowStatus("error", "No pude cargar el listado", ex.Message);
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private void ApplyFilters()
    {
        IEnumerable<ArticleListItemDto> query = _allArticles;

        if (!string.IsNullOrWhiteSpace(SearchText))
        {
            var q = SearchText.Trim().ToLowerInvariant();
            query = query.Where(a =>
                (!string.IsNullOrWhiteSpace(a.Title) && a.Title.ToLower().Contains(q)) ||
                (!string.IsNullOrWhiteSpace(a.VenueName) && a.VenueName.ToLower().Contains(q)) ||
                (!string.IsNullOrWhiteSpace(a.Doi) && a.Doi.ToLower().Contains(q)));
        }

        if (!string.IsNullOrWhiteSpace(StatusFilter))
        {
            query = query.Where(a => GetStatusKey(a) == StatusFilter);
        }

        _filteredArticles = query
            .OrderByDescending(a => GetStatusKey(a))
            .ThenByDescending(a => a.Year)
            .ThenBy(a => a.Title)
            .ToList();

        _page = 1;
        StateHasChanged();
    }

    private IEnumerable<string> StatusOptions =>
        _allArticles
            .Select(a => GetStatusKey(a))
            .Distinct()
            .Where(s => !string.IsNullOrWhiteSpace(s))
            .OrderBy(s => s);

    // 🔹 Mapeo robusto del estado a clave lógica
    private string GetStatusKey(ArticleListItemDto a)
    {
        var raw = (a.PublicationStatusName ?? string.Empty).Trim();

        if (string.IsNullOrWhiteSpace(raw))
            return "SIN ESTADO";

        var s = raw.ToUpperInvariant();

        // Cualquier variante que contenga "PUBLICAD" o "PUBLISHED"
        if (s == "PUBLICADO" || s == "PUBLICADA" ||
            s.Contains("PUBLICAD") || s.Contains("PUBLISHED"))
        {
            return "PUBLICADO";
        }

        // Cualquier variante que contenga "ACEPT" / "ACCEPT"
        if (s == "ACEPTADO" || s == "ACEPTADA" ||
            s.Contains("ACEPT") || s.Contains("ACCEPT"))
        {
            return "ACEPTADO";
        }

        // Todo lo demás se considera sin estado definido
        return "SIN ESTADO";
    }

    private void PrevPage()
    {
        if (_page > 1)
            _page--;
    }

    private void NextPage()
    {
        if (_page < TotalPages)
            _page++;
    }

    private void PageSizeChanged()
    {
        _page = 1;
    }

    private async Task ReloadAsync() => await LoadAsync();

    private void GoToNew() => Nav.NavigateTo("/articulos/registrar");

    private void OpenDetails(ArticleListItemDto item)
    {
        _selectedArticle = item;
        _isDetailsOpen = true;
        _ = LoadDetailAsync(item.Id);
    }

    private async Task LoadDetailAsync(int id)
    {
        _isDetailLoading = true;
        _selectedDetail = null;

        try
        {
            _selectedDetail = await ArticlesClient.GetByIdAsync(id);
        }
        finally
        {
            _isDetailLoading = false;
            StateHasChanged();
        }
    }

    private void CloseDetails()
    {
        _isDetailsOpen = false;
        _selectedArticle = null;
        _selectedDetail = null;
    }

    private void GoToEdit(int id)
    {
        // 🔹 Ruta correcta para editar
        Nav.NavigateTo($"/articulos/editar/{id}");
    }

    private async Task OpenDocumentAsync()
    {
        if (_selectedDetail is null && _selectedArticle is not null)
        {
            await LoadDetailAsync(_selectedArticle.Id);
        }

        var url = _selectedDetail?.EvidenceUrl
                  ?? _selectedDetail?.PublicationUrl
                  ?? _selectedDetail?.JournalUrl;

        if (!string.IsNullOrWhiteSpace(url))
        {
            Nav.NavigateTo(url!, true);
        }
    }

    private void AskDelete(ArticleListItemDto item)
    {
        _articleToDelete = item;
        _confirmDelete?.Show();
    }

    private void AskDeleteById(int id)
    {
        var item = _filteredArticles.FirstOrDefault(a => a.Id == id)
                   ?? _allArticles.FirstOrDefault(a => a.Id == id);

        if (item is not null)
        {
            AskDelete(item);
        }
    }

    private async Task ConfirmDeleteAsync()
    {
        if (_articleToDelete is null)
            return;

        await ArticlesClient.DeleteAsync(_articleToDelete.Id);
        var deletedTitle = _articleToDelete.Title;

        _allArticles.RemoveAll(a => a.Id == _articleToDelete.Id);
        ApplyFilters();

        if (_selectedArticle?.Id == _articleToDelete.Id)
        {
            CloseDetails();
        }

        _articleToDelete = null;
        ShowStatus("success", "Artículo eliminado", $"El artículo '{deletedTitle}' se eliminó correctamente.");
    }

    private void ShowStatus(string variant, string title, string? message)
    {
        _statusVariant = variant;
        _statusTitle = title;
        _statusMessage = message;
        _showStatusModal = true;
    }

    private Task CloseStatusModal()
    {
        _showStatusModal = false;
        return Task.CompletedTask;
    }
}
