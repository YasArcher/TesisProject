@page "/articles/module/profile"
@page "/perfilview"
@using tesisproject.frontend.Services.Interfaces
@using tesisproject.shared.DTOs.Auth
@inject IAuthClientService AuthClient
@inject NavigationManager Nav
<div class="articles-module-page articles-profile-page h-full min-h-0 overflow-y-auto bg-page-bg">
    @if (_showSupport)
    {
        <div class="articles-profile-modal-backdrop" role="presentation">
            <section class="articles-profile-modal" role="dialog" aria-modal="true" aria-labelledby="password-support-title">
                <p class="articles-profile-modal-eyebrow">Soporte DITIC</p>
                <h2 id="password-support-title">Restablecimiento de contraseña</h2>
                <p>
                    Por seguridad institucional, este sistema no restablece contraseñas directamente. Para recuperar o cambiar tu contraseña debes comunicarte con DITIC.
                </p>
                <div class="articles-profile-modal-contact">
                    <span>Teléfono de soporte</span>
                    <strong>032-000-000 ext. 0000</strong>
                </div>
                <div class="articles-profile-modal-contact">
                    <span>Correo de soporte</span>
                    <strong>soporte.ditic@uta.edu.ec</strong>
                </div>
                <small>Estos datos son referenciales y pueden reemplazarse por el canal oficial de la institución.</small>
                <button type="button" class="articles-profile-modal-close" @onclick="HideSupportMessage">
                    Entendido
                </button>
            </section>
        </div>
    }

    <div class="mx-auto w-full max-w-6xl p-4 md:p-6">
        <header class="articles-profile-hero mb-5">
            <div class="articles-profile-hero-copy">
                <span>Soporte y cuenta</span>
                <h1>Perfil de usuario</h1>
                <p>Consulta tu identidad, roles y accesos disponibles dentro de la plataforma integrada.</p>
            </div>
            <button type="button"
                    class="articles-profile-refresh"
                    @onclick="LoadAsync"
                    disabled="@_loading">
                Actualizar
            </button>
        </header>

        @if (_loading)
        {
            <section class="rounded-lg border border-border bg-background p-8 text-center">
                <div class="inline-block h-8 w-8 animate-spin rounded-full border-4 border-solid border-primary border-r-transparent"></div>
                <p class="mt-3 text-sm text-muted">Cargando perfil...</p>
            </section>
        }
        else if (!string.IsNullOrWhiteSpace(_error))
        {
            <section class="rounded-lg border border-border bg-background p-6">
                <h2 class="text-lg font-bold text-foreground">No fue posible consultar el perfil</h2>
                <p class="mt-2 text-sm text-muted">@_error</p>
                <button type="button" class="mt-4 rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-white" @onclick="LoadAsync">
                    Intentar nuevamente
                </button>
            </section>
        }
        else if (_session is not null)
        {
            <section class="articles-profile-grid grid grid-cols-1 gap-4 lg:grid-cols-3">
                <article class="articles-workspace-panel articles-profile-identity rounded-lg border border-border bg-background p-5 lg:col-span-2">
                    <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
                        <div>
                            <p class="text-xs font-semibold uppercase text-muted">Usuario conectado</p>
                            <h2 class="mt-1 text-xl font-bold text-foreground">@Display(_session.DisplayName ?? _session.Email)</h2>
                            <p class="mt-1 text-sm text-muted">@Display(_session.Email)</p>
                        </div>
                        <span class="articles-profile-state">
                            Sesión activa
                        </span>
                    </div>

                    <div class="mt-5 grid grid-cols-1 gap-3 sm:grid-cols-3">
                        <div class="articles-profile-stat rounded-lg border border-border p-4">
                            <p class="text-xs font-semibold text-muted">Roles</p>
                            <p class="mt-1 text-lg font-bold text-foreground">@_session.Roles.Count</p>
                        </div>
                        <div class="articles-profile-stat rounded-lg border border-border p-4">
                            <p class="text-xs font-semibold text-muted">Permisos</p>
                            <p class="mt-1 text-lg font-bold text-foreground">@_session.Permissions.Count</p>
                        </div>
                        <div class="articles-profile-stat rounded-lg border border-border p-4">
                            <p class="text-xs font-semibold text-muted">Artículos</p>
                            <p class="mt-1 text-lg font-bold text-foreground">@(_session.Articles.Enabled ? "Activo" : "Inactivo")</p>
                        </div>
                    </div>
                </article>

                <article class="articles-workspace-panel articles-profile-support rounded-lg border border-border bg-background p-5">
                    <p class="text-xs font-semibold uppercase text-muted">Restablecimiento</p>
                    <h2 class="mt-1 text-lg font-bold text-foreground">Contraseña</h2>
                    <p class="mt-2 text-sm text-muted">
                        El sistema no restablece contraseñas directamente. Para soporte, comunícate con DITIC.
                    </p>
                    <button type="button"
                            class="articles-profile-support-button mt-4 w-full rounded-lg border border-border px-4 py-2 text-sm font-semibold"
                            @onclick="ShowSupportMessage">
                        Restablecer contraseña
                    </button>
                </article>
            </section>

            <section class="articles-profile-details mt-4 grid grid-cols-1 gap-4 xl:grid-cols-2">
                <article class="articles-workspace-panel rounded-lg border border-border bg-background p-5">
                    <h2 class="text-lg font-bold text-foreground">Roles asignados</h2>
                    <div class="mt-3 flex flex-wrap gap-2">
                        @foreach (var role in _session.Roles.DefaultIfEmpty("Sin roles asignados"))
                        {
                            <span class="articles-profile-chip rounded-lg border border-border bg-page-bg px-3 py-2 text-xs font-semibold text-foreground">@GetFriendlyRole(role)</span>
                        }
                    </div>
                </article>

                <article class="articles-workspace-panel rounded-lg border border-border bg-background p-5">
                    <h2 class="text-lg font-bold text-foreground">Accesos de artículos</h2>
                    <div class="mt-3 grid grid-cols-1 gap-2 sm:grid-cols-2">
                        @foreach (var access in ArticleAccessItems)
                        {
                            <div class="articles-profile-access flex items-center justify-between rounded-lg border border-border px-3 py-2">
                                <span class="text-sm text-foreground">@access.Label</span>
                                <span class="rounded-lg px-2 py-1 text-xs font-bold @(access.Enabled ? "is-enabled" : "is-disabled")">
                                    @(access.Enabled ? "Permitido" : "Sin acceso")
                                </span>
                            </div>
                        }
                    </div>
                </article>
            </section>

            <section class="articles-profile-shortcuts mt-4">
                @foreach (var action in QuickActions)
                {
                    <a class="articles-profile-shortcut @(action.Enabled ? null : "is-disabled")"
                       href="@(action.Enabled ? action.Href : null)"
                       aria-disabled="@(!action.Enabled)">
                        <span>@action.Label</span>
                        <small>@action.Description</small>
                    </a>
                }
            </section>
        }
    </div>
</div>

@code {
    private CurrentSessionResponse? _session;
    private bool _loading = true;
    private bool _showSupport;
    private string? _error;

    private IEnumerable<(string Label, bool Enabled)> ArticleAccessItems
    {
        get
        {
            var a = _session?.Articles ?? new ArticleModuleAccessResponse();
            yield return ("Consultar artículos", a.CanList || a.CanAccess);
            yield return ("Registrar artículos", a.CanRegister);
            yield return ("Workflow", a.CanUseWorkflow);
            yield return ("Carga masiva", a.CanUseBulkImport);
            yield return ("APIs externas", a.CanUseExternalApis);
            yield return ("Reportería", a.CanViewReporting);
            yield return ("IA", a.CanViewIntelligence);
            yield return ("Configuración", a.CanManageConfiguration);
        }
    }

    private IEnumerable<(string Label, string Description, string Href, bool Enabled)> QuickActions
    {
        get
        {
            var a = _session?.Articles ?? new ArticleModuleAccessResponse();
            yield return ("Registro", "Abrir formulario de artículos", "/articles/module/register", a.CanRegister);
            yield return ("Workflow", "Revisar envíos y correcciones", "/articles/module/workflow", a.CanUseWorkflow || a.CanRegister);
            yield return ("Reportería", "Consultar indicadores institucionales", "/articles/module/reporting", a.CanViewReporting);
            yield return ("Ayuda", "Ver soporte y manual del módulo", "/articles/module/support", true);
        }
    }

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        _showSupport = false;

        var response = await AuthClient.GetCurrentSessionAsync();
        if (!response.Success || response.Data is null)
        {
            _error = response.Message ?? "La sesión no está disponible. Inicia sesión nuevamente.";
            _loading = false;
            return;
        }

        _session = response.Data;
        _loading = false;
    }

    private void ShowSupportMessage() => _showSupport = true;
    private void HideSupportMessage() => _showSupport = false;

    private static string Display(string? value) => string.IsNullOrWhiteSpace(value) ? "No informado" : value;

    private static string GetFriendlyRole(string role)
        => role switch
        {
            "Admin" => "Administrador",
            "Author" => "Autor",
            "Autor" => "Autor",
            "Analyst" => "Analista",
            "WorkflowReviewerUodide" => "Revisor UODIDE",
            "WorkflowReviewerAreaTecnica" => "Área Técnica",
            "WorkflowProcessorAreaTecnica" => "Procesamiento técnico",
            "ArticleRegistrationUser" => "Registro de artículos",
            "RegistrationMatrixUser" => "Matriz de registro",
            "DirectArticleSaveUser" => "Guardado directo",
            "BulkImportUser" => "Carga masiva",
            "ExternalApiUser" => "APIs externas",
            "ReportingViewer" => "Reportería",
            "ReportingExporter" => "Exportación de reportes",
            "ReportingAdvancedUser" => "Reportería avanzada",
            "IntelligenceViewer" => "Inteligencia",
            "IntelligenceTrainer" => "Entrenamiento IA",
            "ConfigurationManager" => "Configuración",
            "CatalogManager" => "Catálogos",
            "WorkflowTrackingUser" => "Seguimiento workflow",
            "SecurityAdministrator" => "Seguridad",
            "RoleManager" => "Gestión de roles",
            _ => role
        };
}
