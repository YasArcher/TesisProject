@page "/articles/module/profile"
@using tesisproject.frontend.Services.Interfaces
@using tesisproject.shared.DTOs.Auth
@inject IAuthClientService AuthClient
@inject NavigationManager Nav

@* [ARTICLES-MIGRATION] Perfil del modulo de articulos conectado a la sesion unificada del sistema base. *@
<div class="h-full min-h-0 overflow-y-auto bg-page-bg">
    <div class="mx-auto w-full max-w-6xl p-4 md:p-6">
        <header class="mb-5 flex flex-col gap-3 border-b border-border pb-4 md:flex-row md:items-end md:justify-between">
            <div>
                <p class="text-sm font-semibold text-primary">Soporte y cuenta</p>
                <h1 class="mt-1 text-2xl font-bold text-foreground">Perfil de usuario</h1>
                <p class="mt-1 text-sm text-muted">Consulta tu identidad, roles y accesos dentro de la plataforma integrada.</p>
            </div>
            <button type="button"
                    class="rounded-lg border border-border bg-background px-4 py-2 text-sm font-semibold text-foreground hover:bg-primary-subtle"
                    @onclick="LoadAsync"
                    disabled="@_loading">
                Actualizar
            </button>
        </header>

        @if (_loading)
        {
            <section class="rounded-lg border border-border bg-background p-8 text-center">
                <div class="inline-block h-8 w-8 animate-spin rounded-full border-4 border-solid border-primary border-r-transparent"></div>
                <p class="mt-3 text-sm text-muted">Cargando perfil...</p>
            </section>
        }
        else if (!string.IsNullOrWhiteSpace(_error))
        {
            <section class="rounded-lg border border-border bg-background p-6">
                <h2 class="text-lg font-bold text-foreground">No fue posible consultar el perfil</h2>
                <p class="mt-2 text-sm text-muted">@_error</p>
                <button type="button" class="mt-4 rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-white" @onclick="LoadAsync">
                    Intentar nuevamente
                </button>
            </section>
        }
        else if (_session is not null)
        {
            <section class="grid grid-cols-1 gap-4 lg:grid-cols-3">
                <article class="rounded-lg border border-border bg-background p-5 lg:col-span-2">
                    <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
                        <div>
                            <p class="text-xs font-semibold uppercase text-muted">Usuario conectado</p>
                            <h2 class="mt-1 text-xl font-bold text-foreground">@Display(_session.DisplayName ?? _session.Email)</h2>
                            <p class="mt-1 text-sm text-muted">@Display(_session.Email)</p>
                        </div>
                        <span class="inline-flex w-fit rounded-lg bg-primary-subtle px-3 py-2 text-xs font-bold uppercase text-primary">
                            Sesión activa
                        </span>
                    </div>

                    <div class="mt-5 grid grid-cols-1 gap-3 sm:grid-cols-3">
                        <div class="rounded-lg border border-border p-4">
                            <p class="text-xs font-semibold text-muted">Roles</p>
                            <p class="mt-1 text-lg font-bold text-foreground">@_session.Roles.Count</p>
                        </div>
                        <div class="rounded-lg border border-border p-4">
                            <p class="text-xs font-semibold text-muted">Permisos</p>
                            <p class="mt-1 text-lg font-bold text-foreground">@_session.Permissions.Count</p>
                        </div>
                        <div class="rounded-lg border border-border p-4">
                            <p class="text-xs font-semibold text-muted">Artículos</p>
                            <p class="mt-1 text-lg font-bold text-foreground">@(_session.Articles.Enabled ? "Activo" : "Inactivo")</p>
                        </div>
                    </div>
                </article>

                <article class="rounded-lg border border-border bg-background p-5">
                    <p class="text-xs font-semibold uppercase text-muted">Restablecimiento</p>
                    <h2 class="mt-1 text-lg font-bold text-foreground">Contraseña</h2>
                    <p class="mt-2 text-sm text-muted">
                        El sistema no restablece contraseñas directamente. Para soporte, comunícate con DITIC.
                    </p>
                    <button type="button"
                            class="mt-4 w-full rounded-lg border border-border px-4 py-2 text-sm font-semibold text-primary hover:bg-primary-subtle"
                            @onclick="ShowSupportMessage">
                        Restablecer contraseña
                    </button>
                    @if (_showSupport)
                    {
                        <div class="mt-4 rounded-lg border border-primary/30 bg-primary-subtle p-3 text-sm text-foreground">
                            Contacto de soporte: soporte.ditic@uta.edu.ec · 032-000-000 ext. 0000
                        </div>
                    }
                </article>
            </section>

            <section class="mt-4 grid grid-cols-1 gap-4 xl:grid-cols-2">
                <article class="rounded-lg border border-border bg-background p-5">
                    <h2 class="text-lg font-bold text-foreground">Roles asignados</h2>
                    <div class="mt-3 flex flex-wrap gap-2">
                        @foreach (var role in _session.Roles.DefaultIfEmpty("Sin roles asignados"))
                        {
                            <span class="rounded-lg border border-border bg-page-bg px-3 py-2 text-xs font-semibold text-foreground">@role</span>
                        }
                    </div>
                </article>

                <article class="rounded-lg border border-border bg-background p-5">
                    <h2 class="text-lg font-bold text-foreground">Accesos de artículos</h2>
                    <div class="mt-3 grid grid-cols-1 gap-2 sm:grid-cols-2">
                        @foreach (var access in ArticleAccessItems)
                        {
                            <div class="flex items-center justify-between rounded-lg border border-border px-3 py-2">
                                <span class="text-sm text-foreground">@access.Label</span>
                                <span class="rounded-lg px-2 py-1 text-xs font-bold @(access.Enabled ? "bg-primary-subtle text-primary" : "bg-page-bg text-muted")">
                                    @(access.Enabled ? "Permitido" : "Sin acceso")
                                </span>
                            </div>
                        }
                    </div>
                </article>
            </section>
        }
    </div>
</div>

@code {
    private CurrentSessionResponse? _session;
    private bool _loading = true;
    private bool _showSupport;
    private string? _error;

    private IEnumerable<(string Label, bool Enabled)> ArticleAccessItems
    {
        get
        {
            var a = _session?.Articles ?? new ArticleModuleAccessResponse();
            yield return ("Consultar artículos", a.CanList || a.CanAccess);
            yield return ("Registrar artículos", a.CanRegister);
            yield return ("Workflow", a.CanUseWorkflow);
            yield return ("Carga masiva", a.CanUseBulkImport);
            yield return ("APIs externas", a.CanUseExternalApis);
            yield return ("Reportería", a.CanViewReporting);
            yield return ("IA", a.CanViewIntelligence);
            yield return ("Configuración", a.CanManageConfiguration);
        }
    }

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        _showSupport = false;

        var response = await AuthClient.GetCurrentSessionAsync();
        if (!response.Success || response.Data is null)
        {
            _error = response.Message ?? "La sesión no está disponible. Inicia sesión nuevamente.";
            _loading = false;
            return;
        }

        _session = response.Data;
        _loading = false;
    }

    private void ShowSupportMessage() => _showSupport = true;

    private static string Display(string? value) => string.IsNullOrWhiteSpace(value) ? "No informado" : value;
}
