@page "/articles/module/register"
@using tesisproject.frontend.Services.Interfaces
@using tesisproject.shared.DTOs.Configuration
@using tesisproject.shared.DTOs.Catalogs
@inject IFormConfigurationClient FormConfigurationClient
@inject NavigationManager Nav

@* [ARTICLES-MIGRATION] Registro dinamico controlado. Usa configuracion activa de articulos sin activar aun persistencia/workflow. *@
<div class="h-full min-h-0 overflow-y-auto bg-page-bg">
    <div class="mx-auto w-full max-w-7xl p-4 md:p-6">
        <header class="mb-5 flex flex-col gap-3 border-b border-border pb-4 xl:flex-row xl:items-end xl:justify-between">
            <div>
                <p class="text-sm font-semibold text-primary">Registro y seguimiento</p>
                <h1 class="mt-1 text-2xl font-bold text-foreground">Registrar artículo</h1>
                <p class="mt-1 max-w-3xl text-sm text-muted">
                    Vista de integración progresiva conectada al formulario activo. Permite validar estructura, campos requeridos y participantes antes de activar el envío real al workflow.
                </p>
            </div>
            <div class="flex flex-wrap gap-2">
                <button type="button"
                        class="rounded-lg border border-border bg-background px-4 py-2 text-sm font-semibold text-foreground hover:bg-primary-subtle"
                        @onclick="LoadAsync"
                        disabled="@_loading">
                    Actualizar formulario
                </button>
                <button type="button"
                        class="rounded-lg border border-border bg-background px-4 py-2 text-sm font-semibold text-foreground hover:bg-primary-subtle"
                        @onclick="BackToArticles">
                    Volver al listado
                </button>
            </div>
        </header>

        @if (_loading)
        {
            <section class="rounded-lg border border-border bg-background p-8 text-center">
                <div class="inline-block h-8 w-8 animate-spin rounded-full border-4 border-solid border-primary border-r-transparent"></div>
                <p class="mt-3 text-sm text-muted">Cargando formulario activo...</p>
            </section>
        }
        else if (!string.IsNullOrWhiteSpace(_error))
        {
            <section class="rounded-lg border border-border bg-background p-6">
                <h2 class="text-lg font-bold text-foreground">No fue posible cargar el registro</h2>
                <p class="mt-2 text-sm text-muted">@_error</p>
                <button type="button" class="mt-4 rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-white" @onclick="LoadAsync">
                    Intentar nuevamente
                </button>
            </section>
        }
        else if (_articleForm is null)
        {
            <section class="rounded-lg border border-amber-200 bg-amber-50 p-6 text-amber-900">
                <h2 class="text-lg font-bold">Registro en mantenimiento</h2>
                <p class="mt-2 text-sm">No existe un formulario activo para artículos. Activa uno desde configuración para permitir registros.</p>
            </section>
        }
        else
        {
            <section class="mb-5 grid grid-cols-1 gap-4 lg:grid-cols-4">
                <article class="rounded-lg border border-border bg-background p-4">
                    <p class="text-xs font-semibold uppercase text-muted">Formulario</p>
                    <p class="mt-1 text-lg font-bold text-foreground">@_articleForm.FormName</p>
                </article>
                <article class="rounded-lg border border-border bg-background p-4">
                    <p class="text-xs font-semibold uppercase text-muted">Campos visibles</p>
                    <p class="mt-1 text-lg font-bold text-foreground">@VisibleArticleFields.Count</p>
                </article>
                <article class="rounded-lg border border-border bg-background p-4">
                    <p class="text-xs font-semibold uppercase text-muted">Obligatorios</p>
                    <p class="mt-1 text-lg font-bold text-foreground">@VisibleArticleFields.Count(f => f.IsRequired)</p>
                </article>
                <article class="rounded-lg border border-border bg-background p-4">
                    <p class="text-xs font-semibold uppercase text-muted">Participantes</p>
                    <p class="mt-1 text-lg font-bold text-foreground">@_participants.Count</p>
                </article>
            </section>

            @if (!string.IsNullOrWhiteSpace(_statusMessage))
            {
                <section class="mb-5 rounded-lg border @StatusBorderClass @StatusBgClass p-4">
                    <h2 class="text-sm font-bold @StatusTitleClass">@_statusTitle</h2>
                    <p class="mt-1 text-sm @StatusTextClass">@_statusMessage</p>
                    @if (_missingOptional.Count > 0)
                    {
                        <p class="mt-2 text-xs @StatusTextClass">Opcionales pendientes: @string.Join(", ", _missingOptional.Take(8))@(_missingOptional.Count > 8 ? "..." : string.Empty)</p>
                    }
                </section>
            }

            <div class="grid grid-cols-1 gap-5 xl:grid-cols-[minmax(0,1fr)_22rem]">
                <main class="space-y-4">
                    @foreach (var formSection in _articleForm.Sections.OrderBy(s => s.DisplayOrder))
                    {
                        var fields = formSection.Fields.Where(IsRenderable).OrderBy(f => f.DisplayOrder).ToList();
                        if (fields.Count == 0)
                        {
                            continue;
                        }

                        <section class="rounded-lg border border-border bg-background p-5">
                            <div class="mb-4 flex flex-col gap-1 border-b border-border pb-3 sm:flex-row sm:items-end sm:justify-between">
                                <div>
                                    <h2 class="text-lg font-bold text-foreground">@formSection.GroupName</h2>
                                    <p class="text-xs text-muted">@fields.Count campo(s) configurados desde administración</p>
                                </div>
                                <span class="w-fit rounded-lg bg-primary-subtle px-3 py-1 text-xs font-bold text-primary">
                                    @fields.Count(f => f.IsRequired) requerido(s)
                                </span>
                            </div>

                            <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                                @foreach (var field in fields)
                                {
                                    <div class="@(GetColumnClass(field))">
                                        <label class="block">
                                            <span class="mb-1 flex items-center gap-2 text-xs font-semibold text-muted">
                                                @field.FieldLabel
                                                @if (field.IsRequired)
                                                {
                                                    <span class="rounded bg-red-50 px-2 py-0.5 text-[10px] font-bold text-red-700">Obligatorio</span>
                                                }
                                            </span>
                                            @RenderField(field)
                                        </label>
                                        @if (!string.IsNullOrWhiteSpace(field.HelpText))
                                        {
                                            <p class="mt-1 text-xs text-muted">@field.HelpText</p>
                                        }
                                        @if (_validation.TryGetValue(field.FieldId, out var message))
                                        {
                                            <p class="mt-1 text-xs font-semibold text-red-700">@message</p>
                                        }
                                    </div>
                                }
                            </div>
                        </section>
                    }

                    <section class="rounded-lg border border-border bg-background p-5">
                        <div class="mb-4 flex flex-col gap-3 border-b border-border pb-3 sm:flex-row sm:items-center sm:justify-between">
                            <div>
                                <h2 class="text-lg font-bold text-foreground">Participantes</h2>
                                <p class="text-xs text-muted">Debe existir al menos un autor o coautor asociado al registro.</p>
                            </div>
                            <button type="button" class="rounded-lg border border-border px-4 py-2 text-sm font-semibold text-primary hover:bg-primary-subtle" @onclick="AddParticipant">
                                Agregar participante
                            </button>
                        </div>

                        <div class="space-y-3">
                            @foreach (var participant in _participants)
                            {
                                <article class="rounded-lg border border-border bg-page-bg p-4" @key="participant.Id">
                                    <div class="mb-3 flex items-center justify-between gap-3">
                                        <h3 class="text-sm font-bold text-foreground">Participante @participant.Order</h3>
                                        <button type="button"
                                                class="rounded-lg border border-border px-3 py-1.5 text-xs font-semibold text-muted hover:bg-background"
                                                disabled="@(_participants.Count == 1)"
                                                @onclick="() => RemoveParticipant(participant.Id)">
                                            Quitar
                                        </button>
                                    </div>
                                    <div class="grid grid-cols-1 gap-3 md:grid-cols-4">
                                        <label class="block">
                                            <span class="mb-1 block text-xs font-semibold text-muted">Orden</span>
                                            <select class="w-full rounded-lg border border-border bg-background px-3 py-2 text-sm text-foreground" @bind="participant.Order">
                                                @for (var i = 1; i <= _participants.Count; i++)
                                                {
                                                    <option value="@i">@i</option>
                                                }
                                            </select>
                                        </label>
                                        <label class="block md:col-span-2">
                                            <span class="mb-1 block text-xs font-semibold text-muted">Nombre completo</span>
                                            <input class="w-full rounded-lg border @(ParticipantMissing(participant.Name) ? "border-red-300" : "border-border") bg-background px-3 py-2 text-sm text-foreground"
                                                   maxlength="120"
                                                   @bind="participant.Name" />
                                        </label>
                                        <label class="block">
                                            <span class="mb-1 block text-xs font-semibold text-muted">Participación</span>
                                            <select class="w-full rounded-lg border border-border bg-background px-3 py-2 text-sm text-foreground" @bind="participant.Role">
                                                <option>Autor</option>
                                                <option>Coautor</option>
                                            </select>
                                        </label>
                                        <label class="block">
                                            <span class="mb-1 block text-xs font-semibold text-muted">Identificación</span>
                                            <input class="w-full rounded-lg border @(ParticipantMissing(participant.Identifier) ? "border-red-300" : "border-border") bg-background px-3 py-2 text-sm text-foreground"
                                                   maxlength="10"
                                                   inputmode="numeric"
                                                   @bind="participant.Identifier" />
                                        </label>
                                        <label class="block">
                                            <span class="mb-1 block text-xs font-semibold text-muted">Tipo</span>
                                            <select class="w-full rounded-lg border border-border bg-background px-3 py-2 text-sm text-foreground" @bind="participant.Type">
                                                <option>Docente</option>
                                                <option>Estudiante</option>
                                                <option>Externo</option>
                                                <option>Administrativo</option>
                                            </select>
                                        </label>
                                        <label class="block md:col-span-2">
                                            <span class="mb-1 block text-xs font-semibold text-muted">Afiliación</span>
                                            <input class="w-full rounded-lg border border-border bg-background px-3 py-2 text-sm text-foreground"
                                                   maxlength="160"
                                                   @bind="participant.Affiliation" />
                                        </label>
                                    </div>
                                </article>
                            }
                        </div>
                    </section>
                </main>

                <aside class="space-y-4">
                    <section class="rounded-lg border border-border bg-background p-5">
                        <p class="text-xs font-semibold uppercase text-muted">Estado del registro</p>
                        <h2 class="mt-1 text-lg font-bold text-foreground">Preparación controlada</h2>
                        <p class="mt-2 text-sm text-muted">
                            Esta vista valida datos contra la configuración activa. El guardado definitivo y envío a workflow se activarán en la siguiente fase de fusión.
                        </p>
                        <div class="mt-4 grid grid-cols-2 gap-3">
                            <div class="rounded-lg border border-border p-3">
                                <p class="text-xs text-muted">Completados</p>
                                <p class="text-lg font-bold text-foreground">@CompletedRequiredCount</p>
                            </div>
                            <div class="rounded-lg border border-border p-3">
                                <p class="text-xs text-muted">Pendientes</p>
                                <p class="text-lg font-bold text-foreground">@MissingRequiredCount</p>
                            </div>
                        </div>
                        <button type="button"
                                class="mt-4 w-full rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-white hover:opacity-90"
                                @onclick="ValidateDraft">
                            Validar registro
                        </button>
                        <button type="button"
                                class="mt-2 w-full rounded-lg border border-border px-4 py-2 text-sm font-semibold text-foreground hover:bg-primary-subtle"
                                @onclick="PrepareForWorkflow">
                            Preparar para envío
                        </button>
                    </section>

                    <section class="rounded-lg border border-border bg-background p-5">
                        <p class="text-xs font-semibold uppercase text-muted">Siguiente integración</p>
                        <ul class="mt-3 space-y-2 text-sm text-muted">
                            <li>1. Conectar guardado en staging.</li>
                            <li>2. Crear lote institucional.</li>
                            <li>3. Enviar a revisión UODIDE.</li>
                        </ul>
                    </section>
                </aside>
            </div>
        }
    </div>
</div>

@code {
    private ResolvedFormDto? _articleForm;
    private ResolvedFormDto? _participantForm;
    private readonly Dictionary<int, string?> _values = new();
    private readonly Dictionary<int, List<CatalogItemDto>> _catalogs = new();
    private readonly Dictionary<int, string> _validation = new();
    private readonly List<ParticipantDraft> _participants = [new()];
    private readonly List<string> _missingOptional = [];
    private bool _loading = true;
    private bool _submitted;
    private string? _error;
    private string? _statusTitle;
    private string? _statusMessage;
    private bool _statusOk;

    private List<ResolvedFormFieldDto> VisibleArticleFields => _articleForm?.Sections
        .SelectMany(section => section.Fields)
        .Where(IsRenderable)
        .OrderBy(field => field.DisplayOrder)
        .ToList() ?? [];

    private int MissingRequiredCount => VisibleArticleFields.Count(field => field.IsRequired && IsEmpty(field));
    private int CompletedRequiredCount => VisibleArticleFields.Count(field => field.IsRequired && !IsEmpty(field));

    private string StatusBorderClass => _statusOk ? "border-emerald-200" : "border-amber-200";
    private string StatusBgClass => _statusOk ? "bg-emerald-50" : "bg-amber-50";
    private string StatusTitleClass => _statusOk ? "text-emerald-900" : "text-amber-900";
    private string StatusTextClass => _statusOk ? "text-emerald-800" : "text-amber-800";

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        _statusMessage = null;
        _validation.Clear();
        _catalogs.Clear();

        var article = await FormConfigurationClient.GetActiveResolvedFormAsync("Article", "ArticleManualForm");
        var participant = await FormConfigurationClient.GetActiveResolvedFormAsync("ArticleParticipant", "ArticleParticipantForm");

        if (!article.Success)
        {
            _error = article.Message ?? "No fue posible obtener el formulario activo de artículos.";
            _loading = false;
            return;
        }

        _articleForm = article.Data;
        _participantForm = participant.Success ? participant.Data : null;

        SeedDefaults();
        await LoadCatalogsAsync();
        _loading = false;
    }

    private void SeedDefaults()
    {
        foreach (var field in VisibleArticleFields)
        {
            if (!_values.ContainsKey(field.FieldId))
                _values[field.FieldId] = field.DefaultValue;
        }
    }

    private async Task LoadCatalogsAsync()
    {
        foreach (var field in VisibleArticleFields.Where(NeedsCatalog))
        {
            var result = await FormConfigurationClient.GetCatalogItemsByFieldAsync(field.FieldId);
            if (result.Success && result.Data is not null)
                _catalogs[field.FieldId] = result.Data;
        }
    }

    private RenderFragment RenderField(ResolvedFormFieldDto field) => builder =>
    {
        var sequence = 0;
        var css = $"w-full rounded-lg border {(HasValidation(field) ? "border-red-300 bg-red-50" : "border-border bg-background")} px-3 py-2 text-sm text-foreground disabled:opacity-70";
        var disabled = !field.IsEditable;
        var value = GetValue(field);

        if (field.Options.Count > 0 || _catalogs.ContainsKey(field.FieldId))
        {
            builder.OpenElement(sequence++, "select");
            builder.AddAttribute(sequence++, "class", css);
            builder.AddAttribute(sequence++, "disabled", disabled);
            builder.AddAttribute(sequence++, "value", value);
            builder.AddAttribute(sequence++, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, args => SetValue(field, args.Value?.ToString())));
            builder.OpenElement(sequence++, "option");
            builder.AddAttribute(sequence++, "value", string.Empty);
            builder.AddContent(sequence++, "Seleccionar");
            builder.CloseElement();

            foreach (var option in GetOptions(field))
            {
                builder.OpenElement(sequence++, "option");
                builder.AddAttribute(sequence++, "value", option.Value);
                builder.AddContent(sequence++, option.Label);
                builder.CloseElement();
            }

            builder.CloseElement();
            return;
        }

        var type = NormalizeType(field.DataType) switch
        {
            "date" => "date",
            "number" or "integer" or "decimal" => "number",
            _ => "text"
        };

        builder.OpenElement(sequence++, "input");
        builder.AddAttribute(sequence++, "class", css);
        builder.AddAttribute(sequence++, "type", type);
        builder.AddAttribute(sequence++, "disabled", disabled);
        builder.AddAttribute(sequence++, "value", value);
        builder.AddAttribute(sequence++, "placeholder", field.Placeholder ?? string.Empty);
        if (field.MaxLength.HasValue && type == "text")
            builder.AddAttribute(sequence++, "maxlength", field.MaxLength.Value);
        if (type == "date")
            builder.AddAttribute(sequence++, "max", DateTime.Today.ToString("yyyy-MM-dd"));
        builder.AddAttribute(sequence++, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, args => SetValue(field, args.Value?.ToString())));
        builder.CloseElement();
    };

    private void SetValue(ResolvedFormFieldDto field, string? value)
    {
        _values[field.FieldId] = value;
        if (_submitted)
            ValidateField(field);
    }

    private void ValidateDraft()
    {
        _submitted = true;
        _validation.Clear();
        _missingOptional.Clear();

        foreach (var field in VisibleArticleFields)
        {
            ValidateField(field);
            if (!field.IsRequired && IsEmpty(field))
                _missingOptional.Add(field.FieldLabel);
        }

        ValidateParticipants();

        if (_validation.Count == 0)
        {
            _statusOk = true;
            _statusTitle = "Registro validado";
            _statusMessage = _missingOptional.Count == 0
                ? "Todos los campos visibles fueron revisados correctamente."
                : "Los campos obligatorios están completos. Existen campos opcionales pendientes que pueden completarse antes del envío.";
        }
        else
        {
            _statusOk = false;
            _statusTitle = "Correcciones requeridas";
            _statusMessage = $"Se encontraron {_validation.Count} observación(es). Revisa los campos marcados en rojo.";
        }
    }

    private void PrepareForWorkflow()
    {
        ValidateDraft();
        if (_validation.Count > 0)
            return;

        _statusOk = true;
        _statusTitle = "Listo para integración de envío";
        _statusMessage = "El formulario supera la validación local. En la siguiente fase se conectará el guardado en staging y el envío a revisión.";
    }

    private void ValidateField(ResolvedFormFieldDto field)
    {
        _validation.Remove(field.FieldId);
        var value = GetValue(field);

        if (field.IsRequired && string.IsNullOrWhiteSpace(value))
        {
            _validation[field.FieldId] = $"{field.FieldLabel} es obligatorio.";
            return;
        }

        if (string.IsNullOrWhiteSpace(value))
            return;

        if (field.MaxLength.HasValue && value.Length > field.MaxLength.Value)
            _validation[field.FieldId] = $"No debe superar {field.MaxLength.Value} caracteres.";

        if (NormalizeType(field.DataType) == "date" && DateTime.TryParse(value, out var date) && date.Date > DateTime.Today)
            _validation[field.FieldId] = "La fecha no puede ser futura.";
    }

    private void ValidateParticipants()
    {
        if (_participants.Count == 0)
        {
            _validation[-1] = "Debe registrar al menos un participante.";
            return;
        }

        foreach (var participant in _participants)
        {
            if (string.IsNullOrWhiteSpace(participant.Name))
                _validation[-1000 - participant.Id] = $"El nombre del participante {participant.Order} es obligatorio.";
            if (string.IsNullOrWhiteSpace(participant.Identifier) || participant.Identifier.Any(ch => !char.IsDigit(ch)) || participant.Identifier.Length != 10)
                _validation[-2000 - participant.Id] = $"La identificación del participante {participant.Order} debe tener 10 dígitos.";
        }
    }

    private void BackToArticles() => Nav.NavigateTo("/articles");

    private void AddParticipant()
    {
        var nextId = _participants.Count == 0 ? 1 : _participants.Max(p => p.Id) + 1;
        _participants.Add(new ParticipantDraft { Id = nextId, Order = _participants.Count + 1 });
    }

    private void RemoveParticipant(int id)
    {
        if (_participants.Count == 1)
            return;

        _participants.RemoveAll(item => item.Id == id);
        var order = 1;
        foreach (var participant in _participants.OrderBy(item => item.Order))
            participant.Order = order++;
    }

    private bool IsRenderable(ResolvedFormFieldDto field) => field.IsActive && field.IsVisible;
    private bool NeedsCatalog(ResolvedFormFieldDto field) => !string.IsNullOrWhiteSpace(field.ReferenceTableName) || NormalizeType(field.SourceType).Contains("catalog");
    private bool IsEmpty(ResolvedFormFieldDto field) => string.IsNullOrWhiteSpace(GetValue(field));
    private bool HasValidation(ResolvedFormFieldDto field) => _validation.ContainsKey(field.FieldId);
    private string GetValue(ResolvedFormFieldDto field) => _values.TryGetValue(field.FieldId, out var value) ? value ?? string.Empty : string.Empty;
    private string GetColumnClass(ResolvedFormFieldDto field) => field.ColumnSpan is >= 2 ? "md:col-span-2" : string.Empty;
    private static string NormalizeType(string? value) => (value ?? string.Empty).Trim().ToLowerInvariant();
    private bool ParticipantMissing(string? value) => _submitted && string.IsNullOrWhiteSpace(value);

    private IEnumerable<(string Value, string Label)> GetOptions(ResolvedFormFieldDto field)
    {
        foreach (var option in field.Options.Where(item => item.IsActive).OrderBy(item => item.DisplayOrder))
            yield return (option.OptionValue, option.OptionLabel);

        if (_catalogs.TryGetValue(field.FieldId, out var catalog))
        {
            foreach (var item in catalog)
                yield return (item.Id.ToString(), item.Name);
        }
    }

    private sealed class ParticipantDraft
    {
        public int Id { get; set; } = 1;
        public int Order { get; set; } = 1;
        public string? Name { get; set; }
        public string? Identifier { get; set; }
        public string Role { get; set; } = "Autor";
        public string Type { get; set; } = "Docente";
        public string Affiliation { get; set; } = "Universidad Técnica de Ambato";
    }
}




