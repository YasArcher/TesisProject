@page "/articles/module/manual"
@page "/help/manual"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject NavigationManager Nav

<PageTitle>Manual | Produccion cientifica</PageTitle>

<div class="articles-manual-page h-full overflow-y-auto bg-page-bg">
    <div class="mx-auto w-full max-w-6xl p-4 md:p-6">
        <header class="articles-manual-hero rounded-lg border border-border bg-background p-5 shadow-sm md:p-6">
            <p class="text-xs font-bold uppercase tracking-wide text-primary">Guia operativa</p>
            <h1 class="mt-2 text-2xl font-bold text-foreground md:text-3xl">Manual rapido de articulos</h1>
            <p class="mt-3 max-w-3xl text-sm leading-6 text-muted">
                Resumen de las acciones principales por rol para operar el registro, seguimiento y revision de produccion cientifica.
            </p>
        </header>

        <section class="mt-5 grid gap-4 lg:grid-cols-3">
            @foreach (var role in RoleGuides)
            {
                <article class="articles-manual-step rounded-lg border border-border bg-background p-4 shadow-sm">
                    <span class="articles-manual-step-number">@role.Number</span>
                    <h2 class="mt-3 text-base font-bold text-foreground">@role.Title</h2>
                    <p class="mt-2 text-sm leading-6 text-muted">@role.Detail</p>
                    <button type="button" class="articles-manual-link mt-4" @onclick="() => Navigate(role.Route)">Abrir seccion</button>
                </article>
            }
        </section>

        <section class="articles-manual-panel mt-5 rounded-lg border border-border bg-background p-5 shadow-sm">
            <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
                <div class="max-w-3xl">
                    <p class="text-xs font-bold uppercase text-muted">Ruta recomendada</p>
                    <h2 class="mt-1 text-lg font-bold text-foreground">Secuencia de prueba del modulo</h2>
                    <p class="mt-2 text-sm leading-6 text-muted">
                        Revisa primero configuracion, luego registro individual o matriz, despues consulta el listado y finalmente valida las pantallas de workflow, reporteria e IA.
                    </p>
                </div>
                <button type="button" class="articles-manual-action rounded-lg px-4 py-2 text-sm font-semibold" @onclick="BackToArticles">
                    Volver a articulos
                </button>
            </div>

            <div class="articles-manual-route-grid mt-5">
                @foreach (var item in ModuleRoutes)
                {
                    <article class="articles-manual-route">
                        <div>
                            <span>@item.Group</span>
                            <strong>@item.Title</strong>
                            <p>@item.Detail</p>
                        </div>
                        <button type="button" @onclick="() => Navigate(item.Route)">Abrir</button>
                    </article>
                }
            </div>
        </section>

        <section class="articles-manual-panel mt-5 rounded-lg border border-border bg-background p-5 shadow-sm">
            <p class="text-xs font-bold uppercase text-muted">Criterios de revision</p>
            <h2 class="mt-1 text-lg font-bold text-foreground">Que verificar durante la fusion</h2>
            <div class="articles-manual-check-grid mt-4">
                @foreach (var check in VerificationChecks)
                {
                    <div class="articles-manual-check">
                        <span></span>
                        <p>@check</p>
                    </div>
                }
            </div>
        </section>
    </div>
</div>

@code {
    private void BackToArticles() => Nav.NavigateTo("/articles");
    private void Navigate(string route) => Nav.NavigateTo(route);

    private IReadOnlyList<RoleGuide> RoleGuides =>
    [
        new("1", "Autor", "Registra articulos de forma individual o por matriz y revisa observaciones cuando un envio requiere correccion.", "/articles/module/register"),
        new("2", "UODIDE", "Da seguimiento al caso, revisa datos del autor y prepara observaciones o derivacion al siguiente nivel.", "/articles/module/workflow"),
        new("3", "Area Tecnica", "Valida informacion final, revisa consistencia academica y confirma el cierre operativo del registro.", "/articles/module/workflow")
    ];

    private IReadOnlyList<ModuleRoute> ModuleRoutes =>
    [
        new("Base", "Configuracion", "Formularios, campos dinamicos, opciones y catalogos de articulos.", "/articles/module/configuration"),
        new("Registro", "Registro individual", "Formulario dinamico activo para crear articulos.", "/articles/module/register"),
        new("Registro", "Matriz", "Captura tabular y revision de campos obligatorios por fila.", "/articles/module/matrix"),
        new("Consulta", "Listado", "Visualizacion, filtros, tarjetas, tabla y detalle de articulos.", "/articles"),
        new("Seguimiento", "Workflow", "Bandeja integrada por roles y seguimiento del registro.", "/articles/module/workflow"),
        new("Datos", "Carga masiva", "Resumen de matrices, revision de calidad y preparacion de lotes.", "/articles/module/bulk-import"),
        new("Datos", "APIs externas", "Consulta preparada para proveedores academicos externos.", "/articles/module/external-apis"),
        new("Analitica", "Reporteria", "Indicadores iniciales y sincronizacion DW de articulos.", "/articles/module/reporting"),
        new("Analitica", "Inteligencia", "Prediccion y recomendacion sobre datos disponibles.", "/articles/module/intelligence")
    ];

    private IReadOnlyList<string> VerificationChecks =>
    [
        "La navegacion debe mantener el layout integrado de proyectos sin romper sus pantallas.",
        "Las acciones sin backend final deben verse bloqueadas y explicar el motivo al usuario.",
        "Las pantallas de articulos deben reutilizar servicios reales cuando existan contratos unificados.",
        "Los mensajes deben ser claros para usuario final y evitar errores tecnicos sin contexto."
    ];

    private sealed record RoleGuide(string Number, string Title, string Detail, string Route);
    private sealed record ModuleRoute(string Group, string Title, string Detail, string Route);
}
