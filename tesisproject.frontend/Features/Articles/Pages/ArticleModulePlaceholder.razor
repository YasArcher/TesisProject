@page "/articles/module/{ModuleKey}"
@inject NavigationManager Nav

<div class="articles-module-page articles-placeholder-page h-full overflow-y-auto bg-page-bg">
    <div class="mx-auto w-full max-w-5xl p-4 md:p-6">
        <header class="articles-placeholder-hero rounded-lg border border-border bg-background p-5 shadow-sm md:p-6">
            <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
                <div>
                    <p class="text-xs font-bold uppercase tracking-wide text-primary">Produccion cientifica</p>
                    <h1 class="mt-2 text-2xl font-bold text-foreground md:text-3xl">Modulo no disponible</h1>
                    <p class="mt-3 max-w-3xl text-sm leading-6 text-muted">
                        La ruta solicitada no corresponde a una pantalla activa del modulo de articulos dentro de la plataforma integrada.
                    </p>
                </div>
                <span class="articles-placeholder-status">Ruta no configurada</span>
            </div>
        </header>

        <section class="articles-workspace-panel mt-5 rounded-lg border border-border bg-background p-5 shadow-sm md:p-6">
            <div class="grid gap-5 lg:grid-cols-[1.1fr_0.9fr] lg:items-start">
                <div>
                    <span class="inline-flex rounded-lg bg-primary-subtle px-3 py-2 text-xs font-bold uppercase text-primary">
                        Integracion controlada
                    </span>
                    <h2 class="mt-4 text-lg font-bold text-foreground">@ModuleKey</h2>
                    <p class="mt-2 max-w-2xl text-sm leading-6 text-muted">
                        Si esta pantalla debe existir, primero debe agregarse como pagina propia en Features/Articles/Pages y enlazarse desde el sidebar con su capacidad correspondiente.
                    </p>

                    <div class="mt-5 flex flex-wrap gap-2">
                        <button type="button"
                                class="articles-placeholder-action rounded-lg px-4 py-2 text-sm font-semibold"
                                @onclick="BackToArticles">
                            Volver a articulos
                        </button>
                        <button type="button"
                                class="articles-placeholder-secondary rounded-lg px-4 py-2 text-sm font-semibold"
                                @onclick="GoToManual">
                            Ver manual
                        </button>
                    </div>
                </div>

                <div class="articles-placeholder-checklist rounded-lg border border-border p-4">
                    <h3 class="text-sm font-bold text-foreground">Rutas activas</h3>
                    <div class="mt-4 space-y-3">
                        @foreach (var item in ActiveRoutes)
                        {
                            <div class="articles-placeholder-check">
                                <span></span>
                                <button type="button" @onclick="() => Navigate(item.Route)">
                                    <strong>@item.Title</strong>
                                    <small>@item.Detail</small>
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </section>
    </div>
</div>

@code {
    [Parameter] public string ModuleKey { get; set; } = string.Empty;

    private IReadOnlyList<RouteHint> ActiveRoutes =>
    [
        new("Listado de articulos", "Consulta principal y detalle de registros.", "/articles"),
        new("Registro individual", "Formulario dinamico activo para crear articulos.", "/articles/module/register"),
        new("Matriz tabular", "Captura por filas y columnas configurables.", "/articles/module/matrix"),
        new("Configuracion", "Formularios, campos, opciones y catalogos.", "/articles/module/configuration"),
        new("Workflow", "Seguimiento de registros por rol.", "/articles/module/workflow"),
        new("Reporteria e IA", "Indicadores, sincronizacion e inteligencia inicial.", "/articles/module/reporting")
    ];

    private void BackToArticles() => Nav.NavigateTo("/articles");
    private void GoToManual() => Nav.NavigateTo("/articles/module/manual");
    private void Navigate(string route) => Nav.NavigateTo(route);

    private sealed record RouteHint(string Title, string Detail, string Route);
}
