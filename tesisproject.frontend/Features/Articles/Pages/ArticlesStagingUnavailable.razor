@page "/management/article-review-staging"
@page "/scientific-production/article-review-staging"
@page "/management/article-review-staging-frame"
@page "/scientific-production/article-review-staging-frame"
@page "/management/area-tecnica-review-staging"
@page "/scientific-production/area-tecnica-review-staging"
@page "/management/area-tecnica-review-staging-frame"
@page "/scientific-production/area-tecnica-review-staging-frame"
@page "/management/author-correction-staging"
@page "/scientific-production/author-correction-staging"
@page "/management/author-correction-staging-frame"
@page "/scientific-production/author-correction-staging-frame"
@page "/management/uodide-review-staging"
@page "/scientific-production/uodide-review-staging"
@page "/management/uodide-review-staging-frame"
@page "/scientific-production/uodide-review-staging-frame"
@using Microsoft.AspNetCore.Authorization
@using tesisproject.frontend.Services.Interfaces
@using tesisproject.shared.DTOs.MassRegistration
@attribute [Authorize]
@inject IRegistrationMatrixClient MatrixClient
@inject NavigationManager Nav

@* Modulo articulos: rutas de staging y revision protegidas dentro de la plataforma integrada. *@
<PageTitle>@CurrentContext.Title | Plataforma integrada</PageTitle>

<div class="articles-module-page articles-protected-page h-full min-h-0 overflow-y-auto bg-page-bg">
    <div class="mx-auto flex w-full max-w-5xl flex-col gap-5 p-4 md:p-6">
        <header class="articles-protected-hero overflow-hidden rounded-lg border border-border bg-background shadow-sm">
            <div class="articles-protected-hero-band border-b border-border px-5 py-5 text-white md:px-6">
                <p class="text-xs font-bold uppercase tracking-wide text-cyan-200">Produccion cientifica</p>
                <h1 class="mt-2 text-2xl font-bold md:text-3xl">@CurrentContext.Title</h1>
                <p class="mt-3 max-w-3xl text-sm leading-6 text-slate-300">
                    @CurrentContext.Description
                </p>
            </div>
        </header>

        <ArticlesModuleNav Title="Ruta protegida de revision y staging" />

        <section class="articles-protected-panel rounded-lg border border-border bg-background p-5 shadow-sm md:p-6">
            <div class="grid gap-5 lg:grid-cols-[minmax(0,1fr)_18rem] lg:items-start">
                <div>
                    <p class="text-xs font-bold uppercase text-muted">Ruta controlada</p>
                    <h2 class="mt-1 text-lg font-bold text-foreground">@CurrentContext.PanelTitle</h2>
                    <p class="mt-2 text-sm leading-6 text-muted">
                        @CurrentContext.PanelDetail
                    </p>
                    @if (BatchId.HasValue)
                    {
                        <div class="articles-protected-batch mt-4">
                            <span>Lote seleccionado</span>
                            <strong>@BatchId</strong>
                        </div>
                    }
                    <div class="mt-5 grid gap-3 md:grid-cols-3">
                        @foreach (var item in CurrentContext.Steps)
                        {
                            <article class="articles-protected-rule rounded-lg border border-border bg-page-bg p-4">
                                <span class="text-xs font-bold uppercase text-muted">@item.Scope</span>
                                <strong class="mt-2 block text-sm text-foreground">@item.Title</strong>
                                <p class="mt-2 text-xs leading-5 text-muted">@item.Detail</p>
                            </article>
                        }
                    </div>
                    <div class="mt-5 flex flex-wrap gap-2">
                        <button type="button" class="articles-protected-primary rounded-md bg-primary px-4 py-2 text-sm font-semibold text-white" @onclick="GoWorkflow">
                            Ir a workflow
                        </button>
                        @if (CurrentContext.ShowRegisterAction)
                        {
                            <button type="button" class="articles-protected-secondary rounded-md border border-border px-4 py-2 text-sm font-semibold text-foreground hover:bg-primary-subtle" @onclick="GoRegister">
                                Abrir registro
                            </button>
                        }
                        <button type="button" class="articles-protected-secondary rounded-md border border-border px-4 py-2 text-sm font-semibold text-foreground hover:bg-primary-subtle" @onclick="GoArticles">
                            Ver articulos
                        </button>
                        <button type="button" class="articles-protected-secondary rounded-md border border-border px-4 py-2 text-sm font-semibold text-foreground hover:bg-primary-subtle" @onclick="GoBulkImport">
                            Carga masiva
                        </button>
                    </div>
                </div>
                <aside class="articles-protected-aside rounded-lg border border-border bg-page-bg p-4">
                    <p class="text-xs font-bold uppercase text-muted">Estado</p>
                    <strong class="mt-2 block text-lg text-foreground">@CurrentContext.Status</strong>
                    <p class="mt-2 text-sm text-muted">@CurrentContext.StatusDetail</p>
                </aside>
            </div>
        </section>

        @if (BatchId.HasValue)
        {
            <section class="articles-review-panel rounded-lg border border-border bg-background p-5 shadow-sm md:p-6">
                @if (_loadingMatrix)
                {
                    <div class="articles-review-empty">
                        <div class="mx-auto h-8 w-8 animate-spin rounded-full border-4 border-primary border-r-transparent"></div>
                        <p>Cargando lote enviado...</p>
                    </div>
                }
                else if (!string.IsNullOrWhiteSpace(_matrixError))
                {
                    <div class="articles-review-empty articles-review-empty--error">
                        <h2>No fue posible cargar el lote</h2>
                        <p>@_matrixError</p>
                        <button type="button" class="articles-protected-primary rounded-md px-4 py-2 text-sm font-semibold text-white" @onclick="LoadMatrixAsync">
                            Intentar nuevamente
                        </button>
                    </div>
                }
                else if (_matrix is not null)
                {
                    <div class="flex flex-col gap-4 border-b border-border pb-4 lg:flex-row lg:items-start lg:justify-between">
                        <div>
                            <p class="text-xs font-bold uppercase text-muted">Detalle del lote</p>
                            <h2 class="mt-1 text-xl font-bold text-foreground">@_matrix.Summary.Name</h2>
                            <p class="mt-2 max-w-3xl text-sm text-muted">
                                Revisa las filas enviadas desde la matriz. Esta vista permite validar visualmente el contenido antes de continuar con acciones de workflow.
                            </p>
                        </div>
                        <span class="articles-review-status">@StatusLabel(_matrix.Summary.Status)</span>
                    </div>

                    <div class="articles-review-metrics mt-4">
                        <article>
                            <span>Filas</span>
                            <strong>@_matrix.Rows.Count</strong>
                        </article>
                        <article>
                            <span>Columnas</span>
                            <strong>@_matrix.Columns.Count</strong>
                        </article>
                        <article>
                            <span>Obligatorios</span>
                            <strong>@_matrix.Columns.Count(x => x.IsRequired)</strong>
                        </article>
                        <article>
                            <span>Completitud</span>
                            <strong>@CompletionRate%</strong>
                        </article>
                    </div>

                    <div class="articles-review-table-wrap mt-5">
                        <table class="articles-review-table">
                            <thead>
                                <tr>
                                    <th>Fila</th>
                                    @foreach (var column in _matrix.Columns)
                                    {
                                        <th>
                                            <span>@column.FieldLabel</span>
                                            @if (column.IsRequired)
                                            {
                                                <em>Obligatorio</em>
                                            }
                                        </th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in _matrix.Rows)
                                {
                                    <tr @key="row.RegistrationMatrixRowId">
                                        <td class="articles-review-row-number">@row.RowNumber</td>
                                        @foreach (var column in _matrix.Columns)
                                        {
                                            var value = GetCellValue(row, column.FieldId);
                                            <td class="@(column.IsRequired && string.IsNullOrWhiteSpace(value) ? "is-missing" : null)">
                                                @(string.IsNullOrWhiteSpace(value) ? "No informado" : value)
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="articles-review-actions">
                        <button type="button" class="articles-protected-primary rounded-md px-4 py-2 text-sm font-semibold text-white" @onclick="GoWorkflow">
                            Volver al workflow
                        </button>
                        <button type="button" class="articles-protected-secondary rounded-md border border-border px-4 py-2 text-sm font-semibold text-foreground" @onclick="GoMatrix">
                            Abrir matriz
                        </button>
                    </div>
                }
            </section>
        }
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "batchId")]
    public int? BatchId { get; set; }

    private RegistrationMatrixDetailDto? _matrix;
    private bool _loadingMatrix;
    private string? _matrixError;

    private int CompletionRate
    {
        get
        {
            if (_matrix is null || _matrix.Rows.Count == 0 || _matrix.Columns.Count == 0)
                return 0;

            var total = _matrix.Rows.Count * _matrix.Columns.Count;
            var filled = _matrix.Rows.Sum(row => _matrix.Columns.Count(column => !string.IsNullOrWhiteSpace(GetCellValue(row, column.FieldId))));
            return (int)Math.Round(filled * 100m / total, MidpointRounding.AwayFromZero);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (BatchId.HasValue)
            await LoadMatrixAsync();
    }

    private async Task LoadMatrixAsync()
    {
        if (!BatchId.HasValue)
            return;

        _loadingMatrix = true;
        _matrixError = null;
        var result = await MatrixClient.GetMatrixAsync(BatchId.Value);
        if (result.Success && result.Data is not null)
            _matrix = result.Data;
        else
            _matrixError = result.Message ?? "No se pudo obtener el detalle del lote seleccionado.";
        _loadingMatrix = false;
    }

    private void GoWorkflow() => Nav.NavigateTo("/articles/module/workflow");
    private void GoArticles() => Nav.NavigateTo("/articles");
    private void GoRegister() => Nav.NavigateTo("/articles/module/register");
    private void GoBulkImport() => Nav.NavigateTo("/articles/module/bulk-import");
    private void GoMatrix() => Nav.NavigateTo("/articles/module/matrix");

    private static string? GetCellValue(RegistrationMatrixRowDto row, int fieldId)
        => row.Cells.FirstOrDefault(x => x.FieldId == fieldId)?.RawValue;

    private static string StatusLabel(string? status)
        => status switch
        {
            "SubmittedToWorkflow" => "En revision",
            "Submitted" => "Enviado",
            "Draft" => "Borrador",
            _ when !string.IsNullOrWhiteSpace(status) => status,
            _ => "Sin estado"
        };

    private ProtectedContext CurrentContext
    {
        get
        {
            var uri = Nav.ToBaseRelativePath(Nav.Uri).ToLowerInvariant();
            if (uri.Contains("author-correction"))
            {
                return new(
                    "Correccion de envio",
                    "Esta ruta acompana los lotes devueltos al autor. Cuando el caso tenga correcciones disponibles, el flujo debe regresar al panel de revision del autor para continuar sin perder trazabilidad.",
                    "Correccion pendiente de flujo",
                    "El autor debe revisar observaciones, corregir los registros necesarios y volver al panel de envios para reenviar el caso.",
                    "Esperando correccion",
                    "Usa workflow para ubicar el envio devuelto y continuar desde la accion habilitada.",
                    true,
                    [
                        new("Observacion", "Revisar motivo", "La correccion parte de la observacion enviada por UODIDE o Area Tecnica."),
                        new("Datos", "Ajustar registro", "Solo deben modificarse los campos solicitados o incompletos del lote."),
                        new("Reenvio", "Volver al flujo", "Al terminar, el envio debe regresar al panel de revision para ser reenviado.")
                    ]);
            }

            if (uri.Contains("area-tecnica"))
            {
                return new(
                    "Revision tecnica final",
                    "Esta ruta pertenece al cierre tecnico del registro. La aprobacion final debe estar disponible solo cuando el caso haya sido revisado y no existan errores activos.",
                    "Procesamiento final protegido",
                    "Area Tecnica valida consistencia, puede devolver observaciones o finalizar el registro cuando la informacion esta lista.",
                    "Validacion final",
                    "Ingresa desde workflow para conservar el caso, el rol y las acciones habilitadas.",
                    false,
                    [
                        new("Caso", "Abrir revision", "Antes de aprobar debe revisarse el registro o staging asociado al envio."),
                        new("Calidad", "Confirmar datos", "La validacion final verifica revista, DOI, autores y campos academicos."),
                        new("Cierre", "Procesar registro", "El procesamiento definitivo se ejecuta unicamente desde el flujo autorizado.")
                    ]);
            }

            if (uri.Contains("uodide"))
            {
                return new(
                    "Revision UODIDE",
                    "Esta ruta pertenece a la revision inicial institucional. La accion debe abrirse desde workflow despues de tomar el caso correspondiente.",
                    "Revision inicial protegida",
                    "UODIDE toma el caso, revisa el registro del autor y decide si deriva a Area Tecnica o devuelve observaciones.",
                    "Revision inicial",
                    "Vuelve al workflow para tomar el caso y habilitar la accion correcta.",
                    false,
                    [
                        new("Asignacion", "Tomar caso", "La revision inicia cuando UODIDE confirma que asumira el lote."),
                        new("Revision", "Ver registro", "Debe abrirse el registro del autor antes de validar el envio."),
                        new("Decision", "Derivar o devolver", "La salida depende de las observaciones encontradas durante la revision.")
                    ]);
            }

            return new(
                "Revision protegida",
                "Esta ruta pertenece al flujo operativo de revision de articulos. Se mantiene protegida para evitar acciones incompletas fuera del workflow.",
                "Procesamiento bloqueado de forma segura",
                "Para proteger el flujo, esta pantalla no permite validar, corregir ni procesar hasta que el caso tenga una accion disponible para el rol actual.",
                "Bloqueado seguro",
                "Evita acciones incompletas mientras el flujo habilita la revision correspondiente.",
                false,
                [
                    new("Autor", "Correcciones", "El retorno a correccion debe abrir solo cuando exista un envio devuelto y editable."),
                    new("UODIDE", "Revision inicial", "La validacion debe depender de tomar el caso y abrir el registro antes de aprobar."),
                    new("Area tecnica", "Validacion final", "El procesamiento definitivo debe ejecutarse solo con registros revisados y sin errores activos.")
                ]);
        }
    }

    private sealed record ProtectedStep(string Scope, string Title, string Detail);

    private sealed record ProtectedContext(
        string Title,
        string Description,
        string PanelTitle,
        string PanelDetail,
        string Status,
        string StatusDetail,
        bool ShowRegisterAction,
        IReadOnlyList<ProtectedStep> Steps);
}
