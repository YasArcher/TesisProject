@page "/articles/module/support"
@page "/management/support"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject NavigationManager Nav

<PageTitle>Soporte | Produccion cientifica</PageTitle>

<div class="articles-support-page h-full overflow-y-auto bg-page-bg">
    <div class="mx-auto w-full max-w-6xl p-4 md:p-6">
        <header class="articles-support-hero rounded-lg border border-border bg-background p-5 shadow-sm md:p-6">
            <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
                <div>
                    <p class="text-xs font-bold uppercase tracking-wide text-primary">Soporte y cuenta</p>
                    <h1 class="mt-2 text-2xl font-bold text-foreground md:text-3xl">Centro de ayuda institucional</h1>
                    <p class="mt-3 max-w-3xl text-sm leading-6 text-muted">
                        Canal de referencia para reportar incidencias del registro, revision, workflow o procesamiento de articulos cientificos.
                    </p>
                </div>
                <div class="articles-support-status rounded-lg border border-primary/20 bg-primary-subtle px-4 py-3">
                    <span class="block text-xs font-semibold uppercase tracking-wide text-primary">Estado</span>
                    <strong class="mt-1 block text-sm text-foreground">Modulo disponible</strong>
                </div>
            </div>
        </header>

        <section class="mt-5 grid gap-4 md:grid-cols-2 xl:grid-cols-4">
            <article class="articles-support-card rounded-lg border border-border bg-background p-4 shadow-sm">
                <div class="articles-support-icon">?</div>
                <h2 class="mt-3 text-base font-bold text-foreground">Incidencias</h2>
                <p class="mt-2 text-sm leading-6 text-muted">Incluye usuario, rol, articulo, lote y mensaje visible para ubicar rapidamente el punto del flujo.</p>
            </article>
            <article class="articles-support-card rounded-lg border border-border bg-background p-4 shadow-sm">
                <div class="articles-support-icon">✓</div>
                <h2 class="mt-3 text-base font-bold text-foreground">Flujo operativo</h2>
                <p class="mt-2 text-sm leading-6 text-muted">Verifica si el caso pertenece a Autor, UODIDE o Area Tecnica antes de escalarlo.</p>
            </article>
            <article class="articles-support-card rounded-lg border border-border bg-background p-4 shadow-sm">
                <div class="articles-support-icon">i</div>
                <h2 class="mt-3 text-base font-bold text-foreground">Contacto</h2>
                <p class="mt-2 text-sm leading-6 text-muted">Para soporte de cuenta o acceso, solicita ayuda al administrador institucional o DITIC.</p>
            </article>
            <article class="articles-support-card rounded-lg border border-border bg-background p-4 shadow-sm">
                <div class="articles-support-icon">!</div>
                <h2 class="mt-3 text-base font-bold text-foreground">Contrasenas</h2>
                <p class="mt-2 text-sm leading-6 text-muted">El sistema no restablece claves directamente. El usuario debe solicitar soporte institucional.</p>
            </article>
        </section>

        <section class="articles-support-panel mt-5 rounded-lg border border-border bg-background p-5 shadow-sm">
            <div class="grid gap-4 lg:grid-cols-[1.3fr_0.7fr] lg:items-center">
                <div>
                    <h2 class="text-lg font-bold text-foreground">Antes de reportar</h2>
                    <p class="mt-2 text-sm leading-6 text-muted">
                        Revisa el modulo, la accion realizada y si el mensaje aparece durante registro, revision, correccion o procesamiento final.
                    </p>
                </div>
                <div class="articles-support-actions">
                    <button type="button" class="articles-support-action rounded-lg px-4 py-2 text-sm font-semibold" @onclick="GoToManual">
                        Ver manual rapido
                    </button>
                    <button type="button" class="articles-support-secondary rounded-lg px-4 py-2 text-sm font-semibold" @onclick="GoToWorkflow">
                        Revisar workflow
                    </button>
                    <button type="button" class="articles-support-secondary rounded-lg px-4 py-2 text-sm font-semibold" @onclick="GoToSecurity">
                        Ver accesos
                    </button>
                </div>
            </div>
        </section>

        <section class="articles-support-panel mt-5 rounded-lg border border-border bg-background p-5 shadow-sm">
            <div class="grid gap-4 md:grid-cols-3">
                @foreach (var item in SupportRoutes)
                {
                    <article class="articles-support-route">
                        <span>@item.Scope</span>
                        <strong>@item.Title</strong>
                        <p>@item.Detail</p>
                    </article>
                }
            </div>
        </section>
    </div>
</div>

@code {
    private void GoToManual() => Nav.NavigateTo("/articles/module/manual");
    private void GoToWorkflow() => Nav.NavigateTo("/articles/module/workflow");
    private void GoToSecurity() => Nav.NavigateTo("/articles/module/security");

    private IReadOnlyList<SupportRoute> SupportRoutes =>
    [
        new("Registro", "Formulario y matriz", "Validar campos obligatorios, catalogos activos, formulario vigente y mensajes de confirmacion."),
        new("Revision", "Autor, UODIDE y Area tecnica", "Revisar si el caso fue tomado, devuelto, corregido o bloqueado por falta de validacion."),
        new("Analitica", "Reporteria e IA", "Confirmar que los articulos procesados fueron sincronizados antes de interpretar indicadores.")
    ];

    private sealed record SupportRoute(string Scope, string Title, string Detail);
}
