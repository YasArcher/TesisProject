@using tesisproject.shared.DTOs.Articles
@namespace tesisproject.frontend.Features.Articles.Components

@* Modulo articulos: tarjeta de consulta integrada al frontend institucional. *@
@if (Item is not null)
{
    <article class="articles-article-card article-summary-card rounded-lg border border-border bg-background p-4 shadow-sm transition hover:border-primary/40 hover:shadow-md">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
            <div class="min-w-0">
                <div class="mb-2 flex flex-wrap gap-2">
                    <span class="rounded-full bg-primary-subtle px-2.5 py-1 text-xs font-semibold text-primary">@Display(Item.Year)</span>
                    <span class="rounded-full bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-700">@Display(Item.PublicationStatusName)</span>
                    @if (Item.IsOpenAccess)
                    {
                        <span class="rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-semibold text-emerald-700">Acceso abierto</span>
                    }
                    @if (Item.IsProjectResult)
                    {
                        <span class="rounded-full bg-cyan-50 px-2.5 py-1 text-xs font-semibold text-cyan-700">Proyecto</span>
                    }
                </div>
                <h2 class="line-clamp-2 text-base font-bold text-foreground">@Display(Item.Title)</h2>
                <p class="mt-2 text-sm text-muted">DOI: @Display(Item.Doi)</p>
            </div>
            <button type="button"
                    class="shrink-0 rounded-md border border-border px-3 py-2 text-sm font-semibold text-primary hover:bg-primary-subtle"
                    @onclick="ViewMoreAsync">
                Ver detalle
            </button>
        </div>

        <dl class="mt-4 grid grid-cols-1 gap-3 border-t border-border pt-4 sm:grid-cols-2">
            <div>
                <dt class="text-xs font-semibold text-muted">Revista</dt>
                <dd class="mt-1 text-sm text-foreground">@Display(Item.VenueName)</dd>
            </div>
            <div>
                <dt class="text-xs font-semibold text-muted">Indexacion</dt>
                <dd class="mt-1 text-sm text-foreground">@Display(Item.IndexingSourceName)</dd>
            </div>
            <div>
                <dt class="text-xs font-semibold text-muted">Facultad</dt>
                <dd class="mt-1 text-sm text-foreground">@Display(Item.FacultyName)</dd>
            </div>
            <div>
                <dt class="text-xs font-semibold text-muted">Autores</dt>
                <dd class="mt-1 text-sm text-foreground">@DisplayAuthors(Item.AuthorsSummary)</dd>
            </div>
        </dl>
    </article>
}

@code {
    [Parameter, EditorRequired] public ArticleListItemDto Item { get; set; } = default!;
    [Parameter] public EventCallback<int> OnViewMore { get; set; }

    private Task ViewMoreAsync() => OnViewMore.InvokeAsync(Item.Id);

    private static string Display(object? value)
        => string.IsNullOrWhiteSpace(value?.ToString()) ? "No informado" : value.ToString()!;

    private static string DisplayAuthors(string? value)
        => string.IsNullOrWhiteSpace(value) ? "Sin autores informados" : value;
}
