@using tesisproject.shared.DTOs.Articles
@namespace tesisproject.frontend.Features.Articles.Components

@* Modulo articulos: modal de detalle compatible con los servicios disponibles. *@
@if (Open)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4"
         style="background-color: rgba(15, 23, 42, 0.62);"
         @onclick="OnClose">
        <section class="articles-detail-modal w-full max-w-4xl overflow-hidden rounded-lg bg-background shadow-2xl"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="article-detail-title"
                 @onclick:stopPropagation="true">
            <header class="flex items-start justify-between gap-4 border-b border-border bg-slate-950 p-5 text-white">
                <div>
                    <p class="text-sm font-semibold text-cyan-200">Detalle del articulo</p>
                    <h2 id="article-detail-title" class="mt-1 line-clamp-2 text-xl font-bold">
                        @(Loading ? "Consultando..." : Display(Detail?.Title))
                    </h2>
                </div>
                <button type="button"
                        class="rounded-md border border-white/20 px-3 py-2 text-sm font-semibold text-white hover:bg-white/10"
                        @onclick="OnClose">
                    Cerrar
                </button>
            </header>

            <div class="max-h-[72vh] overflow-y-auto p-5">
                @if (Loading)
                {
                    <p class="text-sm text-muted">Cargando informacion...</p>
                }
                else if (!string.IsNullOrWhiteSpace(Error))
                {
                    <p class="text-sm text-muted">@Error</p>
                }
                else if (Detail is not null)
                {
                    <dl class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
                        <InfoTile Label="DOI" Value="@Display(Detail.Doi)" />
                        <InfoTile Label="Anio" Value="@Display(Detail.Year)" />
                        <InfoTile Label="Fecha de publicacion" Value="@DisplayDate(Detail.PublishedAt)" />
                        <InfoTile Label="Paginas" Value="@Display(Detail.PageCount)" />
                        <InfoTile Label="Revista" Value="@Display(Detail.VenueName)" />
                        <InfoTile Label="ISSN" Value="@Display(Detail.IssnCode)" />
                        <InfoTile Label="Volumen" Value="@Display(Detail.VolumeNumber)" />
                        <InfoTile Label="Numero" Value="@Display(Detail.IssueNumber)" />
                        <InfoTile Label="Cuartil" Value="@Display(Detail.Quartile)" />
                        <InfoTile Label="SJR" Value="@Display(Detail.Sjr)" />
                        <InfoTile Label="Facultad" Value="@Display(Detail.FacultyName)" />
                        <InfoTile Label="Filiacion" Value="@Display(Detail.Filiacion)" />
                        <InfoTile Label="Acceso abierto" Value="@(Detail.IsOpenAccess ? "Si" : "No")" />
                        <InfoTile Label="Resultado de proyecto" Value="@(Detail.IsProjectResult ? "Si" : "No")" />
                        <InfoTile Label="Componente intercultural" Value="@(Detail.HasInterculturalComponent ? "Si" : "No")" />
                    </dl>

                    <div class="mt-5 grid grid-cols-1 gap-3 md:grid-cols-2">
                        <div class="rounded-md border border-border bg-page-bg px-3 py-3">
                            <p class="text-xs font-semibold text-muted">Enlaces</p>
                            <div class="mt-2 flex flex-wrap gap-2">
                                @if (!string.IsNullOrWhiteSpace(Detail.PublicationUrl))
                                {
                                    <a href="@Detail.PublicationUrl" target="_blank" rel="noopener noreferrer" class="rounded-md border border-border bg-background px-3 py-1.5 text-xs font-semibold text-primary hover:bg-primary-subtle">Publicacion</a>
                                }
                                @if (!string.IsNullOrWhiteSpace(Detail.JournalUrl))
                                {
                                    <a href="@Detail.JournalUrl" target="_blank" rel="noopener noreferrer" class="rounded-md border border-border bg-background px-3 py-1.5 text-xs font-semibold text-primary hover:bg-primary-subtle">Revista</a>
                                }
                                @if (!string.IsNullOrWhiteSpace(Detail.EvidenceUrl))
                                {
                                    <a href="@Detail.EvidenceUrl" target="_blank" rel="noopener noreferrer" class="rounded-md border border-border bg-background px-3 py-1.5 text-xs font-semibold text-primary hover:bg-primary-subtle">Evidencia</a>
                                }
                                @if (string.IsNullOrWhiteSpace(Detail.PublicationUrl) && string.IsNullOrWhiteSpace(Detail.JournalUrl) && string.IsNullOrWhiteSpace(Detail.EvidenceUrl))
                                {
                                    <span class="text-sm text-muted">Sin enlaces informados.</span>
                                }
                            </div>
                        </div>
                        <div class="rounded-md border border-border bg-page-bg px-3 py-3">
                            <p class="text-xs font-semibold text-muted">Contexto academico</p>
                            <p class="mt-2 text-sm text-foreground">@Display(Detail.GroupName)</p>
                            <p class="mt-1 text-xs text-muted">Evento: @Display(Detail.EventName)</p>
                            <p class="mt-1 text-xs text-muted">Memoria: @Display(Detail.ProceedingsName ?? Detail.Proceedings)</p>
                        </div>
                    </div>

                    <div class="mt-5 border-t border-border pt-4">
                        <h3 class="text-sm font-bold text-foreground">Participantes</h3>
                        @if (Detail.Participants is { Count: > 0 })
                        {
                            <div class="mt-3 grid grid-cols-1 gap-2 sm:grid-cols-2">
                                @foreach (var participant in Detail.Participants.OrderBy(x => x.Index))
                                {
                                    <div class="rounded-md border border-border bg-page-bg px-3 py-2">
                                        <span class="text-xs font-semibold text-muted">Orden @participant.Index</span>
                                        <p class="text-sm font-semibold text-foreground">@Display(participant.Nombre)</p>
                                        <p class="text-xs text-muted">@Display(participant.Participacion)</p>
                                        <p class="text-xs text-muted">Identificacion: @Display(participant.Identificacion)</p>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="mt-2 text-sm text-muted">Sin participantes informados.</p>
                        }
                    </div>

                    @if (Detail.Indexings is { Count: > 0 })
                    {
                        <div class="mt-5 border-t border-border pt-4">
                            <h3 class="text-sm font-bold text-foreground">Indexaciones</h3>
                            <div class="mt-2 flex flex-wrap gap-2">
                                @foreach (var indexing in Detail.Indexings)
                                {
                                    <span class="rounded-full bg-primary-subtle px-3 py-1 text-xs font-semibold text-primary">@indexing.IndexingSourceName</span>
                                }
                            </div>
                        </div>
                    }

                    @if (Detail.DynamicFields.Count > 0)
                    {
                        <div class="mt-5 border-t border-border pt-4">
                            <h3 class="text-sm font-bold text-foreground">Informacion adicional</h3>
                            <dl class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-2">
                                @foreach (var field in Detail.DynamicFields)
                                {
                                    <div class="rounded-md border border-border bg-page-bg px-3 py-2">
                                        <dt class="text-xs font-semibold text-muted">@field.FieldLabel</dt>
                                        <dd class="mt-1 text-sm text-foreground">@Display(field.DisplayValue)</dd>
                                        @if (!string.IsNullOrWhiteSpace(field.HelpText))
                                        {
                                            <dd class="mt-1 text-xs text-muted">@field.HelpText</dd>
                                        }
                                    </div>
                                }
                            </dl>
                        </div>
                    }
                }
            </div>
        </section>
    </div>
}

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public bool Loading { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter] public ArticleDetailDto? Detail { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private static string Display(object? value)
        => string.IsNullOrWhiteSpace(value?.ToString()) ? "No informado" : value.ToString()!;

    private static string DisplayDate(DateTime? value)
        => value?.ToString("dd/MM/yyyy") ?? "No informada";
}
