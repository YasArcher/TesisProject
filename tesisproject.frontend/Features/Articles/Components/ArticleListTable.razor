@using tesisproject.shared.DTOs.Articles
@namespace tesisproject.frontend.Features.Articles.Components

<div class="rounded-3xl border border-[#d4d4d4] bg-white shadow-sm overflow-hidden">
    <table class="min-w-full text-sm">
        <thead class="bg-[#1a2b2b]/5 text-xs uppercase text-[#1a2b2b]/80">
            <tr>
                <th class="px-4 py-3 text-left">Título publicación</th>
                <th class="px-4 py-3 text-left">DOI</th>
                <th class="px-4 py-3 text-left">Estado</th>
                <th class="px-4 py-3 text-left">Revista / Evento</th>
                <th class="px-4 py-3 text-left">ISSN</th>
                <th class="px-4 py-3 text-left">Fuente de indexación</th>
                <th class="px-4 py-3 text-right">Acciones</th>
            </tr>
        </thead>

        <tbody class="divide-y divide-slate-100">
            @if (Items is null || !Items.Any())
            {
                <tr>
                    <td colspan="7" class="px-4 py-6 text-center text-xs text-slate-500">
                        No hay artículos para mostrar.
                    </td>
                </tr>
            }
            else
            {
                @foreach (var item in Items)
                {
                    <tr class="hover:bg-slate-50/60 transition-colors">
                        <!-- Título publicación -->
                        <td class="px-4 py-3 align-top">
                            <div class="text-sm font-semibold text-slate-900 line-clamp-2">
                                @item.Title
                            </div>
                        </td>

                        <!-- DOI -->
                        <td class="px-4 py-3 align-top">
                            @if (!string.IsNullOrWhiteSpace(item.Doi))
                            {
                                <span class="text-xs text-slate-700 break-all">
                                    @item.Doi
                                </span>
                            }
                            else
                            {
                                <span class="text-xs text-slate-400">—</span>
                            }
                        </td>

                        <!-- Estado -->
                        <td class="px-4 py-3 align-top">
                            @if (!string.IsNullOrWhiteSpace(item.PublicationStatusName))
                            {
                                <span class="inline-flex items-center rounded-full bg-slate-100 px-2 py-0.5 text-[11px] font-medium text-slate-800">
                                    @item.PublicationStatusName
                                </span>
                            }
                            else
                            {
                                <span class="text-xs text-slate-400">Sin estado</span>
                            }
                        </td>

                        <!-- Revista / Evento -->
                        <td class="px-4 py-3 align-top">
                            @if (!string.IsNullOrWhiteSpace(item.VenueName))
                            {
                                <span class="text-xs text-slate-800 line-clamp-2">
                                    @item.VenueName
                                </span>
                            }
                            else
                            {
                                <span class="text-xs text-slate-400">No registrado</span>
                            }
                        </td>

                        <!-- ISSN -->
                        <td class="px-4 py-3 align-top">
                            @if (!string.IsNullOrWhiteSpace(item.Issn))
                            {
                                <span class="text-xs text-slate-800 font-mono">
                                    @item.Issn
                                </span>
                            }
                            else
                            {
                                <span class="text-xs text-slate-400">—</span>
                            }
                        </td>

                        <!-- Fuente de indexación -->
                        <td class="px-4 py-3 align-top">
                            @if (!string.IsNullOrWhiteSpace(item.IndexingSourceName))
                            {
                                <span class="text-xs text-slate-800">
                                    @item.IndexingSourceName
                                </span>
                            }
                            else
                            {
                                <span class="text-xs text-slate-400">No especificada</span>
                            }
                        </td>

                        <!-- Acciones -->
                        <td class="px-4 py-3 align-top text-right">
                            <div class="inline-flex flex-col items-end gap-1 sm:flex-row sm:items-center sm:justify-end">
                                <button type="button"
                                        class="rounded-lg border border-slate-300 bg-white px-2.5 py-1 text-[11px] font-medium text-slate-700 shadow-sm hover:bg-slate-50"
                                        @onclick="@(() => OnViewMore.InvokeAsync(item))">
                                    Ver
                                </button>

                                @if (CanEdit)
                                {
                                    <button type="button"
                                            class="rounded-lg bg-[#1a2b2b] px-2.5 py-1 text-[11px] font-medium text-white shadow-sm hover:bg-[#122020]"
                                            @onclick="@(() => OnEdit.InvokeAsync(item.Id))">
                                        Editar
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@code {
    [Parameter] public IEnumerable<ArticleListItemDto> Items { get; set; } = Enumerable.Empty<ArticleListItemDto>();
    [Parameter] public EventCallback<ArticleListItemDto> OnViewMore { get; set; }
    [Parameter] public EventCallback<int> OnEdit { get; set; }
    [Parameter] public bool CanEdit { get; set; }
}
