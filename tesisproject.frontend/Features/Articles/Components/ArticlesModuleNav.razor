@using Microsoft.AspNetCore.Components.Routing

@* Modulo articulos: navegacion compacta para mantener orientado al usuario dentro de la fusion. *@
<nav class="@($"articles-module-nav rounded-lg border border-border bg-background p-3 shadow-sm {Class}")" aria-label="Navegacion del modulo de articulos">
    <div class="flex flex-col gap-3 xl:flex-row xl:items-center xl:justify-between">
        <div class="min-w-0">
            <p class="text-xs font-bold uppercase text-muted">@Eyebrow</p>
            <h2 class="mt-1 text-base font-bold text-foreground">@Title</h2>
        </div>
        <div class="articles-module-nav__rail">
            @foreach (var item in Items)
            {
                <NavLink class="articles-module-nav__item"
                         ActiveClass="articles-module-nav__item--active"
                         href="@item.Route"
                         Match="@item.Match">
                    <span>@item.Step</span>
                    <strong>@item.Label</strong>
                </NavLink>
            }
        </div>
    </div>
</nav>

@code {
    [Parameter] public string Eyebrow { get; set; } = "Produccion cientifica";
    [Parameter] public string Title { get; set; } = "Flujo operativo de articulos";
    [Parameter] public string? Class { get; set; }

    private static readonly IReadOnlyList<NavItem> Items =
    [
        new("01", "Listado", "/articles", NavLinkMatch.All),
        new("02", "Registro", "/articles/module/register", NavLinkMatch.Prefix),
        new("03", "Matriz", "/articles/module/matrix", NavLinkMatch.Prefix),
        new("04", "Workflow", "/articles/module/workflow", NavLinkMatch.Prefix),
        new("05", "Config.", "/articles/module/configuration", NavLinkMatch.Prefix),
        new("06", "APIs", "/articles/module/external-apis", NavLinkMatch.Prefix),
        new("07", "Ingesta", "/articles/module/external-ingestion", NavLinkMatch.Prefix),
        new("08", "Carga", "/articles/module/bulk-import", NavLinkMatch.Prefix),
        new("09", "Reporteria", "/articles/module/reporting", NavLinkMatch.Prefix),
        new("10", "IA", "/articles/module/intelligence", NavLinkMatch.Prefix)
    ];

    private sealed record NavItem(string Step, string Label, string Route, NavLinkMatch Match);
}
