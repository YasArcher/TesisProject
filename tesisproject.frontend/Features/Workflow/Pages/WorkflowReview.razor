            DeclineCaseValidationMessage = "La observación para el autor es obligatoria.";
            return;
        }

        try
        {
            IsSubmittingAction = true;
            var updated = await WorkflowClient.DeclineAsync(SelectedInboxItem.ImportBatchId, new WorkflowActionRequest
            {
                Comments = $"[Para autor] {DeclineCaseComment.Trim()}"
            });

            if (updated is not null)
            {
                SelectedWorkflow = updated;
                SuccessMessage = "El caso fue devuelto al autor con la observación registrada.";
            }

            IsDeclineCaseModalOpen = false;
            DeclineCaseComment = string.Empty;
            await RefreshInboxesAsync();
        }
        catch (Exception ex)
        {
