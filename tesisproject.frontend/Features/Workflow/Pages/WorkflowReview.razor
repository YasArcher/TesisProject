    private bool MatchesAreaTecnicaFilter(WorkflowInboxItemDto item)
    {
        var matchesSearch = string.IsNullOrWhiteSpace(AreaTecnicaSearchTerm)
            || (item.BatchCode?.Contains(AreaTecnicaSearchTerm, StringComparison.OrdinalIgnoreCase) ?? false)
            || (item.SubmittedByUserName?.Contains(AreaTecnicaSearchTerm, StringComparison.OrdinalIgnoreCase) ?? false);

        if (!matchesSearch)
        {
            return false;
        }

        return AreaTecnicaStatusFilter switch
        {
            "pending" => string.IsNullOrWhiteSpace(item.AssignedToUserId) && !item.CanProcessBatch,
            "reviewing" => !string.IsNullOrWhiteSpace(item.AssignedToUserId) && !item.CanProcessBatch,
            "returned" => string.Equals(item.WorkflowStatus, "Returned", StringComparison.OrdinalIgnoreCase),
            "ready" => item.CanProcessBatch || string.Equals(item.WorkflowStatus, "Approved", StringComparison.OrdinalIgnoreCase),
            _ => true
        };
    }

