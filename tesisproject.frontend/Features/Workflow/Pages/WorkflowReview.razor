    private async Task RefreshInboxesAsync()
    {
        AuthorInbox = CanSeeAuthorInbox
            ? await WorkflowClient.GetAuthorInboxAsync()
            : new List<WorkflowInboxItemDto>();

        ReviewInbox = CanSeeUodideInbox || CanSeeAreaTecnicaInbox || IsAdminExperience
            ? await WorkflowClient.GetReviewInboxAsync()
            : new List<WorkflowInboxItemDto>();

        if (SelectedInboxItem is not null)
        {
            SelectedInboxItem = FindInboxItemByBatchId(SelectedInboxItem.ImportBatchId);
            SyncInboxPermissions();
        }
    }

    private WorkflowInboxItemDto? FindInboxItemByBatchId(int batchId)
        => AuthorInbox.Concat(ReviewInbox).FirstOrDefault(x => x.ImportBatchId == batchId);

    private async Task RefreshSelectedWorkflowContextAsync()
    {
        if (SelectedInboxItem is null)
        {
            return;
        }

        var batchId = SelectedInboxItem.ImportBatchId;
        await RefreshInboxesAsync();
        SelectedInboxItem = FindInboxItemByBatchId(batchId);
        SelectedWorkflow = await WorkflowClient.GetBatchWorkflowAsync(batchId);
        if (SelectedInboxItem is null)
        {
            IsIntegratedStagingPanelOpen = false;
            StopStagingRefreshLoop();
        }

        await InvokeAsync(StateHasChanged);
    }

    private void StartStagingRefreshLoop()
    {
        StopStagingRefreshLoop();
        if (!IsIntegratedStagingPanelOpen || SelectedInboxItem is null)
        {
            return;
        }

        _stagingRefreshCts = new CancellationTokenSource();
        _stagingRefreshTask = RunStagingRefreshLoopAsync(_stagingRefreshCts.Token);
    }

    private void StopStagingRefreshLoop()
    {
        if (_stagingRefreshCts is null)
        {
            return;
        }

        _stagingRefreshCts.Cancel();
        _stagingRefreshCts.Dispose();
        _stagingRefreshCts = null;
        _stagingRefreshTask = null;
    }

    private async Task RunStagingRefreshLoopAsync(CancellationToken cancellationToken)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(4));
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                await RefreshSelectedWorkflowContextAsync();
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private void SyncInboxPermissions()
    {
        if (SelectedInboxItem is null || SelectedWorkflow is null)
        {
            return;
        }

        var updated = AuthorInbox.Concat(ReviewInbox).FirstOrDefault(x => x.ImportBatchId == SelectedInboxItem.ImportBatchId);
        if (updated is not null)
        {
            SelectedInboxItem = updated;
        }
    }

