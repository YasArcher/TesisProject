@page "/management/workflow-review"
@page "/scientific-production/workflow-review"
@attribute [Authorize(Roles = "Admin,Author,WorkflowTrackingUser,WorkflowReviewerUodide,WorkflowReviewerAreaTecnica,WorkflowProcessorAreaTecnica")]
@implements IAsyncDisposable

@using Microsoft.AspNetCore.Authorization
@using tesisproject.frontend.Services.Interfaces
@using tesisproject.shared.DTOs.Auth
@using tesisproject.shared.DTOs.Imports
@using tesisproject.shared.DTOs.Workflow
@using System.Security.Claims

@inject IWorkflowClient WorkflowClient
@inject IBulkImportClient BulkImportClient
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavManager

<PageTitle>Revisión de envíos</PageTitle>

<div class="app-page-shell app-shell-warm workflow-review-page space-y-6">
    @if (!IsUodideOnlyExperience)
    {
        <div class="app-module-hero rounded-[1.5rem] px-4 py-4 text-white shadow-lg">
            <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
                <div>
                    <div class="flex items-center gap-3">
                        <span class="workflow-hero__icon">◎</span>
                        <h1 class="text-2xl font-black md:text-3xl">Revisión de envíos</h1>
                    </div>
                    <div class="mt-2 text-sm font-semibold text-white/80">@ExperienceTitle</div>
                </div>
                <div class="flex flex-wrap gap-2">
                    <button class="rounded-xl border border-white/35 bg-white/10 px-4 py-2 text-sm font-semibold" @onclick="LoadAsync">Actualizar bandeja</button>
                    @if (CanOpenSelectedBatch)
                    {
                        <button class="rounded-xl border border-white/35 bg-white/10 px-4 py-2 text-sm font-semibold" @onclick="OpenIntegratedStagingPanelAsync">Abrir panel de staging</button>
                    }
                </div>
            </div>
        </div>
    }

    <AppStatusModal Visible="@HasFeedback"
                    Variant="@FeedbackVariant"
                    Eyebrow="Workflow de revisión"
                    Title="@FeedbackTitle"
                    Message="@FeedbackMessage"
                    OnClose="CloseFeedbackAsync" />

    <AppConfirmPanel Visible="@(_pendingAction is not null)"
                     Eyebrow="Confirmación de workflow"
                     Title="@PendingActionTitle"
                     Message="@PendingActionMessage"
                     ConfirmText="@PendingActionConfirmText"
                     OnConfirm="ConfirmPendingActionAsync"
                     OnCancel="CancelPendingActionAsync" />

    @if (IsCaseDecisionModalOpen)
    {
        <div class="workflow-modal-backdrop" @onclick="CloseCaseDecisionModal">
            <div class="workflow-case-modal" @onclick:stopPropagation="true">
                <div class="workflow-case-modal__header">
                    <div>
                        <div class="workflow-modal-card__eyebrow">Decisión del caso</div>
                        <h2 class="workflow-modal-card__title">¿Deseas tomar este caso?</h2>
                        <p class="workflow-modal-card__caption">@GetCaseDecisionCaption()</p>
                    </div>
                    <button type="button" class="workflow-modal-card__close" @onclick="CloseCaseDecisionModal">✕</button>
                </div>
                <div class="workflow-case-modal__body">
                    <div class="workflow-case-summary">
                        <span class="workflow-case-summary__icon">?</span>
                        <div>
                            <div class="workflow-case-summary__title">@GetCaseDecisionTitle()</div>
                            <div class="workflow-case-summary__meta">@GetCaseDecisionMeta()</div>
                        </div>
                    </div>
                    <div class="workflow-case-modal__actions">
                        <button type="button"
                                class="workflow-case-action workflow-case-action--primary"
                                disabled="@IsSubmittingAction"
                                @onclick="TakeCaseFromDecisionAsync">
                            Tomar caso
                        </button>
                        <button type="button"
                                class="workflow-case-action workflow-case-action--warning"
                                disabled="@IsSubmittingAction"
                                @onclick="OpenDeclineCaseModal">
                            No tomar caso
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (IsDeclineCaseModalOpen)
    {
        <div class="workflow-modal-backdrop" @onclick="CloseDeclineCaseModal">
            <div class="workflow-case-modal" @onclick:stopPropagation="true">
                <div class="workflow-case-modal__header">
                    <div>
                        <div class="workflow-modal-card__eyebrow">Devolver al autor</div>
                        <h2 class="workflow-modal-card__title">Observación obligatoria</h2>
                        <p class="workflow-modal-card__caption">@GetDeclineCaseCaption()</p>
                    </div>
                    <button type="button" class="workflow-modal-card__close" @onclick="CloseDeclineCaseModal">✕</button>
                </div>
                <div class="workflow-case-modal__body">
                    <textarea class="workflow-case-textarea"
                              placeholder="Escribe la observación para el autor..."
                              @bind="DeclineCaseComment"></textarea>
                    @if (!string.IsNullOrWhiteSpace(DeclineCaseValidationMessage))
                    {
                        <div class="workflow-case-validation">@DeclineCaseValidationMessage</div>
                    }
                    <div class="workflow-case-modal__actions">
                        <button type="button"
                                class="workflow-case-action workflow-case-action--warning"
                                disabled="@IsSubmittingAction"
                                @onclick="DeclineCaseAsync">
                            Confirmar devolución
                        </button>
                        <button type="button"
                                class="workflow-case-action"
                                disabled="@IsSubmittingAction"
                                @onclick="CloseDeclineCaseModal">
                            Cancelar
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (IsArticlePreviewModalOpen)
    {
        <div class="workflow-modal-backdrop" @onclick="CloseArticlePreviewAsync">
            <div class="workflow-modal-card" @onclick:stopPropagation="true">
                <div class="workflow-modal-card__header">
                    <div>
                        <div class="workflow-modal-card__eyebrow">Previsualización del registro</div>
                        <h2 class="workflow-modal-card__title">@GetPreviewModalTitle()</h2>
                        <div class="workflow-modal-card__caption">@GetPreviewModalCaption()</div>
                    </div>
                    <button type="button" class="workflow-modal-card__close" @onclick="CloseArticlePreviewAsync">✕</button>
                </div>

                @if (IsArticlePreviewLoading)
                {
                    <div class="workflow-modal-card__loading">Cargando información del envío...</div>
                }
                else if (PreviewBatch is null || !PreviewBatch.Rows.Any())
                {
                    <AppEmptyState Title="Sin previsualización disponible" Message="Este envío no tiene filas disponibles para mostrar en pantalla." />
                }
                else
                {
                    <div class="workflow-modal-card__body">
                        <div class="workflow-preview-summary">
                            <article class="app-detail-card rounded-2xl">
                                <div class="text-xs uppercase tracking-[0.2em] text-slate-500">Estado</div>
                                <div class="mt-2 text-base font-black text-[#12343b]">@GetFriendlyWorkflowStatus(PreviewInboxItem?.WorkflowStatus)</div>
                            </article>
                            <article class="app-detail-card rounded-2xl">
                                <div class="text-xs uppercase tracking-[0.2em] text-slate-500">Registros del envío</div>
                                <div class="mt-2 text-base font-black text-[#12343b]">@PreviewBatch.Summary.TotalRows</div>
                            </article>
                            <article class="app-detail-card rounded-2xl">
                                <div class="text-xs uppercase tracking-[0.2em] text-slate-500">Último movimiento</div>
                                <div class="mt-2 text-base font-black text-[#12343b]">@FormatDateTime(PreviewInboxItem?.LastActionAt)</div>
                            </article>
                        </div>

                        <div class="workflow-preview-rows">
                            @foreach (var row in PreviewBatch.Rows.OrderBy(x => x.RowNumber).Take(8))
                            {
                                <article class="workflow-preview-row">
                                    <div class="workflow-preview-row__header">
                                        <div>
                                            <div class="workflow-preview-row__title">Fila @row.RowNumber</div>
                                            <div class="workflow-preview-row__status">@row.RowStatus</div>
                                        </div>
                                        <span class="@GetStatusBadgeClass(row.RowStatus)">@GetFriendlyWorkflowStatus(row.RowStatus)</span>
                                    </div>
                                    <div class="workflow-preview-grid">
                                        @foreach (var cell in row.Cells.Where(x => !string.IsNullOrWhiteSpace(x.RawValue)).Take(10))
                                        {
                                            <div class="workflow-preview-grid__item">
                                                <div class="workflow-preview-grid__label">@cell.FieldLabel</div>
                                                <div class="workflow-preview-grid__value">@cell.RawValue</div>
                                            </div>
                                        }
                                    </div>
                                </article>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    @if (IsLoading)
    {
        <div class="rounded-3xl border bg-white p-6 text-center text-slate-600 shadow-sm">Cargando workflows y bandejas activas...</div>
    }
    else
    {
        @if (!IsUodideOnlyExperience)
        {
            <section class="app-section-card">
                <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
                    <div>
                        <div class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">Vista activa</div>
                        <div class="mt-1 text-lg font-black text-[#12343b]">@ExperienceHeadline</div>
                        <div class="mt-1 text-sm text-slate-500">@ExperienceSummary</div>
                    </div>
                    <div class="flex flex-wrap gap-2">
                        @if (CanSeeAuthorInbox)
                        {
                            <span class="rounded-full bg-sky-50 px-3 py-1 text-xs font-semibold text-sky-700">Autor</span>
                        }
                        @if (CanSeeUodideInbox)
                        {
                            <span class="rounded-full bg-amber-50 px-3 py-1 text-xs font-semibold text-amber-700">UODIDE</span>
                        }
                        @if (CanSeeAreaTecnicaInbox)
                        {
                            <span class="rounded-full bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-700">Área Técnica</span>
                        }
                    </div>
                </div>
            </section>
        }

        <div class="grid grid-cols-1 gap-6 xl:grid-cols-[1.05fr_0.95fr]">
            <section class="space-y-6">
                @if (CanSeeAuthorInbox)
                {
                    <section class="workflow-panel workflow-panel--validation workflow-panel--author-validation rounded-[1.7rem] border border-[#d9e5e8] bg-white p-5 shadow-sm">
                        <div class="mb-4 flex items-center justify-between gap-3">
                            <div class="flex items-center gap-3">
                                <span class="workflow-section__icon workflow-section__icon--author">✎</span>
                                <div>
                                <div class="workflow-panel-eyebrow workflow-panel-eyebrow--validation">Panel de validación</div>
                                <h2 class="text-lg font-black text-[#12343b]">Mis envíos como autor</h2>
                                <p class="mt-1 text-sm text-slate-500">Aquí están los registros enviados, devueltos o listos para reenviar.</p>
                                </div>
                            </div>
                            <span class="rounded-full bg-[#eef5f6] px-3 py-1 text-xs font-semibold text-[#12343b]">@AuthorInbox.Count envío(s)</span>
                        </div>

                        <div class="workflow-author-tabs">
                            <button type="button" class="@GetAuthorTabClass("tracking")" @onclick="ShowAuthorTracking">
                                <span class="workflow-tab__icon">◔</span>
                                <span>Seguimiento de envíos</span>
                            </button>
                            <button type="button" class="@GetAuthorTabClass("articles")" @onclick="ShowAuthorArticles">
                                <span class="workflow-tab__icon">▤</span>
                                <span>Mis artículos registrados</span>
                            </button>
                        </div>

                        @if (!AuthorInbox.Any())
                        {
                            <AppEmptyState Title="No tienes envíos todavía" Message="Cuando uses 'Enviar a revisión', el lote aparecerá aquí con su estado actual y feedback del flujo." />
                        }
                        else if (IsAuthorArticlesView)
                        {
                            <div class="workflow-author-filter-panel">
                                <div>
                                    <div class="workflow-filter-label">Filtrar artículos procesados</div>
                                    <div class="workflow-filter-caption">Solo se muestran envíos ya registrados por Área Técnica.</div>
                                </div>
                                <div class="workflow-date-filter-grid">
                                    <label>
                                        <span>Desde</span>
                                        <input type="date" @bind="AuthorArticlesFromDate" />
                                    </label>
                                    <label>
                                        <span>Hasta</span>
                                        <input type="date" @bind="AuthorArticlesToDate" />
                                    </label>
                                    <button type="button" class="workflow-filter-reset" @onclick="ClearAuthorArticlesDateFilter">Limpiar</button>
                                </div>
                            </div>
                            <div class="workflow-scroll-panel">
                                @if (!FilteredAuthorRegisteredArticles.Any())
                                {
                                    <AppEmptyState Title="Sin artículos procesados en este rango" Message="Cuando Área Técnica procese tus envíos, aparecerán aquí como artículos registrados." />
                                }
                                else
                                {
                                    <div class="space-y-3 pr-1">
                                    @foreach (var item in FilteredAuthorRegisteredArticles)
                                    {
                                        <article class="workflow-author-article-card">
                                            <div class="workflow-submission-card-layout">
                                                <div class="workflow-submission-avatar workflow-submission-avatar--done">✓</div>
                                                <div class="min-w-0">
                                                    <div class="workflow-card-eyebrow">Registro integrado</div>
                                                    <h3 class="workflow-submission-title">@BuildAuthorSubmissionTitle(item)</h3>
                                                    <p class="workflow-submission-meta">@BuildAuthorSubmissionMeta(item)</p>
                                                    <div class="workflow-submission-chips">
                                                        <span class="workflow-inline-chip workflow-inline-chip--success">@item.ProcessedRows artículo(s) registrado(s)</span>
                                                        <span class="workflow-inline-chip workflow-inline-chip--soft">Cierre: @FormatShortDate(item.LastActionAt ?? item.SubmittedAt)</span>
                                                    </div>
                                                </div>
                                                <div class="workflow-submission-actions">
                                                    <span class="@GetStatusBadgeClass(item.WorkflowStatus)">@GetFriendlyWorkflowStatus(item.WorkflowStatus)</span>
                                                    <button type="button" class="workflow-inline-action" @onclick="() => OpenArticlePreviewAsync(item)">
                                                        <span class="workflow-inline-action__icon">◫</span>
                                                        <span>Previsualizar</span>
                                                    </button>
                                                </div>
                                            </div>
                                        </article>
                                    }
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="workflow-author-filter-panel">
                                <div>
                                    <div class="workflow-filter-label">Filtrar seguimiento</div>
                                    <div class="workflow-filter-caption">Rango aplicado sobre la fecha de envío.</div>
                                </div>
                                <div class="workflow-date-filter-grid">
                                    <label>
                                        <span>Desde</span>
                                        <input type="date" @bind="AuthorTrackingFromDate" />
                                    </label>
                                    <label>
                                        <span>Hasta</span>
                                        <input type="date" @bind="AuthorTrackingToDate" />
                                    </label>
                                    <button type="button" class="workflow-filter-reset" @onclick="ClearAuthorTrackingDateFilter">Limpiar</button>
                                </div>
                            </div>
                            <div class="workflow-scroll-panel">
                                @if (!FilteredAuthorTracking.Any())
                                {
                                    <AppEmptyState Title="Sin envíos en este rango" Message="Ajusta las fechas para consultar otros movimientos de seguimiento." />
                                }
                                else
                                {
                                    <div class="space-y-3 pr-1">
                                    @foreach (var item in FilteredAuthorTracking)
                                    {
                                        <button type="button" class="@GetAuthorSubmissionCardClass(item)" @onclick="() => SelectWorkflowAsync(item)">
                                            <div class="workflow-submission-card-layout">
                                                <div class="@GetAuthorSubmissionAvatarClass(item)">@GetAuthorSubmissionAvatarText(item)</div>
                                                <div class="min-w-0 text-left">
                                                    <div class="workflow-card-eyebrow">@GetAuthorTrackingEyebrow(item)</div>
                                                    <h3 class="workflow-submission-title">@BuildAuthorSubmissionTitle(item)</h3>
                                                    <p class="workflow-submission-meta">@BuildAuthorSubmissionMeta(item)</p>
                                                    <div class="workflow-submission-chips">
                                                        <span class="workflow-inline-chip">@GetAuthorStageLabel(item)</span>
                                                        <span class="workflow-inline-chip workflow-inline-chip--soft">@item.TotalRows artículo(s) enviado(s)</span>
                                                    </div>
                                                    @if (IsReturnedSubmission(item) && !string.IsNullOrWhiteSpace(item.LatestAuthorObservation))
                                                    {
                                                        <div class="workflow-return-observation">
                                                            <span>Observación</span>
                                                            <p>@item.LatestAuthorObservation</p>
                                                        </div>
                                                    }
                                                    @if (IsReturnedSubmission(item))
                                                    {
                                                        <div class="@GetAuthorCorrectionReadinessClass(item)">
                                                            <span>@GetAuthorCorrectionReadinessTitle(item)</span>
                                                            <p>@GetAuthorCorrectionReadinessMessage(item)</p>
                                                        </div>
                                                    }
                                                </div>
                                                <div class="workflow-submission-actions">
                                                    <span class="@GetStatusBadgeClass(item.WorkflowStatus)">@GetFriendlyWorkflowStatus(item.WorkflowStatus)</span>
                                                    @if (IsReturnedSubmission(item))
                                                    {
                                                        <button type="button" class="workflow-inline-action workflow-inline-action--review" @onclick:stopPropagation="true" @onclick="() => OpenAuthorCorrectionAsync(item)">
                                                            <span class="workflow-inline-action__icon">✎</span>
                                                            <span>Corregir datos</span>
                                                        </button>
                                                        <button type="button"
                                                                class="workflow-inline-action workflow-inline-action--success"
                                                                disabled="@(!CanAuthorResubmit(item) || IsSubmittingAction)"
                                                                title="@GetAuthorResubmitTooltip(item)"
                                                                @onclick:stopPropagation="true"
                                                                @onclick="() => RequestAuthorResubmitAsync(item)">
                                                            <span class="workflow-inline-action__icon">↻</span>
                                                            <span>Reenviar</span>
                                                        </button>
                                                        <button type="button" class="workflow-inline-action workflow-inline-action--danger" @onclick:stopPropagation="true" @onclick="() => RequestAuthorCancelAsync(item)">
                                                            <span class="workflow-inline-action__icon">×</span>
                                                            <span>Eliminar</span>
                                                        </button>
                                                    }
                                                    <button type="button" class="workflow-inline-action" @onclick:stopPropagation="true" @onclick="() => OpenArticlePreviewAsync(item)">
                                                        <span class="workflow-inline-action__icon">◫</span>
                                                        <span>Ver artículo</span>
                                                    </button>
                                                </div>
                                            </div>
                                        </button>
                                    }
                                    </div>
                                }
                            </div>
                        }
                    </section>
                }

                @if (CanSeeUodideInbox)
                {
                <section class="workflow-panel workflow-panel--validation workflow-panel--uodide-validation rounded-[1.7rem] border border-[#d9e5e8] bg-white p-5 shadow-sm">
                    <div class="mb-4 flex items-center justify-between gap-3">
                        <div class="flex items-center gap-3">
                            <span class="workflow-section__icon workflow-section__icon--uodide">◌</span>
                            <div>
                            <div class="workflow-panel-eyebrow workflow-panel-eyebrow--validation">Panel de validación</div>
                            <h2 class="text-lg font-black text-[#12343b]">Validación UODIDE</h2>
                            <p class="mt-1 text-sm text-slate-500">Bandeja operativa para tomar, observar o avanzar registros.</p>
                            </div>
                        </div>
                        <span class="rounded-full bg-[#eef5f6] px-3 py-1 text-xs font-semibold text-[#12343b]">@UodideInbox.Count por revisar</span>
                    </div>

                    @if (!CanSeeUodideInbox)
                    {
                        <AppEmptyState Title="Bandeja UODIDE no disponible" Message="Tu usuario todavía no tiene el rol de validación UODIDE, así que esta bandeja permanecerá oculta operativamente para ti." />
                    }
                    else if (!UodideInbox.Any())
                    {
                        <AppEmptyState Title="No hay workflows para UODIDE" Message="Cuando un envío llegue a la etapa de validación UODIDE, aparecerá aquí para revisión y corrección." />
                    }
                    else
                    {
                        <div class="workflow-review-toolbar">
                            <div class="workflow-author-tabs workflow-author-tabs--compact mb-0">
                                <button type="button" class="@GetReviewFilterClass("all")" @onclick="ShowUodideAll">Todos</button>
                                <button type="button" class="@GetReviewFilterClass("pending")" @onclick="ShowUodidePending">Pendientes</button>
                                <button type="button" class="@GetReviewFilterClass("reviewing")" @onclick="ShowUodideReviewing">En revisión</button>
                                <button type="button" class="@GetReviewFilterClass("returned")" @onclick="ShowUodideReturned">Devueltos</button>
                            </div>
                            <input class="workflow-filter-input" placeholder="Buscar por autor o envío" @bind="UodideSearchTerm" @bind:event="oninput" />
                        </div>

                        @if (!FilteredUodideInbox.Any())
                        {
                            <AppEmptyState Title="No hay resultados para este filtro" Message="Ajusta el estado o el texto de búsqueda para encontrar el envío que necesitas revisar." />
                        }
                        else
                        {
                        <div class="workflow-scroll-panel">
                            <div class="space-y-3 pr-1">
                            @foreach (var item in FilteredUodideInbox)
                            {
                                <button type="button" class="@GetUodideSubmissionCardClass(item)" @onclick="() => SelectWorkflowAsync(item)">
                                    <div class="workflow-submission-card-layout">
                                        <div class="@GetUodideSubmissionAvatarClass(item)">@GetUodideSubmissionAvatarText(item)</div>
                                        <div class="min-w-0 text-left">
                                            <div class="workflow-card-eyebrow">@GetUodideReviewEyebrow(item)</div>
                                            <h3 class="workflow-submission-title">@BuildUodideReviewTitle(item)</h3>
                                            <p class="workflow-submission-meta">@BuildUodideReviewMeta(item)</p>
                                            <div class="workflow-submission-chips">
                                                <span class="workflow-inline-chip workflow-inline-chip--registrant">@BuildRegistrantChip(item)</span>
                                                <span class="workflow-inline-chip workflow-inline-chip--uodide">@GetUodideStageLabel(item)</span>
                                                <span class="workflow-inline-chip workflow-inline-chip--soft">@item.TotalRows artículo(s)</span>
                                            </div>
                                        </div>
                                        <div class="workflow-submission-actions">
                                            <span class="@GetStatusBadgeClass(item.WorkflowStatus)">@GetFriendlyWorkflowStatus(item.WorkflowStatus)</span>
                                            @if (!string.IsNullOrWhiteSpace(item.AssignedToUserName))
                                            {
                                                <span class="workflow-inline-chip workflow-inline-chip--success">Tomado</span>
                                            }
                                            @if (item.CanProcessBatch && string.Equals(item.WorkflowStatus, "Approved", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <span class="workflow-inline-chip workflow-inline-chip--success">Listo</span>
                                            }
                                        </div>
                                    </div>
                                </button>
                            }
                        </div>
                        </div>
                        }
                    }
                </section>
                }

                @if (CanSeeAreaTecnicaInbox)
                {
                <section class="workflow-panel workflow-panel--validation workflow-panel--tech-validation rounded-[1.7rem] border border-[#d9e5e8] bg-white p-5 shadow-sm">
                    <div class="mb-4 flex items-center justify-between gap-3">
                        <div class="flex items-center gap-3">
                            <span class="workflow-section__icon workflow-section__icon--tech">⌘</span>
                            <div>
                            <div class="workflow-panel-eyebrow workflow-panel-eyebrow--validation">Panel de cierre</div>
                            <h2 class="text-lg font-black text-[#12343b]">Validación Área Técnica</h2>
                            <p class="mt-1 text-sm text-slate-500">Revisión final, corrección técnica, aprobación y procesamiento definitivo.</p>
                            </div>
                        </div>
                        <span class="rounded-full bg-[#eef5f6] px-3 py-1 text-xs font-semibold text-[#12343b]">@AreaTecnicaInbox.Count caso(s)</span>
                    </div>

                    @if (!CanSeeAreaTecnicaInbox)
                    {
                        <AppEmptyState Title="Bandeja Área Técnica no disponible" Message="Tu usuario todavía no tiene el rol de validación técnica final, así que esta bandeja no se habilita para ti." />
                    }
                    else if (!AreaTecnicaInbox.Any())
                    {
                        <AppEmptyState Title="No hay workflows para Área Técnica" Message="Cuando UODIDE apruebe una etapa, el envío aparecerá aquí para la revisión final y eventual procesamiento." />
                    }
                    else
                    {
                        <div class="workflow-review-toolbar">
                            <div class="workflow-author-tabs workflow-author-tabs--compact mb-0">
                                <button type="button" class="@GetAreaReviewFilterClass("all")" @onclick="ShowAreaAll">Todos</button>
                                <button type="button" class="@GetAreaReviewFilterClass("pending")" @onclick="ShowAreaPending">Pendientes</button>
                                <button type="button" class="@GetAreaReviewFilterClass("reviewing")" @onclick="ShowAreaReviewing">En revisión</button>
                                <button type="button" class="@GetAreaReviewFilterClass("returned")" @onclick="ShowAreaReturned">Devueltos</button>
                                <button type="button" class="@GetAreaReviewFilterClass("ready")" @onclick="ShowAreaReady">Listos para procesar</button>
                            </div>
                            <input class="workflow-filter-input" placeholder="Buscar por lote o autor" @bind="AreaTecnicaSearchTerm" @bind:event="oninput" />
                        </div>

                        @if (!FilteredAreaTecnicaInbox.Any())
                        {
                            <AppEmptyState Title="No hay resultados para este filtro" Message="Ajusta el estado o el texto de búsqueda para encontrar el envío técnico que necesitas revisar." />
                        }
                        else
                        {
                            <div class="workflow-scroll-panel">
                                <div class="space-y-3 pr-1">
                                    @foreach (var item in FilteredAreaTecnicaInbox)
                                    {
                                        <button type="button" class="@GetAreaTecnicaSubmissionCardClass(item)" @onclick="() => SelectWorkflowAsync(item)">
                                            <div class="workflow-submission-card-layout">
                                                <div class="@GetAreaTecnicaSubmissionAvatarClass(item)">@GetAreaTecnicaSubmissionAvatarText(item)</div>
                                                <div class="min-w-0 text-left">
                                                    <div class="workflow-card-eyebrow">@GetAreaTecnicaReviewEyebrow(item)</div>
                                                    <h3 class="workflow-submission-title">@BuildAreaTecnicaReviewTitle(item)</h3>
                                                    <p class="workflow-submission-meta">@BuildAreaTecnicaReviewMeta(item)</p>
                                                    <div class="workflow-submission-chips">
                                                        <span class="workflow-inline-chip workflow-inline-chip--registrant">@BuildRegistrantChip(item)</span>
                                                        <span class="workflow-inline-chip workflow-inline-chip--tech">@GetAreaTecnicaStageLabel(item)</span>
                                                        <span class="workflow-inline-chip workflow-inline-chip--soft">@item.TotalRows artículo(s)</span>
                                                    </div>
                                                </div>
                                                <div class="workflow-submission-actions">
                                                    <span class="@GetStatusBadgeClass(item.WorkflowStatus)">@GetFriendlyWorkflowStatus(item.WorkflowStatus)</span>
                                                    @if (!string.IsNullOrWhiteSpace(item.AssignedToUserName))
                                                    {
                                                        <span class="workflow-inline-chip workflow-inline-chip--success">Tomado</span>
                                                    }
                                                    @if (item.CanProcessBatch && string.Equals(item.WorkflowStatus, "Approved", StringComparison.OrdinalIgnoreCase))
                                                    {
                                                        <span class="workflow-inline-chip workflow-inline-chip--tech-ready">Procesar</span>
                                                    }
                                                </div>
                                            </div>
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                    }
                </section>
                }
            </section>

            <aside class="space-y-4 xl:sticky xl:top-4 xl:self-start">
                <section class="workflow-panel workflow-panel--detail-flow rounded-[1.8rem] border border-[#d9e5e8] bg-white p-5 shadow-sm">
                    <div class="mb-4 flex items-center justify-between gap-3">
                        <div class="flex items-center gap-3">
                            <span class="workflow-section__icon workflow-section__icon--detail">▣</span>
                            <div>
                            <div class="workflow-panel-eyebrow workflow-panel-eyebrow--detail">Detalle y flujo</div>
                            <h2 class="text-lg font-black text-[#12343b]">@DetailPanelTitle</h2>
                            @if (IsAuthorOnlyExperience)
                            {
                                <p class="mt-1 text-sm text-slate-500">Información clara del avance, observaciones y cierre del envío.</p>
                            }
                            else if (IsUodideOnlyExperience)
                            {
                                <p class="mt-1 text-sm text-slate-500">Consulta el historial del caso y ejecuta las acciones de revisión.</p>
                            }
                            else if (IsAreaTecnicaOnlyExperience)
                            {
                                <p class="mt-1 text-sm text-slate-500">Revisa el cierre técnico y procesa los registros cuando estén aprobados.</p>
                            }
                            </div>
                        </div>
                    </div>

                    @if (SelectedWorkflow is null)
                    {
                        <AppEmptyState Title="@DetailEmptyTitle" Message="@DetailEmptyMessage" />
                    }
                    else
                    {
                        <div class="space-y-4">
                            <div class="workflow-detail-tabs">
                                <button type="button" class="@GetDetailTabClass("summary")" @onclick="ShowDetailSummary">
                                    <span class="workflow-tab__icon">◎</span>
                                    <span>Resumen</span>
                                </button>
                                <button type="button" class="@GetDetailTabClass("stages")" @onclick="ShowDetailStages">
                                    <span class="workflow-tab__icon">▥</span>
                                    <span>@(IsAuthorOnlyExperience || IsUodideOnlyExperience ? "Avance" : "Etapas")</span>
                                </button>
                                <button type="button" class="@GetDetailTabClass("notes")" @onclick="ShowDetailNotes">
                                    <span class="workflow-tab__icon">✎</span>
                                    <span>@(IsAuthorOnlyExperience || IsUodideOnlyExperience ? "Observaciones" : "Notas")</span>
                                </button>
                                @if (!IsAuthorOnlyExperience)
                                {
                                    <button type="button" class="@GetDetailTabClass("actions")" @onclick="ShowDetailActions">
                                        <span class="workflow-tab__icon">→</span>
                                        <span>Acciones</span>
                                    </button>
                                }
                            </div>

                            <div class="@(IsAuthorOnlyExperience || IsUodideOnlyExperience ? "workflow-author-detail-hero" : "app-note-panel rounded-2xl")">
                                @if (IsAuthorOnlyExperience && SelectedInboxItem is not null)
                                {
                                    <div class="workflow-author-detail-hero__icon">@GetAuthorSubmissionAvatarText(SelectedInboxItem)</div>
                                    <div class="min-w-0">
                                        <div class="workflow-card-eyebrow">Seguimiento del envío</div>
                                        <div class="workflow-author-detail-hero__title">@BuildAuthorSubmissionTitle(SelectedInboxItem)</div>
                                        <p class="workflow-author-detail-hero__meta">@BuildAuthorSubmissionMeta(SelectedInboxItem)</p>
                                        <div class="workflow-submission-chips">
                                            <span class="@GetStatusBadgeClass(SelectedWorkflow.Status)">@GetFriendlyWorkflowStatus(SelectedWorkflow.Status)</span>
                                            <span class="workflow-inline-chip workflow-inline-chip--soft">@GetAuthorStageLabel(SelectedInboxItem)</span>
                                        </div>
                                    </div>
                                }
                                else if (IsUodideOnlyExperience && SelectedInboxItem is not null)
                                {
                                    <div class="@GetUodideSubmissionAvatarClass(SelectedInboxItem)">@GetUodideSubmissionAvatarText(SelectedInboxItem)</div>
                                    <div class="min-w-0">
                                        <div class="workflow-card-eyebrow">Revisión UODIDE</div>
                                        <div class="workflow-author-detail-hero__title">@BuildUodideReviewTitle(SelectedInboxItem)</div>
                                        <p class="workflow-author-detail-hero__meta">@BuildUodideReviewMeta(SelectedInboxItem)</p>
                                        <div class="workflow-submission-chips">
                                            <span class="@GetStatusBadgeClass(SelectedWorkflow.Status)">@GetFriendlyWorkflowStatus(SelectedWorkflow.Status)</span>
                                            <span class="workflow-inline-chip workflow-inline-chip--uodide">@GetUodideStageLabel(SelectedInboxItem)</span>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="text-xs uppercase tracking-[0.2em] text-slate-500">Lote</div>
                                    <div class="mt-1 text-lg font-black text-[#12343b]">@SelectedInboxItem?.BatchCode</div>
                                    <div class="mt-2 flex flex-wrap gap-2">
                                        <span class="@GetStatusBadgeClass(SelectedWorkflow.Status)">@GetFriendlyWorkflowStatus(SelectedWorkflow.Status)</span>
                                        @if (!string.IsNullOrWhiteSpace(SelectedWorkflow.CurrentStageGroupName))
                                        {
                                            <span class="rounded-full bg-[#fff3de] px-3 py-1 text-xs font-semibold text-[#8b5a16]">@SelectedWorkflow.CurrentStageGroupName</span>
                                        }
                                        @if (SelectedInboxItem?.CanProcessBatch == true && string.Equals(SelectedWorkflow.Status, "Approved", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="rounded-full bg-emerald-100 px-3 py-1 text-xs font-semibold text-emerald-800">Listo para procesamiento final</span>
                                        }
                                    </div>
                                }
                            </div>

                            @if (ActiveDetailView == "summary")
                            {
                            <div class="@(IsAuthorOnlyExperience || IsUodideOnlyExperience ? "workflow-author-summary-grid" : "grid grid-cols-1 gap-3 md:grid-cols-3")">
                              <article class="@(IsAuthorOnlyExperience || IsUodideOnlyExperience ? "workflow-author-detail-card" : "app-detail-card rounded-2xl")">
                                    <div class="text-xs uppercase tracking-[0.2em] text-slate-500">Estado actual</div>
                                    <div class="mt-2 text-base font-black text-[#12343b]">@GetFriendlyWorkflowStatus(SelectedWorkflow.Status)</div>
                                    <div class="mt-1 text-sm text-slate-500">@GetWorkflowProgressCaption()</div>
                                </article>
                              <article class="@(IsAuthorOnlyExperience || IsUodideOnlyExperience ? "workflow-author-detail-card" : "app-detail-card rounded-2xl")">
                                    <div class="text-xs uppercase tracking-[0.2em] text-slate-500">Fechas clave</div>
                                    <div class="mt-2 space-y-1 text-sm text-slate-600">
                                        <div>Enviado: <span class="font-semibold text-[#12343b]">@FormatDateTime(SelectedWorkflow.SubmittedAt)</span></div>
                                        <div>Último movimiento: <span class="font-semibold text-[#12343b]">@FormatDateTime(SelectedWorkflow.LastActionAt)</span></div>
                                        @if ((!IsAuthorOnlyExperience && !IsUodideOnlyExperience) || SelectedWorkflow.CompletedAt.HasValue)
                                        {
                                            <div>Finalizado: <span class="font-semibold text-[#12343b]">@FormatDateTime(SelectedWorkflow.CompletedAt)</span></div>
                                        }
                                    </div>
                                </article>
                              <article class="@(IsAuthorOnlyExperience || IsUodideOnlyExperience ? "workflow-author-detail-card" : "app-detail-card rounded-2xl")">
                                    <div class="text-xs uppercase tracking-[0.2em] text-slate-500">Paso siguiente</div>
                                    <div class="mt-2 text-sm font-semibold text-[#12343b]">@GetNextStepLabel()</div>
                                    <div class="mt-1 text-sm text-slate-500">@GetUserFriendlyCurrentStageLabel()</div>
                                </article>
                            </div>
                            }

                            @if (ActiveDetailView == "stages")
                            {
                            <div class="@(IsAuthorOnlyExperience || IsUodideOnlyExperience ? "workflow-author-detail-section" : "rounded-2xl border border-[#d9e5e8] bg-[#fafcfd] px-4 py-4")">
                                <div class="mb-3 text-xs uppercase tracking-[0.2em] text-slate-500">@(IsAuthorOnlyExperience ? "Avance del envío" : IsUodideOnlyExperience ? "Avance de revisión" : "Etapas")</div>
                                <div class="workflow-scroll-panel workflow-scroll-panel--detail">
                                <div class="space-y-3 pr-1">
                                    @foreach (var stage in SelectedWorkflow.Stages.OrderBy(x => x.DisplayOrder))
                                    {
                                        <article class="@(IsAuthorOnlyExperience || IsUodideOnlyExperience ? "workflow-author-stage-card" : "rounded-2xl border border-[#d9e5e8] bg-white px-4 py-3")">
                                            <div class="flex items-start justify-between gap-3">
                                                <div>
                                                    <h3 class="text-sm font-bold text-[#12343b]">@stage.StageName</h3>
                                                    <p class="mt-1 text-xs text-slate-500">@stage.StageGroupName</p>
                                                </div>
                                                <span class="@GetStatusBadgeClass(stage.Status)">@GetFriendlyWorkflowStatus(stage.Status)</span>
                                            </div>
                                            <div class="mt-3 grid grid-cols-1 gap-2 text-sm text-slate-600 md:grid-cols-2">
                                                <div>Inicio: <span class="font-semibold text-[#12343b]">@FormatDateTime(stage.StartedAt)</span></div>
                                                <div>Cierre: <span class="font-semibold text-[#12343b]">@FormatDateTime(stage.CompletedAt ?? stage.ReturnedAt)</span></div>
                                            </div>
                                            @if (!IsAuthorOnlyExperience && (!string.IsNullOrWhiteSpace(stage.AssignedToUserName) || !string.IsNullOrWhiteSpace(stage.Notes)))
                                            {
                                                <div class="mt-3 space-y-1 text-sm text-slate-600">
                                                    @if (!string.IsNullOrWhiteSpace(stage.AssignedToUserName))
                                                    {
                                                        <div>Asignado a: <span class="font-semibold text-[#12343b]">@stage.AssignedToUserName</span></div>
                                                    }
                                                    @if (!string.IsNullOrWhiteSpace(stage.Notes))
                                                    {
                                                        <div>Nota: @stage.Notes</div>
                                                    }
                                                </div>
                                            }
                                        </article>
                                    }
                                </div>
                                </div>
                            </div>
                            }

                            @if (ActiveDetailView == "notes")
                            {
                            <div class="@(IsAuthorOnlyExperience || IsUodideOnlyExperience ? "workflow-author-detail-section" : "rounded-2xl border border-[#d9e5e8] bg-[#fafcfd] px-4 py-4")">
                                <div class="mb-3 text-xs uppercase tracking-[0.2em] text-slate-500">@NotesPanelTitle</div>
                                @if (!WorkflowNotes.Any())
                                {
                                    <p class="text-sm text-slate-500">Todavía no hay notas registradas para este envío.</p>
                                }
                                else
                                {
                                    <div class="workflow-scroll-panel workflow-scroll-panel--detail">
                                    <div class="space-y-3 pr-1">
                                        @foreach (var note in WorkflowNotes)
                                        {
                                            <article class="@(IsAuthorOnlyExperience || IsUodideOnlyExperience ? "workflow-author-note-card" : "rounded-2xl border border-[#d9e5e8] bg-white px-4 py-3")">
                                                <div class="flex items-center justify-between gap-3">
                                                    <div class="flex flex-wrap items-center gap-2">
                                                        <div class="text-sm font-semibold text-[#12343b]">@GetFriendlyActionName(note.ActionType)</div>
                                                        @if (!string.IsNullOrWhiteSpace(GetCommentAudienceBadge(note.Comments)))
                                                        {
                                                            <span class="workflow-inline-chip workflow-inline-chip--soft">@GetCommentAudienceBadge(note.Comments)</span>
                                                        }
                                                    </div>
                                                    <div class="text-xs text-slate-500">@FormatDateTime(note.PerformedAt)</div>
                                                </div>
                                                @if (!IsAuthorOnlyExperience && !string.IsNullOrWhiteSpace(note.PerformedByUserName))
                                                {
                                                    <div class="mt-1 text-xs text-slate-500">@note.PerformedByUserName</div>
                                                }
                                                        <div class="mt-2 text-sm text-slate-700">@GetDisplayComment(note.Comments)</div>
                                                    </article>
                                                }
                                            </div>
                                    </div>
                                }
                            </div>
                            }

                            @if (!IsAuthorOnlyExperience && ActiveDetailView == "actions")
                            {
                                <div class="rounded-2xl border border-[#d9e5e8] bg-[#fafcfd] px-4 py-4">
                                    <div class="text-xs uppercase tracking-[0.2em] text-slate-500">Acción del proceso</div>
                                    <div class="mt-2 text-sm font-semibold text-[#12343b]">@GetReviewerActionLead()</div>

                                    @if (SelectedInboxItem is not null)
                                    {
                                        <div class="@GetStagingReadinessClass()">
                                            <div class="workflow-readiness-card__icon">@GetStagingReadinessIcon()</div>
                                            <div class="workflow-readiness-card__body">
                                                <div class="workflow-readiness-card__title">@GetStagingReadinessTitle()</div>
                                                <div class="workflow-readiness-card__text">@GetStagingReadinessMessage()</div>
                                                <div class="workflow-readiness-card__chips">
                                                    <span>Total: @SelectedInboxItem.TotalRows</span>
                                                    <span>Listas: @(SelectedInboxItem.ValidRows + SelectedInboxItem.ProcessedRows)</span>
                                                    <span>Pendientes: @GetSelectedPendingRows()</span>
                                                    <span>Errores: @SelectedInboxItem.ErrorRows</span>
                                                </div>
                                            </div>
                                        </div>
                                    }

                                    <div class="mt-3">
                                        <div class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Destinatario de la nota</div>
                                        <div class="mt-2 workflow-author-tabs workflow-author-tabs--compact mb-0">
                                            <button type="button" class="@GetNoteAudienceClass("internal")" @onclick="ShowInternalNoteAudience">Interna</button>
                                            <button type="button" class="@GetNoteAudienceClass("author")" @onclick="ShowAuthorNoteAudience">Para autor</button>
                                            @if (IsAreaTecnicaCurrentStage)
                                            {
                                                <button type="button" class="@GetNoteAudienceClass("uodide")" @onclick="ShowUodideNoteAudience">Para UODIDE</button>
                                            }
                                            else
                                            {
                                                <button type="button" class="@GetNoteAudienceClass("next")" @onclick="ShowNextReviewerNoteAudience">Para Área Técnica</button>
                                            }
                                        </div>
                                    </div>

                                    @if (CanClaimSelectedWorkflow)
                                    {
                                        <div class="mt-4 flex flex-wrap gap-2">
                                            <button class="rounded-xl border border-sky-200 bg-sky-50 px-3 py-2 text-sm font-semibold text-sky-700 disabled:opacity-60"
                                                    disabled="@IsSubmittingAction"
                                                    @onclick="OpenCaseDecisionModal">
                                                Caso
                                            </button>
                                        </div>
                                    }
                                    else if (CanReviewSelectedStaging || CanReturnSelectedWorkflow || CanApproveSelectedWorkflow || CanProcessSelectedWorkflow)
                                    {
                                        @if (CanReturnSelectedWorkflow || CanApproveSelectedWorkflow || CanProcessSelectedWorkflow)
                                        {
                                            <textarea class="mt-3 min-h-[96px] w-full rounded-2xl border border-[#d9e5e8] bg-white px-3 py-3 text-sm text-slate-700"
                                                      placeholder="@GetActionPanelPlaceholder()"
                                                      @bind="WorkflowComment"></textarea>
                                        }
                                        <div class="mt-3 flex flex-wrap gap-2">
                                            @if (CanReviewSelectedStaging)
                                            {
                                                <button class="workflow-inline-action"
                                                        disabled="@IsSubmittingAction"
                                                        @onclick="OpenIntegratedStagingPanelAsync">
                                                    <span class="workflow-inline-action__icon">▤</span>
                                                    <span>@GetStagingActionLabel()</span>
                                                </button>
                                                <button class="rounded-xl border border-[#d9e5e8] bg-white px-3 py-2 text-sm font-semibold text-[#12343b] disabled:opacity-60"
                                                        disabled="@IsSubmittingAction || IsValidatingSelectedBatch"
                                                        @onclick="ValidateSelectedBatchAsync">
                                                    @(IsValidatingSelectedBatch ? "Validando..." : GetValidateActionLabel())
                                                </button>
                                            }
                                            @if (CanReturnSelectedWorkflow)
                                            {
                                                <button class="rounded-xl border border-amber-200 bg-amber-50 px-3 py-2 text-sm font-semibold text-amber-700 disabled:opacity-60"
                                                        disabled="@IsSubmittingAction || string.IsNullOrWhiteSpace(WorkflowComment)"
                                                        title="@GetReturnActionTooltip()"
                                                        @onclick="RequestReturnAsync">
                                                    Devolver al autor
                                                </button>
                                                @if (IsAreaTecnicaCurrentStage)
                                                {
                                                    <button class="rounded-xl border border-[#055052]/20 bg-[#055052]/10 px-3 py-2 text-sm font-semibold text-[#055052] disabled:opacity-60"
                                                            disabled="@IsSubmittingAction || string.IsNullOrWhiteSpace(WorkflowComment)"
                                                            title="@GetReturnToUodideActionTooltip()"
                                                            @onclick="RequestReturnToUodideAsync">
                                                        Devolver a UODIDE
                                                    </button>
                                                }
                                            }
                                            @if (CanApproveSelectedWorkflow)
                                            {
                                                <button class="rounded-xl bg-gradient-to-r from-[#12343b] to-[#2f4858] px-3 py-2 text-sm font-semibold text-white disabled:opacity-60"
                                                        disabled="@IsSubmittingAction"
                                                        @onclick="RequestApproveAsync">
                                                    @GetApproveActionLabel()
                                                </button>
                                            }
                                            @if (CanProcessSelectedWorkflow)
                                            {
                                                <button class="rounded-xl bg-gradient-to-r from-emerald-600 to-emerald-700 px-3 py-2 text-sm font-semibold text-white disabled:opacity-60"
                                                        disabled="@IsSubmittingAction"
                                                        @onclick="RequestProcessAsync">
                                                    Procesar envío
                                                </button>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </section>
            </aside>
        </div>

        @if (!IsAuthorOnlyExperience && IsIntegratedStagingPanelOpen)
        {
            <section class="workflow-stage-panel">
                <div class="workflow-stage-panel__header">
                    <div>
                        <div class="workflow-stage-panel__eyebrow">Staging del lote</div>
                        <h2 class="workflow-stage-panel__title">Revisión completa del registro enviado por el autor</h2>
                        <div class="workflow-stage-panel__caption">@SelectedInboxItem?.BatchCode</div>
                    </div>
                    <div class="flex flex-wrap gap-2">
                        <button class="workflow-inline-action" @onclick="CloseIntegratedStagingPanel">
                            <span class="workflow-inline-action__icon">✕</span>
                            <span>Cerrar panel</span>
                        </button>
                    </div>
                </div>

                @if (SelectedInboxItem is null)
                {
                    <AppEmptyState Title="Sin lote seleccionado" Message="Selecciona un envío para abrir su staging completo dentro de esta misma página." />
                }
                else
                {
                    <div class="workflow-staging-frame-wrap workflow-staging-frame-wrap--full">
                        <iframe class="workflow-staging-frame"
                                src="@GetEmbeddedStagingUrl()"
                                title="Staging del envío"></iframe>
                    </div>
                }
            </section>
        }
    }
</div>

@code {
    private bool IsLoading { get; set; } = true;
    private bool IsSubmittingAction { get; set; }
    private bool IsArticlePreviewModalOpen { get; set; }
    private bool IsArticlePreviewLoading { get; set; }
    private bool IsValidatingSelectedBatch { get; set; }
    private bool IsIntegratedStagingPanelOpen { get; set; }
    private bool IsCaseDecisionModalOpen { get; set; }
    private bool IsDeclineCaseModalOpen { get; set; }
    private CancellationTokenSource? _stagingRefreshCts;
    private Task? _stagingRefreshTask;
    private int _stagingFrameVersion;
    private AuthMeResponse? CurrentUser { get; set; }
    private List<WorkflowInboxItemDto> AuthorInbox { get; set; } = new();
    private List<WorkflowInboxItemDto> ReviewInbox { get; set; } = new();
    private List<WorkflowInboxItemDto> UodideInbox => ReviewInbox
        .Where(x => string.Equals(x.ResponsibleRoleName, "WorkflowReviewerUodide", StringComparison.OrdinalIgnoreCase))
        .ToList();
    private List<WorkflowInboxItemDto> AreaTecnicaInbox => ReviewInbox
        .Where(x => string.Equals(x.ResponsibleRoleName, "WorkflowReviewerAreaTecnica", StringComparison.OrdinalIgnoreCase))
        .ToList();
    private WorkflowInboxItemDto? SelectedInboxItem { get; set; }
    private WorkflowBatchDetailDto? SelectedWorkflow { get; set; }
    private WorkflowInboxItemDto? PreviewInboxItem { get; set; }
    private BulkImportBatchDetailDto? PreviewBatch { get; set; }
    private string WorkflowComment { get; set; } = string.Empty;
    private string ErrorMessage { get; set; } = string.Empty;
    private string SuccessMessage { get; set; } = string.Empty;
    private string ActiveAuthorView { get; set; } = "tracking";
    private string ActiveDetailView { get; set; } = "summary";
    private DateTime? AuthorTrackingFromDate { get; set; }
    private DateTime? AuthorTrackingToDate { get; set; }
    private DateTime? AuthorArticlesFromDate { get; set; }
    private DateTime? AuthorArticlesToDate { get; set; }
    private string UodideStatusFilter { get; set; } = "all";
    private string UodideSearchTerm { get; set; } = string.Empty;
    private string AreaTecnicaStatusFilter { get; set; } = "all";
    private string AreaTecnicaSearchTerm { get; set; } = string.Empty;
    private string WorkflowNoteAudience { get; set; } = "internal";
    private string DeclineCaseComment { get; set; } = string.Empty;
    private string DeclineCaseValidationMessage { get; set; } = string.Empty;
    private PendingWorkflowAction? _pendingAction;

    private bool HasFeedback => !string.IsNullOrWhiteSpace(ErrorMessage) || !string.IsNullOrWhiteSpace(SuccessMessage);
    private bool CanSeeAuthorInbox => CurrentUser?.Roles?.Any(x =>
        string.Equals(x, "Admin", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(x, "Author", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(x, "WorkflowTrackingUser", StringComparison.OrdinalIgnoreCase)) == true;
