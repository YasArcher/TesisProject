    private static bool MatchesDateRange(DateTime? value, DateTime? fromDate, DateTime? toDate)
    {
        if (!value.HasValue)
        {
            return !fromDate.HasValue && !toDate.HasValue;
        }

        var localDate = value.Value.ToLocalTime().Date;

        if (fromDate.HasValue && localDate < fromDate.Value.Date)
        {
            return false;
        }

        if (toDate.HasValue && localDate > toDate.Value.Date)
        {
            return false;
        }

        return true;
    }

