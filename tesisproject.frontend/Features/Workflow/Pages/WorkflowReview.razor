    private async Task ConfirmPendingActionAsync()
    {
        if (_pendingAction is null || SelectedInboxItem is null)
        {
            return;
        }

        try
        {
            IsSubmittingAction = true;
            if (_pendingAction.Kind == "resubmit")
            {
                var updatedResubmit = await WorkflowClient.ResubmitAsync(SelectedInboxItem.ImportBatchId, new WorkflowActionRequest
                {
                    Comments = "[Para UODIDE] Envío revisado por el autor y reenviado para validación."
                });

                SuccessMessage = "El envío fue reenviado a UODIDE para una nueva revisión.";
                WorkflowComment = string.Empty;
                _pendingAction = null;
                await RefreshInboxesAsync();
                if (updatedResubmit is not null)
                {
                    SelectedWorkflow = updatedResubmit;
                    SelectedInboxItem = AuthorInbox.Concat(ReviewInbox).FirstOrDefault(x => x.ImportBatchId == updatedResubmit.ImportBatchId);
                }

                return;
            }

            if (_pendingAction.Kind == "cancel")
            {
                var updatedCancel = await WorkflowClient.CancelAsync(SelectedInboxItem.ImportBatchId, new WorkflowActionRequest
                {
                    Comments = "[Nota interna] Envío eliminado por el autor después de observación UODIDE."
                });

                SuccessMessage = "El envío fue eliminado del workflow.";
                WorkflowComment = string.Empty;
                _pendingAction = null;
                await RefreshInboxesAsync();
                SelectedWorkflow = null;
                SelectedInboxItem = AuthorInbox.Concat(ReviewInbox).FirstOrDefault();
                return;
            }

            if (_pendingAction.Kind == "process")
            {
                var batchId = SelectedInboxItem.ImportBatchId;
                var processed = await BulkImportClient.ProcessBatchAsync(batchId);
                if ((processed?.Batch?.Summary?.ErrorRows ?? 0) > 0)
                {
                    ErrorMessage = "El procesamiento encontró correcciones pendientes. Revisa el staging técnico actualizado y valida nuevamente antes de procesar.";
                    IsIntegratedStagingPanelOpen = true;
                    _stagingFrameVersion++;
                    StartStagingRefreshLoop();
                }
                else
                {
                    SuccessMessage = processed?.Message ?? "El envío se procesó correctamente hacia la base principal.";
                }

                WorkflowComment = string.Empty;
                _pendingAction = null;
                await RefreshInboxesAsync();
                SelectedInboxItem = FindInboxItemByBatchId(batchId);
                SelectedWorkflow = SelectedInboxItem is null ? null : await WorkflowClient.GetBatchWorkflowAsync(batchId);

                return;
            }

            WorkflowBatchDetailDto? updated = _pendingAction.Kind switch
            {
                "claim" => await WorkflowClient.ClaimAsync(SelectedInboxItem.ImportBatchId, new WorkflowActionRequest { Comments = BuildWorkflowCommentForAction() }),
                "return" => await WorkflowClient.ReturnAsync(SelectedInboxItem.ImportBatchId, new WorkflowActionRequest { Comments = BuildWorkflowCommentForAction("author") }),
                "return-uodide" => await WorkflowClient.ReturnToUodideAsync(SelectedInboxItem.ImportBatchId, new WorkflowActionRequest { Comments = BuildWorkflowCommentForAction("uodide") }),
                "approve" => await WorkflowClient.ApproveAsync(SelectedInboxItem.ImportBatchId, new WorkflowActionRequest { Comments = BuildWorkflowCommentForAction() }),
                _ => null
            };

            if (updated is not null)
            {
                SelectedWorkflow = updated;
                SuccessMessage = _pendingAction.Kind switch
                {
                    "claim" => "La etapa quedó tomada correctamente.",
                    "return" => "La etapa fue devuelta correctamente con tus observaciones y el envío volvió al autor.",
                    "return-uodide" => "La etapa fue devuelta correctamente a UODIDE con tus observaciones.",
                    "approve" => BuildApproveSuccessMessage(updated),
                    _ => "Acción completada."
                };

                WorkflowComment = string.Empty;
                WorkflowNoteAudience = "internal";
                _pendingAction = null;
                await RefreshInboxesAsync();
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsSubmittingAction = false;
        }
    }

