    private async Task ValidateSelectedBatchAsync()
    {
        if (SelectedInboxItem is null)
        {
            return;
        }

        try
        {
            IsValidatingSelectedBatch = true;
            var batchId = SelectedInboxItem.ImportBatchId;
            var result = await WorkflowClient.ValidateBatchAsync(batchId);
            SuccessMessage = result?.Message ?? "El lote fue validado correctamente.";
            await RefreshInboxesAsync();
            SelectedInboxItem = FindInboxItemByBatchId(batchId);
            SelectedWorkflow = SelectedInboxItem is null ? null : await WorkflowClient.GetBatchWorkflowAsync(batchId);
            _stagingFrameVersion++;
        }
        catch (Exception ex)
        {
            ErrorMessage = $"No pude validar el lote: {ex.Message}";
        }
        finally
        {
            IsValidatingSelectedBatch = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        StopStagingRefreshLoop();
        if (_stagingRefreshTask is not null)
        {
            try
            {
                await _stagingRefreshTask;
            }
            catch (OperationCanceledException)
            {
            }
        }
    }

    private bool MatchesUodideFilter(WorkflowInboxItemDto item)
    {
        var matchesSearch = string.IsNullOrWhiteSpace(UodideSearchTerm)
            || (item.BatchCode?.Contains(UodideSearchTerm, StringComparison.OrdinalIgnoreCase) ?? false)
            || (item.SubmittedByUserName?.Contains(UodideSearchTerm, StringComparison.OrdinalIgnoreCase) ?? false);

        if (!matchesSearch)
        {
            return false;
        }

        return UodideStatusFilter switch
        {
            "pending" => string.IsNullOrWhiteSpace(item.AssignedToUserId) && !IsReturnedSubmission(item),
            "reviewing" => !string.IsNullOrWhiteSpace(item.AssignedToUserId) && !IsReturnedSubmission(item),
            "returned" => IsReturnedSubmission(item),
            _ => true
        };
    }

    private string GetActionPanelPlaceholder()
        => WorkflowNoteAudience switch
        {
            "author" => "Escribe aquí las observaciones que el autor debe revisar para corregir su envío.",
            "uodide" => "Escribe aquí las observaciones que UODIDE debe revisar antes de reenviar el caso a Área Técnica.",
            "next" => "Escribe una nota breve para Área Técnica con el contexto de tu revisión.",
            _ => "Escribe aquí una observación interna breve para acompañar la acción del workflow."
        };

    private static string GetAuthorCorrectionReadinessClass(WorkflowInboxItemDto item)
        => CanAuthorResubmit(item)
            ? "workflow-return-readiness workflow-return-readiness--ready"
            : "workflow-return-readiness";

    private static string GetAuthorCorrectionReadinessTitle(WorkflowInboxItemDto item)
    {
        if (item.ErrorRows > 0)
        {
            return "Corrección pendiente";
        }

        return item.ValidRows > 0 ? "Listo para reenviar" : "Validación pendiente";
    }

    private static string GetAuthorCorrectionReadinessMessage(WorkflowInboxItemDto item)
    {
        if (item.ErrorRows > 0)
        {
            return $"Aún hay {item.ErrorRows} fila(s) con error. Corrige los datos observados antes de reenviar.";
        }

        return item.ValidRows > 0
            ? $"{item.ValidRows} fila(s) lista(s). Puedes reenviar el caso a UODIDE."
            : "Revisa y valida la matriz corregida para habilitar el reenvío.";
    }

    private static string GetAuthorResubmitTooltip(WorkflowInboxItemDto item)
    {
        if (item.ErrorRows > 0)
        {
            return "Corrige las filas con error antes de reenviar.";
        }

        return item.ValidRows > 0
            ? "Reenviar el caso corregido a UODIDE."
            : "Valida la matriz corregida antes de reenviar.";
    }

    private string GetReturnActionTooltip()
        => string.IsNullOrWhiteSpace(WorkflowComment)
            ? "Escribe una observación para el autor antes de devolver."
            : "Devolver el envío al autor con esta observación.";

    private string GetReturnToUodideActionTooltip()
        => string.IsNullOrWhiteSpace(WorkflowComment)
            ? "Escribe una observación para UODIDE antes de devolver."
            : "Devolver el envío a UODIDE con esta observación.";

    private string? BuildWorkflowCommentForAction(string? forcedAudience = null)
    {
        if (string.IsNullOrWhiteSpace(WorkflowComment))
        {
            return null;
        }

        var audience = string.IsNullOrWhiteSpace(forcedAudience) ? WorkflowNoteAudience : forcedAudience;
        var prefix = audience switch
        {
            "author" => "[Para autor]",
            "next" => "[Para siguiente revisor]",
            "uodide" => "[Para UODIDE]",
            _ => "[Nota interna]"
        };

        return $"{prefix} {WorkflowComment.Trim()}";
    }

    private string GetPreviewModalTitle()
    {
        var title = PreviewBatch?.Rows
            .OrderBy(x => x.RowNumber)
            .SelectMany(x => x.Cells)
            .FirstOrDefault(x => string.Equals(x.FieldKey, "Title", StringComparison.OrdinalIgnoreCase) && !string.IsNullOrWhiteSpace(x.RawValue))
            ?.RawValue;

        return !string.IsNullOrWhiteSpace(title)
            ? title
            : "Detalle del artículo registrado";
    }

    private string GetPreviewModalCaption()
        => PreviewInboxItem is null
            ? "Sin envío seleccionado"
            : IsAuthorOnlyExperience
                ? BuildAuthorSubmissionMeta(PreviewInboxItem)
                : $"Lote {PreviewInboxItem.BatchCode}";

    private static string? GetCommentAudienceBadge(string? comment)
    {
        if (string.IsNullOrWhiteSpace(comment))
        {
            return null;
        }

        if (comment.StartsWith("[Para autor]", StringComparison.OrdinalIgnoreCase))
        {
            return "Para autor";
        }

        if (comment.StartsWith("[Para siguiente revisor]", StringComparison.OrdinalIgnoreCase))
        {
            return "Para siguiente revisor";
        }

        if (comment.StartsWith("[Nota interna]", StringComparison.OrdinalIgnoreCase))
        {
            return "Interna";
        }

        return null;
    }

    private static string? GetDisplayComment(string? comment)
    {
        if (string.IsNullOrWhiteSpace(comment))
        {
            return comment;
        }

        return comment
            .Replace("[Para autor]", string.Empty, StringComparison.OrdinalIgnoreCase)
            .Replace("[Para siguiente revisor]", string.Empty, StringComparison.OrdinalIgnoreCase)
            .Replace("[Nota interna]", string.Empty, StringComparison.OrdinalIgnoreCase)
            .Trim();
    }

    private sealed record PendingWorkflowAction(string Kind);
}
