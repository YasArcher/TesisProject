    private async Task TakeCaseFromDecisionAsync()
    {
        if (SelectedInboxItem is null)
        {
            return;
        }

        try
        {
            IsSubmittingAction = true;
            var updated = await WorkflowClient.ClaimAsync(SelectedInboxItem.ImportBatchId, new WorkflowActionRequest
            {
                Comments = "[Nota interna] Caso tomado para revisión UODIDE."
            });

            if (updated is not null)
            {
                SelectedWorkflow = updated;
                SuccessMessage = "El caso fue tomado correctamente. Ya puedes revisar el registro del autor.";
            }

            IsCaseDecisionModalOpen = false;
            await RefreshInboxesAsync();
        }
        catch (Exception ex)
        {
            ErrorMessage = $"No pude tomar el caso: {ex.Message}";
        }
        finally
        {
            IsSubmittingAction = false;
        }
    }

