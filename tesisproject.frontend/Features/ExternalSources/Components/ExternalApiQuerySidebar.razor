@using tesisproject.frontend.SharedUI
@using tesisproject.shared.DTOs.ExternalApis

<section class="space-y-4">
    <div class="rounded-[1.55rem] border border-[#d7e3ea] bg-white/95 p-4 shadow-sm">
        <div class="mb-3 flex items-center justify-between gap-3">
            <div>
                <h2 class="text-sm font-black text-[#102642] md:text-base">Proveedores</h2>
                <p class="mt-1 text-[11px] text-slate-500">Selecciona una fuente.</p>
            </div>
            <span class="rounded-full bg-[#eef5fb] px-2.5 py-1 text-[11px] font-semibold text-[#295173]">@Providers.Count</span>
        </div>

        <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
            @foreach (var provider in Providers)
            {
                var isSelected = string.Equals(SelectedProvider?.ProviderKey, provider.ProviderKey, StringComparison.OrdinalIgnoreCase);
                <button class="flex items-center justify-between gap-3 rounded-2xl border px-3.5 py-3 text-left text-xs font-semibold transition @(isSelected ? "border-[#5a7ea6] bg-[linear-gradient(135deg,#eef6ff_0%,#f8fbff_100%)] text-[#102642] shadow-sm" : "border-[#dbe6ef] bg-white text-slate-600 hover:border-[#c2d7ea] hover:bg-[#f8fbfd]")"
                        aria-pressed="@isSelected"
                        type="button"
                        @onclick="async () => await OnSelectProvider.InvokeAsync(provider)">
                    <span class="flex flex-col">
                        <span class="text-sm font-black">@provider.DisplayName</span>
                        <span class="mt-1 text-[11px] font-medium text-slate-500">@GetProviderCompactLabel(provider)</span>
                    </span>
                    <span class="rounded-full px-2 py-1 text-[10px] font-bold @(isSelected ? "bg-[#102642] text-white" : "bg-[#f1f5f9] text-slate-600")">
                        @(isSelected ? "Activo" : "Seleccionar")
                    </span>
                </button>
            }
        </div>
    </div>

    <div class="rounded-[1.55rem] border border-[#d7e3ea] bg-white/95 p-4 shadow-sm">
        <div class="mb-4 flex items-start justify-between gap-3">
            <div>
                <h2 class="text-sm font-black text-[#102642] md:text-base">Búsqueda</h2>
                <p class="mt-1 text-[11px] text-slate-500">Define el criterio.</p>
            </div>
            @if (SelectedProvider is not null)
            {
                <span class="rounded-full bg-[#102642] px-3 py-1 text-[11px] font-semibold text-white">@SelectedProvider.DisplayName</span>
            }
        </div>

        @if (SelectedProvider is null)
        {
            <AppEmptyState Title="Selecciona un proveedor" Message="" />
        }
        else
        {
            <div class="space-y-4">
                <div class="rounded-[1.35rem] border border-[#dbe6ef] bg-[#f9fbfd] p-3.5">
                    <div class="mb-3 flex items-center justify-between gap-3">
                        <div>
                            <div class="text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-500">Modo de búsqueda</div>
                            <div class="mt-1 text-xs text-slate-500">Elige el tipo de consulta.</div>
                        </div>
                        <span class="rounded-full bg-white px-2.5 py-1 text-[11px] font-semibold text-[#295173]">
                            <i class="bi bi-stars mr-1"></i>@GetModeLabel(_queryMode)
                        </span>
                    </div>

                    <div class="grid grid-cols-1 gap-2 md:grid-cols-2 xl:grid-cols-3">
                        @foreach (var mode in GetModeOptions())
                        {
                            var isSelectedMode = string.Equals(_queryMode, mode.Value, StringComparison.OrdinalIgnoreCase);
                            <button class="rounded-2xl border px-3 py-3 text-left transition @(isSelectedMode ? "border-[#5a7ea6] bg-[linear-gradient(135deg,#eef6ff_0%,#f6fbff_100%)] shadow-sm" : "border-[#dbe6ef] bg-white hover:border-[#c2d7ea] hover:bg-[#fbfdff]")"
                                    type="button"
                                    aria-pressed="@isSelectedMode"
                                    @onclick="async () => await SetQueryModeAsync(mode.Value)">
                                <div class="flex items-center justify-between gap-2">
                                    <div class="text-sm font-black @(isSelectedMode ? "text-[#102642]" : "text-slate-700")">@mode.Label</div>
                                    <span class="inline-flex h-6 w-6 items-center justify-center rounded-full @(isSelectedMode ? "bg-[#2f5249] text-[#fff8d4]" : "bg-[#eef2f4] text-slate-400")">
                                        <i class="bi @(isSelectedMode ? "bi-check2" : "bi-plus")"></i>
                                    </span>
                                </div>
                                <div class="mt-1 text-[11px] leading-5 @(isSelectedMode ? "text-[#46627e]" : "text-slate-500")">@mode.Description</div>
                            </button>
                        }
                    </div>
                </div>

                <div class="grid grid-cols-1 gap-3 md:grid-cols-2">
                    <div>
                        <label class="mb-1 block text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Resultados máximos</label>
                        <select class="w-full rounded-xl border border-[#c9d7e3] bg-[#f9fbfd] px-3 py-2 text-sm text-slate-700 outline-none transition focus:border-[#5a7ea6] focus:ring-2 focus:ring-[#d7e9fb]"
                                value="@_maxResults"
                                @onchange="HandleMaxResultsChangedAsync">
                            <option value="5">5</option>
                            <option value="10">10</option>
                            <option value="15">15</option>
                            <option value="20">20</option>
                            <option value="0">Todos los que encuentre</option>
                        </select>
                    </div>
                </div>

                @if (_queryMode == "author")
                {
                    <div class="grid grid-cols-1 gap-3">
                        <div>
                            <label class="mb-1 block text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Autor principal</label>
                            <input class="w-full rounded-xl border border-[#c9d7e3] bg-[#f9fbfd] px-3 py-2 text-sm text-slate-700 outline-none transition focus:border-[#5a7ea6] focus:ring-2 focus:ring-[#d7e9fb]"
                                   value="@_primaryAuthor"
                                   @oninput="HandlePrimaryAuthorChangedAsync" />
                        </div>
                        <label class="inline-flex items-start gap-3 rounded-2xl border border-[#dbe6ef] bg-[linear-gradient(135deg,#fffdf3_0%,#f9fbfd_100%)] px-4 py-3 text-sm text-[#102642] shadow-sm">
                            <input type="checkbox"
                                   class="mt-1"
                                   checked="@RestrictAuthorToInstitution"
                                   @onchange="HandleRestrictAuthorToInstitutionChangedAsync" />
                            <span class="flex flex-col gap-1">
                                <span class="font-semibold">Limitar resultados a filiación UTA</span>
                                <span class="text-xs text-slate-500">Usa Universidad Técnica de Ambato como filtro.</span>
                            </span>
                        </label>
                    </div>
                }
                else if (_queryMode == "affiliation")
                {
                    <div class="rounded-2xl border border-[#dbe6ef] bg-[linear-gradient(135deg,#fffdf3_0%,#f9fbfd_100%)] px-4 py-3 shadow-sm">
                        <div class="flex items-start justify-between gap-3">
                            <div>
                                <div class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Filiación institucional</div>
                                <div class="mt-1 font-semibold text-[#102642]">Universidad Técnica de Ambato</div>
                                <div class="mt-1 text-xs text-slate-500">Producción institucional.</div>
                            </div>
                            <span class="inline-flex h-9 w-9 items-center justify-center rounded-2xl bg-[#2f5249] text-[#fff8d4] shadow-sm">
                                <i class="bi bi-building-check"></i>
                            </span>
                        </div>
                    </div>
                }
                else
                {
                    <div>
                        <label class="mb-1 block text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Consulta</label>
                        <textarea class="min-h-[4.5rem] w-full rounded-xl border border-[#c9d7e3] bg-[#f9fbfd] px-3 py-2.5 text-sm text-slate-700 outline-none transition focus:border-[#5a7ea6] focus:ring-2 focus:ring-[#d7e9fb]"
                                  value="@_queryText"
                                  @oninput="HandleQueryTextChangedAsync"></textarea>
                    </div>
                }

                <div class="app-mobile-stack">
                    <button class="rounded-xl bg-[#102642] px-4 py-2.5 text-sm font-semibold text-white disabled:opacity-60"
                            type="button"
                            disabled="@IsRunningQuery"
                            @onclick="RunQueryFromSidebarAsync">
                        @(IsRunningQuery ? "Consultando..." : "Probar proveedor")
                    </button>
                    <button class="rounded-xl border border-[#c9d7e3] bg-white px-4 py-2.5 text-sm font-semibold text-[#102642]"
                            type="button"
                            @onclick="ClearSearchAsync">
                        Limpiar búsqueda
                    </button>
                </div>
            </div>
        }
    </div>

    @if (RecentQueries.Any())
    {
        <div class="rounded-[1.55rem] border border-[#d7e3ea] bg-white/95 p-4 shadow-sm">
            <div class="mb-3 flex items-start justify-between gap-3">
                <div>
                    <h2 class="text-sm font-black text-[#102642] md:text-base">Consultas recientes</h2>
                    <p class="mt-1 text-[11px] text-slate-500">Reutiliza búsquedas anteriores.</p>
                </div>
                <button class="rounded-full border border-[#dbe6ef] bg-white px-3 py-1.5 text-[11px] font-semibold text-slate-600 hover:bg-[#f8fbfd]"
                        type="button"
                        @onclick="OnClearRecentQueries">
                    Limpiar
                </button>
            </div>

            <div class="space-y-2">
                @foreach (var query in RecentQueries)
                {
                    <button class="w-full rounded-2xl border border-[#dbe6ef] bg-[#fbfdff] px-3.5 py-3 text-left transition hover:border-[#c2d7ea] hover:bg-white"
                            type="button"
                            @onclick="() => OnApplyRecentQuery.InvokeAsync(query)">
                        <div class="flex items-center justify-between gap-3">
                            <div class="text-sm font-black text-[#102642]">@query.ProviderName</div>
                            <span class="rounded-full bg-[#eef5fb] px-2.5 py-1 text-[10px] font-bold text-[#295173]">@GetModeLabel(query.QueryMode)</span>
                        </div>
                        <div class="mt-1 text-xs font-semibold text-slate-600">@GetRecentQueryPreview(query)</div>
                        <div class="mt-2 text-[11px] text-slate-500">@query.ExecutedAtLabel</div>
                    </button>
                }
            </div>
        </div>
    }
</section>

@code {
    [Parameter] public IReadOnlyList<ExternalApiProviderDto> Providers { get; set; } = [];
    [Parameter] public ExternalApiProviderDto? SelectedProvider { get; set; }
    [Parameter] public string QueryMode { get; set; } = "general";
    [Parameter] public EventCallback<string> QueryModeChanged { get; set; }
    [Parameter] public int MaxResults { get; set; } = 10;
    [Parameter] public EventCallback<int> MaxResultsChanged { get; set; }
    [Parameter] public string QueryText { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> QueryTextChanged { get; set; }
    [Parameter] public string InstitutionName { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> InstitutionNameChanged { get; set; }
    [Parameter] public string PrimaryAuthor { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> PrimaryAuthorChanged { get; set; }
    [Parameter] public bool RestrictAuthorToInstitution { get; set; }
    [Parameter] public EventCallback<bool> RestrictAuthorToInstitutionChanged { get; set; }
    [Parameter] public string CoAuthor { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> CoAuthorChanged { get; set; }
    [Parameter] public bool IsRunningQuery { get; set; }
    [Parameter] public EventCallback<ExternalApiProviderDto> OnSelectProvider { get; set; }
    [Parameter] public EventCallback OnRunQuery { get; set; }
    [Parameter] public EventCallback OnClearSearch { get; set; }
    [Parameter] public IReadOnlyList<ExternalApiRecentQueryItem> RecentQueries { get; set; } = [];
    [Parameter] public EventCallback<ExternalApiRecentQueryItem> OnApplyRecentQuery { get; set; }
    [Parameter] public EventCallback OnClearRecentQueries { get; set; }

    private string _queryMode = "general";
    private int _maxResults = 10;
    private string _queryText = string.Empty;
    private string _primaryAuthor = string.Empty;
    private string _coAuthor = string.Empty;

    protected override void OnParametersSet()
    {
        _queryMode = string.IsNullOrWhiteSpace(QueryMode) ? "general" : QueryMode;
        _maxResults = MaxResults;
        _queryText = QueryText ?? string.Empty;
        _primaryAuthor = PrimaryAuthor ?? string.Empty;
        _coAuthor = CoAuthor ?? string.Empty;
    }

    private async Task SetQueryModeAsync(string value)
    {
        var nextValue = string.IsNullOrWhiteSpace(value) ? "general" : value;
        if (string.Equals(_queryMode, nextValue, StringComparison.Ordinal))
        {
            return;
        }

        _queryMode = nextValue;
        await QueryModeChanged.InvokeAsync(nextValue);
    }

    private async Task HandleMaxResultsChangedAsync(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out var parsed))
        {
            return;
        }

        _maxResults = parsed;
        await MaxResultsChanged.InvokeAsync(parsed);
    }

    private async Task HandleQueryTextChangedAsync(ChangeEventArgs args)
    {
        _queryText = args.Value?.ToString() ?? string.Empty;
        await QueryTextChanged.InvokeAsync(_queryText);
    }

    private async Task HandlePrimaryAuthorChangedAsync(ChangeEventArgs args)
    {
        _primaryAuthor = args.Value?.ToString() ?? string.Empty;
        await PrimaryAuthorChanged.InvokeAsync(_primaryAuthor);
    }

    private Task HandleRestrictAuthorToInstitutionChangedAsync(ChangeEventArgs args)
        => RestrictAuthorToInstitutionChanged.InvokeAsync(args.Value is bool value && value);

    private async Task HandleCoAuthorChangedAsync(ChangeEventArgs args)
    {
        _coAuthor = args.Value?.ToString() ?? string.Empty;
        await CoAuthorChanged.InvokeAsync(_coAuthor);
    }

    private string GetProviderCompactLabel(ExternalApiProviderDto provider)
        => string.Equals(provider.ProviderKey, "scopus", StringComparison.OrdinalIgnoreCase)
            ? "DOI · Autor · Filiación"
            : "Texto · DOI";

    private string GetModeLabel(string mode)
        => GetModeOptions().FirstOrDefault(option => string.Equals(option.Value, mode, StringComparison.OrdinalIgnoreCase))?.Label ?? "Texto libre";

    private string GetRecentQueryPreview(ExternalApiRecentQueryItem query)
    {
        if (!string.IsNullOrWhiteSpace(query.PrimaryAuthor))
        {
            return query.PrimaryAuthor;
        }

        if (!string.IsNullOrWhiteSpace(query.InstitutionName))
        {
            return query.InstitutionName;
        }

        return string.IsNullOrWhiteSpace(query.QueryText) ? "Consulta sin texto visible" : query.QueryText;
    }

    private async Task RunQueryFromSidebarAsync()
    {
        var maxResults = _maxResults;
        var queryText = _queryText;
        var primaryAuthor = _primaryAuthor;

        await MaxResultsChanged.InvokeAsync(maxResults);
        await QueryTextChanged.InvokeAsync(queryText);
        await PrimaryAuthorChanged.InvokeAsync(primaryAuthor);
        await CoAuthorChanged.InvokeAsync(string.Empty);
        await OnRunQuery.InvokeAsync();
    }

    private async Task ClearSearchAsync()
    {
        _queryText = string.Empty;
        _primaryAuthor = string.Empty;
        _coAuthor = string.Empty;
        _maxResults = 10;
        await MaxResultsChanged.InvokeAsync(_maxResults);
        await QueryTextChanged.InvokeAsync(_queryText);
        await PrimaryAuthorChanged.InvokeAsync(_primaryAuthor);
        await CoAuthorChanged.InvokeAsync(string.Empty);
        await OnClearSearch.InvokeAsync();
    }

    private IReadOnlyList<QueryModeOption> GetModeOptions()
    {
        var options = new List<QueryModeOption>
        {
            new("general", "Texto libre", "Úsalo para títulos, frases o consultas amplias."),
            new("doi", "DOI exacto", "Ideal para validar una publicación concreta.")
        };

        if (string.Equals(SelectedProvider?.ProviderKey, "scopus", StringComparison.OrdinalIgnoreCase))
        {
            options.Add(new QueryModeOption("author", "Autor", "Busca producción asociada a un autor específico."));
            options.Add(new QueryModeOption("affiliation", "Filiación UTA", "Recupera artículos vinculados a la Universidad Técnica de Ambato."));
        }

        return options;
    }

    private sealed record QueryModeOption(string Value, string Label, string Description);

    public sealed class ExternalApiRecentQueryItem
    {
        public string ProviderKey { get; set; } = string.Empty;
        public string ProviderName { get; set; } = string.Empty;
        public string QueryMode { get; set; } = "general";
        public string QueryText { get; set; } = string.Empty;
        public string InstitutionName { get; set; } = string.Empty;
        public string PrimaryAuthor { get; set; } = string.Empty;
        public string CoAuthor { get; set; } = string.Empty;
        public int MaxResults { get; set; } = 10;
        public string ExecutedAtLabel { get; set; } = string.Empty;
    }
}
