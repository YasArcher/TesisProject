@using tesisproject.shared.DTOs.Reports

<section id="reports-block-people" class="reports-dw-concentration-block">
    <div class="reports-dw-section-heading reports-dw-section-heading--ink reports-dw-concentration-block__heading">
        <span><i class="bi bi-diagram-3"></i></span>
        <div>
            <small>Concentración</small>
            <h2>Facultades, líneas y campos</h2>
            <p>Distribución académica por facultad, línea de investigación y campo de conocimiento.</p>
        </div>
    </div>

    @if (HasOverflowData)
    {
        <div class="reports-dw-inline-note reports-dw-concentration-block__note">
            Las listas muestran toda la información disponible y permiten desplazamiento cuando crecen.
        </div>
    }

    <div class="reports-dw-concentration-block__grid">
        <article class="reports-dw-chart-card reports-dw-chart-card--compact reports-dw-concentration-card">
            <ReportCardHeader IconClass="bi bi-mortarboard"
                              Title="Facultades"
                              Description="Producción por facultad." />
            <div class="reports-dw-scroll-panel">
                <ReportBarList Items="@FacultyBarItems"
                               FillVariant="sage"
                               EmptyMessage="Sin facultades registradas para el filtro actual." />
            </div>
        </article>

        <article class="reports-dw-chart-card reports-dw-chart-card--compact reports-dw-concentration-card">
            <ReportCardHeader IconClass="bi bi-bezier2"
                              Title="Líneas de investigación"
                              Description="Producción por línea." />
            <div class="reports-dw-scroll-panel">
                <ReportBarList Items="@ResearchLineBarItems"
                               FillVariant="sage"
                               EmptyMessage="Sin líneas de investigación registradas." />
            </div>
        </article>

        <article class="reports-dw-chart-card reports-dw-chart-card--wide reports-dw-concentration-card reports-dw-concentration-card--fields">
            <ReportCardHeader IconClass="bi bi-diagram-3"
                              Title="Campos de conocimiento"
                              Description="Campos amplio, específico y detallado." />
            <div class="reports-dw-table-wrap reports-dw-table-wrap--compact reports-dw-table-wrap--scrollable">
                <table class="reports-dw-table">
                    <thead>
                    <tr>
                        <th>Campo amplio</th>
                        <th>Campo específico</th>
                        <th>Campo detallado</th>
                        <th>Artículos</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var field in Dashboard?.ArticlesByField ?? [])
                    {
                        <tr>
                            <td>@field.BroadField</td>
                            <td>@field.SpecificField</td>
                            <td>@field.DetailedField</td>
                            <td>@field.TotalArticles</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </article>
    </div>
</section>

@code {
    [Parameter] public InstitutionalReportingDashboardDto? Dashboard { get; set; }

    private bool HasOverflowData =>
        (Dashboard?.ArticlesByFaculty.Count ?? 0) > 8
        || (Dashboard?.ArticlesByResearchLine.Count ?? 0) > 8
        || (Dashboard?.ArticlesByField.Count ?? 0) > 12;

    private IEnumerable<ReportBarItem> FacultyBarItems =>
        Dashboard?.ArticlesByFaculty.Select(ToBarItem) ?? [];

    private IEnumerable<ReportBarItem> ResearchLineBarItems =>
        Dashboard?.ArticlesByResearchLine.Select(ToBarItem) ?? [];

    private static ReportBarItem ToBarItem(ReportingSummaryItemDto item)
        => new(item.Name, item.TotalArticles, item.Name);
}
