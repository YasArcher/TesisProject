@using tesisproject.frontend.Features.Components
@using tesisproject.frontend.SharedUI
@using tesisproject.frontend.SharedUI.SearchInput
@using tesisproject.frontend.SharedUI.ActionButton
@using tesisproject.frontend.Services.Interfaces
@using tesisproject.shared.DTOs.External
@using tesisproject.shared.DTOs.Group.Request
@using tesisproject.shared.DTOs.AppUser
@using tesisproject.shared.DTOs.Group.Response
@using tesisproject.shared.DTOs.Catalog.MemberRoleType.Response

@inject IToastService Toast

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 h-[570px]">

    <!-- Panel izquierdo: Lista de Grupos -->
    <div class="flex-1 min-h-0 overflow-y-auto flex flex-col">
        <!-- Buscador de grupos -->
        <SearchInput Class="mb-4"
                     Placeholder="Buscar grupos..."
                     AriaLabel="Search groups"
                     @bind-Value="searchTerm"
                     DebounceMs="200" />

        <div class="flex-1 min-h-0 overflow-y-auto">
            <Container TItem="GroupResponseDTO"
                       Items="@FilteredGroups"
                       Title="Grupos"
                       ShowItemCount="true"
                       GridClasses="grid grid-cols-1 gap-4"
                       EmptyStateTitle="No hay grupos"
                       EmptyStateDescription="Aún no existen grupos."
                       IsLoading="@IsLoading">

                <ChildContent Context="group">
                    <button type="button"
                            class="w-full block text-left"
                            @onclick="() => SelectGroupAsync(group.GroupId)">
                        <GroupCard Item="@group" Selected="@(group.GroupId == SelectedGroupId)" />
                    </button>
                </ChildContent>

                <EmptyStateAction>
                    <ActionButton Text="Crear Grupo"
                                  Execute="@( () => Task.CompletedTask )"
                                  Intent="ButtonIntent.Info"
                                  Variant="ButtonVariant.Filled"
                                  Size="ButtonSize.Sm"
                                  Disabled="true"
                                  Class="btn-primary-solid text-sm" >
                        <Icon>
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6">
                                <path fill-rule="evenodd" d="M8.25 6.75a3.75 3.75 0 1 1 7.5 0 3.75 3.75 0 0 1-7.5 0ZM15.75 9.75a3 3 0 1 1 6 0 3 3 0 0 1-6 0ZM2.25 9.75a3 3 0 1 1 6 0 3 3 0 0 1-6 0ZM6.31 15.117A6.745 6.745 0 0 1 12 12a6.745 6.745 0 0 1 6.709 7.498.75.75 0 0 1-.372.568A12.696 12.696 0 0 1 12 21.75c-2.305 0-4.47-.612-6.337-1.684a.75.75 0 0 1-.372-.568 6.787 6.787 0 0 1 1.019-4.38Z" clip-rule="evenodd" />
                                <path d="M5.082 14.254a8.287 8.287 0 0 0-1.308 5.135 9.687 9.687 0 0 1-1.764-.44l-.115-.04a.563.563 0 0 1-.373-.487l-.01-.121a3.75 3.75 0 0 1 3.57-4.047ZM20.226 19.389a8.287 8.287 0 0 0-1.308-5.135 3.75 3.75 0 0 1 3.57 4.047l-.01.121a.563.563 0 0 1-.373.486l-.115.04c-.567.2-1.156.349-1.764.441Z" />
                            </svg>
                        </Icon>
                    </ActionButton>
                </EmptyStateAction>

            </Container>
        </div>
    </div>

    <!-- Panel derecho: Detalles del grupo seleccionado -->
    <div class="flex flex-col min-h-0">
        @if (SelectedGroup is not null)
        {
            <div class="mb-4 p-4 bg-primary-subtle border border-border rounded-xl">
                <div class="flex items-start justify-between">
                    <div class="flex items-start gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6">
                            <path fill-rule="evenodd" d="M1.5 7.125c0-1.036.84-1.875 1.875-1.875h6c1.036 0 1.875.84 1.875 1.875v3.75c0 1.036-.84 1.875-1.875 1.875h-6A1.875 1.875 0 0 1 1.5 10.875v-3.75Zm12 1.5c0-1.036.84-1.875 1.875-1.875h5.25c1.035 0 1.875.84 1.875 1.875v8.25c0 1.035-.84 1.875-1.875 1.875h-5.25a1.875 1.875 0 0 1-1.875-1.875v-8.25ZM3 16.125c0-1.036.84-1.875 1.875-1.875h5.25c1.036 0 1.875.84 1.875 1.875v2.25c0 1.035-.84 1.875-1.875 1.875h-5.25A1.875 1.875 0 0 1 3 18.375v-2.25Z" clip-rule="evenodd" />
                        </svg>
                        <div>
                            <h2 class="text-xl font-semibold text-foreground mb-1">@SelectedGroup.Name</h2>
                            <p class="text-sm text-muted">@GroupMembers.Count miembros</p>
                        </div>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-success text-success-foreground">
                            ● Activo
                        </span>
                    </div>
                </div>
            </div>

            <div class="flex-1 min-h-0 flex flex-col">
                <!-- Buscador de miembros -->
                <SearchInput Class="mb-3"
                             Placeholder="Buscar miembros..."
                             AriaLabel="Search members"
                             @bind-Value="memberSearchTerm"
                             DebounceMs="200" />

                <div class="flex-1 min-h-0 overflow-y-auto">
                    <Container TItem="ResolvedUserProfileDTO"
                               Items="@FilteredMembers"
                               Title="Integrantes"
                               ShowItemCount="true"
                               GridClasses="grid grid-cols-1 gap-3"
                               EmptyStateTitle="Sin miembros"
                               EmptyStateDescription="Este grupo aún no tiene miembros asignados"
                               IsLoading="@IsLoadingMembers">
                        <HeaderIcon>
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6">
                                <path fill-rule="evenodd" d="M18.685 19.097A9.723 9.723 0 0 0 21.75 12c0-5.385-4.365-9.75-9.75-9.75S2.25 6.615 2.25 12a9.723 9.723 0 0 0 3.065 7.097A9.716 9.716 0 0 0 12 21.75a9.716 9.716 0 0 0 6.685-2.653Zm-12.54-1.285A7.486 7.486 0 0 1 12 15a7.486 7.486 0 0 1 5.855 2.812A8.224 8.224 0 0 1 12 20.25a8.224 8.224 0 0 1-5.855-2.438ZM15.75 9a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" clip-rule="evenodd" />
                            </svg>
                        </HeaderIcon>

                        <ChildContent Context="member">
                            <MemberCard Item="@member" OnRemoved="HandleMemberRemoved" />
                        </ChildContent>

                        <EmptyStateAction>
                            <ActionButton Text="Agregar Miembro"
                                          Intent="ButtonIntent.Info"
                                          Variant="ButtonVariant.Outline"
                                          Size="ButtonSize.Sm"
                                          Class="text-sm"
                                          Execute="OnAddMemberClick" />
                        </EmptyStateAction>
                    </Container>

                </div>

                <div class="mt-4 flex gap-3">
                    <ActionButton Text="Agregar Miembro"
                                  Intent="ButtonIntent.Info"
                                  Variant="ButtonVariant.Outline"
                                  Size="ButtonSize.Sm"
                                  Class="text-sm"
                                  Execute="OnAddMemberClick">
                        <Icon>
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6">
                                <path d="M5.25 6.375a4.125 4.125 0 1 1 8.25 0 4.125 4.125 0 0 1-8.25 0ZM2.25 19.125a7.125 7.125 0 0 1 14.25 0v.003l-.001.119a.75.75 0 0 1-.363.63 13.067 13.067 0 0 1-6.761 1.873c-2.472 0-4.786-.684-6.76-1.873a.75.75 0 0 1-.364-.63l-.001-.122ZM18.75 7.5a.75.75 0 0 0-1.5 0v2.25H15a.75.75 0 0 0 0 1.5h2.25v2.25a.75.75 0 0 0 1.5 0v-2.25H21a.75.75 0 0 0 0-1.5h-2.25V7.5Z" />
                            </svg>
                        </Icon>
                    </ActionButton>
                    <ActionButton Text="Configurar Grupo"
                                  Intent="ButtonIntent.Neutral"
                                  Variant="ButtonVariant.Ghost"
                                  Size="ButtonSize.Sm"
                                  Class="text-sm"
                                  Execute="OnConfigureGroupClick"
                                  Disabled="@(SelectedGroup is null)">
                        <Icon>
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6">
                                <path fill-rule="evenodd" d="M11.828 2.25c-.916 0-1.699.663-1.85 1.567l-.091.549a.798.798 0 0 1-.517.608 7.45 7.45 0 0 0-.478.198.798.798 0 0 1-.796-.064l-.453-.324a1.875 1.875 0 0 0-2.416.2l-.243.243a1.875 1.875 0 0 0-.2 2.416l.324.453a.798.798 0 0 1 .064.796 7.448 7.448 0 0 0-.198.478.798.798 0 0 1-.608.517l-.55.092a1.875 1.875 0 0 0-1.566 1.849v.344c0 .916.663 1.699 1.567 1.85l.549.091c.281.047.508.25.608.517.06.162.127.321.198.478a.798.798 0 0 1-.064.796l-.324.453a1.875 1.875 0 0 0 .2 2.416l.243.243c.648.648 1.67.733 2.416.2l.453-.324a.798.798 0 0 1 .796-.064c.157.071.316.137.478.198.267.1.47.327.517.608l.092.55c.15.903.932 1.566 1.849 1.566h.344c.916 0 1.699-.663 1.85-1.567l.091-.549a.798.798 0 0 1 .517-.608 7.52 7.52 0 0 0 .478-.198.798.798 0 0 1 .796.064l.453.324a1.875 1.875 0 0 0 2.416-.2l.243-.243c.648-.648.733-1.67.2-2.416l-.324-.453a.798.798 0 0 1-.064-.796c.071-.157.137-.316.198-.478.1-.267.327-.47.608-.517l.55-.091a1.875 1.875 0 0 0 1.566-1.85v-.344c0-.916-.663-1.699-1.567-1.85l-.549-.091a.798.798 0 0 1-.608-.517 7.507 7.507 0 0 0-.198-.478.798.798 0 0 1 .064-.796l.324-.453a1.875 1.875 0 0 0-.2-2.416l-.243-.243a1.875 1.875 0 0 0-2.416-.2l-.453.324a.798.798 0 0 1-.796.064 7.462 7.462 0 0 0-.478-.198.798.798 0 0 1-.517-.608l-.091-.55a1.875 1.875 0 0 0-1.85-1.566h-.344ZM12 15.75a3.75 3.75 0 1 0 0-7.5 3.75 3.75 0 0 0 0 7.5Z" clip-rule="evenodd" />
                            </svg>
                        </Icon>
                    </ActionButton>
                </div>
            </div>
        }
        else
        {
            <div class="flex-1 flex items-center justify-center p-8 border-2 border-dashed border-border rounded-xl">
                <div class="text-center">
                    <h3 class="text-lg font-medium text-foreground mb-2">Selecciona un grupo</h3>
                    <p class="text-sm text-muted">Elige un grupo de la lista para ver sus integrantes y detalles</p>
                </div>
            </div>
        }
    </div>
</div>

<!-- MODAL: User Picker -->
<UserPickerModal ModalId="user-picker"
                 IsOpen="@_showUserPicker"
                 IsOpenChanged="(bool v) => _showUserPicker = v"
                 Users="@_candidates"
                 InitialSelectedUserId="@_preselectedUserId"
                 OnSubmit="HandleUserPicked"
                 OnCancel="() => _showUserPicker = false"
                 Roles="MemberRoles"
                 @bind-SelectedRoleId="_selectedRoleId" />

<!-- MODAL: Group (Edit) -->
@if (SelectedGroup is not null)
{
    <GroupCreateModal ModalId="group-edit-modal"
                      IsOpen="@_showGroupModal"
                      IsOpenChanged="(bool v) => _showGroupModal = v"
                      IsEdit="true"
                      GroupToEdit="@SelectedGroup"
                      GroupTypeId="1"
                      OnUpdate="HandleUpdateGroupAsync"
                      OnCancel="@(()=> _showGroupModal = false)" />
}

@code {
    /* ===== Parámetros públicos ===== */
    [Parameter] public EventCallback OnReloadGroups { get; set; }
    [Parameter] public List<GroupResponseDTO> Groups { get; set; } = new();
    [Parameter] public int? SelectedGroupId { get; set; }
    [Parameter] public EventCallback<int> OnGroupSelected { get; set; }
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public bool IsLoadingMembers { get; set; }
    [Parameter] public List<ResolvedUserProfileDTO> GroupMembers { get; set; } = new();

    // NUEVO: roles de miembro (ya filtrados por Flag = 2 en el padre)
    [Parameter] public IEnumerable<MemberRoleTypeDetailDTO>? MemberRoles { get; set; }

    // === Eventos hacia el padre (CRUD + candidatos) ===
    [Parameter] public EventCallback<AddGroupMemberRequestDTO> OnRequestAddMember { get; set; }
    [Parameter] public EventCallback<UpdateGroupRequestDTO> OnRequestUpdateGroup { get; set; }
    [Parameter] public EventCallback<int> OnRequestRemoveMember { get; set; }
    [Parameter] public Func<int, Task<List<ResolvedUserProfileDTO>>> OnAskCandidates { get; set; } = default!;

    /* ===== Estado local UI ===== */
    private string searchTerm = "";
    private string memberSearchTerm = "";

    // Picker state
    private bool _showUserPicker;
    private List<ResolvedUserProfileDTO> _candidates = new();
    private int? _preselectedUserId;

    // Group edit modal state
    private bool _showGroupModal;

    // Role seleccionado en el UserPickerModal
    private int? _selectedRoleId;

    /* ===== Computados ===== */
    private GroupResponseDTO? SelectedGroup =>
        Groups.FirstOrDefault(g => g.GroupId == SelectedGroupId);

    private List<GroupResponseDTO> FilteredGroups =>
        string.IsNullOrWhiteSpace(searchTerm)
            ? Groups
            : Groups.Where(g => g.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)).ToList();

    private List<ResolvedUserProfileDTO> FilteredMembers =>
        string.IsNullOrWhiteSpace(memberSearchTerm)
            ? GroupMembers
            : GroupMembers.Where(m =>
                   (!string.IsNullOrWhiteSpace(m.FullName) && m.FullName.Contains(memberSearchTerm, StringComparison.OrdinalIgnoreCase)) ||
                   (!string.IsNullOrWhiteSpace(m.Email) && m.Email.Contains(memberSearchTerm, StringComparison.OrdinalIgnoreCase))
              ).ToList();

    /* ===== Acciones ===== */
    private async Task SelectGroupAsync(int groupId)
    {
        if (OnGroupSelected.HasDelegate)
            await OnGroupSelected.InvokeAsync(groupId);
    }

    private async Task HandleMemberRemoved(int userGroupId)
    {
        if (OnRequestRemoveMember.HasDelegate)
            await OnRequestRemoveMember.InvokeAsync(userGroupId);

        if (OnReloadGroups.HasDelegate)
            await OnReloadGroups.InvokeAsync();
    }

    private async Task OnAddMemberClick()
    {
        if (SelectedGroupId is null)
        {
            Toast.ShowWarning("Select a group first.");
            return;
        }

        var candidates = await OnAskCandidates.Invoke(SelectedGroupId.Value);
        _candidates = candidates;

        if (_candidates.Count == 0)
        {
            Toast.ShowInfo("No available users to add.");
            return;
        }

        _preselectedUserId = null;
        _selectedRoleId = null; // reset rol
        _showUserPicker = true;
    }

    private async Task HandleUserPicked(int userId)
    {
        if (SelectedGroupId is null)
        {
            Toast.ShowWarning("Select a group first.");
            return;
        }

        if (_selectedRoleId is null || _selectedRoleId <= 0)
        {
            Toast.ShowWarning("Seleccione un rol para el miembro.");
            return;
        }

        var selected = _candidates.FirstOrDefault(u => u.UserId == userId);
        if (selected is null)
        {
            Toast.ShowError("Selected user not found in candidates.");
            return;
        }

        var request = new AddGroupMemberRequestDTO
        {
            GroupId = SelectedGroupId.Value,
            MemberRole = _selectedRoleId.Value,  // <-- AQUÍ VA EL ID DEL ROL
            Email = selected.Email,
            Document = selected.Document,
            AspUserId = selected.AspNetUserId
        };

        await OnRequestAddMember.InvokeAsync(request);
        _showUserPicker = false;
    }


    private Task OnConfigureGroupClick()
    {
        if (SelectedGroup is null)
        {
            Toast.ShowWarning("Select a group first.");
            return Task.CompletedTask;
        }

        _showGroupModal = true;
        return Task.CompletedTask;
    }

    private async Task HandleUpdateGroupAsync(UpdateGroupRequestDTO dto)
    {
        await OnRequestUpdateGroup.InvokeAsync(dto);
        _showGroupModal = false;
    }
}
