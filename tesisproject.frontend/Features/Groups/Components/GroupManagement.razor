@using tesisproject.frontend.SharedUI.Tabs
@using tesisproject.shared.DTOs.Group.Response
@using tesisproject.shared.DTOs.Group.Request
@using tesisproject.shared.DTOs.External
@using tesisproject.shared.Enums

<div class="space-y-6">
    <Tabs ActiveKey="@CurrentTabKey" OnChange="OnTabChanged">
        <Tab Key="tipo1" Title="Grupo Investigacion">
            <GroupTabContent ProjectType="ProjectType.Type1"
                             Groups="GroupsTipo1"
                             SelectedGroupId="SelectedGroupIdTipo1"
                             OnGroupSelected="@(gid => HandleChildSelect(ProjectType.Type1, gid))"
                             GroupMembers="MembersTipo1"
                             IsLoading="IsLoading"
                             IsLoadingMembers="IsLoadingMembersTipo1"
                             OnReloadGroups="OnReloadGroups"
                             OnRequestAddMember="OnRequestAddMember"
                             OnRequestUpdateGroup="OnRequestUpdateGroup"
                             OnRequestRemoveMember="OnRequestRemoveMember"
                             OnAskCandidates="OnAskCandidates" />
        </Tab>

        <Tab Key="tipo2" Title="Grupo Senesyt">
            <GroupTabContent ProjectType="ProjectType.Type2"
                             Groups="GroupsTipo2"
                             SelectedGroupId="SelectedGroupIdTipo2"
                             OnGroupSelected="@(gid => HandleChildSelect(ProjectType.Type2, gid))"
                             GroupMembers="MembersTipo2"
                             IsLoading="IsLoading"
                             IsLoadingMembers="IsLoadingMembersTipo2"
                             OnReloadGroups="OnReloadGroups"
                             OnRequestAddMember="OnRequestAddMember"
                             OnRequestUpdateGroup="OnRequestUpdateGroup"
                             OnRequestRemoveMember="OnRequestRemoveMember"
                             OnAskCandidates="OnAskCandidates" />
        </Tab>
    </Tabs>
</div>

@code {
    // ===== Estado controlado desde el PADRE (página) =====
    [Parameter] public string CurrentTabKey { get; set; } = "tipo1";
    [Parameter] public EventCallback<string> CurrentTabKeyChanged { get; set; }

    [Parameter] public List<GroupResponseDTO> GroupsTipo1 { get; set; } = new();
    [Parameter] public List<GroupResponseDTO> GroupsTipo2 { get; set; } = new();

    [Parameter] public int? SelectedGroupIdTipo1 { get; set; }
    [Parameter] public int? SelectedGroupIdTipo2 { get; set; }

    [Parameter] public List<ExternalUserDTO> MembersTipo1 { get; set; } = new();
    [Parameter] public List<ExternalUserDTO> MembersTipo2 { get; set; } = new();

    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public bool IsLoadingMembersTipo1 { get; set; }
    [Parameter] public bool IsLoadingMembersTipo2 { get; set; }

    // Eventos hacia el PADRE (página)
    [Parameter] public EventCallback<(ProjectType type, int groupId)> OnGroupSelected { get; set; }
    [Parameter] public EventCallback OnReloadGroups { get; set; }

    // Passthrough CRUD hacia Page
    [Parameter] public EventCallback<AddGroupMemberRequestDTO> OnRequestAddMember { get; set; }
    [Parameter] public EventCallback<UpdateGroupRequestDTO> OnRequestUpdateGroup { get; set; }
    [Parameter] public EventCallback<int> OnRequestRemoveMember { get; set; }
    [Parameter] public Func<int, Task<List<ExternalUserDTO>>> OnAskCandidates { get; set; } = default!;

    private async Task OnTabChanged(string newKey)
        => await CurrentTabKeyChanged.InvokeAsync(newKey);

    private async Task HandleChildSelect(ProjectType type, int gid)
    {
        if (OnGroupSelected.HasDelegate)
            await OnGroupSelected.InvokeAsync((type, gid));
    }
}
