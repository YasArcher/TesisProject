@page "/groups"

@using static tesisproject.frontend.Features.Groups.Components.GroupManagement
@using tesisproject.frontend.Features.Groups.Components
@using tesisproject.frontend.Services.Interfaces
@using tesisproject.frontend.SharedUI.ActionButton
@using tesisproject.shared.DTOs.Group.Request
@using tesisproject.shared.DTOs.Group.Response
@using tesisproject.shared.DTOs.External
@using tesisproject.shared.Enums
@using tesisproject.shared.Responses
@using tesisproject.frontend.Services

@inject IToastService Toast
@inject IGroupService GroupService
@inject IExternalUserService ExternalUserService

<div class="space-y-4">
    <!-- Header -->
    <div class="flex items-center justify-between px-6 py-4 rounded-lg shadow-sm bg-primary text-white">
        <h1 class="text-xl font-bold tracking-tight">Grupos</h1>

        <ActionButton Text="Crear"
                      Execute="@OnCreateClick"
                      Intent="ButtonIntent.Add"
                      Variant="ButtonVariant.Outline"
                      Size="ButtonSize.Md"
                      Class="btn-primary-solid"
        >
        <Icon>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6">
  <path fill-rule="evenodd" d="M12 2.25c-5.385 0-9.75 4.365-9.75 9.75s4.365 9.75 9.75 9.75 9.75-4.365 9.75-9.75S17.385 2.25 12 2.25ZM12.75 9a.75.75 0 0 0-1.5 0v2.25H9a.75.75 0 0 0 0 1.5h2.25V15a.75.75 0 0 0 1.5 0v-2.25H15a.75.75 0 0 0 0-1.5h-2.25V9Z" clip-rule="evenodd" />
</svg>

        </Icon>
        </ActionButton>
    </div>

    <!-- Content -->
    <div>
        <GroupManagement CurrentTabKey="@currentTabKey"
                         CurrentTabKeyChanged="OnTabChanged"
                         GroupsTipo1="@groupsTipo1"
                         GroupsTipo2="@groupsTipo2"
                         SelectedGroupIdTipo1="@selectedGroupIdTipo1"
                         SelectedGroupIdTipo2="@selectedGroupIdTipo2"
                         MembersTipo1="@membersTipo1"
                         MembersTipo2="@membersTipo2"
                         IsLoading="@isLoading"
                         IsLoadingMembersTipo1="@isLoadingMembersTipo1"
                         IsLoadingMembersTipo2="@isLoadingMembersTipo2"
                         OnGroupSelected="HandleGroupSelected"
                         OnReloadGroups="ReloadAfterMemberChange"
                         OnRequestAddMember="HandleAddMember"
                         OnRequestUpdateGroup="HandleUpdateGroup"
                         OnRequestRemoveMember="HandleRemoveMember"
                         OnAskCandidates="HandleAskCandidates" />
    </div>
</div>

<!-- Modal “dumb child” -->
<GroupCreateModal @key="_modalKey"
                  ModalId="group-create-modal"
                  IsEdit="false"
                  @bind-IsOpen="_openCreate"
                  TypeALabel="Administrative"
                  TypeBLabel="Academic"
                  OnCreate="HandleCreate"
                  OnCancel="HandleCancel" />

@code {
    // ====== Estado UI ======
    private bool _openCreate;
    private int _modalKey = 0;
    private string currentTabKey = "tipo1";

    // ====== Estado de datos ======
    private List<GroupResponseDTO> allGroups = new();

    // El hijo espera List<...> concretas
    private List<GroupResponseDTO> groupsTipo1 => allGroups.Where(g => g.GroupTypeId == 1).ToList();
    private List<GroupResponseDTO> groupsTipo2 => allGroups.Where(g => g.GroupTypeId == 2).ToList();

    private int? selectedGroupIdTipo1;
    private int? selectedGroupIdTipo2;

    private List<ExternalUserDTO> membersTipo1 = new();
    private List<ExternalUserDTO> membersTipo2 = new();

    private bool isLoading;
    private bool isLoadingMembersTipo1;
    private bool isLoadingMembersTipo2;

    protected override async Task OnInitializedAsync()
    {
        await LoadGroupsAsync();
        await EnsureDefaultSelectionFor(CurrentType());
    }

    private void OnCreateClick()
    {
        _modalKey++;
        _openCreate = true;
        StateHasChanged();
    }

    private async Task HandleCreate(AddGroupRequestDTO dto)
    {
        try
        {
            var response = await GroupService.CreateAsync(dto);

            if (response.Success)
            {
                Toast.ShowSuccess("Grupo creado exitosamente.");
                var createdId = response.Response?.GroupId;
                var createdTypeId = dto.GroupTypeId;

                _openCreate = false;

                // Refrescar lista y seleccionar el recién creado
                await LoadGroupsAsync();

                if (createdId.HasValue)
                {
                    var targetType = MapGroupTypeIdToProjectType(createdTypeId);
                    currentTabKey = targetType == ProjectType.Type2 ? "tipo2" : "tipo1";
                    await HandleGroupSelected((targetType, createdId.Value));
                }

                StateHasChanged();
                return;
            }

            Toast.ShowError(response.Error ?? "Error al crear el grupo.");
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Excepción al crear el grupo: {ex.Message}");
        }
    }

    private Task HandleCancel()
    {
        _openCreate = false;
        StateHasChanged();
        return Task.CompletedTask;
    }

    // ====== Carga de datos ======
    private async Task LoadGroupsAsync()
    {
        isLoading = true; StateHasChanged();
        try
        {
            var resp = await GroupService.GetListAsync();
            allGroups = resp.Response ?? new();
        }
        finally
        {
            isLoading = false; StateHasChanged();
        }
    }

    private async Task EnsureDefaultSelectionFor(ProjectType type)
    {
        if (type == ProjectType.Type1)
        {
            if (selectedGroupIdTipo1 is null)
            {
                var first = groupsTipo1.FirstOrDefault();
                if (first is not null)
                    await HandleGroupSelected((ProjectType.Type1, first.GroupId));
            }
        }
        else
        {
            if (selectedGroupIdTipo2 is null)
            {
                var first = groupsTipo2.FirstOrDefault();
                if (first is not null)
                    await HandleGroupSelected((ProjectType.Type2, first.GroupId));
            }
        }
    }

    // Evento del hijo con tupla (tipo, id)
    private async Task HandleGroupSelected((ProjectType type, int groupId) args)
    {
        var (projectType, groupId) = args;
        await LoadMembersFor(projectType, groupId);
    }

    private async Task LoadMembersFor(ProjectType projectType, int groupId)
    {
        if (projectType == ProjectType.Type1)
        {
            selectedGroupIdTipo1 = groupId;
            isLoadingMembersTipo1 = true; StateHasChanged();

            var res = await GroupService.GetMembersByGroupIdAsync(groupId);
            membersTipo1 = res.Response ?? new();

            isLoadingMembersTipo1 = false; StateHasChanged();
        }
        else
        {
            selectedGroupIdTipo2 = groupId;
            isLoadingMembersTipo2 = true; StateHasChanged();

            var res = await GroupService.GetMembersByGroupIdAsync(groupId);
            membersTipo2 = res.Response ?? new();

            isLoadingMembersTipo2 = false; StateHasChanged();
        }
    }

    private async Task OnTabChanged(string newTabKey)
    {
        currentTabKey = newTabKey;
        await EnsureDefaultSelectionFor(CurrentType());
        StateHasChanged();
    }

    private async Task ReloadAfterMemberChange()
    {
        if (currentTabKey == "tipo1" && selectedGroupIdTipo1 is int g1)
            await LoadMembersFor(ProjectType.Type1, g1);
        else if (currentTabKey == "tipo2" && selectedGroupIdTipo2 is int g2)
            await LoadMembersFor(ProjectType.Type2, g2);
    }

    private ProjectType CurrentType() => currentTabKey == "tipo2" ? ProjectType.Type2 : ProjectType.Type1;

    private static ProjectType MapGroupTypeIdToProjectType(int groupTypeId)
        => groupTypeId == 2 ? ProjectType.Type2 : ProjectType.Type1;

    // ====== CRUD (desde hijos) ======

    private async Task HandleAddMember(AddGroupMemberRequestDTO dto)
    {
        var res = await GroupService.AddMemberAsync(dto);
        if (!res.Success) { Toast.ShowError(res.Error ?? "No se pudo agregar el miembro."); return; }
        Toast.ShowSuccess("Miembro agregado.");
        await ReloadAfterMemberChange();
    }

    private async Task HandleUpdateGroup(UpdateGroupRequestDTO dto)
    {
        var res = await GroupService.UpdateAsync(dto);
        if (!res.Success) { Toast.ShowError(res.Error ?? "No se pudo actualizar el grupo."); return; }
        Toast.ShowSuccess("Grupo actualizado.");
        await LoadGroupsAsync();
        await ReloadAfterMemberChange();
    }

    private async Task HandleRemoveMember(int userGroupId)
    {
        // TODO: reemplazar por tu endpoint real cuando exista:
        // var res = await GroupService.RemoveMemberAsync(userGroupId);
        // if (!res.Success) { Toast.ShowError(res.Error ?? "No se pudo eliminar el miembro."); return; }
        // Toast.ShowSuccess("Miembro eliminado.");
        // await ReloadAfterMemberChange();

        Toast.ShowInfo("Eliminar miembro: implementar RemoveMemberAsync en IGroupService.");
        await Task.CompletedTask;
    }

    private async Task<List<ExternalUserDTO>> HandleAskCandidates(int groupId)
    {
        var all = await ExternalUserService.GetListAsync();
        if (!all.Success)
        {
            Toast.ShowError(all.Error ?? "No se pudieron cargar usuarios.");
            return new();
        }

        // Determina miembros actuales del tab activo
        var existing = currentTabKey == "tipo2" ? membersTipo2 : membersTipo1;
        var existingIds = new HashSet<int>(existing.Select(m => m.UserId));

        return (all.Response ?? new())
            .Where(u => !existingIds.Contains(u.UserId))
            .OrderBy(u => u.FullName)
            .ToList();
    }
}
