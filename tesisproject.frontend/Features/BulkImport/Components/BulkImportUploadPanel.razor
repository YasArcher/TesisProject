@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms

<div class="rounded-[1.45rem] border border-[#d9e5e8] bg-white p-3.5 shadow-sm">
    <div class="mb-3 flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
        <h2 class="text-base font-black text-[#12343b] md:text-lg">2. Subir archivo al staging</h2>
        <span class="rounded-full bg-[#eef5f6] px-3 py-1 text-xs font-semibold text-[#2f4858]">Estados: Pending · Validated · Processed · Error</span>
    </div>

    <div class="grid grid-cols-1 gap-3 lg:grid-cols-[0.8fr_0.2fr]">
        <div class="rounded-3xl border-2 border-dashed border-[#c7d6da] bg-[#f8fbfc] p-3">
            <div class="flex flex-col gap-2 md:flex-row md:items-center md:justify-between">
                <div>
                    <div class="font-semibold text-[#12343b]">Archivo de carga</div>
                    <div class="text-xs text-slate-500">Excel o CSV para crear el lote en staging.</div>
                </div>
                <InputFile OnChange="OnFileSelected" accept=".xlsx,.xls,.csv" class="block text-sm text-slate-600" />
            </div>

            @if (SelectedFile is not null)
            {
                <div class="mt-3 rounded-2xl border border-emerald-200 bg-emerald-50 px-4 py-2.5 text-sm text-emerald-800">
                    Archivo seleccionado: <span class="font-semibold">@SelectedFile.Name</span> · @((SelectedFile.Size / 1024.0).ToString("F1")) KB
                </div>
            }
        </div>

        <div class="space-y-2.5 rounded-3xl border border-[#ead8bd] bg-[#fffdf8] p-3">
            <label class="block text-sm font-semibold text-[#8b5a16]">Fuente</label>
            <select class="w-full rounded-xl border border-[#e1d1b0] bg-white px-3 py-2 text-sm"
                    value="@SelectedSourceType"
                    @onchange="HandleSourceTypeChanged">
                <option value="Excel">Excel</option>
                <option value="Csv">CSV</option>
                <option value="Manual">Manual</option>
            </select>
            <label class="block text-sm font-semibold text-[#8b5a16]">Notas</label>
            <textarea class="min-h-[3.2rem] w-full rounded-xl border border-[#e1d1b0] bg-white px-3 py-2 text-sm"
                      value="@UploadNotes"
                      @oninput="HandleNotesChanged"
                      placeholder="Objetivo del lote o subconjunto cargado."></textarea>
            <button class="w-full rounded-xl bg-gradient-to-r from-[#c17c2f] to-[#d08d46] px-4 py-2.5 text-sm font-semibold text-white disabled:opacity-60"
                    disabled="@(SelectedFile is null || IsUploading)"
                    @onclick="OnRequestUpload">
                @(IsUploading ? "Subiendo..." : "Crear lote en staging")
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter] public IBrowserFile? SelectedFile { get; set; }
    [Parameter] public string SelectedSourceType { get; set; } = "Excel";
    [Parameter] public string UploadNotes { get; set; } = string.Empty;
    [Parameter] public bool IsUploading { get; set; }
    [Parameter] public EventCallback<InputFileChangeEventArgs> OnFileSelected { get; set; }
    [Parameter] public EventCallback<string> SelectedSourceTypeChanged { get; set; }
    [Parameter] public EventCallback<string> UploadNotesChanged { get; set; }
    [Parameter] public EventCallback OnRequestUpload { get; set; }

    private Task HandleSourceTypeChanged(ChangeEventArgs args)
        => SelectedSourceTypeChanged.InvokeAsync(args.Value?.ToString() ?? "Excel");

    private Task HandleNotesChanged(ChangeEventArgs args)
        => UploadNotesChanged.InvokeAsync(args.Value?.ToString() ?? string.Empty);
}
