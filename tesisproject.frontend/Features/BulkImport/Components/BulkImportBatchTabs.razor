<div class="bulk-stage-tabs rounded-[1.6rem] border border-[#d9e5e8] bg-white p-3 shadow-sm">
    <div class="flex flex-wrap gap-2">
        <button class="@GetTabClass("correction")" @onclick='() => OnTabChange.InvokeAsync("correction")'>Corrección (@CorrectionCount)</button>
        <button class="@GetTabClass("preview")" @onclick='() => OnTabChange.InvokeAsync("preview")'>Validación y preview (@PreviewCount)</button>
        <button class="@GetTabClass("errors")" @onclick='() => OnTabChange.InvokeAsync("errors")'>Errores (@ErrorsCount)</button>
    </div>
</div>

@code {
    [Parameter] public string ActiveTab { get; set; } = "correction";
    [Parameter] public int CorrectionCount { get; set; }
    [Parameter] public int PreviewCount { get; set; }
    [Parameter] public int ErrorsCount { get; set; }
    [Parameter] public EventCallback<string> OnTabChange { get; set; }

    private string GetTabClass(string tabKey)
        => ActiveTab == tabKey
            ? "rounded-full bg-[#12343b] px-4 py-2 text-sm font-semibold text-white shadow-sm"
            : "rounded-full border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50";
}
