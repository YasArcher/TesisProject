@using Microsoft.AspNetCore.Components
@using tesisproject.frontend.SharedUI
@using tesisproject.shared.DTOs.Configuration

<div class="rounded-[1.45rem] border border-[#d9e5e8] bg-white p-3.5 shadow-sm">
    <div class="mb-3 flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
        <h2 class="text-base font-black text-[#12343b] md:text-lg">1. Diseñar plantilla</h2>
        <div class="flex flex-wrap gap-2">
            <button class="rounded-xl border border-[#c7d6da] bg-white px-4 py-2 text-sm font-semibold text-[#12343b]" @onclick="OnUseActiveForms">Usar formularios activos</button>
            <button class="rounded-xl border border-[#e2c695] bg-[#fff3de] px-4 py-2 text-sm font-semibold text-[#8b5a16]" @onclick="OnSelectRequiredOnly">Solo obligatorios</button>
            <button class="rounded-xl bg-gradient-to-r from-[#12343b] to-[#2f4858] px-4 py-2 text-sm font-semibold text-white disabled:opacity-60" disabled="@IsGeneratingTemplate" @onclick="OnDownloadTemplate">@(IsGeneratingTemplate ? "Generando..." : "Descargar plantilla")</button>
        </div>
    </div>

    <div class="mb-3 grid grid-cols-1 gap-3 md:grid-cols-2">
        <input class="w-full rounded-xl border border-[#c9d7db] bg-[#f7fafb] px-3 py-2 text-sm"
               placeholder="Buscar campos de artículo"
               value="@ArticleSearchTerm"
               @oninput="HandleArticleSearchChanged" />
        <input class="w-full rounded-xl border border-[#e1d1b0] bg-[#fffaf2] px-3 py-2 text-sm"
               placeholder="Buscar campos de participante"
               value="@ParticipantSearchTerm"
               @oninput="HandleParticipantSearchChanged" />
    </div>

    <div class="grid grid-cols-1 gap-3 lg:grid-cols-2">
        <div class="rounded-3xl border border-[#d9e5e8] bg-[#f8fbfc]">
            <button class="flex w-full items-center justify-between gap-3 px-4 py-3 text-left" @onclick="ToggleArticlePanel">
                <div>
                    <h3 class="font-bold text-[#12343b]">Campos de artículo</h3>
                    <div class="text-xs text-slate-500">Despliega esta caja solo cuando necesites ajustar columnas.</div>
                </div>
                <div class="flex items-center gap-2">
                    <span class="rounded-full bg-white px-3 py-1 text-xs font-semibold text-[#2f4858]">@SelectedArticleFieldIds.Count seleccionados</span>
                    <span class="text-sm font-semibold text-[#12343b]">@(ShowArticleFields ? "Ocultar" : "Abrir")</span>
                </div>
            </button>
            @if (ShowArticleFields)
            {
                <div class="border-t border-[#d9e5e8] px-3 pb-3 pt-2">
                    <div class="max-h-[15rem] space-y-1.5 overflow-auto pr-1">
                        @if (!ArticleFields.Any())
                        {
                            <AppEmptyState Title="Sin coincidencias" Message="Prueba otra búsqueda para encontrar campos de artículo." />
                        }
                        else
                        {
                            @foreach (var field in ArticleFields)
                            {
                                <label class="flex cursor-pointer items-start gap-3 rounded-2xl border border-[#d9e5e8] bg-white px-3 py-2.5 transition hover:border-[#8cb0b8] hover:shadow-sm">
                                    <input type="checkbox"
                                           class="mt-1 h-4 w-4 rounded border-slate-300 text-[#12343b]"
                                           checked="@SelectedArticleFieldIds.Contains(field.FieldId)"
                                           @onchange="(args) => NotifyArticleToggle(field.FieldId, args.Value)" />
                                    <div class="min-w-0 flex-1">
                                        <div class="flex flex-wrap items-center gap-2">
                                            <span class="font-semibold text-[#12343b]">@field.FieldLabel</span>
                                            @if (field.IsDynamic)
                                            {
                                                <span class="rounded-full bg-[#fff1d6] px-2 py-0.5 text-[11px] font-semibold text-[#8b5a16]">Dinámico</span>
                                            }
                                            @if (field.IsRequired)
                                            {
                                                <span class="rounded-full bg-rose-50 px-2 py-0.5 text-[11px] font-semibold text-rose-700">Obligatorio</span>
                                            }
                                        </div>
                                    </div>
                                </label>
                            }
                        }
                    </div>
                </div>
            }
        </div>

        <div class="rounded-3xl border border-[#ead8bd] bg-[#fffdf8]">
            <button class="flex w-full items-center justify-between gap-3 px-4 py-3 text-left" @onclick="ToggleParticipantPanel">
                <div>
                    <h3 class="font-bold text-[#8b5a16]">Campos de participante</h3>
                    <div class="text-xs text-slate-500">Mantén esta caja cerrada si no necesitas editarla.</div>
                </div>
                <div class="flex items-center gap-2">
                    <span class="rounded-full bg-white px-3 py-1 text-xs font-semibold text-[#8b5a16]">@SelectedParticipantFieldIds.Count seleccionados</span>
                    <span class="text-sm font-semibold text-[#8b5a16]">@(ShowParticipantFields ? "Ocultar" : "Abrir")</span>
                </div>
            </button>
            @if (ShowParticipantFields)
            {
                <div class="border-t border-[#ead8bd] px-3 pb-3 pt-2">
                    <div class="max-h-[15rem] space-y-1.5 overflow-auto pr-1">
                        @if (!ParticipantFields.Any())
                        {
                            <AppEmptyState Title="Sin coincidencias" Message="Prueba otra búsqueda para encontrar campos de participante." />
                        }
                        else
                        {
                            @foreach (var field in ParticipantFields)
                            {
                                <label class="flex cursor-pointer items-start gap-3 rounded-2xl border border-[#ead8bd] bg-white px-3 py-2.5 transition hover:border-[#d9ba86] hover:shadow-sm">
                                    <input type="checkbox"
                                           class="mt-1 h-4 w-4 rounded border-slate-300 text-[#c17c2f]"
                                           checked="@SelectedParticipantFieldIds.Contains(field.FieldId)"
                                           @onchange="(args) => NotifyParticipantToggle(field.FieldId, args.Value)" />
                                    <div class="min-w-0 flex-1">
                                        <div class="flex flex-wrap items-center gap-2">
                                            <span class="font-semibold text-[#8b5a16]">@field.FieldLabel</span>
                                        </div>
                                    </div>
                                </label>
                            }
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public IReadOnlyList<FieldCatalogItemDto> ArticleFields { get; set; } = Array.Empty<FieldCatalogItemDto>();
    [Parameter] public IReadOnlyList<FieldCatalogItemDto> ParticipantFields { get; set; } = Array.Empty<FieldCatalogItemDto>();
    [Parameter] public IReadOnlyCollection<int> SelectedArticleFieldIds { get; set; } = Array.Empty<int>();
    [Parameter] public IReadOnlyCollection<int> SelectedParticipantFieldIds { get; set; } = Array.Empty<int>();
    [Parameter] public string ArticleSearchTerm { get; set; } = string.Empty;
    [Parameter] public string ParticipantSearchTerm { get; set; } = string.Empty;
    [Parameter] public bool IsGeneratingTemplate { get; set; }
    [Parameter] public EventCallback OnUseActiveForms { get; set; }
    [Parameter] public EventCallback OnSelectRequiredOnly { get; set; }
    [Parameter] public EventCallback OnDownloadTemplate { get; set; }
    [Parameter] public EventCallback<string> ArticleSearchTermChanged { get; set; }
    [Parameter] public EventCallback<string> ParticipantSearchTermChanged { get; set; }
    [Parameter] public EventCallback<FieldSelectionChange> OnArticleFieldToggled { get; set; }
    [Parameter] public EventCallback<FieldSelectionChange> OnParticipantFieldToggled { get; set; }
    private bool ShowArticleFields = true;
    private bool ShowParticipantFields;

    private Task HandleArticleSearchChanged(ChangeEventArgs args)
        => ArticleSearchTermChanged.InvokeAsync(args.Value?.ToString() ?? string.Empty);

    private Task HandleParticipantSearchChanged(ChangeEventArgs args)
        => ParticipantSearchTermChanged.InvokeAsync(args.Value?.ToString() ?? string.Empty);

    private Task NotifyArticleToggle(int fieldId, object? value)
        => OnArticleFieldToggled.InvokeAsync(new FieldSelectionChange
        {
            FieldId = fieldId,
            IsSelected = value is bool isChecked && isChecked
        });

    private Task NotifyParticipantToggle(int fieldId, object? value)
        => OnParticipantFieldToggled.InvokeAsync(new FieldSelectionChange
        {
            FieldId = fieldId,
            IsSelected = value is bool isChecked && isChecked
        });

    private void ToggleArticlePanel()
        => ShowArticleFields = !ShowArticleFields;

    private void ToggleParticipantPanel()
        => ShowParticipantFields = !ShowParticipantFields;
}
