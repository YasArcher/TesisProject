    private async Task EnsureBudgetTabAsync()
    {
        _loadingBudget = true;
        _budgetError = null;

        try
        {
            if (_project is null)
            {
                var detail = await ProjectService.GetDetailAsync(ProjectId);
                if (detail.Success && detail.Data is not null)
                    _project = detail.Data;
                else
                    _budgetError ??= detail.ToErrorMessage("No se pudo cargar el proyecto.");
            }

            var txTypesTask = TransactionTypeService.GetListAsync(onlyActives: true, CancellationToken.None);
            var fundingTypesTask = FundingTypeService.GetListAsync(onlyActives: true, CancellationToken.None);

            await Task.WhenAll(txTypesTask, fundingTypesTask);

            var txTypesRes = await txTypesTask;
            var fundingRes = await fundingTypesTask;

            _transactionTypes = (txTypesRes.Success && txTypesRes.Data is not null)
                ? txTypesRes.Data
                : Array.Empty<CatalogListItemDTO>();

            if (!_transactionTypes.Any())
                _budgetError ??= txTypesRes.ToErrorMessage("No se pudieron cargar los tipos de transacción.");

            _fundingTypes = (fundingRes.Success && fundingRes.Data is not null)
                ? fundingRes.Data
                : Array.Empty<CatalogListItemDTO>();

            if (!_fundingTypes.Any())
                _budgetError ??= fundingRes.ToErrorMessage("No se pudieron cargar los tipos de financiamiento.");

            var budgetsRes = await BudgetService.GetProjectBudgetsAsync(ProjectId);

            if (!budgetsRes.Success)
            {
                _budgets = new();
                _budgetTransactions = new();
                _budgetError ??= budgetsRes.ToErrorMessage("No se pudo cargar el presupuesto.");
                return;
            }

            _budgets = budgetsRes.Data ?? new();
            _budgetTransactions = new();

            if (_budgets.Count == 0)
            {
                _budgetError ??= "El proyecto no tiene presupuestos registrados.";
                return;
            }

            foreach (var budget in _budgets)
            {
                var tr = await BudgetService.GetListBudgetTransactionAsync(budget.BudgetId);

                if (tr.Success && tr.Data is not null)
                    _budgetTransactions[budget.BudgetId] = tr.Data.ToList();
                else
                {
                    _budgetTransactions[budget.BudgetId] = new List<BudgetTransactionDTO>();
                    _budgetError ??= tr.ToErrorMessage("No se pudieron cargar las transacciones.");
                }
            }
        }
        catch (Exception ex)
        {
            _budgets = new();
            _budgetTransactions = new();
            _transactionTypes = Array.Empty<CatalogListItemDTO>();
            _fundingTypes = Array.Empty<CatalogListItemDTO>();
            _budgetError = $"Error de conexión: {ex.Message}";
        }
        finally
        {
            _loadingBudget = false;
        }
    }

    private async Task HandleSaveBudgetAsync((int budgetId, UpdateBudgetRequestDTO dto) payload)
    {
        var (budgetId, dto) = payload;
        if (budgetId <= 0) return;
        if (_savingBudgetIds.Contains(budgetId)) return;

        _savingBudgetIds.Add(budgetId);
        StateHasChanged();

        try
        {
            var res = await BudgetService.UpdateAsync(budgetId, dto, CancellationToken.None);

            if (!res.Success || res.Data is null)
            {
                Toast.ShowError(res.ToErrorMessage("No se pudo actualizar el presupuesto."));
                return;
            }

            var updated = res.Data;

            var local = _budgets.FirstOrDefault(x => x.BudgetId == budgetId);
            if (local is not null)
            {
                local.InitialAmount = updated.InitialAmount;
                local.FundingTypeId = updated.FundingTypeId;
                local.FundingTypeName = updated.FundingTypeName;
                local.CertifiedAmount = updated.CertifiedAmount;
                local.ExecutedAmount = updated.ExecutedAmount;
                local.ApprovedAt = updated.ApprovedAt;
            }

            Toast.ShowSuccess(res.ToSuccessMessage("Presupuesto actualizado."));
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Error al actualizar presupuesto: {ex.Message}");
        }
        finally
        {
            _savingBudgetIds.Remove(budgetId);
            StateHasChanged();
        }
    }

    private async Task HandleUpdateTransactionAsync((int transactionId, UpdateBudgetTransactionRequestDTO dto) payload)
    {
        var (txId, dto) = payload;
        if (txId <= 0) return;
        if (_updatingTransactionIds.Contains(txId)) return;

        _updatingTransactionIds.Add(txId);
        StateHasChanged();

        try
        {
            var res = await BudgetService.UpdateTransactionAsync(txId, dto, CancellationToken.None);

            if (!res.Success || res.Data is null)
            {
                Toast.ShowError(res.ToErrorMessage("No se pudo actualizar la transacción."));
                return;
            }

            await EnsureBudgetTabAsync();
            Toast.ShowSuccess(res.ToSuccessMessage("Transacción actualizada."));
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Error al actualizar transacción: {ex.Message}");
        }
        finally
        {
            _updatingTransactionIds.Remove(txId);
            StateHasChanged();
        }
    }

    private async Task HandleCreateBudgetAsync(CreateBudgetRequestDTO dto)
    {
        if (_creatingBudgetProjectIds.Contains(ProjectId)) return;

        _creatingBudgetProjectIds.Add(ProjectId);
        StateHasChanged();

        try
        {
            dto.ProjectId = ProjectId;

            var res = await BudgetService.CreateAsync(dto, CancellationToken.None);

            if (!res.Success || res.Data is null)
            {
                Toast.ShowError(res.ToErrorMessage("No se pudo crear el presupuesto."));
                return;
            }

            var created = res.Data;

            _budgets.Insert(0, created);

            if (!_budgetTransactions.ContainsKey(created.BudgetId))
                _budgetTransactions[created.BudgetId] = new List<BudgetTransactionDTO>();

            Toast.ShowSuccess(res.ToSuccessMessage("Presupuesto creado."));
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Error al crear presupuesto: {ex.Message}");
        }
        finally
        {
            _creatingBudgetProjectIds.Remove(ProjectId);
            StateHasChanged();
        }
    }

