    private async Task EnsureGeneralTabAsync()
    {
        _loadingGeneral = true;
        _generalError = null;

        try
        {
            var detailTask = ProjectService.GetDetailAsync(ProjectId);
            var typesTask = ProjectTypeService.GetListAsync(onlyActives: true);
            var statesTask = ProjectStateService.GetListAsync(onlyActives: true);
            var convocationsTask = ConvocationService.GetListAsync();
            var originTypesTask = ProjectOriginTypeService.GetListAsync(onlyActives: true, CancellationToken.None);

            await Task.WhenAll(detailTask, typesTask, statesTask, convocationsTask, originTypesTask);

            var detail = await detailTask;
            var types = await typesTask;
            var states = await statesTask;
            var convocations = await convocationsTask;
            var originTypes = await originTypesTask;

            if (!detail.Success || detail.Data is null)
            {
                _project = null;
                _generalError = detail.ToErrorMessage("No se pudo cargar el proyecto.");
                return;
            }

            _project = detail.Data;

            if (types.Success && types.Data is not null)
                _projectTypes = types.Data;
            else
                _generalError ??= types.ToErrorMessage("No se pudieron cargar los tipos de proyecto.");

            if (states.Success && states.Data is not null)
                _projectStates = states.Data;
            else
                _generalError ??= states.ToErrorMessage("No se pudieron cargar los estados de proyecto.");

            if (convocations.Success && convocations.Data is not null)
                _convocations = convocations.Data;
            else
                _generalError ??= convocations.ToErrorMessage("No se pudieron cargar las convocatorias.");

            if (originTypes.Success && originTypes.Data is not null)
                _projectOriginTypes = originTypes.Data;
            else
                _generalError ??= originTypes.ToErrorMessage("No se pudieron cargar los tipos de origen del proyecto.");

            _generalDto = new UpdateProjectRequestDTO
            {
                ProjectName = _project.ProjectName ?? string.Empty,
                ProjectTypeId = _project.ProjectTypeId,
                ProjectStateId = _project.ProjectStateId,
                StartDate = _project.StartDate,
                TentativeEndDate = _project.TentativeEndDate,
                RealEndDate = _project.RealEndDate,
                ConvocationId = _project.ConvocationId,
                DurationInMonths = _project.DurationInMonths,
                ProjectOriginTypeId = _project?.ProjectOriginTypeId ?? 0,
            };
        }
        catch (Exception ex)
        {
            _generalError = $"Error de conexión: {ex.Message}";
        }
        finally
        {
            _loadingGeneral = false;
        }
    }

