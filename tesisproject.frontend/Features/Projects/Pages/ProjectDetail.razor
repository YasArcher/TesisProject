    /// Lazy-load / Refresh por tab
    private async Task EnsureTabDataAsync(string tabKey)
    {
        switch (tabKey)
        {
            case "overview":
                _loadingOverview = true;
                _error = null;
                try
                {
                    var detail = await ProjectService.GetDetailAsync(ProjectId);
                    if (detail.Success)
                        _project = detail.Response;
                    else
                    {
                        _project = null;
                        _error = detail.Error ?? "No se pudo cargar el proyecto.";
                    }
                }
                catch (Exception ex)
                {
                    _project = null;
                    _error = $"Error de conexión: {ex.Message}";
                }
                finally
                {
                    _loadingOverview = false;
                }
                break;

            case "members":
                _loadingMembers = true;
                _membersError = null;
                _loadingExternalResearchers = true;
                _externalResearchersError = null;

                try
                {
                    await EnsureProjectDetailIfNeeded();

                    // ===== Miembros internos (Group) =====
                    if (_project?.ProjectGroupId is null or 0)
                    {
                        _members = new();
                        _membersError = "Este proyecto no tiene un grupo asignado.";
                    }
                    else
                    {
                        var res = await GroupService.GetMembersByGroupIdAsync(_project.ProjectGroupId);
                        if (res.Success)
                            _members = res.Response ?? new();
                        else
                        {
                            _members = new();
                            _membersError = res.Error ?? "No se pudieron cargar los miembros.";
                        }
                    }

                    // ===== Investigadores externos del proyecto =====
                    var extRes = await ExternalResearcherProjectService.GetByProjectAsync(ProjectId);

                    if (extRes.Success && extRes.Response is not null)
                    {
                        _externalResearchers = extRes.Response;
                    }
                    else
                    {
                        _externalResearchers = new();
                        _externalResearchersError = extRes.Error ?? "No se pudieron cargar los investigadores externos.";
                    }
                }
                catch (Exception ex)
                {
                    _members = new();
                    _membersError ??= $"Error de conexión: {ex.Message}";

                    _externalResearchers = new();
                    _externalResearchersError ??= $"Error de conexión al cargar investigadores externos: {ex.Message}";
                }
                finally
                {
                    _loadingMembers = false;
                    _loadingExternalResearchers = false;
                }
                break;

            case "extensions":
                _loadingExtensions = true;
                _extensionsError = null;
                try
                {
                    var res = await ProjectExtensionService.ListByProjectAsync(ProjectId);
                    if (res.Success)
                        _extensions = res.Response ?? new();
                    else
                    {
                        _extensions = new();
                        _extensionsError = res.Error ?? "No se pudieron cargar las prórrogas.";
                    }
                }
                catch (Exception ex)
                {
                    _extensions = new();
                    _extensionsError = $"Error de conexión: {ex.Message}";
                }
                finally
                {
                    _loadingExtensions = false;
                }
                break;

            case "visits":
                _loadingVisits = true;
                _visitsError = null;
                try
                {
                    var res = await VisitService.GetByProjectAsync(ProjectId);
                    if (res.Success && res.Success == true)
                        _visits = res.Response?.ToList() ?? new();
                    else
                    {
                        _visits = new();
                        _visitsError = res.Error ?? "No se pudieron cargar las visitas.";
                    }
                    await EnsureProjectObjectivesAsync();
                }
                catch (Exception ex)
                {
                    _visits = new();
                    _visitsError = $"Error de conexión: {ex.Message}";
                }
                finally
                {
                    _loadingVisits = false;
                }
                break;

            case "financial":
                _loadingBudget = true;
                _budgetError = null;

                try
                {
                    var b = await BudgetService.GetProjectBudgetsAsync(ProjectId);

                    if (b.Success)
                    {
                        var budgets = b.Response ?? new();

                        _budgets = budgets;
                        _budgetTransactions = new();

                        if (_budgets.Count > 0)
                        {
                            foreach (var budget in _budgets)
                            {
                                try
                                {
                                    var tr = await BudgetService.GetListBudgetTransactionAsync(budget.BudgetId);

                                    if (tr.Success && tr.Response is not null)
                                    {
                                        _budgetTransactions[budget.BudgetId] = tr.Response.ToList();
                                    }
                                    else
                                    {
                                        _budgetTransactions[budget.BudgetId] = new List<BudgetTransactionDTO>();
                                        _budgetError ??= tr.Error ?? "No se pudieron cargar las transacciones.";
                                    }
                                }
                                catch (Exception exInner)
                                {
                                    _budgetTransactions[budget.BudgetId] = new List<BudgetTransactionDTO>();
                                    _budgetError ??= $"Error al cargar transacciones: {exInner.Message}";
                                }
                            }
                        }
                        else
                        {
                            _budgetError = "El proyecto no tiene presupuestos registrados.";
                        }
                    }
                    else
                    {
                        _budgets = new();
                        _budgetTransactions = new();
                        _budgetError = b.Error ?? "No se pudo cargar el presupuesto.";
                    }
                }
                catch (Exception ex)
                {
                    _budgets = new();
                    _budgetTransactions = new();
                    _budgetError = $"Error de conexión: {ex.Message}";
                }
                finally
                {
                    _loadingBudget = false;
                }
                break;
        }
    }

