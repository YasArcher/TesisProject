@page "/projects/{ProjectId:int}"
@using tesisproject.frontend.Features.Components
@using tesisproject.frontend.Services.Interfaces
@using tesisproject.frontend.SharedUI
@using tesisproject.frontend.SharedUI.Tabs
@using tesisproject.frontend.SharedUI.ActionButton
@using tesisproject.shared.DTOs.Group.Request
@using tesisproject.shared.DTOs.Project.Response
@using tesisproject.frontend.Features.Projects.Components
@using tesisproject.shared.DTOs.Budgets.Request
@using tesisproject.shared.DTOs.ProjectExtensions.Response
@using tesisproject.shared.DTOs.Visit.Request
@using tesisproject.shared.DTOs.Visit.Response
@using tesisproject.shared.DTOs.External

@inject IVisitClientService VisitService
@inject IProjectClientService ProjectService
@inject IBudgetClientService BudgetService
@inject IProjectExtensionClientService ProjectExtensionService
@inject IGroupService GroupService
@inject NavigationManager Nav
@inject IToastService Toast
@inject IExternalUserService ExternalUserService

<div class="flex flex-col h-full">
    <!-- Header -->
    <div class="sticky top-0 z-10 rounded-2xl border border-border p-6 bg-primary-subtle/50 backdrop-blur-sm shrink-0">
        <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6">
            <!-- Izquierda -->
            <div class="space-y-3 min-w-0 flex-1">
                <div class="flex flex-wrap items-center gap-3">
                    <span class="inline-flex items-center px-3 py-1 text-sm font-bold rounded-full bg-primary text-white shrink-0">
                        #@_project?.ProjectId
                    </span>

                    @if (!string.IsNullOrEmpty(_project?.ProjectCode))
                    {
                        <span class="text-sm text-muted font-mono bg-muted/20 px-2 py-1 rounded max-w-full truncate">
                            @_project?.ProjectCode
                        </span>
                    }
                </div>

                <h1 class="text-2xl lg:text-3xl font-bold text-foreground leading-tight break-words text-balance">
                    @(string.IsNullOrEmpty(_project?.ProjectName) ? "Proyecto Sin Nombre" : _project?.ProjectName)
                </h1>

                <div class="flex flex-wrap items-center gap-3">
                    <span class="inline-flex items-center px-3 py-1 text-sm font-medium rounded-full bg-primary-subtle text-primary border border-primary/20">
                        @(_project?.ProjectTypeName ?? "Sin tipo")
                    </span>

                    <span class="inline-flex items-center px-3 py-1 text-sm font-medium rounded-full bg-secondary-subtle text-secondary border border-secondary/20">
                        @(_project?.ProjectStateName ?? "Sin estado")
                    </span>
                </div>
            </div>

            <!-- Derecha -->
            <div class="lg:text-right space-y-2 shrink-0">
                <div class="text-sm font-medium text-muted">Progreso del Proyecto</div>
                <div class="flex items-center gap-4">
                    <div class="w-32 bg-border rounded-full h-3 relative overflow-hidden">
                        <div class="bg-secondary h-3 rounded-full transition-all duration-500"
                             style="width:@((_project?.ExecutionPercentage ?? 0).ToString("F1"))%"></div>
                    </div>
                    <span class="text-2xl font-bold text-secondary">
                        @((_project?.ExecutionPercentage ?? 0).ToString("F1"))%
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabs -->
    <div class="flex-1 overflow-y-auto min-h-0">
        <Tabs ActiveKey="@_activeTab" OnChange="OnTabChanged">

            <Tab Key="overview" Title="Detalles">
                <Icon>
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6">
                        <path d="M11.625 16.5a1.875 1.875 0 1 0 0-3.75 1.875 1.875 0 0 0 0 3.75Z" />
                        <path fill-rule="evenodd" d="M5.625 1.5H9a3.75 3.75 0 0 1 3.75 3.75v1.875c0 1.036.84 1.875 1.875 1.875H16.5a3.75 3.75 0 0 1 3.75 3.75v7.875c0 1.035-.84 1.875-1.875 1.875H5.625a1.875 1.875 0 0 1-1.875-1.875V3.375c0-1.036.84-1.875 1.875-1.875Zm6 16.5c.66 0 1.277-.19 1.797-.518l1.048 1.048a.75.75 0 0 0 1.06-1.06l-1.047-1.048A3.375 3.375 0 1 0 11.625 18Z" clip-rule="evenodd" />
                        <path d="M14.25 5.25a5.23 5.23 0 0 0-1.279-3.434 9.768 9.768 0 0 1 6.963 6.963A5.23 5.23 0 0 0 16.5 7.5h-1.875a.375.375 0 0 1-.375-.375V5.25Z" />
                    </svg>
                </Icon>
                <ChildContent>
                    <ProjectOverviewTab Item="_project" IsLoading="@_loadingOverview" />
                </ChildContent>
            </Tab>

            <Tab Key="members" Title="Miembros">
                <Icon>
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6">
                        <path fill-rule="evenodd" d="M8.25 6.75a3.75 3.75 0 1 1 7.5 0 3.75 3.75 0 0 1-7.5 0ZM15.75 9.75a3 3 0 1 1 6 0 3 3 0 0 1-6 0ZM2.25 9.75a3 3 0 1 1 6 0 3 3 0 0 1-6 0ZM6.31 15.117A6.745 6.745 0 0 1 12 12a6.745 6.745 0 0 1 6.709 7.498.75.75 0 0 1-.372.568A12.696 12.696 0 0 1 12 21.75c-2.305 0-4.47-.612-6.337-1.684a.75.75 0 0 1-.372-.568 6.787 6.787 0 0 1 1.019-4.38Z" clip-rule="evenodd" />
                        <path d="M5.082 14.254a8.287 8.287 0 0 0-1.308 5.135 9.687 9.687 0 0 1-1.764-.44l-.115-.04a.563.563 0 0 1-.373-.487l-.01-.121a3.75 3.75 0 0 1 3.57-4.047ZM20.226 19.389a8.287 8.287 0 0 0-1.308-5.135 3.75 3.75 0 0 1 3.57 4.047l-.01.121a.563.563 0 0 1-.373.486l-.115.04c-.567.2-1.156.349-1.764.441Z" />
                    </svg>
                </Icon>
                <ChildContent>
                    <ProjectMembersTab Members="_members"
                                       IsLoading="@_loadingMembers"
                                       OnInviteMember="HandleInviteMember"
                                       OnChangeRole="HandleChangeRole"
                                       OnRemoveMember="HandleRemoveMember" />
                </ChildContent>
            </Tab>

            <Tab Key="visits" Title="Visitas">
                <Icon>
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6">
                        <path fill-rule="evenodd" d="M7.502 6h7.128A3.375 3.375 0 0 1 18 9.375v9.375a3 3 0 0 0 3-3V6.108c0-1.505-1.125-2.811-2.664-2.94a48.972 48.972 0 0 0-.673-.05A3 3 0 0 0 15 1.5h-1.5a3 3 0 0 0-2.663 1.618c-.225.015-.45.032-.673.05C8.662 3.295 7.554 4.542 7.502 6ZM13.5 3A1.5 1.5 0 0 0 12 4.5h4.5A1.5 1.5 0 0 0 15 3h-1.5Z" clip-rule="evenodd" />
                        <path fill-rule="evenodd" d="M3 9.375C3 8.339 3.84 7.5 4.875 7.5h9.75c1.036 0 1.875.84 1.875 1.875v11.25c0 1.035-.84 1.875-1.875 1.875h-9.75A1.875 1.875 0 0 1 3 20.625V9.375ZM6 12a.75.75 0 0 1 .75-.75h.008a.75.75 0 0 1 .75.75v.008a.75.75 0 0 1-.75.75H6.75a.75.75 0 0 1-.75-.75V12Zm2.25 0a.75.75 0 0 1 .75-.75h3.75a.75.75 0 0 1 0 1.5H9a.75.75 0 0 1-.75-.75ZM6 15a.75.75 0 0 1 .75-.75h.008a.75.75 0 0 1 .75.75v.008a.75.75 0 0 1-.75.75H6.75a.75.75 0 0 1-.75-.75V15Zm2.25 0a.75.75 0 0 1 .75-.75h3.75a.75.75 0 0 1 0 1.5H9a.75.75 0 0 1-.75-.75ZM6 18a.75.75 0 0 1 .75-.75h.008a.75.75 0 0 1 .75.75v.008a.75.75 0 0 1-.75.75H6.75a.75.75 0 0 1-.75-.75V18Zm2.25 0a.75.75 0 0 1 .75-.75h3.75a.75.75 0 0 1 0 1.5H9a.75.75 0 0 1-.75-.75Z" clip-rule="evenodd" />
                    </svg>
                </Icon>
                <ChildContent>
                    <ProjectVisitsTab ProjectId="@ProjectId"
                                      Items="_visits"
                                      IsLoading="@_loadingVisits"
                                      OnAddVisit="HandleAddVisit"
                                      OnOpenVisit="HandleOpenVisit"
                                      OnChangeVisitState="HandleChangeVisitStateAsync" />
                </ChildContent>
            </Tab>

            <Tab Key="financial" Title="Presupuesto">
                <Icon>
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6">
                        <path fill-rule="evenodd" d="M3.75 3.375c0-1.036.84-1.875 1.875-1.875H9a3.75 3.75 0 0 1 3.75 3.75v1.875c0 1.036.84 1.875 1.875 1.875H16.5a3.75 3.75 0 0 1 3.75 3.75v7.875c0 1.035-.84 1.875-1.875 1.875H5.625a1.875 1.875 0 0 1-1.875-1.875V3.375Zm10.5 1.875a5.23 5.23 0 0 0-1.279-3.434 9.768 9.768 0 0 1 6.963 6.963A5.23 5.23 0 0 0 16.5 7.5h-1.875a.375.375 0 0 1-.375-.375V5.25ZM12 10.5a.75.75 0 0 1 .75.75v.028a9.727 9.727 0 0 1 1.687.28.75.75 0 1 1-.374 1.452 8.207 8.207 0 0 0-1.313-.226v1.68l.969.332c.67.23 1.281.85 1.281 1.704 0 .158-.007.314-.02.468-.083.931-.83 1.582-1.669 1.695a9.776 9.776 0 0 1-.561.059v.028a.75.75 0 0 1-1.5 0v-.029a9.724 9.724 0 0 1-1.687-.278.75.75 0 0 1 .374-1.453c.425.11.864.186 1.313.226v-1.68l-.968-.332C9.612 14.974 9 14.354 9 13.5c0-.158.007-.314.02-.468.083-.931.831-1.582 1.67-1.694.185-.025.372-.045.56-.06v-.028a.75.75 0 0 1 .75-.75Zm-1.11 2.324c.119-.016.239-.03.36-.04v1.166l-.482-.165c-.208-.072-.268-.211-.268-.285 0-.113.005-.225.015-.336.013-.146.14-.309.374-.34Zm1.86 4.392V16.05l.482.165c.208.072.268.211.268.285 0 .113-.005.225-.015.336-.012.146-.14.309-.374.34-.12.016-.24.03-.361.04Z" clip-rule="evenodd" />
                    </svg>
                </Icon>
                <ChildContent>
                    <ProjectFinancialTab Budget="_budget"
                                         Transactions="_transactions"
                                         IsLoading="_loadingBudget"
                                         OnAddCertification="HandleAddCertification"
                                         OnExecuteDevengado="HandleExecuteDevengado" />
                </ChildContent>
            </Tab>

            <Tab Key="extensions" Title="Prórrogas">
                <Icon>
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6">
                        <path fill-rule="evenodd" d="M12 2.25c-5.385 0-9.75 4.365-9.75 9.75s4.365 9.75 9.75 9.75 9.75-4.365 9.75-9.75S17.385 2.25 12 2.25ZM12.75 6a.75.75 0 0 0-1.5 0v6c0 .414.336.75.75.75h4.5a.75.75 0 0 0 0-1.5h-3.75V6Z" clip-rule="evenodd" />
                    </svg>
                </Icon>
                <ChildContent>
                    <ProjectExtensionsTab Items="_extensions"
                                          IsLoading="_loadingExtensions"
                                          OnRequestNew="HandleRequestExtension"
                                          OnOpen="HandleOpenExtension" />
                </ChildContent>
            </Tab>

        </Tabs>
    </div>
</div>

<!-- Modales presupuesto -->
<ProjectCertificationModal IsOpen="@_certModalOpen"
                           IsOpenChanged="v => _certModalOpen = v"
                           Value="@_certSeed"
                           IsSaving="@_savingCert"
                           ErrorMessage="@_certError"
                           OnSubmit="OnSubmitCertification"
                           OnCancel="OnCancelCertification" />

<ProjectAccrualModal IsOpen="@_accrualModalOpen"
                     IsOpenChanged="v => _accrualModalOpen = v"
                     Value="@_accrualSeed"
                     IsSaving="@_savingAccrual"
                     ErrorMessage="@_accrualError"
                     OnSubmit="OnSubmitAccrual"
                     OnCancel="OnCancelAccrual" />
<!-- MODAL: User Picker para agregar miembros al grupo del proyecto -->
<UserPickerModal ModalId="project-user-picker"
                 IsOpen="@_showUserPicker"
                 IsOpenChanged="(bool v) => _showUserPicker = v"
                 Users="@_memberCandidates"
                 InitialSelectedUserId="@_preselectedUserId"
                 OnSubmit="HandleUserPickedAsync"
                 OnCancel="() => _showUserPicker = false" />


@code {
    [Parameter] public int ProjectId { get; set; }

    // ======= Estado general =======
    private ProjectDetailResponseDTO? _project;
    private string _activeTab = "overview";
    private bool _loadingOverview;
    private string? _error;

    // ======= Miembros =======
    private List<ExternalUserDTO>? _members;
    private bool _loadingMembers;
    private string? _membersError;

    // ======= Visitas =======
    private List<VisitListResponseDTO>? _visits;
    private bool _loadingVisits;
    private string? _visitsError;

    // ======= Presupuesto =======
    private BudgetDTO? _budget;
    private List<BudgetTransactionDTO>? _transactions;
    private bool _loadingBudget;
    private string? _budgetError;

    // ======= Modales presupuesto =======
    private bool _certModalOpen;
    private bool _savingCert;
    private string? _certError;
    private AddCertificationRequestDTO _certSeed = new();
    private int _currentUserId = 1; // TODO: obtener de claims

    // ======= Prórrogas =======
    private List<ProjectExtensionListResponseDTO>? _extensions;
    private bool _loadingExtensions;
    private string? _extensionsError;

    private bool _accrualModalOpen;
    private bool _savingAccrual;
    private string? _accrualError;
    private ExecuteDevengadoRequestDTO _accrualSeed = new();

    // ====== User Picker (miembros) ======
    private bool _showUserPicker;
    private List<ExternalUserDTO> _memberCandidates = new();
    private int? _preselectedUserId;


    // ======= Lifecycle =======
    protected override async Task OnInitializedAsync()
    {
        await EnsureTabDataAsync(_activeTab);
    }

    private async Task OnTabChanged(string newKey)
    {
        _activeTab = newKey;
        await EnsureTabDataAsync(newKey);
        StateHasChanged();
    }

    /// Lazy-load / Refresh por tab
    private async Task EnsureTabDataAsync(string tabKey)
    {
        switch (tabKey)
        {
            case "overview":
                _loadingOverview = true;
                _error = null;
                try
                {
                    var detail = await ProjectService.GetDetailAsync(ProjectId);
                    if (detail.Success)
                        _project = detail.Response;
                    else
                    {
                        _project = null;
                        _error = detail.Error ?? "No se pudo cargar el proyecto.";
                    }
                }
                catch (Exception ex)
                {
                    _project = null;
                    _error = $"Error de conexión: {ex.Message}";
                }
                finally
                {
                    _loadingOverview = false;
                }
                break;

            case "members":
                _loadingMembers = true;
                _membersError = null;
                try
                {
                    // Asegura tener detalle de proyecto y GroupId
                    await EnsureProjectDetailIfNeeded();

                    if (_project?.ProjectGroupId is null or 0)
                    {
                        _members = new();
                        _membersError = "Este proyecto no tiene un grupo asignado.";
                    }
                    else
                    {
                        var res = await GroupService.GetMembersByGroupIdAsync(_project.ProjectGroupId);
                        if (res.Success)
                            _members = res.Response ?? new();
                        else
                        {
                            _members = new();
                            _membersError = res.Error ?? "No se pudieron cargar los miembros.";
                        }
                    }
                }
                catch (Exception ex)
                {
                    _members = new();
                    _membersError = $"Error de conexión: {ex.Message}";
                }
                finally
                {
                    _loadingMembers = false;
                }
                break;

            case "extensions":
                _loadingExtensions = true;
                _extensionsError = null;
                try
                {
                    var res = await ProjectExtensionService.ListByProjectAsync(ProjectId);
                    if (res.Success)
                        _extensions = res.Response ?? new();
                    else
                    {
                        _extensions = new();
                        _extensionsError = res.Error ?? "No se pudieron cargar las prórrogas.";
                    }
                }
                catch (Exception ex)
                {
                    _extensions = new();
                    _extensionsError = $"Error de conexión: {ex.Message}";
                }
                finally
                {
                    _loadingExtensions = false;
                }
                break;

            case "visits":
                _loadingVisits = true;
                _visitsError = null;
                try
                {
                    var res = await VisitService.GetByProjectAsync(ProjectId);
                    Console.WriteLine("Raw Response:");
                    Console.WriteLine(System.Text.Json.JsonSerializer.Serialize(res));
                    if (res.Success && res.Success == true)
                        _visits = res.Response?.ToList() ?? new();
                    else
                    {
                        _visits = new();
                        _visitsError = res.Error ?? "No se pudieron cargar las visitas.";
                    }
                }
                catch (Exception ex)
                {
                    _visits = new();
                    _visitsError = $"Error de conexión: {ex.Message}";
                }
                finally
                {
                    _loadingVisits = false;
                }
                break;

            case "financial":
                _loadingBudget = true;
                _budgetError = null;
                try
                {
                    var b = await BudgetService.GetBudgetAsync(ProjectId);
                    if (b.Success)
                    {
                        _budget = b.Response;
                        if (_budget is not null)
                        {
                            var tr = await BudgetService.GetListBudgetTransactionAsync(_budget.BudgetId);
                            if (tr.Success)
                                _transactions = tr.Response ?? new();
                            else
                            {
                                _transactions = new();
                                _budgetError = tr.Error ?? "No se pudieron cargar las transacciones.";
                            }
                        }
                        else
                        {
                            _transactions = null;
                        }
                    }
                    else
                    {
                        _budget = null;
                        _transactions = null;
                        _budgetError = b.Error ?? "No se pudo cargar el presupuesto.";
                    }
                }
                catch (Exception ex)
                {
                    _budget = null;
                    _transactions = null;
                    _budgetError = $"Error de conexión: {ex.Message}";
                }
                finally
                {
                    _loadingBudget = false;
                }
                break;
        }
    }

    // ===== Acciones miembros =====
    private async Task HandleInviteMember()
    {
        await EnsureProjectDetailIfNeeded();

        if (_project?.ProjectGroupId is null or 0)
        {
            Toast.ShowWarning("Este proyecto no tiene un grupo asignado.");
            return;
        }

        // 1) Traer todos los usuarios externos
        var all = await ExternalUserService.GetListAsync();
        if (!all.Success)
        {
            Toast.ShowError(all.Error ?? "No se pudieron cargar los usuarios.");
            return;
        }

        // 2) Filtrar los que YA están en el grupo
        var existingIds = new HashSet<int>((_members ?? new()).Select(m => m.UserId));
        _memberCandidates = (all.Response ?? new())
            .Where(u => !existingIds.Contains(u.UserId))
            .OrderBy(u => u.FullName)
            .ToList();

        if (_memberCandidates.Count == 0)
        {
            Toast.ShowInfo("No hay usuarios disponibles para agregar.");
            return;
        }

        _preselectedUserId = null;
        _showUserPicker = true;
        StateHasChanged();
    }

    private Task HandleChangeRole(int userId)
    {
        // Lógica para cambiar rol de un miembro
        return Task.CompletedTask;
    }

    private async Task HandleRemoveMember(int userGroupId)
    {
        await EnsureProjectDetailIfNeeded();

        if (_project?.ProjectGroupId is null or 0)
        {
            Toast.ShowWarning("Este proyecto no tiene un grupo asignado.");
            return;
        }

        try
        {
            var res = await GroupService.RemoveMemberAsync(_project.ProjectGroupId, userGroupId);
            if (!res.Success)
            {
                Toast.ShowError(res.Error ?? "No se pudo remover el miembro.");
                return;
            }

            Toast.ShowSuccess("Miembro removido.");
            await EnsureTabDataAsync("members");
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Error al remover miembro: {ex.Message}");
        }
    }


    // ===== Acciones presupuesto =====
    private Task HandleAddCertification()
    {
        if (_budget is null) return Task.CompletedTask;

        _certError = null;
        _savingCert = false;
        _certSeed = new AddCertificationRequestDTO
        {
            BudgetId = _budget.BudgetId,
            CertifiedByUserId = _currentUserId,
            CertifiedAt = null,
            Amount = 0,
            BudgetItem = string.Empty,
            CURNumber = null
        };

        _certModalOpen = true;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task OnSubmitCertification(AddCertificationRequestDTO dto)
    {
        if (_budget is null) return;

        try
        {
            _savingCert = true;
            _certError = null;

            var res = await BudgetService.CreateCertificationAsync(_budget.BudgetId, dto);
            if (!res.Success)
            {
                _certError = res.Error ?? "No se pudo crear la certificación.";
                return;
            }

            _certModalOpen = false;
            await ReloadBudgetTabAsync();
        }
        catch (Exception ex)
        {
            _certError = $"Error: {ex.Message}";
        }
        finally
        {
            _savingCert = false;
        }
    }

    private Task OnCancelCertification()
    {
        _certModalOpen = false;
        _certError = null;
        return Task.CompletedTask;
    }

    private Task HandleExecuteDevengado(int budgetTransactionId)
    {
        if (_budget is null) return Task.CompletedTask;

        _accrualError = null;
        _savingAccrual = false;
        _accrualSeed = new ExecuteDevengadoRequestDTO
        {
            BudgetTransactionId = budgetTransactionId,
            ExecutedByUserId = _currentUserId,
            ExecutedAt = null,
            CURNumber = null
        };

        _accrualModalOpen = true;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task OnSubmitAccrual(ExecuteDevengadoRequestDTO dto)
    {
        if (_budget is null) return;

        try
        {
            _savingAccrual = true;
            _accrualError = null;

            var res = await BudgetService.ExecuteAccrualAsync(_budget.BudgetId, dto);
            if (!res.Success)
            {
                _accrualError = res.Error ?? "No se pudo ejecutar el devengo.";
                return;
            }

            _accrualModalOpen = false;
            await ReloadBudgetTabAsync();
        }
        catch (Exception ex)
        {
            _accrualError = $"Error: {ex.Message}";
        }
        finally
        {
            _savingAccrual = false;
        }
    }

    private Task OnCancelAccrual()
    {
        _accrualModalOpen = false;
        _accrualError = null;
        return Task.CompletedTask;
    }

    private async Task HandleChangeVisitStateAsync((int visitId, int newStateId) e)
    {
        var (visitId, newStateId) = e;

        try
        {
            var req = new UpdateVisitRequestDTO
            {
                VisitId = visitId,
                ProjectId = ProjectId,
                VisitStateId = newStateId
            };

            var resp = await VisitService.UpdateAsync(req);

            if (resp.Success && resp.Response is VisitListResponseDTO updated && _visits is not null)
            {
                var local = _visits.FirstOrDefault(x => x.VisitId == updated.VisitId);
                if (local is not null)
                {
                    local.VisitStateId = updated.VisitStateId;
                    local.VisitStateName = updated.VisitStateName;
                }
                StateHasChanged();
            }
            else
            {
                _visitsError = resp.Error ?? "No se pudo actualizar el estado de la visita.";
                await EnsureTabDataAsync("visits");
            }
        }
        catch (Exception ex)
        {
            _visitsError = $"Error de conexión: {ex.Message}";
            await EnsureTabDataAsync("visits");
        }
    }

    // ===== Util =====
    private async Task ReloadBudgetTabAsync()
    {
        await EnsureTabDataAsync("financial");
        StateHasChanged();
    }

    // ===== Acciones visitas =====
