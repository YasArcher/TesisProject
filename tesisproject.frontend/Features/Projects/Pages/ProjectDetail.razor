    private async Task HandleUserPickedAsync(int userId)
    {
        await EnsureProjectDetailIfNeeded();

        if (_project?.ProjectGroupId is null or 0)
        {
            Toast.ShowWarning("Este proyecto no tiene un grupo asignado.");
            _showUserPicker = false;
            return;
        }
        var selectedRole = _memberRoles?.FirstOrDefault(r => r.Id == _selectedRoleIdForProject.Value);
        if (selectedRole is null)
        {
            Toast.ShowError("No se pudo identificar el rol seleccionado.");
            return;
        }

        if (IsCoordinatorRole(selectedRole.Name))
        {
            var alreadyHasRole = ProjectAlreadyHasRole(selectedRole.Id);
            if (alreadyHasRole)
            {
                Toast.ShowWarning($"Ya existe un miembro con el rol '{selectedRole.Name}' en este proyecto.");
                return;
            }
        }


        if (_selectedRoleIdForProject is null || _selectedRoleIdForProject <= 0)
        {
            Toast.ShowWarning("Seleccione un rol para el miembro.");
            return;
        }

        var selected = _memberCandidates.FirstOrDefault(u => u.UserId == userId);
        if (selected is null)
        {
            Toast.ShowError("No se encontró el usuario seleccionado.");
            _showUserPicker = false;
            return;
        }

        var req = new AddGroupMemberRequestDTO
        {
            GroupId = _project.ProjectGroupId,
            MemberRole = _selectedRoleIdForProject.Value,
            Email = selected.Email,
            Document = selected.Document,
            AspUserId = selected.AspNetUserId
        };

        var res = await GroupService.AddMemberAsync(req);
        if (!res.Success)
        {
            Toast.ShowError(res.Error ?? "No se pudo agregar el miembro.");
            return;
        }

        Toast.ShowSuccess("Miembro agregado.");
        _showUserPicker = false;

        await EnsureTabDataAsync("members");
        StateHasChanged();
    }

    private async Task EnsureMemberRolesAsync()
    {
        // Si ya están cargados, no vuelvas a pedirlos
        if (_memberRoles is not null && _memberRoles.Any())
            return;

        try
        {
            var res = await MemberRoleTypeService.GetListAsync(onlyActives: true);

            if (!res.Success || res.Response is null)
            {
                Toast.ShowError(res.Error ?? "No se pudieron cargar los roles.");
                _memberRoles = Array.Empty<MemberRoleTypeDetailDTO>();
                return;
            }

            var allRoles = res.Response; // List<MemberRoleTypeListItemDTO>

            _memberRoles = allRoles
                .Where(r => r.Flag == 1) // tu filtro de grupo/proyecto
                .Select(r => new MemberRoleTypeDetailDTO
                {
                    Id = r.Id,
                    Name = r.Name,
                    IsActive = r.IsActive,
                    Flag = r.Flag
                })
                .ToList();
        }
        catch (Exception ex)
        {
            Toast.ShowError($"No se pudieron cargar los roles: {ex.Message}");
            _memberRoles = Array.Empty<MemberRoleTypeDetailDTO>();
        }
    }

    private static bool IsCoordinatorRole(string roleName)
    {
        if (string.IsNullOrWhiteSpace(roleName))
            return false;

        var name = roleName.Trim();

        return name.Contains("coordinador", StringComparison.OrdinalIgnoreCase)
            && (name.Contains("principal", StringComparison.OrdinalIgnoreCase)
                || name.Contains("subrogante", StringComparison.OrdinalIgnoreCase));
    }

    private async Task<bool> GroupAlreadyHasRoleAsync(int roleId)
    {
        if (_project?.ProjectGroupId is null or 0)
            return false;

        var res = await GroupService.GetMembersByGroupIdAsync(_project.ProjectGroupId);

        if (!res.Success || res.Response is null)
            return false;

        return res.Response.Any(m => m.MemberRoleId == roleId);
    }

