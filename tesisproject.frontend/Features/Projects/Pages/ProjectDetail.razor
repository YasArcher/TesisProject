    /// <summary>Eliminar issue (confirmación ya manejada por ActionButton)</summary>
    private async Task HandleDeleteIssue(int issueId)
    {
        try
        {
             var res = await VisitIssueService.DeleteAsync(issueId);

             if (!res.Success)
             {
                 Toast.ShowError(res.Error ?? "No se pudo eliminar el problema.");
                 return;
             }

             Toast.ShowSuccess("Problema eliminado correctamente.");

             //Refrescar lista de issues
             if (_openVisitId.HasValue)
             {
                 await ReloadVisitIssuesAsync(_openVisitId.Value);
             }
            await Task.Delay(500); // Simular eliminación
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Error al eliminar: {ex.Message}");
        }
    }

    /// <summary>Submit del modal (crear o actualizar)</summary>
    private async Task HandleSubmitIssue(VisitIssueFormModal.VisitIssueFormModel form)
    {
        if (!_openVisitId.HasValue) return;

        try
        {
            _savingIssue = true;
            _issueError = null;
            StateHasChanged();

            if (_editingIssueId.HasValue)
            {
                // ACTUALIZAR
                var updateDto = new VisitIssueUpdateRequestDTO
                {
                    Description = form.Description
                };

                 var res = await VisitIssueService.UpdateAsync(_editingIssueId.Value, updateDto);

                 if (!res.Success)
                 {
                     _issueError = res.Error ?? "No se pudo actualizar el problema.";
                     return;
                 }

                Toast.ShowSuccess("Problema actualizado correctamente.");
            }
            else
            {
                // CREAR
                var createDto = new VisitIssueCreateRequestDTO
                {
                    VisitId = _openVisitId.Value,
                    Description = form.Description,
                };

                 var res = await VisitIssueService.CreateAsync(createDto);

                 if (!res.Success)
                 {
                     _issueError = res.Error ?? "No se pudo crear el problema.";
                     return;
                 }

                Toast.ShowSuccess("Problema registrado correctamente.");
            }

            // Cerrar modal y refrescar
            _issueModalOpen = false;
            await ReloadVisitIssuesAsync(_openVisitId.Value);
        }
        catch (Exception ex)
        {
            _issueError = $"Error: {ex.Message}";
        }
        finally
        {
            _savingIssue = false;
            StateHasChanged();
        }
    }

    /// <summary>Cancelar modal</summary>
    private Task HandleCancelIssue()
    {
        _issueModalOpen = false;
        _issueError = null;
        _editingIssueId = null;
        _issueInitialValues = null;
        return Task.CompletedTask;
    }

