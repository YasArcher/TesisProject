        try
        {
            var detailTask = VisitService.GetVisitDetailAsync(visitId);
            var issuesTask = VisitIssueService.ListByVisitAsync(visitId);
            var productsTask = ProductService.ListByProjectAsync(ProjectId, CancellationToken.None);

            await Task.WhenAll(detailTask, issuesTask, productsTask);

            var detailRes = await detailTask;
            var issuesRes = await issuesTask;
            var productsRes = await productsTask;

            // ===== Detalle =====
            if (detailRes.Success)
                _visitDetail = detailRes.Response;
            else
            {
                _visitDetail = null;
                _visitDetailError = detailRes.Error ?? "No se pudo cargar el detalle de la visita.";
            }

            // ===== Issues =====
            if (issuesRes.Success)
                _visitIssues = issuesRes.Response?.ToList() ?? new();
            else
                _visitIssues = new(); // si quieres, aquí también podrías guardar un error

            // ===== Productos (filtrados por visita) =====
            if (productsRes.Success && productsRes.Response is not null)
            {
                _projectProducts = productsRes.Response.ToList();

                _visitProducts = _projectProducts
                    .Where(p => p.VisitId == visitId)
                    .OrderByDescending(p => p.CreatedAt)
                    .ToList();
            }
            else
            {
                _projectProducts = new();
                _visitProducts = new();
                _productsError = productsRes.Error ?? "No se pudieron cargar los productos del proyecto.";
            }
        }
        catch (Exception ex)
        {
            _visitDetail = null;
            _visitIssues = new();
            _projectProducts = new();
            _visitProducts = new();
            _visitDetailError = $"Error de conexión: {ex.Message}";
        }
        finally
        {
            _loadingVisitDetail = false;
        }

        StateHasChanged();
    }

