@page "/projects/{ProjectId:int}"
@using tesisproject.frontend.Features.Components
@using tesisproject.frontend.Services.Interfaces
@using tesisproject.frontend.SharedUI
@using tesisproject.frontend.SharedUI.Tabs
@using tesisproject.frontend.SharedUI.ActionButton
@using tesisproject.shared.DTOs.Catalog.Common.Response
@using tesisproject.shared.DTOs.Catalog.MemberRoleType.Response
@using tesisproject.shared.DTOs.Catalog.ResearchCategoryType.Response
@using tesisproject.shared.DTOs.Group.Request
@using tesisproject.shared.DTOs.ObjectiveActivity.Request
@using tesisproject.shared.DTOs.Project.Response
@using tesisproject.frontend.Features.Projects.Components
@using tesisproject.shared.DTOs.Budgets.Request
@using tesisproject.shared.DTOs.ProjectExtensions.Response
@using tesisproject.shared.DTOs.Visit.Request
@using tesisproject.shared.DTOs.Visit.Response
@using tesisproject.shared.DTOs.External
@using tesisproject.shared.DTOs.AppUser
@using tesisproject.shared.DTOs.VisitIssues.Request
@using tesisproject.shared.DTOs.VisitIssues.Response
@using tesisproject.shared.DTOs.Catalog.ResearchCategory.Response
@using tesisproject.shared.DTOs.ProjectObjective.Response
@using tesisproject.shared.DTOs.ObjectiveActivity.Response
@using tesisproject.shared.DTOs.ExternalResearcherProject.Response
@using tesisproject.shared.DTOs.ExternalResearcher.Request
@using tesisproject.shared.DTOs.ExternalResearcher.Response
@using tesisproject.shared.DTOs.Institution.Response
@using tesisproject.shared.DTOs.ExternalResearcherProject.Request
@using tesisproject.shared.DTOs.Products.Product.Response

@inject IProductClientService ProductService
@inject IExternalResearcherClientService ExternalResearcherClient
@inject IInstitutionClientService InstitutionClient
@inject IVisitClientService VisitService
@inject IProjectClientService ProjectService
@inject IBudgetClientService BudgetService
@inject IProjectExtensionClientService ProjectExtensionService
@inject IExternalAcademicsClientService ExternalAcademicsService
@inject IGroupService GroupService
@inject NavigationManager Nav
@inject IToastService Toast
@inject IObjectiveActivityClientService ObjectiveActivityService
@inject IExternalUserService ExternalUserService
@inject IVisitIssueClientService VisitIssueService
@inject IMemberRoleTypeClientService MemberRoleTypeService
@inject IResearchCategoryClientService ResearchCategoryService
@inject IResearchCategoryTypeClientService ResearchCategoryTypeService
@inject IResearchCategoryGroupClientService ResearchCategoryGroupService
@inject ITransactionTypeClientService TransactionTypeService
@inject IProjectObjectiveClientService ProjectObjectiveService
@inject IExternalResearcherProjectClientService ExternalResearcherProjectService
@inject IProjectExtensionTypeClientService ProjectExtensionTypeService


<div class="flex flex-col h-full">
    <!-- Header -->
    <div class="sticky top-0 z-10 rounded-2xl border border-border p-6 bg-primary-subtle/50 backdrop-blur-sm shrink-0">
        <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6">
            <!-- Izquierda -->
            <div class="space-y-3 min-w-0 flex-1">
                <div class="flex flex-wrap items-center gap-3">
                    <span class="inline-flex items-center px-3 py-1 text-sm font-bold rounded-full bg-primary text-white shrink-0">
                        #@_project?.ProjectId
                    </span>

                    @if (!string.IsNullOrEmpty(_project?.ProjectCode))
                    {
                        <span class="text-sm text-muted font-mono bg-muted/20 px-2 py-1 rounded max-w-full truncate">
                            @_project?.ProjectCode
                        </span>
                    }
                </div>

                <h1 class="text-2xl lg:text-3xl font-bold text-foreground leading-tight break-words text-balance">
                    @(string.IsNullOrEmpty(_project?.ProjectName) ? "Proyecto Sin Nombre" : _project?.ProjectName)
                </h1>

                <div class="flex flex-wrap items-center gap-3">
                    <span class="inline-flex items-center px-3 py-1 text-sm font-medium rounded-full bg-primary-subtle text-primary border border-primary/20">
                        @(_project?.ProjectTypeName ?? "Sin tipo")
                    </span>

                    <span class="inline-flex items-center px-3 py-1 text-sm font-medium rounded-full bg-secondary-subtle text-secondary border border-secondary/20">
                        @(_project?.ProjectStateName ?? "Sin estado")
                    </span>
                </div>
            </div>

            <!-- Derecha -->
            <div class="lg:text-right space-y-3 shrink-0">
                <div class="flex lg:justify-end">
                    <ActionButton Execute="GoToEdit"
                                  Text="Editar"
                                  Intent="ButtonIntent.Info"
                                  Variant="ButtonVariant.Filled"
                                  Size="ButtonSize.Md" />
                </div>

                <div class="text-sm font-medium text-muted">Progreso del Proyecto</div>
                <div class="flex items-center gap-4 lg:justify-end">
                    <div class="w-32 bg-border rounded-full h-3 relative overflow-hidden">
                        <div class="bg-secondary h-3 rounded-full transition-all duration-500"
                             style="width:@((_project?.ExecutionPercentage ?? 0).ToString("F1"))%"></div>
                    </div>
                    <span class="text-2xl font-bold text-secondary">
                        @((_project?.ExecutionPercentage ?? 0).ToString("F1"))%
                    </span>
                </div>
            </div>

        </div>
    </div>

    <!-- Tabs -->
    <div class="flex-1 overflow-y-auto min-h-0">
        <Tabs ActiveKey="@_activeTab" OnChange="OnTabChanged">

            <Tab Key="overview" Title="Detalles">
                <Icon>
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6">
                        <path d="M11.625 16.5a1.875 1.875 0 1 0 0-3.75 1.875 1.875 0 0 0 0 3.75Z" />
                        <path fill-rule="evenodd" d="M5.625 1.5H9a3.75 3.75 0 0 1 3.75 3.75v1.875c0 1.036.84 1.875 1.875 1.875H16.5a3.75 3.75 0 0 1 3.75 3.75v7.875c0 1.035-.84 1.875-1.875 1.875H5.625a1.875 1.875 0 0 1-1.875-1.875V3.375c0-1.036.84-1.875 1.875-1.875Zm6 16.5c.66 0 1.277-.19 1.797-.518l1.048 1.048a.75.75 0 0 0 1.06-1.06l-1.047-1.048A3.375 3.375 0 1 0 11.625 18Z" clip-rule="evenodd" />
                        <path d="M14.25 5.25a5.23 5.23 0 0 0-1.279-3.434 9.768 9.768 0 0 1 6.963 6.963A5.23 5.23 0 0 0 16.5 7.5h-1.875a.375.375 0 0 1-.375-.375V5.25Z" />
                    </svg>
                </Icon>
                <ChildContent>
                    <ProjectOverviewTab Item="_project"
                                        IsLoading="@_loadingOverview"
                                        ResearchCategoryTree="_researchCategoryTree"
                                        ResearchCategoryTypes="_researchCategoryTypes"
                                        ResearchCategoryGroups="_researchCategoryGroups"
                                        OnViewDocument="HandleViewDocument" />
                </ChildContent>
            </Tab>

            <Tab Key="members" Title="Miembros">
                <Icon>
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6">
                        <path fill-rule="evenodd" d="M8.25 6.75a3.75 3.75 0 1 1 7.5 0 3.75 3.75 0 0 1-7.5 0ZM15.75 9.75a3 3 0 1 1 6 0 3 3 0 0 1-6 0ZM2.25 9.75a3 3 0 1 1 6 0 3 3 0 0 1-6 0ZM6.31 15.117A6.745 6.745 0 0 1 12 12a6.745 6.745 0 0 1 6.709 7.498.75.75 0 0 1-.372.568A12.696 12.696 0 0 1 12 21.75c-2.305 0-4.47-.612-6.337-1.684a.75.75 0 0 1-.372-.568 6.787 6.787 0 0 1 1.019-4.38Z" clip-rule="evenodd" />
                        <path d="M5.082 14.254a8.287 8.287 0 0 0-1.308 5.135 9.687 9.687 0 0 1-1.764-.44l-.115-.04a.563.563 0 0 1-.373-.487l-.01-.121a3.75 3.75 0 0 1 3.57-4.047ZM20.226 19.389a8.287 8.287 0 0 0-1.308-5.135 3.75 3.75 0 0 1 3.57 4.047l-.01.121a.563.563 0 0 1-.373.486l-.115.04c-.567.2-1.156.349-1.764.441Z" />
                    </svg>
                </Icon>
                <ChildContent>
                    <ProjectMembersTab Members="_members"
                                       Faculties="_faculties"
                                       IsLoading="@_loadingMembers"
                                       ExternalResearchersProjects="_externalResearchers"
                                       IsLoadingExternalResearchers="@_loadingExternalResearchers"
                                       OnInviteMember="HandleInviteMember"
                                       OnChangeRole="HandleChangeRole"
                                       OnRemoveMember="HandleRemoveMember"
                                       OnAddExternalResearcher="HandleOpenExternalResearcherPicker"
                                       OnRemoveExternalResearcher="HandleRemoveExternalResearcher" />
                </ChildContent>
            </Tab>

            <Tab Key="visits" Title="Visitas">
                <Icon>
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6">
                        <path fill-rule="evenodd" d="M7.502 6h7.128A3.375 3.375 0 0 1 18 9.375v9.375a3 3 0 0 0 3-3V6.108c0-1.505-1.125-2.811-2.664-2.94a48.972 48.972 0 0 0-.673-.05A3 3 0 0 0 15 1.5h-1.5a3 3 0 0 0-2.663 1.618c-.225.015-.45.032-.673.05C8.662 3.295 7.554 4.542 7.502 6ZM13.5 3A1.5 1.5 0 0 0 12 4.5h4.5A1.5 1.5 0 0 0 15 3h-1.5Z" clip-rule="evenodd" />
                        <path fill-rule="evenodd" d="M3 9.375C3 8.339 3.84 7.5 4.875 7.5h9.75c1.036 0 1.875.84 1.875 1.875v11.25c0 1.035-.84 1.875-1.875 1.875h-9.75A1.875 1.875 0 0 1 3 20.625V9.375ZM6 12a.75.75 0 0 1 .75-.75h.008a.75.75 0 0 1 .75.75v.008a.75.75 0 0 1-.75.75H6.75a.75.75 0 0 1-.75-.75V12Zm2.25 0a.75.75 0 0 1 .75-.75h3.75a.75.75 0 0 1 0 1.5H9a.75.75 0 0 1-.75-.75ZM6 15a.75.75 0 0 1 .75-.75h.008a.75.75 0 0 1 .75.75v.008a.75.75 0 0 1-.75.75H6.75a.75.75 0 0 1-.75-.75V15Zm2.25 0a.75.75 0 0 1 .75-.75h3.75a.75.75 0 0 1 0 1.5H9a.75.75 0 0 1-.75-.75Z" clip-rule="evenodd" />
                    </svg>
                </Icon>
                <ChildContent>
                    @if (_openVisitId is int vid)
                    {
                        <VisitDetailPanel @key="vid"
                                          ProjectId="@ProjectId"
                                          VisitId="@vid"
                                          Value="@_visitDetail"
                                          VisitIssues="@_visitIssues"
                                          IsLoading="@_loadingVisitDetail"
                                          ErrorMessage="@_visitDetailError"
                                          ProjectObjectives="@_projectObjectives"
                                          Products="@_visitProducts"
                                          IsLoadingProducts="@_loadingProducts"
                                          ProductsError="@_productsError"
                                          OnProductCreated="HandleProductCreated"
                                          OnSaveActivityRequested="HandleSaveSingleActivityAsync"
                                          OnBack="HandleCloseVisit"
                                          OnAddIssue="HandleAddIssue"
                                          OnEditIssue="HandleEditIssue"
                                          OnDeleteIssue="HandleDeleteIssue"
                                          OnChangeVisitState="HandleChangeVisitStateAsync" />

                    }
                    else
                    {
                        <ProjectVisitsTab ProjectId="@ProjectId"
                                          Items="@_visits"
                                          IsLoading="@_loadingVisits"
                                          OnAddVisit="HandleAddVisit"
                                          OnOpenVisit="HandleOpenVisit"
                                          OnChangeVisitState="HandleChangeVisitStateAsync" />
                    }
                </ChildContent>
            </Tab>

            <Tab Key="financial" Title="Presupuesto">
                <Icon>
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6">
                        <path fill-rule="evenodd" d="M3.75 3.375c0-1.036.84-1.875 1.875-1.875H9a3.75 3.75 0 0 1 3.75 3.75v1.875c0 1.036.84 1.875 1.875 1.875H16.5a3.75 3.75 0 0 1 3.75 3.75v7.875c0 1.035-.84 1.875-1.875 1.875H5.625a1.875 1.875 0 0 1-1.875-1.875V3.375Zm10.5 1.875a5.23 5.23 0 0 0-1.279-3.434 9.768 9.768 0 0 1 6.963 6.963A5.23 5.23 0 0 0 16.5 7.5h-1.875a.375.375 0 0 1-.375-.375V5.25ZM12 10.5a.75.75 0 0 1 .75.75v.028a9.727 9.727 0 0 1 1.687.28.75.75 0 1 1-.374 1.452 8.207 8.207 0 0 0-1.313-.226v1.68l.969.332c.67.23 1.281.85 1.281 1.704 0 .158-.007.314-.02.468-.083.931-.83 1.582-1.669 1.695a9.776 9.776 0 0 1-.561.059v.028a.75.75 0 0 1-1.5 0v-.029a9.724 9.724 0 0 1-1.687-.278.75.75 0 0 1 .374-1.453c.425.11.864.186 1.313.226v-1.68l-.968-.332C9.612 14.974 9 14.354 9 13.5c0-.158.007-.314.02-.468.083-.931.831-1.582 1.67-1.694.185-.025.372-.045.56-.06v-.028a.75.75 0 0 1 .75-.75Zm-1.11 2.324c.119-.016.239-.03.36-.04v1.166l-.482-.165c-.208-.072-.268-.211-.268-.285 0-.113.005-.225.015-.336.013-.146.14-.309.374-.34Zm1.86 4.392V16.05l.482.165c.208.072.268.211.268.285 0 .113-.005.225-.015.336-.012.146-.14.309-.374.34-.12.016-.24.03-.361.04Z" clip-rule="evenodd" />
                    </svg>
                </Icon>
                <ChildContent>
                    <ProjectFinancialTab @key="_budgetRefreshToken"
                                         Budgets="_budgets"
                                         BudgetTransactionsByBudgetId="_budgetTransactions"
                                         IsLoading="_loadingBudget"
                                         TransactionTypes="_transactionTypes"
                                         OnAddCertification="HandleAddCertification"
                                         OnExecuteDevengado="HandleExecuteDevengado"
                                         OnCancelTransaction="HandleCancelTransaction"
                                         TransactionPageSize="15" />

                </ChildContent>
            </Tab>
            <Tab Key="extensions" Title="Prórrogas">
                <Icon>
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6">
                        <path fill-rule="evenodd" d="M12 2.25c-5.385 0-9.75 4.365-9.75 9.75s4.365 9.75 9.75 9.75 9.75-4.365 9.75-9.75S17.385 2.25 12 2.25ZM12.75 6a.75.75 0 0 0-1.5 0v6c0 .414.336.75.75.75h4.5a.75.75 0 0 0 0-1.5h-3.75V6Z" clip-rule="evenodd" />
                    </svg>
                </Icon>
                <ChildContent>
                    <ProjectExtensionsTab Items="_extensions"
                                          ExtensionTypes="_extensionTypes"
                                          IsLoading="_loadingExtensions"
                                          OnRequestNew="HandleRequestExtension"
                                          OnOpen="HandleOpenExtension" />
                </ChildContent>
            </Tab>
        </Tabs>
    </div>
</div>

<!-- Modales presupuesto -->
<ProjectCertificationModal IsOpen="@_certModalOpen"
                           IsOpenChanged="v => _certModalOpen = v"
                           Value="@_certSeed"
                           IsSaving="@_savingCert"
                           OnSubmit="OnSubmitCertification"
                           OnCancel="OnCancelCertification" />

<ProjectAccrualModal IsOpen="@_accrualModalOpen"
                     IsOpenChanged="v => _accrualModalOpen = v"
                     Value="@_accrualSeed"
                     IsSaving="@_savingAccrual"
                     OnSubmit="OnSubmitAccrual"
                     OnCancel="OnCancelAccrual" />
<!-- MODAL: User Picker -->
<UserPickerModal ModalId="project-user-picker"
                 IsOpen="@_showUserPicker"
                 IsOpenChanged="(bool v) => _showUserPicker = v"
                 Users="@_memberCandidates"
                 InitialSelectedUserId="@_preselectedUserId"
                 OnSubmit="HandleUserPickedAsync"
                 OnCancel="() => _showUserPicker = false"
                 Roles="_memberRoles"
                 @bind-SelectedRoleId="_selectedRoleIdForProject" />

<VisitIssueFormModal Id="visit-issue-modal"
                     IsOpen="@_issueModalOpen"
                     IsOpenChanged="v => _issueModalOpen = v"
                     IsSaving="@_savingIssue"
                     ErrorMessage="@_issueError"
                     IssueId="@_editingIssueId"
                     VisitId="@(_openVisitId ?? 0)"
                     InitialValues="@_issueInitialValues"
                     OnSubmit="HandleSubmitIssue"
                     OnCancel="HandleCancelIssue" />

<ExternalResearcherPickerModal ModalId="project-external-researcher-picker"
                               IsOpen="@_showExternalResearcherPicker"
                               IsOpenChanged="v => _showExternalResearcherPicker = v"
                               Researchers="@_externalResearcherCandidates"
                               OnSubmit="HandleExternalResearcherPickedAsync"
                               OnCancel="() => _showExternalResearcherPicker = false"
                               OnCreateNewRequested="HandleOpenExternalResearcherCreateModal" />

<ExternalResearcherCreateModal ModalId="project-external-researcher-create"
                               IsOpen="@_showExternalResearcherCreateModal"
                               IsOpenChanged="v => _showExternalResearcherCreateModal = v"
                               OnSave="HandleExternalResearcherCreatedAsync"
                               OnCancel="HandleExternalResearcherCreateCanceled"
                               InstitutionSuggestions="@_institutionSuggestions"
                               OnInstitutionSearchRequested="HandleInstitutionSearchAsync" />

<DocumentViewerModal Id="document-viewer-modal"
                     Title="Documento inicial del Proyecto"
                     DocumentId="@_selectedDocumentId"
                     IsOpen="@_docViewerOpen"
                     IsOpenChanged="v => _docViewerOpen = v" />

<!-- Al final del archivo, después de los otros modales -->

<CreateProjectExtensionModal @bind-IsOpen="_showCreateExtensionModal"
                             ProjectId="@ProjectId"
                             ExtensionTypes="@(_extensionTypes ?? new())"
                             OnExtensionCreated="HandleExtensionCreated" />

@code {
    private bool _docViewerOpen;
    private int _selectedDocumentId;


    // ======= products (para visitas/detail) =======
    private List<ProductListItemResponseDTO> _projectProducts = new();
    private List<ProductListItemResponseDTO> _visitProducts = new();
    private bool _loadingProducts;
    private string? _productsError;

    // ======= Categorías de investigación (árbol) =======
    private IReadOnlyList<ResearchCategoryTreeItemDTO> _researchCategoryTree = Array.Empty<ResearchCategoryTreeItemDTO>();
    private bool _loadingResearchCategories;
    private string? _researchCategoriesError;
    [Parameter] public int ProjectId { get; set; }

    // ======= Estado general =======
    private ProjectDetailResponseDTO? _project;
    private string _activeTab = "overview";
    private bool _loadingOverview;
    private string? _error;

    // ======= Objetivos del proyecto (para avance en visitas) =======
    private IReadOnlyList<ProjectObjectiveWithActivitiesDTO> _projectObjectives = Array.Empty<ProjectObjectiveWithActivitiesDTO>();
    private bool _loadingObjectives;
    private string? _objectivesError;


    // ======= Miembros =======
    private List<ResolvedUserProfileDTO>? _members;
    private bool _loadingMembers;
    private string? _membersError;

    // ======= Investigadores externos =======
    private List<ExternalResearcherProjectListItemDTO>? _externalResearchers;
    private bool _loadingExternalResearchers;
    private string? _externalResearchersError;

    // ======= Visitas (lista) =======
    private List<VisitListResponseDTO>? _visits;
    private bool _loadingVisits;
    private string? _visitsError;

    // ======= Visitas (detalle para swap) =======
    private int? _openVisitId;                            // << NUEVO
    private VisitDetailResponseDTO? _visitDetail;         // << NUEVO
    private bool _loadingVisitDetail;                     // << NUEVO
    private string? _visitDetailError;                    // << NUEVO
    private List<VisitIssueResponseDTO>? _visitIssues;
    private bool _loadingIssues;
    private bool _issueModalOpen;
    private bool _savingIssue;
    private string? _issueError;
    private int? _editingIssueId;
    private VisitIssueFormModal.VisitIssueFormModel? _issueInitialValues;

    // ======= Tipos de transacción (catálogo) =======
    private IReadOnlyList<CatalogListItemDTO> _transactionTypes = Array.Empty<CatalogListItemDTO>();
    private bool _loadingTransactionTypes;
    private string? _transactionTypesError;

    // ======= Presupuesto =======
    private List<BudgetDTO> _budgets = new();
    private Dictionary<int, List<BudgetTransactionDTO>> _budgetTransactions = new();
    private bool _loadingBudget;
    private string? _budgetError;
    private int _budgetRefreshToken = 0;

    // Para saber en qué presupuesto se está devengando
    private int? _selectedBudgetIdForAccrual;


    // ======= Modales presupuesto =======
    private bool _certModalOpen;
    private bool _savingCert;
    private AddCertificationRequestDTO _certSeed = new();

    // ======= Prórrogas =======
    private List<ProjectExtensionListResponseDTO>? _extensions;
    private bool _loadingExtensions;
    private string? _extensionsError;
    // Agregar esta variable al inicio del @code
    private bool _showCreateExtensionModal;

    // Reemplazar los handlers existentes:
    private Task HandleRequestExtension()
    {
        _showCreateExtensionModal = true;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task HandleExtensionCreated()
    {
        _showCreateExtensionModal = false;
        await LoadProjectExtensions();
        StateHasChanged();
    }


    private List<CatalogListItemDTO>? _extensionTypes;  // Lista de tipos de prórroga
    private bool _loadingExtensionTypes;
    private string? _extensionTypesError;

    private bool _accrualModalOpen;
    private bool _savingAccrual;
    private ExecuteDevengadoRequestDTO _accrualSeed = new();

    // ====== User Picker (miembros) ======
    private bool _showUserPicker;
    private List<ResolvedUserProfileDTO> _memberCandidates = new();
    private int? _preselectedUserId;

    // ======= Facultades / Programas externos =======
    private List<ExternalFacultyDTO> _faculties = new();
    private bool _loadingFaculties;
    private string? _facultiesError;

    // ======= Roles de miembro para el picker de proyecto =======
    private IEnumerable<MemberRoleTypeDetailDTO>? _memberRoles;
    private int? _selectedRoleIdForProject;
    // ======= Tipos de Categoría de Investigación =======
    private IReadOnlyList<ResearchCategoryTypeListItemDTO> _researchCategoryTypes = Array.Empty<ResearchCategoryTypeListItemDTO>();
    private string? _researchCategoryTypesError;
    private bool _loadingResearchCategoryTypes;

    // ======= Agrupaciones de Categorías de Investigación =======
    private IReadOnlyList<CatalogListItemDTO> _researchCategoryGroups
        = Array.Empty<CatalogListItemDTO>();
    private bool _loadingResearchCategoryGroups;
    private string? _researchCategoryGroupsError;

    // Investigadores externos (picker / crear)
    private bool _showExternalResearcherPicker;
    private bool _showExternalResearcherCreateModal;

    private List<ExternalResearcherListItemDTO> _externalResearcherCandidates = new();
    private List<InstitutionListItemDTO> _institutionSuggestions = new();
    private List<InstitutionListItemDTO> _allInstitutions = new();

    private Task GoToEdit()
    {
        Nav.NavigateTo($"/projects/{ProjectId}/edit");
        return Task.CompletedTask;
    }


    private async Task HandleOpenExternalResearcherPicker()
    {
        try
        {
            var result = await ExternalResearcherClient.ListAsync(
                term: null,
                institutionId: null,
                ct: CancellationToken.None);

            if (!result.Success || result.Response is null)
            {
                Toast.ShowError(result.Error ?? "No se pudieron cargar los investigadores externos.");
                return;
            }

            // Evitar duplicados: ya asociados a este proyecto
            var existingIds = new HashSet<int>(_externalResearchers?.Select(er => er.ExternalResearcherId) ?? Enumerable.Empty<int>());

            _externalResearcherCandidates = result.Response
                .Where(r => !existingIds.Contains(r.Id))
                .OrderBy(r => r.FullName)
                .ToList();

            if (_externalResearcherCandidates.Count == 0)
            {
                Toast.ShowInfo("No hay investigadores externos disponibles para agregar.");
            }

            _showExternalResearcherPicker = true;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Error al cargar investigadores externos: {ex.Message}");
        }
    }

    private async Task LoadExtensionTypes()
    {
        _loadingExtensionTypes = true;
        _extensionTypesError = null;

        try
        {
            var res = await ProjectExtensionTypeService.GetListAsync(onlyActives: true, CancellationToken.None);
            if (res.Success && res.Response is not null)
            {
                _extensionTypes = res.Response;  // Asigna la lista de tipos de prórroga
            }
            else
            {
                _extensionTypes = new List<CatalogListItemDTO>();
                _extensionTypesError = res.Error ?? "No se pudieron cargar los tipos de prórroga.";
            }
        }
        catch (Exception ex)
        {
            _extensionTypes = new List<CatalogListItemDTO>();
            _extensionTypesError = $"Error al cargar los tipos de prórroga: {ex.Message}";
        }
        finally
        {
            _loadingExtensionTypes = false;
        }
    }

    private async Task LoadProjectExtensions()
    {
        _loadingExtensions = true;
        _extensionsError = null;

        try
        {
            var res = await ProjectExtensionService.ListByProjectAsync(ProjectId, CancellationToken.None);
            if (res.Success && res.Response is not null)
            {
                _extensions = res.Response;
            }
            else
            {
                _extensions = new List<ProjectExtensionListResponseDTO>();
