    private Task HandleExecuteDevengado(int budgetTransactionId)
    {
        // Buscar a qué presupuesto pertenece esta transacción
        int? budgetId = null;

        foreach (var kvp in _budgetTransactions)
        {
            var txList = kvp.Value;
            if (txList is not null && txList.Any(t => t.BudgetTransactionId == budgetTransactionId))
            {
                budgetId = kvp.Key; // este es el BudgetId
                break;
            }
        }

        if (!budgetId.HasValue)
        {
            Toast.ShowError("No se pudo identificar el presupuesto de esta transacción.");
            return Task.CompletedTask;
        }

        _selectedBudgetIdForAccrual = budgetId.Value;
        _savingAccrual = false;

        _accrualSeed = new ExecuteDevengadoRequestDTO
        {
            BudgetTransactionId = budgetTransactionId,
            ExecutedAmount = 0,
            CURNumber = string.Empty,
            ExecutionDescription = string.Empty,
            ExecutedAt = null
        };

        _accrualModalOpen = true;
        StateHasChanged();
        return Task.CompletedTask;
    }


