    // >>> SWAP: abrir detalle (ya NO navegamos a /visits/{id})
    private async Task HandleOpenVisit(int visitId)
    {
        _openVisitId = visitId;
        _loadingVisitDetail = true;
        _visitDetailError = null;

        try
        {
            // <<<< MODIFICAR: Cargar detalle de la visita Y sus issues
            var detailTask = VisitService.GetVisitDetailAsync(visitId);
            var issuesTask = VisitIssueService.ListByVisitAsync(visitId);

            await Task.WhenAll(detailTask, issuesTask);

            var detailRes = await detailTask;
            var issuesRes = await issuesTask;

            if (detailRes.Success)
                _visitDetail = detailRes.Response;
            else
                _visitDetailError = detailRes.Error ?? "No se pudo cargar el detalle de la visita.";

            if (issuesRes.Success)
                _visitIssues = issuesRes.Response?.ToList() ?? new();
            else
                _visitIssues = new();
            await Task.Delay(500); // Simular carga
        }
        catch (Exception ex)
        {
            _visitDetail = null;
            _visitIssues = new();
            _visitDetailError = $"Error de conexión: {ex.Message}";
        }
        finally
        {
            _loadingVisitDetail = false;
        }

        StateHasChanged();
    }

    // >>> SWAP: cerrar detalle y volver a la lista
    private Task HandleCloseVisit()
    {
        _openVisitId = null;
        _visitDetail = null;
        _visitDetailError = null;
        _visitIssues = null;
        // (opcional) refrescar lista si quieres
         _ = EnsureTabDataAsync("visits");
        return Task.CompletedTask;
    }
