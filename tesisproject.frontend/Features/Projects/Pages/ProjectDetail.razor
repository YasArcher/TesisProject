    private async Task HandleSaveObjectivesAsync(IEnumerable<ObjectiveActivityListItemDTO> activities)
    {
        var list = activities?.ToList() ?? new();
        if (list.Count == 0)
        {
            Toast.ShowInfo("No hay actividades para guardar.");
            return;
        }

        try
        {
            // Actualiza cada actividad (ProgressPercentage 0..100)
            var tasks = list.Select(a =>
            {
                var dto = new UpdateObjectiveActivityRequestDTO
                {
                    // ✅ Mapea estos campos con los nombres reales de tu DTO de UI
                    ObjectiveActivityId = a.ObjectiveActivityId,
                    ObjectiveId = a.ObjectiveId,
                    ActionText = a.ActionText ?? string.Empty,
                    ActivityResult = a.ActivityResult,
                };

                return ObjectiveActivityService.UpdateAsync(a.ObjectiveActivityId, dto, CancellationToken.None);
            }).ToList();

            var results = await Task.WhenAll(tasks);

            var firstFail = results.FirstOrDefault(r => !r.Success);
            if (firstFail is not null)
            {
                Toast.ShowError(firstFail.Error ?? "No se pudieron guardar algunos cambios.");
                return;
            }

            Toast.ShowSuccess("Avance guardado correctamente.");

            // ✅ Refresh parcial del tab visits (no recarga toda la página)
            await RefreshVisitsTabAsync(refreshVisitList: false, refreshVisitDetail: false);
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Error al guardar actividades: {ex.Message}");
        }
    }



