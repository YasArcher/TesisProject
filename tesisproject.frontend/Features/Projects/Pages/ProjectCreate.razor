    private async Task HandleSaveAsync()
    {
        if (IsSaving)
            return;

        //Console.WriteLine("=== [HandleSaveAsync] Inicio ===");
        IsSaving = true;

        try
        {
            //Console.WriteLine("→ Validando campos iniciales...");

            if (string.IsNullOrWhiteSpace(DideData.ProjectName))
            {
                //Console.WriteLine("❌ ProjectName faltante");
                Toast.ShowWarning("Ingrese el nombre del proyecto antes de crear el registro.");
                return;
            }

            if (DideData.ResearchTypeId is null || DideData.ResearchTypeId.Value <= 0)
            {
                //Console.WriteLine("❌ ResearchTypeId faltante");
                Toast.ShowWarning("Seleccione el tipo de investigación del proyecto.");
                return;
            }

            if (_budgets is null || !_budgets.Any(b => b.FundingTypeId > 0 && b.InitialAmount > 0))
            {
                //Console.WriteLine("❌ Budgets no válidos");
                Toast.ShowWarning("Debe registrar al menos un presupuesto con monto inicial mayor a 0.");
                return;
            }

            var facultyId = ResolveCoordinatorFacultyId();
            //Console.WriteLine($"→ FacultyId resuelto: {facultyId}");

            if (facultyId <= 0)
            {
                //Console.WriteLine("❌ Faculty ID inválido");
                Toast.ShowError("No se pudo determinar la facultad del proyecto. Verifique los investigadores y sus facultades.");
                return;
            }

            if (!_scheduledDate.HasValue)
            {
                //Console.WriteLine("❌ No hay fecha programada para visita");
                Toast.ShowWarning("Seleccione la fecha programada para la visita del proyecto.");
                return;
            }

            // ===============================
            // UPLOAD DOCUMENTO
            // ===============================

            if (_projectDocument is null)
            {
                //Console.WriteLine("→ Documento no existe aún, preparando upload...");

                if (_selectedResolutionFile is null)
                {
                    //Console.WriteLine("❌ No seleccionaste archivo PDF de resolución");
                    Toast.ShowWarning("Debe seleccionar el PDF de la resolución inicial antes de crear el proyecto.");
                    return;
                }

                //Console.WriteLine($"→ Subiendo PDF: {_selectedResolutionFile.Name} (tipo: {_selectedResolutionFile.ContentType})");

                if (_resolutionFileBytes is null)
                {
                    Toast.ShowError("No se encontraron los bytes del archivo de resolución. Vuelva a seleccionar el archivo.");
                    return;
                }

                var dto = new UploadDocumentClientDTO
                {
                    DocumentTypeId = 1,
                    RelatedDocumentId = null,
                    ResolutionCode = ResolutionData.ResolutionCode,
                    ResolutionDate = ResolutionData.ResolutionHeaderDate,
                    CreatedByUserId = _currentUserId
                };
                var content = MultipartBuilder.Build(
                    dto,
                    _resolutionFileBytes,
                    _selectedResolutionFile.Name,
                    _selectedResolutionFile.ContentType
                );

                //Console.WriteLine("→ Subiendo documento...");
                var uploadResponse = await DocumentClient.UploadAsync(content);

                //Console.WriteLine($"← Respuesta Upload: Success={uploadResponse.Success}, Error={uploadResponse.Error}");

                if (!uploadResponse.Success || uploadResponse.Response is null)
                {
                    //Console.WriteLine("❌ Error subiendo documento");
                    Toast.ShowError(uploadResponse.Error ?? "No se pudo subir el documento de resolución.");
                    return;
                }

                _projectDocument = uploadResponse.Response;
                //Console.WriteLine($"✓ Documento subido. DocumentId: {_projectDocument.DocumentId}");
            }

            var documentDto = _projectDocument;

            // ===============================
            // CREAR DTO PRINCIPAL DEL PROYECTO
            // ===============================

            //Console.WriteLine("→ Preparando Project DTO...");

            // 1) Obtener acrónimo de la facultad
            var faculty = _faculties.FirstOrDefault(f => f.FacultyId == facultyId);
            var facultyAcronym = faculty?.Acronym ?? string.Empty;

            var projectDto = new AddProjectRequestDTO
            {
                ProjectName = DideData.ProjectName,
                ProjectTypeId = _selectedProjectTypeId,
                ProjectGroupId = 0,
                ResearchCategoryIds = ExtractSelectedResearchCategoryIds(),
                ApprovalDate = ResolutionData.ResolutionHeaderDate
                               ?? documentDto.ResolutionDate
                               ?? DateTime.Today,
                StartDate = ResolutionData.ExecutionStartDate,
                ProjectCode = facultyAcronym,
                CreatedByUserId = _currentUserId,
                ProjectStateId = 3,
                DurationInMonths = ResolutionData.Duration > 0 ? ResolutionData.Duration : 12,
                FacultyId = facultyId
            };

            //Console.WriteLine($"→ ProjectDto listo: Name={projectDto.ProjectName}, Code={projectDto.ProjectCode}, Type={projectDto.ProjectTypeId}, FacultyId={projectDto.FacultyId}");

            // ===============================
            // BUDGETS
            // ===============================

            var budgetsDto = new List<CreateBudgetRequestDTO>();
            if (_budgets != null)
            {
                foreach (var b in _budgets.Where(x => x.FundingTypeId > 0 && x.InitialAmount > 0))
                {
                    budgetsDto.Add(new CreateBudgetRequestDTO
                    {
                        ProjectId = 0,
                        ApprovedByUserId = _currentUserId,
                        InitialAmount = b.InitialAmount,
                        FundingTypeId = b.FundingTypeId
                    });
                }
            }

            //Console.WriteLine($"→ Budgets listos. Count={budgetsDto.Count}");

            // ===============================
            // OBJECTIVES
            // ===============================

            var objectivesDto = new List<ProjectObjectiveWithActivitiesRequestDTO>();

            if (DideData.Objectives != null)
            {
                foreach (var obj in DideData.Objectives)
                {
                    var objectiveDto = new ProjectObjectiveWithActivitiesRequestDTO
                    {
                        ObjectiveTypeId = obj.ObjectiveType,
                        Objective = obj.ObjectiveText,
                        Result = "Result not provided in DIDE form",
                        Activities = MapActivities(obj)
                    };

                    objectivesDto.Add(objectiveDto);
                }
            }

            //Console.WriteLine($"→ Objectives listos. Count={objectivesDto.Count}");

            // ===============================
            // GROUP MEMBERS (miembros del proyecto)
            // ===============================

            var groupMembersDto = new List<AddGroupMemberRequestDTO>();

            if (DideData.Researchers != null)
            {
                foreach (var r in DideData.Researchers)
                {
                    // Basta con que tenga email y rol
                    if (!string.IsNullOrWhiteSpace(r.email) && r.Role > 0)
                    {
                        groupMembersDto.Add(new AddGroupMemberRequestDTO
                        {
                            AspUserId = r.AspNetUserId > 0 ? r.AspNetUserId : null,
                            MemberRole = r.Role,
                            Document = r.Document,
                            GroupId = 0, // el back ignora esto y usa el group generado
                            Email = r.email,
                        });
                    }
                }
            }

            //Console.WriteLine("[Wizard] Researchers total: " + (DideData.Researchers?.Count ?? 0));
            //Console.WriteLine("[Wizard] GroupMembers a enviar: " +
            //   System.Text.Json.JsonSerializer.Serialize(groupMembersDto));

            // ===============================
            // REQUEST COMPLETO
            // ===============================

            var request = new AddProjectFullRequestDTO
            {
                Project = projectDto,
                ProjectDocumentData = documentDto,
                GroupMembers = groupMembersDto,
                Budgets = budgetsDto,
                Objectives = objectivesDto,
                ScheduledDate = _scheduledDate.Value
            };

            //Console.WriteLine("→ Llamando a ProjectClient.CreateFullAsync() ...");
            var response = await ProjectClient.CreateFullAsync(request, CancellationToken.None);

            //Console.WriteLine($"← Respuesta CreateFull: Success={response.Success}, Error={response.Error}");

            if (!response.Success || response.Response is null)
            {
                //Console.WriteLine($"❌ Error creando proyecto: {response.Error}");
                Toast.ShowError(response.Error ?? "No se pudo crear el proyecto.");
                return;
            }

            //Console.WriteLine($"✓ Proyecto creado. ProjectId={response.Response.ProjectId}");
            Toast.ShowSuccess("Proyecto creado correctamente.");

            Nav.NavigateTo($"/projects/{response.Response.ProjectId}");
        }
        finally
        {
            //Console.WriteLine("=== [HandleSaveAsync] FIN ===");
            IsSaving = false;
        }
    }

    private Task OnBudgetsChanged(List<CreateBudgetRequestDTO> newBudgets)
    {
        _budgets = newBudgets ?? new();
        _fundingTypeId = _budgets
            .FirstOrDefault(b => b.FundingTypeId > 0)?.FundingTypeId ?? 0;

        return Task.CompletedTask;
    }

    private int ResolveCoordinatorFacultyId()
    {
        if (DideData.Researchers is null || DideData.Researchers.Count == 0)
            return 0;

        if (_faculties is null || _faculties.Count == 0)
            return 0;

        // 1) Intentar con el coordinador principal
        if (_coordinatorRoleId.HasValue)
        {
            var coord = DideData.Researchers
                .FirstOrDefault(r => r.Role == _coordinatorRoleId.Value && r.FacultyCareerId > 0);

            if (coord is not null)
                return MapProgramToFaculty(coord.FacultyCareerId);
        }

        // 2) Fallback: cualquier investigador con FacultyCareerId > 0
        var withFaculty = DideData.Researchers.FirstOrDefault(r => r.FacultyCareerId > 0);
        if (withFaculty is not null)
            return MapProgramToFaculty(withFaculty.FacultyCareerId);

        return 0;
    }

    private int MapProgramToFaculty(int facultyCareerId)
    {
        if (facultyCareerId <= 0 || _faculties is null || _faculties.Count == 0)
            return 0;

        // Buscar el programa dentro de las facultades
        foreach (var fac in _faculties)
        {
            if (fac.Programs is null)
                continue;

            if (fac.Programs.Any(p => p.ProgramId == facultyCareerId))
                return fac.FacultyId;
        }

        // Fallback: por si el id ya fuera FacultyId
        var facById = _faculties.FirstOrDefault(f => f.FacultyId == facultyCareerId);
        return facById?.FacultyId ?? 0;
    }

    private List<AddObjectiveActivityRequestDTO> MapActivities(DideObjectiveInfo obj)
    {
        var result = new List<AddObjectiveActivityRequestDTO>();

        if (obj.Activities is null)
            return result;

        foreach (var act in obj.Activities)
        {
            result.Add(new AddObjectiveActivityRequestDTO
            {
                ActivityResult = act.ActivityResult,
                ActionText = act.ActivityText,
                IsCompleted = false,
            });
        }

        return result;
    }

