    private List<int> ExtractSelectedResearchCategoryIds()
    {
        var result = new List<int>();

        if (_selectedResearchCategories is null || _selectedResearchCategories.Count == 0)
            return result;

        void CollectLeafIds(ResearchCategoryTreeItemDTO node)
        {
            if (node.Children == null || node.Children.Count == 0)
            {
                result.Add(node.Id);
                return;
            }

            foreach (var child in node.Children)
                CollectLeafIds(child);
        }

        foreach (var root in _selectedResearchCategories)
            CollectLeafIds(root);

        return result.Distinct().ToList();
    }

    private async Task HandleOpenExternalResearcherPicker()
    {
        try
        {
            var result = await ExternalResearcherClient.ListAsync(
                term: null,
                institutionId: null,
                ct: CancellationToken.None);

            if (!result.Success || result.Data is null)
            {
                Toast.ShowError(result.ToErrorMessage("No se pudieron cargar los investigadores externos."));
                return;
            }

            _externalResearcherCandidates = result.Data
                .Where(r => !_selectedExternalResearchers.Any(s => s.Id == r.Id))
                .OrderBy(r => r.FullName)
                .ToList();

            if (_externalResearcherCandidates.Count == 0)
                Toast.ShowInfo("No hay investigadores externos registrados. Puede crearlos con 'Nuevo investigador externo'.");

            _showExternalResearcherPicker = true;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Error al cargar investigadores externos: {ex.Message}");
        }
    }

