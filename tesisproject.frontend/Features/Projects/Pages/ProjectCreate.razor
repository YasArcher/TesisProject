    private async Task EnsureInstitutionsLoadedAsync()
    {
        if (_allInstitutions.Count > 0)
            return;

        var result = await InstitutionClient.ListAsync(
            onlyActives: true,
            ct: CancellationToken.None);

        if (result.Success && result.Data is not null)
        {
            _allInstitutions = result.Data;
        }
        else if (!result.Success)
        {
            Toast.ShowWarning(result.ToErrorMessage("No se pudieron cargar las instituciones."));
        }
    }

    private async Task HandleInstitutionSearchAsync(string searchTerm)
    {
        await EnsureInstitutionsLoadedAsync();

        if (_allInstitutions.Count == 0)
        {
            _institutionSuggestions = new List<InstitutionListItemDTO>();
            return;
        }

        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            _institutionSuggestions = _allInstitutions
                .OrderBy(i => i.Name)
                .Take(20)
                .ToList();
        }
        else
        {
            var term = searchTerm.Trim();

            _institutionSuggestions = _allInstitutions
                .Where(i =>
                    (!string.IsNullOrWhiteSpace(i.Name) &&
                     i.Name.Contains(term, StringComparison.OrdinalIgnoreCase))
                    || (!string.IsNullOrWhiteSpace(i.CountryName) &&
                        i.CountryName.Contains(term, StringComparison.OrdinalIgnoreCase)))
                .OrderBy(i => i.Name)
                .Take(20)
                .ToList();
        }
    }

    private Task HandleExternalResearcherPickedAsync(int externalResearcherId)
    {
        var researcher = _externalResearcherCandidates
            .FirstOrDefault(r => r.Id == externalResearcherId);

        if (researcher is null)
        {
            Toast.ShowError("No se encontró el investigador externo seleccionado.");
            _showExternalResearcherPicker = false;
            return Task.CompletedTask;
        }

        if (_selectedExternalResearchers.Any(r => r.Id == researcher.Id))
        {
            Toast.ShowInfo("Este investigador externo ya fue agregado.");
            _showExternalResearcherPicker = false;
            return Task.CompletedTask;
        }

        _selectedExternalResearchers.Add(researcher);

        Toast.ShowSuccess($"Investigador externo '{researcher.FullName}' agregado al proyecto.");
        _showExternalResearcherPicker = false;
        StateHasChanged();

        return Task.CompletedTask;
    }

    private Task HandleRemoveExternalResearcher(int id)
    {
        var existing = _selectedExternalResearchers.FirstOrDefault(r => r.Id == id);
        if (existing is not null)
        {
            _selectedExternalResearchers.Remove(existing);
            StateHasChanged();
            Toast.ShowInfo($"Investigador externo '{existing.FullName}' fue removido.");
        }

        return Task.CompletedTask;
    }

