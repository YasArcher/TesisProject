@page "/projects"
@using tesisproject.frontend.Features.Projects.Components
@using tesisproject.frontend.Services.Implementations
@using tesisproject.frontend.Services.Interfaces
@using tesisproject.frontend.SharedUI
@using tesisproject.frontend.SharedUI.ActionButton
@using tesisproject.shared.DTOs.Project
@using tesisproject.shared.DTOs.Project.Response
@inject IProjectClientService ProjectService

<Container TItem="ProjectListResponseDTO"
           Items="@GetProjects()"
           Title="Mis Proyectos"
           ShowItemCount="true"
           IsLoading="@isLoading"
           GridClasses="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4 md:gap-6"
           EmptyStateTitle="No tienes proyectos aún"
           EmptyStateDescription="Comienza creando tu primer proyecto para organizar tu trabajo.">
    <EmptyStateAction>
        <ActionButton Text="Crear Nuevo Proyecto"
                      Execute="CreateNewProject"
                      Intent="ButtonIntent.Accept"
                      Variant="ButtonVariant.Filled"
                      Size="ButtonSize.Sm"
                      Disabled="@isLoading"
                      Class="px-4 py-2 rounded-md" />
    </EmptyStateAction>
    <ChildContent Context="project">
        <ProjectCard Item="project" />
    </ChildContent>
</Container>

@code {
    private List<ProjectListResponseDTO>? projects;
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadProjects();
    }

    private List<ProjectListResponseDTO> GetProjects()
    {
        return projects ?? new List<ProjectListResponseDTO>();
    }

    private async Task LoadProjects()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var response = await ProjectService.GetListAsync(onlyActive: true);

            if (response.Success)
            {
                projects = response.Response ?? new List<ProjectListResponseDTO>();
            }
            else
            {
                errorMessage = response.Error ?? "Error desconocido al cargar proyectos";
                projects = new List<ProjectListResponseDTO>();
                Console.WriteLine($"Error loading projects: {errorMessage}");
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error de conexión: {ex.Message}";
            Console.WriteLine($"Exception loading projects: {ex.Message}");
            projects = new List<ProjectListResponseDTO>();
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void CreateNewProject()
    {
        // En espera
    }
}