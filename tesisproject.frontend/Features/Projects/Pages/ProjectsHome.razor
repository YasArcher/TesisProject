@page "/projects/home"
@using tesisproject.frontend.Features.Projects.Components
@using tesisproject.frontend.Services.Interfaces
@using tesisproject.frontend.SharedUI
@using tesisproject.frontend.SharedUI.ActionButton
@using tesisproject.shared.DTOs.Project.Response
@inject IProjectClientService ProjectService
@inject NavigationManager Nav

<Container TItem="ProjectListResponseDTO"
           Items="projects ?? new()"
           Title="Mis Proyectos"
           ShowItemCount="true"
           IsLoading="@isLoading"
           GridClasses="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4 md:gap-6"
           EmptyStateTitle="No tienes proyectos aún"
           EmptyStateDescription="Comienza creando tu primer proyecto para organizar tu trabajo.">

    <EmptyStateAction>
        <ActionButton Text="Crear Nuevo Proyecto"
                      Execute="CreateNewProject"
                      Intent="ButtonIntent.Accept"
                      Variant="ButtonVariant.Filled"
                      Size="ButtonSize.Sm"
                      Disabled="@isLoading"
                      Class="px-4 py-2 rounded-md" />
    </EmptyStateAction>

    <ChildContent Context="project">
        @* Usa @key si el Container no lo hace internamente *@
        <div @key="project.ProjectId">
            <ProjectCard Item="project"
                         OnOpen="HandleOpen"
                         OnShowDetails="HandleShowDetails" />
        </div>
    </ChildContent>
</Container>

@code {
    private List<ProjectListResponseDTO>? projects;
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync() => await LoadProjects();

    private async Task LoadProjects()
    {
        isLoading = true; errorMessage = null;
        try
        {
            var resp = await ProjectService.GetListAsync(onlyActive: true);
            projects = resp.Success ? resp.Response ?? new() : new();
            if (!resp.Success) errorMessage = resp.Error ?? "Error desconocido al cargar proyectos";
        }
        catch (Exception ex)
        {
            errorMessage = $"Error de conexión: {ex.Message}";
            projects = new();
        }
        finally { isLoading = false; StateHasChanged(); }
    }

    // Navegación y acciones desde el padre
    private Task HandleOpen(ProjectListResponseDTO item)
    {
        Nav.NavigateTo($"/projects/{item.ProjectId}");
        return Task.CompletedTask;
    }

    private Task HandleShowDetails(ProjectListResponseDTO item)
    {
        // Abrir modal, sidebar, etc. (solo ejemplo)
        Console.WriteLine($"Show details for {item.ProjectName}");
        return Task.CompletedTask;
    }

    private void CreateNewProject()
    {
        Nav.NavigateTo("/projects/create");
    }
}
