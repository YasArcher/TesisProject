@page "/projects"
@using tesisproject.frontend.Components
@using tesisproject.frontend.SharedUI
@using tesisproject.shared.DTOs.Project
@using tesisproject.frontend.Services.Interfaces
@using tesisproject.frontend.Features.Projects.Components
@inject IApiClient Api

<Container TItem="ProjectListItemDto"
           Items="@GetProjects()"
           Title="Mis Proyectos"
           ShowItemCount="true"
           IsLoading="@isLoading"
           GridClasses="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4 md:gap-6"
           EmptyStateTitle="No tienes proyectos aún"
           EmptyStateDescription="Comienza creando tu primer proyecto para organizar tu trabajo.">

    <EmptyStateAction>
        <button @onclick="CreateNewProject"
                class="px-4 py-2 bg-blue-500 text-white rounded-md hover:bg-blue-600 font-medium">
            Crear Nuevo Proyecto
        </button>
    </EmptyStateAction>
    <ChildContent Context="project">
        <ProjectCard Item="project" />
    </ChildContent>
</Container>

@code {
    private List<ProjectListItemDto>? projects;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadProjects();
    }

    private List<ProjectListItemDto> GetProjects()
    {
        return projects ?? new List<ProjectListItemDto>();
    }

    private async Task LoadProjects()
    {
        isLoading = true;
        try
        {
            projects = await Api.GetAsync<List<ProjectListItemDto>>("api/projects/list");
            projects ??= new List<ProjectListItemDto>();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading projects: {ex.Message}");
            projects = new List<ProjectListItemDto>();
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void CreateNewProject()
    {
        // Navegar a creación de proyecto
    }
}