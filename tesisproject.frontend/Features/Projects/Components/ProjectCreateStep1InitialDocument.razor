@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@using tesisproject.shared.DTOs.Algorithms.Response
@using tesisproject.shared.DTOs.Filters
@using tesisproject.frontend.SharedUI.FileUpload
@using tesisproject.frontend.SharedUI.ActionButton
@using tesisproject.frontend.SharedUI.TextInput
@using tesisproject.frontend.Utils
@using System.Globalization

<div class="w-full flex flex-col gap-6">
    <!-- Descripción -->
    <section class="flex flex-col gap-2">
        <h3 class="text-lg font-semibold">Step 1: Initial document</h3>
        <p class="text-sm text-muted">
            Upload the initial resolution or document. The system will extract basic project information,
            which you can review and adjust before moving to the next step.
        </p>
    </section>

    <!-- Layout principal: upload + formulario -->
    <section class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Columna: Upload -->
        <div class="lg:col-span-1">
            <h4 class="text-sm font-semibold mb-2">Upload initial document (PDF)</h4>

            <FileUpload ContainerClass="w-full"
                        UploadText="Click to upload or drag & drop"
                        AcceptedTypes=".pdf,application/pdf"
                        MaxFileSizeMB="10"
                        AllowRemove="true"
                        IsDisabled="@IsBusy"
                        ShowProgress="false"
                        OnFileSelected="HandleFileSelected" />

            <p class="mt-2 text-xs text-muted">
                Supported format: PDF. Maximum size: 10 MB.
            </p>
        </div>

        <!-- Columna: Campos extraídos -->
        <div class="lg:col-span-2">
            <h4 class="text-sm font-semibold mb-3">Extracted data (editable)</h4>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <!-- Document type (selector) -->
                <div class="flex flex-col gap-1">
                    <label class="text-xs font-medium text-foreground">Document type</label>
                    <select class="border border-border rounded px-2 py-1 text-sm bg-background"
                            disabled="@IsBusy"
                            value="@ResolutionModel.documentTypeId"
                            @onchange="HandleDocumentTypeChanged">
                        <option value="0">Select a document type...</option>

                        @if (DocumentTypeOptions is not null)
                        {
                            @foreach (var item in DocumentTypeOptions)
                            {
                                <!-- TODO: Ajusta 'Id' y 'Name' a las propiedades reales de tu KeyValueItemDTO -->
                                <option value="@item.Id">@item.Name</option>
                            }
                        }
                    </select>
                </div>

                <!-- Resolution code -->
                <TextInput Label="Resolution code"
                           Value="@ResolutionModel.ResolutionCode"
                           ValueChanged="val => ResolutionModel.ResolutionCode = val"
                           Placeholder="E.g. RESOLUCIÓN No. XXX"
                           Disabled="@IsBusy" />

                <!-- Resolution header date -->
                <TextInput Label="Resolution header date"
                           Value="@GetResolutionHeaderDateText()"
                           ValueChanged="val => ResolutionModel.ResolutionHeaderDate = ParseDateFromInput(val)"
                           Placeholder="E.g. 01/01/2025"
                           Disabled="@IsBusy" />

                <!-- Meeting date -->
                <TextInput Label="Meeting date"
                           Value="@GetMeetingDateText()"
                           ValueChanged="val => ResolutionModel.MeetingDate = ParseDateFromInput(val)"
                           Placeholder="E.g. 15/01/2025"
                           Disabled="@IsBusy" />

                <!-- Execution start date -->
                <TextInput Label="Execution start date"
                           Value="@GetExecutionStartDateText()"
                           ValueChanged="val => ResolutionModel.ExecutionStartDate = ParseDateFromInput(val)"
                           Placeholder="E.g. 01/03/2025"
                           Disabled="@IsBusy" />

                <!-- Duration (months) -->
                <TextInput Label="Duration (months)"
                           Value="@ResolutionModel.Duration.ToString()"
                           ValueChanged="val => ResolutionModel.Duration = ParseIntOrDefault(val)"
                           Placeholder="E.g. 12"
                           Disabled="@IsBusy" />

                <!-- Budget (USD) -->
                <TextInput Label="Budget (USD)"
                           Value="@ResolutionModel.Budget.ToString()"
                           ValueChanged="val => ResolutionModel.Budget = ParseIntOrDefault(val)"
                           Placeholder="E.g. 8500"
                           Disabled="@IsBusy" />

                <!-- Main decision verb -->
                <TextInput Label="Main decision verb"
                           Value="@ResolutionModel.MainDecisionVerb"
                           ValueChanged="val => ResolutionModel.MainDecisionVerb = val"
                           Placeholder="E.g. APROBAR, AUTORIZAR..."
                           Disabled="@IsBusy"
                           HelpText="Main action verb used in the resolution (e.g. APROBAR, AUTORIZAR)." />
            </div>
        </div>
    </section>
</div>

@code {
    [Parameter] public ResolutionInfo ResolutionModel { get; set; } = new();
    [Parameter] public bool IsBusy { get; set; }

    // Catálogo recibido desde el padre
    [Parameter] public IReadOnlyList<KeyValueItemDTO> DocumentTypeOptions { get; set; } = Array.Empty<KeyValueItemDTO>();

    // Eventos hacia el Main
    [Parameter] public EventCallback<IBrowserFile> OnFileSelected { get; set; }
    [Parameter] public EventCallback OnNext { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private async Task HandleFileSelected(IBrowserFile file)
    {
        if (OnFileSelected.HasDelegate)
        {
            await OnFileSelected.InvokeAsync(file);
        }
    }

    private void HandleDocumentTypeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var id))
        {
            ResolutionModel.documentTypeId = id;
        }
        else
        {
            ResolutionModel.documentTypeId = 0;
        }
    }

    // ==========================
    // Helpers de fechas
    // ==========================

    private static DateTime? ParseDateFromInput(string? input)
    {
        if (string.IsNullOrWhiteSpace(input))
            return null;

        var culture = new CultureInfo("es-ES");

        // Intentar con formato dd/MM/yyyy
        if (DateTime.TryParseExact(input, "dd/MM/yyyy", culture,
                                   DateTimeStyles.None, out var exactDate))
        {
            return exactDate;
        }

        // Fallback a TryParse normal en es-ES
        if (DateTime.TryParse(input, culture, DateTimeStyles.None, out var parsed))
        {
            return parsed;
        }

        return null;
    }

    private string GetResolutionHeaderDateText()
    {
        var text = ResolutionModel.ResolutionHeaderDate.ToSpanishShortDate();
        return text == "-" ? string.Empty : text;
    }

    private string GetMeetingDateText()
    {
        var text = ResolutionModel.MeetingDate.ToSpanishShortDate();
        return text == "-" ? string.Empty : text;
    }

    private string GetExecutionStartDateText()
    {
        var text = ResolutionModel.ExecutionStartDate.ToSpanishShortDate();
        return text == "-" ? string.Empty : text;
    }

    // ==========================
    // Helpers numéricos
    // ==========================

    private static int ParseIntOrDefault(string? input, int defaultValue = 0)
    {
        if (int.TryParse(input, out var value))
            return value;

        return defaultValue;
    }
}
