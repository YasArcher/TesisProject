@using Microsoft.AspNetCore.Components
@using tesisproject.shared.DTOs.Algorithms.Response
@using tesisproject.shared.DTOs.Catalog.ObjectiveType.Response
@using tesisproject.shared.DTOs.Filters   @* KeyValueItemDTO *@

<div class="w-full flex flex-col gap-6">
    <!-- Descripción -->
    <section class="flex flex-col gap-2">
        <h3 class="text-lg font-semibold">Step 5: Objectives & activities</h3>
        <p class="text-sm text-muted">
            Review and adjust the objectives and their activities detected from the DIDE
            project form. These objectives will be stored as part of the project definition.
        </p>
    </section>

    <!-- Editor de objetivos y actividades -->
    <section class="mt-2">
        <h4 class="text-sm font-semibold mb-3">Objectives & activities</h4>

        <ObjectivesActivitiesEditor Objectives="DideModel.Objectives" />
        @* Si luego quieres usar ObjectiveTypeOptions aquí, solo hay que pasárselos al editor *@
    </section>
</div>

@code {
    [Parameter] public DideProjectFormInfo DideModel { get; set; } = new();

    [Parameter] public bool IsBusy { get; set; }

    // <<< ESTE ES EL QUE FALTABA >>>

    [Parameter] public IReadOnlyList<ObjectiveTypeListItemDTO> ObjectiveTypeOptions { get; set; } = Array.Empty<ObjectiveTypeListItemDTO>();

}
