@using tesisproject.frontend.SharedUI.Card
@using tesisproject.frontend.SharedUI.ActionButton
@inherits ComponentBase

<Card Tone="CardTone.Default"
      Class="bg-background border border-border rounded-2xl card-hover-primary transition-shadow">
    <CardHeader>
        <h3 class="text-lg font-semibold text-foreground">@Item.ProjectName</h3>

        <p class="text-sm text-muted">
            <span class="font-medium">State:</span> @Item.ProjectStateName •
            <span class="font-medium">Type:</span> @Item.ProjectTypeName
        </p>

        <p class="text-sm text-muted">
            <span class="font-medium">Group:</span> @Item.ProjectGroupName
        </p>
    </CardHeader>

    <CardBody>
        <div class="text-sm text-foreground grid grid-cols-2 gap-x-4 gap-y-1">
            <div>
                <span class="font-medium">Start:</span>
                @(Item.StartDate?.ToString("yyyy-MM-dd") ?? "N/A")
            </div>
            <div>
                <span class="font-medium">End:</span>
                @(Item.TentativeEndDate?.ToString("yyyy-MM-dd") ?? "N/A")
            </div>
            <div class="col-span-2">
                <span class="font-medium">Progress:</span>
                @(Item.ExecutionPercentage?.ToString("0.##") ?? "0")%
            </div>
        </div>
    </CardBody>

    <CardFooter>
        <div class="flex gap-2">
            <ActionButton Text="Open"
                          Intent="ButtonIntent.Accept"
                          Variant="ButtonVariant.Filled"
                          Size="ButtonSize.Sm"
                          Class="rounded-md"
                          Execute="@(() => OnOpen.InvokeAsync(Item))">
                <Icon>
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                    </svg>
                </Icon>
            </ActionButton>

            <ActionButton Text="Details"
                          Intent="ButtonIntent.Neutral"
                          Variant="ButtonVariant.Outline"
                          Size="ButtonSize.Sm"
                          Class="rounded-md"
                          Execute="@(() => OnShowDetails.InvokeAsync(Item))" />
        </div>
    </CardFooter>
</Card>