<div class="bg-white border border-gray-200 rounded-lg overflow-hidden hover:shadow-lg transition-shadow">
    <div class="p-4">
        <h3 class="text-lg font-semibold text-gray-900 mb-1">@Item.ProjectName</h3>
        <p class="text-sm text-gray-600 mb-2">
            <span class="font-medium">State:</span> @Item.ProjectStateName •
            <span class="font-medium">Type:</span> @Item.ProjectTypeName
        </p>
        <p class="text-sm text-gray-600 mb-2">
            <span class="font-medium">Group:</span> @Item.ProjectGroupName
        </p>

        <div class="text-sm text-gray-700 grid grid-cols-2 gap-x-4 gap-y-1 mb-3">
            <div><span class="font-medium">Start:</span> @(Item.StartDate?.ToString("yyyy-MM-dd") ?? "N/A")</div>
            <div><span class="font-medium">End:</span> @(Item.TentativeEndDate?.ToString("yyyy-MM-dd") ?? "N/A")</div>
            <div><span class="font-medium">Progress:</span> @(Item.ExecutionPercentage?.ToString("0.##") ?? "0")%</div>
        </div>

        <div class="flex gap-2">
            <a class="px-3 py-1 rounded-md bg-blue-600 text-white text-sm hover:bg-blue-700"
               href="@($"/projects/{Item.ProjectId}")">Open</a>
            <button class="px-3 py-1 rounded-md border text-sm hover:bg-gray-50">Details</button>
        </div>
    </div>
</div>
