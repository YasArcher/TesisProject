    private sealed class ProductDetailForEdit
    {
        public int ProductTypeId { get; set; }
        public string? Title { get; set; }
        public string? Description { get; set; }
        public List<ProductValueForEdit> Values { get; set; } = new();
    }

    private sealed class ProductValueForEdit
    {
        public int AttributeDefinitionId { get; set; }
        public string? Value { get; set; }
    }

    // Fallback: si aún no tienes endpoint de detalle, usa lo que viene en la lista (sin values)
    private ProductDetailForEdit? TryMapFromListItem(int productId)
    {
        var p = Products?.FirstOrDefault(x => x.Id == productId);
        if (p is null) return null;

        return new ProductDetailForEdit
        {
            ProductTypeId = p.ProductTypeId, // si tu ListItem no tiene ProductTypeId, quita esto y obliga endpoint detalle
            Title = p.Title,
            Description = p.Description,
            Values = new List<ProductValueForEdit>()
        };
    }

    private sealed class UiDesignField
    {
        public int AttributeDefinitionId { get; set; } // ProductAttributeDefinitionDetailDTO.Id
        public string Label { get; set; } = string.Empty; // ProductAttributeName
        public bool IsRequired { get; set; }
        public int DisplayOrder { get; set; }
        public ProductAttributeDataType DataType { get; set; } = ProductAttributeDataType.Text;
        public string? Unit { get; set; }
        public string DataTypeLabel { get; set; } = "Text";
    }

    private async Task OpenCreateProductModal()
    {
        _productModalOpen = true;
        _loadingModal = true;
        _savingProduct = false;
        _modalError = null;

        _selectedProductTypeId = 0;
        _title = string.Empty;
        _description = null;

        _design = null;
        _fieldValues.Clear();
        _designDefinitions.Clear();

        try
        {
            var typesRes = await ProductTypeService.GetListAsync(CancellationToken.None);
            if (!typesRes.Success || typesRes.Response is null)
            {
                _productTypes = new();
                _modalError = typesRes.Error ?? "Could not load product types.";
                return;
            }

            _productTypes = typesRes.Response
                .OrderBy(x => x.Name)
                .ToList();
        }
        catch (Exception ex)
        {
            _modalError = $"Error opening modal: {ex.Message}";
        }
        finally
        {
            _loadingModal = false;
            StateHasChanged();
        }
    }

    private void CloseCreateProductModal()
    {
        _productModalOpen = false;
        _modalError = null;
        _savingProduct = false;
        _loadingModal = false;

        _design = null;
        _fieldValues.Clear();
        _designDefinitions.Clear();
    }

    private async Task OnProductTypeChanged(ChangeEventArgs e)
    {
        _modalError = null;
        _design = null;
        _fieldValues.Clear();
        _designDefinitions.Clear();

        if (!int.TryParse(e.Value?.ToString(), out var typeId))
        {
            _selectedProductTypeId = 0;
            return;
        }

        _selectedProductTypeId = typeId;

        if (_selectedProductTypeId <= 0)
            return;

        _loadingModal = true;
        try
        {
            var designRes = await ProductTypeDesignService.GetByProductTypeIdAsync(_selectedProductTypeId, CancellationToken.None);
            if (!designRes.Success || designRes.Response is null)
            {
                _design = null;
                _modalError = designRes.Error ?? "Could not load product type template.";
                return;
            }

            _design = designRes.Response;

            if (_design.Definitions is not null && _design.Definitions.Count > 0)
            {
                foreach (var def in _design.Definitions.OrderBy(x => x.DisplayOrder))
                {
                    _designDefinitions.Add(new UiDesignField
                    {
                        AttributeDefinitionId = def.Id,
                        Label = def.ProductAttributeName,
                        IsRequired = def.IsRequired,
                        DisplayOrder = def.DisplayOrder,
                        DataType = def.DataType,
                        Unit = def.Unit,
                        DataTypeLabel = def.DataType switch
                        {
                            ProductAttributeDataType.Number => "Number",
                            ProductAttributeDataType.Date => "Date",
                            ProductAttributeDataType.Url => "Url",
                            _ => "Text"
                        }
                    });

                    if (!_fieldValues.ContainsKey(def.Id))
                        _fieldValues[def.Id] = null;
                }
            }
        }
        catch (Exception ex)
        {
            _modalError = $"Error loading template: {ex.Message}";
        }
        finally
        {
            _loadingModal = false;
            StateHasChanged();
        }
    }

    private string GetFieldValue(int attributeDefinitionId)
        => _fieldValues.TryGetValue(attributeDefinitionId, out var v) ? (v ?? string.Empty) : string.Empty;

    private void SetFieldValue(int attributeDefinitionId, string? value)
        => _fieldValues[attributeDefinitionId] = string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private async Task SaveProductAsync()
    {
        _modalError = null;

        if (ProjectId <= 0)
        {
            _modalError = "Invalid ProjectId.";
            return;
        }

        if (VisitId <= 0)
        {
            _modalError = "Invalid VisitId.";
            return;
        }

        if (_selectedProductTypeId <= 0)
        {
            _modalError = "Select product type.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_title))
        {
            _modalError = "Title is required.";
            return;
        }

        foreach (var req in _designDefinitions.Where(x => x.IsRequired))
        {
            var v = GetFieldValue(req.AttributeDefinitionId);
            if (string.IsNullOrWhiteSpace(v))
            {
                _modalError = $"Complete required field: {req.Label}.";
                return;
            }
        }

        _savingProduct = true;
        try
        {
            var values = new List<ProductValueUpsertDTO>();

            foreach (var f in _designDefinitions.OrderBy(x => x.DisplayOrder))
            {
                var val = GetFieldValue(f.AttributeDefinitionId);
                if (string.IsNullOrWhiteSpace(val))
                    continue;

                values.Add(new ProductValueUpsertDTO
                {
                    AttributeDefinitionId = f.AttributeDefinitionId,
                    Value = val
                });
            }

            var req = new ProductCreateRequestDTO
            {
                ProjectId = ProjectId,
                VisitId = VisitId,
                ProductTypeId = _selectedProductTypeId,
                Title = _title.Trim(),
                Description = string.IsNullOrWhiteSpace(_description) ? null : _description.Trim(),
                Values = values,
                AuthorUserIds = new List<int>()
            };

            var res = await ProductService.CreateAsync(req, CancellationToken.None);

            if (!res.Success)
            {
                Toast.ShowError(res.Error ?? "Could not create product.");
                return;
            }

            Toast.ShowSuccess("Product created successfully.");
            CloseCreateProductModal();

            if (OnProductCreated.HasDelegate)
                await OnProductCreated.InvokeAsync(VisitId);
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Error creating product: {ex.Message}");
        }
        finally
        {
            _savingProduct = false;
            StateHasChanged();
        }
    }
}