@using tesisproject.shared.DTOs.VisitIssues.Response
@using tesisproject.shared.Enums
@using tesisproject.frontend.SharedUI.ActionButton

<!-- Sección de Problemas/Observaciones -->
<div class="col-span-1 lg:col-span-2">
    <div class="border border-border rounded-lg p-4">
        <div class="flex items-center justify-between mb-3">
            <h4 class="text-base font-semibold text-foreground">
                Problemas y Observaciones
            </h4>
            <button type="button"
                    class="px-3 py-1.5 text-sm rounded-lg bg-primary text-white hover:opacity-90"
                    @onclick="() => OnAddIssue.InvokeAsync()">
                + Agregar
            </button>
        </div>

        @if (VisitIssues == null || !VisitIssues.Any())
        {
            <p class="text-sm text-muted text-center py-4">
                No hay problemas registrados para esta visita.
            </p>
        }
        else
        {
            <div class="space-y-3">
                @foreach (var issue in VisitIssues)
                {
                    <div class="border border-border rounded-lg p-3 hover:border-primary transition-colors">
                        <div class="flex items-start justify-between gap-3">
                            <div class="flex-1 min-w-0">
                                <!-- Estado -->
                                <div class="flex items-center gap-2 mb-2">
                                    <span class="@GetStatusBadgeClass(issue.Status)">
                                        @GetStatusText(issue.Status)
                                    </span>
                                    @if (issue.DueDate.HasValue)
                                    {
                                        <span class="text-xs text-muted">
                                            Vence: @issue.DueDate.Value.ToString("dd/MM/yyyy")
                                        </span>
                                    }
                                </div>

                                <!-- Descripción -->
                                <p class="text-sm text-foreground whitespace-pre-wrap">
                                    @issue.Description
                                </p>

                                <!-- Metadata -->
                                <div class="mt-2 flex items-center gap-3 text-xs text-muted">
                                    <span>Creado: @issue.CreatedAtUtc.ToString("dd/MM/yyyy HH:mm")</span>
                                    @if (issue.ResolvedDate.HasValue)
                                    {
                                        <span>Resuelto: @issue.ResolvedDate.Value.ToString("dd/MM/yyyy")</span>
                                    }
                                </div>
                            </div>

                            <!-- Acciones -->
                            <div class="flex items-center gap-1">
                                <ActionButton Execute="() => OnEditIssue.InvokeAsync((issue.VisitIssueId, issue))"
                                              Intent="ButtonIntent.Info"
                                              Variant="ButtonVariant.Ghost"
                                              Size="ButtonSize.Sm"
                                              Class="p-1.5 rounded hover:bg-primary/10 text-primary transition-colors">
                                    <Icon>
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                        </svg>
                                    </Icon>
                                </ActionButton>

                                <ActionButton Execute="() => OnDeleteIssue.InvokeAsync(issue.VisitIssueId)"
                                              Intent="ButtonIntent.Delete"
                                              Variant="ButtonVariant.Ghost"
                                              Size="ButtonSize.Sm"
                                              ConfirmBeforeExecute="true"
                                              ConfirmTitle="Confirmar eliminación"
                                              ConfirmMessage="@($"¿Estás seguro de eliminar este problema? Esta acción no se puede deshacer.\n\nProblema: {(string.IsNullOrEmpty(issue.Description) ? "Sin descripción" : (issue.Description.Length > 100 ? issue.Description.Substring(0, 100) + "..." : issue.Description))}")"
                                              ConfirmButtonText="Eliminar"
                                              CancelButtonText="Cancelar"
                                              Class="p-1.5 rounded hover:bg-error/10 text-error transition-colors">
                                    <Icon>
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                        </svg>
                                    </Icon>
                                </ActionButton>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    // ===== Parámetros para VisitIssues =====
    [Parameter] public IReadOnlyList<VisitIssueResponseDTO>? VisitIssues { get; set; }
    [Parameter] public EventCallback OnAddIssue { get; set; }
    [Parameter] public EventCallback<(int issueId, VisitIssueResponseDTO issue)> OnEditIssue { get; set; }
    [Parameter] public EventCallback<int> OnDeleteIssue { get; set; } // Solo issueId, confirmación integrada en ActionButton

    // ===== Helpers de presentación =====
    private string GetStatusBadgeClass(IssueStatus status)
    {
        return status switch
        {
            IssueStatus.Open => "px-2 py-0.5 text-xs font-medium rounded bg-yellow-100 text-yellow-800",
            IssueStatus.InProgress => "px-2 py-0.5 text-xs font-medium rounded bg-blue-100 text-blue-800",
            IssueStatus.Resolved => "px-2 py-0.5 text-xs font-medium rounded bg-green-100 text-green-800",
            _ => "px-2 py-0.5 text-xs font-medium rounded bg-gray-100 text-gray-800"
        };
    }

    private string GetStatusText(IssueStatus status)
    {
        return status switch
        {
            IssueStatus.Open => "Pendiente",
            IssueStatus.InProgress => "En Progreso",
            IssueStatus.Resolved => "Resuelto",
            _ => status.ToString()
        };
    }
}