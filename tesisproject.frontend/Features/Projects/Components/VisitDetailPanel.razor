@using tesisproject.frontend.SharedUI.ActionButton
@using tesisproject.frontend.SharedUI.ConfirmDialog
@using tesisproject.shared.DTOs.Visit.Response
@using tesisproject.shared.DTOs.VisitIssues.Response
@using tesisproject.shared.Enums
@using tesisproject.shared.DTOs.ProjectObjective.Response
@using tesisproject.shared.DTOs.ObjectiveActivity.Response

<div class="space-y-6">
    <!-- Header superior: Botón volver + Info visita -->
    <div class="flex items-center justify-between pb-4 border-b border-border px-5">
        <ActionButton Execute="OnBack"
                      Text="Back to visits"
                      Intent="ButtonIntent.Info"
                      Variant="ButtonVariant.Outline"
                      Size="ButtonSize.Md">
            <Icon>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5">
                    <path fill-rule="evenodd" d="M7.72 12.53a.75.75 0 0 1 0-1.06l7.5-7.5a.75.75 0 1 1 1.06 1.06L9.31 12l6.97 6.97a.75.75 0 1 1-1.06 1.06l-7.5-7.5Z" clip-rule="evenodd" />
                </svg>
            </Icon>
        </ActionButton>

        <div class="text-right">
            <span class="inline-flex items-center px-3 py-1 rounded-full bg-primary-subtle text-primary text-sm font-semibold">
                Visit #@VisitId
            </span>
        </div>
    </div>

    <!-- Sección de Objetivos del Proyecto -->
    @if (ProjectObjectives is not null && ProjectObjectives.Any())
    {
        <div class="bg-background border border-border rounded-xl shadow-sm">
            <div class="px-5 py-4 border-b border-border">
                <h3 class="text-lg font-bold text-foreground">
                    Project Objectives Progress
                </h3>
                <p class="text-sm text-muted mt-1">
                    Track and update the completion status of project objectives and activities
                </p>
            </div>
            <div class="p-5">
                <ProjectObjectivesProgress Objectives="ProjectObjectives"
                                           OnSaveRequested="HandleObjectivesSaveAsync" />
            </div>
        </div>
    }

    <!-- Sección de Problemas y Observaciones -->
    <div class="bg-background border border-border rounded-xl shadow-sm">
        <!-- Header de la sección -->
        <div class="px-5 py-4 border-b border-border">
            <div class="flex items-center justify-between">
                <div>
                    <h3 class="text-lg font-bold text-foreground">
                        Issues and Observations
                    </h3>
                    <p class="text-sm text-muted mt-1">
                        Document problems and observations encountered during the visit
                    </p>
                </div>

                <ActionButton Execute="OnAddIssue"
                              Text="Add Issue"
                              Intent="ButtonIntent.Add"
                              Variant="ButtonVariant.Filled"
                              Size="ButtonSize.Md">
                    <Icon>
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5">
                            <path fill-rule="evenodd" d="M12 3.75a.75.75 0 0 1 .75.75v6.75h6.75a.75.75 0 0 1 0 1.5h-6.75v6.75a.75.75 0 0 1-1.5 0v-6.75H4.5a.75.75 0 0 1 0-1.5h6.75V4.5a.75.75 0 0 1 .75-.75Z" clip-rule="evenodd" />
                        </svg>
                    </Icon>
                </ActionButton>
            </div>
        </div>

        <!-- Contenido: Lista de problemas -->
        <div class="p-5">
            @if (VisitIssues == null || !VisitIssues.Any())
            {
                <div class="text-center py-12 px-4">
                    <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-muted/10 mb-4">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-8 h-8 text-muted">
                            <path fill-rule="evenodd" d="M2.25 12c0-5.385 4.365-9.75 9.75-9.75s9.75 4.365 9.75 9.75-4.365 9.75-9.75 9.75S2.25 17.385 2.25 12ZM12 8.25a.75.75 0 0 1 .75.75v3.75a.75.75 0 0 1-1.5 0V9a.75.75 0 0 1 .75-.75Zm0 8.25a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Z" clip-rule="evenodd" />
                        </svg>
                    </div>
                    <p class="text-sm text-muted font-medium">
                        No issues recorded for this visit yet
                    </p>
                    <p class="text-xs text-muted mt-1">
                        Click "Add Issue" to document problems or observations
                    </p>
                </div>
            }
            else
            {
                <div class="space-y-4">
                    @foreach (var issue in VisitIssues)
                    {
                        <div class="border border-border rounded-lg bg-background hover:border-primary-light hover:shadow-sm transition-all duration-200">
                            <div class="p-4">
                                <div class="flex items-start justify-between gap-4">
                                    <!-- Contenido del problema -->
                                    <div class="flex-1 min-w-0 space-y-3">
                                        <!-- Descripción -->
                                        <div>
                                            <p class="text-sm text-foreground leading-relaxed whitespace-pre-wrap">
                                                @issue.Description
                                            </p>
                                        </div>

                                        <!-- Metadata del problema -->
                                        <div class="flex items-center gap-4 pt-2 border-t border-border/50">
                                            <div class="flex items-center gap-2 text-xs text-muted">
                                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4">
                                                    <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm.75-13a.75.75 0 0 0-1.5 0v5c0 .414.336.75.75.75h4a.75.75 0 0 0 0-1.5h-3.25V5Z" clip-rule="evenodd" />
                                                </svg>
                                                <span>Created: @issue.CreatedAtUtc.ToString("MMM dd, yyyy HH:mm")</span>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Acciones: Editar y Eliminar -->
                                    <div class="flex items-start gap-2 flex-shrink-0">
                                        <ActionButton Execute="() => OnEditIssue.InvokeAsync((issue.VisitIssueId, issue))"
                                                      Intent="ButtonIntent.Info"
                                                      Variant="ButtonVariant.Ghost"
                                                      Size="ButtonSize.Sm"
                                                      Class="p-2 rounded-lg hover:bg-primary-subtle text-primary transition-colors">
                                            <Icon>
                                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                                </svg>
                                            </Icon>
                                        </ActionButton>

                                        <ActionButton Execute="() => OnDeleteIssue.InvokeAsync(issue.VisitIssueId)"
                                                      Intent="ButtonIntent.Delete"
                                                      Variant="ButtonVariant.Ghost"
                                                      Size="ButtonSize.Sm"
                                                      ConfirmBeforeExecute="true"
                                                      ConfirmTitle="Confirm deletion"
                                                      ConfirmMessage="@($"Are you sure you want to delete this issue? This action cannot be undone.\n\nIssue: {(string.IsNullOrEmpty(issue.Description) ? "No description" : (issue.Description.Length > 100 ? issue.Description[..100] + "..." : issue.Description))}")"
                                                      ConfirmButtonText="Delete"
                                                      CancelButtonText="Cancel"
                                                      Class="p-2 rounded-lg hover:bg-error/10 text-error transition-colors">
                                            <Icon>
                                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1 1h-4a1 1 0 00-1 1v3M4 7h16" />
                                                </svg>
                                            </Icon>
                                        </ActionButton>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Footer con contador -->
                <div class="mt-4 pt-4 border-t border-border">
                    <div class="flex items-center justify-between text-xs text-muted">
                        <span>
                            Total issues: <span class="font-semibold text-foreground">@VisitIssues.Count</span>
                        </span>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    // ===== Parámetros para VisitIssues =====
    [Parameter] public IReadOnlyList<VisitIssueResponseDTO>? VisitIssues { get; set; }
    [Parameter] public EventCallback OnAddIssue { get; set; }
    [Parameter] public EventCallback<(int issueId, VisitIssueResponseDTO issue)> OnEditIssue { get; set; }
    [Parameter] public EventCallback<int> OnDeleteIssue { get; set; }
    [Parameter] public int ProjectId { get; set; }
    [Parameter] public int VisitId { get; set; }
    [Parameter] public VisitDetailResponseDTO Value { get; set; } = null!;
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public string? ErrorMessage { get; set; }
    [Parameter] public EventCallback OnBack { get; set; }
    [Parameter] public EventCallback<(int visitId, int newStateId)> OnChangeVisitState { get; set; }

    // ===== Objetivos del proyecto / actividades =====
    [Parameter]
    public IReadOnlyList<ProjectObjectiveWithActivitiesDTO> ProjectObjectives { get; set; }
        = Array.Empty<ProjectObjectiveWithActivitiesDTO>();

    [Parameter] public EventCallback<IEnumerable<ObjectiveActivityListItemDTO>> OnSaveObjectivesRequested { get; set; }

    private async Task HandleObjectivesSaveAsync(IEnumerable<ObjectiveActivityListItemDTO> activities)
    {
        if (OnSaveObjectivesRequested.HasDelegate)
        {
            await OnSaveObjectivesRequested.InvokeAsync(activities);
        }
    }

    // ===== Helpers de presentación =====
    private string GetStatusBadgeClass(IssueStatus status)
    {
        return status switch
        {
            IssueStatus.Open => "px-3 py-1 text-xs font-semibold rounded-full bg-accent/10 text-accent border border-accent/20",
            IssueStatus.InProgress => "px-3 py-1 text-xs font-semibold rounded-full bg-primary-subtle text-primary border border-primary-light",
            IssueStatus.Resolved => "px-3 py-1 text-xs font-semibold rounded-full bg-secondary-subtle text-secondary border border-secondary-light",
            _ => "px-3 py-1 text-xs font-semibold rounded-full bg-muted/10 text-muted border border-muted/20"
        };
    }

    private string GetStatusText(IssueStatus status)
    {
        return status switch
        {
            IssueStatus.Open => "Pending",
            IssueStatus.InProgress => "In Progress",
            IssueStatus.Resolved => "Resolved",
            _ => status.ToString()
        };
    }
}