@using tesisproject.frontend.Services.Interfaces
@using tesisproject.frontend.SharedUI.ActionButton
@using tesisproject.frontend.SharedUI.ConfirmDialog
@using tesisproject.shared.DTOs.Visit.Response
@using tesisproject.shared.DTOs.VisitIssues.Response
@using tesisproject.shared.Enums
@using tesisproject.shared.DTOs.ProjectObjective.Response
@using tesisproject.shared.DTOs.ObjectiveActivity.Response

@using tesisproject.shared.DTOs.Products.Product.Request
@using tesisproject.shared.DTOs.Products.Product.Response
@using tesisproject.shared.DTOs.Products.ProductTypeDesign.Response
@using tesisproject.shared.DTOs.Catalog.Common.Response

@inject NavigationManager Nav
@inject IToastService Toast
@inject IProductClientService ProductService
@inject IProductTypeClientService ProductTypeService
@inject IProductTypeDesignClientService ProductTypeDesignService

<div class="space-y-6">
    <!-- Header superior: Botón volver + Info visita -->
    <div class="flex items-center justify-between pb-4 border-b border-border px-5">
        <ActionButton Execute="OnBack"
                      Text="Back to visits"
                      Intent="ButtonIntent.Info"
                      Variant="ButtonVariant.Outline"
                      Size="ButtonSize.Md">
            <Icon>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5">
                    <path fill-rule="evenodd" d="M7.72 12.53a.75.75 0 0 1 0-1.06l7.5-7.5a.75.75 0 1 1 1.06 1.06L9.31 12l6.97 6.97a.75.75 0 1 1-1.06 1.06l-7.5-7.5Z" clip-rule="evenodd" />
                </svg>
            </Icon>
        </ActionButton>

        <div class="text-right">
            <span class="inline-flex items-center px-3 py-1 rounded-full bg-primary-subtle text-primary text-sm font-semibold">
                Visit #@VisitId
            </span>
        </div>
    </div>

    <!-- Sección de Objetivos del Proyecto -->
    @if (ProjectObjectives is not null && ProjectObjectives.Any())
    {
        <div class="bg-background border border-border rounded-xl shadow-sm">
            <div class="px-5 py-4 border-b border-border">
                <h3 class="text-lg font-bold text-foreground">
                    Project Objectives Progress
                </h3>
                <p class="text-sm text-muted mt-1">
                    Track and update the completion status of project objectives and activities
                </p>
            </div>
            <div class="p-5">
                <ProjectObjectivesProgress Objectives="ProjectObjectives"
                                           OnSaveRequested="HandleObjectivesSaveAsync" />
            </div>
        </div>
    }

    <!-- Sección de productos (solo de esta visita) -->
    <div class="bg-background border border-border rounded-xl shadow-sm">
        <div class="px-5 py-4 border-b border-border">
            <div class="flex items-center justify-between gap-3">
                <div>
                    <h3 class="text-lg font-bold text-foreground">
                        Products
                    </h3>
                    <p class="text-sm text-muted mt-1">
                        Products created for this visit
                    </p>
                </div>

                <ActionButton Execute="OpenCreateProductModal"
                              Text="Add Product"
                              Intent="ButtonIntent.Add"
                              Variant="ButtonVariant.Filled"
                              Size="ButtonSize.Md">
                    <Icon>
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5">
                            <path fill-rule="evenodd" d="M12 3.75a.75.75 0 0 1 .75.75v6.75h6.75a.75.75 0 0 1 0 1.5h-6.75v6.75a.75.75 0 0 1-1.5 0v-6.75H4.5a.75.75 0 0 1 0-1.5h6.75V4.5a.75.75 0 0 1 .75-.75Z" clip-rule="evenodd" />
                        </svg>
                    </Icon>
                </ActionButton>
            </div>
        </div>

        <div class="p-5">
            @if (!string.IsNullOrWhiteSpace(ProductsError))
            {
                <div class="rounded-xl border border-error/30 bg-error/10 p-3 text-sm text-error">
                    @ProductsError
                </div>
            }
            else if (IsLoadingProducts)
            {
                <div class="flex items-center gap-3 py-6">
                    <div class="w-6 h-6 border-4 border-primary border-t-transparent rounded-full animate-spin"></div>
                    <span class="text-sm text-muted">Loading products...</span>
                </div>
            }
            else if (Products is null || Products.Count == 0)
            {
                <div class="text-center py-12 px-4">
                    <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-muted/10 mb-4">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-8 h-8 text-muted">
                            <path fill-rule="evenodd" d="M2.25 12c0-5.385 4.365-9.75 9.75-9.75s9.75 4.365 9.75 9.75-4.365 9.75-9.75 9.75S2.25 17.385 2.25 12ZM12 8.25a.75.75 0 0 1 .75.75v3.75a.75.75 0 0 1-1.5 0V9a.75.75 0 0 1 .75-.75Zm0 8.25a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Z" clip-rule="evenodd" />
                        </svg>
                    </div>
                    <p class="text-sm text-muted font-medium">
                        No products created for this visit yet
                    </p>
                    <p class="text-xs text-muted mt-1">
                        Click "Add Product" to create one from templates
                    </p>
                </div>
            }
            else
            {
                <div class="space-y-3">
                    @foreach (var p in Products.OrderByDescending(x => x.CreatedAt))
                    {
                        <div class="border border-border rounded-lg bg-background hover:border-primary-light hover:shadow-sm transition-all duration-200">
                            <div class="p-4">
                                <div class="flex items-start justify-between gap-4">
                                    <div class="flex-1 min-w-0">
                                        <div class="flex items-center gap-2">
                                            <div class="font-semibold text-foreground truncate">@p.Title</div>
                                            <span class="inline-flex items-center px-2 py-0.5 text-xs font-semibold rounded-full bg-primary-subtle text-primary border border-primary/20">
                                                @p.ProductTypeName
                                            </span>
                                        </div>

                                        <div class="text-xs text-muted mt-1">
                                            Created: @p.CreatedAt.ToString("MMM dd, yyyy HH:mm")
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(p.Description))
                                        {
                                            <div class="text-sm text-foreground/90 mt-2 whitespace-pre-wrap">
                                                @p.Description
                                            </div>
                                        }
                                    </div>

                                    <div class="flex items-start gap-2 flex-shrink-0">
                                        <ActionButton Execute="@(() => OpenEditProductModal(p.Id))"
                                                      Text="Open"
                                                      Intent="ButtonIntent.Info"
                                                      Variant="ButtonVariant.Outline"
                                                      Size="ButtonSize.Sm" />

                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <div class="mt-4 pt-4 border-t border-border">
                    <div class="flex items-center justify-between text-xs text-muted">
                        <span>
                            Total products: <span class="font-semibold text-foreground">@Products.Count</span>
                        </span>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Sección de Problemas y Observaciones -->
    <div class="bg-background border border-border rounded-xl shadow-sm">
        <!-- Header de la sección -->
        <div class="px-5 py-4 border-b border-border">
            <div class="flex items-center justify-between">
                <div>
                    <h3 class="text-lg font-bold text-foreground">
                        Issues and Observations
                    </h3>
                    <p class="text-sm text-muted mt-1">
                        Document problems and observations encountered during the visit
                    </p>
                </div>

                <ActionButton Execute="OnAddIssue"
                              Text="Add Issue"
                              Intent="ButtonIntent.Add"
                              Variant="ButtonVariant.Filled"
                              Size="ButtonSize.Md">
                    <Icon>
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5">
                            <path fill-rule="evenodd" d="M12 3.75a.75.75 0 0 1 .75.75v6.75h6.75a.75.75 0 0 1 0 1.5h-6.75v6.75a.75.75 0 0 1-1.5 0v-6.75H4.5a.75.75 0 0 1 0-1.5h6.75V4.5a.75.75 0 0 1 .75-.75Z" clip-rule="evenodd" />
                        </svg>
                    </Icon>
                </ActionButton>
            </div>
        </div>

        <!-- Contenido: Lista de problemas -->
        <div class="p-5">
            @if (VisitIssues == null || !VisitIssues.Any())
            {
                <div class="text-center py-12 px-4">
                    <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-muted/10 mb-4">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-8 h-8 text-muted">
                            <path fill-rule="evenodd" d="M2.25 12c0-5.385 4.365-9.75 9.75-9.75s9.75 4.365 9.75 9.75-4.365 9.75-9.75 9.75S2.25 17.385 2.25 12ZM12 8.25a.75.75 0 0 1 .75.75v3.75a.75.75 0 0 1-1.5 0V9a.75.75 0 0 1 .75-.75Zm0 8.25a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Z" clip-rule="evenodd" />
                        </svg>
                    </div>
                    <p class="text-sm text-muted font-medium">
                        No issues recorded for this visit yet
                    </p>
                    <p class="text-xs text-muted mt-1">
                        Click "Add Issue" to document problems or observations
                    </p>
                </div>
            }
            else
            {
                <div class="space-y-4">
                    @foreach (var issue in VisitIssues)
                    {
                        <div class="border border-border rounded-lg bg-background hover:border-primary-light hover:shadow-sm transition-all duration-200">
                            <div class="p-4">
                                <div class="flex items-start justify-between gap-4">
                                    <!-- Contenido del problema -->
                                    <div class="flex-1 min-w-0 space-y-3">
                                        <!-- Descripción -->
                                        <div>
                                            <p class="text-sm text-foreground leading-relaxed whitespace-pre-wrap">
                                                @issue.Description
                                            </p>
                                        </div>

                                        <!-- Metadata del problema -->
                                        <div class="flex items-center gap-4 pt-2 border-t border-border/50">
                                            <div class="flex items-center gap-2 text-xs text-muted">
                                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4">
                                                    <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm.75-13a.75.75 0 0 0-1.5 0v5c0 .414.336.75.75.75h4a.75.75 0 0 0 0-1.5h-3.25V5Z" clip-rule="evenodd" />
                                                </svg>
                                                <span>Created: @issue.CreatedAtUtc.ToString("MMM dd, yyyy HH:mm")</span>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Acciones: Editar y Eliminar -->
                                    <div class="flex items-start gap-2 flex-shrink-0">
                                        <ActionButton Execute="() => OnEditIssue.InvokeAsync((issue.VisitIssueId, issue))"
                                                      Intent="ButtonIntent.Info"
                                                      Variant="ButtonVariant.Ghost"
                                                      Size="ButtonSize.Sm"
                                                      Class="p-2 rounded-lg hover:bg-primary-subtle text-primary transition-colors">
                                            <Icon>
                                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                                </svg>
                                            </Icon>
                                        </ActionButton>

                                        <ActionButton Execute="() => OnDeleteIssue.InvokeAsync(issue.VisitIssueId)"
                                                      Intent="ButtonIntent.Delete"
                                                      Variant="ButtonVariant.Ghost"
                                                      Size="ButtonSize.Sm"
                                                      ConfirmBeforeExecute="true"
                                                      ConfirmTitle="Confirm deletion"
                                                      ConfirmMessage="@($"Are you sure you want to delete this issue? This action cannot be undone.\n\nIssue: {(string.IsNullOrEmpty(issue.Description) ? "No description" : (issue.Description.Length > 100 ? issue.Description[..100] + "..." : issue.Description))}")"
                                                      ConfirmButtonText="Delete"
                                                      CancelButtonText="Cancel"
                                                      Class="p-2 rounded-lg hover:bg-error/10 text-error transition-colors">
                                            <Icon>
                                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1 1h-4a1 1 0 00-1 1v3M4 7h16" />
                                                </svg>
                                            </Icon>
                                        </ActionButton>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Footer con contador -->
                <div class="mt-4 pt-4 border-t border-border">
                    <div class="flex items-center justify-between text-xs text-muted">
                        <span>
                            Total issues: <span class="font-semibold text-foreground">@VisitIssues.Count</span>
                        </span>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
@* ===================== modal editar producto ===================== *@
@if (_editProductModalOpen)
{
    <div class="fixed inset-0 z-50">
        <div class="absolute inset-0 bg-black/50" @onclick="CloseEditProductModal"></div>

        <div class="absolute inset-0 flex items-center justify-center p-4">
            <div class="w-full max-w-3xl rounded-2xl border border-border bg-background shadow-xl overflow-hidden">
                <div class="p-5 border-b border-border flex items-start justify-between gap-3">
                    <div class="min-w-0">
                        <div class="text-lg font-semibold text-foreground">Edit product</div>
                        <div class="text-sm text-muted">
                            Project #@ProjectId · Visit #@VisitId · Product #@_editingProductId
                        </div>
                    </div>

                    <button class="text-muted hover:text-foreground" @onclick="CloseEditProductModal" title="Close">
                        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                    </button>
                </div>

                <div class="p-5 space-y-4 max-h-[70vh] overflow-y-auto">
                    @if (_loadingEditModal)
                    {
                        <div class="flex items-center gap-3 py-6">
                            <div class="w-6 h-6 border-4 border-primary border-t-transparent rounded-full animate-spin"></div>
                            <span class="text-sm text-muted">Loading product...</span>
                        </div>
                    }
                    else
                    {
                        @if (!string.IsNullOrWhiteSpace(_editModalError))
                        {
                            <div class="rounded-xl border border-error/30 bg-error/10 p-3 text-sm text-error">
                                @_editModalError
                            </div>
                        }

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                            <div>
                                <label class="block text-sm font-medium text-foreground mb-1">Product type</label>
                                <select class="w-full rounded-xl border border-border bg-background px-3 py-2 text-sm"
                                        disabled
                                        value="@_editSelectedProductTypeId">
                                    @foreach (var t in _productTypes)
                                    {
                                        <option value="@t.Id">@t.Name</option>
                                    }
                                </select>
                                <div class="text-xs text-muted mt-1">
                                    Product type is locked for existing products.
                                </div>
                            </div>

                            <div>
                                <label class="block text-sm font-medium text-foreground mb-1">Title</label>
                                <input class="w-full rounded-xl border border-border bg-background px-3 py-2 text-sm"
                                       @bind="_editTitle" />
                            </div>
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-foreground mb-1">Description (optional)</label>
                            <textarea class="w-full rounded-xl border border-border bg-background px-3 py-2 text-sm min-h-[90px]"
                                      @bind="_editDescription"></textarea>
                        </div>

                        @if (_editDesign is not null && _editDesignDefinitions.Count > 0)
                        {
                            <div class="pt-2">
                                <div class="text-sm font-semibold text-foreground mb-2">Template fields</div>

                                <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                                    @foreach (var def in _editDesignDefinitions)
                                    {
                                        <div class="rounded-xl border border-border p-3">
                                            <div class="flex items-center justify-between gap-2">
                                                <div class="text-sm font-medium text-foreground truncate" title="@def.Label">
                                                    @def.Label
                                                </div>
                                                @if (def.IsRequired)
                                                {
                                                    <span class="text-xs px-2 py-0.5 rounded-full border border-error/30 bg-error/10 text-error">Required</span>
                                                }
                                            </div>

                                            <div class="text-xs text-muted mt-1">
                                                @def.DataTypeLabel
                                            </div>

                                            <div class="mt-2">
                                                @if (def.DataType == ProductAttributeDataType.Date)
                                                {
                                                    <input type="date"
                                                           class="w-full rounded-xl border border-border bg-background px-3 py-2 text-sm"
                                                           value="@GetEditFieldValue(def.AttributeDefinitionId)"
                                                           @onchange="(e) => SetEditFieldValue(def.AttributeDefinitionId, e.Value?.ToString())" />
                                                }
                                                else if (def.DataType == ProductAttributeDataType.Number)
                                                {
                                                    <input type="number" step="any"
                                                           class="w-full rounded-xl border border-border bg-background px-3 py-2 text-sm"
                                                           value="@GetEditFieldValue(def.AttributeDefinitionId)"
                                                           @onchange="(e) => SetEditFieldValue(def.AttributeDefinitionId, e.Value?.ToString())" />
                                                }
                                                else if (def.DataType == ProductAttributeDataType.Url)
                                                {
                                                    <input type="url"
                                                           class="w-full rounded-xl border border-border bg-background px-3 py-2 text-sm"
                                                           value="@GetEditFieldValue(def.AttributeDefinitionId)"
                                                           @onchange="(e) => SetEditFieldValue(def.AttributeDefinitionId, e.Value?.ToString())" />
                                                }
                                                else
                                                {
                                                    <input type="text"
                                                           class="w-full rounded-xl border border-border bg-background px-3 py-2 text-sm"
                                                           value="@GetEditFieldValue(def.AttributeDefinitionId)"
                                                           @onchange="(e) => SetEditFieldValue(def.AttributeDefinitionId, e.Value?.ToString())" />
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="rounded-xl border border-border bg-muted/10 p-3 text-sm text-muted">
                                No template fields found for this product type.
                            </div>
                        }
                    }
                </div>

                <div class="p-5 border-t border-border flex items-center justify-end gap-2">
                    <ActionButton Text="Cancel"
                                  Intent="ButtonIntent.Neutral"
                                  Variant="ButtonVariant.Outline"
                                  Size="ButtonSize.Sm"
                                  Execute="CloseEditProductModal" />

                    <ActionButton Text="@(_savingEditProduct ? "Saving..." : "Save changes")"
                                  Intent="ButtonIntent.Add"
                                  Variant="ButtonVariant.Outline"
                                  Size="ButtonSize.Sm"
                                  IsDisabled="@_savingEditProduct"
                                  Execute="SaveEditedProductAsync" />
                </div>
            </div>
        </div>
    </div>
}

@* ===================== modal crear producto (dentro del detail) ===================== *@
@if (_productModalOpen)
{
    <div class="fixed inset-0 z-50">
        <div class="absolute inset-0 bg-black/50" @onclick="CloseCreateProductModal"></div>

        <div class="absolute inset-0 flex items-center justify-center p-4">
            <div class="w-full max-w-3xl rounded-2xl border border-border bg-background shadow-xl overflow-hidden">
                <div class="p-5 border-b border-border flex items-start justify-between gap-3">
                    <div class="min-w-0">
                        <div class="text-lg font-semibold text-foreground">Create product</div>
                        <div class="text-sm text-muted">
                            Project #@ProjectId · Visit #@VisitId
                        </div>
                    </div>

                    <button class="text-muted hover:text-foreground" @onclick="CloseCreateProductModal" title="Close">
                        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                    </button>
                </div>

                <div class="p-5 space-y-4 max-h-[70vh] overflow-y-auto">
                    @if (_loadingModal)
                    {
                        <div class="flex items-center gap-3 py-6">
                            <div class="w-6 h-6 border-4 border-primary border-t-transparent rounded-full animate-spin"></div>
                            <span class="text-sm text-muted">Loading template...</span>
                        </div>
                    }
                    else
                    {
                        @if (!string.IsNullOrWhiteSpace(_modalError))
                        {
                            <div class="rounded-xl border border-error/30 bg-error/10 p-3 text-sm text-error">
                                @_modalError
                            </div>
                        }

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                            <div>
                                <label class="block text-sm font-medium text-foreground mb-1">Product type</label>
                                <select class="w-full rounded-xl border border-border bg-background px-3 py-2 text-sm"
                                        @onchange="OnProductTypeChanged"
                                        value="@_selectedProductTypeId">
                                    <option value="0">-- Select --</option>
                                    @foreach (var t in _productTypes)
                                    {
                                        <option value="@t.Id">@t.Name</option>
                                    }
                                </select>
                            </div>

                            <div>
                                <label class="block text-sm font-medium text-foreground mb-1">Title</label>
                                <input class="w-full rounded-xl border border-border bg-background px-3 py-2 text-sm"
                                       placeholder="e.g. Article, paper, chapter..."
                                       @bind="_title" />
                            </div>
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-foreground mb-1">Description (optional)</label>
                            <textarea class="w-full rounded-xl border border-border bg-background px-3 py-2 text-sm min-h-[90px]"
                                      placeholder="Short description..."
                                      @bind="_description"></textarea>
                        </div>

                        @if (_design is not null && _designDefinitions.Count > 0)
                        {
                            <div class="pt-2">
                                <div class="text-sm font-semibold text-foreground mb-2">Template fields</div>

                                <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                                    @foreach (var def in _designDefinitions)
                                    {
                                        <div class="rounded-xl border border-border p-3">
                                            <div class="flex items-center justify-between gap-2">
                                                <div class="text-sm font-medium text-foreground truncate" title="@def.Label">
                                                    @def.Label
                                                </div>
                                                @if (def.IsRequired)
                                                {
                                                    <span class="text-xs px-2 py-0.5 rounded-full border border-error/30 bg-error/10 text-error">Required</span>
                                                }
                                            </div>

                                            <div class="text-xs text-muted mt-1">
                                                @def.DataTypeLabel
                                            </div>

                                            <div class="mt-2">
                                                @if (def.DataType == ProductAttributeDataType.Date)
                                                {
                                                    <input type="date"
                                                           class="w-full rounded-xl border border-border bg-background px-3 py-2 text-sm"
                                                           value="@GetFieldValue(def.AttributeDefinitionId)"
                                                           @onchange="(e) => SetFieldValue(def.AttributeDefinitionId, e.Value?.ToString())" />
                                                }
                                                else if (def.DataType == ProductAttributeDataType.Number)
                                                {
                                                    <input type="number" step="any"
                                                           class="w-full rounded-xl border border-border bg-background px-3 py-2 text-sm"
                                                           value="@GetFieldValue(def.AttributeDefinitionId)"
                                                           @onchange="(e) => SetFieldValue(def.AttributeDefinitionId, e.Value?.ToString())" />
                                                }
                                                else if (def.DataType == ProductAttributeDataType.Url)
                                                {
                                                    <input type="url"
                                                           class="w-full rounded-xl border border-border bg-background px-3 py-2 text-sm"
                                                           placeholder="https://..."
                                                           value="@GetFieldValue(def.AttributeDefinitionId)"
                                                           @onchange="(e) => SetFieldValue(def.AttributeDefinitionId, e.Value?.ToString())" />
                                                }
                                                else
                                                {
                                                    <input type="text"
                                                           class="w-full rounded-xl border border-border bg-background px-3 py-2 text-sm"
                                                           value="@GetFieldValue(def.AttributeDefinitionId)"
                                                           @onchange="(e) => SetFieldValue(def.AttributeDefinitionId, e.Value?.ToString())" />
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                        else if (_selectedProductTypeId > 0)
                        {
                            <div class="rounded-xl border border-border bg-muted/10 p-3 text-sm text-muted">
                                This type has no template fields (or template returned no definitions).
                            </div>
                        }
                    }
                </div>

                <div class="p-5 border-t border-border flex items-center justify-end gap-2">
                    <ActionButton Text="Cancel"
                                  Intent="ButtonIntent.Neutral"
                                  Variant="ButtonVariant.Outline"
                                  Size="ButtonSize.Sm"
                                  Execute="CloseCreateProductModal" />

                    <ActionButton Text="@(_savingProduct ? "Saving..." : "Save product")"
                                  Intent="ButtonIntent.Add"
                                  Variant="ButtonVariant.Outline"
                                  Size="ButtonSize.Sm"
                                  IsDisabled="@_savingProduct"
                                  Execute="SaveProductAsync" />
                </div>
            </div>
        </div>
    </div>
}

