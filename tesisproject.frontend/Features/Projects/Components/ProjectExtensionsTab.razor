@using tesisproject.shared.DTOs.Catalog.Common.Response
@using tesisproject.shared.DTOs.ProjectExtensions.Response
@using tesisproject.frontend.SharedUI.ActionButton

<div class="space-y-4">
    <div class="flex justify-between items-center">
        <h3 class="text-base font-semibold">Prórrogas</h3>

        <ActionButton Text="Generar prórroga"
                      Intent="ButtonIntent.Warning"
                      Variant="ButtonVariant.Outline"
                      Size="ButtonSize.Sm"
                      Execute="OnRequestNew">
            <Icon>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6">
                    <path fill-rule="evenodd" d="M12 2.25c-5.385 0-9.75 4.365-9.75 9.75s4.365 9.75 9.75 9.75 9.75-4.365 9.75-9.75S17.385 2.25 12 2.25ZM12.75 9a.75.75 0 0 0-1.5 0v2.25H9a.75.75 0 0 0 0 1.5h2.25V15a.75.75 0 0 0 1.5 0v-2.25H15a.75.75 0 0 0 0-1.5h-2.25V9Z" clip-rule="evenodd" />
                </svg>
            </Icon>
        </ActionButton>
    </div>

    @if (IsLoading)
    {
        <div class="text-sm text-muted">Cargando prórrogas…</div>
    }
    else if (Items?.Count == 0)
    {
        <div class="text-sm text-muted">No hay prórrogas registradas.</div>
    }
    else
    {
        <div class="grid gap-3">
            @foreach (var e in Items)
            {
                <div class="rounded-lg border p-3 flex items-center justify-between card-hover-primary">
                    <div class="min-w-0">
                        <div class="font-medium truncate">
                            Prórroga #@e.ProjectExtensionId
                            <span class="mx-2 text-muted">•</span>
                            <span class="inline-flex items-center px-2 py-0.5 text-xs rounded-full bg-primary-subtle text-primary border border-primary/20">
                                @e.ProjectExtensionTypeName
                            </span>
                        </div>

                        <div class="text-sm text-muted">
                            Proyecto: <span class="font-medium">@e.ProjectName</span>
                            <span class="mx-2">•</span>
                            Solicitado: @(e.RequestedAt?.ToString("yyyy-MM-dd") ?? "-")
                            @if (e.ApprovedAt is not null)
                            {
                                <span class="mx-2">•</span>
                                <span>Aprobado: @e.ApprovedAt?.ToString("yyyy-MM-dd")</span>
                            }
                        </div>

                        @if (!string.IsNullOrWhiteSpace(e.DocumentName))
                        {
                            <div class="text-xs text-muted mt-1">
                                Documento: @e.DocumentName
                            </div>
                        }
                    </div>

                    <div class="flex gap-2 shrink-0">
                        <ActionButton Text="Abrir"
                                      Intent="ButtonIntent.Neutral"
                                      Variant="ButtonVariant.Outline"
                                      Size="ButtonSize.Sm"
                                      Execute="@(() => OnOpen.InvokeAsync(e.ProjectExtensionId))" />
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public List<CatalogListItemDTO> ExtensionTypes { get; set; } = new();
    [Parameter] public List<ProjectExtensionListResponseDTO>? Items { get; set; }
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public EventCallback OnRequestNew { get; set; }
    [Parameter] public EventCallback<int> OnOpen { get; set; }
}