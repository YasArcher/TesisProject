@* Features/Projects/Components/ProjectCertificationModal.razor *@
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@using tesisproject.shared.DTOs.Budgets.Request

@if (IsOpen)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/40">
        <EditForm Model="_model" OnValidSubmit="HandleSubmit">
            <DataAnnotationsValidator />
            <div class="w-full max-w-lg rounded-xl bg-white shadow-lg border">
                <!-- Header -->
                <div class="px-4 py-3 border-b flex items-center justify-between">
                    <h3 class="text-base font-semibold">Nueva certificación</h3>
                    <button type="button"
                            class="text-sm px-2 py-1 rounded hover:bg-gray-100"
                            @onclick="Close"
                            disabled="@IsSaving">
                        ✕
                    </button>
                </div>

                <!-- Body -->
                <div class="p-4 space-y-4">
                    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
                    {
                        <div class="text-sm text-red-600">@ErrorMessage</div>
                    }

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                        <!-- Monto -->
                        <div class="space-y-1">
                            <label class="text-xs font-medium">Monto *</label>
                            <InputNumber @bind-Value="_model.Amount"
                                         class="w-full rounded-md border px-3 py-2 text-sm"
                                         disabled="@IsSaving" />
                            <ValidationMessage For="@(() => _model.Amount)" />
                        </div>

                        <!-- Fecha certificación -->
                        <div class="space-y-1">
                            <label class="text-xs font-medium">Fecha certificación</label>
                            <InputDate @bind-Value="_model.CertifiedAt"
                                       class="w-full rounded-md border px-3 py-2 text-sm"
                                       disabled="@IsSaving" />
                            <small class="text-xs text-muted">Vacío = hoy (UTC)</small>
                        </div>
                    </div>

                    <!-- Partida -->
                    <div class="space-y-1">
                        <label class="text-xs font-medium">Partida presupuestaria *</label>
                        <InputText @bind-Value="_model.BudgetItem"
                                   class="w-full rounded-md border px-3 py-2 text-sm"
                                   disabled="@IsSaving" />
                        <ValidationMessage For="@(() => _model.BudgetItem)" />
                    </div>

                    <!-- CUR (opcional) -->
                    <div class="space-y-1">
                        <label class="text-xs font-medium">CUR (opcional)</label>
                        <InputText @bind-Value="_model.CURNumber"
                                   class="w-full rounded-md border px-3 py-2 text-sm"
                                   disabled="@IsSaving" />
                    </div>
                </div>

                <!-- Footer -->
                <div class="px-4 py-3 border-t flex justify-end gap-2">
                    <button type="button"
                            class="px-3 py-2 rounded-md border text-sm hover:bg-gray-50"
                            @onclick="Close"
                            disabled="@IsSaving">
                        Cancelar
                    </button>

                    <button type="submit"
                            class="px-3 py-2 rounded-md text-sm text-white"
                            disabled="@IsSaving"
                            style="background-color: var(--color-primary);">
                        @(IsSaving ? "Guardando..." : "Guardar certificación")
                    </button>
                </div>
            </div>
        </EditForm>
    </div>
}

@code {
    // ===== Parámetros (controlados por el padre) =====
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }

    // Para inicializar el modelo sin que el modal haga lógica externa
    [Parameter] public int BudgetId { get; set; }
    [Parameter] public int CertifiedByUserId { get; set; }

    // Estado visual controlado por el padre
    [Parameter] public bool IsSaving { get; set; } = false;
    [Parameter] public string? ErrorMessage { get; set; }

    // Si el padre quiere “prellenar” algo (opcional)
    [Parameter] public AddCertificationRequestDTO? Value { get; set; }

    // Evento al guardar (el padre recibirá el DTO y hará la lógica)
    [Parameter] public EventCallback<AddCertificationRequestDTO> OnSubmit { get; set; }

    // Evento al cerrar/cancelar
    [Parameter] public EventCallback OnCancel { get; set; }

    // ===== Estado interno del modal (solo UI) =====
    private AddCertificationRequestDTO _model = new();

    protected override void OnParametersSet()
    {
        if (IsOpen)
        {
            // Si el padre pasa un Value, úsalo; si no, inicializa uno nuevo
            _model = Value is not null
                ? new AddCertificationRequestDTO
                {
                    BudgetId = Value.BudgetId,
                    Amount = Value.Amount,
                    BudgetItem = Value.BudgetItem,
                    CURNumber = Value.CURNumber,
                    CertifiedAt = Value.CertifiedAt,
                    CertifiedByUserId = Value.CertifiedByUserId
                }
                : new AddCertificationRequestDTO
                {
                    BudgetId = BudgetId,
                    CertifiedByUserId = CertifiedByUserId,
                    // Deja null para que el backend asigne hoy (UTC) si así lo deseas
                    CertifiedAt = null
                };
        }
    }

    private async Task HandleSubmit()
    {
        if (OnSubmit.HasDelegate)
            await OnSubmit.InvokeAsync(_model);
    }

    private async Task Close()
    {
        if (OnCancel.HasDelegate)
            await OnCancel.InvokeAsync();

        if (IsOpenChanged.HasDelegate)
            await IsOpenChanged.InvokeAsync(false);
    }
}
