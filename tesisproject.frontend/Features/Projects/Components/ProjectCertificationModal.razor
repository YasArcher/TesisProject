@* Features/Projects/Components/ProjectCertificationModal.razor *@
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@using tesisproject.shared.DTOs.Budgets.Request
@using tesisproject.frontend.SharedUI.Modal
@using tesisproject.frontend.SharedUI.ActionButton
@using tesisproject.frontend.SharedUI.TextInput
@using tesisproject.frontend.SharedUI.DateInput

<Modal Id="CertificationModal"
       Title="Nueva certificación"
       IsOpen="@IsOpen"
       ShowCloseButton="true"
       CloseOnBackdrop="true"
       CloseOnEscape="true"
       Size="ModalSize.Md"
       OnClose="Close"
       IsOpenChanged="IsOpenChanged">

    <ChildContent>
        <EditForm EditContext="_editContext">
            <DataAnnotationsValidator />

            @if (!string.IsNullOrWhiteSpace(ErrorMessage))
            {
                <div class="mb-3 text-sm text-error">@ErrorMessage</div>
            }

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <!-- Monto (*) -->
                <div>
                    <label class="block text-sm font-medium text-foreground mb-1">Monto *</label>
                    <InputNumber @bind-Value="_model.Amount"
                                 class="w-full rounded-md border border-border px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary disabled:opacity-60"
                                 disabled="@IsSaving" />
                    <ValidationMessage For="@(() => _model.Amount)" />
                </div>

                <!-- Fecha certificación -->
                <div>
                    <DateInput Label="Fecha certificación"
                               Value="@_certifiedDate"
                               ValueChanged="OnCertifiedDateChanged"
                               Disabled="@IsSaving" />
                    <p class="mt-1 text-xs text-muted">Vacío = hoy (UTC)</p>
                </div>
            </div>

            <!-- Partida presupuestaria (*) -->
            <div class="mt-4">
                <TextInput Label="Partida presupuestaria"
                           Placeholder="Ej.: 510201 "
                           Value="@_model.BudgetItem"
                           ValueChanged="(v => _model.BudgetItem = v ?? string.Empty)"
                           For="@(() => _model.BudgetItem)"
                           Required="true"
                           MaxLength="120"
                           Disabled="@IsSaving"
                           InputType="number" />
                <ValidationMessage For="@(() => _model.BudgetItem)" />
            </div>

            <!-- CUR (opcional) -->
            <div class="mt-4">
                <TextInput Label="CUR (opcional)"
                           Placeholder="Ej.: 120-2025-000123"
                           Value="@_model.CURNumber"
                           ValueChanged="(v => _model.CURNumber = v)"
                           For="@(() => _model.CURNumber)"
                           MaxLength="50"
                           Disabled="@IsSaving" />
            </div>
        </EditForm>
    </ChildContent>

    <Footer>
        <div class="flex justify-end gap-2">
            <ActionButton Text="Cancelar"
                          Variant="ButtonVariant.Ghost"
                          Intent="ButtonIntent.Neutral"
                          Size="ButtonSize.Sm"
                          Disabled="@IsSaving"
                          Execute="Close"
                          Class="btn-primary-ghost" />

            <ActionButton Text="@(IsSaving ? "Guardando..." : "Guardar certificación")"
                          Variant="ButtonVariant.Filled"
                          Intent="ButtonIntent.Accept"
                          Size="ButtonSize.Sm"
                          Disabled="@IsSaving"
                          Execute="OnSaveClick"
                          Class="btn-primary-solid" />
        </div>
    </Footer>
</Modal>

@code {
    // Parámetros
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public int BudgetId { get; set; }
    [Parameter] public int CertifiedByUserId { get; set; }
    [Parameter] public bool IsSaving { get; set; } = false;
    [Parameter] public string? ErrorMessage { get; set; }
    [Parameter] public AddCertificationRequestDTO? Value { get; set; }
    [Parameter] public EventCallback<AddCertificationRequestDTO> OnSubmit { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private AddCertificationRequestDTO _model = new();
    private EditContext _editContext = default!;

    // DateInput: propiedad local
    private DateOnly? _certifiedDate;

    protected override void OnParametersSet()
    {
        if (IsOpen)
        {
            _model = Value is not null
                ? new AddCertificationRequestDTO
                {
                    BudgetId = Value.BudgetId,
                    Amount = Value.Amount,
                    BudgetItem = Value.BudgetItem,
                    CURNumber = Value.CURNumber,
                    CertifiedAt = Value.CertifiedAt,
                    CertifiedByUserId = Value.CertifiedByUserId
                }
                : new AddCertificationRequestDTO
                {
                    BudgetId = BudgetId,
                    CertifiedByUserId = CertifiedByUserId,
                    CertifiedAt = null
                };

            // DTO(DateTime?) -> UI(DateOnly?)
            _certifiedDate = _model.CertifiedAt.HasValue
                ? DateOnly.FromDateTime(DateTime.SpecifyKind(_model.CertifiedAt.Value, DateTimeKind.Utc))
                : (DateOnly?)null;

            _editContext = new EditContext(_model);
            _editContext.OnValidationStateChanged += (_, __) => InvokeAsync(StateHasChanged);
        }
    }

    private Task OnCertifiedDateChanged(DateOnly? d)
    {
        _certifiedDate = d;
        // UI(DateOnly?) -> DTO(DateTime? en UTC 00:00)
        _model.CertifiedAt = d.HasValue
            ? new DateTime(d.Value.Year, d.Value.Month, d.Value.Day, 0, 0, 0, DateTimeKind.Utc)
            : (DateTime?)null;
        return Task.CompletedTask;
    }

    private async Task OnSaveClick()
    {
        if (IsSaving) return;

        if (_editContext.Validate())
            await HandleSubmit();
    }

    private async Task HandleSubmit()
    {
        if (OnSubmit.HasDelegate)
            await OnSubmit.InvokeAsync(_model);
    }

    private async Task Close()
    {
        if (IsSaving) return;
        if (OnCancel.HasDelegate)
            await OnCancel.InvokeAsync();
        if (IsOpenChanged.HasDelegate)
            await IsOpenChanged.InvokeAsync(false);
    }
}
