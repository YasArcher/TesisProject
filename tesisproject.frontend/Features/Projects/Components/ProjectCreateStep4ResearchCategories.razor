@using Microsoft.AspNetCore.Components
@using tesisproject.shared.DTOs.Algorithms.Response
@using tesisproject.shared.DTOs.Catalog.Common.Response
@using tesisproject.shared.DTOs.Catalog.ResearchCategory.Response
@using tesisproject.shared.DTOs.Catalog.ResearchCategoryType.Response

<div class="w-full min-w-0 flex flex-col gap-3">
    <!-- Header -->
    <section class="flex flex-col gap-2">
        <div class="flex items-center justify-between gap-2">
            <div class="flex items-center gap-2 min-w-0">
                <div class="w-6 h-6 rounded-md flex items-center justify-center bg-secondary/10 shrink-0">
                    <svg class="w-4 h-4 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M4 6h16M4 10h16M4 14h16M4 18h16" />
                    </svg>
                </div>
                <h5 class="text-sm font-semibold text-foreground truncate">Categorías</h5>
            </div>

            @if (_selectedResearchCategories.Count > 0)
            {
                <span class="px-2 py-0.5 text-xs font-semibold rounded-full bg-secondary text-white whitespace-nowrap">
                    @GetTotalCategoriesCount() seleccionadas
                </span>
            }
        </div>

        <div class="rounded-lg border border-border bg-background p-3">
            <div class="space-y-3">
                @if (ResearchCategoryGroups is not null && ResearchCategoryGroups.Any())
                {
                    @foreach (var group in ResearchCategoryGroups)
                    {
                        <div class="border border-border rounded-xl p-2.5 bg-background/60">
                            <ResearchCategoryMultiLevelSelector Title="@group.Name"
                                                                ResearchCategoryGroupId="@group.Id"
                                                                Categories="@ResearchCategoryTree"
                                                                CategoryTypes="@ResearchCategoryTypes"
                                                                OnSelectionChanged="(selection) => HandleGroupSelectionChanged(group.Id, selection)" />
                        </div>
                    }
                }
                else
                {
                    <ResearchCategoryMultiLevelSelector Categories="@ResearchCategoryTree"
                                                        CategoryTypes="@ResearchCategoryTypes"
                                                        OnSelectionChanged="HandleGlobalSelectionChanged" />
                }
            </div>
        </div>
    </section>

    <!-- Líneas detectadas -->
    @if (DideModel.ResearchLines?.Any() == true)
    {
        <section class="rounded-lg border border-accent/30 bg-accent/5 p-3">
            <div class="flex items-center justify-between gap-2 mb-2">
                <span class="text-xs font-semibold text-foreground">Detectado en DIDE</span>
                <span class="px-1.5 py-0.5 text-[10px] font-medium rounded bg-accent/20 text-accent whitespace-nowrap">
                    @DideModel.ResearchLines.Count
                </span>
            </div>

            <div class="flex flex-wrap gap-2">
                @foreach (var line in DideModel.ResearchLines)
                {
                    <span class="inline-flex items-center gap-1 px-2 py-1 text-xs rounded-md bg-background border border-border text-foreground">
                        @line
                    </span>
                }
            </div>
        </section>
    }

    <!-- Estado vacío -->
    @if (_selectedResearchCategories.Count == 0 && (DideModel.ResearchLines is null || !DideModel.ResearchLines.Any()))
    {
        <section class="flex items-center justify-center py-5 px-4 rounded-lg border border-dashed border-border bg-background/50">
            <p class="text-xs text-muted text-center">
                Aún no hay categorías seleccionadas.
            </p>
        </section>
    }
</div>

@code {
    [Parameter] public DideProjectFormInfo DideModel { get; set; } = new();

    [Parameter]
    public IReadOnlyList<ResearchCategoryTreeItemDTO> ResearchCategoryTree { get; set; }
        = Array.Empty<ResearchCategoryTreeItemDTO>();

    [Parameter]
    public IReadOnlyList<ResearchCategoryTypeListItemDTO> ResearchCategoryTypes { get; set; }
        = Array.Empty<ResearchCategoryTypeListItemDTO>();

    [Parameter]
    public IReadOnlyList<CatalogListItemDTO> ResearchCategoryGroups { get; set; }
        = Array.Empty<CatalogListItemDTO>();

    [Parameter]
    public EventCallback<List<ResearchCategoryTreeItemDTO>> OnResearchCategoriesChanged { get; set; }

    private List<ResearchCategoryTreeItemDTO> _selectedResearchCategories { get; set; } = new();
    private readonly Dictionary<int, List<ResearchCategoryTreeItemDTO>> _selectionByGroup = new();

    protected override void OnParametersSet()
    {
        DideModel.ResearchLines ??= new List<string>();

        if (ResearchCategoryGroups is null || ResearchCategoryGroups.Count == 0)
        {
            if (_selectionByGroup.Count > 0)
            {
                _selectionByGroup.Clear();
                _selectedResearchCategories = new();
            }

            return;
        }

        var validGroupIds = ResearchCategoryGroups.Select(g => g.Id).ToHashSet();
        var staleKeys = _selectionByGroup.Keys.Where(k => !validGroupIds.Contains(k)).ToList();

        if (staleKeys.Count > 0)
        {
            foreach (var key in staleKeys)
                _selectionByGroup.Remove(key);

            RebuildGlobalSelection();
        }
    }

    private async Task HandleGlobalSelectionChanged(List<ResearchCategoryTreeItemDTO> selection)
    {
        _selectionByGroup.Clear();
        _selectedResearchCategories = selection ?? new();

        if (OnResearchCategoriesChanged.HasDelegate)
        {
            await OnResearchCategoriesChanged.InvokeAsync(_selectedResearchCategories);
        }
    }

    private async Task HandleGroupSelectionChanged(int groupId, List<ResearchCategoryTreeItemDTO> selection)
    {
        _selectionByGroup[groupId] = selection ?? new();
        RebuildGlobalSelection();

        if (OnResearchCategoriesChanged.HasDelegate)
        {
            await OnResearchCategoriesChanged.InvokeAsync(_selectedResearchCategories);
        }
    }

    private void RebuildGlobalSelection()
    {
        _selectedResearchCategories = _selectionByGroup
            .Values
            .SelectMany(list => list)
            .GroupBy(node => node.Id)
            .Select(g => g.First())
            .ToList();
    }

    private int GetTotalCategoriesCount()
    {
        int count = 0;

        void CountRecursive(ResearchCategoryTreeItemDTO node)
        {
            count++;
            foreach (var child in node.Children)
                CountRecursive(child);
        }

        foreach (var root in _selectedResearchCategories)
            CountRecursive(root);

        return count;
    }
}