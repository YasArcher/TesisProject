@using System.Globalization
@using Microsoft.AspNetCore.Components
@using tesisproject.frontend.SharedUI.ActionButton
@using tesisproject.frontend.SharedUI.Table
@using tesisproject.shared.DTOs.Budgets
@using tesisproject.shared.DTOs.Budgets.Request
@using tesisproject.shared.Enums
@using tesisproject.frontend.Utils

<DataTable TItem="BudgetTransactionDTO"
           Items="@Transactions"
           Columns="@_columns"
           EmptyText="@EmptyText"
           RowTemplate="@TransactionRowTemplate"
           PageSize="@PageSize"
           Total="@TotalTransactions" />

@code {
    // ===== Parámetros =====
    [Parameter] public List<BudgetTransactionDTO>? Transactions { get; set; }
    [Parameter] public string EmptyText { get; set; } = "Aún no hay transacciones.";
    [Parameter] public EventCallback<int> OnExecuteDevengado { get; set; }
    [Parameter] public int PageSize { get; set; } = 3;

    private int TotalTransactions => Transactions?.Count ?? 0;

    // ===== Columnas (ordenan por valor crudo) =====
    private IReadOnlyList<ColumnDef<BudgetTransactionDTO>> _columns = new[]
    {
        // Número (ordenamos por Id, mostramos ordinal en la fila)
        new ColumnDef<BudgetTransactionDTO>("N°",        t => t.BudgetTransactionId,                                   Width: "60px",  Sortable: true),

        // Fecha dinámica: devengada si existe, caso contrario certificada
        new ColumnDef<BudgetTransactionDTO>("Fecha",     t => (object?)(t.ExecutedAt ?? t.CertifiedAt),               Width: "150px", Sortable: true),

        // CUR: vacío si no hay
        new ColumnDef<BudgetTransactionDTO>("CUR",       t => string.IsNullOrWhiteSpace(t.CURNumber) ? "" : t.CURNumber!, Width: "120px", Sortable: true),

        // Descripción dinámica
        new ColumnDef<BudgetTransactionDTO>("Descripción",
            t => !string.IsNullOrWhiteSpace(t.ExecutionDescription)
                    ? t.ExecutionDescription!
                    : t.CertificationDescription ?? "",
            Width: "240px",
            Sortable: true),

        // Valor dinámico (devengado o certificado)
        new ColumnDef<BudgetTransactionDTO>("Valor",
            t => t.ExecutedAt.HasValue ? t.ExecutedAmount : t.CertifiedAmount,
            Width: "120px",
            Sortable: true),

        // Partida presupuestaria (vacío si no hay)
        new ColumnDef<BudgetTransactionDTO>("Partida presupuestaria",
            t => t.BudgetItem ?? "",
            Width: "200px",
            Sortable: true),

        // Nombre de la transacción
        new ColumnDef<BudgetTransactionDTO>("Nombre",
            t => t.Name ?? "",
            Width: "200px",
            Sortable: true),

        // Estado (texto de ordenación)
        new ColumnDef<BudgetTransactionDTO>("Estado",
            t => t.TransactionTypeId,
            Width: "120px",
            Sortable: true),

        // Acción (no sortable)
        new ColumnDef<BudgetTransactionDTO>("Acción",
            t => "",
            Width: "100px",
            Sortable: false)
    };

    // ===== Row Template (formateo visual con helpers) =====
    private RenderFragment<BudgetTransactionDTO> TransactionRowTemplate => transaction => @<text>
        <!-- N° (ordinal) -->
        <td class="px-4 py-3 text-sm text-foreground align-middle">
            @(Transactions is null ? "" : (Transactions.IndexOf(transaction) + 1).ToString())
        </td>

        <!-- Fecha dinámica -->
        <td class="px-4 py-3 text-sm text-foreground align-middle">
            @DateCell(transaction.ExecutedAt ?? transaction.CertifiedAt)
        </td>

        <!-- CUR -->
        <td class="px-4 py-3 text-sm text-foreground align-middle">
            @(string.IsNullOrWhiteSpace(transaction.CURNumber) ? "" : transaction.CURNumber)
        </td>

        <!-- Descripción dinámica -->
        <td class="px-4 py-3 text-sm text-foreground align-middle">
            @(
                !string.IsNullOrWhiteSpace(transaction.ExecutionDescription)
                ? transaction.ExecutionDescription
                : transaction.CertificationDescription
                )
    </td>

    <!-- Valor dinámico -->
    <td class="px-4 py-3 text-sm text-foreground align-middle text-right">
        @FormatMoney(transaction.ExecutedAt.HasValue ? transaction.ExecutedAmount : transaction.CertifiedAmount)
    </td>

    <!-- Partida presupuestaria -->
    <td class="px-4 py-3 text-sm text-foreground align-middle">
        @(string.IsNullOrWhiteSpace(transaction.BudgetItem) ? "" : transaction.BudgetItem)
    </td>

    <!-- Nombre -->
    <td class="px-4 py-3 text-sm text-foreground align-middle">
        @transaction.Name
    </td>

    <!-- Estado -->
    <td class="px-4 py-3 text-sm text-foreground align-middle">
        @if (IsExecuted(transaction.ExecutedAt))
                {
        <span class="px-2 py-1 rounded text-xs bg-green-100 text-green-700">Devengada</span>
                }
                else
                {
        <span class="px-2 py-1 rounded text-xs bg-yellow-100 text-yellow-800">Certificada</span>
                }
    </td>

    <!-- Acción -->
    <td class="px-4 py-3 text-sm text-foreground align-middle text-right">
        <ActionButton Text="Devengar"
                      Intent="ButtonIntent.Accept"
                      Variant="ButtonVariant.Outline"
                      Size="ButtonSize.Xs"
                      Disabled="@IsExecuted(transaction.ExecutedAt)"
                      Execute="@(() => OnExecuteDevengado.InvokeAsync(transaction.BudgetTransactionId))" />
    </td>
</text>;

    // ===== Celdas y utilidades =====
    private static RenderFragment DateCell(DateTime? dt) => builder =>
    {
        var text = dt.ToSpanishShortDate(); // "-", o dd/MM/yyyy
        var title = $"{dt.ToSpanishDate()} • {dt.ToRelativeTime()}";

        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "title", title);
        builder.AddContent(2, text);
        builder.CloseElement();
    };

    private static string FormatMoney(decimal amount)
        => amount.ToString("N2", CultureInfo.InvariantCulture);

    private static bool IsExecuted(DateTime? executedAt)
        => executedAt.HasValue && executedAt.Value != DateTime.MinValue;
}
