@using System.Globalization
@using Microsoft.AspNetCore.Components
@using tesisproject.frontend.SharedUI.ActionButton
@using tesisproject.frontend.SharedUI.StatCard
@using tesisproject.shared.DTOs.External
@using tesisproject.frontend.SharedUI.Table

<div class="p-6 space-y-4">
    <!-- Header + actions -->
    <div class="flex flex-col md:flex-row md:justify-between md:items-center gap-3">
        <div class="flex items-center gap-2">
            <ActionButton Text="Agregar Miembros"
                          Intent="ButtonIntent.Accept"
                          Variant="ButtonVariant.Filled"
                          Size="ButtonSize.Sm"
                          Execute="@(()=> OnInviteMember.InvokeAsync())">
                <Icon>
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6">
                        <path d="M5.25 6.375a4.125 4.125 0 1 1 8.25 0 4.125 4.125 0 0 1-8.25 0ZM2.25 19.125a7.125 7.125 0 0 1 14.25 0v.003l-.001.119a.75.75 0 0 1-.363.63 13.067 13.067 0 0 1-6.761 1.873c-2.472 0-4.786-.684-6.76-1.873a.75.75 0 0 1-.364-.63l-.001-.122ZM18.75 7.5a.75.75 0 0 0-1.5 0v2.25H15a.75.75 0 0 0 0 1.5h2.25v2.25a.75.75 0 0 0 1.5 0v-2.25H21a.75.75 0 0 0 0-1.5h-2.25V7.5Z" />
                    </svg>
                </Icon>
            </ActionButton>
        </div>
    </div>

    @if (IsLoading)
    {
        <div class="text-sm text-muted">Cargando Miembros…</div>
    }
    else if (Members is null || Members.Count == 0)
    {
        <div class="text-sm text-muted">Este proyecto no tiene miembros aun.</div>
    }
    else
    {
        <!-- Tabla reutilizable -->
        <DataTable TItem="ExternalUserDTO"
                   Items="filtered"
                   Columns="_columns"
                   PageSize="PageSize"
                   Total="filtered.Count"
                   CurrentPage="currentPage"
                   OnPageChanged="HandlePageChanged"
                   EmptyText="Este proyecto no tiene miembros aun.">

            <RowTemplate Context="m">
                <td class="px-4 py-3 text-sm font-medium text-foreground align-middle w-48">
                    @m.FullName
                </td>

                <td class="px-4 py-3 text-sm text-muted align-middle w-56">
                    @m.Email
                </td>

                <td class="px-4 py-3 text-sm align-middle w-40">
                    <span class="px-2 py-0.5 rounded-full text-xs border border-border text-foreground bg-foreground/5">
                        @m.Role
                    </span>
                </td>

                <td class="px-4 py-3 text-sm text-foreground align-middle w-40">
                    @m.Position
                </td>

                <td class="px-4 py-3 text-sm text-foreground align-middle w-32">
                    @m.Document
                </td>

                <td class="px-4 py-3 text-sm text-foreground align-middle w-32">
                    @GetFacultyNameFor(m)
                </td>

                <td class="px-4 py-3 text-sm text-foreground align-middle w-40">
                    @GetProgramNameFor(m)
                </td>

                <td class="px-4 py-3 text-sm text-right align-middle w-44">
                    <div class="inline-flex gap-1">
                        <ActionButton Text="Cambiar Rol"
                                      Intent="ButtonIntent.Neutral"
                                      Variant="ButtonVariant.Ghost"
                                      Size="ButtonSize.Xs"
                                      Execute="@(()=> OnChangeRole.InvokeAsync(m.UserId))" />

                        <ActionButton Text="Eliminar"
                                      Intent="ButtonIntent.Danger"
                                      Variant="ButtonVariant.Outline"
                                      Size="ButtonSize.Xs"
                                      Execute="@(()=> OnRemoveMember.InvokeAsync(m.UserGroupId))" />
                    </div>
                </td>
            </RowTemplate>
        </DataTable>
    }
</div>

@code {
    [Parameter] public List<ExternalFacultyDTO>? Faculties { get; set; }

    // ===== Parameters =====
    [Parameter] public List<ExternalUserDTO>? Members { get; set; }
    [Parameter] public bool IsLoading { get; set; }

    // Eventos (padre)
    [Parameter] public EventCallback OnInviteMember { get; set; }
    [Parameter] public EventCallback<int> OnChangeRole { get; set; }
    [Parameter] public EventCallback<int> OnRemoveMember { get; set; }

    // Paginación + filtro
    [Parameter] public int PageSize { get; set; } = 15;
    private int currentPage = 1;
    private string searchText = string.Empty;

    // KPIs (por si luego los usas en StatCards)
    private int totalMembers => Members?.Count ?? 0;

    private int uniqueRolesCount => Members?
        .Select(m => (m.Role ?? string.Empty).Trim())
        .Where(r => !string.IsNullOrWhiteSpace(r))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .Count() ?? 0;

    private int withFacultyCareer => Members?.Count(m => m.FacultyCareerId.HasValue) ?? 0;

    // Filtro
    private List<ExternalUserDTO> filtered => string.IsNullOrWhiteSpace(searchText)
        ? (Members ?? new())
        : (Members ?? new())
            .Where(m =>
                (!string.IsNullOrWhiteSpace(m.FullName) && m.FullName.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrWhiteSpace(m.Email) && m.Email.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrWhiteSpace(m.Role) && m.Role.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrWhiteSpace(m.Document) && m.Document.Contains(searchText, StringComparison.OrdinalIgnoreCase))
            )
            .ToList();

    private IReadOnlyList<ColumnDef<ExternalUserDTO>> _columns = Array.Empty<ColumnDef<ExternalUserDTO>>();

    protected override void OnInitialized()
    {
        _columns = new[]
        {
            new ColumnDef<ExternalUserDTO>("Nombre",   m => m.FullName ?? string.Empty,   "12rem", Sortable: true),
            new ColumnDef<ExternalUserDTO>("Email",    m => m.Email ?? string.Empty,      "14rem", Sortable: true),
            new ColumnDef<ExternalUserDTO>("Rol",      m => m.Role ?? string.Empty,       "10rem", Sortable: true),
            new ColumnDef<ExternalUserDTO>("Position", m => m.Position ?? string.Empty,   "10rem", Sortable: true),
            new ColumnDef<ExternalUserDTO>("Cedula",   m => m.Document ?? string.Empty,   "8rem",  Sortable: true),
            new ColumnDef<ExternalUserDTO>("Facultad", m => GetFacultyNameFor(m),         "12rem", Sortable: true),
            new ColumnDef<ExternalUserDTO>("Carrera",  m => GetProgramNameFor(m),         "12rem", Sortable: true),
            new ColumnDef<ExternalUserDTO>("Acciones", m => string.Empty,                 "11rem", Sortable: false),
        };
    }


    private Task HandlePageChanged(int page)
    {
        currentPage = page;
        return Task.CompletedTask;
    }

    private string GetFacultyNameFor(ExternalUserDTO member)
    {
        if (!member.FacultyCareerId.HasValue || Faculties is null || Faculties.Count == 0)
            return "-";

        int id = member.FacultyCareerId.Value;

        // 1) Ver si es FACULTAD
        var faculty = Faculties.FirstOrDefault(f => f.FacultyId == id);
        if (faculty is not null)
            return faculty.Name; // Es facultad directa

        // 2) Ver si es PROGRAMA
        var program = Faculties
            .SelectMany(f => f.Programs ?? new List<ExternalProgramDTO>())
            .FirstOrDefault(p => p.ProgramId == id);

        if (program is not null)
        {
            var parentFaculty = Faculties.FirstOrDefault(f => f.FacultyId == program.FacultyId);
            return parentFaculty?.Name ?? "-";
        }

        return "-";
    }

    private string GetProgramNameFor(ExternalUserDTO member)
    {
        if (!member.FacultyCareerId.HasValue || Faculties is null || Faculties.Count == 0)
            return "-";

        int id = member.FacultyCareerId.Value;

        // Si es FACULTAD → no tiene programa asociado
        if (Faculties.Any(f => f.FacultyId == id))
            return "-";

        // Si es PROGRAMA → devolver su nombre
        var program = Faculties
            .SelectMany(f => f.Programs ?? new List<ExternalProgramDTO>())
            .FirstOrDefault(p => p.ProgramId == id);

        return program?.Name ?? "-";
    }
}