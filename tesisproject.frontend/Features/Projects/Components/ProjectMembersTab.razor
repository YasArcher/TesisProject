@using System.Globalization
@using Microsoft.AspNetCore.Components
@using tesisproject.frontend.SharedUI.ActionButton
@using tesisproject.frontend.SharedUI.Table
@using tesisproject.shared.DTOs.External
@using tesisproject.shared.DTOs.AppUser
@using tesisproject.shared.DTOs.ExternalResearcherProject.Response

<div class="w-full min-w-0 flex flex-col gap-4 p-4 md:p-5">
    <!-- Acciones -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
        <ActionButton Text="Agregar miembros"
                      Intent="ButtonIntent.Accept"
                      Variant="ButtonVariant.Filled"
                      Size="ButtonSize.Sm"
                      Execute="@(() => OnInviteMember.InvokeAsync())"
                      Class="w-full" />

        <ActionButton Text="Agregar externo"
                      Intent="ButtonIntent.Neutral"
                      Variant="ButtonVariant.Outline"
                      Size="ButtonSize.Sm"
                      Execute="@(() => OnAddExternalResearcher.InvokeAsync())"
                      Class="w-full" />
    </div>

    <!-- Miembros internos -->
    <section class="rounded-xl border border-border bg-background p-4 shadow-sm min-w-0">
        <div class="flex items-center justify-between gap-2 mb-3">
            <div class="flex items-center gap-2 min-w-0">
                <h3 class="text-sm font-semibold text-foreground truncate">Miembros</h3>
                @if (InternalMembers.Count > 0)
                {
                    <span class="px-2 py-0.5 text-[11px] font-medium rounded-full bg-primary text-white whitespace-nowrap">
                        @InternalMembers.Count
                    </span>
                }
            </div>
        </div>

        @if (IsLoading)
        {
            <div class="text-sm text-muted">Cargando miembros...</div>
        }
        else if (InternalMembers.Count == 0)
        {
            <div class="rounded-lg border border-dashed border-border bg-background/50 px-4 py-6 text-center">
                <p class="text-sm text-muted">No hay miembros registrados.</p>
            </div>
        }
        else
        {
            <div class="min-w-0">
                <DataTable TItem="ResolvedUserProfileDTO"
                           Items="InternalMembers"
                           Columns="_columns"
                           PageSize="PageSize"
                           Total="InternalMembers.Count"
                           CurrentPage="_internalPage"
                           OnPageChanged="HandleInternalPageChanged"
                           EmptyText="No hay miembros registrados.">

                    <RowTemplate Context="m">
                        <td class="px-4 py-3 text-sm font-medium text-foreground align-middle w-48">
                            @m.FullName
                        </td>

                        <td class="px-4 py-3 text-sm text-muted align-middle w-56">
                            @m.Email
                        </td>

                        <td class="px-4 py-3 text-sm align-middle w-40">
                            <span class="px-2 py-0.5 rounded-full text-xs border border-border text-foreground bg-foreground/5">
                                @m.Role
                            </span>
                        </td>

                        <td class="px-4 py-3 text-sm text-foreground align-middle w-40">
                            @m.Position
                        </td>

                        <td class="px-4 py-3 text-sm text-foreground align-middle w-32">
                            @m.Document
                        </td>

                        <td class="px-4 py-3 text-sm text-foreground align-middle w-32">
                            @GetFacultyNameFor(m)
                        </td>

                        <td class="px-4 py-3 text-sm text-foreground align-middle w-40">
                            @GetProgramNameFor(m)
                        </td>

                        <td class="px-4 py-3 text-sm text-right align-middle w-32">
                            <ActionButton Text="Eliminar"
                                          Intent="ButtonIntent.Danger"
                                          Variant="ButtonVariant.Outline"
                                          Size="ButtonSize.Xs"
                                          Execute="@(() => OnRemoveMember.InvokeAsync(m.UserGroupId))" />
                        </td>
                    </RowTemplate>
                </DataTable>
            </div>
        }
    </section>

    <!-- Investigadores externos -->
    <section class="rounded-xl border border-border bg-background p-4 shadow-sm min-w-0">
        <div class="flex items-center justify-between gap-2 mb-3">
            <div class="flex items-center gap-2 min-w-0">
                <h3 class="text-sm font-semibold text-foreground truncate">Externos</h3>
                @if (ExternalMembers.Count > 0)
                {
                    <span class="px-2 py-0.5 text-[11px] font-medium rounded-full bg-secondary text-white whitespace-nowrap">
                        @ExternalMembers.Count
                    </span>
                }
            </div>
        </div>

        @if (IsLoadingExternalResearchers)
        {
            <div class="text-sm text-muted">Cargando externos...</div>
        }
        else if (ExternalMembers.Count == 0)
        {
            <div class="rounded-lg border border-dashed border-border bg-background/50 px-4 py-6 text-center">
                <p class="text-sm text-muted">No hay investigadores externos.</p>
            </div>
        }
        else
        {
            <div class="min-w-0">
                <DataTable TItem="ExternalResearcherProjectListItemDTO"
                           Items="ExternalMembers"
                           Columns="_externalColumns"
                           PageSize="PageSize"
                           Total="ExternalMembers.Count"
                           CurrentPage="_externalPage"
                           OnPageChanged="HandleExternalPageChanged"
                           EmptyText="No hay investigadores externos.">

                    <RowTemplate Context="er">
                        <td class="px-4 py-3 text-sm font-medium text-foreground align-middle w-56">
                            @er.ExternalResearcherFullName
                        </td>

                        <td class="px-4 py-3 text-sm text-muted align-middle w-56">
                            @er.ExternalResearcherEmail
                        </td>

                        <td class="px-4 py-3 text-sm align-middle w-40">
                            <span class="px-2 py-0.5 rounded-full text-xs border border-border text-foreground bg-foreground/5">
                                @er.Role
                            </span>
                        </td>

                        <td class="px-4 py-3 text-sm text-foreground align-middle w-40">
                            @er.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm", CultureInfo.InvariantCulture)
                        </td>

                        <td class="px-4 py-3 text-sm text-foreground align-middle w-32">
                            @(er.ExitDate.HasValue
                                ? er.ExitDate.Value.ToLocalTime().ToString("dd/MM/yyyy", CultureInfo.InvariantCulture)
                                : "-")
                        </td>

                        <td class="px-4 py-3 text-sm text-right align-middle w-32">
                            <ActionButton Text="Eliminar"
                                          Intent="ButtonIntent.Danger"
                                          Variant="ButtonVariant.Outline"
                                          Size="ButtonSize.Xs"
                                          Execute="@(() => OnRemoveExternalResearcher.InvokeAsync(er.Id))" />
                        </td>
                    </RowTemplate>
                </DataTable>
            </div>
        }
    </section>
</div>

@code {
    [Parameter] public List<ExternalFacultyDTO>? Faculties { get; set; }

    [Parameter] public List<ResolvedUserProfileDTO>? Members { get; set; }
    [Parameter] public bool IsLoading { get; set; }

    [Parameter] public List<ExternalResearcherProjectListItemDTO>? ExternalResearchersProjects { get; set; }
    [Parameter] public bool IsLoadingExternalResearchers { get; set; }

    [Parameter] public EventCallback OnAddExternalResearcher { get; set; }
    [Parameter] public EventCallback<int> OnRemoveExternalResearcher { get; set; }

    [Parameter] public EventCallback OnInviteMember { get; set; }
    [Parameter] public EventCallback<int> OnRemoveMember { get; set; }

    [Parameter] public int PageSize { get; set; } = 15;

    private int _internalPage = 1;
    private int _externalPage = 1;

    private List<ResolvedUserProfileDTO> InternalMembers => Members ?? new();
    private List<ExternalResearcherProjectListItemDTO> ExternalMembers => ExternalResearchersProjects ?? new();

    private static readonly IReadOnlyList<ColumnDef<ResolvedUserProfileDTO>> _columns =
        new[]
        {
            new ColumnDef<ResolvedUserProfileDTO>("Nombre",   m => m.FullName ?? string.Empty, "12rem", Sortable: true),
            new ColumnDef<ResolvedUserProfileDTO>("Email",    m => m.Email ?? string.Empty,    "14rem", Sortable: true),
            new ColumnDef<ResolvedUserProfileDTO>("Rol",      m => m.Role ?? string.Empty,     "10rem", Sortable: true),
            new ColumnDef<ResolvedUserProfileDTO>("Cargo",    m => m.Position ?? string.Empty, "10rem", Sortable: true),
            new ColumnDef<ResolvedUserProfileDTO>("Cédula",   m => m.Document ?? string.Empty, "8rem",  Sortable: true),
            new ColumnDef<ResolvedUserProfileDTO>("Facultad", m => string.Empty,               "12rem", Sortable: false),
            new ColumnDef<ResolvedUserProfileDTO>("Carrera",  m => string.Empty,               "12rem", Sortable: false),
            new ColumnDef<ResolvedUserProfileDTO>("Acciones", m => string.Empty,               "8rem",  Sortable: false),
        };

    private static readonly IReadOnlyList<ColumnDef<ExternalResearcherProjectListItemDTO>> _externalColumns =
        new[]
        {
            new ColumnDef<ExternalResearcherProjectListItemDTO>("Nombre",   e => e.ExternalResearcherFullName ?? string.Empty, "14rem", Sortable: true),
            new ColumnDef<ExternalResearcherProjectListItemDTO>("Email",    e => e.ExternalResearcherEmail ?? string.Empty,    "14rem", Sortable: true),
            new ColumnDef<ExternalResearcherProjectListItemDTO>("Rol",      e => e.Role ?? string.Empty,                       "10rem", Sortable: true),
            new ColumnDef<ExternalResearcherProjectListItemDTO>("Ingreso",  e => e.CreatedAtUtc,                               "10rem", Sortable: true),
            new ColumnDef<ExternalResearcherProjectListItemDTO>("Salida",   e => e.ExitDate,                                   "10rem", Sortable: true),
            new ColumnDef<ExternalResearcherProjectListItemDTO>("Acciones", e => string.Empty,                                 "8rem",  Sortable: false),
        };

    private Task HandleInternalPageChanged(int page)
    {
        _internalPage = page;
        return Task.CompletedTask;
    }

    private Task HandleExternalPageChanged(int page)
    {
        _externalPage = page;
        return Task.CompletedTask;
    }

    private string GetFacultyNameFor(ResolvedUserProfileDTO member)
    {
        if (!member.FacultyCareerId.HasValue || Faculties is null || Faculties.Count == 0)
            return "-";

        int id = member.FacultyCareerId.Value;

        var faculty = Faculties.FirstOrDefault(f => f.FacultyId == id);
        if (faculty is not null)
            return faculty.Name;

        var program = Faculties
            .SelectMany(f => f.Programs ?? new List<ExternalProgramDTO>())
            .FirstOrDefault(p => p.ProgramId == id);

        if (program is not null)
        {
            var parentFaculty = Faculties.FirstOrDefault(f => f.FacultyId == program.FacultyId);
            return parentFaculty?.Name ?? "-";
        }

        return "-";
    }

    private string GetProgramNameFor(ResolvedUserProfileDTO member)
    {
        if (!member.FacultyCareerId.HasValue || Faculties is null || Faculties.Count == 0)
            return "-";

        int id = member.FacultyCareerId.Value;

        if (Faculties.Any(f => f.FacultyId == id))
            return "-";

        var program = Faculties
            .SelectMany(f => f.Programs ?? new List<ExternalProgramDTO>())
            .FirstOrDefault(p => p.ProgramId == id);

        return program?.Name ?? "-";
    }
}