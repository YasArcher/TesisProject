@using Microsoft.AspNetCore.Components
@using tesisproject.frontend.SharedUI.ActionButton
@using tesisproject.shared.DTOs.Catalog.Common.Response
@using tesisproject.shared.DTOs.Project.Response
@using tesisproject.frontend.Utils
@using tesisproject.shared.DTOs.Catalog.ResearchCategory.Response
@using tesisproject.shared.DTOs.Catalog.ResearchCategoryType.Response

<div class="w-full min-w-0 flex flex-col gap-4 p-4 md:p-5">
    @if (IsLoading || (!_loadFinishedOnce && Item is null))
    {
        <div class="flex items-center justify-center gap-3 rounded-lg border border-primary/20 bg-primary-subtle px-4 py-6">
            <div class="animate-spin h-5 w-5 border-2 border-primary border-t-transparent rounded-full"></div>
            <div class="text-sm font-medium text-primary">Cargando proyecto...</div>
        </div>
    }
    else if (Item is null)
    {
        <div class="flex items-center gap-3 rounded-lg border border-error/20 bg-error/10 px-4 py-5">
            <div class="w-9 h-9 rounded-full bg-error/15 flex items-center justify-center shrink-0">
                <span class="text-error text-lg">⚠</span>
            </div>
            <div class="min-w-0">
                <div class="font-semibold text-error">Proyecto no disponible</div>
                <div class="text-sm text-error/80">No se encontraron datos.</div>
            </div>
        </div>
    }
    else
    {
        <div class="grid gap-4 xl:grid-cols-[minmax(0,2fr)_320px]">
            <!-- Columna principal -->
            <div class="min-w-0 flex flex-col gap-4">
                <!-- Fechas + documento -->
                <div class="bg-background border border-border rounded-xl p-4 shadow-sm">
                    <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
                        <div class="flex items-center gap-3 min-w-0">
                            <div class="w-9 h-9 bg-primary/10 rounded-lg flex items-center justify-center shrink-0">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
                                </svg>
                            </div>
                            <h3 class="text-base font-semibold text-foreground truncate">Fechas</h3>
                        </div>

                        <ActionButton Text="Ver documento inicial"
                                      Intent="ButtonIntent.Info"
                                      Variant="ButtonVariant.Filled"
                                      Size="ButtonSize.Sm"
                                      Execute="ViewMainDocumentAsync"
                                      Disabled="@(!CanViewMainDocument)" />
                    </div>

                    <div class="mt-4 grid gap-3 sm:grid-cols-3">
                        <div class="rounded-lg border border-border bg-page-bg px-3 py-3">
                            <div class="text-[11px] font-semibold uppercase tracking-wide text-primary mb-1">Inicio</div>
                            @if (Item.StartDate.HasValue)
                            {
                                <div class="text-sm font-medium text-foreground">@Item.StartDate.ToSpanishDate()</div>
                            }
                            else
                            {
                                <div class="text-sm text-muted italic">No definida</div>
                            }
                        </div>

                        <div class="rounded-lg border border-border bg-page-bg px-3 py-3">
                            <div class="text-[11px] font-semibold uppercase tracking-wide text-secondary mb-1">Fin previsto</div>
                            @if (Item.TentativeEndDate.HasValue)
                            {
                                <div class="text-sm font-medium text-foreground">@Item.TentativeEndDate.ToSpanishDate()</div>
                            }
                            else
                            {
                                <div class="text-sm text-muted italic">No definida</div>
                            }
                        </div>

                        <div class="rounded-lg border border-border bg-page-bg px-3 py-3">
                            <div class="text-[11px] font-semibold uppercase tracking-wide text-accent mb-1">Fin real</div>
                            @if (Item.RealEndDate.HasValue)
                            {
                                <div class="text-sm font-medium text-foreground">@Item.RealEndDate.ToSpanishDate()</div>
                            }
                            else
                            {
                                <div class="text-sm text-muted italic">En progreso</div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Descripción -->
                <div class="bg-background border border-border rounded-xl p-4 shadow-sm">
                    <div class="flex items-center gap-3 mb-4">
                        <div class="w-9 h-9 bg-accent/10 rounded-lg flex items-center justify-center shrink-0">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
                                 fill="currentColor" class="w-5 h-5" aria-hidden="true">
                                <path fill-rule="evenodd" d="M5.625 1.5c-1.036 0-1.875.84-1.875 1.875v17.25c0 1.035.84 1.875 1.875 1.875h12.75c1.035 0 1.875-.84 1.875-1.875V12.75A3.75 3.75 0 0 0 16.5 9h-1.875a1.875 1.875 0 0 1-1.875-1.875V5.25A3.75 3.75 0 0 0 9 1.5H5.625ZM7.5 15a.75.75 0 0 1 .75-.75h7.5a.75.75 0 0 1 0 1.5h-7.5A.75.75 0 0 1 7.5 15Zm.75 2.25a.75.75 0 0 0 0 1.5H12a.75.75 0 0 0 0-1.5H8.25Z" clip-rule="evenodd" />
                                <path d="M12.971 1.816A5.23 5.23 0 0 1 14.25 5.25v1.875c0 .207.168.375.375.375H16.5a5.23 5.23 0 0 1 3.434 1.279 9.768 9.768 0 0 0-6.963-6.963Z" />
                            </svg>
                        </div>
                        <h3 class="text-base font-semibold text-foreground">Descripción</h3>
                    </div>

                    <div class="space-y-4">
                        <!-- Objetivo -->
                        <div>
                            <h4 class="text-xs font-semibold text-muted uppercase tracking-wide mb-2">Objetivo</h4>
                            <div class="bg-page-bg border border-border rounded-lg p-3">
                                @if (!string.IsNullOrWhiteSpace(GetGeneralObjectiveText()))
                                {
                                    <p class="text-sm text-foreground leading-relaxed break-words">
                                        @GetGeneralObjectiveText()
                                    </p>
                                }
                                else
                                {
                                    <p class="text-sm text-muted italic">Sin objetivo definido</p>
                                }
                            </div>
                        </div>

                        <!-- Categorías -->
                        <div>
                            <h4 class="text-xs font-semibold text-muted uppercase tracking-wide mb-2">
                                Categorías de investigación
                            </h4>

                            @if (_projectTreeRoots.Count == 0)
                            {
                                <div class="bg-page-bg border border-border rounded-lg p-3">
                                    <span class="text-sm text-muted italic">Sin categorías definidas</span>
                                </div>
                            }
                            else if (ResearchCategoryGroups is not null && ResearchCategoryGroups.Any()
                                  && ResearchCategoryTypes is not null && ResearchCategoryTypes.Any())
                            {
                                var projectRoots = _projectTreeRoots;

                                @foreach (var group in ResearchCategoryGroups)
                                {
                                    var typeIdsInGroup = ResearchCategoryTypes
                                        .Where(t => t.ResearchCategoryGroupId == group.Id)
                                        .Select(t => t.Id)
                                        .ToHashSet();

                                    var rootsInGroup = projectRoots
                                        .Where(r => ContainsTypeInGroup(r, typeIdsInGroup))
                                        .ToList();

                                    if (!rootsInGroup.Any())
                                    {
                                        continue;
                                    }

                                    <div class="mb-3">
                                        <div class="text-[11px] font-semibold text-muted uppercase mb-2">
                                            @group.Name
                                        </div>

                                        <div class="bg-page-bg border border-border rounded-lg p-3">
                                            @foreach (var root in rootsInGroup)
                                            {
                                                @RenderCategoryNode(root, 0)
                                            }
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="bg-page-bg border border-border rounded-lg p-3">
                                    @foreach (var root in _projectTreeRoots)
                                    {
                                        @RenderCategoryNode(root, 0)
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Columna lateral -->
            <div class="min-w-0">
                <div class="bg-background border border-border rounded-xl p-4 shadow-sm">
                    <div class="flex items-center gap-3 mb-4">
                        <div class="w-9 h-9 bg-primary/10 rounded-lg flex items-center justify-center shrink-0">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-5">
                                <path d="M12 7.5a2.25 2.25 0 1 0 0 4.5 2.25 2.25 0 0 0 0-4.5Z" />
                                <path fill-rule="evenodd" d="M1.5 4.875C1.5 3.839 2.34 3 3.375 3h17.25c1.035 0 1.875.84 1.875 1.875v9.75c0 1.036-.84 1.875-1.875 1.875H3.375A1.875 1.875 0 0 1 1.5 14.625v-9.75ZM8.25 9.75a3.75 3.75 0 1 1 7.5 0 3.75 3.75 0 0 1-7.5 0ZM18.75 9a.75.75 0 0 0-.75.75v.008c0 .414.336.75.75.75h.008a.75.75 0 0 0 .75-.75V9.75a.75.75 0 0 0-.75-.75h-.008ZM4.5 9.75A.75.75 0 0 1 5.25 9h.008a.75.75 0 0 1 .75.75v.008a.75.75 0 0 1-.75.75H5.25a.75.75 0 0 1-.75-.75V9.75Z" clip-rule="evenodd" />
                                <path d="M2.25 18a.75.75 0 0 0 0 1.5c5.4 0 10.63.722 15.6 2.075 1.19.324 2.4-.558 2.4-1.82V18.75a.75.75 0 0 0-.75-.75H2.25Z" />
                            </svg>
                        </div>
                        <h3 class="text-base font-semibold text-foreground">Presupuesto</h3>
                    </div>

                    @if (Item.Budgets is not null && Item.Budgets.Any())
                    {
                        <div class="space-y-3">
                            @foreach (var budget in Item.Budgets)
                            {
                                <div class="rounded-lg border border-border bg-page-bg p-3">
                                    <div class="text-[11px] font-semibold text-muted uppercase tracking-wide mb-1">
                                        Monto inicial
                                    </div>
                                    <div class="text-2xl font-bold text-foreground break-words">
                                        @budget.InitialAmount.ToString("C", new System.Globalization.CultureInfo("es-EC"))
                                    </div>

                                    <div class="mt-2 text-xs text-muted">Tipo de financiamiento</div>
                                    <div class="text-sm text-foreground">
                                        @DisplayOrDash(budget.FundingTypeName)
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="rounded-lg border border-dashed border-border bg-background/50 px-4 py-6 text-center">
                            <div class="text-sm font-medium text-muted">Sin presupuesto</div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public ProjectDetailResponseDTO? Item { get; set; }
    [Parameter] public bool IsLoading { get; set; }

    [Parameter] public IReadOnlyList<ResearchCategoryTreeItemDTO>? ResearchCategoryTree { get; set; }
    [Parameter] public IReadOnlyList<ResearchCategoryTypeListItemDTO>? ResearchCategoryTypes { get; set; }
    [Parameter] public IReadOnlyList<CatalogListItemDTO>? ResearchCategoryGroups { get; set; }

    [Parameter] public EventCallback<int> OnViewDocument { get; set; }

    private const int DOC_MEMORANDO_INICIAL = 1;

    private bool _wasLoading;
    private bool _loadFinishedOnce;

    private readonly Dictionary<int, ResearchCategoryTreeItemDTO> _allItems = new();
    private readonly List<ResearchCategoryTreeItemDTO> _projectTreeRoots = new();

    protected override void OnParametersSet()
    {
        if (_wasLoading && !IsLoading)
        {
            _loadFinishedOnce = true;
        }

        _wasLoading = IsLoading;

        _allItems.Clear();
        _projectTreeRoots.Clear();

        if (ResearchCategoryTree is null || !ResearchCategoryTree.Any())
            return;

        foreach (var root in ResearchCategoryTree)
        {
            BuildIndexRecursive(root);
        }

        if (Item?.ResearchCategoryIds is null || !Item.ResearchCategoryIds.Any())
            return;

        foreach (var leafId in Item.ResearchCategoryIds.Distinct())
        {
            if (_allItems.TryGetValue(leafId, out var leafNode))
            {
                InsertIntoProjectTree(leafNode);
            }
        }
    }

    private string? GetGeneralObjectiveText()
    {
        return Item?.ProjectObjectives?
            .FirstOrDefault(o => o.ObjectiveTypeId == 1)?
            .Objective;
    }

    private async Task ViewMainDocumentAsync()
    {
        var doc = Item?.Documents?
            .FirstOrDefault(d => d.DocumentTypeId == DOC_MEMORANDO_INICIAL && d.DocumentId > 0);

        if (doc is null)
            return;

        await OnViewDocument.InvokeAsync(doc.DocumentId);
    }

    private bool ContainsTypeInGroup(ResearchCategoryTreeItemDTO node, HashSet<int> typeIdsInGroup)
    {
        if (typeIdsInGroup.Contains(node.ResearchCategoryTypeId))
            return true;

        foreach (var child in node.Children)
        {
            if (ContainsTypeInGroup(child, typeIdsInGroup))
                return true;
        }

        return false;
    }

    private void BuildIndexRecursive(ResearchCategoryTreeItemDTO node)
    {
        if (!_allItems.ContainsKey(node.Id))
            _allItems[node.Id] = node;

        if (node.Children is null || node.Children.Count == 0)
            return;

        foreach (var child in node.Children)
        {
            BuildIndexRecursive(child);
        }
    }

    private void InsertIntoProjectTree(ResearchCategoryTreeItemDTO node)
    {
        if (!node.ParentCategoryId.HasValue)
        {
            var existingRoot = _projectTreeRoots.FirstOrDefault(r => r.Id == node.Id);
            if (existingRoot is null)
            {
                _projectTreeRoots.Add(CloneWithoutChildren(node));
            }
            return;
        }

        if (!_allItems.TryGetValue(node.ParentCategoryId.Value, out var parent))
            return;

        InsertIntoProjectTree(parent);

        var parentInProjectTree = FindNodeById(_projectTreeRoots, parent.Id);
        if (parentInProjectTree is null)
            return;

        if (!parentInProjectTree.Children.Any(c => c.Id == node.Id))
        {
            parentInProjectTree.Children.Add(CloneWithoutChildren(node));
        }
    }

    private ResearchCategoryTreeItemDTO? FindNodeById(List<ResearchCategoryTreeItemDTO> roots, int id)
    {
        foreach (var n in roots)
        {
            if (n.Id == id)
                return n;

            var found = FindNodeById(n.Children, id);
            if (found is not null)
                return found;
        }

        return null;
    }

    private bool CanViewMainDocument =>
        Item?.Documents?.Any(d => d.DocumentTypeId == DOC_MEMORANDO_INICIAL && d.DocumentId > 0) == true;

    private static string DisplayOrDash(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "-" : value;

    private ResearchCategoryTreeItemDTO CloneWithoutChildren(ResearchCategoryTreeItemDTO src)
    {
        return new ResearchCategoryTreeItemDTO
        {
            Id = src.Id,
            Name = src.Name,
            IsActive = src.IsActive,
            ResearchCategoryTypeId = src.ResearchCategoryTypeId,
            ResearchCategoryTypeName = src.ResearchCategoryTypeName,
            ParentCategoryId = src.ParentCategoryId,
            Children = new List<ResearchCategoryTreeItemDTO>()
        };
    }

    private RenderFragment RenderCategoryNode(ResearchCategoryTreeItemDTO node, int depth) => builder =>
    {
        var seq = 0;

        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "mb-1");

        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class",
            $"flex items-start gap-2 text-sm text-foreground {(depth == 0 ? "font-semibold" : "font-normal")}");

        if (depth > 0)
        {
            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "class", "mt-1 inline-block w-1.5 h-1.5 rounded-full bg-accent");
            builder.CloseElement();
        }

        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "flex flex-col gap-0.5 min-w-0");

        builder.OpenElement(seq++, "span");
        builder.AddAttribute(seq++, "class", "leading-tight break-words");
        builder.AddContent(seq++, node.Name);
        builder.CloseElement();

        if (!string.IsNullOrWhiteSpace(node.ResearchCategoryTypeName))
        {
            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "class",
                "inline-flex items-center px-2 py-0.5 rounded-full text-[11px] bg-muted/20 text-muted font-medium uppercase tracking-wide w-fit");
            builder.AddContent(seq++, node.ResearchCategoryTypeName);
            builder.CloseElement();
        }

        builder.CloseElement();
        builder.CloseElement();

        if (node.Children.Any())
        {
            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "ml-4 pl-3 border-l border-border/60 mt-1 space-y-1");

            foreach (var child in node.Children)
            {
                builder.AddContent(seq++, RenderCategoryNode(child, depth + 1));
            }

            builder.CloseElement();
        }

        builder.CloseElement();
    };
}