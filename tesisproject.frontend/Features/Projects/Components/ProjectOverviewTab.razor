@using tesisproject.shared.DTOs.Catalog.Common.Response
@using tesisproject.shared.DTOs.Project.Response
@using tesisproject.frontend.Utils
@using tesisproject.shared.DTOs.Catalog.ResearchCategory.Response
@using tesisproject.shared.DTOs.Catalog.ResearchCategoryType.Response

<div class="p-6 max-w-7xl mx-auto space-y-8">
    @if (IsLoading)
    {
        <div class="flex items-center justify-center gap-4 p-8 bg-primary-subtle rounded-xl border border-primary/20">
            <div class="animate-spin h-6 w-6 border-3 border-primary border-t-transparent rounded-full"></div>
            <div class="text-primary font-medium">Cargando detalles del proyecto...</div>
        </div>
    }
    else if (Item is null)
    {
        <div class="flex items-center justify-center gap-4 p-8 bg-error/10 border border-error/20 rounded-xl">
            <div class="w-10 h-10 bg-error/20 rounded-full flex items-center justify-center">
                <span class="text-error text-xl">⚠️</span>
            </div>
            <div>
                <div class="font-semibold text-error">No se encontraron datos</div>
                <div class="text-sm text-error/75">El proyecto solicitado no está disponible</div>
            </div>
        </div>
    }
    else
    {
        <!-- Grid principal -->
        <div class="grid gap-8 lg:grid-cols-3">

            <!-- Columna izquierda: Información principal -->
            <div class="lg:col-span-2 space-y-8">

                <!-- Fechas del proyecto -->
                <div class="bg-background border border-border rounded-xl p-6 shadow-sm">
                    <div class="flex items-center gap-3 mb-6">
                        <div class="w-10 h-10 bg-primary/10 rounded-xl flex items-center justify-center">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5m-9-6h.008v.008H12v-.008ZM12 15h.008v.008H12V15Zm0 2.25h.008v.008H12v-.008ZM9.75 15h.008v.008H9.75V15Zm0 2.25h.008v.008H9.75v-.008ZM7.5 15h.008v.008H7.5V15Zm0 2.25h.008v.008H7.5v-.008Zm6.75-4.5h.008v.008h-.008v-.008Zm0 2.25h.008v.008h-.008V15Zm0 2.25h.008v.008h-.008v-.008Zm2.25-4.5h.008v.008H16.5v-.008Zm0 2.25h.008v.008H16.5V15Z" />
                            </svg>
                        </div>
                        <h3 class="text-lg font-semibold text-foreground">Fechas Clave del Proyecto</h3>
                    </div>

                    <div class="grid gap-6 sm:grid-cols-3">
                        <div class="relative">
                            <div class="absolute left-0 top-0 w-1 h-full bg-primary/20 rounded-full"></div>
                            <div class="pl-4">
                                <div class="text-xs text-primary font-semibold mb-2 uppercase tracking-wide">Inicio</div>
                                <div class="font-semibold text-lg">
                                    @if (Item.StartDate.HasValue)
                                    {
                                        <span class="text-foreground">@Item.StartDate.ToSpanishDate()</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted italic">No definida</span>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="relative">
                            <div class="absolute left-0 top-0 w-1 h-full bg-secondary/20 rounded-full"></div>
                            <div class="pl-4">
                                <div class="text-xs text-secondary font-semibold mb-2 uppercase tracking-wide">Fin Previsto</div>
                                <div class="font-semibold text-lg">
                                    @if (Item.TentativeEndDate.HasValue)
                                    {
                                        <span class="text-foreground">@Item.TentativeEndDate.ToSpanishDate()</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted italic">No definida</span>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="relative">
                            <div class="absolute left-0 top-0 w-1 h-full bg-accent/20 rounded-full"></div>
                            <div class="pl-4">
                                <div class="text-xs text-accent font-semibold mb-2 uppercase tracking-wide">Fin Real</div>
                                <div class="font-semibold text-lg">
                                    @if (Item.RealEndDate.HasValue)
                                    {
                                        <span class="text-foreground">@Item.RealEndDate.ToSpanishDate()</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted italic">En progreso</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Descripción -->
                <div class="bg-background border border-border rounded-xl p-6 shadow-sm">
                    <div class="flex items-center gap-3 mb-6">
                        <div class="w-10 h-10 bg-accent/10 rounded-xl flex items-center justify-center">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
                                 fill="currentColor" class="w-6 h-6" aria-hidden="true">
                                <path fill-rule="evenodd" d="M5.625 1.5c-1.036 0-1.875.84-1.875 1.875v17.25c0 1.035.84 1.875 1.875 1.875h12.75c1.035 0 1.875-.84 1.875-1.875V12.75A3.75 3.75 0 0 0 16.5 9h-1.875a1.875 1.875 0 0 1-1.875-1.875V5.25A3.75 3.75 0 0 0 9 1.5H5.625ZM7.5 15a.75.75 0 0 1 .75-.75h7.5a.75.75 0 0 1 0 1.5h-7.5A.75.75 0 0 1 7.5 15Zm.75 2.25a.75.75 0 0 0 0 1.5H12a.75.75 0 0 0 0-1.5H8.25Z" clip-rule="evenodd" />
                                <path d="M12.971 1.816A5.23 5.23 0 0 1 14.25 5.25v1.875c0 .207.168.375.375.375H16.5a5.23 5.23 0 0 1 3.434 1.279 9.768 9.768 0 0 0-6.963-6.963Z" />
                            </svg>
                        </div>
                        <h3 class="text-lg font-semibold text-foreground">Descripción del Proyecto</h3>
                    </div>

                    <div class="space-y-6">
                        <!-- Objetivo -->
                        <div>
                            <div class="flex items-center gap-3 mb-4">
                                <div class="w-10 h-10 bg-accent/10 rounded-xl flex items-center justify-center">
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
                                         fill="currentColor" class="w-6 h-6" aria-hidden="true">
                                        <path fill-rule="evenodd" d="M3 2.25a.75.75 0 0 1 .75.75v.54l1.838-.46a9.75 9.75 0 0 1 6.725.738l.108.054A8.25 8.25 0 0 0 18 4.524l3.11-.732a.75.75 0 0 1 .917.81 47.784 47.784 0 0 0 .005 10.337.75.75 0 0 1-.574.812l-3.114.733a9.75 9.75 0 0 1-6.594-.77l-.108-.054a8.25 8.25 0 0 0-5.69-.625l-2.202.55V21a.75.75 0 0 1-1.5 0V3A.75.75 0 0 1 3 2.25Z" clip-rule="evenodd" />
                                    </svg>
                                </div>
                                <h4 class="text-sm font-semibold text-muted uppercase tracking-wide">Objetivo</h4>
                            </div>
                            <div class="bg-page-bg border border-border rounded-lg p-4">
                                @if (Item.ProjectObjectives != null && Item.ProjectObjectives.Any(o => o.ObjectiveTypeId == 1))
                                {
                                    @foreach (var obj in Item.ProjectObjectives.Where(o => o.ObjectiveTypeId == 1))
                                    {
                                        <p class="text-foreground leading-relaxed">@obj.Objective</p>
                                    }
                                }
                                else
                                {
                                    <p class="text-muted italic">Sin objetivo definido</p>
                                }
                            </div>
                        </div>
                        <!-- Línea de investigación -->
                        <div>
                            <div class="flex items-center gap-3 mb-2">
                                <div class="w-10 h-10 bg-accent/10 rounded-xl flex items-center justify-center">
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
                                         fill="currentColor" class="w-6 h-6" aria-hidden="true">
                                        <path fill-rule="evenodd" d="M10.5 3.798v5.02a3 3 0 0 1-.879 2.121l-2.377 2.377a9.845 9.845 0 0 1 5.091 1.013 8.315 8.315 0 0 0 5.713.636l.285-.071-3.954-3.955a3 3 0 0 1-.879-2.121v-5.02a23.614 23.614 0 0 0-3 0Zm4.5.138a.75.75 0 0 0 .093-1.495A24.837 24.837 0 0 0 12 2.25a25.048 25.048 0 0 0-3.093.191A.75.75 0 0 0 9 3.936v4.882a1.5 1.5 0 0 1-.44 1.06l-6.293 6.294c-1.62 1.621-.903 4.475 1.471 4.88 2.686.46 5.447.698 8.262.698 2.816 0 5.576-.239 8.262-.697 2.373-.406 3.092-3.26 1.47-4.881L15.44 9.879A1.5 1.5 0 0 1 15 8.818V3.936Z" clip-rule="evenodd" />
                                    </svg>
                                </div>
                                <h4 class="text-sm font-semibold text-muted uppercase tracking-wide">
                                    Clasificación de Categorías de Investigación
                                </h4>
                            </div>

                            @if (_projectTreeRoots.Count == 0)
                            {
                                <span class="text-muted italic">Sin categorías de investigación definidas</span>
                            }
                            else if (ResearchCategoryGroups is not null && ResearchCategoryGroups.Any()
                            && ResearchCategoryTypes is not null && ResearchCategoryTypes.Any())
                            {
                                var projectRoots = _projectTreeRoots;

                                @foreach (var group in ResearchCategoryGroups)
                                {
                                    // tipos que pertenecen a este grupo
                                    var typeIdsInGroup = ResearchCategoryTypes
                                    .Where(t => t.ResearchCategoryGroupId == group.Id)
                                    .Select(t => t.Id)
                                    .ToHashSet();

                                    // raíces del proyecto cuya rama contiene al menos un nodo de esos tipos
                                    var rootsInGroup = projectRoots
                                    .Where(r => ContainsTypeInGroup(r, typeIdsInGroup))
                                    .ToList();

                                    if (!rootsInGroup.Any())
                                    {
                                        continue;
                                    }

                                    <div class="mb-4">
                                        <div class="text-xs font-semibold text-muted uppercase mb-2">
                                            @group.Name
                                        </div>

                                        <div class="bg-page-bg border border-border rounded-lg p-4">
                                            @foreach (var root in rootsInGroup)
                                            {
                                                @RenderCategoryNode(root, 0)
                                            }
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="bg-page-bg border border-border rounded-lg p-4">
                                    @foreach (var root in _projectTreeRoots)
                                    {
                                        @RenderCategoryNode(root, 0)
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Columna derecha: Información complementaria -->
            <div class="space-y-8">

                <!-- Presupuesto -->
                <div class="bg-background border border-border rounded-xl p-6 shadow-sm">
                    <div class="flex items-center gap-3 mb-6">
                        <div class="w-10 h-10 bg-primary/10 rounded-xl flex items-center justify-center">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6">
                                <path d="M12 7.5a2.25 2.25 0 1 0 0 4.5 2.25 2.25 0 0 0 0-4.5Z" />
                                <path fill-rule="evenodd" d="M1.5 4.875C1.5 3.839 2.34 3 3.375 3h17.25c1.035 0 1.875.84 1.875 1.875v9.75c0 1.036-.84 1.875-1.875 1.875H3.375A1.875 1.875 0 0 1 1.5 14.625v-9.75ZM8.25 9.75a3.75 3.75 0 1 1 7.5 0 3.75 3.75 0 0 1-7.5 0ZM18.75 9a.75.75 0 0 0-.75.75v.008c0 .414.336.75.75.75h.008a.75.75 0 0 0 .75-.75V9.75a.75.75 0 0 0-.75-.75h-.008ZM4.5 9.75A.75.75 0 0 1 5.25 9h.008a.75.75 0 0 1 .75.75v.008a.75.75 0 0 1-.75.75H5.25a.75.75 0 0 1-.75-.75V9.75Z" clip-rule="evenodd" />
                                <path d="M2.25 18a.75.75 0 0 0 0 1.5c5.4 0 10.63.722 15.6 2.075 1.19.324 2.4-.558 2.4-1.82V18.75a.75.75 0 0 0-.75-.75H2.25Z" />
                            </svg>
                        </div>
                        <h3 class="text-lg font-semibold text-foreground">Presupuestos</h3>
                    </div>
                    @if (Item.Budgets is not null && Item.Budgets.Any())
                    {
                        <div class="space-y-4">
                            @foreach (var budget in Item.Budgets)
                            {
                                <div class="bg-page-bg border border-border rounded-lg p-4">
                                    <div class="text-xs font-semibold text-muted mb-2 uppercase tracking-wide">
                                        Monto Inicial
                                    </div>
                                    <div class="text-3xl font-bold text-foreground">
                                        @budget.InitialAmount.ToString("C", new System.Globalization.CultureInfo("es-EC"))
                                    </div>
                                </div>

                                <div class="bg-page-bg border border-border rounded-lg p-4">
                                    <div class="text-xs font-semibold text-muted mb-1 uppercase tracking-wide">
                                        Tipo de financiamiento
                                    </div>
                                    <div class="text-sm text-foreground">
                                        @budget.FundingTypeName
                                    </div>
                                </div>
                            }

                            <div class="bg-primary/5 border border-primary/20 rounded-lg p-4">
                                <div class="flex items-start gap-3">
                                    <span class="text-primary text-lg flex-shrink-0">💡</span>
                                    <div class="text-sm text-primary">
                                        <strong>Información completa:</strong> Para ver detalles del presupuesto
                                        (certificado, ejecutado, transacciones), accede a la pestaña "Presupuesto".
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="bg-muted/10 border border-muted/20 rounded-lg p-6 text-center">
                            <div class="w-16 h-16 bg-muted/20 rounded-full flex items-center justify-center mx-auto mb-4">
                                <span class="text-muted text-2xl">💰</span>
                            </div>
                            <div class="font-semibold text-muted mb-2">Sin presupuesto asignado</div>
                            <div class="text-sm text-muted/75">Este proyecto aún no tiene un presupuesto configurado</div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public ProjectDetailResponseDTO? Item { get; set; }
    [Parameter] public bool IsLoading { get; set; }

    [Parameter] public IReadOnlyList<ResearchCategoryTreeItemDTO>? ResearchCategoryTree { get; set; }
    [Parameter] public IReadOnlyList<ResearchCategoryTypeListItemDTO>? ResearchCategoryTypes { get; set; }
    [Parameter] public IReadOnlyList<CatalogListItemDTO>? ResearchCategoryGroups { get; set; }

    // índice para no recorrer el árbol mil veces
    private readonly Dictionary<int, ResearchCategoryTreeItemDTO> _allItems = new();

    // subárbol mínimo solo con las categorías del proyecto
    private readonly List<ResearchCategoryTreeItemDTO> _projectTreeRoots = new();

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        _allItems.Clear();
        _projectTreeRoots.Clear();

        if (ResearchCategoryTree is null || !ResearchCategoryTree.Any())
            return;

        foreach (var root in ResearchCategoryTree)
        {
            BuildIndexRecursive(root);
        }

        if (Item?.ResearchCategoryIds is null || !Item.ResearchCategoryIds.Any())
            return;

        foreach (var leafId in Item.ResearchCategoryIds.Distinct())
        {
            if (_allItems.TryGetValue(leafId, out var leafNode))
            {
                InsertIntoProjectTree(leafNode);
            }
        }
    }

    private bool ContainsTypeInGroup(ResearchCategoryTreeItemDTO node, HashSet<int> typeIdsInGroup)
    {
        if (typeIdsInGroup.Contains(node.ResearchCategoryTypeId))
            return true;

        foreach (var child in node.Children)
        {
            if (ContainsTypeInGroup(child, typeIdsInGroup))
                return true;
        }

        return false;
    }

    private void BuildIndexRecursive(ResearchCategoryTreeItemDTO node)
    {
        if (!_allItems.ContainsKey(node.Id))
            _allItems[node.Id] = node;

        if (node.Children is null || node.Children.Count == 0)
            return;

        foreach (var child in node.Children)
        {
            BuildIndexRecursive(child);
        }
    }

    /// <summary>
    /// Inserta un nodo (hoja) en el árbol del proyecto, reconstruyendo toda la cadena
    /// padre → ... → hoja. No duplica padres ni hojas si ya existen.
    /// </summary>
    private void InsertIntoProjectTree(ResearchCategoryTreeItemDTO node)
    {
        if (!node.ParentCategoryId.HasValue)
        {
            // Es raíz
            var existingRoot = _projectTreeRoots.FirstOrDefault(r => r.Id == node.Id);
            if (existingRoot is null)
            {
                _projectTreeRoots.Add(CloneWithoutChildren(node));
            }
            return;
        }

        // Asegurar que el padre está en el subárbol
        if (!_allItems.TryGetValue(node.ParentCategoryId.Value, out var parent))
            return;

        InsertIntoProjectTree(parent);

        var parentInProjectTree = FindNodeById(_projectTreeRoots, parent.Id);
        if (parentInProjectTree is null)
            return;

        if (!parentInProjectTree.Children.Any(c => c.Id == node.Id))
        {
            parentInProjectTree.Children.Add(CloneWithoutChildren(node));
        }
    }

    private ResearchCategoryTreeItemDTO? FindNodeById(List<ResearchCategoryTreeItemDTO> roots, int id)
    {
        foreach (var n in roots)
        {
            if (n.Id == id)
                return n;

            var found = FindNodeById(n.Children, id);
            if (found is not null)
                return found;
        }
        return null;
    }

    private ResearchCategoryTreeItemDTO CloneWithoutChildren(ResearchCategoryTreeItemDTO src)
    {
        return new ResearchCategoryTreeItemDTO
        {
            Id = src.Id,
            Name = src.Name,
            IsActive = src.IsActive,
            ResearchCategoryTypeId = src.ResearchCategoryTypeId,
            ResearchCategoryTypeName = src.ResearchCategoryTypeName,
            ParentCategoryId = src.ParentCategoryId,
            Children = new List<ResearchCategoryTreeItemDTO>()
        };
    }

    /// <summary>
    /// Render recursivo del árbol (visual anidado).
    /// </summary>
    private RenderFragment RenderCategoryNode(ResearchCategoryTreeItemDTO node, int depth) => builder =>
 {
     var seq = 0;

     builder.OpenElement(seq++, "div");
     builder.AddAttribute(seq++, "class", "mb-1");

     // Contenedor del nodo
     builder.OpenElement(seq++, "div");
     builder.AddAttribute(seq++, "class",
         $"flex items-start gap-2 text-sm text-foreground {(depth == 0 ? "font-semibold" : "font-normal")}");

     if (depth > 0)
     {
         // bolita de nivel
         builder.OpenElement(seq++, "span");
         builder.AddAttribute(seq++, "class", "mt-1 inline-block w-1.5 h-1.5 rounded-full bg-accent");
         builder.CloseElement(); // span
     }

     // Bloque texto: nombre + tipo
     builder.OpenElement(seq++, "div");
     builder.AddAttribute(seq++, "class", "flex flex-col gap-0.5");

     // Nombre de la categoría
     builder.OpenElement(seq++, "span");
     builder.AddAttribute(seq++, "class", "leading-tight");
     builder.AddContent(seq++, node.Name);
     builder.CloseElement(); // span

     if (!string.IsNullOrWhiteSpace(node.ResearchCategoryTypeName))
     {
         builder.OpenElement(seq++, "span");
         builder.AddAttribute(seq++, "class",
             "inline-flex items-center px-2 py-0.5 rounded-full text-[11px] " +
             "bg-muted/20 text-muted font-medium uppercase tracking-wide");
         builder.AddContent(seq++, node.ResearchCategoryTypeName);
         builder.CloseElement(); // span
     }

     builder.CloseElement(); // div (texto)

     builder.CloseElement(); // div (contenedor nodo)

     // Hijos
     if (node.Children.Any())
     {
         builder.OpenElement(seq++, "div");
         builder.AddAttribute(seq++, "class", "ml-4 pl-3 border-l border-border/60 mt-1 space-y-1");

         foreach (var child in node.Children)
         {
             builder.AddContent(seq++, RenderCategoryNode(child, depth + 1));
         }

         builder.CloseElement(); // div hijos
     }
     
     builder.CloseElement(); // div wrapper
 };
}