@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@using tesisproject.shared.DTOs.Algorithms.Response
@using tesisproject.shared.DTOs.External
@using tesisproject.shared.DTOs.Filters
@using tesisproject.frontend.SharedUI.FileUpload
@using tesisproject.frontend.SharedUI.ActionButton
@using tesisproject.frontend.SharedUI.TextInput

<div class="w-full flex flex-col gap-6">
    <!-- Descripción -->
    <section class="flex flex-col gap-2">
        <h3 class="text-lg font-semibold">Step 2: DIDE project form</h3>
        <p class="text-sm text-muted">
            Upload the DIDE project form (FORMATO DIDE-PRY-002-2020). The system will extract
            project name, research lines, research type, researchers, objectives and activities.
            You can review and adjust the extracted information before proceeding.
        </p>
    </section>

    <!-- Layout principal: upload + campos generales -->
    <section class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Columna: Upload -->
        <div class="lg:col-span-1">
            <h4 class="text-sm font-semibold mb-2">Upload DIDE project form (PDF)</h4>

            <FileUpload ContainerClass="w-full"
                        UploadText="Click to upload or drag & drop"
                        AcceptedTypes=".pdf,application/pdf"
                        MaxFileSizeMB="10"
                        AllowRemove="true"
                        IsDisabled="@IsBusy"
                        ShowProgress="false"
                        OnFileSelected="HandleFileSelected" />

            <p class="mt-2 text-xs text-muted">
                Supported format: PDF. Maximum size: 10 MB.
            </p>
        </div>

        <!-- Columna: Datos generales del proyecto -->
        <div class="lg:col-span-2">
            <h4 class="text-sm font-semibold mb-3">General project data</h4>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <TextInput Label="Project name"
                           Value="@DideModel.ProjectName"
                           ValueChanged="val => DideModel.ProjectName = val ?? string.Empty"
                           Placeholder="Project title as in the DIDE form"
                           Disabled="@IsBusy"
                           Required="true" />

                <!-- Research type (selector) -->
                <div class="flex flex-col gap-1">
                    <label class="text-xs font-medium text-foreground">Research type</label>
                    <select class="border border-border rounded px-2 py-1 text-sm bg-background"
                            disabled="@IsBusy"
                            value="@GetResearchTypeIdValue()"
                            @onchange="HandleResearchTypeChanged">
                        <option value="">Select research type...</option>

                        @if (ResearchTypeOptions is not null)
                        {
                            @foreach (var item in ResearchTypeOptions)
                            {
                                <option value="@item.Id">@item.Name</option>
                            }
                        }
                    </select>
                    <span class="text-[11px] text-muted">
                        E.g. Aplicada, Experimental, etc. (mapped from catalog).
                    </span>
                </div>
            </div>

            <!-- Líneas de investigación -->
            <div class="mt-4">
                <h5 class="text-sm font-semibold mb-2">Research lines</h5>

                @if (DideModel.ResearchLines?.Any() == true)
                {
                    @for (int i = 0; i < DideModel.ResearchLines.Count; i++)
                    {
                        var index = i;
                        <div class="mb-2">
                            <TextInput Label="@($"Research line #{index + 1}")"
                                       Value="@DideModel.ResearchLines[index]"
                                       ValueChanged="val => DideModel.ResearchLines[index] = val ?? string.Empty"
                                       Disabled="@IsBusy" />
                        </div>
                    }
                }
                else
                {
                    <p class="text-xs text-muted">
                        No research lines detected yet. They will appear here after processing the DIDE PDF.
                    </p>
                }
            </div>
        </div>
    </section>

    <!-- Investigadores -->
    <section class="mt-2">
        <h4 class="text-sm font-semibold mb-3">Researchers</h4>

        @if (DideModel.Researchers?.Any() == true)
        {
            <div class="space-y-3">
                @for (int i = 0; i < DideModel.Researchers.Count; i++)
                {
                    var index = i;
                    var researcher = DideModel.Researchers[index];

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 border border-border rounded-md p-3">
                        <!-- Role selector -->
                        <div class="flex flex-col gap-1">
                            <label class="text-xs font-medium text-foreground">Role</label>
                            <select class="border border-border rounded px-2 py-1 text-sm bg-background"
                                    disabled="@IsBusy"
                                    value="@researcher.Role"
                                    @onchange="e => HandleResearcherRoleChanged(index, e)">
                                <option value="0">Select role...</option>

                                @if (MemberRoleTypeOptions is not null)
                                {
                                    @foreach (var item in MemberRoleTypeOptions)
                                    {
                                        <option value="@item.Id">@item.Name</option>
                                    }
                                }
                            </select>
                            @if (!string.IsNullOrWhiteSpace(researcher.RoleName))
                            {
                                <span class="text-[11px] text-muted">
                                    Detected: @researcher.RoleName
                                </span>
                            }
                        </div>

                        <TextInput Label="Full name"
                                   Value="@researcher.FullName"
                                   ValueChanged="val => DideModel.Researchers[index].FullName = val ?? string.Empty"
                                   Disabled="@IsBusy" />

                        <TextInput Label="Email"
                                   Value="@researcher.email"
                                   ValueChanged="val => DideModel.Researchers[index].email = val ?? string.Empty"
                                   Disabled="@IsBusy" />

                        <!-- Faculty selector (solo facultad, guardando facultyId en FacultyCareerId) -->
                        <div class="flex flex-col gap-1">
                            <label class="text-xs font-medium text-foreground">Faculty</label>
                            <select class="border border-border rounded px-2 py-1 text-sm bg-background"
                                    disabled="@IsBusy"
                                    value="@GetSelectedFacultyValue(index)"
                                    @onchange="e => HandleFacultyChanged(index, e)">

                                <option value="">Select faculty...</option>

                                @if (Faculties is not null)
                                {
                                    @foreach (var faculty in Faculties)
                                    {
                                        <option value="@faculty.FacultyId">
                                            @faculty.Acronym - @faculty.Name
                                        </option>
                                    }
                                }
                            </select>
                            <span class="text-[11px] text-muted">
                                This value will be stored as FacultyCareerId (faculty Id).
                            </span>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="text-xs text-muted">
                No researchers detected yet. They will appear here after processing the DIDE PDF.
            </p>
        }
    </section>

    <!-- Objetivos -->
    <section class="mt-4">
        <h4 class="text-sm font-semibold mb-3">Objectives & Activities</h4>

        <ObjectivesActivitiesEditor Objectives="DideModel.Objectives" />
    </section>

</div>

@code {
    [Parameter] public DideProjectFormInfo DideModel { get; set; } = new();
    [Parameter] public bool IsBusy { get; set; }

    [Parameter] public IReadOnlyList<ExternalFacultyDTO> Faculties { get; set; } = Array.Empty<ExternalFacultyDTO>();

    // Catálogos recibidos desde el padre
    [Parameter] public IReadOnlyList<KeyValueItemDTO> ResearchTypeOptions { get; set; } = Array.Empty<KeyValueItemDTO>();
    [Parameter] public IReadOnlyList<KeyValueItemDTO> MemberRoleTypeOptions { get; set; } = Array.Empty<KeyValueItemDTO>();
    [Parameter] public IReadOnlyList<KeyValueItemDTO> ObjectiveTypeOptions { get; set; } = Array.Empty<KeyValueItemDTO>();

    // Eventos hacia el Main
    [Parameter] public EventCallback<IBrowserFile> OnFileSelected { get; set; }
    [Parameter] public EventCallback OnPrevious { get; set; }
    [Parameter] public EventCallback OnNext { get; set; }

    protected override void OnParametersSet()
    {
        DideModel.ResearchLines ??= new List<string>();
        DideModel.Researchers ??= new List<ResearcherInfo>();
        DideModel.Objectives ??= new List<DideObjectiveInfo>();

        NormalizeFacultyIdsFromLegacyPrograms();
    }

    /// <summary>
    /// Si FacultyCareerId viene con programId, lo convierte a facultyId.
    /// Si ya es facultyId, lo deja igual.
    /// </summary>
    private void NormalizeFacultyIdsFromLegacyPrograms()
    {
        if (DideModel.Researchers is null || Faculties is null || !Faculties.Any())
            return;

        for (int i = 0; i < DideModel.Researchers.Count; i++)
        {
            var researcher = DideModel.Researchers[i];
            var rawId = researcher.FacultyCareerId;

            var facultyId = ResolveFacultyId(rawId);

            researcher.FacultyCareerId = facultyId ?? 0;
            DideModel.Researchers[i] = researcher;
        }
    }

    /// <summary>
    /// Devuelve el facultyId a partir de un Id que puede ser:
    /// - directamente un facultyId
    /// - o un programId (career) que hay que mapear a su facultad
    /// </summary>
    private int? ResolveFacultyId(int rawId)
    {
        if (rawId <= 0 || Faculties is null || !Faculties.Any())
            return null;

        // 1) Id ya es una facultad
        var faculty = Faculties.FirstOrDefault(f => f.FacultyId == rawId);
        if (faculty is not null)
            return faculty.FacultyId;

        // 2) Caso legacy: es un programId
        foreach (var f in Faculties)
        {
            if (f.Programs is null) continue;

            if (f.Programs.Any(p => p.ProgramId == rawId))
                return f.FacultyId;
        }

        return null;
    }

    private string GetSelectedFacultyValue(int index)
    {
        if (DideModel.Researchers is null || index < 0 || index >= DideModel.Researchers.Count)
            return string.Empty;

        var id = DideModel.Researchers[index].FacultyCareerId;
        return id > 0 ? id.ToString() : string.Empty;
    }

    private void HandleFacultyChanged(int index, ChangeEventArgs e)
    {
        if (DideModel.Researchers is null || index < 0 || index >= DideModel.Researchers.Count)
            return;

        var value = e.Value?.ToString();

        if (int.TryParse(value, out var facultyId) && facultyId > 0)
        {
            DideModel.Researchers[index].FacultyCareerId = facultyId;
        }
        else
        {
            DideModel.Researchers[index].FacultyCareerId = 0;
        }
    }

    private async Task HandleFileSelected(IBrowserFile file)
    {
        if (OnFileSelected.HasDelegate)
        {
            await OnFileSelected.InvokeAsync(file);
        }
    }

    // ==========================
    // Helpers ResearchType
    // ==========================

    private string GetResearchTypeIdValue()
    {
        return DideModel.ResearchTypeId.HasValue && DideModel.ResearchTypeId.Value > 0
            ? DideModel.ResearchTypeId.Value.ToString()
            : string.Empty;
    }

    private void HandleResearchTypeChanged(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();

        if (int.TryParse(value, out var id))
        {
            DideModel.ResearchTypeId = id;
        }
        else
        {
            DideModel.ResearchTypeId = null;
        }
    }

    // ==========================
    // Helpers Researchers
    // ==========================

    private void HandleResearcherRoleChanged(int index, ChangeEventArgs e)
    {
        if (index < 0 || index >= DideModel.Researchers.Count)
            return;

        if (int.TryParse(e.Value?.ToString(), out var id))
        {
            DideModel.Researchers[index].Role = id;
        }
        else
        {
            DideModel.Researchers[index].Role = 0;
        }
    }

    private void HandleObjectiveTypeChanged(int index, ChangeEventArgs e)
    {
        if (DideModel.Objectives is null || index < 0 || index >= DideModel.Objectives.Count)
            return;

        var value = e.Value?.ToString();

        if (int.TryParse(value, out var id) && id > 0)
        {
            DideModel.Objectives[index].ObjectiveType = id;
        }
        else
        {
            DideModel.Objectives[index].ObjectiveType = 0;
        }
    }

    // ==========================
    // Helpers numéricos
    // ==========================

    private static int ParseIntOrDefault(string? input, int defaultValue = 0)
    {
        if (int.TryParse(input, out var value))
            return value;

        return defaultValue;
    }
}
