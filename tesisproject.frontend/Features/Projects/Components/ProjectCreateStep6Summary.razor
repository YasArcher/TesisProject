@using Microsoft.AspNetCore.Components
@using tesisproject.shared.DTOs.Algorithms.Response
@using tesisproject.shared.DTOs.Catalog.Common.Response
@using tesisproject.shared.DTOs.Catalog.MemberRoleType.Response
@using tesisproject.shared.DTOs.External
@using tesisproject.shared.DTOs.Catalog.ResearchCategory.Response
@using tesisproject.frontend.Utils
@using tesisproject.shared.DTOs.Budgets.Request

<div class="w-full min-w-0 flex flex-col gap-3">

    <!-- Grid principal -->
    <section class="grid grid-cols-1 xl:grid-cols-[320px_minmax(0,1fr)] gap-3">
        <!-- Resolución -->
        <div class="rounded-lg border border-border bg-background overflow-hidden">
            <div class="px-3 py-2 border-b border-border bg-primary/5">
                <div class="flex items-center gap-2">
                    <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                    <h4 class="text-sm font-semibold text-foreground">Resolución</h4>
                </div>
            </div>

            <div class="p-3 space-y-2 text-sm">
                <div>
                    <span class="text-[11px] font-medium text-muted block">Código</span>
                    <span class="text-foreground">@DisplayOrDash(ResolutionModel.ResolutionCode)</span>
                </div>

                <div>
                    <span class="text-[11px] font-medium text-muted block">Tipo de documento</span>
                    <span class="text-foreground">@DisplayOrDash(GetDocumentTypeName(ResolutionModel.documentTypeId))</span>
                </div>

                <div>
                    <span class="text-[11px] font-medium text-muted block">Convocatoria</span>
                    <span class="text-foreground">@DisplayOrDash(ConvocationName)</span>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                    <div>
                        <span class="text-[11px] font-medium text-muted block">Fecha resolución</span>
                        <span class="text-foreground">@DisplayOrDash(ResolutionModel.ResolutionHeaderDate)</span>
                    </div>

                    <div>
                        <span class="text-[11px] font-medium text-muted block">Fecha reunión</span>
                        <span class="text-foreground">@DisplayOrDash(ResolutionModel.MeetingDate)</span>
                    </div>

                    <div>
                        <span class="text-[11px] font-medium text-muted block">Inicio ejecución</span>
                        <span class="text-foreground">@DisplayOrDash(ResolutionModel.ExecutionStartDate)</span>
                    </div>

                    <div>
                        <span class="text-[11px] font-medium text-muted block">Duración</span>
                        <span class="text-foreground">
                            @(ResolutionModel.Duration > 0 ? $"{ResolutionModel.Duration} meses" : "-")
                        </span>
                    </div>
                </div>

                <div class="pt-2 border-t border-border space-y-1.5">
                    <div class="flex items-center justify-between gap-2">
                        <span class="text-[11px] font-medium text-muted">Presupuesto total</span>
                        <span class="text-sm font-bold text-secondary">
                            @FormatCurrency(GetTotalBudget())
                        </span>
                    </div>

                    @if (Budgets?.Any(b => b.InitialAmount > 0 && b.FundingTypeId > 0) == true)
                    {
                        <div class="space-y-1">
                            @foreach (var b in Budgets.Where(b => b.InitialAmount > 0 && b.FundingTypeId > 0))
                            {
                                <div class="flex items-center justify-between gap-2 text-xs">
                                    <span class="text-muted truncate">
                                        @DisplayOrDash(GetFundingTypeName(b.FundingTypeId))
                                    </span>
                                    <span class="font-medium text-foreground whitespace-nowrap">
                                        @FormatCurrency(b.InitialAmount)
                                    </span>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-[11px] text-muted italic">No hay presupuestos registrados</p>
                    }
                </div>
            </div>
        </div>

        <!-- Proyecto -->
        <div class="rounded-lg border border-border bg-background overflow-hidden">
            <div class="px-3 py-2 border-b border-border bg-secondary/5">
                <div class="flex items-center gap-2">
                    <svg class="w-4 h-4 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                    </svg>
                    <h4 class="text-sm font-semibold text-foreground">Proyecto</h4>
                </div>
            </div>

            <div class="p-3 space-y-3 text-sm">
                <div>
                    <span class="text-[11px] font-medium text-muted block mb-1">Nombre</span>
                    <p class="text-foreground font-medium break-words">
                        @DisplayOrDash(DideModel.ProjectName)
                    </p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-2">
                    <div>
                        <span class="text-[11px] font-medium text-muted block">Tipo de investigación</span>
                        <span class="text-foreground">@DisplayOrDash(GetResearchTypeName(DideModel.ResearchTypeId))</span>
                    </div>

                    <div>
                        <span class="text-[11px] font-medium text-muted block">Facultad del proyecto</span>
                        <span class="text-foreground">@DisplayOrDash(GetProjectFacultyDisplayName())</span>
                    </div>
                </div>

                <div>
                    <span class="text-[11px] font-medium text-muted block mb-1">Líneas detectadas</span>
                    @if (DideModel.ResearchLines?.Any() == true)
                    {
                        <div class="flex flex-wrap gap-1">
                            @foreach (var line in DideModel.ResearchLines)
                            {
                                <span class="px-2 py-0.5 text-[11px] rounded bg-accent/10 text-foreground border border-accent/20">
                                    @(string.IsNullOrWhiteSpace(line) ? "-" : line)
                                </span>
                            }
                        </div>
                    }
                    else
                    {
                        <span class="text-muted">-</span>
                    }
                </div>

                <div class="pt-2 border-t border-border">
                    <div class="flex items-center justify-between gap-2 mb-2">
                        <span class="text-[11px] font-semibold text-foreground">Categorías</span>
                        @if (GetVisibleCategories().Any())
                        {
                            <span class="px-2 py-0.5 text-[11px] font-medium rounded-full bg-secondary text-white">
                                @GetVisibleCategories().Count
                            </span>
                        }
                    </div>

                    @if (GetVisibleCategories().Any())
                    {
                        <div class="space-y-1 max-h-28 overflow-auto pr-1">
                            @foreach (var cat in GetVisibleCategories())
                            {
                                <div class="flex items-center gap-2 text-[11px]">
                                    <span class="w-1.5 h-1.5 rounded-full bg-secondary shrink-0"></span>
                                    @if (!string.IsNullOrWhiteSpace(cat.ResearchCategoryTypeName))
                                    {
                                        <span class="text-muted">@cat.ResearchCategoryTypeName:</span>
                                    }
                                    <span class="text-foreground break-words">@DisplayOrDash(cat.Name)</span>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-[11px] text-muted italic">No hay categorías seleccionadas</p>
                    }
                </div>

                <div class="pt-2 border-t border-border">
                    <div class="flex items-center justify-between gap-2 mb-2">
                        <span class="text-[11px] font-semibold text-foreground">Investigadores</span>
                        @if (DideModel.Researchers?.Any() == true)
                        {
                            <span class="px-2 py-0.5 text-[11px] font-medium rounded-full bg-primary text-white">
                                @DideModel.Researchers.Count
                            </span>
                        }
                    </div>

                    @if (DideModel.Researchers?.Any() == true)
                    {
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-2 max-h-36 overflow-auto pr-1">
                            @foreach (var r in DideModel.Researchers)
                            {
                                <div class="flex items-start gap-2 p-2 rounded-md border border-border bg-background">
                                    <div class="w-7 h-7 rounded-full bg-primary/10 flex items-center justify-center shrink-0">
                                        <svg class="w-3.5 h-3.5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                  d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                                        </svg>
                                    </div>

                                    <div class="min-w-0 flex-1">
                                        <p class="text-xs font-medium text-foreground truncate">
                                            @DisplayOrDash(r.FullName)
                                        </p>
                                        <p class="text-[10px] text-muted truncate">
                                            @DisplayOrDash(GetMemberRoleName(r.Role, r.RoleName))
                                        </p>
                                        <p class="text-[10px] text-muted truncate">
                                            @DisplayOrDash(r.email)
                                        </p>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-[11px] text-muted italic">No se detectaron investigadores</p>
                    }
                </div>
            </div>
        </div>
    </section>

    <!-- Objetivos -->
    <section class="rounded-lg border border-border bg-background overflow-hidden">
        <div class="px-3 py-2 border-b border-border bg-accent/5 flex items-center justify-between gap-2">
            <div class="flex items-center gap-2 min-w-0">
                <svg class="w-4 h-4 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
                </svg>
                <h4 class="text-sm font-semibold text-foreground truncate">Objetivos</h4>
            </div>

            <span class="px-2 py-0.5 text-[11px] font-medium rounded-full bg-accent/20 text-foreground whitespace-nowrap">
                @(DideModel.Objectives?.Count ?? 0)
            </span>
        </div>

        <div class="p-3">
            @if (DideModel.Objectives?.Any() == true)
            {
                <div class="space-y-2 max-h-56 overflow-auto pr-1">
                    @for (int i = 0; i < DideModel.Objectives.Count; i++)
                    {
                        var obj = DideModel.Objectives[i];

                        <div class="rounded-md border border-border p-3">
                            <div class="flex items-start gap-3">
                                <div class="w-6 h-6 rounded bg-accent/10 flex items-center justify-center shrink-0 text-[11px] font-bold text-accent">
                                    @(i + 1)
                                </div>

                                <div class="flex-1 min-w-0">
                                    <div class="flex flex-wrap items-center gap-1.5 mb-1.5">
                                        <span class="px-1.5 py-0.5 text-[10px] font-medium rounded bg-primary/10 text-primary">
                                            @DisplayOrDash(GetObjectiveTypeName(obj.ObjectiveType))
                                        </span>

                                        @if (obj.Activities?.Any() == true)
                                        {
                                            <span class="px-1.5 py-0.5 text-[10px] font-medium rounded bg-secondary/10 text-secondary">
                                                @obj.Activities.Count actividades
                                            </span>
                                        }
                                    </div>

                                    <p class="text-xs text-foreground break-words">
                                        @DisplayOrDash(obj.ObjectiveText)
                                    </p>

                                    @if (obj.Activities?.Any() == true)
                                    {
                                        <details class="mt-2">
                                            <summary class="cursor-pointer text-[10px] text-muted hover:text-primary transition-colors">
                                                Ver actividades
                                            </summary>

                                            <ul class="mt-1.5 space-y-1 pl-3 border-l-2 border-secondary/30">
                                                @foreach (var act in obj.Activities)
                                                {
                                                    <li class="text-[10px] text-foreground">
                                                        @DisplayOrDash(act.ActivityText)
                                                    </li>
                                                }
                                            </ul>
                                        </details>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="flex items-center justify-center py-6 text-center">
                    <p class="text-xs text-muted">No se detectaron objetivos.</p>
                </div>
            }
        </div>
    </section>
</div>

@code {
    [Parameter] public ResolutionInfo ResolutionModel { get; set; } = new();
    [Parameter] public DideProjectFormInfo DideModel { get; set; } = new();
    [Parameter] public int? CoordinatorRoleId { get; set; }

    [Parameter] public IReadOnlyList<CatalogListItemDTO> DocumentTypeOptions { get; set; } = Array.Empty<CatalogListItemDTO>();
    [Parameter] public IReadOnlyList<CatalogListItemDTO> ResearchTypeOptions { get; set; } = Array.Empty<CatalogListItemDTO>();
    [Parameter] public IReadOnlyList<MemberRoleTypeListItemDTO> MemberRoleTypeOptions { get; set; } = Array.Empty<MemberRoleTypeListItemDTO>();
    [Parameter] public IReadOnlyList<CatalogListItemDTO> ObjectiveTypeOptions { get; set; } = Array.Empty<CatalogListItemDTO>();
    [Parameter] public IReadOnlyList<ExternalFacultyDTO> Faculties { get; set; } = Array.Empty<ExternalFacultyDTO>();
    [Parameter] public string? ConvocationName { get; set; }

    [Parameter] public IReadOnlyList<CatalogListItemDTO> FundingTypeOptions { get; set; } = Array.Empty<CatalogListItemDTO>();
    [Parameter] public IReadOnlyList<CreateBudgetRequestDTO> Budgets { get; set; } = Array.Empty<CreateBudgetRequestDTO>();
    [Parameter] public IReadOnlyList<ResearchCategoryTreeItemDTO> SelectedResearchCategories { get; set; } = Array.Empty<ResearchCategoryTreeItemDTO>();

    private static string DisplayOrDash(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static string DisplayOrDash(DateTime? value)
    {
        if (!value.HasValue) return "-";
        var text = value.ToSpanishShortDate();
        return string.IsNullOrWhiteSpace(text) ? "-" : text;
    }

    private decimal GetTotalBudget()
    {
        if (Budgets is null || Budgets.Count == 0)
            return 0m;

        return Budgets
            .Where(b => b.InitialAmount > 0 && b.FundingTypeId > 0)
            .Sum(b => b.InitialAmount);
    }

    private static string FormatCurrency(decimal amount) =>
        amount > 0 ? $"${amount:N2}" : "-";

    private string GetDocumentTypeName(int id)
    {
        if (id <= 0 || DocumentTypeOptions is null) return string.Empty;
        return DocumentTypeOptions.FirstOrDefault(x => x.Id == id)?.Name ?? string.Empty;
    }

    private string GetResearchTypeName(int? id)
    {
        if (!id.HasValue || id.Value <= 0 || ResearchTypeOptions is null) return string.Empty;
        return ResearchTypeOptions.FirstOrDefault(x => x.Id == id.Value)?.Name ?? string.Empty;
    }

    private string GetMemberRoleName(int id, string? fallback)
    {
        if (id > 0 && MemberRoleTypeOptions is not null)
        {
            var item = MemberRoleTypeOptions.FirstOrDefault(x => x.Id == id);
            if (!string.IsNullOrWhiteSpace(item?.Name)) return item!.Name;
        }

        return !string.IsNullOrWhiteSpace(fallback) ? fallback : string.Empty;
    }

    private string GetObjectiveTypeName(int id)
    {
        if (id <= 0 || ObjectiveTypeOptions is null) return string.Empty;
        return ObjectiveTypeOptions.FirstOrDefault(x => x.Id == id)?.Name ?? string.Empty;
    }

    private string GetFundingTypeName(int id)
    {
        if (id <= 0 || FundingTypeOptions is null) return string.Empty;
        return FundingTypeOptions.FirstOrDefault(x => x.Id == id)?.Name ?? string.Empty;
    }

    private List<ResearchCategoryTreeItemDTO> GetVisibleCategories()
    {
        return FlattenCategories(SelectedResearchCategories ?? Array.Empty<ResearchCategoryTreeItemDTO>())
            .GroupBy(x => x.Id)
            .Select(g => g.First())
            .ToList();
    }

    private IEnumerable<ResearchCategoryTreeItemDTO> FlattenCategories(IEnumerable<ResearchCategoryTreeItemDTO> roots)
    {
        foreach (var node in roots)
        {
            yield return node;

            if (node.Children is { Count: > 0 })
            {
                foreach (var child in FlattenCategories(node.Children))
                    yield return child;
            }
        }
    }

    private (string FacultyLabel, string ProgramLabel) ResolveFacultyAndProgram(int facultyCareerId)
    {
        if (facultyCareerId <= 0 || Faculties is null || Faculties.Count == 0)
            return ("No asignado", "No asignado");

        foreach (var faculty in Faculties)
        {
            if (faculty.Programs is null)
                continue;

            var program = faculty.Programs.FirstOrDefault(p => p.ProgramId == facultyCareerId);
            if (program is not null)
            {
                var facultyText = string.IsNullOrWhiteSpace(faculty.Acronym)
                    ? faculty.Name
                    : $"{faculty.Acronym} - {faculty.Name}";

                return (facultyText, program.Name);
            }
        }

        var fac = Faculties.FirstOrDefault(f => f.FacultyId == facultyCareerId);
        if (fac is not null)
        {
            var facultyText = string.IsNullOrWhiteSpace(fac.Acronym)
                ? fac.Name
                : $"{fac.Acronym} - {fac.Name}";

            return (facultyText, "No asignado");
        }

        return ("Facultad desconocida", "Carrera desconocida");
    }

    private string GetProjectFacultyDisplayName()
    {
        if (DideModel?.Researchers is null || DideModel.Researchers.Count == 0)
            return string.Empty;

        if (Faculties is null || Faculties.Count == 0)
            return string.Empty;

        if (!CoordinatorRoleId.HasValue || CoordinatorRoleId.Value <= 0)
            return string.Empty;

        var coordinator = DideModel.Researchers
            .FirstOrDefault(r => r.Role == CoordinatorRoleId.Value);

        if (coordinator is null || coordinator.FacultyCareerId <= 0)
            return string.Empty;

        var facultyProgram = ResolveFacultyAndProgram(coordinator.FacultyCareerId);
        return facultyProgram.FacultyLabel;
    }
}