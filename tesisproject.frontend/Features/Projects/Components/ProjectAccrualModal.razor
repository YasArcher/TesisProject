@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@using tesisproject.shared.DTOs.Budgets.Request
@using tesisproject.frontend.SharedUI.Modal
@using tesisproject.frontend.SharedUI.ActionButton
@using tesisproject.frontend.SharedUI.TextInput
@using tesisproject.frontend.SharedUI.DateInput

<Modal Id="AccrualModal"
       Title="Devengar transacción"
       IsOpen="@IsOpen"
       ShowCloseButton="true"
       CloseOnBackdrop="true"
       CloseOnEscape="true"
       Size="ModalSize.Md"
       OnClose="Close"
       IsOpenChanged="IsOpenChanged">

    <ChildContent>
        <EditForm Model="_model" OnValidSubmit="HandleSubmit">
            <DataAnnotationsValidator />

            @if (!string.IsNullOrWhiteSpace(ErrorMessage))
            {
                <div class="mb-3 text-sm text-error">@ErrorMessage</div>
            }

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <!-- Fecha de devengo -->
                <div>
                    <DateInput Label="Fecha de devengo"
                               Value="@_executedDate"
                               ValueChanged="OnExecutedDateChanged"
                               Disabled="@IsSaving" />
                    <p class="mt-1 text-xs text-muted">Vacío = hoy (UTC)</p>
                </div>

                <!-- CUR (opcional) -->
                <div>
                    <TextInput Label="CUR (opcional)"
                               Placeholder="Ej.: 120-2025-000123"
                               Value="@_model.CURNumber"
                               ValueChanged="(v => _model.CURNumber = v)"
                               MaxLength="50"
                               Disabled="@IsSaving" />
                </div>
            </div>
        </EditForm>
    </ChildContent>

    <Footer>
        <div class="flex justify-end gap-2">
            <ActionButton Text="Cancelar"
                          Variant="ButtonVariant.Ghost"
                          Intent="ButtonIntent.Neutral"
                          Size="ButtonSize.Sm"
                          Disabled="@IsSaving"
                          Execute="Close"
                          Class="btn-primary-ghost" />
            <ActionButton Text="@(IsSaving ? "Devengando..." : "Confirmar devengo")"
                          Variant="ButtonVariant.Filled"
                          Intent="ButtonIntent.Accept"
                          Size="ButtonSize.Sm"
                          Disabled="@IsSaving"
                          Execute="HandleSubmit"
                          Class="btn-primary-solid" />
        </div>
    </Footer>
</Modal>

@code {
    // Parámetros (padre)
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public bool IsSaving { get; set; }
    [Parameter] public string? ErrorMessage { get; set; }
    [Parameter] public ExecuteDevengadoRequestDTO? Value { get; set; }
    [Parameter] public EventCallback<ExecuteDevengadoRequestDTO> OnSubmit { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private ExecuteDevengadoRequestDTO _model = new();

    // DateInput trabaja con DateOnly?
    private DateOnly? _executedDate;

    protected override void OnParametersSet()
    {
        if (IsOpen)
        {
            _model = Value is not null
                ? new ExecuteDevengadoRequestDTO
                {
                    BudgetTransactionId = Value.BudgetTransactionId,
                    CURNumber = Value.CURNumber,
                }
                : new ExecuteDevengadoRequestDTO();

            // Sincroniza DTO(DateTime?) -> UI(DateOnly?)
            _executedDate = _model.ExecutedAt.HasValue
                ? DateOnly.FromDateTime(DateTime.SpecifyKind(_model.ExecutedAt.Value, DateTimeKind.Utc))
                : (DateOnly?)null;
        }
    }

    private Task OnExecutedDateChanged(DateOnly? d)
    {
        _executedDate = d;
        // UI(DateOnly?) -> DTO(DateTime? en UTC a las 00:00)
        _model.ExecutedAt = d.HasValue
            ? new DateTime(d.Value.Year, d.Value.Month, d.Value.Day, 0, 0, 0, DateTimeKind.Utc)
            : (DateTime?)null;
        return Task.CompletedTask;
    }

    private async Task HandleSubmit()
    {
        if (IsSaving) return;
        if (OnSubmit.HasDelegate)
            await OnSubmit.InvokeAsync(_model);
    }

    private async Task Close()
    {
        if (IsSaving) return;
        if (OnCancel.HasDelegate)
            await OnCancel.InvokeAsync();
        if (IsOpenChanged.HasDelegate)
            await IsOpenChanged.InvokeAsync(false);
    }
}
