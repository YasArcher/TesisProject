@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@using System.ComponentModel.DataAnnotations
@using tesisproject.frontend.SharedUI.DateInput
@using tesisproject.shared.DTOs.Budgets.Request
@using tesisproject.frontend.SharedUI.Modal
@using tesisproject.frontend.SharedUI.ActionButton
@using tesisproject.frontend.SharedUI.TextInput

<Modal Id="AccrualModal"
       Title="Devengar transacción"
       IsOpen="@IsOpen"
       ShowCloseButton="true"
       CloseOnBackdrop="true"
       CloseOnEscape="true"
       Size="ModalSize.Md"
       OnClose="Close"
       IsOpenChanged="IsOpenChanged">

    <ChildContent>
        <EditForm EditContext="_editContext">
            <DataAnnotationsValidator />
            <div class="space-y-4">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <!-- Monto devengado -->
                    <div>
                        <label class="block text-sm font-medium text-foreground mb-1">
                            Monto devengado *
                        </label>
                        <InputNumber @bind-Value="_model.ExecutedAmount"
                                     class="w-full rounded-md border border-border px-3 py-2 text-sm
                                            focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary
                                            disabled:opacity-60"
                                     disabled="@IsSaving" />
                        <ValidationMessage For="@(() => _model.ExecutedAmount)" />
                    </div>

                    <!-- CUR -->
                    <div>
                        <TextInput TValue="string"
                                   Label="CUR *"
                                   Placeholder="Ej.: 000123"
                                   @bind-Value="_model.CURNumber"
                                   For="@(() => _model.CURNumber)"
                                   Required="true"
                                   MaxLength="100"
                                   Disabled="@IsSaving" />

                    </div>
                </div>

                                <!-- Fecha de devengo (opcional: vacío = hoy) -->
                <div>
                    <DateInput Label="Fecha de devengo"
                               Value="@_executedDate"
                               ValueChanged="OnExecutedDateChanged"
                               Disabled="@IsSaving" />
                    <p class="mt-1 text-xs text-muted">
                        Vacío = hoy (UTC)
                    </p>
                </div>

                <!-- Descripción del devengo -->
                <div>
                    <label class="block text-sm font-medium text-foreground mb-1">
                        Descripción del devengo *
                    </label>
                    <textarea class="w-full rounded-md border border-border px-3 py-2 text-sm
                                     focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary
                                     disabled:opacity-60"
                              @bind="_model.ExecutionDescription"
                              maxlength="1000"
                              rows="4"
                              disabled="@IsSaving">
                    </textarea>
                    <ValidationMessage For="@(() => _model.ExecutionDescription)" />
                    <p class="mt-1 text-xs text-muted">
                        Máximo 1000 caracteres.
                    </p>
                </div>
            </div>
        </EditForm>
    </ChildContent>

    <Footer>
        <div class="flex justify-end gap-2">
            <ActionButton Text="Cancelar"
                          Variant="ButtonVariant.Ghost"
                          Intent="ButtonIntent.Neutral"
                          Size="ButtonSize.Sm"
                          Disabled="@IsSaving"
                          Execute="Close"
                          Class="btn-primary-ghost" />

            <ActionButton Text="@(IsSaving ? "Devengando..." : "Confirmar devengo")"
                          Variant="ButtonVariant.Filled"
                          Intent="ButtonIntent.Accept"
                          Size="ButtonSize.Sm"
                          Disabled="@IsSaving"
                          Execute="OnSaveClick"
                          Class="btn-primary-solid" />
        </div>
    </Footer>
</Modal>

@code {
    // Parámetros (padre)
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public bool IsSaving { get; set; }
    [Parameter] public ExecuteDevengadoRequestDTO? Value { get; set; }
    [Parameter] public EventCallback<ExecuteDevengadoRequestDTO> OnSubmit { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private ExecuteDevengadoRequestDTO _model = new();
    private EditContext _editContext = default!;
    private DateOnly? _executedDate;
    private bool _wasOpen;

    protected override void OnParametersSet()
    {
        // Solo inicializar CUANDO se abre el modal
        if (IsOpen && (!_wasOpen || _editContext is null))
        {
            _model = Value is not null
                ? new ExecuteDevengadoRequestDTO
                {
                    BudgetTransactionId = Value.BudgetTransactionId,
                    ExecutedAmount = Value.ExecutedAmount,
                    CURNumber = Value.CURNumber,
                    ExecutionDescription = Value.ExecutionDescription,
                    ExecutedAt = Value.ExecutedAt
                }
                : new ExecuteDevengadoRequestDTO
                {
                    BudgetTransactionId = Value?.BudgetTransactionId ?? 0
                };

            _executedDate = _model.ExecutedAt.HasValue
                ? DateOnly.FromDateTime(_model.ExecutedAt.Value)
                : (DateOnly?)null;

            _editContext = new EditContext(_model);
            _editContext.OnValidationStateChanged += (_, __) => InvokeAsync(StateHasChanged);
        }

        _wasOpen = IsOpen;
    }

    private async Task OnSaveClick()
    {
        if (IsSaving) return;

        if (_editContext.Validate())
        {
            if (OnSubmit.HasDelegate)
                await OnSubmit.InvokeAsync(_model);
        }
    }

    private async Task Close()
    {
        if (IsSaving) return;

        if (OnCancel.HasDelegate)
            await OnCancel.InvokeAsync();

        if (IsOpenChanged.HasDelegate)
            await IsOpenChanged.InvokeAsync(false);
    }

    private Task OnExecutedDateChanged(DateOnly? d)
    {
        _executedDate = d;
        _model.ExecutedAt = d.HasValue
            ? new DateTime(d.Value.Year, d.Value.Month, d.Value.Day, 0, 0, 0, DateTimeKind.Utc)
            : (DateTime?)null;

        return Task.CompletedTask;
    }
}
