@using tesisproject.frontend.SharedUI.ActionButton
@using tesisproject.frontend.SharedUI.Modal
@using tesisproject.shared.DTOs.Catalog.Common.Response
@using tesisproject.shared.DTOs.Catalog.ProductAttribute.Response
@using tesisproject.shared.DTOs.Catalog.Common.Request
@using tesisproject.shared.DTOs.Catalog.ProductAttribute.Request
@using tesisproject.shared.Enums

<div class="p-6 max-w-7xl mx-auto">
    <!-- Header Section -->
    <div class="mb-8">
        <div class="flex items-start justify-between">
            <div class="space-y-1">
                <h2 class="text-2xl font-bold text-foreground">Catálogos de Productos</h2>
                <p class="text-sm text-muted max-w-2xl">
                    Gestione los tipos de productos y atributos utilizados para describir productos en el sistema.
                </p>
            </div>
        </div>
    </div>

    @if (Loading)
    {
        <div class="flex items-center justify-center py-12">
            <div class="text-center space-y-3">
                <div class="inline-block h-8 w-8 animate-spin rounded-full border-4 border-solid border-primary border-r-transparent"></div>
                <p class="text-sm text-muted">Cargando catálogos de productos...</p>
            </div>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(Error))
    {
        <div class="rounded-lg border-2 border-error bg-error/5 p-4">
            <div class="flex items-start gap-3">
                <svg class="h-5 w-5 text-error flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <div class="flex-1">
                    <h3 class="text-sm font-semibold text-error mb-1">Error al cargar los datos</h3>
                    <p class="text-sm text-error/80">@Error</p>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="grid gap-6 lg:grid-cols-2">
            <!-- Product Types Card -->
            <div class="group rounded-xl border-2 border-border bg-background shadow-sm hover:shadow-md transition-all duration-200">
                <div class="p-5 border-b border-border bg-background/50">
                    <div class="flex items-start justify-between gap-4">
                        <div class="flex-1">
                            <div class="flex items-center gap-2 mb-1">
                                <svg class="h-5 w-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
                                </svg>
                                <h3 class="text-base font-semibold text-foreground">Tipos de Producto</h3>
                            </div>
                            <p class="text-xs text-muted leading-relaxed">
                                Categorías de alto nivel como Producción científica, Patente, Software, etc.
                            </p>
                        </div>

                        <div class="flex items-center gap-3 flex-shrink-0">
                            <span class="inline-flex items-center px-2.5 py-1 rounded-md bg-primary/10 text-xs font-medium text-primary">
                                @ProductTypes.Count @(ProductTypes.Count == 1 ? "tipo" : "tipos")
                            </span>
                            <ActionButton Text="Nuevo tipo"
                                          Intent="ButtonIntent.Add"
                                          Variant="ButtonVariant.Outline"
                                          Size="ButtonSize.Xs"
                                          Execute="OnNewProductTypeRequested">
                                <Icon>
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6">
                                        <path fill-rule="evenodd" d="M12 3.75a.75.75 0 0 1 .75.75v6.75h6.75a.75.75 0 0 1 0 1.5h-6.75v6.75a.75.75 0 0 1-1.5 0v-6.75H4.5a.75.75 0 0 1 0-1.5h6.75V4.5a.75.75 0 0 1 .75-.75Z" clip-rule="evenodd" />
                                    </svg>

                                </Icon>
                            </ActionButton>
                        </div>
                    </div>
                </div>

                <div class="p-5">
                    @if (ProductTypes.Count == 0)
                    {
                        <div class="text-center py-8 px-4">
                            <svg class="mx-auto h-12 w-12 text-muted/40" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
                            </svg>
                            <p class="mt-3 text-sm text-muted">
                                Aún no hay tipos de producto
                            </p>
                            <p class="mt-1 text-xs text-muted/70">
                                Cree uno para comenzar a organizar productos
                            </p>
                        </div>
                    }
                    else
                    {
                        <ul class="space-y-2 max-h-96 overflow-y-auto pr-1">
                            @foreach (var t in ProductTypes)
                            {
                                <li class="group/item flex items-center justify-between gap-3 p-3 rounded-lg border border-border bg-background hover:border-primary/40 hover:bg-primary/5 transition-all duration-150">
                                    <div class="flex flex-col flex-1 min-w-0">
                                        <span class="truncate font-medium text-sm text-foreground">@t.Name</span>
                                        <div class="flex items-center gap-1.5 mt-1.5 flex-wrap">
                                            @if (t.IsActive)
                                            {
                                                <span class="inline-flex items-center px-2 py-0.5 rounded-md text-xs font-medium bg-secondary/15 text-secondary border border-secondary/30">
                                                    Activo
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="inline-flex items-center px-2 py-0.5 rounded-md text-xs font-medium bg-muted/15 text-muted border border-border">
                                                    Inactivo
                                                </span>
                                            }

                                            @if (t.IsLocked)
                                            {
                                                <span class="inline-flex items-center px-2 py-0.5 rounded-md text-xs font-medium bg-accent/15 text-accent border border-accent/30">
                                                    <svg class="h-3 w-3 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                                                    </svg>
                                                    Bloqueado
                                                </span>
                                            }
                                        </div>
                                    </div>

                                    <div class="flex items-center gap-2 flex-shrink-0">
                                        @if (!t.IsLocked)
                                        {
                                            <ActionButton Intent="ButtonIntent.Add"
                                                          Variant="ButtonVariant.Outline"
                                                          Size="ButtonSize.Xs"
                                                          Execute="@(() => OnEditProductTypeRequested.InvokeAsync(t.Id))">
                                                <Icon>
                                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6">
                                                        <path d="M21.731 2.269a2.625 2.625 0 0 0-3.712 0l-1.157 1.157 3.712 3.712 1.157-1.157a2.625 2.625 0 0 0 0-3.712ZM19.513 8.199l-3.712-3.712-8.4 8.4a5.25 5.25 0 0 0-1.32 2.214l-.8 2.685a.75.75 0 0 0 .933.933l2.685-.8a5.25 5.25 0 0 0 2.214-1.32l8.4-8.4Z" />
                                                        <path d="M5.25 5.25a3 3 0 0 0-3 3v10.5a3 3 0 0 0 3 3h10.5a3 3 0 0 0 3-3V13.5a.75.75 0 0 0-1.5 0v5.25a1.5 1.5 0 0 1-1.5 1.5H5.25a1.5 1.5 0 0 1-1.5-1.5V8.25a1.5 1.5 0 0 1 1.5-1.5h5.25a.75.75 0 0 0 0-1.5H5.25Z" />
                                                    </svg>

                                                </Icon>
                                            </ActionButton>

                                            <ActionButton Intent="ButtonIntent.Delete"
                                                          Variant="ButtonVariant.Outline"
                                                          Size="ButtonSize.Xs"
                                                          ConfirmBeforeExecute="true"
                                                          ConfirmTitle="Eliminar tipo de producto"
                                                          ConfirmMessage="¿Está seguro de que desea eliminar este tipo de producto? Esta acción no se puede deshacer."
                                                          ConfirmButtonText="Eliminar"
                                                          CancelButtonText="Cancelar"
                                                          Execute="@(() => OnDeleteProductTypeRequested.InvokeAsync(t.Id))">
                                                <Icon>
                                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6">
                                                        <path fill-rule="evenodd" d="M16.5 4.478v.227a48.816 48.816 0 0 1 3.878.512.75.75 0 1 1-.256 1.478l-.209-.035-1.005 13.07a3 3 0 0 1-2.991 2.77H8.084a3 3 0 0 1-2.991-2.77L4.087 6.66l-.209.035a.75.75 0 0 1-.256-1.478A48.567 48.567 0 0 1 7.5 4.705v-.227c0-1.564 1.213-2.9 2.816-2.951a52.662 52.662 0 0 1 3.369 0c1.603.051 2.815 1.387 2.815 2.951Zm-6.136-1.452a51.196 51.196 0 0 1 3.273 0C14.39 3.05 15 3.684 15 4.478v.113a49.488 49.488 0 0 0-6 0v-.113c0-.794.609-1.428 1.364-1.452Zm-.355 5.945a.75.75 0 1 0-1.5.058l.347 9a.75.75 0 1 0 1.499-.058l-.346-9Zm5.48.058a.75.75 0 1 0-1.498-.058l-.347 9a.75.75 0 0 0 1.5.058l.345-9Z" clip-rule="evenodd" />
                                                    </svg>

                                                </Icon>
                                            </ActionButton>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-medium bg-muted/10 text-muted/60">
                                                Protegido
                                            </span>
                                        }
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>

            <!-- Product Attributes Card -->
            <div class="group rounded-xl border-2 border-border bg-background shadow-sm hover:shadow-md transition-all duration-200">
                <div class="p-5 border-b border-border bg-background/50">
                    <div class="flex items-start justify-between gap-4">
                        <div class="flex-1">
                            <div class="flex items-center gap-2 mb-1">
                                <svg class="h-5 w-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                                </svg>
                                <h3 class="text-base font-semibold text-foreground">Atributos de Producto</h3>
                            </div>
                            <p class="text-xs text-muted leading-relaxed">
                                Campos atómicos como Título, Autores, DOI, Año, etc.
                            </p>
                        </div>

                        <div class="flex items-center gap-3 flex-shrink-0">
                            <span class="inline-flex items-center px-2.5 py-1 rounded-md bg-primary/10 text-xs font-medium text-primary">
                                @ProductAttributes.Count @(ProductAttributes.Count == 1 ? "atributo" : "atributos")
                            </span>
                            <ActionButton Text="Nuevo atributo"
                                          Intent="ButtonIntent.Add"
                                          Variant="ButtonVariant.Outline"
                                          Size="ButtonSize.Xs"
                                          Execute="OnNewAttributeRequested">
                                <Icon>
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6">
                                        <path fill-rule="evenodd" d="M12 3.75a.75.75 0 0 1 .75.75v6.75h6.75a.75.75 0 0 1 0 1.5h-6.75v6.75a.75.75 0 0 1-1.5 0v-6.75H4.5a.75.75 0 0 1 0-1.5h6.75V4.5a.75.75 0 0 1 .75-.75Z" clip-rule="evenodd" />
                                    </svg>

                                </Icon>
                            </ActionButton>
                        </div>
                    </div>
                </div>

                <div class="p-5">
                    @if (ProductAttributes.Count == 0)
                    {
                        <div class="text-center py-8 px-4">
                            <svg class="mx-auto h-12 w-12 text-muted/40" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                            </svg>
                            <p class="mt-3 text-sm text-muted">
                                Aún no hay atributos
                            </p>
                            <p class="mt-1 text-xs text-muted/70">
                                Cree atributos como Título, Autores, DOI, Año, etc.
                            </p>
                        </div>
                    }
                    else
                    {
                        <ul class="space-y-2 max-h-96 overflow-y-auto pr-1">
                            @foreach (var a in ProductAttributes)
                            {
                                <li class="group/item flex items-center justify-between gap-3 p-3 rounded-lg border border-border bg-background hover:border-primary/40 hover:bg-primary/5 transition-all duration-150">
                                    <div class="flex flex-col flex-1 min-w-0">
                                        <span class="truncate font-medium text-sm text-foreground">@a.Name</span>
                                        <div class="flex items-center gap-1.5 mt-1.5 flex-wrap">
                                            <span class="inline-flex items-center px-2 py-0.5 rounded-md text-xs font-medium bg-primary/10 text-primary border border-primary/30">
                                                @a.DataType.ToString()
                                            </span>

                                            @if (!string.IsNullOrWhiteSpace(a.Unit))
                                            {
                                                <span class="text-xs text-muted">· @a.Unit</span>
                                            }

                                            @if (a.IsActive)
                                            {
                                                <span class="inline-flex items-center px-2 py-0.5 rounded-md text-xs font-medium bg-secondary/15 text-secondary border border-secondary/30">
                                                    Activo
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="inline-flex items-center px-2 py-0.5 rounded-md text-xs font-medium bg-muted/15 text-muted border border-border">
                                                    Inactivo
                                                </span>
                                            }

                                            @if (a.IsLocked)
                                            {
                                                <span class="inline-flex items-center px-2 py-0.5 rounded-md text-xs font-medium bg-accent/15 text-accent border border-accent/30">
                                                    <svg class="h-3 w-3 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                                                    </svg>
                                                    Bloqueado
                                                </span>
                                            }
                                        </div>
                                    </div>

                                    <div class="flex items-center gap-2 flex-shrink-0">
                                        @if (!a.IsLocked)
                                        {
                                            <ActionButton Intent="ButtonIntent.Add"
                                                          Variant="ButtonVariant.Outline"
                                                          Size="ButtonSize.Xs"
                                                          Execute="@(() => OnEditAttributeRequested.InvokeAsync(a.Id))">
                                                <Icon>
                                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6">
                                                        <path d="M21.731 2.269a2.625 2.625 0 0 0-3.712 0l-1.157 1.157 3.712 3.712 1.157-1.157a2.625 2.625 0 0 0 0-3.712ZM19.513 8.199l-3.712-3.712-8.4 8.4a5.25 5.25 0 0 0-1.32 2.214l-.8 2.685a.75.75 0 0 0 .933.933l2.685-.8a5.25 5.25 0 0 0 2.214-1.32l8.4-8.4Z" />
                                                        <path d="M5.25 5.25a3 3 0 0 0-3 3v10.5a3 3 0 0 0 3 3h10.5a3 3 0 0 0 3-3V13.5a.75.75 0 0 0-1.5 0v5.25a1.5 1.5 0 0 1-1.5 1.5H5.25a1.5 1.5 0 0 1-1.5-1.5V8.25a1.5 1.5 0 0 1 1.5-1.5h5.25a.75.75 0 0 0 0-1.5H5.25Z" />
                                                    </svg>

                                                </Icon>
                                            </ActionButton>

                                            <ActionButton Intent="ButtonIntent.Delete"
                                                          Variant="ButtonVariant.Outline"
                                                          Size="ButtonSize.Xs"
                                                          ConfirmBeforeExecute="true"
                                                          ConfirmTitle="Eliminar atributo"
                                                          ConfirmMessage="¿Está seguro de que desea eliminar este atributo? Puede afectar las configuraciones de productos existentes."
                                                          ConfirmButtonText="Eliminar"
                                                          CancelButtonText="Cancelar"
                                                          Execute="@(() => OnDeleteAttributeRequested.InvokeAsync(a.Id))">
                                                <Icon>
                                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6">
                                                        <path fill-rule="evenodd" d="M16.5 4.478v.227a48.816 48.816 0 0 1 3.878.512.75.75 0 1 1-.256 1.478l-.209-.035-1.005 13.07a3 3 0 0 1-2.991 2.77H8.084a3 3 0 0 1-2.991-2.77L4.087 6.66l-.209.035a.75.75 0 0 1-.256-1.478A48.567 48.567 0 0 1 7.5 4.705v-.227c0-1.564 1.213-2.9 2.816-2.951a52.662 52.662 0 0 1 3.369 0c1.603.051 2.815 1.387 2.815 2.951Zm-6.136-1.452a51.196 51.196 0 0 1 3.273 0C14.39 3.05 15 3.684 15 4.478v.113a49.488 49.488 0 0 0-6 0v-.113c0-.794.609-1.428 1.364-1.452Zm-.355 5.945a.75.75 0 1 0-1.5.058l.347 9a.75.75 0 1 0 1.499-.058l-.346-9Zm5.48.058a.75.75 0 1 0-1.498-.058l-.347 9a.75.75 0 0 0 1.5.058l.345-9Z" clip-rule="evenodd" />
                                                    </svg>

                                                </Icon>
                                            </ActionButton>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-medium bg-muted/10 text-muted/60">
                                                Protegido
                                            </span>
                                        }
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>
    }
</div>

@* ===== MODAL Product Type ===== *@
<CatalogEditModal Id="product-type-modal"
                  IsOpen="@TypeModalOpen"
                  IsOpenChanged="TypeModalOpenChanged"
                  IsEditMode="@IsTypeEditMode"
                  IsSaving="@SavingType"
                  Error="@TypeError"
                  Model="@TypeEditModel"
                  NewTitle="Nuevo tipo de producto"
                  EditTitle="Editar tipo de producto"
                  OnCancel="OnTypeCancelRequested"
                  OnSave="OnTypeSaveRequested" />

@* ===== MODAL Product Attribute ===== *@
<ProductAttributeEditModal IsOpen="@AttributeModalOpen"
                           IsOpenChanged="AttributeModalOpenChanged"
                           IsEditMode="@IsAttributeEditMode"
                           IsSaving="@SavingAttribute"
                           Error="@AttributeError"
                           Model="@AttributeEditModel"
                           DataTypes="@DataTypes"
                           OnCancel="OnAttributeCancelRequested"
                           OnSave="OnAttributeSaveRequested" />

@code {
    // ===== Estado general =====
    [Parameter] public bool Loading { get; set; }
    [Parameter] public string? Error { get; set; }

    [Parameter] public IReadOnlyList<CatalogListItemDTO> ProductTypes { get; set; } = new List<CatalogListItemDTO>();
    [Parameter] public IReadOnlyList<ProductAttributeListItemDTO> ProductAttributes { get; set; } = new List<ProductAttributeListItemDTO>();

    // ===== ProductType modal =====
    [Parameter] public bool TypeModalOpen { get; set; }
    [Parameter] public EventCallback<bool> TypeModalOpenChanged { get; set; }
    [Parameter] public bool IsTypeEditMode { get; set; }
    [Parameter] public bool SavingType { get; set; }
    [Parameter] public string? TypeError { get; set; }
    [Parameter] public CatalogDetailDTO TypeEditModel { get; set; } = new();

    // ===== ProductAttribute modal =====
    [Parameter] public bool AttributeModalOpen { get; set; }
    [Parameter] public EventCallback<bool> AttributeModalOpenChanged { get; set; }
    [Parameter] public bool IsAttributeEditMode { get; set; }
    [Parameter] public bool SavingAttribute { get; set; }
    [Parameter] public string? AttributeError { get; set; }
    [Parameter] public ProductAttributeDetailDTO AttributeEditModel { get; set; } = new();
    [Parameter] public IEnumerable<ProductAttributeDataType> DataTypes { get; set; } = Array.Empty<ProductAttributeDataType>();

    // ===== Callbacks (acciones) =====
    [Parameter] public EventCallback OnNewProductTypeRequested { get; set; }
    [Parameter] public EventCallback<int> OnEditProductTypeRequested { get; set; }
    [Parameter] public EventCallback OnTypeCancelRequested { get; set; }
    [Parameter] public EventCallback OnTypeSaveRequested { get; set; }
    [Parameter] public EventCallback<int> OnDeleteProductTypeRequested { get; set; }

    [Parameter] public EventCallback OnNewAttributeRequested { get; set; }
    [Parameter] public EventCallback<int> OnEditAttributeRequested { get; set; }
    [Parameter] public EventCallback OnAttributeCancelRequested { get; set; }
    [Parameter] public EventCallback OnAttributeSaveRequested { get; set; }
    [Parameter] public EventCallback<int> OnDeleteAttributeRequested { get; set; }
}