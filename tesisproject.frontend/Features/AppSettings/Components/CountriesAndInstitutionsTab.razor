@using tesisproject.frontend.SharedUI.ActionButton
@using tesisproject.frontend.SharedUI.Modal
@using tesisproject.frontend.SharedUI.Table
@using tesisproject.frontend.SharedUI.SelectInput
@using tesisproject.frontend.SharedUI.TextInput
@using tesisproject.frontend.SharedUI.SearchInput
@using tesisproject.shared.DTOs.Catalog.Country.Request
@using tesisproject.shared.DTOs.Catalog.Country.Response
@using tesisproject.shared.DTOs.Institution.Request
@using tesisproject.shared.DTOs.Institution.Response
@using tesisproject.shared.DTOs.Filters
@using tesisproject.frontend.Services.Interfaces
@using System.Globalization
@using System.Text

@inject ICountryClientService CountryClient
@inject IInstitutionClientService InstitutionClient
@inject IToastService Toast

<div class="p-6 max-w-[1800px] mx-auto space-y-6">
    <!-- Page Header -->
    <div class="space-y-1">
        <h2 class="text-2xl font-bold text-foreground">Países e Instituciones</h2>
        <p class="text-sm text-muted max-w-3xl">
            Administre países y sus instituciones asociadas. Seleccione un país para ver y gestionar sus instituciones.
        </p>
    </div>

    <!-- Main Content Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-[380px_1fr] gap-6">

        <!-- LEFT SIDEBAR: Countries -->
        <div class="space-y-4">
            <div class="rounded-xl border-2 border-border bg-background shadow-sm">
                <!-- Countries Header -->
                <div class="p-4 border-b border-border bg-background/50">
                    <div class="flex items-center justify-between mb-1">
                        <div class="flex items-center gap-2">
                            <svg class="h-5 w-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                            <h3 class="text-base font-semibold text-foreground">Países</h3>
                        </div>
                    </div>
                    <p class="text-xs text-muted mb-3">
                        Ubicaciones geográficas para clasificación institucional.
                    </p>

                    <!-- Search countries -->
                    <SearchInput Value="@_countrySearchTerm"
                                 ValueChanged="OnCountrySearchChanged"
                                 Placeholder="Buscar países..."
                                 Class="mb-3" />

                    <ActionButton Execute="OpenCreateCountryModal"
                                  Text="Nuevo País"
                                  Intent="ButtonIntent.Add"
                                  Variant="ButtonVariant.Outline"
                                  Size="ButtonSize.Sm"
                                  Class="w-full" />
                </div>

                <!-- Countries List -->
                <div class="p-4">
                    @if (_loadingCountries)
                    {
                        <div class="flex items-center justify-center py-8">
                            <div class="text-center space-y-2">
                                <div class="inline-block h-6 w-6 animate-spin rounded-full border-3 border-solid border-primary border-r-transparent"></div>
                                <p class="text-xs text-muted">Cargando países...</p>
                            </div>
                        </div>
                    }
                    else if (_countries.Count == 0)
                    {
                        <div class="text-center py-8 px-4">
                            <svg class="mx-auto h-10 w-10 text-muted/40" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                            <p class="mt-2 text-xs text-muted">Aún no hay países</p>
                            <p class="mt-1 text-xs text-muted/70">Crea tu primer país para comenzar</p>
                        </div>
                    }
                    else
                    {
                        <div class="space-y-2 max-h-[600px] overflow-y-auto pr-1">
                            @foreach (var country in _filteredCountries)
                            {
                                var isSelected = _selectedCountryId == country.Id;
                                <div class="group/country rounded-lg border-2 @(isSelected ? "border-primary bg-primary/5" : "border-border bg-background hover:border-primary/40 hover:bg-primary/5") transition-all duration-150">
                                    <button type="button"
                                            @onclick="@(() => OnCountrySelected(country.Id))"
                                            class="w-full p-3">
                                        <div class="flex items-start justify-between gap-2">
                                            <div class="flex-1 min-w-0 text-left">
                                                <div class="flex items-center gap-2 mb-1.5">
                                                    <div class="w-2 h-2 rounded-full flex-shrink-0 @(country.IsActive ? "bg-secondary" : "bg-muted")"></div>
                                                    <span class="font-medium text-sm text-foreground truncate">@country.Name</span>
                                                </div>
                                                <div class="flex items-center gap-1.5 flex-wrap">
                                                    <span class="inline-flex items-center px-1.5 py-0.5 rounded-md text-xs font-medium bg-muted/15 text-muted border border-border">
                                                        @country.IsoCode
                                                    </span>
                                                    <span class="inline-flex items-center px-1.5 py-0.5 rounded-md text-xs font-medium bg-muted/15 text-muted border border-border">
                                                        @country.IsoAlpha3
                                                    </span>
                                                    @if (country.IsActive)
                                                    {
                                                        <span class="inline-flex items-center px-1.5 py-0.5 rounded-md text-xs font-medium bg-secondary/15 text-secondary border border-secondary/30">
                                                            Activo
                                                        </span>
                                                    }
                                                </div>
                                            </div>
                                            @if (isSelected)
                                            {
                                                <svg class="h-5 w-5 text-primary flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
                                                    <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z" />
                                                </svg>
                                            }
                                        </div>
                                    </button>

                                    <div class="px-3 pb-3 flex items-center gap-2">
                                        <ActionButton Execute="@(() => OpenEditCountryModal(country))"
                                                      Intent="ButtonIntent.Neutral"
                                                      Variant="ButtonVariant.Outline"
                                                      Size="ButtonSize.Xs"
                                                      Class="flex-1">
                                            <Icon>
                                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6">
                                                    <path d="M21.731 2.269a2.625 2.625 0 0 0-3.712 0l-1.157 1.157 3.712 3.712 1.157-1.157a2.625 2.625 0 0 0 0-3.712ZM19.513 8.199l-3.712-3.712-8.4 8.4a5.25 5.25 0 0 0-1.32 2.214l-.8 2.685a.75.75 0 0 0 .933.933l2.685-.8a5.25 5.25 0 0 0 2.214-1.32l8.4-8.4Z" />
                                                    <path d="M5.25 5.25a3 3 0 0 0-3 3v10.5a3 3 0 0 0 3 3h10.5a3 3 0 0 0 3-3V13.5a.75.75 0 0 0-1.5 0v5.25a1.5 1.5 0 0 1-1.5 1.5H5.25a1.5 1.5 0 0 1-1.5-1.5V8.25a1.5 1.5 0 0 1 1.5-1.5h5.25a.75.75 0 0 0 0-1.5H5.25Z" />
                                                </svg>
                                            </Icon>
                                        </ActionButton>
                                        <ActionButton Execute="@(() => DeleteCountryAsync(country.Id))"
                                                      Intent="ButtonIntent.Delete"
                                                      Variant="ButtonVariant.Outline"
                                                      Size="ButtonSize.Xs"
                                                      ConfirmBeforeExecute="true"
                                                      ConfirmMessage="@($"¿Está seguro de que desea eliminar '{country.Name}'? Esto afectará a todas las instituciones asociadas.")"
                                                      Class="flex-1">
                                            <Icon>
                                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6">
                                                    <path fill-rule="evenodd" d="M16.5 4.478v.227a48.816 48.816 0 0 1 3.878.512.75.75 0 1 1-.256 1.478l-.209-.035-1.005 13.07a3 3 0 0 1-2.991 2.77H8.084a3 3 0 0 1-2.991-2.77L4.087 6.66l-.209.035a.75.75 0 0 1-.256-1.478A48.567 48.567 0 0 1 7.5 4.705v-.227c0-1.564 1.213-2.9 2.816-2.951a52.662 52.662 0 0 1 3.369 0c1.603.051 2.815 1.387 2.815 2.951Zm-6.136-1.452a51.196 51.196 0 0 1 3.273 0C14.39 3.05 15 3.684 15 4.478v.113a49.488 49.488 0 0 0-6 0v-.113c0-.794.609-1.428 1.364-1.452Zm-.355 5.945a.75.75 0 1 0-1.5.058l.347 9a.75.75 0 1 0 1.499-.058l-.346-9Zm5.48.058a.75.75 0 1 0-1.498-.058l-.347 9a.75.75 0 0 0 1.5.058l.345-9Z" clip-rule="evenodd" />
                                                </svg>
                                            </Icon>
                                        </ActionButton>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- RIGHT PANEL: Institutions -->
        <div class="space-y-6">
            <div class="rounded-xl border-2 border-border bg-background shadow-sm">
                <div class="p-5 border-b border-border bg-background/50">
                    <div class="flex items-center justify-between">
                        <div class="flex-1">
                            <div class="flex items-center gap-2 mb-1">
                                <svg class="h-5 w-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                                </svg>
                                <h3 class="text-base font-semibold text-foreground">Instituciones</h3>
                            </div>
                            <p class="text-xs text-muted">
                                @if (_selectedCountryId.HasValue)
                                {
                                    var selectedCountry = _countries.FirstOrDefault(c => c.Id == _selectedCountryId);
                                    <text>Administrar instituciones de @selectedCountry?.Name</text>
                                }
                                else
                                {
                                    <text>Seleccione un país para ver y administrar sus instituciones</text>
                                }
                            </p>
                        </div>

                        <ActionButton Execute="OpenCreateInstitutionModal"
                                      Text="Nueva Institución"
                                      Intent="ButtonIntent.Add"
                                      Variant="ButtonVariant.Outline"
                                      Size="ButtonSize.Sm"
                                      Disabled="@(!_selectedCountryId.HasValue)" />
                    </div>
                </div>

                <div class="p-5">
                    @if (!_selectedCountryId.HasValue)
                    {
                        <div class="text-center py-12">
                            <svg class="mx-auto h-12 w-12 text-muted/40" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 19l-7-7 7-7" />
                            </svg>
                            <p class="mt-3 text-sm text-muted">Seleccione un país para ver sus instituciones</p>
                        </div>
                    }
                    else if (_loadingInstitutions)
                    {
                        <div class="flex items-center justify-center py-12">
                            <div class="text-center space-y-2">
                                <div class="inline-block h-6 w-6 animate-spin rounded-full border-3 border-solid border-primary border-r-transparent"></div>
                                <p class="text-xs text-muted">Cargando instituciones...</p>
                            </div>
                        </div>
                    }
                    else if (_institutions.Count == 0)
                    {
                        <div class="text-center py-12">
                            <svg class="mx-auto h-12 w-12 text-muted/40" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                            </svg>
                            <p class="mt-3 text-sm font-medium text-muted">Aún no hay instituciones</p>
                            <p class="mt-1 text-xs text-muted/70">Agregue instituciones a este país</p>
                        </div>
                    }
                    else
                    {
                        <!-- Search institutions -->
                        <SearchInput Value="@_institutionSearchTerm"
                                     ValueChanged="OnInstitutionSearchChanged"
                                     Placeholder="Buscar instituciones..."
                                     Class="mb-4" />

                        <DataTable TItem="InstitutionListItemDTO"
                                   Items="@_filteredInstitutions"
                                   PageSize="6"
                                   Total="@_filteredInstitutions.Count"
                                   Columns="@_institutionColumns"
                                   EmptyText="No se encontraron instituciones">
                            <RowTemplate>
                                @{
                                    var inst = context;
                                }
                                <td class="px-4 py-3 text-sm font-medium text-foreground">
                                    @inst.Name
                                </td>
                                <td class="px-4 py-3 text-sm text-muted">
                                    @inst.CountryName
                                </td>
                                <td class="px-4 py-3 text-center">
                                    @if (inst.IsActive)
                                    {
                                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-xs font-medium bg-secondary/15 text-secondary border border-secondary/30">
                                            <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                                            </svg>
                                            Activa
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-xs font-medium bg-muted/15 text-muted border border-border">
                                            <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
                                            </svg>
                                            Inactiva
                                        </span>
                                    }
                                </td>
                                <td class="px-4 py-3 text-right">
                                    <div class="inline-flex items-center gap-2">
                                        <ActionButton Execute="@(() => OpenEditInstitutionModal(inst.Id))"
                                                      Intent="ButtonIntent.Neutral"
                                                      Variant="ButtonVariant.Outline"
                                                      Size="ButtonSize.Xs">
                                            <Icon>
                                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6">
                                                    <path d="M21.731 2.269a2.625 2.625 0 0 0-3.712 0l-1.157 1.157 3.712 3.712 1.157-1.157a2.625 2.625 0 0 0 0-3.712ZM19.513 8.199l-3.712-3.712-8.4 8.4a5.25 5.25 0 0 0-1.32 2.214l-.8 2.685a.75.75 0 0 0 .933.933l2.685-.8a5.25 5.25 0 0 0 2.214-1.32l8.4-8.4Z" />
                                                    <path d="M5.25 5.25a3 3 0 0 0-3 3v10.5a3 3 0 0 0 3 3h10.5a3 3 0 0 0 3-3V13.5a.75.75 0 0 0-1.5 0v5.25a1.5 1.5 0 0 1-1.5 1.5H5.25a1.5 1.5 0 0 1-1.5-1.5V8.25a1.5 1.5 0 0 1 1.5-1.5h5.25a.75.75 0 0 0 0-1.5H5.25Z" />
                                                </svg>
                                            </Icon>
                                        </ActionButton>
                                        <ActionButton Execute="@(() => DeleteInstitutionAsync(inst.Id))"
                                                      Intent="ButtonIntent.Delete"
                                                      Variant="ButtonVariant.Outline"
                                                      Size="ButtonSize.Xs"
                                                      ConfirmBeforeExecute="true"
                                                      ConfirmMessage="@($"¿Está seguro de que desea eliminar '{inst.Name}'?")">
                                            <Icon>
                                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6">
                                                    <path fill-rule="evenodd" d="M16.5 4.478v.227a48.816 48.816 0 0 1 3.878.512.75.75 0 1 1-.256 1.478l-.209-.035-1.005 13.07a3 3 0 0 1-2.991 2.77H8.084a3 3 0 0 1-2.991-2.77L4.087 6.66l-.209.035a.75.75 0 0 1-.256-1.478A48.567 48.567 0 0 1 7.5 4.705v-.227c0-1.564 1.213-2.9 2.816-2.951a52.662 52.662 0 0 1 3.369 0c1.603.051 2.815 1.387 2.815 2.951Zm-6.136-1.452a51.196 51.196 0 0 1 3.273 0C14.39 3.05 15 3.684 15 4.478v.113a49.488 49.488 0 0 0-6 0v-.113c0-.794.609-1.428 1.364-1.452Zm-.355 5.945a.75.75 0 1 0-1.5.058l.347 9a.75.75 0 1 0 1.499-.058l-.346-9Zm5.48.058a.75.75 0 1 0-1.498-.058l-.347 9a.75.75 0 0 0 1.5.058l.345-9Z" clip-rule="evenodd" />
                                                </svg>
                                            </Icon>
                                        </ActionButton>
                                    </div>
                                </td>
                            </RowTemplate>
                        </DataTable>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- MODALS -->
    <!-- Country Modal -->
    <Modal Id="country-modal"
           IsOpen="@_countryModalOpen"
           IsOpenChanged="v => _countryModalOpen = v"
           Title="@(_isCountryEdit ? "Editar País" : "Nuevo País")"
           Size="ModalSize.Md">
        <ChildContent>
            <div class="space-y-4">
                <TextInput @bind-Value="_countryEditModel.Name"
                           Label="Nombre del País"
                           Placeholder="ej., Ecuador"
                           Required="true" />

                <div class="grid grid-cols-2 gap-4">
                    <TextInput @bind-Value="_countryEditModel.IsoCode"
                               Label="Código ISO (2 caracteres)"
                               Placeholder="ej., EC"
                               Required="true"
                               MaxLength="2" />

                    <TextInput @bind-Value="_countryEditModel.IsoAlpha3"
                               Label="ISO Alpha-3 (3 caracteres)"
                               Placeholder="ej., ECU"
                               Required="true"
                               MaxLength="3" />
                </div>

                @if (_isCountryEdit)
                {
                    <label class="flex items-center gap-2 cursor-pointer">
                        <input type="checkbox"
                               class="h-4 w-4 rounded border-border text-primary focus:ring-2 focus:ring-primary/30 cursor-pointer"
                               @bind="_countryEditModel.IsActive" />
                        <span class="text-sm text-foreground">Activo</span>
                    </label>
                }

                <div class="flex justify-end gap-2 pt-4 border-t border-border">
                    <ActionButton Execute="CloseCountryModal"
                                  Text="Cancelar"
                                  Intent="ButtonIntent.Neutral"
                                  Variant="ButtonVariant.Outline"
                                  Size="ButtonSize.Sm" />
                    <ActionButton Execute="SaveCountryAsync"
                                  Text="Guardar"
                                  Intent="ButtonIntent.Accept"
                                  Size="ButtonSize.Sm"
                                  Disabled="@(!CanSaveCountry())" />
                </div>
            </div>
        </ChildContent>
    </Modal>

    <!-- Institution Modal -->
    <Modal Id="institution-modal"
           IsOpen="@_institutionModalOpen"
           IsOpenChanged="v => _institutionModalOpen = v"
           Title="@(_isInstitutionEdit ? "Editar Institución" : "Nueva Institución")"
           Size="ModalSize.Md">
        <ChildContent>
            <div class="space-y-4">
                <TextInput @bind-Value="_institutionEditModel.Name"
                           Label="Nombre de la Institución"
                           Placeholder="ej., Universidad Nacional de Chimborazo"
                           Required="true" />

                <div class="space-y-2">
                    <label class="text-sm font-medium text-foreground">
                        País @(_selectedCountryId.HasValue ? "(Preseleccionado)" : "")
                    </label>
                    @if (_isInstitutionEdit || !_selectedCountryId.HasValue)
                    {
                        <SelectInput TItem="CountryListItemDTO"
                                     Items="@_countries.Where(c => c.IsActive).ToList()"
                                     @bind-Value="_selectedCountryForInstitution"
                                     GetText="@(c => c.Name)"
                                     GetKey="@(c => c.Id.ToString())"
                                     Placeholder="-- Seleccionar país --"
                                     Size="SelectSize.Md" />
                    }
                    else
                    {
                        <input type="text"
                               class="w-full rounded-lg border border-border bg-muted/5 px-3 py-2 text-sm text-foreground cursor-not-allowed"
                               value="@(_countries.FirstOrDefault(c => c.Id == _selectedCountryId)?.Name ?? "")"
                               disabled />
                        <p class="text-xs text-muted mt-1">
                            El país fue preseleccionado desde la barra lateral.
                        </p>
                    }
                </div>

                @if (_isInstitutionEdit)
                {
                    <label class="flex items-center gap-2 cursor-pointer">
                        <input type="checkbox"
                               class="h-4 w-4 rounded border-border text-primary focus:ring-2 focus:ring-primary/30 cursor-pointer"
                               @bind="_institutionEditModel.IsActive" />
                        <span class="text-sm text-foreground">Activa</span>
                    </label>
                }

                <div class="flex justify-end gap-2 pt-4 border-t border-border">
                    <ActionButton Execute="CloseInstitutionModal"
                                  Text="Cancelar"
                                  Intent="ButtonIntent.Neutral"
                                  Variant="ButtonVariant.Outline"
                                  Size="ButtonSize.Sm" />
                    <ActionButton Execute="SaveInstitutionAsync"
                                  Text="Guardar"
                                  Intent="ButtonIntent.Accept"
                                  Size="ButtonSize.Sm"
                                  Disabled="@(!CanSaveInstitution())" />
                </div>
            </div>
        </ChildContent>
    </Modal>
</div>

@code {
    // ===== Search terms =====
    private string _countrySearchTerm = string.Empty;
    private string _institutionSearchTerm = string.Empty;

    // Countries
    private bool _loadingCountries;
    private List<CountryListItemDTO> _countries = new();
    private List<CountryListItemDTO> _filteredCountries = new();
    private int? _selectedCountryId;
    private bool _countryModalOpen;
    private bool _isCountryEdit;
    private CountryDetailDTO _countryEditModel = new();

    // Institutions
    private bool _loadingInstitutions;
    private List<InstitutionListItemDTO> _institutions = new();
    private List<InstitutionListItemDTO> _filteredInstitutions = new();
    private bool _institutionModalOpen;
    private bool _isInstitutionEdit;
    private InstitutionDetailDTO _institutionEditModel = new();
    private CountryListItemDTO? _selectedCountryForInstitution;

    // Table columns
    private List<ColumnDef<InstitutionListItemDTO>> _institutionColumns = new();

    protected override async Task OnInitializedAsync()
    {
        InitializeInstitutionColumns();
        await LoadCountriesAsync();
    }

    private void InitializeInstitutionColumns()
    {
        _institutionColumns = new()
        {
            new("Nombre", i => i.Name, Sortable: true),
            new("País", i => i.CountryName ?? "", Sortable: true, Width: "200px"),
            new("Estado", i => i.IsActive ? "Activa" : "Inactiva", Sortable: true, Width: "120px"),
            new("Acciones", i => "", Sortable: false, Width: "150px")
        };
    }

    protected override void OnParametersSet()
    {
        if (_selectedCountryForInstitution != null && _selectedCountryForInstitution.Id != _institutionEditModel.CountryId)
        {
            _institutionEditModel.CountryId = _selectedCountryForInstitution.Id;
        }
    }

    // ===== Normalización para búsqueda (sin acentos, minúsculas) =====
    private static string NormalizeForSearch(string? input)
    {
        if (string.IsNullOrWhiteSpace(input))
            return string.Empty;

        var normalized = input.Normalize(NormalizationForm.FormD);
        var sb = new StringBuilder(normalized.Length);

        foreach (var ch in normalized)
        {
            var uc = CharUnicodeInfo.GetUnicodeCategory(ch);
            if (uc != UnicodeCategory.NonSpacingMark)
            {
                sb.Append(char.ToLowerInvariant(ch));
            }
        }

        return sb.ToString();
    }

    // ===== Search handlers (conectados a SearchInput) =====
    private Task OnCountrySearchChanged(string value)
    {
        _countrySearchTerm = value;
        return OnCountrySearchRequested(value);
    }

    private Task OnInstitutionSearchChanged(string value)
    {
        _institutionSearchTerm = value;
        return OnInstitutionSearchRequested(value);
    }

    private Task OnInstitutionSearchRequested(string term)
    {
        var normTerm = NormalizeForSearch(term?.Trim());

        if (string.IsNullOrEmpty(normTerm))
        {
            _filteredInstitutions = _institutions.ToList();
        }
        else
        {
            _filteredInstitutions = _institutions
                .Where(i =>
                {
                    var nameNorm = NormalizeForSearch(i.Name);
                    var countryNorm = NormalizeForSearch(i.CountryName);

                    return (!string.IsNullOrEmpty(nameNorm) && nameNorm.Contains(normTerm)) ||
                           (!string.IsNullOrEmpty(countryNorm) && countryNorm.Contains(normTerm));
                })
                .OrderBy(i => i.Name)
                .ToList();
        }

        StateHasChanged();
        return Task.CompletedTask;
    }

    private Task OnCountrySearchRequested(string term)
    {
        var normTerm = NormalizeForSearch(term?.Trim());

        if (string.IsNullOrEmpty(normTerm))
        {
            _filteredCountries = _countries.ToList();
        }
        else
        {
            _filteredCountries = _countries
                .Where(c =>
                {
                    var nameNorm = NormalizeForSearch(c.Name);
                    var iso2Norm = NormalizeForSearch(c.IsoCode);
                    var iso3Norm = NormalizeForSearch(c.IsoAlpha3);

                    return (!string.IsNullOrEmpty(nameNorm) && nameNorm.Contains(normTerm)) ||
                           (!string.IsNullOrEmpty(iso2Norm) && iso2Norm.Contains(normTerm)) ||
                           (!string.IsNullOrEmpty(iso3Norm) && iso3Norm.Contains(normTerm));
                })
                .OrderBy(c => c.Name)
                .ToList();
        }

        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task OnCountrySelectedChanged(int? countryId)
    {
        if (!countryId.HasValue)
            return;

        await OnCountrySelected(countryId.Value);
    }

    // ===== COUNTRIES =====
    private async Task LoadCountriesAsync()
    {
        _loadingCountries = true;
        try
        {
            var result = await CountryClient.ListAsync(onlyActives: false);
            if (!result.Success)
            {
                Toast.ShowError("Error al cargar los países.");
                _countries = new();
                _filteredCountries = new();
                return;
            }

            _countries = result.Response ?? new();
            _filteredCountries = _countries.ToList();

            if (!_selectedCountryId.HasValue && _countries.Count > 0)
            {
                _selectedCountryId = _countries.First().Id;
                await LoadInstitutionsAsync();
            }
        }
        finally
        {
            _loadingCountries = false;
        }
    }

    private async Task OnCountrySelected(int countryId)
    {
        if (_selectedCountryId == countryId) return;
        _selectedCountryId = countryId;
        await LoadInstitutionsAsync();
    }

    private void OpenCreateCountryModal()
    {
        _isCountryEdit = false;
        _countryEditModel = new CountryDetailDTO
        {
            IsActive = true,
            IsoCode = "",
            IsoAlpha3 = "",
            Name = ""
        };
        _countryModalOpen = true;
    }

    private void OpenEditCountryModal(CountryListItemDTO country)
    {
        _isCountryEdit = true;
        _countryEditModel = new CountryDetailDTO
        {
            Id = country.Id,
            Name = country.Name,
            IsoCode = country.IsoCode,
            IsoAlpha3 = country.IsoAlpha3,
            IsActive = country.IsActive
        };
        _countryModalOpen = true;
    }

    private void CloseCountryModal() => _countryModalOpen = false;

    private bool CanSaveCountry()
    {
        return !string.IsNullOrWhiteSpace(_countryEditModel.Name) &&
               !string.IsNullOrWhiteSpace(_countryEditModel.IsoCode) &&
               _countryEditModel.IsoCode.Length == 2 &&
               !string.IsNullOrWhiteSpace(_countryEditModel.IsoAlpha3) &&
               _countryEditModel.IsoAlpha3.Length == 3;
    }

    private async Task SaveCountryAsync()
    {
        if (!CanSaveCountry())
        {
            Toast.ShowWarning("Por favor complete todos los campos requeridos correctamente.");
            return;
        }

        if (_isCountryEdit)
        {
            var dto = new UpdateCountryRequestDTO
            {
                Id = _countryEditModel.Id,
                Name = _countryEditModel.Name,
                IsoCode = _countryEditModel.IsoCode.ToUpper(),
                IsoAlpha3 = _countryEditModel.IsoAlpha3.ToUpper(),
                IsActive = _countryEditModel.IsActive
            };
            var result = await CountryClient.UpdateAsync(dto);
            if (!result.Success)
            {
                Toast.ShowError("Error al actualizar el país.");
                return;
            }
            Toast.ShowSuccess("País actualizado exitosamente.");
        }
        else
        {
            var dto = new AddCountryRequestDTO
            {
                Name = _countryEditModel.Name,
                IsoCode = _countryEditModel.IsoCode.ToUpper(),
                IsoAlpha3 = _countryEditModel.IsoAlpha3.ToUpper()
            };
            var result = await CountryClient.CreateAsync(dto);
            if (!result.Success)
            {
                Toast.ShowError("Error al crear el país.");
                return;
            }
            Toast.ShowSuccess("País creado exitosamente.");
            _selectedCountryId = result.Response?.Id;
        }
        _countryModalOpen = false;
        await LoadCountriesAsync();
        if (_selectedCountryId.HasValue)
        {
            await LoadInstitutionsAsync();
        }
    }

