    // ===== INSTITUTIONS =====
    private async Task LoadInstitutionsAsync()
    {
        if (!_selectedCountryId.HasValue)
        {
            _institutions.Clear();
            _filteredInstitutions.Clear();
            return;
        }

        _loadingInstitutions = true;
        try
        {
            var result = await InstitutionClient.ListAsync(onlyActives: false);
            if (!result.Success)
            {
                Toast.ShowError("Error al cargar las instituciones.");
                _institutions = new();
                _filteredInstitutions = new();
                return;
            }

            var allInstitutions = result.Response ?? new();
            _institutions = allInstitutions
                .Where(i => i.CountryId == _selectedCountryId.Value)
                .OrderBy(i => i.Name)
                .ToList();

            _filteredInstitutions = _institutions.ToList();
        }
        finally
        {
            _loadingInstitutions = false;
        }
    }

    private void OpenCreateInstitutionModal()
    {
        if (!_selectedCountryId.HasValue)
        {
            Toast.ShowWarning("Seleccione un país primero.");
            return;
        }

        _isInstitutionEdit = false;
        _institutionEditModel = new InstitutionDetailDTO
        {
            Name = "",
            IsActive = true,
            CountryId = _selectedCountryId.Value
        };
        _selectedCountryForInstitution = _countries.FirstOrDefault(c => c.Id == _selectedCountryId.Value);
        _institutionModalOpen = true;
    }

    private async Task OpenEditInstitutionModal(int institutionId)
    {
        _isInstitutionEdit = true;
        var result = await InstitutionClient.GetByIdAsync(institutionId);
        if (!result.Success || result.Response is null)
        {
            Toast.ShowError("Error al cargar los detalles de la institución.");
            return;
        }
        _institutionEditModel = result.Response;
        _selectedCountryForInstitution = _countries.FirstOrDefault(c => c.Id == _institutionEditModel.CountryId);
        _institutionModalOpen = true;
    }

    private void CloseInstitutionModal() => _institutionModalOpen = false;

    private bool CanSaveInstitution()
    {
        return !string.IsNullOrWhiteSpace(_institutionEditModel.Name) &&
               _institutionEditModel.CountryId.HasValue;
    }

    private async Task SaveInstitutionAsync()
    {
        if (!CanSaveInstitution())
        {
            Toast.ShowWarning("El nombre de la institución y el país son requeridos.");
            return;
        }

        if (_isInstitutionEdit)
        {
            var dto = new UpdateInstitutionRequestDTO
            {
                Id = _institutionEditModel.Id,
                Name = _institutionEditModel.Name,
                CountryId = _institutionEditModel.CountryId,
                IsActive = _institutionEditModel.IsActive
            };
            var result = await InstitutionClient.UpdateAsync(dto);
            if (!result.Success)
            {
                Toast.ShowError("Error al actualizar la institución.");
                return;
            }
            Toast.ShowSuccess("Institución actualizada exitosamente.");
        }
        else
        {
            var dto = new AddInstitutionRequestDTO
            {
                Name = _institutionEditModel.Name,
                CountryId = _institutionEditModel.CountryId
            };
            var result = await InstitutionClient.CreateAsync(dto);
            if (!result.Success)
            {
                Toast.ShowError("Error al crear la institución.");
                return;
            }
            Toast.ShowSuccess("Institución creada exitosamente.");
        }
        _institutionModalOpen = false;
        await LoadInstitutionsAsync();
    }

