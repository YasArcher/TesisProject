@using tesisproject.frontend.SharedUI.ActionButton
@using tesisproject.shared.DTOs.Catalog.Common.Response

<div class="rounded-xl border border-border bg-card p-4 space-y-2">
    <div class="flex items-center justify-between">
        <div>
            <h3 class="text-sm font-semibold text-foreground">@Title</h3>
            @if (!string.IsNullOrWhiteSpace(Description))
            {
                <p class="text-xs text-muted">
                    @Description
                </p>
            }
        </div>

        <div class="flex items-center gap-2">
            <span class="text-xs text-muted">
                @Items.Count @ItemLabel
            </span>
            @if (ShowNewButton)
            {
                <ActionButton Text="@NewButtonText"
                              Intent="ButtonIntent.Add"
                              Variant="ButtonVariant.Outline"
                              Size="ButtonSize.Xs"
                              Execute="OnNew">
                    <Icon>
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6">
                            <path fill-rule="evenodd" d="M12 3.75a.75.75 0 0 1 .75.75v6.75h6.75a.75.75 0 0 1 0 1.5h-6.75v6.75a.75.75 0 0 1-1.5 0v-6.75H4.5a.75.75 0 0 1 0-1.5h6.75V4.5a.75.75 0 0 1 .75-.75Z" clip-rule="evenodd" />
                        </svg>

                    </Icon>
                </ActionButton>
            }
        </div>
    </div>

    @if (Items.Count == 0)
    {
        <p class="text-sm text-muted">
            @EmptyMessage
        </p>
    }
    else
    {
        <ul class="space-y-1 max-h-72 overflow-y-auto">
            @foreach (var item in Items)
            {
                <li class="flex items-center justify-between gap-2 text-sm">
                    <div class="flex flex-col">
                        <span class="truncate font-medium">@item.Name</span>
                        <span class="text-xs flex items-center gap-1">
                            @if (ShowActiveBadge)
                            {
                                @if (item.IsActive)
                                {
                                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-success-subtle text-success">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-muted text-muted-foreground">
                                        Inactive
                                    </span>
                                }
                            }

                            @if (ShowLockedBadge && item.IsLocked)
                            {
                                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-muted text-muted-foreground">
                                    Locked
                                </span>
                            }
                        </span>
                    </div>

                    @if (!item.IsLocked && OnEdit.HasDelegate)
                    {
                        <ActionButton Text="@EditButtonText"
                                      Intent="ButtonIntent.Add"
                                      Variant="ButtonVariant.Outline"
                                      Size="ButtonSize.Xs"
                                      Execute="@(() => OnEdit.InvokeAsync(item.Id))" />
                    }
                    else if (item.IsLocked && ShowLockedBadge)
                    {
                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-muted text-muted-foreground">
                            Cannot edit
                        </span>
                    }
                </li>
            }
        </ul>
    }
</div>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Description { get; set; }

    [Parameter]
    public IReadOnlyList<CatalogListItemDTO> Items { get; set; }
        = Array.Empty<CatalogListItemDTO>();

    [Parameter] public string ItemLabel { get; set; } = "items";
    [Parameter] public string EmptyMessage { get; set; } = "No items found.";

    [Parameter] public bool ShowNewButton { get; set; } = true;
    [Parameter] public string NewButtonText { get; set; } = "New";

    [Parameter] public string EditButtonText { get; set; } = "Edit";

    [Parameter] public bool ShowActiveBadge { get; set; } = true;
    [Parameter] public bool ShowLockedBadge { get; set; } = true;

    [Parameter] public EventCallback OnNew { get; set; }
    [Parameter] public EventCallback<int> OnEdit { get; set; }
}
