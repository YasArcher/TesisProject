            b2.AddAttribute(6, "stroke-linecap", "round");
            b2.AddAttribute(7, "stroke-linejoin", "round");
            b2.AddAttribute(8, "stroke-width", "2");
            b2.AddAttribute(9, "d", "M12 4v16m8-8H4");
            b2.CloseElement();
            b2.CloseElement();
        }));
        builder.CloseComponent();

        // Editar
        builder.OpenComponent<ActionButton>(seq++);
        builder.AddAttribute(seq++, "Execute", EventCallback.Factory.Create(this, () => OpenEditCategoryModal(node.Id)));
        builder.AddAttribute(seq++, "Intent", ButtonIntent.Neutral);
        builder.AddAttribute(seq++, "Variant", ButtonVariant.Outline);
        builder.AddAttribute(seq++, "Size", ButtonSize.Xs);
        builder.AddAttribute(seq++, "Icon", (RenderFragment)(b2 =>
        {
            b2.OpenElement(0, "svg");
            b2.AddAttribute(1, "class", "w-3.5 h-3.5");
            b2.AddAttribute(2, "fill", "none");
            b2.AddAttribute(3, "stroke", "currentColor");
            b2.AddAttribute(4, "viewBox", "0 0 24 24");
            b2.OpenElement(5, "path");
            b2.AddAttribute(6, "stroke-linecap", "round");
            b2.AddAttribute(7, "stroke-linejoin", "round");
            b2.AddAttribute(8, "stroke-width", "2");
            b2.AddAttribute(9, "d", "M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z");
            b2.CloseElement();
            b2.CloseElement();
        }));
        builder.CloseComponent();

        // Eliminar (solo hojas)
        if (!hasChildren)
        {
            builder.OpenComponent<ActionButton>(seq++);
            builder.AddAttribute(seq++, "Execute", EventCallback.Factory.Create(this, () => DeleteCategoryAsync(node.Id)));
            builder.AddAttribute(seq++, "Intent", ButtonIntent.Delete);
            builder.AddAttribute(seq++, "Variant", ButtonVariant.Outline);
            builder.AddAttribute(seq++, "Size", ButtonSize.Xs);
            builder.AddAttribute(seq++, "ConfirmBeforeExecute", true);
            builder.AddAttribute(seq++, "ConfirmMessage", $"¿Estás seguro de que deseas eliminar '{node.Name}'?");
            builder.AddAttribute(seq++, "Icon", (RenderFragment)(b2 =>
            {
                b2.OpenElement(0, "svg");
                b2.AddAttribute(1, "class", "w-3.5 h-3.5");
                b2.AddAttribute(2, "fill", "none");
                b2.AddAttribute(3, "stroke", "currentColor");
                b2.AddAttribute(4, "viewBox", "0 0 24 24");
                b2.OpenElement(5, "path");
                b2.AddAttribute(6, "stroke-linecap", "round");
                b2.AddAttribute(7, "stroke-linejoin", "round");
                b2.AddAttribute(8, "stroke-width", "2");
                b2.AddAttribute(9, "d", "M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16");
                b2.CloseElement();
                b2.CloseElement();
            }));
            builder.CloseComponent();
        }

        builder.CloseElement(); // acciones
        builder.CloseElement(); // tarjeta

        // Hijos (solo si expandido)
        if (hasChildren && isExpanded)
        {
            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "mt-2 space-y-2 pl-4 border-l-2 border-border/50");

            for (var i = 0; i < node.Children.Count; i++)
            {
                var child = node.Children[i];
                var childIsLast = i == node.Children.Count - 1;
                builder.AddContent(seq++, RenderCategoryNode(child, depth + 1, childIsLast));
            }

            builder.CloseElement();
        }

        builder.CloseElement(); // wrapper relativo
    };
