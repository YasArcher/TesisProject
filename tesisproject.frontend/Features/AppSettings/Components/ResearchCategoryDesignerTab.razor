    // ===== CATEGORÍAS =====
    private async Task LoadCategoriesAsync()
    {
        _loadingCategories = true;
        try
        {
            _allTree.Clear();
            _filteredTree.Clear();
            _flatCategoriesForGroup.Clear();
            if (!_selectedGroupId.HasValue) return;

            var treeResult = await ResearchCategoryClient.GetTreeAsync(onlyActives: false);
            if (!treeResult.Success)
            {
                Toast.ShowError("Error al cargar el árbol de categorías.");
                return;
            }
            _allTree = treeResult.Response ?? new List<ResearchCategoryTreeItemDTO>();

            var listResult = await ResearchCategoryClient.GetAllAsync(onlyActives: false);
            if (!listResult.Success)
            {
                Toast.ShowError("Error al cargar la lista de categorías.");
                return;
            }
            var flatAll = listResult.Response ?? Array.Empty<ResearchCategoryListItemDTO>();
            var allowedTypeIds = _types.Select(t => t.Id).ToHashSet();

            _flatCategoriesForGroup = flatAll
                .Where(c => allowedTypeIds.Contains(c.ResearchCategoryTypeId))
                .OrderBy(c => c.Name)
                .ToList();

            _filteredTree = _allTree
                .Select(root => FilterNodeByTypes(root, allowedTypeIds))
                .Where(node => node is not null)
                .ToList()!;
        }
        finally
        {
            _loadingCategories = false;
        }
    }

    private void ToggleNodeExpansion(int nodeId)
    {
        if (_expandedNodes.Contains(nodeId))
            _expandedNodes.Remove(nodeId);
        else
            _expandedNodes.Add(nodeId);
    }

    private void ExpandAllNodes()
    {
        _expandedNodes.Clear();
        foreach (var root in _filteredTree)
            AddNodeAndChildrenToExpanded(root);
    }

    private void CollapseAllNodes() => _expandedNodes.Clear();

    private void AddNodeAndChildrenToExpanded(ResearchCategoryTreeItemDTO node)
    {
        if (node.Children.Any())
        {
            _expandedNodes.Add(node.Id);
            foreach (var child in node.Children)
                AddNodeAndChildrenToExpanded(child);
        }
    }

    private ResearchCategoryTreeItemDTO? FilterNodeByTypes(ResearchCategoryTreeItemDTO node, HashSet<int> allowedTypeIds)
    {
        var filteredChildren = node.Children
            .Select(child => FilterNodeByTypes(child, allowedTypeIds))
            .Where(child => child is not null)
            .ToList()!;

        var includeThis = allowedTypeIds.Contains(node.ResearchCategoryTypeId);
        if (!includeThis && filteredChildren.Count == 0) return null;

        return new ResearchCategoryTreeItemDTO
        {
            Id = node.Id,
            Name = node.Name,
            IsActive = node.IsActive,
            ResearchCategoryTypeId = node.ResearchCategoryTypeId,
            ResearchCategoryTypeName = node.ResearchCategoryTypeName,
            ParentCategoryId = node.ParentCategoryId,
            Children = filteredChildren
        };
    }

    private void OpenCreateRootCategoryModalForType(int typeId)
    {
        if (!_selectedGroupId.HasValue || _types.Count == 0)
        {
            Toast.ShowWarning("Selecciona un grupo y asegúrate de tener al menos un tipo.");
            return;
        }

        var selectedType = _types.FirstOrDefault(t => t.Id == typeId);
        if (selectedType == null || !selectedType.IsActive)
        {
            Toast.ShowWarning("El tipo seleccionado no está activo.");
            return;
        }

        _isCategoryEdit = false;
        _categoryParentLocked = false;
        _categoryParentLockedFromTree = false;

        _categoryEditModel = new ResearchCategoryDetailDTO
        {
            IsActive = true,
            ParentCategoryId = null,
            ResearchCategoryTypeId = typeId
        };

        _selectedTypeForCategory = selectedType;
        _selectedParentCategory = null;

        _categoryModalOpen = true;
    }

    private void OpenCreateChildCategoryModal(int parentCategoryId)
    {
        if (!_selectedGroupId.HasValue || _types.Count == 0)
        {
            Toast.ShowWarning("Selecciona un grupo y asegúrate de tener al menos un tipo.");
            return;
        }

        var parent = _flatCategoriesForGroup.FirstOrDefault(c => c.Id == parentCategoryId);
        if (parent == null)
        {
            Toast.ShowError("Categoría padre no encontrada.");
            return;
        }

        var parentTypeIndex = _types.FindIndex(t => t.Id == parent.ResearchCategoryTypeId);
        var nextTypeId = parentTypeIndex >= 0 && parentTypeIndex < _types.Count - 1
            ? _types[parentTypeIndex + 1].Id
            : parent.ResearchCategoryTypeId;

        _isCategoryEdit = false;
        _categoryParentLocked = false;
        _categoryParentLockedFromTree = true;

        _categoryEditModel = new ResearchCategoryDetailDTO
        {
            IsActive = true,
            ParentCategoryId = parentCategoryId,
            ResearchCategoryTypeId = nextTypeId
        };

        _selectedTypeForCategory = _types.FirstOrDefault(t => t.Id == nextTypeId);
        _selectedParentCategory = parent;

        _categoryModalOpen = true;
    }

    private async Task OpenEditCategoryModal(int categoryId)
    {
        _isCategoryEdit = true;
        _categoryParentLocked = false;
        _categoryParentLockedFromTree = false;

        var result = await ResearchCategoryClient.GetByIdAsync(categoryId);
        if (!result.Success || result.Response is null)
        {
            Toast.ShowError("Error al cargar los detalles de la categoría.");
            return;
        }
        _categoryEditModel = result.Response;

        _selectedTypeForCategory = _types.FirstOrDefault(t => t.Id == _categoryEditModel.ResearchCategoryTypeId);
        _selectedParentCategory = _categoryEditModel.ParentCategoryId.HasValue
            ? _flatCategoriesForGroup.FirstOrDefault(c => c.Id == _categoryEditModel.ParentCategoryId)
            : null;

        _categoryModalOpen = true;
    }

    private void CloseCategoryModal() => _categoryModalOpen = false;

    private void OnCategoryTypeChanged()
    {
        if (!_categoryParentLockedFromTree)
        {
            _categoryEditModel.ParentCategoryId = null;
            _selectedParentCategory = null;
        }
        StateHasChanged();
    }

    private bool GetIsParentRequired()
    {
        if (_categoryEditModel.ResearchCategoryTypeId <= 0) return false;
        var typeIndex = _types.FindIndex(t => t.Id == _categoryEditModel.ResearchCategoryTypeId);
        return typeIndex > 0;
    }

    private string GetRequiredParentTypeName()
    {
        if (_categoryEditModel.ResearchCategoryTypeId <= 0) return "";
        var typeIndex = _types.FindIndex(t => t.Id == _categoryEditModel.ResearchCategoryTypeId);
        if (typeIndex <= 0) return "";
        return _types[typeIndex - 1].Name;
    }

    private List<ResearchCategoryListItemDTO> GetAvailableParents()
    {
        if (_categoryEditModel.ResearchCategoryTypeId <= 0) return new();
        var typeIndex = _types.FindIndex(t => t.Id == _categoryEditModel.ResearchCategoryTypeId);
        if (typeIndex <= 0) return new();
        var parentTypeId = _types[typeIndex - 1].Id;
        return _flatCategoriesForGroup
            .Where(c => c.ResearchCategoryTypeId == parentTypeId)
            .Where(c => !_isCategoryEdit || c.Id != _categoryEditModel.Id)
            .OrderBy(c => c.Name)
            .ToList();
    }

    private bool CanSaveCategory()
    {
        if (string.IsNullOrWhiteSpace(_categoryEditModel.Name)) return false;
        if (_categoryEditModel.ResearchCategoryTypeId <= 0) return false;
        if (_isParentRequired && !_categoryEditModel.ParentCategoryId.HasValue) return false;
        if (_isParentRequired && !_availableParents.Any()) return false;
        return true;
    }

    private async Task SaveCategoryAsync()
    {
        if (!CanSaveCategory())
        {
            if (string.IsNullOrWhiteSpace(_categoryEditModel.Name))
                Toast.ShowWarning("El nombre de la categoría es obligatorio.");
            else if (_categoryEditModel.ResearchCategoryTypeId <= 0)
                Toast.ShowWarning("El tipo de categoría es obligatorio.");
            else if (_isParentRequired && !_categoryEditModel.ParentCategoryId.HasValue)
                Toast.ShowWarning($"Se requiere una categoría padre de tipo '{_requiredParentTypeName}'.");
            return;
        }

        if (_isCategoryEdit)
        {
            var dto = new UpdateResearchCategoryRequestDTO
            {
                Id = _categoryEditModel.Id,
                Name = _categoryEditModel.Name,
                IsActive = _categoryEditModel.IsActive,
                ResearchCategoryTypeId = _categoryEditModel.ResearchCategoryTypeId,
                ParentCategoryId = _categoryEditModel.ParentCategoryId
            };
            var result = await ResearchCategoryClient.UpdateAsync(dto);
            if (!result.Success)
            {
                Toast.ShowError("Error al actualizar la categoría.");
                return;
            }
            Toast.ShowSuccess("Categoría actualizada correctamente.");
        }
        else
        {
            var dto = new AddResearchCategoryRequestDTO
            {
                Name = _categoryEditModel.Name,
                IsActive = _categoryEditModel.IsActive,
                ResearchCategoryTypeId = _categoryEditModel.ResearchCategoryTypeId,
                ParentCategoryId = _categoryEditModel.ParentCategoryId
            };
            var result = await ResearchCategoryClient.CreateAsync(dto);
            if (!result.Success)
            {
                Toast.ShowError("Error al crear la categoría.");
                return;
            }
            Toast.ShowSuccess("Categoría creada correctamente.");
        }
        _categoryModalOpen = false;
        await LoadCategoriesAsync();
        await LoadTypesAsync();
    }

    private async Task DeleteCategoryAsync(int categoryId)
    {
        var result = await ResearchCategoryClient.DeleteAsync(categoryId);
        if (!result.Success)
        {
            Toast.ShowError("Error al eliminar la categoría.");
            return;
        }
        Toast.ShowSuccess("Categoría eliminada correctamente.");
        await LoadCategoriesAsync();
        await LoadTypesAsync();
    }

    // ===== RENDERIZADO DEL ÁRBOL =====
    private RenderFragment RenderCategoryNode(ResearchCategoryTreeItemDTO node, int depth, bool isLast) => builder =>
    {
        var seq = 0;
        var hasChildren = node.Children.Any();
        var isExpanded = _expandedNodes.Contains(node.Id);

        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "relative");

        // Tarjeta del nodo
        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", $"group/node flex items-center gap-3 p-3 rounded-lg border-2 border-border bg-background hover:border-primary/40 hover:bg-primary/5 transition-all duration-150 {(depth > 0 ? "ml-6" : "")}");

        // Izquierda: botón expandir + ícono + contenido
        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "flex items-center gap-3 flex-1 min-w-0");

        // Botón expandir/colapsar
        if (hasChildren)
        {
            builder.OpenComponent<ActionButton>(seq++);
            builder.AddAttribute(seq++, "Execute", EventCallback.Factory.Create(this, () => ToggleNodeExpansion(node.Id)));
            builder.AddAttribute(seq++, "Variant", ButtonVariant.Ghost);
            builder.AddAttribute(seq++, "Size", ButtonSize.Xs);
            builder.AddAttribute(seq++, "Class", "p-0 w-6 h-6 min-w-0");
            builder.AddAttribute(seq++, "Icon", (RenderFragment)(b2 =>
            {
                b2.OpenElement(0, "svg");
                b2.AddAttribute(1, "class", $"w-4 h-4 transition-transform duration-200 {(isExpanded ? "rotate-90" : "")}");
                b2.AddAttribute(2, "fill", "none");
                b2.AddAttribute(3, "stroke", "currentColor");
                b2.AddAttribute(4, "viewBox", "0 0 24 24");
                b2.OpenElement(5, "path");
                b2.AddAttribute(6, "stroke-linecap", "round");
                b2.AddAttribute(7, "stroke-linejoin", "round");
                b2.AddAttribute(8, "stroke-width", "2");
                b2.AddAttribute(9, "d", "M9 5l7 7-7 7");
                b2.CloseElement();
                b2.CloseElement();
            }));
            builder.CloseComponent();
        }
        else
        {
            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "w-6 flex-shrink-0");
            builder.CloseElement();
        }

        // Ícono del nodo
        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", $"w-8 h-8 rounded-lg flex items-center justify-center flex-shrink-0 {(node.IsActive ? "bg-secondary/15 text-secondary" : "bg-muted/15 text-muted")}");
        builder.OpenElement(seq++, "svg");
        builder.AddAttribute(seq++, "class", "w-4 h-4");
        builder.AddAttribute(seq++, "fill", "none");
        builder.AddAttribute(seq++, "stroke", "currentColor");
        builder.AddAttribute(seq++, "viewBox", "0 0 24 24");
        builder.OpenElement(seq++, "path");
        builder.AddAttribute(seq++, "stroke-linecap", "round");
        builder.AddAttribute(seq++, "stroke-linejoin", "round");
        builder.AddAttribute(seq++, "stroke-width", "2");
        builder.AddAttribute(seq++, "d", hasChildren ? "M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" : "M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z");
        builder.CloseElement();
        builder.CloseElement();
        builder.CloseElement();

        // Nombre y tipo
        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "flex-1 min-w-0");
        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "font-medium text-sm text-foreground truncate");
        builder.AddContent(seq++, node.Name);
        builder.CloseElement();

        if (!string.IsNullOrWhiteSpace(node.ResearchCategoryTypeName))
        {
            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "text-xs text-muted mt-0.5");
            builder.AddContent(seq++, node.ResearchCategoryTypeName);
            builder.CloseElement();
        }
        builder.CloseElement();

        builder.CloseElement(); // flex items-center

        // Acciones
        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "flex items-center gap-2 opacity-0 group-hover/node:opacity-100 transition-opacity flex-shrink-0");

        // Agregar hijo
        builder.OpenComponent<ActionButton>(seq++);
