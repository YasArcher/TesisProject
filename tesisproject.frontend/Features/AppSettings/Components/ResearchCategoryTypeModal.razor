@using tesisproject.frontend.SharedUI.ActionButton
@using tesisproject.frontend.SharedUI.Modal
@using tesisproject.frontend.SharedUI.TextInput
@using tesisproject.shared.DTOs.Catalog.ResearchCategoryType.Response

<Modal Id="research-type-modal"
       IsOpen="IsOpen"
       IsOpenChanged="IsOpenChanged"
       Title="@(IsEdit ? "Editar Tipo de Categoría" : "Nuevo Tipo de Categoría")"
       Size="ModalSize.Sm">
    <ChildContent>
        <div class="space-y-4">
            <TextInput @bind-Value="Model.Name"
                       Label="Nombre del Tipo"
                       Placeholder="Ej: Dominio, Línea de Investigación, Campo"
                       Required="true" />

            <div class="space-y-2">
                <label class="text-sm font-medium text-muted">
                    Grupo de Categoría
                </label>
                <input type="text"
                       class="w-full rounded-lg border border-border bg-muted/5 px-3 py-2 text-sm text-muted cursor-not-allowed"
                       value="@SelectedGroupName"
                       disabled />
            </div>

            @if (IsEdit)
            {
                <label class="flex items-center gap-2 cursor-pointer">
                    <input type="checkbox"
                           class="h-4 w-4 rounded border-border text-primary focus:ring-2 focus:ring-primary/30 cursor-pointer"
                           @bind="Model.IsActive" />
                    <span class="text-sm text-foreground">Activo</span>
                </label>
            }

            <div class="flex justify-end gap-2 pt-4 border-t border-border">
                <ActionButton Execute="HandleCancel"
                              Text="Cancelar"
                              Intent="ButtonIntent.Neutral"
                              Variant="ButtonVariant.Outline"
                              Size="ButtonSize.Sm" />

                <ActionButton Execute="HandleSave"
                              Text="Guardar"
                              Intent="ButtonIntent.Accept"
                              Size="ButtonSize.Sm" />
            </div>
        </div>
    </ChildContent>
</Modal>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public bool IsEdit { get; set; }

    [Parameter, EditorRequired]
    public ResearchCategoryTypeDetailDTO Model { get; set; } = new();

    [Parameter] public string SelectedGroupName { get; set; } = "Sin grupo seleccionado";

    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private Task HandleSave() => OnSave.InvokeAsync();
    private Task HandleCancel() => OnCancel.InvokeAsync();
}