@using tesisproject.shared.DTOs.Catalog.Common.Response
@using tesisproject.frontend.SharedUI.ActionButton

<div class="group rounded-xl border-2 border-border bg-background shadow-sm hover:shadow-md transition-all duration-200">
    <!-- Header Section -->
    <div class="p-5 border-b border-border bg-background/50">
        <div class="flex items-start justify-between gap-4">
            <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 mb-1">
                    @if (Icon is not null)
                    {
                        <div class="h-5 w-5 text-primary flex-shrink-0">
                            @Icon
                        </div>
                    }
                    <h3 class="text-base font-semibold text-foreground truncate">@Title</h3>
                </div>
                @if (!string.IsNullOrWhiteSpace(Description))
                {
                    <p class="text-xs text-muted leading-relaxed">
                        @Description
                    </p>
                }
            </div>

            <div class="flex items-center gap-3 flex-shrink-0">
                <span class="inline-flex items-center px-2.5 py-1 rounded-md bg-primary/10 text-xs font-medium text-primary whitespace-nowrap">
                    @Items.Count @(Items.Count == 1 ? CountLabelSingular : CountLabelPlural)
                </span>

                <ActionButton Text="@NewButtonText"
                              Intent="ButtonIntent.Add"
                              Variant="ButtonVariant.Outline"
                              Size="ButtonSize.Xs"
                              Execute="OnNewRequested" >
                          <Icon>
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6">
                            <path fill-rule="evenodd" d="M12 3.75a.75.75 0 0 1 .75.75v6.75h6.75a.75.75 0 0 1 0 1.5h-6.75v6.75a.75.75 0 0 1-1.5 0v-6.75H4.5a.75.75 0 0 1 0-1.5h6.75V4.5a.75.75 0 0 1 .75-.75Z" clip-rule="evenodd" />
                        </svg>

                          </Icon>
                          </ActionButton>
            </div>
        </div>
    </div>

    <!-- Body Section -->
    <div class="p-5">
        @if (Items.Count == 0)
        {
            <!-- Empty State -->
            <div class="flex flex-col items-center justify-center text-center py-8 px-4">
                @if (EmptyIcon is not null)
                {
                    <div class="mx-auto h-12 w-12 text-muted/40 mb-3">
                        @EmptyIcon
                    </div>
                }
                else
                {
                    <svg class="mx-auto h-12 w-12 text-muted/40 mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4" />
                    </svg>
                }

                <p class="text-sm font-medium text-muted">
                    @EmptyTitle
                </p>

                @if (!string.IsNullOrWhiteSpace(EmptySubtitle))
                {
                    <p class="mt-1 text-xs text-muted/70 max-w-xs">
                        @EmptySubtitle
                    </p>
                }
            </div>
        }
        else
        {
            <!-- Items List -->
            <ul class="space-y-2 max-h-96 overflow-y-auto pr-1 scrollbar-thin">
                @foreach (var item in Items)
                {
                    <li class="group/item rounded-lg border border-border bg-background hover:border-primary/40 hover:bg-primary/5 transition-all duration-150">
                        <div class="flex items-center justify-between gap-3 p-3">
                            <!-- Item Info -->
                            <div class="flex flex-col flex-1 min-w-0">
                                <span class="truncate font-medium text-sm text-foreground mb-1.5">
                                    @item.Name
                                </span>

                                <div class="flex items-center gap-1.5 flex-wrap">
                                    <!-- Active/Inactive Badge -->
                                    @if (item.IsActive)
                                    {
                                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-xs font-medium bg-secondary/15 text-secondary border border-secondary/30">
                                            <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                                            </svg>
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-xs font-medium bg-muted/15 text-muted border border-border">
                                            <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
                                            </svg>
                                            Inactive
                                        </span>
                                    }

                                    <!-- Locked Badge -->
                                    @if (item.IsLocked)
                                    {
                                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-xs font-medium bg-accent/15 text-accent border border-accent/30">
                                            <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                                            </svg>
                                            Locked
                                        </span>
                                    }
                                </div>
                            </div>

                            <!-- Action Buttons -->
                            <div class="flex items-center gap-2 flex-shrink-0">
                                @if (!item.IsLocked)
                                {
                                    <!-- Edit Button -->
                                    <ActionButton Intent="ButtonIntent.Add"
                                                  Variant="ButtonVariant.Outline"
                                                  Size="ButtonSize.Xs"
                                                  Execute="@(() => OnEditRequested.InvokeAsync(item.Id))"
                                                  Class="opacity-80 hover:opacity-100">
                                        <Icon>
                                            @if (EditIcon is not null)
                                            {
                                                @EditIcon
                                            }
                                            else
                                            {
                                                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                                </svg>
                                            }
                                        </Icon>
                                    </ActionButton>

                                    <!-- Delete Button -->
                                    <ActionButton Intent="ButtonIntent.Delete"
                                                  Variant="ButtonVariant.Outline"
                                                  Size="ButtonSize.Xs"
                                                  ConfirmBeforeExecute="true"
                                                  ConfirmTitle="@DeleteConfirmTitle"
                                                  ConfirmMessage="@DeleteConfirmMessage"
                                                  ConfirmButtonText="@DeleteConfirmButtonText"
                                                  CancelButtonText="@DeleteCancelButtonText"
                                                  Execute="@(() => OnDeleteRequested.InvokeAsync(item.Id))"
                                                  Class="opacity-80 hover:opacity-100">
                                        <Icon>
                                            @if (DeleteIcon is not null)
                                            {
                                                @DeleteIcon
                                            }
                                            else
                                            {
                                                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                                </svg>
                                            }
                                        </Icon>
                                    </ActionButton>
                                }
                                else
                                {
                                    <!-- Protected Label -->
                                    <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-medium bg-muted/10 text-muted/60">
                                        <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                                        </svg>
                                        Protected
                                    </div>
                                }
                            </div>
                        </div>
                    </li>
                }
            </ul>
        }
    </div>
</div>

@code {
    // Lista de items
    [Parameter] public IReadOnlyList<CatalogListItemDTO> Items { get; set; } = Array.Empty<CatalogListItemDTO>();

    // Textos de cabecera
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string Description { get; set; } = string.Empty;
    [Parameter] public string NewButtonText { get; set; } = "New item";

    // Etiquetas de contador
    [Parameter] public string CountLabelSingular { get; set; } = "item";
    [Parameter] public string CountLabelPlural { get; set; } = "items";

    // Textos de estado vacío
    [Parameter] public string EmptyTitle { get; set; } = "No items yet";
    [Parameter] public string EmptySubtitle { get; set; } = "Create items to start using this catalog.";

    // Textos de confirmación de eliminación
    [Parameter] public string DeleteConfirmTitle { get; set; } = "Delete item";
    [Parameter] public string DeleteConfirmMessage { get; set; } = "Are you sure you want to delete this item? This action cannot be undone.";
    [Parameter] public string DeleteConfirmButtonText { get; set; } = "Delete";
    [Parameter] public string DeleteCancelButtonText { get; set; } = "Cancel";

    // Iconos personalizables (RenderFragment para flexibilidad)
    [Parameter] public RenderFragment? Icon { get; set; }
    [Parameter] public RenderFragment? EmptyIcon { get; set; }
    [Parameter] public RenderFragment? EditIcon { get; set; }
    [Parameter] public RenderFragment? DeleteIcon { get; set; }

    // Callbacks de eventos
    [Parameter] public EventCallback OnNewRequested { get; set; }
    [Parameter] public EventCallback<int> OnEditRequested { get; set; }
    [Parameter] public EventCallback<int> OnDeleteRequested { get; set; }
}