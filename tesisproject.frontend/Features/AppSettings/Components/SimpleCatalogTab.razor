@using tesisproject.frontend.SharedUI.ActionButton
@using tesisproject.frontend.SharedUI.Modal
@using tesisproject.shared.DTOs.Catalog.Common.Response

<div class="h-full min-h-0 flex flex-col p-6 max-w-7xl mx-auto w-full">
    @if (Loading)
    {
        <div class="flex-1 min-h-0 flex items-center justify-center py-12">
            <div class="text-center space-y-3">
                <div class="inline-block h-8 w-8 animate-spin rounded-full border-4 border-solid border-primary border-r-transparent"></div>
                <p class="text-sm text-muted">Cargando catálogos...</p>
            </div>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(Error))
    {
        <div class="shrink-0 rounded-lg border-2 border-error bg-error/5 p-4">
            <div class="flex items-start gap-3">
                <svg class="h-5 w-5 text-error flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <div class="flex-1">
                    <h3 class="text-sm font-semibold text-error mb-1">Error al cargar datos</h3>
                    <p class="text-sm text-error/80">@Error</p>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="flex-1 min-h-0 overflow-y-auto pr-1">
            <div class="grid gap-6 grid-cols-1 md:grid-cols-2 xl:grid-cols-3 items-start">
                <div class="min-h-0">
                    <CatalogCard Items="DocumentTypes"
                                 Title="Tipos de Documento"
                                 Description="Tipos de documentos asociados a proyectos, visitas y procesos."
