@* ===== MODALS (reutilizando CatalogEditModal) ===== *@

<CatalogEditModal Id="document-type-modal"
                  IsOpen="@DocumentTypeModalOpen"
                  IsOpenChanged="DocumentTypeModalOpenChanged"
                  IsEditMode="@IsDocumentTypeEditMode"
                  IsSaving="@SavingDocumentType"
                  Error="@DocumentTypeError"
                  Model="@DocumentTypeEditModel"
                  NewTitle="Nuevo tipo de documento"
                  EditTitle="Editar tipo de documento"
                  OnCancel="OnDocumentTypeCancelRequested"
                  OnSave="OnDocumentTypeSaveRequested" />

