@page "/settings"

@using tesisproject.frontend.Features.AppSettings.Components
@using tesisproject.frontend.SharedUI.Tabs
@using tesisproject.frontend.SharedUI.ActionButton
@using tesisproject.frontend.SharedUI.Modal
@using tesisproject.frontend.Services.Interfaces

@using tesisproject.shared.DTOs.Catalog.Common.Request
@using tesisproject.shared.DTOs.Catalog.Common.Response
@using tesisproject.shared.DTOs.Catalog.ProductAttribute.Request
@using tesisproject.shared.DTOs.Catalog.ProductAttribute.Response
@using tesisproject.shared.DTOs.Products.ProductAttributeDefinition.Request
@using tesisproject.shared.DTOs.Products.ProductTypeDesign.Request
@using tesisproject.shared.DTOs.Products.ProductTypeDesign.Response
@using tesisproject.shared.Enums

@inject IToastService Toast
@inject IProductTypeClientService ProductTypeClient
@inject IProductTypeDesignClientService ProductTypeDesignClient
@inject IProductAttributeClientService ProductAttributeClient

@inject IDocumentTypeClientService DocumentTypeClient
@inject IFundingTypeClientService FundingTypeClient
@inject IObjectiveTypeClientService ObjectiveTypeClient
@inject IProjectTypeClientService ProjectTypeClient
@inject ITransactionTypeClientService TransactionTypeClient

<div class="flex flex-col h-full min-h-0 gap-4">
    <!-- Header -->
    <div class="rounded-2xl border border-border p-6 bg-primary-subtle/50 backdrop-blur-sm shrink-0">
        <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
            <div class="space-y-2">
                <h1 class="text-2xl font-bold text-foreground">
                    Configuración del Sistema
                </h1>
                @* <p class="text-sm text-muted">
                    Configure catálogos del sistema, productos y otras opciones.
                </p> *@
            </div>
        </div>
    </div>

    <!-- Tabs container -->
    <div class="flex-1 min-h-0 overflow-hidden">
        <Tabs ActiveKey="@_activeTab"
              OnChange="OnTabChanged"
              Variant="TabVariant.Underline">

            <!-- Products configuration tab -->
            <Tab Key="products" Title="Productos">
                <Icon>
                    <svg xmlns="http://www.w3.org/2000/svg"
                         viewBox="0 0 24 24"
                         fill="currentColor"
                         class="size-5">
                        <path fill-rule="evenodd"
                              d="M4.5 5.25A2.25 2.25 0 0 1 6.75 3h10.5A2.25 2.25 0 0 1 19.5 5.25v13.5a.75.75 0 0 1-1.133.62L12 15.884l-6.367 3.486A.75.75 0 0 1 4.5 18.75V5.25Z"
                              clip-rule="evenodd" />
                    </svg>
                </Icon>

                <ChildContent>
                    <Tabs ActiveKey="@_productsSubTab"
                          OnChange="OnProductsSubTabChanged"
                          Variant="TabVariant.Pills">

                        <!-- Sub-tab: Product catalogs (Product Types + Attributes) -->
                        <Tab Key="catalogs" Title="Catálogos de productos">
                            <ChildContent>
                                <ProductCatalogsTab Loading="@_catalogLoading"
                                                    Error="@_catalogError"
                                                    ProductTypes="@(_catalogProductTypes)"
                                                    ProductAttributes="@(_catalogProductAttributes)"
                                                    TypeModalOpen="@_typeModalOpen"
                                                    TypeModalOpenChanged="v => _typeModalOpen = v"
                                                    IsTypeEditMode="@_isTypeEditMode"
                                                    SavingType="@_savingType"
                                                    TypeError="@_typeError"
                                                    TypeEditModel="@_typeEditModel"
                                                    AttributeModalOpen="@_attributeModalOpen"
                                                    AttributeModalOpenChanged="v => _attributeModalOpen = v"
                                                    IsAttributeEditMode="@_isAttributeEditMode"
                                                    SavingAttribute="@_savingAttribute"
                                                    AttributeError="@_attributeError"
                                                    AttributeEditModel="@_attributeEditModel"
                                                    DataTypes="@_dataTypes"
                                                    OnNewProductTypeRequested="HandleOpenNewProductTypeModal"
                                                    OnEditProductTypeRequested="HandleOpenEditProductTypeModal"
                                                    OnTypeCancelRequested="HandleCancelTypeEdit"
                                                    OnTypeSaveRequested="HandleSaveTypeAsync"
                                                    OnDeleteProductTypeRequested="HandleDeleteProductTypeAsync"
                                                    OnNewAttributeRequested="HandleOpenNewAttributeModal"
                                                    OnEditAttributeRequested="HandleOpenEditAttributeModal"
                                                    OnAttributeCancelRequested="HandleCancelAttributeEdit"
                                                    OnAttributeSaveRequested="HandleSaveAttributeAsync"
                                                    OnDeleteAttributeRequested="HandleDeleteAttributeAsync" />
                            </ChildContent>
                        </Tab>

                        <!-- Sub-tab: Designer -->
                        <Tab Key="designer" Title="Diseñador">
                            <ChildContent>
                                <ProductTypeDesignerTab Loading="@_designerLoading"
                                                        Error="@_designerError"
                                                        ProductTypes="@_designerProductTypes"
                                                        CurrentDesign="@_designerCurrentDesign"
                                                        AvailableAttributes="@_designerAvailableAttributes"
                                                        DefinitionRows="@_designerDefinitionRows"
                                                        Saving="@_designerSaving"
                                                        DesignError="@_designerDesignError"
                                                        OnProductTypeSelected="HandleDesignerLoadDesignAsync"
                                                        OnAddDefinitionRequested="HandleDesignerAddDefinition"
                                                        OnRemoveDefinitionRequested="HandleDesignerRemoveDefinition"
                                                        OnSaveDesignRequested="HandleDesignerSaveDesignAsync"
                                                        OnDefinitionRowsReordered="HandleDesignerRowsReordered" />
                            </ChildContent>
                        </Tab>

                    </Tabs>
                </ChildContent>
            </Tab>

            <!-- Core catalogs tab -->
            <Tab Key="core-catalogs" Title="Catálogos principales">
                <Icon>
                    <svg xmlns="http://www.w3.org/2000/svg"
                         viewBox="0 0 24 24"
                         fill="currentColor"
                         class="size-5">
                        <path fill-rule="evenodd"
                              d="M4 6h16v2H4V6zm0 5h16v2H4v-2zm0 5h16v2H4v-2z"
                              clip-rule="evenodd" />
                    </svg>
                </Icon>
                <ChildContent>
                    <SimpleCatalogTab Loading="@_coreCatalogsLoading"
                                      Error="@_coreCatalogsError"
                                      DocumentTypes="@_documentTypes"
                                      FundingTypes="@_fundingTypes"
                                      ObjectiveTypes="@_objectiveTypes"
                                      ProjectTypes="@_projectTypesCore"
                                      TransactionTypes="@_transactionTypes"
                                      DocumentTypeModalOpen="@_documentTypeModalOpen"
                                      DocumentTypeModalOpenChanged="v => _documentTypeModalOpen = v"
                                      IsDocumentTypeEditMode="@_isDocumentTypeEditMode"
                                      SavingDocumentType="@_savingDocumentType"
                                      DocumentTypeError="@_documentTypeError"
                                      DocumentTypeEditModel="@_documentTypeEditModel"
                                      FundingTypeModalOpen="@_fundingTypeModalOpen"
                                      FundingTypeModalOpenChanged="v => _fundingTypeModalOpen = v"
                                      IsFundingTypeEditMode="@_isFundingTypeEditMode"
                                      SavingFundingType="@_savingFundingType"
                                      FundingTypeError="@_fundingTypeError"
                                      FundingTypeEditModel="@_fundingTypeEditModel"
                                      ObjectiveTypeModalOpen="@_objectiveTypeModalOpen"
                                      ObjectiveTypeModalOpenChanged="v => _objectiveTypeModalOpen = v"
                                      IsObjectiveTypeEditMode="@_isObjectiveTypeEditMode"
                                      SavingObjectiveType="@_savingObjectiveType"
                                      ObjectiveTypeError="@_objectiveTypeError"
                                      ObjectiveTypeEditModel="@_objectiveTypeEditModel"
                                      ProjectTypeModalOpen="@_projectTypeModalOpen"
                                      ProjectTypeModalOpenChanged="v => _projectTypeModalOpen = v"
                                      IsProjectTypeEditMode="@_isProjectTypeEditMode"
                                      SavingProjectType="@_savingProjectType"
                                      ProjectTypeError="@_projectTypeError"
                                      ProjectTypeEditModel="@_projectTypeEditModel"
                                      TransactionTypeModalOpen="@_transactionTypeModalOpen"
                                      TransactionTypeModalOpenChanged="v => _transactionTypeModalOpen = v"
                                      IsTransactionTypeEditMode="@_isTransactionTypeEditMode"
                                      SavingTransactionType="@_savingTransactionType"
                                      TransactionTypeError="@_transactionTypeError"
                                      TransactionTypeEditModel="@_transactionTypeEditModel"
                                      OnNewDocumentTypeRequested="HandleOpenNewDocumentTypeModal"
                                      OnEditDocumentTypeRequested="HandleOpenEditDocumentTypeModal"
                                      OnDocumentTypeCancelRequested="HandleCancelDocumentTypeEdit"
                                      OnDocumentTypeSaveRequested="HandleSaveDocumentTypeAsync"
                                      OnDeleteDocumentTypeRequested="HandleDeleteDocumentTypeAsync"
                                      OnNewFundingTypeRequested="HandleOpenNewFundingTypeModal"
                                      OnEditFundingTypeRequested="HandleOpenEditFundingTypeModal"
                                      OnFundingTypeCancelRequested="HandleCancelFundingTypeEdit"
                                      OnFundingTypeSaveRequested="HandleSaveFundingTypeAsync"
                                      OnDeleteFundingTypeRequested="HandleDeleteFundingTypeAsync"
                                      OnNewObjectiveTypeRequested="HandleOpenNewObjectiveTypeModal"
                                      OnEditObjectiveTypeRequested="HandleOpenEditObjectiveTypeModal"
                                      OnObjectiveTypeCancelRequested="HandleCancelObjectiveTypeEdit"
                                      OnObjectiveTypeSaveRequested="HandleSaveObjectiveTypeAsync"
                                      OnDeleteObjectiveTypeRequested="HandleDeleteObjectiveTypeAsync"
                                      OnNewProjectTypeRequested="HandleOpenNewProjectTypeCoreModal"
                                      OnEditProjectTypeRequested="HandleOpenEditProjectTypeCoreModal"
                                      OnProjectTypeCancelRequested="HandleCancelProjectTypeCoreEdit"
                                      OnProjectTypeSaveRequested="HandleSaveProjectTypeCoreAsync"
                                      OnDeleteProjectTypeRequested="HandleDeleteProjectTypeCoreAsync"
                                      OnNewTransactionTypeRequested="HandleOpenNewTransactionTypeModal"
                                      OnEditTransactionTypeRequested="HandleOpenEditTransactionTypeModal"
                                      OnTransactionTypeCancelRequested="HandleCancelTransactionTypeEdit"
                                      OnTransactionTypeSaveRequested="HandleSaveTransactionTypeAsync"
                                      OnDeleteTransactionTypeRequested="HandleDeleteTransactionTypeAsync" />
                </ChildContent>
            </Tab>

            <!-- Research categories tab -->
            <Tab Key="research-categories" Title="Categorías de investigación">
                <Icon>
                    <svg xmlns="http://www.w3.org/2000/svg"
                         viewBox="0 0 24 24"
                         fill="currentColor"
                         class="size-5">
                        <path d="M4 4h7v7H4z" />
                        <path d="M13 4h7v7h-7z" />
                        <path d="M4 13h7v7H4z" />
                        <path d="M13 13h7v7h-7z" />
                    </svg>
                </Icon>
                <ChildContent>
                    <ResearchCategoryDesignerTab />
                </ChildContent>
            </Tab>
            <!-- Countries & Institutions tab -->
            <Tab Key="countries-institutions" Title="Países e Instituciones">
                <Icon>
                    <svg xmlns="http://www.w3.org/2000/svg"
                         viewBox="0 0 24 24"
                         fill="currentColor"
                         class="size-5">
                        <path d="M4.5 6.75A.75.75 0 0 1 5.25 6h13.5a.75.75 0 0 1 .75.75v10.5a.75.75 0 0 1-.75.75H5.25a.75.75 0 0 1-.75-.75V6.75Z" />
                        <path d="M7.5 9h3v6h-3V9Zm6 0h3v6h-3V9Z" />
                    </svg>
                </Icon>
                <ChildContent>
                    <CountriesAndInstitutionsTab />
                </ChildContent>
            </Tab>
                        <!-- Technician groups tab -->
            <Tab Key="technician-groups" Title="Grupos de técnicos">
                <Icon>
                    <svg xmlns="http://www.w3.org/2000/svg"
                         viewBox="0 0 24 24"
                         fill="currentColor"
                         class="size-5">
                        <path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5s-3 1.34-3 3 1.34 3 3 3Zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5 5 6.34 5 8s1.34 3 3 3Zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5C15 14.17 10.33 13 8 13Zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5Z"/>
                    </svg>
                </Icon>

                <ChildContent>
                    <TechnicianGroupsTab />
                </ChildContent>
            </Tab>
        </Tabs>
    </div>
</div>

@code {
    // ==================== CORE CATALOGS STATE ====================

    private bool _coreCatalogsLoading;
    private string? _coreCatalogsError;

    private List<CatalogListItemDTO> _documentTypes = new();
    private List<CatalogListItemDTO> _fundingTypes = new();
    private List<CatalogListItemDTO> _objectiveTypes = new();
    private List<CatalogListItemDTO> _projectTypesCore = new();
    private List<CatalogListItemDTO> _productTypesCore = new();
    private List<CatalogListItemDTO> _transactionTypes = new();

    private bool _coreCatalogsLoadedOnce;

    // ===== DocumentType modal =====
    private bool _documentTypeModalOpen;
    private bool _isDocumentTypeEditMode;
    private bool _savingDocumentType;
    private string? _documentTypeError;
    private CatalogDetailDTO _documentTypeEditModel = new();

    // ===== FundingType modal =====
    private bool _fundingTypeModalOpen;
    private bool _isFundingTypeEditMode;
    private bool _savingFundingType;
    private string? _fundingTypeError;
    private CatalogDetailDTO _fundingTypeEditModel = new();

    // ===== ObjectiveType modal =====
    private bool _objectiveTypeModalOpen;
    private bool _isObjectiveTypeEditMode;
    private bool _savingObjectiveType;
    private string? _objectiveTypeError;
    private CatalogDetailDTO _objectiveTypeEditModel = new();

    // ===== ProjectType (core) modal =====
    private bool _projectTypeModalOpen;
    private bool _isProjectTypeEditMode;
    private bool _savingProjectType;
    private string? _projectTypeError;
    private CatalogDetailDTO _projectTypeEditModel = new();

    // ===== TransactionType modal =====
    private bool _transactionTypeModalOpen;
    private bool _isTransactionTypeEditMode;
    private bool _savingTransactionType;
    private string? _transactionTypeError;
    private CatalogDetailDTO _transactionTypeEditModel = new();

    private string _activeTab = "products";
    private string _productsSubTab = "catalogs";

    // --------- Estado del Designer ----------

    private bool _designerLoading;
    private string? _designerError;

    private List<CatalogListItemDTO> _designerProductTypes = new();
    private ProductTypeDesignDetailDTO? _designerCurrentDesign;

    private List<ProductAttributeDetailDTO> _designerAvailableAttributes = new();
    private List<ProductAttributeDefinitionUpsertDTO> _designerDefinitionRows = new();

    private bool _productTypeModalOpen;
    private bool _productTypeModalSaving;
    private CatalogDetailDTO _productTypeModalModel = new();

    private bool _designerSaving;
    private string? _designerDesignError;

    // ===== Estado de catálogos de productos =====

    private bool _catalogLoading;
    private string? _catalogError;

    private List<CatalogListItemDTO> _catalogProductTypes = new();
    private List<ProductAttributeListItemDTO> _catalogProductAttributes = new();

    // ===== ProductType modal (para catálogos de producto) =====
    private bool _typeModalOpen;
    private bool _isTypeEditMode;
    private bool _savingType;
    private string? _typeError;
    private CatalogDetailDTO _typeEditModel = new();

    // ===== ProductAttribute modal =====
    private bool _attributeModalOpen;
    private bool _isAttributeEditMode;
    private bool _savingAttribute;
    private string? _attributeError;
    private ProductAttributeDetailDTO _attributeEditModel = new();

    private readonly IEnumerable<ProductAttributeDataType> _dataTypes =
        Enum.GetValues(typeof(ProductAttributeDataType)).Cast<ProductAttributeDataType>();

    // ==================== lifecycle ====================

    protected override async Task OnInitializedAsync()
    {
        await LoadProductCatalogsAsync();
    }

    // ==================== ROOT TABS ====================

    private async Task OnTabChanged(string newKey)
    {
        _activeTab = newKey;

        if (newKey == "products")
        {
            // Opcional: refrescar si quieres
        }
        else if (newKey == "core-catalogs" && !_coreCatalogsLoadedOnce)
        {
            await LoadCoreCatalogsAsync();
        }
        // "research-categories" no necesita nada aquí: el componente hijo se encarga solo
    }

    // ==================== PRODUCT CATALOGS (PRODUCT TYPES + ATTRIBUTES) ====================

    private async Task LoadProductCatalogsAsync()
    {
        _catalogLoading = true;
        _catalogError = null;

        try
        {
            var typesRes = await ProductTypeClient.GetListAsync();
            if (!typesRes.Success || typesRes.Response is null)
            {
                _catalogError = typesRes.Error ?? "Error al cargar los tipos de producto.";
                _catalogProductTypes = new();
            }
            else
            {
                _catalogProductTypes = typesRes.Response;
            }

            var attrsRes = await ProductAttributeClient.GetListAsync(onlyActives: false);
            if (!attrsRes.Success || attrsRes.Response is null)
            {
                if (_catalogError is null)
                    _catalogError = attrsRes.Error ?? "Error al cargar los atributos de producto.";
                else
                    Toast.ShowWarning(attrsRes.Error ?? "Error al cargar los atributos de producto.");

                _catalogProductAttributes = new();
            }
            else
            {
                _catalogProductAttributes = attrsRes.Response;
            }
        }
        catch (Exception ex)
        {
            _catalogError ??= $"Error inesperado al cargar los catálogos de producto: {ex.Message}";
        }
        finally
        {
            _catalogLoading = false;
            StateHasChanged();
        }
    }

    // ===== ProductType handlers (product catalogs) =====

    private void HandleOpenNewProductTypeModal()
    {
        _isTypeEditMode = false;
        _typeError = null;
        _typeEditModel = new CatalogDetailDTO
        {
            Id = 0,
            Name = string.Empty,
            IsActive = true,
            IsLocked = false
        };
        _typeModalOpen = true;
    }

    private async Task HandleOpenEditProductTypeModal(int id)
    {
        _isTypeEditMode = true;
        _typeError = null;

        try
        {
            var res = await ProductTypeClient.GetByIdAsync(id);
            if (!res.Success || res.Response is null)
            {
                Toast.ShowError(res.Error ?? "Error al cargar el tipo de producto.");
                return;
            }

            _typeEditModel = res.Response;
            _typeModalOpen = true;
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Error al cargar el tipo de producto: {ex.Message}");
        }
    }

    private void HandleCancelTypeEdit()
    {
        _typeModalOpen = false;
        _typeError = null;
    }

    private async Task HandleSaveTypeAsync()
    {
        if (_typeEditModel.IsLocked && _typeEditModel.Id != 0)
        {
            _typeError = "Este tipo de producto está bloqueado y no puede ser modificado.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_typeEditModel.Name))
        {
            _typeError = "El nombre es requerido.";
            return;
        }

        try
        {
            _savingType = true;
            _typeError = null;

            if (_typeEditModel.Id == 0)
            {
                var req = new AddCatalogRequestDTO
                {
                    Name = _typeEditModel.Name.Trim()
                };

                var res = await ProductTypeClient.CreateAsync(req);
                if (!res.Success)
                {
                    _typeError = res.Error ?? "Error al crear el tipo de producto.";
                    return;
                }

                Toast.ShowSuccess("Tipo de producto creado exitosamente.");
            }
            else
            {
                var req = new UpdateCatalogRequestDTO
                {
                    Id = _typeEditModel.Id,
                    Name = _typeEditModel.Name.Trim(),
                    IsActive = _typeEditModel.IsActive
                };

                var res = await ProductTypeClient.UpdateAsync(req);
                if (!res.Success)
                {
                    _typeError = res.Error ?? "Error al actualizar el tipo de producto.";
                    return;
                }

                Toast.ShowSuccess("Tipo de producto actualizado exitosamente.");
            }

            _typeModalOpen = false;
            await LoadProductCatalogsAsync();
        }
        catch (Exception ex)
        {
            _typeError = $"Error inesperado al guardar el tipo de producto: {ex.Message}";
        }
        finally
        {
            _savingType = false;
            StateHasChanged();
        }
    }

    // ===== ProductAttribute handlers =====

    private void HandleOpenNewAttributeModal()
    {
        _isAttributeEditMode = false;
        _attributeError = null;
        _attributeEditModel = new ProductAttributeDetailDTO
        {
            Id = 0,
            Name = string.Empty,
            IsActive = true,
            IsLocked = false,
            DataType = ProductAttributeDataType.Text,
            Unit = null
        };
        _attributeModalOpen = true;
    }

    private async Task HandleOpenEditAttributeModal(int id)
    {
        _isAttributeEditMode = true;
        _attributeError = null;

        try
        {
            var res = await ProductAttributeClient.GetByIdAsync(id);
            if (!res.Success || res.Response is null)
            {
                Toast.ShowError(res.Error ?? "Error al cargar el atributo de producto.");
                return;
            }

            _attributeEditModel = res.Response;
            _attributeModalOpen = true;
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Error al cargar el atributo de producto: {ex.Message}");
        }
    }

    private void HandleCancelAttributeEdit()
    {
        _attributeModalOpen = false;
        _attributeError = null;
    }

    private async Task HandleSaveAttributeAsync()
    {
        if (_attributeEditModel.IsLocked && _attributeEditModel.Id != 0)
        {
            _attributeError = "Este atributo está bloqueado y no puede ser modificado.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_attributeEditModel.Name))
        {
            _attributeError = "El nombre es requerido.";
            return;
        }

        try
        {
            _savingAttribute = true;
            _attributeError = null;

            if (_attributeEditModel.Id == 0)
            {
                var req = new AddProductAttributeRequestDTO
                {
                    Name = _attributeEditModel.Name.Trim(),
                    IsActive = _attributeEditModel.IsActive,
                    DataType = _attributeEditModel.DataType,
                    Unit = _attributeEditModel.Unit
                };

                var res = await ProductAttributeClient.CreateAsync(req);
                if (!res.Success)
                {
                    _attributeError = res.Error ?? "Error al crear el atributo.";
                    return;
                }

                Toast.ShowSuccess("Atributo creado exitosamente.");
            }
            else
            {
                var req = new UpdateProductAttributeRequestDTO
                {
                    Id = _attributeEditModel.Id,
                    Name = _attributeEditModel.Name.Trim(),
                    IsActive = _attributeEditModel.IsActive,
                    DataType = _attributeEditModel.DataType,
                    Unit = _attributeEditModel.Unit
                };

                var res = await ProductAttributeClient.UpdateAsync(_attributeEditModel.Id, req);
                if (!res.Success)
                {
                    _attributeError = res.Error ?? "Error al actualizar el atributo.";
                    return;
                }

                Toast.ShowSuccess("Atributo actualizado exitosamente.");
            }

            _attributeModalOpen = false;
            await LoadProductCatalogsAsync();
        }
        catch (Exception ex)
        {
            _attributeError = $"Error inesperado al guardar el atributo: {ex.Message}";
        }
        finally
        {
            _savingAttribute = false;
            StateHasChanged();
        }
    }

    private async Task HandleDeleteProductTypeAsync(int id)
    {
        var type = _catalogProductTypes.FirstOrDefault(t => t.Id == id);
        if (type?.IsLocked == true)
        {
            Toast.ShowWarning("Este tipo de producto está bloqueado y no puede ser eliminado.");
            return;
        }

        try
        {
            var res = await ProductTypeClient.DeleteAsync(id);
            if (!res.Success)
            {
                Toast.ShowError(res.Error ?? "Error al eliminar el tipo de producto.");
                return;
            }

            Toast.ShowSuccess("Tipo de producto eliminado exitosamente.");
            await LoadProductCatalogsAsync();
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Error inesperado al eliminar el tipo de producto: {ex.Message}");
        }
    }

    private async Task HandleDeleteAttributeAsync(int id)
    {
        var attr = _catalogProductAttributes.FirstOrDefault(a => a.Id == id);
        if (attr?.IsLocked == true)
        {
            Toast.ShowWarning("Este atributo está bloqueado y no puede ser eliminado.");
            return;
        }

        try
        {
            var res = await ProductAttributeClient.DeleteAsync(id);
            if (!res.Success)
            {
                Toast.ShowError(res.Error ?? "Error al eliminar el atributo.");
                return;
            }

            Toast.ShowSuccess("Atributo eliminado exitosamente.");
            await LoadProductCatalogsAsync();
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Error inesperado al eliminar el atributo: {ex.Message}");
        }
    }

    // ==================== CORE CATALOGS LOAD ====================

    private async Task LoadCoreCatalogsAsync()
    {
        _coreCatalogsLoading = true;
        _coreCatalogsError = null;

        try
        {
            // Document types
            var docRes = await DocumentTypeClient.GetListAsync(onlyActives: false);
            _documentTypes = docRes.Success && docRes.Response is not null
                ? docRes.Response
                : new List<CatalogListItemDTO>();

            if (!docRes.Success && docRes.Error is not null)
                _coreCatalogsError ??= docRes.Error;

            // Funding types
            var fundRes = await FundingTypeClient.GetListAsync(onlyActives: false);
            _fundingTypes = fundRes.Success && fundRes.Response is not null
                ? fundRes.Response
                : new List<CatalogListItemDTO>();

            if (!fundRes.Success && fundRes.Error is not null)
                _coreCatalogsError ??= fundRes.Error;

            // Objective types
            var objRes = await ObjectiveTypeClient.GetListAsync(onlyActives: false);
            _objectiveTypes = objRes.Success && objRes.Response is not null
                ? objRes.Response
                : new List<CatalogListItemDTO>();

            if (!objRes.Success && objRes.Error is not null)
                _coreCatalogsError ??= objRes.Error;

            // Project types (core)
            var projRes = await ProjectTypeClient.GetListAsync(onlyActives: false);
            _projectTypesCore = projRes.Success && projRes.Response is not null
                ? projRes.Response
                : new List<CatalogListItemDTO>();

            if (!projRes.Success && projRes.Error is not null)
                _coreCatalogsError ??= projRes.Error;

            // Product types (core)
            var prodRes = await ProductTypeClient.GetListAsync();
            _productTypesCore = prodRes.Success && prodRes.Response is not null
                ? prodRes.Response
                : new List<CatalogListItemDTO>();

            if (!prodRes.Success && prodRes.Error is not null)
                _coreCatalogsError ??= prodRes.Error;

            // Transaction types
            var trxRes = await TransactionTypeClient.GetListAsync(onlyActives: false);
            _transactionTypes = trxRes.Success && trxRes.Response is not null
