    private void HandleDesignerAddDefinition()
    {
        _designerDesignError = null;

        if (_designerAvailableAttributes.Count == 0)
        {
            _designerDesignError = "No hay atributos disponibles. Cree atributos primero en la pestaña de catálogos.";
            return;
        }

        var nextOrder = (_designerDefinitionRows.Count == 0)
            ? 1
            : _designerDefinitionRows.Max(d => d.DisplayOrder) + 1;

        var defaultAttrId = _designerAvailableAttributes.First().Id;

        _designerDefinitionRows.Add(new ProductAttributeDefinitionUpsertDTO
        {
            Id = 0,
            ProductAttributeId = defaultAttrId,
            IsRequired = false,
            DisplayOrder = nextOrder
        });
    }

    private void HandleDesignerRemoveDefinition(ProductAttributeDefinitionUpsertDTO row)
    {
        _designerDefinitionRows.Remove(row);
    }

    private async Task HandleDesignerSaveDesignAsync()
    {
        _designerDesignError = null;

        if (_designerCurrentDesign is null)
        {
            _designerDesignError = "No hay diseño de tipo de producto cargado.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_designerCurrentDesign.ProductType.Name))
        {
            _designerDesignError = "El nombre del tipo de producto es requerido.";
            return;
        }

        if (_designerCurrentDesign.ProductType.IsLocked)
        {
            _designerDesignError = "Este tipo de producto está bloqueado y no puede ser modificado.";
            return;
        }

        if (_designerDefinitionRows.Count == 0)
        {
            _designerDesignError = "Se requiere al menos una definición de atributo.";
            return;
        }

        if (_designerDefinitionRows.Any(d => d.ProductAttributeId <= 0))
        {
            _designerDesignError = "Todas las definiciones deben tener un atributo válido.";
            return;
        }

        try
        {
            _designerSaving = true;

            var typeUpsert = new ProductTypeUpsertDTO
            {
                Id = _designerCurrentDesign.ProductType.Id,
                Name = _designerCurrentDesign.ProductType.Name.Trim(),
                IsActive = _designerCurrentDesign.ProductType.IsActive
            };

            var definitionsUpsert = _designerDefinitionRows
                .OrderBy(d => d.DisplayOrder)
                .ToList();

            var request = new SaveProductTypeDesignRequestDTO
            {
                ProductType = typeUpsert,
                Attributes = new List<ProductAttributeUpsertDTO>(),
                Definitions = definitionsUpsert
            };

            var res = await ProductTypeDesignClient.SaveAsync(request);
            if (!res.Success || res.Response is null)
            {
                _designerDesignError = res.Error ?? "Error al guardar el diseño del tipo de producto.";
                return;
            }

            _designerCurrentDesign = res.Response;

            _designerAvailableAttributes = _designerCurrentDesign.Attributes.ToList();
            _designerDefinitionRows = _designerCurrentDesign.Definitions
                .OrderBy(d => d.DisplayOrder)
                .Select(d => new ProductAttributeDefinitionUpsertDTO
                {
                    Id = d.Id,
                    ProductAttributeId = d.ProductAttributeId,
                    IsRequired = d.IsRequired,
                    DisplayOrder = d.DisplayOrder
                })
                .ToList();

            await LoadDesignerProductTypesAsync();

            Toast.ShowSuccess("Diseño del tipo de producto guardado exitosamente.");
        }
        catch (Exception ex)
        {
            _designerDesignError = $"Error inesperado al guardar el diseño del tipo de producto: {ex.Message}";
        }
        finally
        {
            _designerSaving = false;
            StateHasChanged();
        }
    }
}