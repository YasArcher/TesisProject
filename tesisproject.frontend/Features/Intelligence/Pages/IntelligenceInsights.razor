    private DecisionFocusItem SelectedDecisionFocus =>
        DecisionFocusItems.FirstOrDefault(x => x.Key == _selectedDecisionFocus)
        ?? DecisionFocusItems[0];

    private string DataQualityChipClass => DataQuality.Status switch
    {
        "Ready" => "app-inline-chip app-inline-chip--success",
        "Limited" => "app-inline-chip app-inline-chip--gold",
        _ => "app-inline-chip app-inline-chip--danger"
    };

    private IReadOnlyList<IntelligenceForecastPointDto> ForecastPoints =>
        (_intelligence?.ProductionForecast.History.TakeLast(6) ?? [])
        .Concat(_intelligence?.ProductionForecast.Forecast ?? [])
        .ToList();

    private string ForecastTotalLabel
    {
        get
        {
            var forecast = _intelligence?.ProductionForecast.Forecast;
            if (forecast is null || forecast.Count == 0)
            {
                return "Sin predicción";
            }

            return $"{forecast.Sum(x => x.Value):N1} artículos";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardAsync();
    }

    private async Task LoadDashboardAsync()
    {
        _isLoading = true;
        _error = null;

        try
        {
            _intelligence = await IntelligenceClient.GetDashboardAsync(new InstitutionalReportingFilterDto());
            _trainingHistory = await IntelligenceClient.GetTrainingHistoryAsync(8);
        }
        catch (Exception ex)
        {
            _intelligence = null;
            _error = $"No se pudo cargar la inteligencia institucional: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task RunTrainingAsync()
    {
        _isTraining = true;
        _error = null;

        try
        {
            _trainingRun = await IntelligenceClient.RunTrainingAsync(new InstitutionalReportingFilterDto());
            _intelligence = await IntelligenceClient.GetDashboardAsync(new InstitutionalReportingFilterDto());
            _trainingHistory = await IntelligenceClient.GetTrainingHistoryAsync(8);
            _selectedHistoryRun = _trainingRun is null
                ? null
                : _trainingHistory.FirstOrDefault(x => x.RunId == _trainingRun.RunId);
        }
        catch (Exception ex)
        {
            _error = $"No se pudo ejecutar el entrenamiento IA: {ex.Message}";
        }
        finally
        {
            _isTraining = false;
        }
    }

    private string MonthlyBarStyle(int articles)
        => $"--month-fill:{Math.Clamp(articles * 100 / MaxMonthlyArticles, 4, 100)}%";

    private static string GetMapeClass(decimal mape)
        => mape >= 100 ? "ai-mape-warning" : "";

    private static string GetInsightPriorityClass(string priority)
        => priority switch
        {
            "Alta" => "ai-insight-priority ai-insight-priority--high",
            "Baja" => "ai-insight-priority ai-insight-priority--low",
            _ => "ai-insight-priority"
        };

    private static string InsightBarStyle(decimal share)
        => $"--insight-share:{Math.Clamp((double)share, 4, 100).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}%";

    private string BuildFocusResult(string insightKey, string fallback)
    {
        var insight = DecisionInsights.FirstOrDefault(x => x.Key == insightKey);
        return insight is null
            ? fallback
            : $"{insight.Label}: {insight.Signal} {insight.Recommendation}";
    }

    private static bool ContainsDecisionText(string? value, string term)
        => !string.IsNullOrWhiteSpace(value)
            && value.Contains(term, StringComparison.OrdinalIgnoreCase);

    private static string FacultyMonthStyle(IntelligenceFacultyForecastDto faculty, int articles)
    {
        var max = Math.Max(1, faculty.RecentMonths.Select(x => x.Articles).DefaultIfEmpty(0).Max());
        var height = Math.Clamp(articles * 100 / max, 12, 100);
        return $"--faculty-month-height:{height}%";
    }

    private static string SegmentMonthStyle(IntelligenceSegmentForecastDto segment, int articles)
    {
        var max = Math.Max(1, segment.RecentMonths.Select(x => x.Articles).DefaultIfEmpty(0).Max());
        var height = Math.Clamp(articles * 100 / max, 12, 100);
        return $"--faculty-month-height:{height}%";
    }

    private void SelectTrainingRun(IntelligenceTrainingRunDto run)
    {
        _selectedHistoryRun = run;
    }

    private void ClearSelectedTrainingRun()
    {
        _selectedHistoryRun = null;
    }

    private bool IsSelectedRun(IntelligenceTrainingRunDto run)
        => _selectedHistoryRun?.RunId == run.RunId;

    private void SetActiveView(string view)
    {
        _activeView = view;
    }

    private string GetViewTabClass(string view)
        => _activeView == view ? "ai-view-tab ai-view-tab--active" : "ai-view-tab";

    private void SelectDecisionFocus(string key)
    {
        _selectedDecisionFocus = key;
    }

    private string GetFocusPillClass(string key)
        => key == _selectedDecisionFocus ? "ai-focus-pill ai-focus-pill--active" : "ai-focus-pill";

    private string HealthLabel
    {
        get
        {
            if (_isLoading)
            {
                return "Sincronizando IA";
            }

            return _intelligence is null
                ? "IA no disponible"
                : $"{_intelligence.TrainingStatus} · {_intelligence.DataWindowLabel}";
        }
    }

    private string LastAiGeneratedLabel
        => _intelligence is null
            ? "Sin lectura generada"
            : $"Lectura IA {_intelligence.GeneratedAt:dd/MM/yyyy HH:mm}";

    private string HealthClass
        => _intelligence is not null
            ? "ai-status ai-status--ok"
            : _isLoading
                ? "ai-status ai-status--loading"
                : "ai-status ai-status--warning";

    private sealed record DecisionFocusItem(
        string Key,
        string Title,
        string Description,
        string Status,
        string Icon,
        string Result);
