            "url" => $"{label} debe contener una URL válida.",
            "noFutureDate" => $"{label} no puede ser una fecha futura.",
            "minNumber" => $"{label} debe ser mayor o igual a {NormalizeUiValue(value) ?? "N"}.",
            "maxNumber" => $"{label} debe ser menor o igual a {NormalizeUiValue(value) ?? "N"}.",
            "regex" => $"{label} debe cumplir el patrón definido.",
            _ => $"{label} será validado con la regla seleccionada."
        };
    }

    private static string GetValidationPreset(string? validationRule)
        => DynamicFieldValidationEngine.Parse(validationRule).Rules.FirstOrDefault()?.Type ?? string.Empty;

    private static string? GetValidationRuleValue(string? validationRule)
        => DynamicFieldValidationEngine.Parse(validationRule).Rules.FirstOrDefault()?.Value;

    private static string? GetValidationRuleMessage(string? validationRule)
        => DynamicFieldValidationEngine.Parse(validationRule).Rules.FirstOrDefault()?.Message;

    private static string? BuildValidationRule(string? preset, string? value, string? message)
    {
        if (string.IsNullOrWhiteSpace(preset))
        {
            return null;
        }

        return DynamicFieldValidationEngine.Serialize(new DynamicFieldValidationRuleSet
        {
            Rules =
            [
                new DynamicFieldValidationRule
                {
                    Type = preset.Trim(),
                    Value = ValidationPresetNeedsValue(preset) ? NormalizeUiValue(value) : null,
                    Message = NormalizeUiValue(message)
                }
            ]
        });
    }

    private void OnNewFieldValidationPresetChanged(ChangeEventArgs args)
    {
        NewFieldValidationPreset = args.Value?.ToString() ?? string.Empty;
        if (!ValidationPresetNeedsValue(NewFieldValidationPreset))
        {
            NewFieldValidationValue = null;
        }

        NewField.ValidationRule = BuildValidationRule(NewFieldValidationPreset, NewFieldValidationValue, NewFieldValidationMessage);
    }

    private void OnNewFieldValidationValueChanged(ChangeEventArgs args)
    {
        NewFieldValidationValue = args.Value?.ToString();
        NewField.ValidationRule = BuildValidationRule(NewFieldValidationPreset, NewFieldValidationValue, NewFieldValidationMessage);
    }

    private void OnNewFieldValidationMessageChanged(ChangeEventArgs args)
    {
        NewFieldValidationMessage = args.Value?.ToString();
        NewField.ValidationRule = BuildValidationRule(NewFieldValidationPreset, NewFieldValidationValue, NewFieldValidationMessage);
    }

    private static void SetFieldValidationPreset(FieldCatalogItemDto field, string? preset)
    {
        var currentValue = GetValidationRuleValue(field.ValidationRule);
        var currentMessage = GetValidationRuleMessage(field.ValidationRule);
        field.ValidationRule = BuildValidationRule(preset, ValidationPresetNeedsValue(preset) ? currentValue : null, currentMessage);
    }

    private static void SetFieldValidationValue(FieldCatalogItemDto field, string? value)
    {
        var preset = GetValidationPreset(field.ValidationRule);
        var currentMessage = GetValidationRuleMessage(field.ValidationRule);
        field.ValidationRule = BuildValidationRule(preset, value, currentMessage);
    }

    private static void SetFieldValidationMessage(FieldCatalogItemDto field, string? message)
    {
        var preset = GetValidationPreset(field.ValidationRule);
        var currentValue = GetValidationRuleValue(field.ValidationRule);
        field.ValidationRule = BuildValidationRule(preset, currentValue, message);
    }

    private static string? NormalizeUiValue(string? value)
        => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

