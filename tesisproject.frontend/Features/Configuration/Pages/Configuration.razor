    {
        public string ActiveTab { get; set; } = "forms";
        public string? FormSearchTerm { get; set; }
        public string? FieldSearchTerm { get; set; }
        public string? CatalogSearchTerm { get; set; }
        public string? OptionSearchTerm { get; set; }
        public string? SelectedCatalogKey { get; set; }
        public int? SelectedFormId { get; set; }
        public int? SelectedDynamicFieldId { get; set; }
    }
