@page "/configuration"
@attribute [Authorize(Roles = "Admin,Analyst,ConfigurationManager,CatalogManager")]
@using Blazored.LocalStorage
@using tesisproject.frontend.Features.Configuration.Components
@using tesisproject.frontend.SharedUI
@using tesisproject.shared.DTOs.Configuration
@using tesisproject.shared.Validation

@inject IFormConfigurationClient FormConfigurationClient
@inject ILocalStorageService LocalStorage

<PageTitle>Configuración dinámica</PageTitle>

<div class="app-page-shell app-shell-warm configuration-page">
    <div class="app-module-hero configuration-hero mb-5 rounded-[1.8rem] p-5 text-white shadow-lg">
        <div class="flex flex-col gap-5 xl:flex-row xl:items-center xl:justify-between">
            <div class="flex items-start gap-4">
                <div class="configuration-hero__icon">
                    <i class="bi bi-sliders2-vertical"></i>
                </div>
                <div>
                    <div class="text-xs font-semibold uppercase tracking-[0.24em] text-white/70">Administración dinámica</div>
                    <h1 class="mt-1 text-2xl font-black md:text-3xl">Formularios y metadatos</h1>
                    <p class="mt-2 max-w-3xl text-sm leading-6 text-white/78">@GetActiveTabHelperText()</p>
                </div>
            </div>
            <div class="configuration-hero__badges">
                <span><i class="bi bi-ui-checks-grid"></i> Formularios</span>
                <span><i class="bi bi-input-cursor-text"></i> Campos</span>
                <span><i class="bi bi-tags"></i> Catálogos</span>
                <span><i class="bi bi-list-check"></i> Opciones</span>
            </div>
        </div>
    </div>

    <AppStatusModal Visible="@HasStatusMessage"
                    Variant="@CurrentStatusVariant"
                    Eyebrow="Configuración"
                    Title="@CurrentStatusTitle"
                    Message="@CurrentStatusMessage"
                    OnClose="CloseStatusModal" />
    <AppConfirmPanel
                     Visible="@HasPendingConfirmation"
                     Title="@PendingConfirmationTitle"
                     Message="@PendingConfirmationMessage"
                     OnCancel="CancelPendingConfirmation"
                     OnConfirm="ConfirmPendingActionAsync" />

    @if (IsLoading)
    {
        <div class="rounded-3xl border bg-white p-6 text-center text-slate-600 shadow-sm">Cargando configuración...</div>
    }
    else
    {
        <ConfigurationOverviewPanel FormsCount="@Forms.Count"
                                    ActiveFormsCount="@Forms.Count(x => x.IsActive)"
                                    FieldsCount="@AvailableFields.Count"
                                    DynamicFieldsCount="@AvailableFields.Count(x => x.IsDynamic)"
                                    SelectedFormFieldsCount="@SelectedFormFields.Count"
                                    SelectedCatalogLabel="@GetCatalogLabel(SelectedCatalogKey)"
                                    CatalogItemsCount="@CatalogItems.Count"
                                    ActiveTab="@ActiveTab"
                                    OnTabChange="SetActiveTabAsync" />

        @if (ActiveTab == "forms")
        {
            <div class="grid grid-cols-1 gap-6 xl:grid-cols-[0.8fr_1.5fr]">
                <ConfigurationFormsSidebar FormSearchTerm="@FormSearchTerm"
                                           FormSearchTermChanged="UpdateFormSearchTermAsync"
                                           NewForm="NewForm"
                                           OnCreateForm="CreateFormAsync"
                                           FilteredForms="@GetFilteredForms().ToList()"
                                           SelectedFormId="@SelectedFormId"
                                           OnSelectForm="HandleFormSelectionAsync" />

                <div class="space-y-6">
                    <section class="rounded-3xl border bg-gradient-to-br from-[#f8fbfc] to-[#fffaf3] shadow-sm">
                        <header class="border-b bg-gradient-to-r from-[#edf5f6] to-[#fff7ec] px-4 py-3">
                            <h2 class="text-base font-bold text-[#12343b]">Formulario seleccionado</h2>
                        </header>
                        <div class="space-y-3 px-4 py-4 text-sm">
                            @if (SelectedForm is null)
                            {
                                <div class="text-slate-500">Sin formulario seleccionado.</div>
                            }
                            else
                            {
                                <div class="grid grid-cols-1 gap-3 md:grid-cols-2">
                                    <input class="rounded-xl border px-3 py-2" @bind="SelectedForm.FormName" />
                                    <label class="inline-flex items-center gap-2 rounded-xl border px-3 py-2"><input type="checkbox" @bind="SelectedForm.IsActive" /> Activo</label>
                                </div>
                                <div class="rounded-xl border border-[#d8e5e8] bg-white/80 px-3 py-2 text-xs text-slate-600">
                                    Identificador visible: <span class="font-semibold text-[#12343b]">@GetUserFacingFormIdentifier(SelectedForm.FormKey)</span>
                                    · Tipo: <span class="font-semibold text-[#12343b]">@GetUserFacingEntityName(SelectedForm.EntityName)</span>
                                </div>
                                <textarea class="w-full rounded-xl border px-3 py-2" rows="3" @bind="SelectedForm.Description"></textarea>
                                <div class="app-mobile-stack">
                                    <button class="rounded-xl bg-[#12343b] px-4 py-2 text-sm font-semibold text-white" @onclick="UpdateSelectedFormAsync">Guardar formulario</button>
                                    <button class="rounded-xl bg-rose-600 px-4 py-2 text-sm font-semibold text-white" @onclick="RequestDeleteSelectedForm">Eliminar formulario</button>
                                </div>
                            }
                        </div>
                    </section>

                    <section class="rounded-3xl border bg-white shadow-sm">
                        <header class="border-b bg-[#f5f7f8] px-5 py-4">
                            <h2 class="text-base font-bold text-[#12343b]">Asignaciones del formulario</h2>
                        </header>
                        <div class="space-y-4 px-5 py-5">
                            @if (SelectedForm is null)
                            {
                                <div class="text-sm text-slate-500">Sin formulario seleccionado.</div>
                            }
                            else
                            {
                                <details class="rounded-2xl border p-4" open>
                                    <summary class="cursor-pointer font-semibold text-slate-900">Agregar campo al formulario</summary>
                                    <div class="mt-4 space-y-3 text-sm">
                                        <div class="grid grid-cols-1 gap-3 lg:grid-cols-[1fr_auto]">
                                            <input class="rounded-xl border border-slate-300 bg-slate-50 px-3 py-2 text-sm"
                                                   placeholder="Buscar campo para asignar"
                                                   @bind="FormAssignmentFieldSearchTerm"
                                                   @bind:event="oninput" />
                                            <label class="flex items-center gap-2 rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-xs font-semibold text-slate-600">
                                                Campos visibles
                                                <input type="range" min="6" max="16" step="1" @bind="FormAssignmentFieldPickerSize" />
                                                <span class="rounded-full bg-white px-2 py-1 text-[11px] text-slate-700">@FormAssignmentFieldPickerSize</span>
                                            </label>
                                        </div>
                                        <div class="grid grid-cols-1 gap-3 md:grid-cols-2">
                                            <div class="space-y-2 md:col-span-2">
                                                <div class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Campos disponibles</div>
                                                <select class="min-h-[12rem] w-full rounded-xl border px-3 py-2" size="@FormAssignmentFieldPickerSize" @bind="AddFieldRequest.FieldId">
                                                    <option value="0">Selecciona un campo</option>
                                                    @foreach (var field in GetFilteredAvailableFieldsForAssignment())
                                                    {
                                                        <option value="@field.FieldId">@field.FieldLabel</option>
                                                    }
                                                </select>
                                                <div class="text-xs text-slate-500">@GetFilteredAvailableFieldsForAssignment().Count() campo(s) visibles para asignar.</div>
                                            </div>
                                            <input class="rounded-xl border px-3 py-2" placeholder="Grupo" @bind="AddFieldRequest.GroupName" />
                                            <input class="rounded-xl border px-3 py-2" type="number" placeholder="Orden" @bind="AddFieldRequest.DisplayOrder" />
                                            <input class="rounded-xl border px-3 py-2" type="number" placeholder="ColumnSpan" @bind="AddFieldRequest.ColumnSpan" />
                                        </div>
                                        <div class="flex flex-wrap gap-4 text-sm">
                                            <label class="inline-flex items-center gap-2"><input type="checkbox" @bind="AddFieldRequest.IsVisible" /> Visible</label>
                                            <label class="inline-flex items-center gap-2"><input type="checkbox" @bind="AddFieldRequest.IsRequired" /> Requerido</label>
                                            <label class="inline-flex items-center gap-2"><input type="checkbox" @bind="AddFieldRequest.IsEditable" /> Editable</label>
                                        </div>
                                        <button class="rounded-xl bg-[#2f4858] px-4 py-2 text-sm font-semibold text-white" @onclick="AddFieldToSelectedFormAsync">Agregar al formulario</button>
                                    </div>
                                </details>

                                @if (SelectedFormFields.Count == 0)
                                {
                                    <div class="rounded-2xl border border-dashed p-5 text-sm text-slate-500">Este formulario todavía no tiene campos asignados.</div>
                                }
                                else
                                {
                                    <div class="max-h-[34rem] overflow-y-auto pr-1">
                                    <div class="grid grid-cols-1 gap-3 xl:grid-cols-2">
                                    @foreach (var field in SelectedFormFields)
                                    {
                                        <details class="rounded-2xl border p-4">
                                            <summary class="cursor-pointer">
                                                <div class="inline-flex items-center gap-3">
                                                    <span class="font-semibold text-slate-900">@field.FieldLabel</span>
                                                    <span class="text-xs text-slate-500">@GetUserFacingDataType(field.DataType)</span>
                                                </div>
                                            </summary>
                                            <div class="mt-4 text-sm">
                                                <div class="grid grid-cols-1 gap-3 md:grid-cols-3">
                                                    <input class="rounded-xl border px-3 py-2" value="@field.GroupName" placeholder="Grupo" @onchange="e => field.GroupName = e.Value?.ToString()" />
                                                    <input class="rounded-xl border px-3 py-2" type="number" value="@field.DisplayOrder" @onchange="e => field.DisplayOrder = int.TryParse(e.Value?.ToString(), out var parsed) ? parsed : field.DisplayOrder" />
                                                    <input class="rounded-xl border px-3 py-2" type="number" value="@field.ColumnSpan" placeholder="ColumnSpan" @onchange="e => field.ColumnSpan = int.TryParse(e.Value?.ToString(), out var parsed) ? parsed : null" />
                                                </div>
                                                <div class="mt-3 flex flex-wrap gap-4">
                                                    <label class="inline-flex items-center gap-2"><input type="checkbox" checked="@field.IsVisible" @onchange="e => field.IsVisible = e.Value is bool b && b" /> Visible</label>
                                                    <label class="inline-flex items-center gap-2"><input type="checkbox" checked="@field.IsRequired" @onchange="e => field.IsRequired = e.Value is bool b && b" /> Requerido</label>
                                                    <label class="inline-flex items-center gap-2"><input type="checkbox" checked="@field.IsEditable" @onchange="e => field.IsEditable = e.Value is bool b && b" /> Editable</label>
                                                </div>
                                                <div class="app-mobile-stack mt-4">
                                                    <button class="rounded-xl bg-[#586f7c] px-4 py-2 text-sm font-semibold text-white" @onclick="() => UpdateFormFieldAsync(field)">Guardar asignación</button>
                                                    <button class="rounded-xl bg-rose-600 px-4 py-2 text-sm font-semibold text-white" @onclick="() => RequestDeleteFormField(field)">Quitar del formulario</button>
                                                </div>
                                            </div>
                                        </details>
                                    }
                                    </div>
                                    </div>
                                }
                            }
                        </div>
                    </section>
                </div>
            </div>
        }

        @if (ActiveTab == "fields")
        {
            <div class="grid grid-cols-1 gap-6 xl:grid-cols-[0.82fr_1.18fr]">
                <section class="rounded-3xl border bg-gradient-to-br from-[#f8fbfc] to-[#fffaf3] shadow-sm">
                    <header class="border-b bg-gradient-to-r from-[#edf5f6] to-[#fff7ec] px-5 py-4">
                        <h2 class="text-base font-bold text-[#12343b]">Nuevo campo dinámico</h2>
                    </header>
                    <div class="space-y-4 px-5 py-5 text-sm">
                        <div class="grid grid-cols-1 gap-3">
                            <label class="space-y-1">
                                <span class="text-xs font-semibold uppercase tracking-[0.16em] text-slate-500">Sección del sistema</span>
                                <select class="w-full rounded-xl border px-3 py-2" @bind="NewField.EntityName">
                                    <option value="Article">Artículo</option>
                                    <option value="ArticleParticipant">Participante del artículo</option>
                                </select>
                            </label>
                            <label class="space-y-1">
                                <span class="text-xs font-semibold uppercase tracking-[0.16em] text-slate-500">Identificador interno</span>
                                <input class="w-full rounded-xl border px-3 py-2" placeholder="Clave técnica del campo" @bind="NewField.FieldKey" />
                            </label>
                            <label class="space-y-1">
                                <span class="text-xs font-semibold uppercase tracking-[0.16em] text-slate-500">Nombre visible</span>
                                <input class="w-full rounded-xl border px-3 py-2" placeholder="Nombre que verá el usuario" @bind="NewField.FieldLabel" />
                            </label>
                            <label class="space-y-1">
                                <span class="text-xs font-semibold uppercase tracking-[0.16em] text-slate-500">Tipo de dato</span>
                                <select class="w-full rounded-xl border px-3 py-2" @bind="NewField.DataType">
                                    <option value="string">Texto</option>
                                    <option value="int">Número entero</option>
                                    <option value="decimal">Número decimal</option>
                                    <option value="datetime">Fecha y hora</option>
                                    <option value="bool">Sí / No</option>
                                </select>
                            </label>
                            <label class="space-y-1">
                                <span class="text-xs font-semibold uppercase tracking-[0.16em] text-slate-500">Texto guía en el campo</span>
                                <input class="w-full rounded-xl border px-3 py-2" placeholder="Texto de apoyo dentro del campo" @bind="NewField.Placeholder" />
                            </label>
                            <label class="space-y-1">
                                <span class="text-xs font-semibold uppercase tracking-[0.16em] text-slate-500">Ayuda para el usuario</span>
                                <textarea class="w-full rounded-xl border px-3 py-2" rows="2" placeholder="Mensaje o instrucción para completar el campo" @bind="NewField.HelpText"></textarea>
                            </label>
                            <div class="configuration-validation-panel">
                                <div class="configuration-validation-panel__head">
                                    <div>
                                        <div class="configuration-validation-panel__eyebrow">Validación del registro</div>
                                        <strong>Control de datos del campo</strong>
                                    </div>
                                    <span>@GetValidationPresetShortLabel(NewFieldValidationPreset)</span>
                                </div>
                                <p>@GetValidationHelperText(NewFieldValidationPreset)</p>
                                <div class="configuration-validation-panel__grid">
                                    <label>
                                        <span>Regla</span>
                                        <select class="rounded-xl border px-3 py-2" value="@NewFieldValidationPreset" @onchange="OnNewFieldValidationPresetChanged">
                                        @foreach (var option in ValidationPresetOptions)
                                        {
                                            <option value="@option.Key">@option.Label</option>
                                        }
                                        </select>
                                    </label>
                                    <label>
                                        <span>Valor de referencia</span>
                                        <input class="rounded-xl border px-3 py-2" placeholder="@GetValidationValuePlaceholder(NewFieldValidationPreset)" value="@NewFieldValidationValue" @onchange="OnNewFieldValidationValueChanged" disabled="@(!ValidationPresetNeedsValue(NewFieldValidationPreset))" />
                                    </label>
                                    <label>
                                        <span>Mensaje al usuario</span>
                                        <input class="rounded-xl border px-3 py-2" placeholder="Mensaje de error" value="@NewFieldValidationMessage" @onchange="OnNewFieldValidationMessageChanged" disabled="@(string.IsNullOrWhiteSpace(NewFieldValidationPreset))" />
                                    </label>
                                </div>
                                <div class="configuration-validation-panel__preview">
                                    <i class="bi bi-info-circle"></i>
                                    <span>@GetValidationPreview(NewField.FieldLabel, NewFieldValidationPreset, NewFieldValidationValue, NewFieldValidationMessage)</span>
                                </div>
                            </div>
                            <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
                                <label class="inline-flex items-center gap-2 rounded-xl border px-3 py-2"><input type="checkbox" @bind="NewField.IsRequired" /> Requerido</label>
                                <label class="inline-flex items-center gap-2 rounded-xl border px-3 py-2"><input type="checkbox" @bind="NewField.IsActive" /> Activo</label>
                            </div>
                        </div>
                        <button class="rounded-xl bg-[#2f4858] px-4 py-2 text-sm font-semibold text-white" @onclick="CreateDynamicFieldAsync">Crear campo</button>
                    </div>
                </section>

                <section class="rounded-3xl border bg-white shadow-sm">
                    <header class="border-b bg-[#f5f7f8] px-5 py-4">
                        <h2 class="text-base font-bold text-[#12343b]">Campos del sistema</h2>
                    </header>
                    <div class="space-y-4 px-5 py-5">
                        <input class="w-full rounded-xl border border-slate-300 bg-slate-50 px-3 py-2 text-sm" placeholder="Buscar campo por nombre visible, clave o tipo" @bind="FieldSearchTerm" @bind:event="oninput" @bind:after="PersistUiStateAsync" />

                        @if (!GetFilteredFields().Any())
                        {
                            <AppEmptyState Title="Sin campos visibles" Message="No hay campos que coincidan con la búsqueda actual." />
                        }
                        else
                        {
                            <div class="space-y-4">
                                <div class="rounded-2xl border border-[#d9e5e8] bg-[#f8fbfc] p-4">
                                    <div class="mb-3 flex items-center justify-between gap-3">
                                        <div>
                                            <div class="font-bold text-[#12343b]">Campos dinámicos</div>
                                            <div class="text-xs text-slate-500">Campos creados para extender el modelo sin tocar la base estructural.</div>
                                        </div>
                                        <span class="rounded-full bg-white px-3 py-1 text-xs font-semibold text-[#12343b]">@GetFilteredDynamicFields().Count() visibles</span>
                                    </div>
                                    @if (!GetFilteredDynamicFields().Any())
                                    {
                                        <AppEmptyState Title="Sin campos dinámicos" Message="No hay campos dinámicos con el filtro actual." />
                                    }
                                    else
                                    {
                                        <div class="max-h-[22rem] overflow-y-auto pr-1">
                                            <div class="grid grid-cols-1 gap-3 xl:grid-cols-2">
                                                @foreach (var field in GetFilteredDynamicFields())
                                                {
                                                    <details class="rounded-2xl border border-[#d8e5e8] bg-white p-4">
                                                        <summary class="cursor-pointer">
                                                            <div class="flex flex-wrap items-center gap-2">
                                                                <span class="font-semibold text-slate-900">@field.FieldLabel</span>
                                                                <span class="text-xs text-slate-500">@GetUserFacingDataType(field.DataType)</span>
                                                                <span class="@GetFieldActiveBadgeClass(field.IsActive)">@(field.IsActive ? "Activo" : "Inactivo")</span>
                                                            </div>
                                                        </summary>
                                                        <div class="mt-4 text-sm">
                                                            <div class="grid grid-cols-1 gap-3 md:grid-cols-2">
                                                                <input class="rounded-xl border px-3 py-2" value="@field.FieldLabel" @onchange="e => field.FieldLabel = e.Value?.ToString() ?? field.FieldLabel" />
                                                                <input class="rounded-xl border px-3 py-2" value="@field.DisplayOrder" type="number" @onchange="e => field.DisplayOrder = int.TryParse(e.Value?.ToString(), out var parsed) ? parsed : field.DisplayOrder" />
                                                                <input class="rounded-xl border px-3 py-2" value="@field.Placeholder" placeholder="Texto guía en el campo" @onchange="e => field.Placeholder = e.Value?.ToString()" />
                                                                <input class="rounded-xl border px-3 py-2" value="@field.MaxLength" type="number" placeholder="Cantidad máxima de caracteres" @onchange="e => field.MaxLength = int.TryParse(e.Value?.ToString(), out var parsed) ? parsed : null" />
                                                            </div>
                                                            <textarea class="mt-3 w-full rounded-xl border px-3 py-2" rows="2" @onchange="e => field.HelpText = e.Value?.ToString()">@field.HelpText</textarea>
                                                            <div class="configuration-validation-panel configuration-validation-panel--compact">
                                                                <div class="configuration-validation-panel__head">
                                                                    <div>
                                                                        <div class="configuration-validation-panel__eyebrow">Validación del registro</div>
                                                                        <strong>Control de datos</strong>
                                                                    </div>
                                                                    <span>@GetValidationPresetShortLabel(GetValidationPreset(field.ValidationRule))</span>
                                                                </div>
                                                                <p>@GetValidationHelperText(GetValidationPreset(field.ValidationRule))</p>
                                                                <div class="configuration-validation-panel__grid">
                                                                    <label>
                                                                        <span>Regla</span>
                                                                        <select class="rounded-xl border px-3 py-2" value="@GetValidationPreset(field.ValidationRule)" @onchange="e => SetFieldValidationPreset(field, e.Value?.ToString())">
                                                                        @foreach (var option in ValidationPresetOptions)
                                                                        {
                                                                            <option value="@option.Key">@option.Label</option>
                                                                        }
                                                                        </select>
                                                                    </label>
                                                                    <label>
                                                                        <span>Valor</span>
                                                                        <input class="rounded-xl border px-3 py-2" placeholder="@GetValidationValuePlaceholder(GetValidationPreset(field.ValidationRule))" value="@GetValidationRuleValue(field.ValidationRule)" @onchange="e => SetFieldValidationValue(field, e.Value?.ToString())" disabled="@(!ValidationPresetNeedsValue(GetValidationPreset(field.ValidationRule)))" />
                                                                    </label>
                                                                    <label>
                                                                        <span>Error</span>
                                                                        <input class="rounded-xl border px-3 py-2" placeholder="Mensaje de error" value="@GetValidationRuleMessage(field.ValidationRule)" @onchange="e => SetFieldValidationMessage(field, e.Value?.ToString())" disabled="@(string.IsNullOrWhiteSpace(GetValidationPreset(field.ValidationRule)))" />
                                                                    </label>
                                                                </div>
                                                                <div class="configuration-validation-panel__preview">
                                                                    <i class="bi bi-info-circle"></i>
                                                                    <span>@GetValidationPreview(field.FieldLabel, GetValidationPreset(field.ValidationRule), GetValidationRuleValue(field.ValidationRule), GetValidationRuleMessage(field.ValidationRule))</span>
                                                                </div>
                                                            </div>
                                                            <div class="mt-3 flex flex-wrap gap-4">
                                                                <label class="inline-flex items-center gap-2"><input type="checkbox" checked="@field.IsActive" @onchange="e => field.IsActive = e.Value is bool b && b" /> Activo</label>
                                                                <label class="inline-flex items-center gap-2"><input type="checkbox" checked="@field.IsRequired" @onchange="e => field.IsRequired = e.Value is bool b && b" /> Requerido</label>
                                                                <label class="inline-flex items-center gap-2"><input type="checkbox" checked="@field.IsVisible" @onchange="e => field.IsVisible = e.Value is bool b && b" /> Visible</label>
                                                                <label class="inline-flex items-center gap-2"><input type="checkbox" checked="@field.IsEditable" @onchange="e => field.IsEditable = e.Value is bool b && b" /> Editable</label>
                                                            </div>
                                                            <button class="mt-4 rounded-xl bg-slate-800 px-4 py-2 text-sm font-semibold text-white" @onclick="() => UpdateFieldAsync(field)">Guardar campo</button>
                                                        </div>
                                                    </details>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>

                                <div class="rounded-2xl border border-[#ead8bd] bg-[#fffdf8] p-4">
                                    <div class="mb-3 flex items-center justify-between gap-3">
                                        <div>
                                            <div class="font-bold text-[#8b5a16]">Campos físicos</div>
                                            <div class="text-xs text-slate-500">Campos ya existentes dentro del modelo base del sistema.</div>
                                        </div>
                                        <span class="rounded-full bg-white px-3 py-1 text-xs font-semibold text-[#8b5a16]">@GetFilteredPhysicalFields().Count() visibles</span>
                                    </div>
                                    @if (!GetFilteredPhysicalFields().Any())
                                    {
                                        <AppEmptyState Title="Sin campos físicos" Message="No hay campos físicos con el filtro actual." />
                                    }
                                    else
                                    {
                                        <div class="max-h-[22rem] overflow-y-auto pr-1">
                                            <div class="grid grid-cols-1 gap-3 xl:grid-cols-2">
                                                @foreach (var field in GetFilteredPhysicalFields())
                                                {
                                                    <details class="rounded-2xl border border-[#ead8bd] bg-white p-4">
                                                        <summary class="cursor-pointer">
                                                            <div class="flex flex-wrap items-center gap-2">
                                                                <span class="font-semibold text-slate-900">@field.FieldLabel</span>
                                                                <span class="text-xs text-slate-500">@GetUserFacingDataType(field.DataType)</span>
                                                                <span class="@GetFieldActiveBadgeClass(field.IsActive)">@(field.IsActive ? "Activo" : "Inactivo")</span>
                                                            </div>
                                                        </summary>
                                                        <div class="mt-4 text-sm">
                                                            <div class="grid grid-cols-1 gap-3 md:grid-cols-2">
                                                                <input class="rounded-xl border px-3 py-2" value="@field.FieldLabel" @onchange="e => field.FieldLabel = e.Value?.ToString() ?? field.FieldLabel" />
                                                                <input class="rounded-xl border px-3 py-2" value="@field.DisplayOrder" type="number" @onchange="e => field.DisplayOrder = int.TryParse(e.Value?.ToString(), out var parsed) ? parsed : field.DisplayOrder" />
                                                                <input class="rounded-xl border px-3 py-2" value="@field.Placeholder" placeholder="Texto guía en el campo" @onchange="e => field.Placeholder = e.Value?.ToString()" />
                                                                <input class="rounded-xl border px-3 py-2" value="@field.MaxLength" type="number" placeholder="Cantidad máxima de caracteres" @onchange="e => field.MaxLength = int.TryParse(e.Value?.ToString(), out var parsed) ? parsed : null" />
                                                            </div>
                                                            <textarea class="mt-3 w-full rounded-xl border px-3 py-2" rows="2" @onchange="e => field.HelpText = e.Value?.ToString()">@field.HelpText</textarea>
                                                            <div class="configuration-validation-panel configuration-validation-panel--physical">
                                                                <div class="configuration-validation-panel__head">
                                                                    <div>
                                                                        <div class="configuration-validation-panel__eyebrow">Validación del registro</div>
                                                                        <strong>Control de datos</strong>
                                                                    </div>
                                                                    <span>@GetValidationPresetShortLabel(GetValidationPreset(field.ValidationRule))</span>
                                                                </div>
                                                                <p>@GetValidationHelperText(GetValidationPreset(field.ValidationRule))</p>
                                                                <div class="configuration-validation-panel__grid">
                                                                    <label>
                                                                        <span>Regla</span>
                                                                        <select class="rounded-xl border px-3 py-2" value="@GetValidationPreset(field.ValidationRule)" @onchange="e => SetFieldValidationPreset(field, e.Value?.ToString())">
                                                                        @foreach (var option in ValidationPresetOptions)
                                                                        {
                                                                            <option value="@option.Key">@option.Label</option>
                                                                        }
                                                                        </select>
                                                                    </label>
                                                                    <label>
                                                                        <span>Valor</span>
                                                                        <input class="rounded-xl border px-3 py-2" placeholder="@GetValidationValuePlaceholder(GetValidationPreset(field.ValidationRule))" value="@GetValidationRuleValue(field.ValidationRule)" @onchange="e => SetFieldValidationValue(field, e.Value?.ToString())" disabled="@(!ValidationPresetNeedsValue(GetValidationPreset(field.ValidationRule)))" />
                                                                    </label>
                                                                    <label>
                                                                        <span>Error</span>
                                                                        <input class="rounded-xl border px-3 py-2" placeholder="Mensaje de error" value="@GetValidationRuleMessage(field.ValidationRule)" @onchange="e => SetFieldValidationMessage(field, e.Value?.ToString())" disabled="@(string.IsNullOrWhiteSpace(GetValidationPreset(field.ValidationRule)))" />
                                                                    </label>
                                                                </div>
                                                                <div class="configuration-validation-panel__preview">
                                                                    <i class="bi bi-info-circle"></i>
                                                                    <span>@GetValidationPreview(field.FieldLabel, GetValidationPreset(field.ValidationRule), GetValidationRuleValue(field.ValidationRule), GetValidationRuleMessage(field.ValidationRule))</span>
                                                                </div>
                                                            </div>
                                                            <div class="mt-3 flex flex-wrap gap-4">
                                                                <label class="inline-flex items-center gap-2"><input type="checkbox" checked="@field.IsActive" @onchange="e => field.IsActive = e.Value is bool b && b" /> Activo</label>
                                                                <label class="inline-flex items-center gap-2"><input type="checkbox" checked="@field.IsRequired" @onchange="e => field.IsRequired = e.Value is bool b && b" /> Requerido</label>
                                                                <label class="inline-flex items-center gap-2"><input type="checkbox" checked="@field.IsVisible" @onchange="e => field.IsVisible = e.Value is bool b && b" /> Visible</label>
                                                                <label class="inline-flex items-center gap-2"><input type="checkbox" checked="@field.IsEditable" @onchange="e => field.IsEditable = e.Value is bool b && b" /> Editable</label>
                                                            </div>
                                                            <button class="mt-4 rounded-xl bg-slate-800 px-4 py-2 text-sm font-semibold text-white" @onclick="() => UpdateFieldAsync(field)">Guardar campo</button>
                                                        </div>
                                                    </details>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </section>
            </div>
        }

