@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using tesisproject.frontend.SharedUI.Modal
@using tesisproject.frontend.SharedUI.ActionButton
@using tesisproject.frontend.SharedUI.SelectInput
@using tesisproject.frontend.SharedUI.Table
@using tesisproject.frontend.SharedUI.SearchInput
@using tesisproject.shared.DTOs.External
@using tesisproject.shared.DTOs.AppUser
@using tesisproject.shared.DTOs.Catalog.MemberRoleType.Response
@using tesisproject.frontend.Utils

<Modal Id="@ModalId"
       Title="Agregar miembro al grupo"
       IsOpen="@IsOpen"
       IsOpenChanged="IsOpenChanged"
       ShowCloseButton="true"
       CloseOnBackdrop="true"
       CloseOnEscape="true"
       Size="ModalSize.Lg"
       OnClose="HandleClose">

    <ChildContent>
        <div class="space-y-4">

            <SearchInput Value="@search"
                         ValueChanged="OnSearchChanged"
                         Placeholder="Buscar por nombre o correo"
                         AriaLabel="Buscar usuario por nombre o correo"
                         Class="w-full"
                         DebounceMs="10" />

            <div class="max-h-[350px] overflow-y-auto pr-1 border border-border rounded-xl">
                <DataTable TItem="ResolvedUserProfileDTO"
                           Items="FilteredUsers ?? Enumerable.Empty<ResolvedUserProfileDTO>()"
                           Columns="@UserColumns"
                           RowTemplate="UserRowTemplate"
                           PageSize="4"
                           Total="@(FilteredUsers?.Count() ?? 0)"
                           EmptyText="No se encontraron usuarios." />
            </div>

            @if (RequireRoleSelection)
            {
                @if (Roles is not null && Roles.Any())
                {
                    <div class="space-y-1">
                        <label class="block text-sm font-medium text-foreground">
                            Rol
                        </label>

                        <SelectInput TItem="MemberRoleTypeDetailDTO"
                                     Items="Roles"
                                     @bind-Value="SelectedRole"
                                     GetText="@(r => r.Name)"
                                     GetKey="@(r => r.Id.ToString())"
                                     Placeholder="Seleccione un rol"
                                     AllowClear="true"
                                     Size="SelectSize.Md" />

                        @if (ShowRoleValidation && (SelectedRoleId is null || SelectedRoleId <= 0))
                        {
                            <p class="text-sm text-[color:var(--color-error)]">Por favor, seleccione un rol.</p>
                        }
                    </div>
                }
                else
                {
                    <p class="text-sm text-muted">
                        No hay roles disponibles para seleccionar.
                    </p>
                }
            }

        </div>
    </ChildContent>

    <Footer>
        <div class="flex items-center justify-end gap-2">
            <ActionButton Text="Cancelar"
                          Execute="OnCancelClicked"
                          Variant="ButtonVariant.Ghost"
                          Size="ButtonSize.Sm"
                          Class="inline-flex items-center justify-center rounded-xl px-4 py-2" />
            <ActionButton Text="Agregar"
                          Execute="Submit"
                          Variant="ButtonVariant.Soft"
                          Size="ButtonSize.Sm"
                          Class="btn-primary inline-flex items-center justify-center rounded-xl px-4 py-2">
                <Icon>
                    <svg xmlns="http://www.w3.org/2000/svg" class="size-5" viewBox="0 0 24 24" fill="currentColor">
                        <path fill-rule="evenodd" d="M11 4.5a.75.75 0 0 1 .75.75V11h5.75a.75.75 0 0 1 0 1.5H11.75v5.75a.75.75 0 0 1-1.5 0V12.5H4.5a.75.75 0 0 1 0-1.5h5.75V5.25A.75.75 0 0 1 11 4.5Z" clip-rule="evenodd" />
                    </svg>
                </Icon>
            </ActionButton>
        </div>
    </Footer>
</Modal>

@code {
    /* ========== Public API ========== */
    [Parameter] public string ModalId { get; set; } = "user-picker-modal";
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }

    /// <summary>Users to list.</summary>
    [Parameter] public IEnumerable<ResolvedUserProfileDTO>? Users { get; set; }

    /// <summary>Emits the selected UserId when confirming.</summary>
    [Parameter] public EventCallback<int> OnSubmit { get; set; }

    /// <summary>Notifies cancel/close.</summary>
    [Parameter] public EventCallback OnCancel { get; set; }

    /// <summary>Optional preselected user.</summary>
    [Parameter] public int? InitialSelectedUserId { get; set; }

    /// <summary>Lista de roles (ya filtrados por Flag == 2 en el padre).</summary>
    [Parameter] public IEnumerable<MemberRoleTypeDetailDTO>? Roles { get; set; }

    /// <summary>Id del rol seleccionado (bind desde el padre).</summary>
    [Parameter] public int? SelectedRoleId { get; set; }

    [Parameter] public bool RequireRoleSelection { get; set; } = true;

    [Parameter] public EventCallback<int?> SelectedRoleIdChanged { get; set; }

    /* ========== State ========== */
    private int? SelectedUserId;
    private string search = string.Empty;
    private bool ShowUserValidation;
    private bool ShowRoleValidation;

    private MemberRoleTypeDetailDTO? _selectedRole;
    private MemberRoleTypeDetailDTO? SelectedRole
    {
        get => _selectedRole;
        set
        {
            _selectedRole = value;
            var newId = value?.Id;

            if (SelectedRoleId != newId)
            {
                SelectedRoleId = newId;
                _ = SelectedRoleIdChanged.InvokeAsync(newId);
            }
        }
    }

    private static readonly IReadOnlyList<ColumnDef<ResolvedUserProfileDTO>> UserColumns =
        new[]
        {
            // Columna de selección (no ordenable)
            new ColumnDef<ResolvedUserProfileDTO>("", u => u.UserId, "3rem", Sortable: false),

            // Nombre
            new ColumnDef<ResolvedUserProfileDTO>("Nombre", u => u.FullName ?? string.Empty, "16rem"),

            // Email
            new ColumnDef<ResolvedUserProfileDTO>("Correo", u => u.Email ?? string.Empty, "18rem"),
        };

    // Filtro por nombre (puedes ampliar a email si quieres)
    private IEnumerable<ResolvedUserProfileDTO>? FilteredUsers
    {
        get
        {
            if (Users is null)
                return null;

            if (string.IsNullOrWhiteSpace(search))
                return Users;

            // Normalizamos el query
            var q = Normalizers.NormalizeForSearch(search);

            return Users.Where(u =>
            {
                var name = Normalizers.NormalizeForSearch(u.FullName);
                var email = Normalizers.NormalizeForSearch(u.Email);

                return name.Contains(q) || email.Contains(q);
            });
        }
    }

    // RowTemplate: solo <td>, el <tr> lo genera DataTable
    private RenderFragment<ResolvedUserProfileDTO> UserRowTemplate => user => @<text>
        @{
            var selected = SelectedUserId == user.UserId;
            var baseCell = "px-4 py-3 text-sm align-middle";
            var selectedBg = selected ? " bg-primary-subtle" : string.Empty;
            var cellClass = baseCell + selectedBg;
        }

            <td class="@cellClass">
                <button type="button"
                        class="inline-flex items-center justify-center rounded-full border border-border w-5 h-5
                                   @(selected ? " bg-primary-subtle text-[color:var(--color-uta-header)]" : " bg-background")"
                        aria-pressed="@selected"
                        @onclick="() => SelectUser(user.UserId)">
                    @if (selected)
                    {
                        <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none">
                            <path stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                  d="M20 6 9 17l-5-5" />
                        </svg>
                    }
                </button>
            </td>

            <td class="@cellClass">
                @user.FullName
            </td>

            <td class="@($"{cellClass} text-muted")">
                @user.Email
            </td>
    </text>;

protected override void OnParametersSet()
{
if (IsOpen && SelectedUserId is null && InitialSelectedUserId is not null)
SelectedUserId = InitialSelectedUserId;

// Sincronizar rol seleccionado desde SelectedRoleId
if (Roles is not null && Roles.Any() && SelectedRoleId.HasValue)
{
_selectedRole = Roles.FirstOrDefault(r => r.Id == SelectedRoleId.Value);
}
else if (!SelectedRoleId.HasValue)
{
_selectedRole = null;
}
}

private void SelectUser(int userId)
{
SelectedUserId = userId;
ShowUserValidation = false;
StateHasChanged();
}

private Task OnSearchChanged(string value)
{
search = value;
// FilteredUsers se recalcula en el getter; solo forzamos render
StateHasChanged();
return Task.CompletedTask;
}

private async Task Submit()
{
if (SelectedUserId is null)
{
ShowUserValidation = true;
return;
}

if (RequireRoleSelection && (SelectedRoleId is null || SelectedRoleId <= 0))
{
ShowRoleValidation = true;
return;
}

ShowUserValidation = false;
ShowRoleValidation = false;

await OnSubmit.InvokeAsync(SelectedUserId.Value);
}

private async Task OnCancelClicked() => await OnCancel.InvokeAsync();
private async Task HandleClose() => await OnCancel.InvokeAsync();
}