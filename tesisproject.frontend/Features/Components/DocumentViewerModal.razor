@using tesisproject.frontend.SharedUI.Modal
@using tesisproject.frontend.SharedUI.ActionButton
@using tesisproject.frontend.Services.Interfaces
@using Microsoft.JSInterop

@inject IDocumentClientService DocumentService
@inject IJSRuntime JS

<Modal Id="@Id"
       Title="@Title"
       Size="ModalSize.Xl"
       IsOpen="@IsOpen"
       IsOpenChanged="@IsOpenChanged"
       CloseOnBackdrop="true"
       CloseOnEscape="true">

    <ChildContent>
        <div class="flex flex-col h-[68vh] overflow-hidden">
            @if (DocumentId <= 0)
            {
                <div class="text-sm text-muted">
                    No hay ningún documento seleccionado.
                </div>
            }
            else
            {
                <div class="flex-1 min-h-0 border border-border rounded-2xl overflow-hidden bg-background">
                    @if (string.IsNullOrWhiteSpace(_blobUrl))
                    {
                        <div class="h-full w-full flex items-center justify-center text-sm text-muted">
                            Cargando documento...
                        </div>
                    }
                    else
                    {
                        <iframe src="@_blobUrl"
                                class="w-full h-full"
                                title="Vista previa del documento">
                        </iframe>
                    }
                </div>

                <div class="shrink-0 mt-3 pt-3 border-t border-border bg-background">
                    <div class="flex justify-end gap-2">
                        <ActionButton Text="Abrir"
                                      Intent="ButtonIntent.Info"
                                      Variant="ButtonVariant.Ghost"
                                      Size="ButtonSize.Md"
                                      Execute="OpenAsync" />

                        <ActionButton Text="Descargar"
                                      Intent="ButtonIntent.Info"
                                      Variant="ButtonVariant.Filled"
                                      Size="ButtonSize.Md"
                                      Execute="DownloadAsync" />
                    </div>
                </div>
            }
        </div>
    </ChildContent>

</Modal>

@code
{
    [Parameter] public string Id { get; set; } = "document-viewer-modal";
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }

    [Parameter] public int DocumentId { get; set; }
    [Parameter] public string Title { get; set; } = "Documento";

    private string? _blobUrl;
    private string? _fileName;
    private int _loadedDocumentId;

    protected override async Task OnParametersSetAsync()
    {
        if (!IsOpen || DocumentId <= 0)
        {
            await CleanupBlobAsync();
            _loadedDocumentId = 0;
            return;
        }

        if (_loadedDocumentId == DocumentId && !string.IsNullOrWhiteSpace(_blobUrl))
            return;

        await CleanupBlobAsync();

        var r = await DocumentService.GetContentAsync(DocumentId);

        if (!r.Success || r.Data is null)
        {
            _loadedDocumentId = 0;
            return;
        }

        var payload = r.Data;
        _fileName = payload.FileName;

        _blobUrl = await JS.InvokeAsync<string>(
            "docViewer.bytesToBlobUrl",
            payload.Bytes,
            payload.ContentType);

        _loadedDocumentId = DocumentId;
    }

    private async Task CleanupBlobAsync()
    {
        if (!string.IsNullOrWhiteSpace(_blobUrl))
            await JS.InvokeVoidAsync("docViewer.revoke", _blobUrl);

        _blobUrl = null;
        _fileName = null;
    }

    private async Task OpenAsync()
    {
        if (string.IsNullOrWhiteSpace(_blobUrl)) return;
        await JS.InvokeVoidAsync("open", _blobUrl, "_blank");
    }

    private async Task DownloadAsync()
    {
        if (string.IsNullOrWhiteSpace(_blobUrl)) return;
        await JS.InvokeVoidAsync(
            "docViewer.downloadUrl",
            _blobUrl,
            _fileName ?? $"document-{DocumentId}.pdf");
    }
}