@page "/management/author-workspace"
@page "/scientific-production/author-workspace"
@attribute [Authorize(Roles = "Author,ArticleRegistrationUser,WorkflowTrackingUser")]

@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using tesisproject.frontend.Services.Interfaces
@using tesisproject.shared.DTOs.Workflow
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IRegistrationWorkflowSettingsClient RegistrationWorkflowSettingsClient

<PageTitle>Espacio del autor</PageTitle>

<div class="app-page-shell app-shell-warm space-y-5">
    <section class="rounded-[1.4rem] border border-[#c9d8d2] bg-gradient-to-br from-[#003638] via-[#055052] to-[#285A48] p-5 text-white shadow-sm">
        <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
            <div class="max-w-3xl">
                <span class="inline-flex items-center rounded-full bg-white/12 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-[#d9efe8]">
                    Registro científico institucional
                </span>
                <h1 class="mt-3 text-2xl font-semibold md:text-3xl">Espacio del autor</h1>
                <p class="mt-2 max-w-2xl text-sm leading-6 text-[#dbece7]">
                    Este sitio está destinado al registro, consulta externa y seguimiento de información científica enviada a revisión institucional.
                </p>
            </div>
            <div class="rounded-[1rem] border border-white/15 bg-white/10 px-4 py-3 text-sm text-[#eef8f5]">
                <div class="text-xs uppercase tracking-wide text-[#b9d8ce]">Sesión activa</div>
                <div class="mt-1 font-semibold">@UserName</div>
                <div class="text-xs text-[#cfe4dc]">Rol operativo: Autor</div>
            </div>
        </div>
    </section>

    <section class="grid gap-4 xl:grid-cols-[1.15fr_0.85fr]">
        <article class="rounded-[1.2rem] border border-[#d8e4df] bg-white p-4 shadow-sm">
            <div class="mb-4 flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
                <div>
                    <span class="text-xs font-semibold uppercase tracking-wide text-[#408A71]">Acciones principales</span>
                    <h2 class="text-xl font-semibold text-[#12343b]">Registro y seguimiento</h2>
                </div>
                <span class="rounded-full bg-[#edf6f2] px-3 py-1 text-xs font-semibold text-[#285A48]">@RegistrationModeLabel</span>
            </div>

            <div class="grid gap-3 md:grid-cols-2">
                @if (CanRegisterArticles)
                {
                    <a href="/articulos/registrar" class="group rounded-[1rem] border border-[#d8e4df] bg-[#f8fbfa] p-4 text-decoration-none transition hover:border-[#408A71] hover:bg-white hover:shadow-sm">
                        <div class="flex items-start gap-3">
                            <span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-[#055052] text-white"><i class="bi bi-pencil-square"></i></span>
                            <div>
                                <div class="font-semibold text-[#12343b] group-hover:text-[#055052]">Registrar artículo</div>
                                <p class="mt-1 text-sm leading-5 text-[#5d6f6a]">Completa el formulario activo y envía tu producción científica a revisión.</p>
                            </div>
                        </div>
                    </a>
                }

                <a href="/management/workflow-review" class="group rounded-[1rem] border border-[#d8e4df] bg-[#f8fbfa] p-4 text-decoration-none transition hover:border-[#408A71] hover:bg-white hover:shadow-sm">
                    <div class="flex items-start gap-3">
                        <span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-[#408A71] text-white"><i class="bi bi-arrow-repeat"></i></span>
                        <div>
                            <div class="font-semibold text-[#12343b] group-hover:text-[#055052]">Revisión de envíos</div>
                            <p class="mt-1 text-sm leading-5 text-[#5d6f6a]">Consulta el estado de tus artículos y atiende observaciones cuando existan.</p>
                        </div>
                    </div>
                </a>

                <a href="/management/externalapis" class="group rounded-[1rem] border border-[#d8e4df] bg-[#f8fbfa] p-4 text-decoration-none transition hover:border-[#408A71] hover:bg-white hover:shadow-sm">
                    <div class="flex items-start gap-3">
                        <span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-[#8C1007] text-white"><i class="bi bi-search"></i></span>
                        <div>
                            <div class="font-semibold text-[#12343b] group-hover:text-[#660B05]">APIs externas</div>
                            <p class="mt-1 text-sm leading-5 text-[#5d6f6a]">Busca información académica de apoyo antes de registrar o corregir datos.</p>
                        </div>
                    </div>
                </a>

                <a href="/perfilview" class="group rounded-[1rem] border border-[#d8e4df] bg-[#f8fbfa] p-4 text-decoration-none transition hover:border-[#408A71] hover:bg-white hover:shadow-sm">
                    <div class="flex items-start gap-3">
                        <span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-[#628141] text-white"><i class="bi bi-person-circle"></i></span>
                        <div>
                            <div class="font-semibold text-[#12343b] group-hover:text-[#285A48]">Perfil y cuenta</div>
                            <p class="mt-1 text-sm leading-5 text-[#5d6f6a]">Revisa tu sesión, datos de cuenta y accesos disponibles.</p>
                        </div>
                    </div>
                </a>
            </div>
        </article>

        <aside class="space-y-4">
            <article class="rounded-[1.2rem] border border-[#d8e4df] bg-white p-4 shadow-sm">
                <span class="text-xs font-semibold uppercase tracking-wide text-[#408A71]">Flujo esperado</span>
                <div class="mt-3 space-y-3">
                    @foreach (var step in WorkflowSteps)
                    {
                        <div class="flex gap-3">
                            <span class="mt-1 grid h-7 w-7 shrink-0 place-items-center rounded-full bg-[#edf6f2] text-xs font-bold text-[#055052]">@step.Number</span>
                            <div>
                                <div class="text-sm font-semibold text-[#12343b]">@step.Title</div>
                                <p class="mb-0 text-xs leading-5 text-[#667a75]">@step.Description</p>
                            </div>
                        </div>
                    }
                </div>
            </article>

            <article class="rounded-[1.2rem] border border-[#d8e4df] bg-[#f8fbfa] p-4">
                <span class="text-xs font-semibold uppercase tracking-wide text-[#408A71]">Soporte</span>
                <div class="mt-3 grid gap-2">
                    <a class="rounded-xl border border-[#d8e4df] bg-white px-3 py-2 text-sm font-semibold text-[#12343b] text-decoration-none hover:border-[#408A71]" href="/management/support">
                        Centro de ayuda
                    </a>
                    <a class="rounded-xl border border-[#d8e4df] bg-white px-3 py-2 text-sm font-semibold text-[#12343b] text-decoration-none hover:border-[#408A71]" href="/help/manual">
                        Manual de usuario
                    </a>
                </div>
            </article>
        </aside>
    </section>
</div>

@code {
    private string UserName { get; set; } = "Autor";
    private string RegistrationEntryMode { get; set; } = RegistrationEntryModes.AuthorAndUodide;
    private bool HasRegistrationPermission { get; set; }
    private bool IsAuthor { get; set; }

    private bool CanRegisterArticles => HasRegistrationPermission
        || (IsAuthor && RegistrationEntryMode != RegistrationEntryModes.UodideOnly);

    private string RegistrationModeLabel => CanRegisterArticles
        ? "Registro habilitado"
        : "Seguimiento habilitado";

    private static IReadOnlyList<WorkflowStep> WorkflowSteps =>
    [
        new("1", "Registrar", "Completa la información científica desde el formulario activo."),
        new("2", "Enviar a revisión", "El envío pasa a UODIDE para la primera validación institucional."),
        new("3", "Dar seguimiento", "Consulta observaciones, corrige datos y revisa el estado del proceso.")
    ];

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = state.User;

        UserName = user.FindFirst(ClaimTypes.Name)?.Value
            ?? user.FindFirst(ClaimTypes.Email)?.Value
            ?? user.Identity?.Name
            ?? "Autor";

        IsAuthor = user.IsInRole("Author");
        HasRegistrationPermission = user.IsInRole("ArticleRegistrationUser");

        try
        {
            RegistrationEntryMode = (await RegistrationWorkflowSettingsClient.GetAsync())?.EntryMode
                ?? RegistrationEntryModes.AuthorAndUodide;
        }
        catch
        {
            RegistrationEntryMode = RegistrationEntryModes.AuthorAndUodide;
        }
    }

    private sealed record WorkflowStep(string Number, string Title, string Description);
}
