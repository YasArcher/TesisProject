<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
	<RootNamespace>tesisproject.frontend</RootNamespace>
	<AssemblyName>tesisproject.frontend</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Features\Articles\**" />
    <Compile Remove="Services\Auth\Interfaces\**" />
    <Content Remove="Features\Articles\**" />
    <Content Remove="Services\Auth\Interfaces\**" />
