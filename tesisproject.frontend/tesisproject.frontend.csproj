<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
	<RootNamespace>tesisproject.frontend</RootNamespace>
	<AssemblyName>tesisproject.frontend</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Models\**" />
    <Compile Remove="Services\Auth\Interfaces\**" />
    <Content Remove="Models\**" />
    <Content Remove="Services\Auth\Interfaces\**" />
    <EmbeddedResource Remove="Models\**" />
    <EmbeddedResource Remove="Services\Auth\Interfaces\**" />
    <None Remove="Models\**" />
    <None Remove="Services\Auth\Interfaces\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="Features\Projects\Pages\Component.razor" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="SharedUI\SelectInput\SelectInput.razor.css" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Blazored.LocalStorage" Version="4.5.0" />
    <PackageReference Include="Blazored.Toast" Version="4.2.1" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="9.0.8" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="9.0.8" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="9.0.8" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="9.0.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\tesisproject.shared\tesisproject.shared.csproj" />
  </ItemGroup>

  <!-- [ARTICLES-MIGRATION] Copia pasiva para analisis; no se compila ni publica. -->
  <ItemGroup>
    <Compile Remove="ArticlesMigration\**\*.cs" />
    <Content Remove="ArticlesMigration\**" />
    <EmbeddedResource Remove="ArticlesMigration\**" />
    <None Remove="ArticlesMigration\**" />
    <RazorComponent Remove="ArticlesMigration\**\*.razor" />
    <RazorGenerate Remove="ArticlesMigration\**\*.razor" />
  </ItemGroup>
</Project>
