@using tesisproject.frontend.SharedUI
@using Microsoft.AspNetCore.Components
@inherits LayoutComponentBase
@inject NavigationManager Nav

<div class="fusion-app-shell @(_isSidebarCollapsed ? "is-sidebar-collapsed" : null)">
    @if (ShowSidebar)
    {
        <aside class="fusion-sidebar-desktop @(_isSidebarCollapsed ? "is-collapsed" : null)" aria-label="Navegación principal">
            <SideBar IsCollapsed="@_isSidebarCollapsed"
                     IsDesktop="true"
                     OnToggleCollapsed="ToggleSidebarCollapsed" />
        </aside>

        @if (IsSidebarOpen)
        {
            <div class="fusion-sidebar-overlay" @onclick="ToggleSidebar">
                <aside class="fusion-sidebar-mobile" @onclick:stopPropagation="true" aria-label="Navegación principal móvil">
                    <SideBar IsCollapsed="false" IsDesktop="false" />
                </aside>
            </div>
        }
    }

    <div class="fusion-app-workspace">
        <header class="fusion-app-header">
            @if (ShowSidebar)
            {
                <button @onclick="ToggleSidebar"
                        class="fusion-sidebar-tab"
                        aria-label="Abrir navegación">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M4 12h16M4 17h16" />
                    </svg>
                </button>
            }

            <a href="/" class="fusion-header-brand" aria-label="Inicio del sistema integrado">
                <img src="/images/logo.png" alt="Sistema integrado" />
                <span>
                    <small>UTA · Plataforma integrada</small>
                    <strong>Gestión institucional de investigación</strong>
                </span>
            </a>

            <div class="fusion-header-context">
                <span class="fusion-header-pill">@CurrentModuleBadge</span>
                <span class="fusion-header-description">@CurrentModuleDescription</span>
            </div>

            <div class="fusion-header-actions">
                <div class="fusion-header-clock" aria-label="Fecha y hora actual">
                    <span>@CurrentDateLabel</span>
                    <strong>@CurrentTimeLabel</strong>
                </div>

                <a href="/" class="fusion-header-link">Módulos</a>
                <button type="button" class="fusion-logout-button" @onclick="HandleLogout">
                    <span>Salir</span>
                </button>
            </div>
        </header>

        <main class="fusion-app-main">
            <div class="fusion-app-content">
                @Body
            </div>
        </main>
    </div>
</div>
