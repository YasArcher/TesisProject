@page "/login"
@using Microsoft.AspNetCore.Authorization
@layout MinimalLayout

<PageTitle>Ingreso institucional</PageTitle>

<div class="login-card">
    <div class="login-card__brand">
        <img src="/images/logo.png" alt="Sistema institucional" class="login-card__brand-logo" />
        <div>
            <div class="login-card__brand-kicker">UTA</div>
            <div class="login-card__brand-title">Acceso institucional</div>
        </div>
    </div>

    <div class="login-card__header">
        <h1>Inicia sesion</h1>
        <p>Usa tus credenciales para ingresar al modulo correspondiente segun tu rol institucional.</p>
    </div>

    <EditForm Model="@LoginModel" OnValidSubmit="HandleLogin">
        <DataAnnotationsValidator />

        <div class="login-card__field">
            <label for="login-email">Correo institucional</label>
            <div class="login-card__input-shell">
                <span class="login-card__input-icon" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M1.5 8.67v8.58A2.25 2.25 0 0 0 3.75 19.5h16.5a2.25 2.25 0 0 0 2.25-2.25V8.67l-8.93 5.49a3 3 0 0 1-3.14 0L1.5 8.67Z" />
                        <path d="M22.5 6.908V6.75A2.25 2.25 0 0 0 20.25 4.5H3.75A2.25 2.25 0 0 0 1.5 6.75v.158l9.714 5.978a1.5 1.5 0 0 0 1.572 0L22.5 6.908Z" />
                    </svg>
                </span>
                <InputText id="login-email"
                           @bind-Value="LoginModel.Email"
                           type="email"
                           class="login-card__input"
                           autocomplete="email"
                           inputmode="email"
                           placeholder="usuario@uta.edu.ec" />
            </div>
            <ValidationMessage For="@(() => LoginModel.Email)" class="login-card__validation" />
        </div>

        <div class="login-card__field">
            <label for="login-password">Contrasena</label>
            <div class="login-card__input-shell">
                <span class="login-card__input-icon" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                        <path fill-rule="evenodd" d="M12 1.5a5.25 5.25 0 0 0-5.25 5.25V9A3.75 3.75 0 0 0 3 12.75v5.25A3.75 3.75 0 0 0 6.75 21.75h10.5A3.75 3.75 0 0 0 21 18v-5.25A3.75 3.75 0 0 0 17.25 9V6.75A5.25 5.25 0 0 0 12 1.5Zm3.75 7.5V6.75a3.75 3.75 0 1 0-7.5 0V9h7.5Z" clip-rule="evenodd" />
                    </svg>
                </span>
                <InputText id="login-password"
                           @bind-Value="LoginModel.Password"
                           type="@(ShowPassword ? "text" : "password")"
                           class="login-card__input login-card__input--password"
                           autocomplete="current-password"
                           placeholder="Ingresa tu contrasena" />
                <button type="button"
                        class="login-card__toggle"
                        aria-label="@(ShowPassword ? "Ocultar contrasena" : "Mostrar contrasena")"
                        title="@(ShowPassword ? "Ocultar contrasena" : "Mostrar contrasena")"
                        @onclick="TogglePassword">
                    @if (ShowPassword)
                    {
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M3.53 2.47a.75.75 0 0 0-1.06 1.06l18 18a.75.75 0 1 0 1.06-1.06l-18-18Z" />
                            <path d="M22.676 12.553a11.249 11.249 0 0 1-2.631 3.31l-3.099-3.099a5.25 5.25 0 0 0-6.71-6.71L7.759 3.577A11.217 11.217 0 0 1 12 2.75c4.97 0 9.185 3.223 10.676 7.697.12.36.12.746 0 1.106Z" />
                            <path d="M15.75 12c0 .18-.013.357-.038.53L11.47 8.288A3.75 3.75 0 0 1 15.75 12ZM12.53 15.712 8.288 11.47A3.75 3.75 0 0 0 12.53 15.712Z" />
                            <path d="M6.75 12c0-.619.107-1.213.304-1.764L3.956 7.137a11.248 11.248 0 0 0-2.632 3.31c-.12.36-.12.746 0 1.106C2.815 16.027 7.03 19.25 12 19.25c1.52 0 2.97-.301 4.292-.846l-2.477-2.477A5.25 5.25 0 0 1 6.75 12Z" />
                        </svg>
                    }
                    else
                    {
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z" />
                            <path fill-rule="evenodd" d="M1.323 11.447C2.811 6.976 7.028 3.75 12.001 3.75c4.97 0 9.185 3.223 10.675 7.697.12.36.12.746 0 1.106-1.49 4.474-5.706 7.697-10.675 7.697-4.973 0-9.19-3.226-10.678-7.697a1.762 1.762 0 0 1 0-1.106ZM17.25 12a5.25 5.25 0 1 1-10.5 0 5.25 5.25 0 0 1 10.5 0Z" clip-rule="evenodd" />
                        </svg>
                    }
                </button>
            </div>
            <ValidationMessage For="@(() => LoginModel.Password)" class="login-card__validation" />
        </div>

        <div class="login-card__meta">
            <span>Acceso seguro</span>
            <span>Sesion institucional</span>
        </div>

        <button type="submit" class="login-card__submit" disabled="@_busy">
            @if (_busy)
            {
                <span class="login-card__spinner" aria-hidden="true"></span>
                <span>Ingresando...</span>
            }
            else
            {
                <span>Ingresar al sistema</span>
            }
        </button>
    </EditForm>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="login-card__error" role="alert" aria-live="assertive">@_error</div>
    }
</div>
