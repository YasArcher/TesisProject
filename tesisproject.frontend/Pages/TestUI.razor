<h3 class="text-xl font-semibold mb-4">Table demo</h3>
<DataTable TItem="ProjectItem"
           Items="PagedItems"
           Columns="ProjectColumns"
           PageSize="PageSize"
           Total="Projects.Count"
           CurrentPage="@CurrentPage"
           OnPageChanged="OnPageChanged">
    <!-- Optional custom row template:
    <RowTemplate Context="p">
        <td class="px-4 py-3">@p.ProjectId</td>
        <td class="px-4 py-3">@p.Name</td>
        <td class="px-4 py-3">@p.State</td>
        <td class="px-4 py-3">@p.CreatedAt.ToShortDateString()</td>
    </RowTemplate>
    -->
</DataTable>

@code {
    // Demo DTO for table (keep demo independent from your Entities if you want)
    public sealed class ProjectItem
    {
        [Required] public string ProjectId { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public string State { get; set; } = "Draft";
        public DateOnly CreatedAt { get; set; }
    }

    private List<ProjectItem> Projects = new();
    private IReadOnlyList<ColumnDef<ProjectItem>> ProjectColumns => new[]
    {
        new ColumnDef<ProjectItem>("ID",     p => p.ProjectId, "12rem"),
        new ColumnDef<ProjectItem>("Name",   p => p.Name),
        new ColumnDef<ProjectItem>("State",  p => p.State, Width: "8rem"),
        new ColumnDef<ProjectItem>("Created",p => p.CreatedAt)
    };

    private int PageSize = 10;
    private int CurrentPage = 1;

    private IEnumerable<ProjectItem> PagedItems =>
        Projects.Skip((CurrentPage - 1) * PageSize).Take(PageSize);

    protected override void OnInitialized()
    {
        // Seed demo data
        var today = DateOnly.FromDateTime(DateTime.Today);
        for (int i = 1; i <= 53; i++)
        {
            Projects.Add(new ProjectItem
            {
                ProjectId = $"PRJ-{i:0000}",
                Name = $"Project #{i}",
                State = i % 3 == 0 ? "Closed" : (i % 2 == 0 ? "Active" : "Draft"),
                CreatedAt = today.AddDays(-i)
            });
        }
    }

    private void OnPageChanged(int page)
    {
        CurrentPage = page;
        StateHasChanged();
    }
}

<h3 class="text-xl font-semibold mb-4">Feedback Demo</h3>
<div class="space-y-8 p-6">
