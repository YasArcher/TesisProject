@page "/"
@using tesisproject.frontend.Services.Interfaces
@using tesisproject.frontend.SharedUI.Feedback
@using tesisproject.shared.DTOs.Articles
@using tesisproject.shared.Errors
@inject IAuthClientService AuthClient
@inject IProjectClientService ProjectClient
@inject IArticleClientService ArticleClient
@inject NavigationManager Nav

<div class="portal-page">
    <div class="portal-content">
        <header class="portal-hero">
            <img src="/images/portal-research.png"
                 alt="Investigadores revisando artículos y resultados en un laboratorio universitario"
                 loading="eager" decoding="async" />
            <div class="portal-hero-shade"></div>
            <div class="portal-hero-copy">
                <p>Investigación institucional</p>
                <h1>Portal de investigación</h1>
                <span>Proyectos y producción científica en un solo lugar.</span>
            </div>
        </header>

        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <p class="portal-notice" role="status">@_message</p>
        }

        <section class="portal-metrics" aria-label="Indicadores generales">
            <div class="portal-section-heading">
                <h2>Resumen institucional</h2>
                @if (!_loading)
                {
                    <button type="button" disabled="@_metricsLoading" @onclick="RefreshMetricsAsync">Actualizar cifras</button>
                }
            </div>
            <div class="portal-metrics-grid">
                <article>
                    <span>Total de proyectos</span>
                    @if (_loading || _metricsLoading) { <Skeleton Width="84" Height="36" /> }
                    else { <strong>@MetricValue(_totalProjects)</strong> }
                </article>
                <article>
                    <span>Total de artículos</span>
                    @if (_loading || _metricsLoading) { <Skeleton Width="84" Height="36" /> }
                    else { <strong>@MetricValue(_totalArticles)</strong> }
                </article>
                <article>
                    <span>Proyectos en ejecución</span>
                    @if (_loading || _metricsLoading) { <Skeleton Width="84" Height="36" /> }
                    else { <strong>@MetricValue(_projectsInProgress)</strong> }
                </article>
            </div>
            @if (_metricsError)
            {
                <p class="portal-metrics-note" role="status">Algunas cifras no están disponibles. Puedes actualizarlas nuevamente.</p>
            }
        </section>

        <section class="portal-modules" aria-label="Módulos disponibles">
            <div class="portal-section-heading"><h2>Módulos</h2></div>
            <div class="portal-module-grid">
                <article class="portal-module-card portal-module-projects">
                    <div>
                        <span class="portal-module-label">@(_loading ? "Consultando acceso" : _canOpenProjects ? "Disponible" : "Sin acceso")</span>
                        <h3>Gestión de proyectos</h3>
                        <p>Proyectos, matrices y seguimiento.</p>
                    </div>
                    <button type="button" disabled="@(_loading || !_canOpenProjects)" @onclick="OpenProjects">
                        @(_canOpenProjects ? "Ir a proyectos" : "Módulo no disponible")
                    </button>
                </article>
                <article class="portal-module-card portal-module-articles">
                    <div>
                        <span class="portal-module-label">@ArticleAvailabilityLabel</span>
                        <h3>Producción científica</h3>
                        <p>Artículos, registro y reportería.</p>
                    </div>
                    <button type="button" disabled="@(_loading || !_canOpenArticles)" @onclick="OpenArticles">
                        @(_canOpenArticles ? "Ir a artículos" : "Módulo no disponible")
                    </button>
                </article>
            </div>
        </section>
    </div>
</div>

@code {
    private bool _loading = true;
    private bool _metricsLoading;
    private bool _metricsError;
    private bool _canOpenProjects;
    private bool _canOpenArticles;
    private bool _canReadArticles;
    private bool _articlesEnabled;
    private int? _totalProjects;
    private int? _totalArticles;
    private int? _projectsInProgress;
    private string? _message;

    private string ArticleAvailabilityLabel
        => _loading ? "Consultando acceso" : !_articlesEnabled ? "En preparación" : _canOpenArticles ? "Disponible" : "Sin acceso";

    protected override async Task OnInitializedAsync()
    {
        var result = await AuthClient.GetCurrentSessionAsync();

        if (result.Success && result.Data is not null)
        {
            _canOpenProjects = result.Data.Roles.Any(role =>
                role.Equals("coordinador", StringComparison.OrdinalIgnoreCase) ||
                role.Equals("technical", StringComparison.OrdinalIgnoreCase) ||
                role.Equals("admin", StringComparison.OrdinalIgnoreCase) ||
                role.Equals("superadmin", StringComparison.OrdinalIgnoreCase));
            _articlesEnabled = result.Data.Articles.Enabled;
            _canOpenArticles = _articlesEnabled && (result.Data.Articles.CanAccess || result.Data.Articles.CanList);
            _canReadArticles = _articlesEnabled && result.Data.Articles.CanList;

            if (!_canOpenProjects && !_canOpenArticles)
                _message = "Tu cuenta no tiene un módulo asignado.";
        }
        else
        {
            _message = "No fue posible consultar tus accesos. Actualiza la página para intentarlo de nuevo.";
        }

        _loading = false;
        await RefreshMetricsAsync();
    }

    private async Task RefreshMetricsAsync()
    {
        if (_metricsLoading)
            return;

        _metricsLoading = true;
        _metricsError = false;
        _totalProjects = null;
        _projectsInProgress = null;
        _totalArticles = null;

        try
        {
            var results = await Task.WhenAll(LoadProjectMetricsAsync(), LoadArticleMetricsAsync());
            _metricsError = results.Any(success => !success);
        }
        finally
        {
            _metricsLoading = false;
        }
    }

    private async Task<bool> LoadProjectMetricsAsync()
    {
        if (!_canOpenProjects)
            return true;

        try
        {
            var result = await ProjectClient.GetListAsync(onlyActive: false);
            if (result.Success && result.Data is not null)
            {
                _totalProjects = result.Data.Count;
                _projectsInProgress = result.Data.Count(project =>
                    string.Equals(project.ProjectStateName, "En ejecución", StringComparison.OrdinalIgnoreCase));
                return true;
            }

            if (result.ErrorCode == ErrorCodes.Project.NoneFound)
            {
                _totalProjects = 0;
                _projectsInProgress = 0;
                return true;
            }
        }
        catch
        {
            // Keep the metric unavailable when the projects service cannot be reached.
        }

        return false;
    }

    private async Task<bool> LoadArticleMetricsAsync()
    {
        if (!_canReadArticles)
            return true;

        try
        {
            var result = await ArticleClient.GetPageAsync(new ArticleListQuery { Page = 1, PageSize = 1 });
            if (result.Success && result.Data is not null)
            {
                _totalArticles = result.Data.TotalCount;
                return true;
            }
        }
        catch
        {
            // Keep the metric unavailable when the articles service cannot be reached.
        }

        return false;
    }

    private static string MetricValue(int? value) => value?.ToString("N0") ?? "N/D";

    private void OpenProjects() => Nav.NavigateTo("/projects/home");
    private void OpenArticles() => Nav.NavigateTo("/articles");
}
