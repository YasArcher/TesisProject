@page "/"
@layout MainLayout
@using tesisproject.frontend.SharedUI.ActionButton

<PageTitle>Home</PageTitle>

<h1>Hello, HOME!</h1>

Welcome to your new app.

<ActionButton Text="Click Me!"
              Intent="ButtonIntent.Info"
              ExecuteAsync="OnActionButtonClick"
              Class="bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded" />


@code {
    private Task OnActionButtonClick()
    {
        Console.WriteLine("🔵 ActionButton clicked!");
        return Task.CompletedTask;
    }
}
