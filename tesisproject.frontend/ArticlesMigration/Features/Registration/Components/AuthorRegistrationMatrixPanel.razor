@using Blazored.LocalStorage
@using tesisproject.frontend.Services.Errors
@using tesisproject.frontend.SharedUI
@using tesisproject.shared.DTOs.Catalogs
@using tesisproject.shared.DTOs.Configuration
@using tesisproject.shared.DTOs.MassRegistration
@using tesisproject.shared.Validation

@inject IRegistrationMatrixClient RegistrationMatrixClient
@inject IFormConfigurationClient FormConfigurationClient
@inject ILocalStorageService LocalStorage

<div class="author-matrix-panel space-y-4">
    <AppStatusModal Visible="@HasStatusMessage"
                    Variant="@StatusVariant"
                    Eyebrow="Registro en masa"
                    Title="@StatusTitle"
                    Message="@StatusMessage"
                    OnClose="CloseStatusModal" />

    <AppConfirmPanel Visible="@IsSubmitConfirmOpen"
                     Eyebrow="Confirmar envío"
                     Title="Enviar artículos a revisión"
                     Message="@SubmitConfirmMessage"
                     ConfirmText="Enviar a revisión"
                     CancelText="Seguir editando"
                     OnConfirm="ConfirmSubmitAsync"
                     OnCancel="CloseSubmitConfirmAsync" />

    @if (IsSubmittingReview)
    {
        <div class="author-matrix-cooldown">
            <div class="author-matrix-cooldown__card">
                <div class="author-matrix-cooldown__spinner"></div>
                <div class="author-matrix-cooldown__eyebrow">Procesando envío</div>
                <h3>Estamos enviando la matriz a revisión</h3>
                <p>
                    Espera un momento mientras se genera el lote institucional y se crea el staging para UODIDE y Área Técnica.
                </p>
            </div>
        </div>
    }

    @if (IsLoading)
    {
        <div class="rounded-[1.6rem] border border-[var(--app-border-subtle)] bg-white px-6 py-8 text-center text-sm text-[var(--app-text-muted)] shadow-sm">
            Preparando la matriz de registro del autor...
        </div>
    }
    else if (!AllowedFieldIds.Any())
    {
        <AppEmptyState Class="rounded-[1.8rem] border border-[var(--app-border-subtle)] bg-white px-6 py-10 shadow-sm"
                       Title="No hay campos configurados para el registro en masa"
                       Message="Activa primero los campos requeridos en la configuración del formulario para habilitar esta modalidad." />
    }
    else if (Matrix is null)
    {
        <AppEmptyState Class="rounded-[1.8rem] border border-[var(--app-border-subtle)] bg-white px-6 py-10 shadow-sm"
                       Title="No pude preparar la matriz del autor"
                       Message="Intenta recargar el módulo para generar un nuevo borrador de trabajo." />
    }
    else
    {
        <div class="author-matrix-shell">
            <section class="author-matrix-overview rounded-[1.85rem] border border-[var(--app-border-subtle)] p-4 shadow-sm">
                <div class="author-matrix-overview__content">
                    <div class="space-y-2">
                        <div class="author-matrix-eyebrow">Registro en masa para autores</div>
                        <h2 class="text-xl font-black text-[var(--app-heading)]">Matriz institucional de artículos</h2>
                        <p class="text-sm text-[var(--app-text-muted)]">
                            Usa esta hoja para registrar varios artículos con los campos institucionales habilitados y enviar únicamente las filas listas al proceso de revisión.
                        </p>
                    </div>
                    <div class="author-matrix-overview__text">
                        <span class="@GetMatrixStatusClass(Matrix.Summary)">@GetMatrixStatusLabel(Matrix.Summary)</span>
                        <span><strong>@OrderedRows.Count</strong> fila(s) en la hoja</span>
                        <span><strong>@ReadyRowsCount</strong> lista(s) para revisión</span>
                        <span><strong>@PendingRowsCount</strong> pendiente(s)</span>
                        <span><strong>@TotalParticipantDrafts</strong> participante(s)</span>
                        <span><strong>@RequiredColumnsCount</strong> campo(s) obligatorios</span>
                    </div>
                </div>
            </section>

            <section class="author-matrix-board overflow-hidden rounded-[1.8rem] border border-[var(--app-border-subtle)] bg-white shadow-sm">
                <div class="author-matrix-board__header border-b border-[var(--app-border-subtle)] px-4 py-3">
                    <div class="flex flex-wrap items-center justify-between gap-3">
                        <div>
                            <div class="author-matrix-eyebrow">Captura tabular</div>
                            <div class="text-sm font-semibold text-[var(--app-heading)]">@Matrix.Summary.Name</div>
                        </div>
                        <div class="text-xs text-[var(--app-text-muted)]">
                            Completa o corrige las celdas necesarias antes de iniciar el envío a revisión.
                        </div>
                    </div>
                </div>

                @if (!Matrix.Rows.Any())
                {
                    <div class="p-6">
                        <AppEmptyState Title="Tu matriz está vacía" Message="Agrega la primera fila para empezar a registrar artículos en masa." />
                    </div>
                }
                else
                {
                    <div class="author-matrix-panel__table-host">
                        <table class="min-w-full border-separate border-spacing-0 text-sm">
                            <thead class="sticky top-0 z-20 text-white shadow-sm">
                                <tr>
                                    <th class="border border-white/10 px-3 py-2 text-left text-xs font-bold uppercase tracking-[0.16em] text-white/80">Fila</th>
                                    @foreach (var column in OrderedColumns)
                                    {
                                        <th class="border border-white/10 px-3 py-2 text-left align-top">
                                            <div class="author-matrix-column-head min-w-[12rem]">
                                                <div class="font-semibold text-white">
                                                    @column.FieldLabel
                                                    @if (IsColumnRequired(column))
                                                    {
                                                        <span class="text-[#ffe0a8]">*</span>
                                                    }
                                                </div>
                                                <div class="mt-1 text-[11px] text-white/70">@GetColumnLegend(column)</div>
                                            </div>
                                        </th>
                                    }
                                    <th class="border border-white/10 px-3 py-2 text-left text-xs font-bold uppercase tracking-[0.16em] text-white/80">Acción</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in OrderedRows)
                                {
                                    <tr class="author-matrix-row bg-white even:bg-[var(--app-surface-soft)]/50">
                                        <td class="border border-[var(--app-border-subtle)] px-3 py-3 align-top">
                                            <div class="author-matrix-row__index">@row.RowNumber</div>
                                            <div class="mt-1">
                                                <span class="@GetRowStatusClass(row)">@GetRowStatusLabel(row)</span>
                                            </div>
                                        </td>
                                        @foreach (var column in OrderedColumns)
                                        {
                                            var field = GetFieldById(column.FieldId);
                                            var value = GetCellValue(row, column.FieldId);
                                            <td class="@GetCellContainerClass(column, row)">
                                                @if (field is not null && HasFixedOptions(field))
                                                {
                                                    <select class="w-full min-w-[12rem] rounded-xl border border-[var(--app-border-subtle)] bg-white px-3 py-2 text-sm shadow-sm"
                                                            value="@value"
                                                            @onchange="e => UpdateCellAsync(row.RegistrationMatrixRowId, column.FieldId, e.Value?.ToString(), field)">
                                                        <option value="">Seleccionar...</option>
                                                        @foreach (var option in GetFixedOptions(field))
                                                        {
                                                            <option value="@option.Value">@option.Label</option>
                                                        }
                                                    </select>
                                                }
                                                else if (field is not null && HasOptionsForRow(field, row))
                                                {
                                                    <select class="w-full min-w-[12rem] rounded-xl border border-[var(--app-border-subtle)] bg-white px-3 py-2 text-sm shadow-sm"
                                                            value="@value"
                                                            @onchange="e => UpdateCellAsync(row.RegistrationMatrixRowId, column.FieldId, e.Value?.ToString(), field)">
                                                        <option value="">Seleccionar...</option>
                                                        @foreach (var option in GetOptionsForRow(field, row))
                                                        {
                                                            <option value="@option.Value">@option.Label</option>
                                                        }
                                                    </select>
                                                }
                                                else if (field is not null && IsBooleanField(field))
                                                {
                                                    <select class="w-full min-w-[12rem] rounded-xl border border-[var(--app-border-subtle)] bg-white px-3 py-2 text-sm shadow-sm"
                                                            value="@value"
                                                            @onchange="e => UpdateCellAsync(row.RegistrationMatrixRowId, column.FieldId, e.Value?.ToString(), field)">
                                                        <option value="">Seleccionar...</option>
                                                        <option value="true">Sí</option>
                                                        <option value="false">No</option>
                                                    </select>
                                                }
                                                else
                                                {
                                                    <input class="w-full min-w-[12rem] rounded-xl border border-[var(--app-border-subtle)] bg-white px-3 py-2 text-sm shadow-sm"
                                                           type="@(field is null ? "text" : GetInputType(field))"
                                                           step="@(field is null ? null : GetInputStep(field))"
                                                           min="@(field is null ? null : GetInputMin(field))"
                                                           max="@(field is null ? null : GetInputMax(field))"
                                                           maxlength="@(field is null ? null : GetInputMaxLength(field))"
                                                           inputmode="@(field is not null && IsIdentificationField(field) ? "numeric" : null)"
                                                           placeholder="@(field is null ? "Registrar valor" : GetPlaceholder(field))"
                                                           value="@value"
                                                           @onchange="e => UpdateCellAsync(row.RegistrationMatrixRowId, column.FieldId, e.Value?.ToString(), field)" />
                                                }
                                                @if (field is not null && ShowSupport(field, row))
                                                {
                                                    <div class="mt-1 text-[11px] text-[var(--app-text-soft)]">@GetSupport(field, row)</div>
                                                }
                                                @if (field is not null && !string.IsNullOrWhiteSpace(GetCellValidationMessage(column, row)))
                                                {
                                                    <div class="mt-1 rounded-lg bg-rose-50 px-2 py-1 text-[11px] font-semibold text-rose-700">@GetCellValidationMessage(column, row)</div>
                                                }
                                            </td>
                                        }
                                        <td class="border border-[var(--app-border-subtle)] px-3 py-3 align-top">
                                            <div class="flex min-w-[9rem] flex-col gap-2">
                                                <button type="button" class="rounded-xl border border-[#408A71]/30 bg-[#eaf6f1] px-3 py-2 text-xs font-semibold text-[#055052]" @onclick="() => OpenParticipantEditor(row.RegistrationMatrixRowId)">
                                                    Autores (@GetParticipantDrafts(row.RegistrationMatrixRowId).Count)
                                                </button>
                                                <button type="button" class="rounded-xl border border-rose-200 bg-rose-50 px-3 py-2 text-xs font-semibold text-rose-700" @onclick="() => DeleteRowAsync(row.RegistrationMatrixRowId)">
                                                    Quitar fila
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>

            @if (EditingParticipantsRow is not null)
            {
                <section class="rounded-[1.8rem] border border-[#408A71]/25 bg-gradient-to-br from-white via-[#f7fbf8] to-[#eef6f2] p-4 shadow-sm">
                    <div class="flex flex-wrap items-start justify-between gap-3 border-b border-[#408A71]/15 pb-3">
                        <div>
                            <div class="author-matrix-eyebrow">Participantes de la fila @EditingParticipantsRow.RowNumber</div>
                            <h3 class="text-lg font-black text-[#003638]">Autores y coautores del artículo</h3>
                            <p class="mt-1 text-sm text-[var(--app-text-muted)]">Registra al menos un participante. El primero queda como autor principal y los siguientes como coautores, salvo que ajustes su participación.</p>
                        </div>
                        <div class="flex flex-wrap gap-2">
                            <button type="button" class="rounded-xl bg-[#055052] px-3 py-2 text-xs font-semibold text-white shadow-sm" @onclick="() => AddParticipantAsync(EditingParticipantsRow.RegistrationMatrixRowId)">
                                Agregar participante
                            </button>
                            <button type="button" class="rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-600" @onclick="CloseParticipantEditor">
                                Cerrar
                            </button>
                        </div>
                    </div>

                    <div class="mt-4 grid gap-3">
                        @foreach (var participant in GetParticipantDrafts(EditingParticipantsRow.RegistrationMatrixRowId))
                        {
                            <article class="rounded-[1.35rem] border border-white/70 bg-white/90 p-3 shadow-sm">
                                <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
                                    <div>
                                        <div class="text-xs font-black uppercase tracking-[0.14em] text-[#408A71]">Participante @participant.Index</div>
                                        <div class="text-sm font-semibold text-[#003638]">@GetParticipantSummary(participant)</div>
                                    </div>
                                    <button type="button"
                                            class="rounded-xl border border-rose-200 bg-rose-50 px-3 py-2 text-xs font-semibold text-rose-700 disabled:cursor-not-allowed disabled:opacity-50"
                                            disabled="@(GetParticipantDrafts(EditingParticipantsRow.RegistrationMatrixRowId).Count <= 1)"
                                            @onclick="() => RemoveParticipantAsync(EditingParticipantsRow.RegistrationMatrixRowId, participant.LocalId)">
                                        Quitar
                                    </button>
                                </div>

                                <div class="grid gap-3 md:grid-cols-2 xl:grid-cols-4">
                                    @foreach (var field in VisibleParticipantFields)
                                    {
                                        var participantValue = GetParticipantCellValue(participant, field.FieldId);
                                        <label class="@GetParticipantFieldClass(field, participant)">
                                            <span class="text-[11px] font-bold uppercase tracking-[0.12em] text-slate-500">
                                                @field.FieldLabel
                                                @if (field.IsRequired)
                                                {
                                                    <span class="text-rose-600">*</span>
                                                }
                                            </span>
                                            @if (IsIndexField(field))
                                            {
                                                <input class="mt-1 w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-sm font-semibold text-slate-500"
                                                       value="@participant.Index"
                                                       readonly />
                                            }
                                            else if (HasFixedOptions(field))
                                            {
                                                <select class="mt-1 w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm shadow-sm"
                                                        value="@participantValue"
                                                        @onchange="e => UpdateParticipantCellAsync(EditingParticipantsRow.RegistrationMatrixRowId, participant.LocalId, field.FieldId, e.Value?.ToString())">
                                                    <option value="">Seleccionar...</option>
                                                    @foreach (var option in GetFixedOptions(field))
                                                    {
                                                        <option value="@option.Value">@option.Label</option>
                                                    }
                                                </select>
                                            }
                                            else if (IsBooleanField(field))
                                            {
                                                <select class="mt-1 w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm shadow-sm"
                                                        value="@participantValue"
                                                        @onchange="e => UpdateParticipantCellAsync(EditingParticipantsRow.RegistrationMatrixRowId, participant.LocalId, field.FieldId, e.Value?.ToString())">
                                                    <option value="">Seleccionar...</option>
                                                    <option value="true">Sí</option>
                                                    <option value="false">No</option>
                                                </select>
                                            }
                                            else
                                            {
                                                <input class="mt-1 w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm shadow-sm"
                                                       type="@(GetInputType(field))"
                                                       step="@(GetInputStep(field))"
                                                       min="@(GetInputMin(field))"
                                                       max="@(GetInputMax(field))"
                                                       maxlength="@(GetInputMaxLength(field))"
                                                       inputmode="@(IsIdentificationField(field) ? "numeric" : null)"
                                                       placeholder="@GetPlaceholder(field)"
                                                       value="@participantValue"
                                                       @onchange="e => UpdateParticipantCellAsync(EditingParticipantsRow.RegistrationMatrixRowId, participant.LocalId, field.FieldId, e.Value?.ToString())" />
                                            }
                                            @if (!string.IsNullOrWhiteSpace(GetParticipantValidationMessage(field, participant)))
                                            {
                                                <span class="mt-1 block rounded-lg bg-rose-50 px-2 py-1 text-[11px] font-semibold text-rose-700">@GetParticipantValidationMessage(field, participant)</span>
                                            }
                                        </label>
                                    }
                                </div>
                            </article>
                        }
                    </div>
                </section>
            }
        </div>

        <div class="author-matrix-floating-actions">
            <button type="button"
                    class="author-matrix-floating-button author-matrix-floating-button--submit"
                    disabled="@(!CanSubmit || IsBusy)"
                    title="Enviar artículos a revisión"
                    @onclick="OpenSubmitConfirm">
                @(IsSubmittingReview ? "..." : "Enviar")
            </button>
            <button type="button"
                    class="author-matrix-floating-button"
                    title="Agregar fila"
                    @onclick="AddRowAsync">
                +
            </button>
        </div>
    }
</div>

@code {
    private const string DraftStorageKey = "author-registration.matrix-draft";
    private readonly Dictionary<OptionCacheKey, List<OptionItem>> FieldOptions = new();
    private List<FieldCatalogItemDto> ArticleFields { get; set; } = new();
    private List<FieldCatalogItemDto> ParticipantFields { get; set; } = new();
    private RegistrationMatrixDetailDto? Matrix { get; set; }
    private bool IsLoading { get; set; } = true;
    private bool IsBusy { get; set; }
    private string StatusVariant { get; set; } = "info";
    private string StatusTitle { get; set; } = string.Empty;
    private string StatusMessage { get; set; } = string.Empty;
    private string CurrentFieldSignature { get; set; } = string.Empty;
    private bool IsSubmitConfirmOpen { get; set; }
    private bool IsSubmittingReview { get; set; }
    private bool HasAttemptedSubmit { get; set; }
    private int? EditingParticipantsRowId { get; set; }
    private Dictionary<int, List<MatrixParticipantDraft>> RowParticipantDrafts { get; set; } = new();
    private string SubmitConfirmMessage { get; set; } = "Se generará el staging institucional para todos los registros listos de esta matriz. Mientras se realiza el envío no podrás seguir editando la hoja.";

    [Parameter] public IReadOnlyList<int> AllowedArticleFieldIds { get; set; } = [];
    [Parameter] public IReadOnlyList<int> AllowedParticipantFieldIds { get; set; } = [];
    [Parameter] public string MatrixName { get; set; } = "Registro masivo de artículos";
    [Parameter] public EventCallback<string> OnSubmitted { get; set; }

    private bool HasStatusMessage => !string.IsNullOrWhiteSpace(StatusTitle);
    private IReadOnlyList<int> AllowedFieldIds => AllowedArticleFieldIds.Distinct().ToList();
    private IReadOnlyList<RegistrationMatrixColumnDto> OrderedColumns => Matrix?.Columns.OrderBy(x => x.DisplayOrder).ThenBy(x => x.RegistrationMatrixColumnId).ToList() ?? [];
    private IReadOnlyList<RegistrationMatrixRowDto> OrderedRows => Matrix?.Rows.OrderBy(x => x.RowNumber).ToList() ?? [];
    private RegistrationMatrixRowDto? EditingParticipantsRow => OrderedRows.FirstOrDefault(x => x.RegistrationMatrixRowId == EditingParticipantsRowId);
    private IReadOnlyList<FieldCatalogItemDto> VisibleParticipantFields => ParticipantFields
        .Where(x => AllowedParticipantFieldIds.Contains(x.FieldId))
        .Where(x => !x.FieldKey.Equals("InstitutionalPersonId", StringComparison.OrdinalIgnoreCase))
        .Where(x => !x.FieldKey.Equals("ExternalAuthorId", StringComparison.OrdinalIgnoreCase))
        .OrderBy(x => x.DisplayOrder)
        .ThenBy(x => x.FieldId)
        .ToList();
    private int RequiredColumnsCount => OrderedColumns.Count(IsColumnRequired);
    private int ReadyRowsCount => OrderedRows.Count(IsReadyRow);
    private int PendingRowsCount => OrderedRows.Count - ReadyRowsCount;
    private int TotalParticipantDrafts => RowParticipantDrafts.Values.Sum(x => x.Count);
    private bool CanSubmit => Matrix is not null && OrderedRows.Any();

    protected override async Task OnParametersSetAsync()
    {
        var newSignature = BuildAllowedFieldSignature();
        if (string.IsNullOrWhiteSpace(newSignature) || string.Equals(CurrentFieldSignature, newSignature, StringComparison.Ordinal))
        {
            return;
        }

        CurrentFieldSignature = newSignature;
        await InitializeAsync();
    }

    private async Task InitializeAsync()
    {
        try
        {
            IsLoading = true;
            StatusTitle = string.Empty;
            StatusMessage = string.Empty;
            FieldOptions.Clear();

            ArticleFields = await LoadMatrixFieldsAsync("Article", "ArticleManualForm", AllowedArticleFieldIds);
            ParticipantFields = await LoadMatrixFieldsAsync("ArticleParticipant", "ArticleParticipantForm", AllowedParticipantFieldIds);

            if (!AllowedFieldIds.Any())
            {
                Matrix = null;
                return;
            }

            await LoadOrCreateDraftMatrixAsync();
            if (Matrix is not null && !Matrix.Rows.Any())
            {
                Matrix = await RegistrationMatrixClient.AddRowAsync(Matrix.Summary.RegistrationMatrixId) ?? Matrix;
            }

            await LoadParticipantDraftsAsync();
            await EnsureParticipantDraftsAsync();
            await EnsureSupportAsync();
        }
        catch (Exception ex)
        {
            ShowStatus("error", "No pude preparar la matriz del autor", UserFacingErrorMapper.FromException(ex, "Actualiza la pantalla e inténtalo nuevamente."));
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task LoadOrCreateDraftMatrixAsync()
    {
        var draft = await LocalStorage.GetItemAsync<AuthorMatrixDraftState>(DraftStorageKey);
        if (draft?.MatrixId is int storedMatrixId && string.Equals(draft.FieldSignature, CurrentFieldSignature, StringComparison.Ordinal))
        {
            try
            {
                var existing = await RegistrationMatrixClient.GetMatrixAsync(storedMatrixId);
                if (existing is not null && MatchesAllowedFields(existing))
                {
                    Matrix = existing;
                    return;
                }
            }
            catch
            {
            }
        }

        Matrix = await RegistrationMatrixClient.CreateMatrixAsync(new CreateRegistrationMatrixRequest
        {
            Name = MatrixName,
            EntityName = "Article",
            Notes = "Borrador automático del registro en masa para autores.",
            FieldIds = AllowedFieldIds.ToList()
        });

        if (Matrix is not null)
        {
            await PersistDraftStateAsync(Matrix.Summary.RegistrationMatrixId);
        }
    }

    private async Task<List<FieldCatalogItemDto>> LoadMatrixFieldsAsync(string entityName, string preferredFormKey, IReadOnlyList<int> allowedIds)
    {
        var allowed = allowedIds.Distinct().ToHashSet();
        var resolvedForm = await TryGetActiveFormAsync(entityName, preferredFormKey);
        if (resolvedForm is not null)
        {
            return resolvedForm.Sections
                .OrderBy(section => section.DisplayOrder)
                .SelectMany(section => section.Fields.OrderBy(field => field.DisplayOrder))
                .Where(field => allowed.Contains(field.FieldId))
                .Select(MapResolvedField)
                .ToList();
        }

        var fields = await FormConfigurationClient.GetFieldsAsync(entityName);
        return fields.Where(field => allowed.Contains(field.FieldId)).ToList();
    }

    private async Task<ResolvedFormDto?> TryGetActiveFormAsync(string entityName, string preferredFormKey)
    {
        try
        {
            return await FormConfigurationClient.GetActiveResolvedFormAsync(entityName, preferredFormKey);
        }
        catch
        {
            return null;
        }
    }

    private static FieldCatalogItemDto MapResolvedField(ResolvedFormFieldDto field)
        => new()
        {
            FieldId = field.FieldId,
            EntityName = field.EntityName,
            FieldKey = field.FieldKey,
            FieldLabel = field.FieldLabel,
            DataType = field.DataType,
            SourceType = field.SourceType,
            PhysicalTableName = field.PhysicalTableName,
            PhysicalColumnName = field.PhysicalColumnName,
            ReferenceTableName = field.ReferenceTableName,
            IsSystemField = field.IsSystemField,
            IsDynamic = field.IsDynamic,
            IsRequired = field.IsRequired,
            IsVisible = field.IsVisible,
            IsEditable = field.IsEditable,
            IsFilterable = field.IsFilterable,
            IsActive = field.IsActive,
            DisplayOrder = field.DisplayOrder,
            MaxLength = field.MaxLength,
            Placeholder = field.Placeholder,
            HelpText = field.HelpText,
            DefaultValue = field.DefaultValue,
            ValidationRule = field.ValidationRule
        };

    private async Task PersistDraftStateAsync(int matrixId)
    {
        await LocalStorage.SetItemAsync(DraftStorageKey, new AuthorMatrixDraftState
        {
            MatrixId = matrixId,
            FieldSignature = CurrentFieldSignature
        });
    }

    private bool MatchesAllowedFields(RegistrationMatrixDetailDto matrix)
        => matrix.Columns.OrderBy(x => x.DisplayOrder).Select(x => x.FieldId).SequenceEqual(AllowedFieldIds);

    private async Task ReloadMatrixAsync()
    {
        if (Matrix is null)
        {
            await InitializeAsync();
            return;
        }

        try
        {
            IsBusy = true;
            Matrix = await RegistrationMatrixClient.GetMatrixAsync(Matrix.Summary.RegistrationMatrixId);
            await EnsureSupportAsync();
        }
        catch (Exception ex)
        {
            ShowStatus("error", "No pude recargar la matriz", UserFacingErrorMapper.FromException(ex, "Actualiza la pantalla e inténtalo nuevamente."));
        }
        finally
        {
            IsBusy = false;
        }
    }

    private async Task AddRowAsync()
    {
        if (Matrix is null)
        {
            return;
        }

        try
        {
            IsBusy = true;
            Matrix = await RegistrationMatrixClient.AddRowAsync(Matrix.Summary.RegistrationMatrixId) ?? Matrix;
            await EnsureParticipantDraftsAsync();
            await EnsureSupportAsync();
        }
        catch (Exception ex)
        {
            ShowStatus("error", "No pude agregar la fila", UserFacingErrorMapper.FromException(ex, "Actualiza la matriz e inténtalo nuevamente."));
        }
        finally
        {
            IsBusy = false;
        }
    }

    private async Task DeleteRowAsync(int rowId)
    {
        if (Matrix is null)
        {
            return;
        }

        try
        {
            IsBusy = true;
            await RegistrationMatrixClient.DeleteRowAsync(Matrix.Summary.RegistrationMatrixId, rowId);
            Matrix = await RegistrationMatrixClient.GetMatrixAsync(Matrix.Summary.RegistrationMatrixId) ?? Matrix;
            RowParticipantDrafts.Remove(rowId);
            if (EditingParticipantsRowId == rowId)
            {
                EditingParticipantsRowId = null;
            }

            await PersistParticipantDraftsAsync();
            await EnsureSupportAsync();
        }
        catch (Exception ex)
        {
            ShowStatus("error", "No pude quitar la fila", UserFacingErrorMapper.FromException(ex, "Actualiza la matriz e inténtalo nuevamente."));
        }
        finally
        {
            IsBusy = false;
        }
    }

    private async Task LoadParticipantDraftsAsync()
    {
        RowParticipantDrafts = new();
        if (Matrix is null)
        {
            return;
        }

        var stored = await LocalStorage.GetItemAsync<List<MatrixRowParticipantsDraftState>>(ParticipantDraftStorageKey());
        if (stored is null)
        {
            return;
        }

        RowParticipantDrafts = stored
            .GroupBy(x => x.RowId)
            .ToDictionary(
                x => x.Key,
                x => x.First().Participants
                    .OrderBy(p => p.Index)
                    .Select((p, index) => NormalizeParticipantDraft(p, index + 1))
                    .ToList());
    }

    private async Task EnsureParticipantDraftsAsync()
    {
        if (Matrix is null)
        {
            return;
        }

        var changed = false;
        foreach (var row in OrderedRows)
        {
            if (!RowParticipantDrafts.TryGetValue(row.RegistrationMatrixRowId, out var participants) || participants.Count == 0)
            {
                RowParticipantDrafts[row.RegistrationMatrixRowId] = [CreateParticipantDraft(1)];
                changed = true;
                continue;
            }

            NormalizeParticipantIndexes(participants);
        }

        foreach (var rowId in RowParticipantDrafts.Keys.Where(rowId => OrderedRows.All(row => row.RegistrationMatrixRowId != rowId)).ToList())
        {
            RowParticipantDrafts.Remove(rowId);
            changed = true;
        }

        if (changed)
        {
            await PersistParticipantDraftsAsync();
        }
    }

    private async Task PersistParticipantDraftsAsync()
    {
        if (Matrix is null)
        {
            return;
        }

        var state = RowParticipantDrafts
            .OrderBy(x => OrderedRows.FirstOrDefault(row => row.RegistrationMatrixRowId == x.Key)?.RowNumber ?? int.MaxValue)
            .Select(x => new MatrixRowParticipantsDraftState
            {
                RowId = x.Key,
                Participants = x.Value
                    .OrderBy(p => p.Index)
                    .Select((p, index) => NormalizeParticipantDraft(p, index + 1))
                    .ToList()
            })
            .ToList();

        await LocalStorage.SetItemAsync(ParticipantDraftStorageKey(), state);
    }

    private void OpenParticipantEditor(int rowId)
    {
        EditingParticipantsRowId = rowId;
        if (!RowParticipantDrafts.ContainsKey(rowId))
        {
            RowParticipantDrafts[rowId] = [CreateParticipantDraft(1)];
        }
    }

    private Task CloseParticipantEditor()
    {
        EditingParticipantsRowId = null;
        return Task.CompletedTask;
    }

    private async Task AddParticipantAsync(int rowId)
    {
        var participants = GetParticipantDrafts(rowId);
        participants.Add(CreateParticipantDraft(participants.Count + 1));
        NormalizeParticipantIndexes(participants);
        await PersistParticipantDraftsAsync();
    }

    private async Task RemoveParticipantAsync(int rowId, string localId)
    {
        var participants = GetParticipantDrafts(rowId);
        if (participants.Count <= 1)
        {
            return;
        }

        participants.RemoveAll(x => x.LocalId == localId);
        NormalizeParticipantIndexes(participants);
        await PersistParticipantDraftsAsync();
    }

    private async Task UpdateParticipantCellAsync(int rowId, string localId, int fieldId, string? rawValue)
    {
        var participants = GetParticipantDrafts(rowId);
        var participant = participants.FirstOrDefault(x => x.LocalId == localId);
        if (participant is null)
        {
            return;
        }

        var cleaned = NormalizeRawValue(rawValue);
        if (string.IsNullOrWhiteSpace(cleaned))
        {
            participant.Cells.Remove(fieldId);
        }
        else
        {
            participant.Cells[fieldId] = cleaned;
        }

        await PersistParticipantDraftsAsync();
    }

    private List<MatrixParticipantDraft> GetParticipantDrafts(int rowId)
    {
        if (!RowParticipantDrafts.TryGetValue(rowId, out var participants) || participants.Count == 0)
        {
            participants = [CreateParticipantDraft(1)];
            RowParticipantDrafts[rowId] = participants;
        }

        return participants;
    }

    private MatrixParticipantDraft CreateParticipantDraft(int index)
    {
        var draft = new MatrixParticipantDraft
        {
            Index = index,
            LocalId = Guid.NewGuid().ToString("N")
        };

        SetDefaultParticipantValue(draft, "Index", index.ToString());
        SetDefaultParticipantValue(draft, "Participacion", index == 1 ? "Autor" : "Coautor");
        SetDefaultParticipantValue(draft, "ParticipantType", "Docente");
        SetDefaultParticipantValue(draft, "IsPrimaryAuthor", index == 1 ? "true" : "false");
        return draft;
    }

    private MatrixParticipantDraft NormalizeParticipantDraft(MatrixParticipantDraft draft, int index)
    {
        draft.LocalId = string.IsNullOrWhiteSpace(draft.LocalId) ? Guid.NewGuid().ToString("N") : draft.LocalId;
        draft.Index = index;
        SetDefaultParticipantValue(draft, "Index", index.ToString());
        SetDefaultParticipantValue(draft, "Participacion", index == 1 ? "Autor" : "Coautor", overwriteEmptyOnly: true);
        SetDefaultParticipantValue(draft, "ParticipantType", "Docente", overwriteEmptyOnly: true);
        SetDefaultParticipantValue(draft, "IsPrimaryAuthor", index == 1 ? "true" : "false");
        return draft;
    }

    private void NormalizeParticipantIndexes(List<MatrixParticipantDraft> participants)
    {
        for (var index = 0; index < participants.Count; index++)
        {
            NormalizeParticipantDraft(participants[index], index + 1);
        }
    }

    private void SetDefaultParticipantValue(MatrixParticipantDraft draft, string fieldKey, string value, bool overwriteEmptyOnly = false)
    {
        var field = ParticipantFields.FirstOrDefault(x => x.FieldKey.Equals(fieldKey, StringComparison.OrdinalIgnoreCase));
        if (field is null)
        {
            return;
        }

        if (overwriteEmptyOnly && draft.Cells.TryGetValue(field.FieldId, out var existing) && !string.IsNullOrWhiteSpace(existing))
        {
            return;
        }

        draft.Cells[field.FieldId] = value;
    }

    private async Task UpdateCellAsync(int rowId, int fieldId, string? rawValue, FieldCatalogItemDto? field)
    {
        if (Matrix is null)
        {
            return;
        }

        try
        {
            IsBusy = true;
            Matrix = await RegistrationMatrixClient.UpdateCellAsync(Matrix.Summary.RegistrationMatrixId, rowId, new UpdateRegistrationMatrixCellRequest
            {
                FieldId = fieldId,
                RawValue = NormalizeRawValue(rawValue)
            }) ?? Matrix;

            if (field is not null)
            {
                await ClearDependentValuesAsync(rowId, field);
            }

            await EnsureSupportAsync();
        }
        catch (Exception ex)
        {
            ShowStatus("error", "No pude actualizar la celda", UserFacingErrorMapper.FromException(ex, "Revisa el valor ingresado."));
        }
        finally
        {
            IsBusy = false;
        }
    }

    private async Task ClearDependentValuesAsync(int rowId, FieldCatalogItemDto field)
    {
        if (field.FieldKey.Equals("BroadFieldId", StringComparison.OrdinalIgnoreCase))
        {
            await ClearFieldValueIfExistsAsync(rowId, "SpecificFieldId");
            await ClearFieldValueIfExistsAsync(rowId, "DetailedFieldId");
        }
        else if (field.FieldKey.Equals("SpecificFieldId", StringComparison.OrdinalIgnoreCase))
        {
            await ClearFieldValueIfExistsAsync(rowId, "DetailedFieldId");
        }
    }

    private async Task ClearFieldValueIfExistsAsync(int rowId, string fieldKey)
    {
        if (Matrix is null)
        {
            return;
        }

        var related = GetFieldByKey(fieldKey);
        var currentValue = related is null ? null : Matrix.Rows.FirstOrDefault(x => x.RegistrationMatrixRowId == rowId)?.Cells.FirstOrDefault(x => x.FieldId == related.FieldId)?.RawValue;
        if (related is null || string.IsNullOrWhiteSpace(currentValue))
        {
            return;
        }

        Matrix = await RegistrationMatrixClient.UpdateCellAsync(Matrix.Summary.RegistrationMatrixId, rowId, new UpdateRegistrationMatrixCellRequest
        {
            FieldId = related.FieldId,
            RawValue = null
        }) ?? Matrix;
    }

    private void OpenSubmitConfirm()
    {
        if (!CanSubmit || IsBusy || IsSubmittingReview)
        {
            return;
        }

        HasAttemptedSubmit = true;
        var validationIssues = GetMatrixValidationIssues().Take(8).ToList();
        if (validationIssues.Count > 0)
        {
            var listed = string.Join(", ", validationIssues);
            ShowStatus("error", "Revisa la matriz", $"Hay campos pendientes o con información inválida antes de enviar. Observaciones detectadas: {listed}.");
            return;
        }

        var optionalIssues = GetMissingOptionalCells().Take(8).ToList();
        SubmitConfirmMessage = optionalIssues.Count > 0
            ? $"Los campos obligatorios están completos, pero hay campos opcionales sin información: {string.Join(", ", optionalIssues)}. Puedes seguir completándolos o enviar la matriz a revisión de todas formas."
            : "Se generará el staging institucional para todos los registros de esta matriz. Mientras se realiza el envío no podrás seguir editando la hoja.";
        IsSubmitConfirmOpen = true;
    }

    private Task CloseSubmitConfirmAsync()
    {
        IsSubmitConfirmOpen = false;
        SubmitConfirmMessage = "Se generará el staging institucional para todos los registros listos de esta matriz. Mientras se realiza el envío no podrás seguir editando la hoja.";
        return Task.CompletedTask;
    }

    private async Task ConfirmSubmitAsync()
    {
        IsSubmitConfirmOpen = false;
        await SubmitAsync();
    }

    private async Task SubmitAsync()
    {
        if (Matrix is null)
        {
            return;
        }

        try
        {
            IsSubmittingReview = true;
            var result = await RegistrationMatrixClient.SubmitToStagingAsync(Matrix.Summary.RegistrationMatrixId, new SubmitRegistrationMatrixRequest
            {
                ValidateAfterCreate = true,
                UseAuthorWorkflow = true,
                RowParticipants = BuildParticipantPayload()
            });

            if (result?.BatchResult?.Batch?.Summary is null)
            {
                ShowStatus("warning", "Revisa este punto", "La matriz se envió, pero no recibí el lote de revisión esperado.");
                return;
            }

            await LocalStorage.RemoveItemAsync(DraftStorageKey);
            await LocalStorage.RemoveItemAsync(ParticipantDraftStorageKey());
            HasAttemptedSubmit = false;
            await InitializeAsync();

            var message = $"Los artículos se enviaron a revisión correctamente. Se creó el lote {result.BatchResult.Batch.Summary.BatchCode} para staging institucional.";
            ShowStatus("success", "Registro en masa enviado", message);

            if (OnSubmitted.HasDelegate)
            {
                await OnSubmitted.InvokeAsync(message);
            }
        }
        catch (Exception ex)
        {
            ShowStatus("error", "No pude enviar la matriz a revisión", UserFacingErrorMapper.FromException(ex, "Revisa las filas marcadas y vuelve a enviar."));
        }
        finally
        {
            IsSubmittingReview = false;
        }
    }

    private async Task EnsureSupportAsync()
    {
        if (Matrix is null)
        {
            return;
        }

        foreach (var column in Matrix.Columns)
        {
            var field = GetFieldById(column.FieldId);
            if (field is null)
            {
                continue;
            }

            if (field.IsDynamic)
            {
                await EnsureOptionsAsync(field, null);
                continue;
            }

            if (!LooksCatalog(field))
            {
                continue;
            }

            if (!IsHierarchicalCatalog(field))
            {
                await EnsureOptionsAsync(field, null);
                continue;
            }

            foreach (var row in Matrix.Rows)
            {
                await EnsureOptionsAsync(field, GetParentCatalogId(field, row));
            }
        }
    }

    private async Task EnsureOptionsAsync(FieldCatalogItemDto field, int? parentId)
    {
        var key = new OptionCacheKey(field.FieldId, parentId);
        if (FieldOptions.ContainsKey(key))
        {
            return;
        }

        if (field.IsDynamic)
        {
            var options = await FormConfigurationClient.GetFieldOptionsAsync(field.FieldId);
            FieldOptions[key] = options.Where(x => x.IsActive).OrderBy(x => x.DisplayOrder).Select(x => new OptionItem(x.OptionValue, x.OptionLabel)).ToList();
            return;
        }

        if (LooksCatalog(field))
        {
            try
            {
                var options = await FormConfigurationClient.GetCatalogItemsByFieldAsync(field.FieldId, parentId);
                FieldOptions[key] = options.OrderBy(x => x.Name).Select(x => new OptionItem(x.Id.ToString(), x.Name)).ToList();
            }
            catch
            {
                FieldOptions[key] = [];
            }
            return;
        }

        FieldOptions[key] = [];
    }

    private FieldCatalogItemDto? GetFieldById(int id) => ArticleFields.Concat(ParticipantFields).FirstOrDefault(x => x.FieldId == id);
    private FieldCatalogItemDto? GetFieldByKey(string key) => ArticleFields.Concat(ParticipantFields).FirstOrDefault(x => x.FieldKey.Equals(key, StringComparison.OrdinalIgnoreCase));
    private string GetCellValue(RegistrationMatrixRowDto row, int fieldId) => row.Cells.FirstOrDefault(x => x.FieldId == fieldId)?.RawValue ?? string.Empty;
    private bool HasOptionsForRow(FieldCatalogItemDto field, RegistrationMatrixRowDto row) => GetOptionsForRow(field, row).Any();

    private IEnumerable<OptionItem> GetOptionsForRow(FieldCatalogItemDto field, RegistrationMatrixRowDto row)
    {
        var key = new OptionCacheKey(field.FieldId, GetParentCatalogId(field, row));
        return FieldOptions.TryGetValue(key, out var options) ? options : Enumerable.Empty<OptionItem>();
    }

    private int? GetParentCatalogId(FieldCatalogItemDto field, RegistrationMatrixRowDto row)
    {
        if (field.FieldKey.Equals("SpecificFieldId", StringComparison.OrdinalIgnoreCase))
        {
            return TryGetRelatedFieldValue(row, "BroadFieldId");
        }

        if (field.FieldKey.Equals("DetailedFieldId", StringComparison.OrdinalIgnoreCase))
        {
            return TryGetRelatedFieldValue(row, "SpecificFieldId");
        }

        return null;
    }

    private int? TryGetRelatedFieldValue(RegistrationMatrixRowDto row, string fieldKey)
    {
        var relatedField = GetFieldByKey(fieldKey);
        if (relatedField is null)
        {
            return null;
        }

        var raw = GetCellValue(row, relatedField.FieldId);
        return int.TryParse(raw, out var value) ? value : null;
    }

    private bool IsReadyRow(RegistrationMatrixRowDto row)
    {
        var requiredColumns = OrderedColumns.Where(IsColumnRequired).ToList();
        return (requiredColumns.Count == 0 || requiredColumns.All(column => !string.IsNullOrWhiteSpace(GetCellValue(row, column.FieldId))))
            && !GetRowValidationIssues(row).Any();
    }

    private IEnumerable<string> GetMissingRequiredCells()
    {
        foreach (var row in OrderedRows)
        {
            foreach (var column in OrderedColumns.Where(IsColumnRequired))
            {
                if (string.IsNullOrWhiteSpace(GetCellValue(row, column.FieldId)))
                {
                    yield return $"Fila {row.RowNumber}: {column.FieldLabel}";
                }
            }
        }
    }

    private IEnumerable<string> GetMissingOptionalCells()
    {
        foreach (var row in OrderedRows)
        {
            foreach (var column in OrderedColumns.Where(x => !IsColumnRequired(x)))
            {
                var field = GetFieldById(column.FieldId);
                if (field is null || IsLowSignalOptionalField(field))
                {
                    continue;
                }

                if (string.IsNullOrWhiteSpace(GetCellValue(row, column.FieldId)))
                {
                    yield return $"Fila {row.RowNumber}: {column.FieldLabel}";
                }
            }
        }
    }

    private IEnumerable<string> GetMissingRequiredParticipantCells()
    {
        var requiredParticipantFields = VisibleParticipantFields.Where(x => x.IsRequired).ToList();
        foreach (var row in OrderedRows)
        {
            var participants = GetParticipantDrafts(row.RegistrationMatrixRowId);
            if (participants.Count == 0)
            {
                yield return $"Fila {row.RowNumber}: al menos un participante";
                continue;
            }

            foreach (var participant in participants)
            {
                foreach (var field in requiredParticipantFields)
                {
                    if (IsIndexField(field))
                    {
                        continue;
                    }

                    if (string.IsNullOrWhiteSpace(GetParticipantCellValue(participant, field.FieldId)))
                    {
                        yield return $"Fila {row.RowNumber}, participante {participant.Index}: {field.FieldLabel}";
                    }
                }
            }
        }
    }

    private IEnumerable<string> GetMatrixValidationIssues()
    {
        foreach (var row in OrderedRows)
        {
            foreach (var issue in GetRowValidationIssues(row))
            {
                yield return issue;
            }
        }
    }

    private IEnumerable<string> GetRowValidationIssues(RegistrationMatrixRowDto row)
    {
        foreach (var column in OrderedColumns)
        {
            var field = GetFieldById(column.FieldId);
            if (field is null)
            {
                continue;
            }

            var message = ValidateMatrixField(field, GetCellValue(row, column.FieldId));
            if (!string.IsNullOrWhiteSpace(message))
            {
                yield return $"Fila {row.RowNumber}: {message}";
            }
        }

        var participants = GetParticipantDrafts(row.RegistrationMatrixRowId);
        if (participants.Count == 0)
        {
            yield return $"Fila {row.RowNumber}: debe registrar al menos un participante";
            yield break;
        }

        foreach (var participant in participants)
        {
            foreach (var field in VisibleParticipantFields)
            {
                if (IsIndexField(field))
                {
                    continue;
                }

                var message = ValidateMatrixField(field, GetParticipantCellValue(participant, field.FieldId));
                if (!string.IsNullOrWhiteSpace(message))
                {
                    yield return $"Fila {row.RowNumber}, participante {participant.Index}: {message}";
                }
            }
        }
    }

    private List<RegistrationMatrixRowParticipantDto> BuildParticipantPayload()
        => OrderedRows
            .Select(row => new RegistrationMatrixRowParticipantDto
            {
                RegistrationMatrixRowId = row.RegistrationMatrixRowId,
                Participants = GetParticipantDrafts(row.RegistrationMatrixRowId)
                    .OrderBy(x => x.Index)
                    .Select(participant => new RegistrationMatrixParticipantDto
                    {
                        Index = participant.Index,
                        Cells = BuildParticipantCells(participant)
                    })
                    .ToList()
            })
            .ToList();

    private List<RegistrationMatrixCellDto> BuildParticipantCells(MatrixParticipantDraft participant)
    {
        var cells = participant.Cells
            .Where(x => !string.IsNullOrWhiteSpace(x.Value))
            .Select(x => new RegistrationMatrixCellDto { FieldId = x.Key, RawValue = x.Value })
            .ToList();

        foreach (var field in VisibleParticipantFields)
        {
            if (IsIndexField(field) && cells.All(x => x.FieldId != field.FieldId))
            {
                cells.Add(new RegistrationMatrixCellDto { FieldId = field.FieldId, RawValue = participant.Index.ToString() });
            }
        }

        return cells;
    }

    private string GetRowStatusLabel(RegistrationMatrixRowDto row)
    {
        var requiredColumns = OrderedColumns.Where(IsColumnRequired).ToList();
        if (requiredColumns.Count == 0)
        {
            return "Lista";
        }

        var completedRequired = requiredColumns.Count(column => !string.IsNullOrWhiteSpace(GetCellValue(row, column.FieldId)));
        if (completedRequired == 0)
        {
            return "Vacía";
        }

        return completedRequired == requiredColumns.Count ? "Lista" : $"{completedRequired}/{requiredColumns.Count}";
    }

    private string GetRowStatusClass(RegistrationMatrixRowDto row)
        => GetRowStatusLabel(row) switch
        {
            "Lista" => "rounded-full bg-emerald-100 px-2 py-0.5 text-[10px] font-semibold text-emerald-700",
            "Vacía" => "rounded-full bg-slate-100 px-2 py-0.5 text-[10px] font-semibold text-slate-600",
            _ => "rounded-full bg-amber-100 px-2 py-0.5 text-[10px] font-semibold text-amber-700"
        };

    private string GetSupport(FieldCatalogItemDto field, RegistrationMatrixRowDto row)
    {
        if (!string.IsNullOrWhiteSpace(field.HelpText))
        {
            return field.HelpText!;
        }

        if (field.FieldKey.Equals("SpecificFieldId", StringComparison.OrdinalIgnoreCase))
        {
            return TryGetRelatedFieldValue(row, "BroadFieldId").HasValue ? "Se filtra según el campo amplio seleccionado en esta fila." : "Primero selecciona un campo amplio para habilitar esta lista.";
        }

        if (field.FieldKey.Equals("DetailedFieldId", StringComparison.OrdinalIgnoreCase))
        {
            return TryGetRelatedFieldValue(row, "SpecificFieldId").HasValue ? "Se filtra según el campo específico seleccionado en esta fila." : "Primero selecciona un campo específico para habilitar esta lista.";
        }

        if (field.IsDynamic)
        {
            return "Opciones dinámicas activas.";
        }

        return LooksCatalog(field) ? "Catálogo disponible para ayudarte a registrar." : string.Empty;
    }

    private bool ShowSupport(FieldCatalogItemDto field, RegistrationMatrixRowDto row) => !string.IsNullOrWhiteSpace(GetSupport(field, row));
    private bool IsColumnRequired(RegistrationMatrixColumnDto column) => GetFieldById(column.FieldId)?.IsRequired ?? column.IsRequired;

    private string GetParticipantCellValue(MatrixParticipantDraft participant, int fieldId)
        => participant.Cells.TryGetValue(fieldId, out var value) ? value : string.Empty;

    private string GetParticipantSummary(MatrixParticipantDraft participant)
    {
        var nameField = ParticipantFields.FirstOrDefault(x => x.FieldKey.Equals("Nombre", StringComparison.OrdinalIgnoreCase));
        var participationField = ParticipantFields.FirstOrDefault(x => x.FieldKey.Equals("Participacion", StringComparison.OrdinalIgnoreCase));
        var name = nameField is null ? string.Empty : GetParticipantCellValue(participant, nameField.FieldId);
        var participation = participationField is null ? string.Empty : GetParticipantCellValue(participant, participationField.FieldId);
        return string.IsNullOrWhiteSpace(name)
            ? $"Sin nombre · {participation}"
            : $"{name} · {participation}";
    }

    private string? GetCellValidationMessage(RegistrationMatrixColumnDto column, RegistrationMatrixRowDto row)
    {
        if (!HasAttemptedSubmit)
        {
            return null;
        }

        var field = GetFieldById(column.FieldId);
        return field is null ? null : ValidateMatrixField(field, GetCellValue(row, column.FieldId));
    }

    private string? GetParticipantValidationMessage(FieldCatalogItemDto field, MatrixParticipantDraft participant)
        => HasAttemptedSubmit && !IsIndexField(field)
            ? ValidateMatrixField(field, GetParticipantCellValue(participant, field.FieldId))
            : null;

    private static string? ValidateMatrixField(FieldCatalogItemDto field, string? rawValue)
    {
        var cleaned = string.IsNullOrWhiteSpace(rawValue) ? null : rawValue.Trim();
        var validationMessage = DynamicFieldValidationEngine.Validate(
            field.FieldLabel,
            field.DataType,
            field.IsRequired,
            GetEffectiveMaxLength(field),
            field.ValidationRule,
            new DynamicFieldValidationValue { Text = cleaned });

        if (!string.IsNullOrWhiteSpace(validationMessage))
        {
            return validationMessage;
        }

        if (string.IsNullOrWhiteSpace(cleaned))
        {
            return null;
        }

        if (IsPageCountField(field)
            && int.TryParse(cleaned, out var pageCount)
            && pageCount > 1000)
        {
            return "Numero de paginas no debe superar 1000.";
        }

        if (IsQuartileField(field) && !GetFixedOptions(field).Any(x => x.Value.Equals(cleaned, StringComparison.OrdinalIgnoreCase)))
        {
            return "Cuartil debe ser Q1, Q2, Q3 o Q4.";
        }

        if (IsParticipationField(field) && !GetFixedOptions(field).Any(x => x.Value.Equals(cleaned, StringComparison.OrdinalIgnoreCase)))
        {
            return "Participacion debe ser Autor o Coautor.";
        }

        if (IsParticipantTypeField(field) && !GetFixedOptions(field).Any(x => x.Value.Equals(cleaned, StringComparison.OrdinalIgnoreCase)))
        {
            return "Tipo de participante debe ser Docente, Estudiante, Externo u Otro.";
        }

        if (IsIdentificationField(field) && !System.Text.RegularExpressions.Regex.IsMatch(cleaned, @"^\d{10}$"))
        {
            return "Identificacion debe contener exactamente 10 numeros.";
        }

        return null;
    }

    private string GetParticipantFieldClass(FieldCatalogItemDto field, MatrixParticipantDraft participant)
    {
        var baseClass = "block rounded-2xl border bg-white/70 p-3 transition";
        if (!HasAttemptedSubmit)
        {
            return $"{baseClass} border-slate-100";
        }

        if (!string.IsNullOrWhiteSpace(GetParticipantValidationMessage(field, participant)))
        {
            return $"{baseClass} border-rose-300 bg-rose-50";
        }

        return $"{baseClass} border-slate-100";
    }

    private string GetCellContainerClass(RegistrationMatrixColumnDto column, RegistrationMatrixRowDto row)
    {
        var baseClass = "border px-3 py-3 align-top transition";
        if (!HasAttemptedSubmit)
        {
            return $"{baseClass} border-[var(--app-border-subtle)]";
        }

        var isEmpty = string.IsNullOrWhiteSpace(GetCellValue(row, column.FieldId));
        var field = GetFieldById(column.FieldId);
        if (!string.IsNullOrWhiteSpace(GetCellValidationMessage(column, row)))
        {
            return $"{baseClass} border-rose-300 bg-rose-50";
        }

        if (!IsColumnRequired(column) && isEmpty && field is not null && !IsLowSignalOptionalField(field))
        {
            return $"{baseClass} border-amber-300 bg-amber-50";
        }

        return $"{baseClass} border-[var(--app-border-subtle)]";
    }

    private static bool LooksCatalog(FieldCatalogItemDto field) => !string.IsNullOrWhiteSpace(field.ReferenceTableName) || field.SourceType.Equals("Catalog", StringComparison.OrdinalIgnoreCase) || field.FieldKey.EndsWith("Id", StringComparison.OrdinalIgnoreCase);
    private static bool IsHierarchicalCatalog(FieldCatalogItemDto field) => field.FieldKey is "SpecificFieldId" or "DetailedFieldId";
    private static bool IsBooleanField(FieldCatalogItemDto field) => field.DataType.Contains("bool", StringComparison.OrdinalIgnoreCase) || field.DataType.Contains("bit", StringComparison.OrdinalIgnoreCase);
    private static bool IsLowSignalOptionalField(FieldCatalogItemDto field)
        => IsBooleanField(field)
           || field.FieldKey.Equals("ExternalSource", StringComparison.OrdinalIgnoreCase)
           || field.FieldKey.Equals("ExternalId", StringComparison.OrdinalIgnoreCase)
           || field.FieldKey.Equals("InstitutionalPersonId", StringComparison.OrdinalIgnoreCase);
    private static bool IsNumericField(FieldCatalogItemDto field) => field.DataType.Contains("int", StringComparison.OrdinalIgnoreCase) || field.DataType.Contains("decimal", StringComparison.OrdinalIgnoreCase) || field.DataType.Contains("number", StringComparison.OrdinalIgnoreCase) || field.DataType.Contains("double", StringComparison.OrdinalIgnoreCase) || field.DataType.Contains("float", StringComparison.OrdinalIgnoreCase);
    private static string GetInputType(FieldCatalogItemDto field) => field.DataType.Contains("datetime", StringComparison.OrdinalIgnoreCase) ? "datetime-local" : field.DataType.Contains("date", StringComparison.OrdinalIgnoreCase) ? "date" : IsNumericField(field) ? "number" : "text";
    private static string? GetInputStep(FieldCatalogItemDto field) => field.DataType.Contains("decimal", StringComparison.OrdinalIgnoreCase) || field.DataType.Contains("double", StringComparison.OrdinalIgnoreCase) || field.DataType.Contains("float", StringComparison.OrdinalIgnoreCase) ? "0.01" : IsNumericField(field) ? "1" : null;
    private static string? GetInputMin(FieldCatalogItemDto field) => IsNumericField(field) ? "0" : null;
    private static string? GetInputMax(FieldCatalogItemDto field) => field.DataType.Contains("datetime", StringComparison.OrdinalIgnoreCase)
        ? DateTime.Now.ToString("yyyy-MM-ddTHH:mm", System.Globalization.CultureInfo.InvariantCulture)
        : field.DataType.Contains("date", StringComparison.OrdinalIgnoreCase)
            ? DateTime.Today.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)
            : field.FieldKey.Equals("PageCount", StringComparison.OrdinalIgnoreCase) ? "1000" : null;
    private static int? GetInputMaxLength(FieldCatalogItemDto field) => IsNumericField(field) ? null : GetEffectiveMaxLength(field);
    private static int GetEffectiveMaxLength(FieldCatalogItemDto field)
    {
        if (IsIdentificationField(field))
        {
            return 10;
        }

        if (field.MaxLength is > 0 and var configured)
        {
            return configured;
        }

        if (field.FieldKey.Contains("doi", StringComparison.OrdinalIgnoreCase))
        {
            return 20;
        }

        if (field.FieldKey.Contains("email", StringComparison.OrdinalIgnoreCase))
        {
            return 30;
        }

        if (field.FieldKey.Contains("nombre", StringComparison.OrdinalIgnoreCase) || field.FieldKey.Contains("name", StringComparison.OrdinalIgnoreCase))
        {
            return 200;
        }

        return 1000;
    }
    private static string GetPlaceholder(FieldCatalogItemDto field) => !string.IsNullOrWhiteSpace(field.Placeholder) ? field.Placeholder! : field.IsRequired ? "Campo obligatorio" : "Registrar valor";
    private string GetColumnLegend(RegistrationMatrixColumnDto column) => $"{(column.EntityName == "ArticleParticipant" ? "Participante" : "Artículo")}{(IsColumnRequired(column) ? " · Obligatorio" : "")}{(column.IsDynamic ? " · Dinámico" : "")}";
    private static bool HasFixedOptions(FieldCatalogItemDto field) => IsQuartileField(field) || IsParticipationField(field) || IsParticipantTypeField(field);
    private static bool IsQuartileField(FieldCatalogItemDto field) => field.FieldKey.Equals("Quartile", StringComparison.OrdinalIgnoreCase);
    private static bool IsPageCountField(FieldCatalogItemDto field) => field.FieldKey.Equals("PageCount", StringComparison.OrdinalIgnoreCase);
    private static bool IsParticipationField(FieldCatalogItemDto field) => field.FieldKey.Equals("Participacion", StringComparison.OrdinalIgnoreCase);
    private static bool IsParticipantTypeField(FieldCatalogItemDto field) => field.FieldKey.Equals("ParticipantType", StringComparison.OrdinalIgnoreCase);
    private static bool IsIdentificationField(FieldCatalogItemDto field) => field.FieldKey.Equals("Identificacion", StringComparison.OrdinalIgnoreCase);
    private static bool IsIndexField(FieldCatalogItemDto field) => field.FieldKey.Equals("Index", StringComparison.OrdinalIgnoreCase);
    private static IReadOnlyList<OptionItem> GetFixedOptions(FieldCatalogItemDto field)
        => IsQuartileField(field)
            ? [new("Q1", "Q1"), new("Q2", "Q2"), new("Q3", "Q3"), new("Q4", "Q4")]
            : IsParticipationField(field)
                ? [new("Autor", "Autor"), new("Coautor", "Coautor")]
                : IsParticipantTypeField(field)
                    ? [new("Docente", "Docente"), new("Estudiante", "Estudiante"), new("Externo", "Externo"), new("Otro", "Otro")]
                    : [];

    private static string GetMatrixStatusClass(RegistrationMatrixSummaryDto matrix)
        => matrix.Status.Contains("Processed", StringComparison.OrdinalIgnoreCase)
            ? "rounded-full bg-emerald-100 px-3 py-1.5 text-xs font-semibold text-emerald-700"
            : matrix.Status.Contains("Staging", StringComparison.OrdinalIgnoreCase) || matrix.LastImportBatchId.HasValue
                ? "rounded-full bg-amber-100 px-3 py-1.5 text-xs font-semibold text-amber-700"
                : "rounded-full bg-slate-100 px-3 py-1.5 text-xs font-semibold text-slate-600";

    private static string GetMatrixStatusLabel(RegistrationMatrixSummaryDto matrix)
        => matrix.Status.Contains("Processed", StringComparison.OrdinalIgnoreCase) ? "Procesada"
         : matrix.Status.Contains("Staging", StringComparison.OrdinalIgnoreCase) || matrix.LastImportBatchId.HasValue ? "En revisión"
         : "Borrador";

    private static string? NormalizeRawValue(string? rawValue) => string.IsNullOrWhiteSpace(rawValue) ? null : rawValue.Trim();
    private string BuildAllowedFieldSignature() => $"{string.Join("|", AllowedFieldIds)}::participants::{string.Join("|", AllowedParticipantFieldIds.Distinct())}";
    private string ParticipantDraftStorageKey() => Matrix is null ? $"{DraftStorageKey}.participants" : $"{DraftStorageKey}.participants.{Matrix.Summary.RegistrationMatrixId}";

    private void ShowStatus(string variant, string title, string message)
    {
        StatusVariant = variant;
        StatusTitle = title;
        StatusMessage = message;
    }

    private Task CloseStatusModal()
    {
        StatusTitle = string.Empty;
        StatusMessage = string.Empty;
        return Task.CompletedTask;
    }

    private sealed class AuthorMatrixDraftState
    {
        public int MatrixId { get; set; }
        public string? FieldSignature { get; set; }
    }

    private sealed class MatrixRowParticipantsDraftState
    {
        public int RowId { get; set; }
        public List<MatrixParticipantDraft> Participants { get; set; } = [];
    }

    private sealed class MatrixParticipantDraft
    {
        public string LocalId { get; set; } = Guid.NewGuid().ToString("N");
        public int Index { get; set; }
        public Dictionary<int, string> Cells { get; set; } = new();
    }

    private sealed record OptionItem(string Value, string Label);
    private sealed record OptionCacheKey(int FieldId, int? ParentId);
}
