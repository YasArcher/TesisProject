@using System.IO
@using tesisproject.shared.DTOs.Imports

<div class="rounded-[1.45rem] border border-[#d9e5e8] bg-white p-3.5 shadow-sm">
    <div class="mb-3 flex items-center justify-between gap-3">
        <h2 class="text-base font-black text-[#12343b] md:text-lg">3. Lotes recientes</h2>
        <button class="rounded-xl border border-[#c7d6da] bg-white px-4 py-2 text-sm font-semibold text-[#12343b]" @onclick="OnRefresh">Actualizar</button>
    </div>

    <div class="mb-3 grid grid-cols-1 gap-3 lg:grid-cols-[1fr_1fr_0.9fr]">
        <InputDate TValue="DateTime?" class="rounded-xl border border-[#c9d7db] bg-[#f7fafb] px-3 py-2 text-sm" @bind-Value="FromDate" />
        <InputDate TValue="DateTime?" class="rounded-xl border border-[#c9d7db] bg-[#f7fafb] px-3 py-2 text-sm" @bind-Value="ToDate" />
        <div class="rounded-2xl border border-[#d9e5e8] bg-[#f8fbfc] px-4 py-2.5">
            <div class="text-[11px] uppercase tracking-wide text-slate-500">Tarjetas por página</div>
            <input type="range" min="4" max="12" step="2" class="mt-2 w-full accent-[#12343b]" @bind="PageSize" />
            <div class="mt-1 text-xs font-semibold text-[#12343b]">@PageSize visibles</div>
        </div>
    </div>

    @if (!FilteredBatches.Any())
    {
        <AppEmptyState Title="No hay lotes que coincidan con el filtro" Message="Ajusta las fechas o limpia el filtro para volver a ver el historial reciente." />
    }
    else
    {
        <div class="mb-3 flex items-center justify-between gap-3 rounded-2xl bg-[#f8fbfc] px-4 py-3 text-sm text-slate-600">
            <div>Mostrando <span class="font-bold text-[#12343b]">@PagedBatches.Count</span> de <span class="font-bold text-[#12343b]">@FilteredBatches.Count</span> lotes filtrados.</div>
            <div>Página <span class="font-bold text-[#12343b]">@NormalizedPage</span> / <span class="font-bold text-[#12343b]">@TotalPages</span></div>
        </div>
        <div class="grid grid-cols-1 gap-3 lg:grid-cols-2">
            @foreach (var batch in PagedBatches)
            {
                <button class="rounded-3xl border border-[#d9e5e8] bg-[#f8fbfc] p-3.5 text-left transition hover:border-[#8cb0b8] hover:shadow-sm" @onclick="() => OnOpenBatch.InvokeAsync(batch.ImportBatchId)">
                    <div class="flex items-start justify-between gap-3">
                        <div>
                            <div class="font-semibold text-[#12343b]">@GetBatchCardTitle(batch)</div>
                            <div class="mt-1 text-xs text-slate-500">Código: @batch.BatchCode</div>
                        </div>
                        <span class="rounded-full bg-white px-3 py-1 text-xs font-semibold text-[#2f4858]">@batch.Status</span>
                    </div>
                    <div class="mt-3 grid grid-cols-3 gap-2 text-xs text-slate-500">
                        <div>Total: <span class="font-semibold text-slate-700">@batch.TotalRows</span></div>
                        <div>Errores: <span class="font-semibold text-rose-700">@batch.ErrorRows</span></div>
                        <div>Procesadas: <span class="font-semibold text-emerald-700">@batch.ProcessedRows</span></div>
                    </div>
                    <div class="mt-3 grid grid-cols-1 gap-1 text-xs text-slate-500">
                        <div>Ingresado: <span class="font-semibold text-slate-700">@FormatBatchDate(batch.StartedAt)</span></div>
                        <div>Estado actual: <span class="font-semibold text-slate-700">@GetFriendlyBatchStatus(batch)</span></div>
                        <div>Última actividad: <span class="font-semibold text-slate-700">@GetLastActivityDate(batch)</span></div>
                    </div>
                </button>
            }
        </div>
        <div class="mt-3 flex flex-wrap items-center justify-between gap-3">
            <button class="rounded-xl border border-[#c7d6da] bg-white px-3 py-2 text-sm font-semibold text-[#12343b] disabled:opacity-50" disabled="@(NormalizedPage <= 1)" @onclick="GoPrevious">Anterior</button>
            <button class="rounded-xl border border-[#c7d6da] bg-white px-3 py-2 text-sm font-semibold text-[#12343b] disabled:opacity-50" disabled="@(NormalizedPage >= TotalPages)" @onclick="GoNext">Siguiente</button>
        </div>
    }
</div>

@code {
    [Parameter] public IReadOnlyList<BulkImportBatchSummaryDto> Batches { get; set; } = new List<BulkImportBatchSummaryDto>();
    [Parameter] public EventCallback OnRefresh { get; set; }
    [Parameter] public EventCallback<int> OnOpenBatch { get; set; }

    private DateTime? FromDate { get; set; }
    private DateTime? ToDate { get; set; }
    private int PageSize { get; set; } = 6;
    private int Page { get; set; } = 1;

    private DateTime? ToDateInclusive => ToDate?.Date.AddDays(1).AddTicks(-1);
    private List<BulkImportBatchSummaryDto> FilteredBatches => Batches
        .Where(MatchesDateFilter)
        .OrderByDescending(batch => batch.StartedAt)
        .ToList();
    private int TotalPages => Math.Max(1, (int)Math.Ceiling((double)FilteredBatches.Count / PageSize));
    private int NormalizedPage => Math.Min(Math.Max(1, Page), TotalPages);
    private List<BulkImportBatchSummaryDto> PagedBatches => FilteredBatches
        .Skip((NormalizedPage - 1) * PageSize)
        .Take(PageSize)
        .ToList();

    private bool MatchesDateFilter(BulkImportBatchSummaryDto batch)
    {
        if (FromDate.HasValue && batch.StartedAt < FromDate.Value.Date)
        {
            return false;
        }

        if (ToDateInclusive.HasValue && batch.StartedAt > ToDateInclusive.Value)
        {
            return false;
        }

        return true;
    }

    private void GoPrevious()
    {
        if (Page > 1)
        {
            Page--;
        }
    }

    private void GoNext()
    {
        if (Page < TotalPages)
        {
            Page++;
        }
    }

    private string GetBatchCardTitle(BulkImportBatchSummaryDto batch)
    {
        var fileName = string.IsNullOrWhiteSpace(batch.FileName)
            ? "Lote sin archivo"
            : Path.GetFileNameWithoutExtension(batch.FileName);

        return $"{fileName} · {FormatBatchDate(batch.StartedAt)} · {batch.BatchCode}";
    }

    private static string FormatBatchDate(DateTime date)
        => date.ToLocalTime().ToString("dd/MM/yyyy HH:mm");

    private static string GetFriendlyBatchStatus(BulkImportBatchSummaryDto batch)
        => batch.Status switch
        {
            "Pending" => "Pendiente",
            "Validated" => "Validado",
            "Processed" => "Procesado",
            "Error" => "Con errores",
            "Empty" => "Vacío",
            _ => batch.Status
        };

    private string GetLastActivityDate(BulkImportBatchSummaryDto batch)
        => batch.FinishedAt.HasValue
            ? FormatBatchDate(batch.FinishedAt.Value)
            : "En curso";
}
