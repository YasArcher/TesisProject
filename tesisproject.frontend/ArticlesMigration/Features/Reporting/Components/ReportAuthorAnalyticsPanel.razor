    private HierarchyAuthorNode BuildHierarchyAuthorNode(AuthorReportingSummaryDto author)
    {
        var allPublications = DeduplicateAuthorPublications(
            Dashboard?.Publications
                .Where(x => MatchesAuthorPublication(x, author))
                .ToList() ?? []);

        var filteredPublications = allPublications
            .Where(MatchesHierarchyRole)
            .Where(MatchesHierarchyFaculty)
            .OrderByDescending(x => x.PublishedDate ?? x.CreatedDate)
            .ThenBy(x => x.Title)
            .ToList();

        var isExpanded = IsHierarchyAuthorExpanded(author.AuthorKey);
        var detailLimit = isExpanded
            ? filteredPublications.Count
            : VisibleHierarchyPublicationsPerAuthor;

        var publicationNodes = filteredPublications
            .Take(detailLimit)
            .Select(x => new HierarchyPublicationNode(x, GetPublicationCoauthors(x, author.AuthorKey)))
            .ToList();

        var totalArticles = HasHierarchyPublicationFilters ? filteredPublications.Count : author.TotalArticles;
        var primaryArticles = HasHierarchyPublicationFilters
            ? filteredPublications.Count(x => x.IsPrimaryAuthor)
            : author.PrimaryAuthorArticles;
        var coauthorArticles = HasHierarchyPublicationFilters
            ? filteredPublications.Count(x => !x.IsPrimaryAuthor)
            : author.CoauthorArticles;
        var facultySource = HasHierarchyPublicationFilters ? filteredPublications : allPublications;

        return new HierarchyAuthorNode(
            author,
            totalArticles,
            primaryArticles,
            coauthorArticles,
            GetDominantPublicationValue(facultySource, x => x.Faculty, "Sin facultad dominante"),
            publicationNodes,
            BuildHierarchySegments(facultySource, x => x.Faculty, "Sin facultad"),
            totalArticles,
            filteredPublications.Count,
            isExpanded,
            filteredPublications.Count > VisibleHierarchyPublicationsPerAuthor);
    }

    private IReadOnlyList<HierarchyCoauthorNode> GetPublicationCoauthors(AuthorPublicationDto publication, int authorKey)
    {
        var publicationIdentity = GetPublicationIdentity(publication);

        return PublicationCoauthorsByIdentity.TryGetValue(publicationIdentity, out var coauthors)
            ? coauthors.Where(x => x.AuthorKey != authorKey).ToList()
            : [];
    }

    private Dictionary<string, IReadOnlyList<HierarchyCoauthorNode>> PublicationCoauthorsByIdentity =>
        _publicationCoauthorsByIdentity ??= BuildPublicationCoauthorLookup();

    private Dictionary<string, IReadOnlyList<HierarchyCoauthorNode>> BuildPublicationCoauthorLookup()
    {
        return Dashboard?.Publications
            .GroupBy(GetPublicationIdentity, StringComparer.OrdinalIgnoreCase)
            .ToDictionary(
                g => g.Key,
                g => (IReadOnlyList<HierarchyCoauthorNode>)g
                    .GroupBy(x => x.AuthorKey)
                    .Select(authorGroup => new HierarchyCoauthorNode(
                        authorGroup.Key,
                        NormalizeValue(authorGroup.First().AuthorName, "Sin autor")))
                    .OrderBy(x => x.AuthorName)
                    .ToList(),
                StringComparer.OrdinalIgnoreCase) ?? [];
    }

    private bool MatchesSelectedAuthorPublication(AuthorPublicationDto publication) =>
        SelectedAuthor is not null && MatchesAuthorPublication(publication, SelectedAuthor);

    private bool MatchesSnapshotAuthorPublication(AuthorPublicationDto publication) =>
        SnapshotAuthors.Any(author => MatchesAuthorPublication(publication, author));

    private static bool MatchesAuthorPublication(AuthorPublicationDto publication, AuthorReportingSummaryDto author)
    {
        if (!string.IsNullOrWhiteSpace(author.AuthorIdentity)
            && !string.IsNullOrWhiteSpace(publication.AuthorIdentity))
        {
            return publication.AuthorIdentity.Equals(author.AuthorIdentity, StringComparison.OrdinalIgnoreCase);
        }

        return publication.AuthorKey == author.AuthorKey;
    }

    private static string GetPublicationIdentity(AuthorPublicationDto publication)
    {
        if (publication.ArticleKey > 0)
        {
            return $"dw:{publication.ArticleKey}";
        }

        if (publication.ArticleId > 0)
        {
            return $"oltp:{publication.ArticleId}";
        }

        return $"title:{NormalizeValue(publication.Title, "Sin título")}|{publication.PublishedDate:O}|{publication.Year}";
    }

    private bool MatchesHierarchyRole(AuthorPublicationDto publication) =>
        string.IsNullOrWhiteSpace(_hierarchyRoleFilter)
        || (_hierarchyRoleFilter.Equals("primary", StringComparison.OrdinalIgnoreCase) && publication.IsPrimaryAuthor)
        || (_hierarchyRoleFilter.Equals("coauthor", StringComparison.OrdinalIgnoreCase) && !publication.IsPrimaryAuthor);

    private bool MatchesHierarchyFaculty(AuthorPublicationDto publication) =>
        string.IsNullOrWhiteSpace(_hierarchyFacultyFilter)
        || NormalizeValue(publication.Faculty, string.Empty)
            .Equals(_hierarchyFacultyFilter, StringComparison.OrdinalIgnoreCase);

