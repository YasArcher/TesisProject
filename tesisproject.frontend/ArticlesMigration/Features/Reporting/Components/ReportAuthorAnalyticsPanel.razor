    private static string GetHierarchySegmentPieStyle(IReadOnlyList<HierarchySegment> segments)
    {
        if (segments.Count == 0)
        {
            return "background: conic-gradient(#055052 0 100%);";
        }

        var total = Math.Max(1, segments.Sum(x => x.Count));
        var current = 0d;
        var stops = new List<string>();

        foreach (var segment in segments)
        {
            var next = current + (segment.Count / (double)total * 100);
            stops.Add($"{segment.Color} {current:0.##}% {next:0.##}%");
            current = next;
        }

        return $"background: conic-gradient({string.Join(", ", stops)});";
    }

    private static IReadOnlyList<HierarchySegment> BuildHierarchySegments(
        IEnumerable<AuthorPublicationDto> publications,
        Func<AuthorPublicationDto, string> selector,
        string fallback)
    {
        var colors = new[] { "#055052", "#408A71", "#628141", "#8C1007", "#435663" };

        return publications
            .Select(selector)
            .Select(x => NormalizeValue(x, fallback))
            .GroupBy(x => x, StringComparer.OrdinalIgnoreCase)
            .OrderByDescending(g => g.Count())
            .ThenBy(g => g.Key)
            .Take(colors.Length)
            .Select((g, index) => new HierarchySegment(g.Key, g.Count(), colors[index]))
            .ToList();
    }

