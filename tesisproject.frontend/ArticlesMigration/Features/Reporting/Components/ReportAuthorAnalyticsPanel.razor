    private void QueuePdfScopeChanged()
    {
        if (!OnPdfScopeChanged.HasDelegate)
        {
            return;
        }

        _ = InvokeAsync(async () => await OnPdfScopeChanged.InvokeAsync(BuildAuthorPdfScopeFilter()));
    }

    private InstitutionalReportingFilterDto BuildAuthorPdfScopeFilter()
    {
        var filter = new InstitutionalReportingFilterDto
        {
            Faculty = string.IsNullOrWhiteSpace(_hierarchyFacultyFilter) ? null : _hierarchyFacultyFilter.Trim(),
            OnlyPrimaryAuthors = _hierarchyRoleFilter.Equals("primary", StringComparison.OrdinalIgnoreCase) ? true : null
        };

        if (_hierarchyAuthorScope.Equals("visible", StringComparison.OrdinalIgnoreCase))
        {
            filter.AuthorName = string.IsNullOrWhiteSpace(_authorSearchTerm) ? null : _authorSearchTerm.Trim();
        }
        else
        {
            var selectedNames = SelectedAuthorOptions
                .Select(x => x.AuthorName)
                .Where(x => !string.IsNullOrWhiteSpace(x))
                .ToList();

            filter.AuthorName = selectedNames.Count == 0
                ? SelectedAuthor?.AuthorName
                : string.Join(PdfAuthorNameSeparator, selectedNames);
        }

        return filter;
    }

    private AuthorReportingSummaryDto? FindAuthor(int authorKey, string? authorName)
    {
        var authors = Dashboard?.Authors;
        if (authors is null || authors.Count == 0)
        {
            return null;
        }

        var byKey = authors.FirstOrDefault(x => x.AuthorKey == authorKey);
        if (byKey is not null)
        {
            return byKey;
        }

        var normalizedName = NormalizeValue(authorName, string.Empty);
        return string.IsNullOrWhiteSpace(normalizedName)
            ? null
            : authors.FirstOrDefault(x => NormalizeValue(x.AuthorName, string.Empty)
                .Equals(normalizedName, StringComparison.OrdinalIgnoreCase));
    }

