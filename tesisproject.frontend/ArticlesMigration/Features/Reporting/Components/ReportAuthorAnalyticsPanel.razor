@using tesisproject.shared.DTOs.Reports

<section class="reports-dw-author-panel">
    @if (IsBusy && Dashboard is null)
    {
        <ReportEmptyState IconClass="bi bi-hourglass-split"
                          Title="Cargando analítica de autores"
                          Message="Estamos preparando autores, publicaciones y coautorías desde el modelo analítico." />
    }
    else if (Dashboard is null)
    {
        <ReportEmptyState IconClass="bi bi-people"
                          Title="Sin lectura de autores"
                          Message="Aplica una búsqueda o actualiza la reportería para consultar producción por autores." />
    }
    else
    {
        @if (!IsFallbackSummary && Dashboard.Authors.Count > 0)
        {
            <article class="reports-dw-chart-card reports-dw-chart-card--wide reports-dw-author-hierarchy-shell">
                <div class="reports-dw-author-hierarchy-shell__head">
                    <div class="reports-dw-author-hierarchy-shell__title">
                        <span><i class="bi bi-diagram-2"></i></span>
                        <div>
                            <small>Jerarquía autoral</small>
                            <h3>Mapa de autores y publicaciones</h3>
                        </div>
                    </div>
                    <div class="reports-dw-author-hierarchy-shell__actions">
                        <div class="reports-dw-author-search-box">
                            <i class="bi bi-search" aria-hidden="true"></i>
                            <input id="reports-author-hierarchy-search"
                                   type="search"
                                   value="@AuthorSearchTerm"
                                   @oninput="OnAuthorSearchChanged"
                                   placeholder="Buscar autor, filiación, ID u ORCID" />
                            @if (!string.IsNullOrWhiteSpace(AuthorSearchTerm))
                            {
                                <button type="button"
                                        title="Limpiar búsqueda"
                                        aria-label="Limpiar búsqueda de autor"
                                        @onclick="ClearAuthorSearch">
                                    <i class="bi bi-x-lg" aria-hidden="true"></i>
                                </button>
                            }
                        </div>
                        <button type="button"
                                class="reports-dw-author-picker-button"
                                @onclick="OpenAuthorPicker">
                            <i class="bi bi-person-lines-fill" aria-hidden="true"></i>
                            <span>@SelectedAuthorPickerLabel</span>
                        </button>
                        <button type="button"
                                class="reports-dw-author-hierarchy-filter-toggle"
                                @onclick="ToggleHierarchyFilters">
                            <i class="bi bi-sliders" aria-hidden="true"></i>
                            @(_showHierarchyFilters ? "Ocultar filtros" : "Filtros")
                        </button>
                    </div>
                </div>

                @if (_showAuthorPicker)
                {
                    <div class="reports-dw-author-picker-backdrop" @onclick="CloseAuthorPicker">
                        <div class="reports-dw-author-picker-modal" role="dialog" aria-modal="true" aria-labelledby="reports-author-picker-title" @onclick:stopPropagation="true">
                            <header>
                                <div>
                                    <small>Selección de autores</small>
                                    <strong id="reports-author-picker-title">@AuthorSearchResultLabel</strong>
                                </div>
                                <button type="button"
                                        title="Cerrar"
                                        aria-label="Cerrar selector de autores"
                                        @onclick="CloseAuthorPicker">
                                    <i class="bi bi-x-lg" aria-hidden="true"></i>
                                </button>
                            </header>

                            @if (SelectedAuthorOptions.Count > 0)
                            {
                                <div class="reports-dw-author-picker-selected">
                                    <strong>@SelectedAuthorOptions.Count autor(es) seleccionados</strong>
                                    <div>
                                        @foreach (var author in SelectedAuthorOptions)
                                        {
                                            <button type="button"
                                                    title="Enfocar autor"
                                                    @onclick="@(() => FocusAuthor(author.AuthorKey))">
                                                @Shorten(author.AuthorName, 28)
                                                <i class="bi bi-bullseye" aria-hidden="true"></i>
                                            </button>
                                        }
                                    </div>
                                </div>
                            }

                            @if (!HasAuthorSearchResults)
                            {
                                <div class="reports-dw-author-picker-empty">
                                    No hay autores para la búsqueda actual.
                                </div>
                            }
                            else
                            {
                                <div class="reports-dw-author-picker-groups">
                                    @foreach (var group in AlphabetizedAuthorGroups)
                                    {
                                        <section class="reports-dw-author-picker-group">
                                            <span>@group.Initial</span>
                                            <div>
                                                @foreach (var author in group.Authors)
                                                {
                                                    <button type="button"
                                                            class="@GetAuthorPickerItemClass(author)"
                                                            @onclick="@(() => ToggleAuthorFromPicker(author.AuthorKey))">
                                                        <strong>@author.AuthorName</strong>
                                                        <small>
                                                            @(IsAuthorSelected(author.AuthorKey) ? "Seleccionado" : "Agregar") ·
                                                            @author.TotalArticles.ToString("N0") publicaciones · @NormalizeValue(author.Affiliation, "Sin filiación")
                                                        </small>
                                                    </button>
                                                }
                                            </div>
                                        </section>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }

                <section class="reports-dw-author-view-panel reports-dw-author-hierarchy-panel">
                    @{
                        var hierarchyAuthorNodes = HierarchyAuthorNodes;
                    }
                    <section class="reports-dw-author-snapshot-panel">
                        <div class="reports-dw-author-snapshot-panel__head">
                            <div>
                                <small>Lectura rápida</small>
                                <strong>Resumen analítico de autores</strong>
                            </div>
                            <span>@AuthorSnapshotScopeLabel</span>
                        </div>

                        <div class="reports-dw-author-snapshot-grid">
                            <ReportChartCard Title="Rol autoral"
                                             Description="Principal frente a coautoría."
                                             HasData="@HasAuthorRoleSnapshot"
                                             EmptyMessage="Sin roles autorales disponibles."
                                             ChartId="chart-author-role-snapshot"
                                             Height="210px"
                                             Option="@AuthorRoleSnapshotOption"
                                             Accent="green"
                                             Density="author-snapshot" />

                            <ReportChartCard Title="Carga por autor"
                                             Description="Distribución por volumen individual."
                                             HasData="@(AuthorLoadBuckets.Count > 0)"
                                             EmptyMessage="Sin carga autoral disponible."
                                             ChartId="chart-author-load-snapshot"
                                             Height="210px"
                                             Option="@AuthorLoadSnapshotOption"
                                             Accent="sage"
                                             Density="author-snapshot" />

                            <ReportChartCard Title="Intensidad de coautoría"
                                             Description="Colaboraciones por autor."
                                             HasData="@(CoauthorIntensityBuckets.Count > 0)"
                                             EmptyMessage="Sin coautorías disponibles."
                                             ChartId="chart-author-coauthor-snapshot"
                                             Height="210px"
                                             Option="@CoauthorIntensitySnapshotOption"
                                             Accent="blue"
                                             Density="author-snapshot" />

                            <ReportChartCard Title="Cobertura de identificación"
                                             Description="ORCID y filiación registrados."
                                             HasData="@HasIdentificationCoverage"
                                             EmptyMessage="Sin cobertura de identificación."
                                             ChartId="chart-author-coverage-snapshot"
                                             Height="210px"
                                             Option="@IdentificationCoverageSnapshotOption"
                                             Accent="gold"
                                             Density="author-snapshot" />
                        </div>
                    </section>

                    <div class="reports-dw-author-hierarchy-activebar">
                        <strong>@AuthorHierarchyResultLabel</strong>
                        @if (_hierarchyAuthorScope.Equals("visible", StringComparison.OrdinalIgnoreCase))
                        {
                            <span><i class="bi bi-person-lines-fill" aria-hidden="true"></i>@AuthorHierarchyScopeLabel</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(_hierarchyRoleFilter))
                        {
                            <span><i class="bi bi-person-check" aria-hidden="true"></i>@HierarchyRoleLabel</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(_hierarchyFacultyFilter))
                        {
                            <span><i class="bi bi-building" aria-hidden="true"></i>@HierarchyFacultyLabel</span>
                        }
                        <span><i class="reports-dw-author-hierarchy-legend__primary"></i>Principal</span>
                        <span><i class="reports-dw-author-hierarchy-legend__coauthor"></i>Coautor</span>
                    </div>

                    @if (_showHierarchyFilters)
                    {
                        <div class="reports-dw-filter-grid reports-dw-author-local-controls reports-dw-author-hierarchy-controls">
                            <div class="report-select-filter">
                                <label for="reports-author-hierarchy-scope">Alcance</label>
                                <select id="reports-author-hierarchy-scope"
                                        class="form-select"
                                        value="@_hierarchyAuthorScope"
                                        @onchange="OnHierarchyAuthorScopeChanged">
                                    <option value="selected">Autor seleccionado</option>
                                    <option value="visible">Autores visibles</option>
                                </select>
                            </div>
                            <div class="report-select-filter">
                                <label for="reports-author-hierarchy-role">Rol</label>
                                <select id="reports-author-hierarchy-role"
                                        class="form-select"
                                        value="@_hierarchyRoleFilter"
                                        @onchange="OnHierarchyRoleChanged">
                                    <option value="">Todos</option>
                                    <option value="primary">Autor principal</option>
                                    <option value="coauthor">Coautor</option>
                                </select>
                            </div>
                            <div class="report-select-filter">
                                <label for="reports-author-hierarchy-faculty">Facultad</label>
                                <select id="reports-author-hierarchy-faculty"
                                        class="form-select"
                                        value="@_hierarchyFacultyFilter"
                                        @onchange="OnHierarchyFacultyChanged">
                                    <option value="">Todas</option>
                                    @foreach (var faculty in HierarchyFacultyOptions)
                                    {
                                        <option value="@faculty">@faculty</option>
                                    }
                                </select>
                            </div>
                        </div>
                    }

                    @if (hierarchyAuthorNodes.Count == 0)
                    {
                        <div class="reports-dw-author-publication-empty">
                            <i class="bi bi-diagram-2"></i>
                            <strong>Sin datos para la jerarquía</strong>
                            <span>Ajusta el alcance, rol o facultad para revisar publicaciones del autor.</span>
                        </div>
                    }
                    else
                    {
                        <div class="reports-dw-author-hierarchy-list">
                            @foreach (var authorNode in hierarchyAuthorNodes)
                            {
                                <article class="reports-dw-author-hierarchy-author" @key="authorNode.Author.AuthorIdentity">
                                    <div class="reports-dw-author-hierarchy-author__head">
                                        <div class="reports-dw-author-hierarchy-donut" style="@GetHierarchyDonutStyle(authorNode)">
                                            <span>@authorNode.TotalArticles.ToString("N0")</span>
                                        </div>
                                        <div>
                                            <small>Autor</small>
                                            <strong>@authorNode.Author.AuthorName</strong>
                                            <span>@NormalizeValue(authorNode.Author.Affiliation, "Sin filiación")</span>
                                            <em>@authorNode.TopFaculty</em>
                                        </div>
                                        <button type="button"
                                                class="reports-dw-author-hierarchy-focus-button"
                                                @onclick="@(() => FocusAuthor(authorNode.Author.AuthorKey))">
                                            <i class="bi bi-bullseye" aria-hidden="true"></i>
                                            Enfocar
                                        </button>
                                    </div>

                                    <div class="reports-dw-author-hierarchy-metrics">
                                        <span><strong>@authorNode.TotalArticles.ToString("N0")</strong><small>publicaciones</small></span>
                                        <span><strong>@authorNode.PrimaryArticles.ToString("N0")</strong><small>principal</small></span>
                                        <span><strong>@authorNode.CoauthorArticles.ToString("N0")</strong><small>coautor</small></span>
                                    </div>

                                    @if (authorNode.Publications.Count == 0)
                                    {
                                        <div class="reports-dw-author-hierarchy-empty">
                                            Sin publicaciones dentro de los filtros de jerarquía.
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="reports-dw-author-hierarchy-tabs">
                                            <button type="button"
                                                    class='@GetHierarchyTabClass(authorNode, "publications")'
                                                    @onclick='@(() => SetHierarchyAuthorTab(authorNode.Author.AuthorKey, "publications"))'>
                                                <i class="bi bi-list-ul" aria-hidden="true"></i>
                                                Publicaciones
                                            </button>
                                            <button type="button"
                                                    class='@GetHierarchyTabClass(authorNode, "summary")'
                                                    @onclick='@(() => SetHierarchyAuthorTab(authorNode.Author.AuthorKey, "summary"))'>
                                                <i class="bi bi-pie-chart" aria-hidden="true"></i>
                                                Resumen
                                            </button>
                                        </div>

                                        <div class="reports-dw-author-hierarchy-treehead">
                                            <div>
                                                <small>Publicaciones registradas</small>
                                                <strong>
                                                    @GetHierarchyTreeSummary(authorNode)
                                                </strong>
                                            </div>

                                            @if (authorNode.CanTogglePublicationDetail)
                                            {
                                                <button type="button"
                                                        @onclick="@(() => ToggleHierarchyAuthorPublications(authorNode.Author.AuthorKey))">
                                                    <i class="@GetHierarchyToggleIconClass(authorNode)" aria-hidden="true"></i>
                                                    @(authorNode.IsExpanded ? "Contraer" : "Ver detalle")
                                                </button>
                                            }
                                        </div>

                                        @if (GetHierarchyAuthorTab(authorNode.Author.AuthorKey) == "summary")
                                        {
                                            <div class="reports-dw-author-hierarchy-summary">
                                                <div class="reports-dw-author-hierarchy-summary-strip">
                                                    <span>
                                                        <small>Detalle visible</small>
                                                        <strong>@authorNode.DetailPublicationCount.ToString("N0")</strong>
                                                    </span>
                                                    <span>
                                                        <small>Principal</small>
                                                        <strong>@authorNode.PrimaryArticles.ToString("N0")</strong>
                                                    </span>
                                                    <span>
                                                        <small>Coautoría</small>
                                                        <strong>@authorNode.CoauthorArticles.ToString("N0")</strong>
                                                    </span>
                                                    <span>
                                                        <small>Facultad dominante</small>
                                                        <strong>@authorNode.TopFaculty</strong>
                                                    </span>
                                                </div>
                                                <article>
                                                    <div class="reports-dw-author-hierarchy-pie" style="@GetHierarchyRolePieStyle(authorNode)">
                                                        <span>@authorNode.TotalArticles.ToString("N0")</span>
                                                    </div>
                                                    <div class="reports-dw-author-hierarchy-pie-copy">
                                                        <strong>Rol autoral</strong>
                                                        <span>@authorNode.PrimaryArticles.ToString("N0") principal · @authorNode.CoauthorArticles.ToString("N0") coautoría</span>
                                                        <div class="reports-dw-author-hierarchy-mini-legend">
                                                            <i class="reports-dw-author-hierarchy-mini-legend__dark"></i>Principal
                                                            <i class="reports-dw-author-hierarchy-mini-legend__red"></i>Coautoría
                                                        </div>
                                                    </div>
                                                </article>

                                                <article>
                                                    <div class="reports-dw-author-hierarchy-pie" style="@GetHierarchySegmentPieStyle(authorNode.FacultySegments)">
                                                        <span>@authorNode.DetailPublicationCount.ToString("N0")</span>
                                                    </div>
                                                    <div class="reports-dw-author-hierarchy-pie-copy">
                                                        <strong>Facultades</strong>
                                                        @foreach (var segment in authorNode.FacultySegments)
                                                        {
                                                            <span><i style="background:@segment.Color"></i>@segment.Name · @segment.Count.ToString("N0")</span>
                                                        }
                                                    </div>
                                                </article>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="@GetHierarchyPublicationsClass(authorNode)">
                                                @foreach (var publication in authorNode.Publications)
                                                {
                                                    <div class="reports-dw-author-hierarchy-publication" @key="GetPublicationIdentity(publication.Publication)">
                                                        <div class="@GetHierarchyMarkerClass(publication.Publication)"></div>
                                                        <div class="@GetHierarchyPublicationBodyClass(authorNode)">
                                                            <div class="reports-dw-author-hierarchy-publication__title">
                                                                <strong>@publication.Publication.Title</strong>
                                                                <span>
                                                                    <i class="bi bi-calendar3" aria-hidden="true"></i>
                                                                    @((publication.Publication.PublishedDate ?? publication.Publication.CreatedDate)?.ToString("dd/MM/yyyy") ?? "Sin fecha")
                                                                </span>
                                                            </div>
                                                            <div class="reports-dw-author-hierarchy-publication__compact">
                                                                <div class="reports-dw-author-hierarchy-publication__meta">
                                                                    <span class="@GetHierarchyRolePillClass(publication.Publication)">@(publication.Publication.IsPrimaryAuthor ? "Principal" : "Coautor")</span>
                                                                    <span class="@GetHierarchyMetaPillClass(publication.Publication.Faculty, "faculty")">@NormalizeValue(publication.Publication.Faculty, "Sin facultad")</span>
                                                                    <span class="@GetHierarchyMetaPillClass(publication.Publication.IndexingSourceName, "source")">@NormalizeValue(publication.Publication.IndexingSourceName, "Sin base")</span>
                                                                    @if (authorNode.IsExpanded)
                                                                    {
                                                                        <span class="@GetHierarchyMetaPillClass(publication.Publication.Quartile, "quartile")">@NormalizeValue(publication.Publication.Quartile, "Sin cuartil")</span>
                                                                    }
                                                                </div>
                                                                @if (authorNode.IsExpanded)
                                                                {
                                                                    <div class="reports-dw-author-hierarchy-coauthors">
                                                                        @if (publication.Coauthors.Count == 0)
                                                                        {
                                                                            <span>Sin coautores</span>
                                                                        }
                                                                        else
                                                                        {
                                                                            @foreach (var coauthor in publication.Coauthors.Take(VisibleHierarchyCoauthors))
                                                                            {
                                                                                <button type="button"
                                                                                        title="@GetHierarchyCoauthorFocusTitle(coauthor)"
                                                                                        @onclick="@(() => FocusHierarchyCoauthor(coauthor))"
                                                                                        disabled="@(!CanFocusHierarchyCoauthor(coauthor))">
                                                                                    <i class="bi bi-person" aria-hidden="true"></i>
                                                                                    @coauthor.AuthorName
                                                                                </button>
                                                                            }
                                                                            @if (publication.Coauthors.Count > VisibleHierarchyCoauthors)
                                                                            {
                                                                                <span>+@(publication.Coauthors.Count - VisibleHierarchyCoauthors)</span>
                                                                            }
                                                                        }
                                                                    </div>
                                                                }
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        }

                                        @if (authorNode.HasOfficialTotalGap)
                                        {
                                            <div class="reports-dw-inline-note reports-dw-inline-note--soft">
                                                Total oficial: @authorNode.TotalArticles.ToString("N0"). Detalle disponible en la jerarquía: @authorNode.DetailPublicationCount.ToString("N0").
                                            </div>
                                        }
                                    }
                                </article>
                            }
                        </div>
                    }
                </section>
            </article>
        }
    }
</section>

@code {
    [Parameter] public AuthorReportingDashboardDto? Dashboard { get; set; }
    [Parameter] public bool IsBusy { get; set; }
    [Parameter] public bool IsFallbackSummary { get; set; }
    [Parameter] public string ScopeLabel { get; set; } = string.Empty;
    [Parameter] public EventCallback<InstitutionalReportingFilterDto> OnPdfScopeChanged { get; set; }
    private int? _selectedAuthorKey;
    private int? _selectedCoauthorKey;
    private HashSet<int> _selectedAuthorKeys = [];
    private string _authorSearchTerm = string.Empty;
    private string? _selectedPublicationSource;
    private string? _selectedPublicationQuartile;
    private string? _selectedPublicationRole;
    private string _selectedPublicationSort = "recent";
    private string _selectedCoauthorSort = "shared";
    private string _selectedTimelineRange = "24m";
    private bool _showHierarchyFilters;
    private bool _showAuthorPicker;
    private string _hierarchyAuthorScope = "selected";
    private string _hierarchyRoleFilter = string.Empty;
    private string _hierarchyFacultyFilter = string.Empty;
    private AuthorReportingDashboardDto? _coauthorLookupDashboard;
    private Dictionary<string, IReadOnlyList<HierarchyCoauthorNode>>? _publicationCoauthorsByIdentity;
    private Dictionary<int, string> _hierarchyAuthorTabs = [];
    private IReadOnlyList<AuthorReportingSummaryDto>? _selectedAuthorOptionsCache;
    private IReadOnlyList<AuthorReportingSummaryDto>? _orderedAuthorOptionsCache;
    private IReadOnlyList<AuthorReportingSummaryDto>? _filteredAuthorOptionsCache;
    private IReadOnlyList<AuthorAlphabetGroup>? _alphabetizedAuthorGroupsCache;
    private IReadOnlyList<string>? _hierarchyFacultyOptionsCache;
    private IReadOnlyList<HierarchyAuthorNode>? _hierarchyAuthorNodesCache;
    private IReadOnlyList<AuthorReportingSummaryDto>? _snapshotAuthorsCache;
    private IReadOnlyList<AuthorPublicationDto>? _snapshotPublicationLinksCache;
    private IReadOnlyList<AuthorPublicationDto>? _snapshotPublicationsCache;
    private IReadOnlyList<ReportingSummaryItemDto>? _authorLoadBucketsCache;
    private IReadOnlyList<ReportingSummaryItemDto>? _coauthorIntensityBucketsCache;
    private int? _snapshotPrimaryPublicationsCache;
    private int? _snapshotCoauthorPublicationsCache;
    private object? _authorRoleSnapshotOptionCache;
    private bool _authorRoleSnapshotOptionBuilt;
    private object? _authorLoadSnapshotOptionCache;
    private bool _authorLoadSnapshotOptionBuilt;
    private object? _coauthorIntensitySnapshotOptionCache;
    private bool _coauthorIntensitySnapshotOptionBuilt;
    private object? _identificationCoverageSnapshotOptionCache;
    private bool _identificationCoverageSnapshotOptionBuilt;
    private const string PdfAuthorNameSeparator = "||";

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_coauthorLookupDashboard, Dashboard))
        {
            _coauthorLookupDashboard = Dashboard;
            InvalidateAuthorComputedState(includeCoauthorLookup: true);
        }

        if (Dashboard?.Authors.Count > 0)
        {
            var hasSelectedAuthor = _selectedAuthorKey.HasValue
                && Dashboard.Authors.Any(x => x.AuthorKey == _selectedAuthorKey.Value);

            if (!hasSelectedAuthor)
            {
                _selectedAuthorKey = Dashboard.Authors
                    .OrderByDescending(x => x.TotalArticles)
                    .ThenBy(x => x.AuthorName)
                    .First()
                    .AuthorKey;

                _selectedCoauthorKey = null;
                ClearPublicationFilters();
            }

            var visibleAuthorKeys = Dashboard.Authors.Select(x => x.AuthorKey).ToHashSet();
            _selectedAuthorKeys.RemoveWhere(authorKey => !visibleAuthorKeys.Contains(authorKey));
            if (_selectedAuthorKey.HasValue)
            {
                _selectedAuthorKeys.Add(_selectedAuthorKey.Value);
            }

            if (_selectedAuthorKeys.Count == 0 && _selectedAuthorKey.HasValue)
            {
                _selectedAuthorKeys.Add(_selectedAuthorKey.Value);
            }

            if (_selectedCoauthorKey.HasValue
                && !Dashboard.Coauthors.Any(x => x.AuthorKey == SelectedAuthorKey && x.CoauthorKey == _selectedCoauthorKey.Value))
            {
                _selectedCoauthorKey = null;
            }

            return;
        }

        _selectedAuthorKey = null;
        _selectedCoauthorKey = null;
        _selectedAuthorKeys.Clear();
        ClearPublicationFilters();
    }

    private int SelectedAuthorKey
    {
        get
        {
            if (_selectedAuthorKey.HasValue && Dashboard?.Authors.Any(x => x.AuthorKey == _selectedAuthorKey.Value) == true)
            {
                return _selectedAuthorKey.Value;
            }

            return Dashboard?.Authors.OrderByDescending(x => x.TotalArticles).ThenBy(x => x.AuthorName).FirstOrDefault()?.AuthorKey ?? 0;
        }
    }

    private int? SelectedCoauthorKey =>
        _selectedCoauthorKey.HasValue && SelectedAuthorCoauthors.Any(x => x.CoauthorKey == _selectedCoauthorKey.Value)
            ? _selectedCoauthorKey
            : null;

    private AuthorReportingSummaryDto? SelectedAuthor =>
        Dashboard?.Authors.FirstOrDefault(x => x.AuthorKey == SelectedAuthorKey)
        ?? Dashboard?.Authors.OrderByDescending(x => x.TotalArticles).ThenBy(x => x.AuthorName).FirstOrDefault();

    private string AuthorSearchTerm => _authorSearchTerm;

    private IReadOnlyList<AuthorReportingSummaryDto> SelectedAuthorOptions =>
        _selectedAuthorOptionsCache ??= Dashboard?.Authors
            .Where(x => _selectedAuthorKeys.Contains(x.AuthorKey))
            .OrderByDescending(x => x.TotalArticles)
            .ThenBy(x => x.AuthorName)
            .ToList() ?? [];

    private string SelectedAuthorPickerLabel =>
        SelectedAuthorOptions.Count switch
        {
            0 => Shorten(SelectedAuthorDisplayName, 28),
            1 => Shorten(SelectedAuthorOptions[0].AuthorName, 28),
            _ => $"{SelectedAuthorOptions.Count:N0} autores"
        };

    private IReadOnlyList<AuthorReportingSummaryDto> OrderedAuthorOptions =>
        _orderedAuthorOptionsCache ??= Dashboard?.Authors
            .OrderByDescending(x => x.TotalArticles)
            .ThenBy(x => x.AuthorName)
            .ToList() ?? [];

    private IReadOnlyList<AuthorReportingSummaryDto> FilteredAuthorOptions
    {
        get
        {
            if (_filteredAuthorOptionsCache is not null)
            {
                return _filteredAuthorOptionsCache;
            }

            var authors = OrderedAuthorOptions;
            if (string.IsNullOrWhiteSpace(_authorSearchTerm))
            {
                return _filteredAuthorOptionsCache = authors;
            }

            var term = _authorSearchTerm.Trim();
            return _filteredAuthorOptionsCache = authors
                .Where(x => MatchesAuthorSearch(x, term))
                .ToList();
        }
    }

    private IReadOnlyList<AuthorReportingSummaryDto> AuthorSelectOptions
    {
        get
        {
            var filteredAuthors = FilteredAuthorOptions;
            if (SelectedAuthor is null || filteredAuthors.Any(x => x.AuthorKey == SelectedAuthor.AuthorKey))
            {
                return filteredAuthors;
            }

