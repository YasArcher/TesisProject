    private IReadOnlyList<AuthorPublicationDto> RawSelectedAuthorPublications
    {
        get
        {
            var publications = DeduplicateAuthorPublications(
                Dashboard?.Publications
                    .Where(MatchesSelectedAuthorPublication)
                    .ToList() ?? []);

            if (SelectedCoauthor is null)
            {
                return publications
                    .OrderByDescending(x => x.PublishedDate ?? x.CreatedDate)
                    .ThenBy(x => x.Title)
                    .ToList();
            }

            var selectedCoauthorIdentity = NormalizeValue(SelectedCoauthor.CoauthorName, "Sin coautor");
            var sharedArticleKeys = Dashboard?.Publications
                .Where(x => NormalizeValue(x.AuthorName, "Sin autor")
                    .Equals(selectedCoauthorIdentity, StringComparison.OrdinalIgnoreCase))
                .Select(GetPublicationIdentity)
                .ToHashSet(StringComparer.OrdinalIgnoreCase) ?? [];

            return publications
                .Where(x => sharedArticleKeys.Contains(GetPublicationIdentity(x)))
                .OrderByDescending(x => x.PublishedDate ?? x.CreatedDate)
                .ThenBy(x => x.Title)
                .ToList();
        }
    }

