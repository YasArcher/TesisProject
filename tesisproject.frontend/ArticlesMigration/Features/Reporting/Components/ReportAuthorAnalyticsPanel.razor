    private static IReadOnlyList<AuthorPublicationDto> DeduplicateAuthorPublications(IEnumerable<AuthorPublicationDto> publications)
    {
        return publications
            .GroupBy(GetPublicationIdentity, StringComparer.OrdinalIgnoreCase)
            .Select(g => g
                .OrderByDescending(x => x.IsPrimaryAuthor)
                .ThenByDescending(x => x.PublishedDate ?? x.CreatedDate)
                .ThenBy(x => x.Title)
                .First())
            .ToList();
    }

    private IEnumerable<AuthorPublicationDto> ApplyPublicationSort(IEnumerable<AuthorPublicationDto> publications)
    {
        return _selectedPublicationSort switch
        {
            "oldest" => publications
                .OrderBy(x => x.PublishedDate ?? x.CreatedDate)
                .ThenBy(x => x.Title),
            "quartile" => publications
                .OrderBy(x => NormalizeValue(x.Quartile, "Sin cuartil"))
                .ThenByDescending(x => x.PublishedDate ?? x.CreatedDate)
                .ThenBy(x => x.Title),
            "source" => publications
                .OrderBy(x => NormalizeValue(x.IndexingSourceName, "Sin base"))
                .ThenByDescending(x => x.PublishedDate ?? x.CreatedDate)
                .ThenBy(x => x.Title),
            "venue" => publications
                .OrderBy(x => NormalizeValue(x.VenueName, "Sin revista"))
                .ThenByDescending(x => x.PublishedDate ?? x.CreatedDate)
                .ThenBy(x => x.Title),
            _ => publications
                .OrderByDescending(x => x.PublishedDate ?? x.CreatedDate)
                .ThenBy(x => x.Title)
        };
    }

    private IEnumerable<AuthorCoauthorDto> ApplyCoauthorSort(IEnumerable<AuthorCoauthorDto> coauthors)
    {
        return _selectedCoauthorSort switch
        {
            "name" => coauthors
                .OrderBy(x => x.CoauthorName)
                .ThenByDescending(x => x.SharedArticles),
            "affiliation" => coauthors
                .OrderBy(x => NormalizeValue(x.CoauthorAffiliation, "Sin filiación"))
                .ThenBy(x => x.CoauthorName)
                .ThenByDescending(x => x.SharedArticles),
            _ => coauthors
                .OrderByDescending(x => x.SharedArticles)
                .ThenBy(x => x.CoauthorName)
        };
    }

    private static IReadOnlyList<ReportingSummaryItemDto> BuildAuthorLoadBuckets(
        IReadOnlyList<AuthorReportingSummaryDto> authors,
        IReadOnlyList<AuthorPublicationDto> publicationLinks)
    {
        if (authors.Count == 0)
        {
            return [];
        }

        var countsByAuthor = publicationLinks
            .GroupBy(x => string.IsNullOrWhiteSpace(x.AuthorIdentity)
                ? x.AuthorKey.ToString()
                : x.AuthorIdentity.Trim(), StringComparer.OrdinalIgnoreCase)
            .ToDictionary(
                g => g.Key,
                g => g.Select(GetPublicationIdentity).Distinct(StringComparer.OrdinalIgnoreCase).Count(),
                StringComparer.OrdinalIgnoreCase);

        var authorPublicationCounts = authors
            .Select(author =>
            {
                var identity = string.IsNullOrWhiteSpace(author.AuthorIdentity)
                    ? author.AuthorKey.ToString()
                    : author.AuthorIdentity.Trim();

                return countsByAuthor.TryGetValue(identity, out var count) ? count : 0;
            })
            .Where(x => x > 0)
            .ToList();

        if (authorPublicationCounts.Count == 0)
        {
            return [];
        }

        var buckets = new[]
        {
            new ReportingSummaryItemDto { Name = "1 publicación", TotalArticles = authorPublicationCounts.Count(x => x == 1) },
            new ReportingSummaryItemDto { Name = "2-3 publicaciones", TotalArticles = authorPublicationCounts.Count(x => x is >= 2 and <= 3) },
            new ReportingSummaryItemDto { Name = "4-6 publicaciones", TotalArticles = authorPublicationCounts.Count(x => x is >= 4 and <= 6) },
            new ReportingSummaryItemDto { Name = "7+ publicaciones", TotalArticles = authorPublicationCounts.Count(x => x >= 7) }
        };

        return buckets.Where(x => x.TotalArticles > 0).ToList();
    }

    private IReadOnlyList<ReportingSummaryItemDto> BuildCoauthorIntensityBuckets(IReadOnlyList<AuthorReportingSummaryDto> authors)
    {
        if (authors.Count == 0 || Dashboard?.Coauthors.Count is not > 0)
        {
            return [];
        }

        var intensityByAuthor = authors.ToDictionary(
            author => author.AuthorKey,
            author => Dashboard.Coauthors
                .Where(x => x.AuthorKey == author.AuthorKey)
                .Sum(x => x.SharedArticles));

        var buckets = new[]
        {
            new ReportingSummaryItemDto { Name = "0-1 vínculos", TotalArticles = intensityByAuthor.Count(x => x.Value <= 1) },
            new ReportingSummaryItemDto { Name = "2-5 vínculos", TotalArticles = intensityByAuthor.Count(x => x.Value is >= 2 and <= 5) },
            new ReportingSummaryItemDto { Name = "6-10 vínculos", TotalArticles = intensityByAuthor.Count(x => x.Value is >= 6 and <= 10) },
            new ReportingSummaryItemDto { Name = "11+ vínculos", TotalArticles = intensityByAuthor.Count(x => x.Value >= 11) }
        };

        return buckets.Where(x => x.TotalArticles > 0).ToList();
    }

