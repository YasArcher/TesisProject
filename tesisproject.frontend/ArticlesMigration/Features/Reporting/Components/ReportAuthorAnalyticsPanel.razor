    private bool MatchesTimelineRange(AuthorPublicationDto publication)
    {
        if (_selectedTimelineRange.Equals("all", StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        var referenceDate = publication.PublishedDate ?? publication.CreatedDate;
        if (!referenceDate.HasValue)
        {
            return false;
        }

        var months = _selectedTimelineRange.Equals("12m", StringComparison.OrdinalIgnoreCase) ? -12 : -24;
        return referenceDate.Value >= DateTime.Today.AddMonths(months);
    }

    private static bool IsRecentPublication(AuthorPublicationDto publication)
    {
        var referenceDate = publication.PublishedDate ?? publication.CreatedDate;
        if (!referenceDate.HasValue)
        {
            return false;
        }

        return referenceDate.Value >= DateTime.Today.AddMonths(-24);
    }

    private static string GetDominantPublicationValue(
        IEnumerable<AuthorPublicationDto> publications,
        Func<AuthorPublicationDto, string> selector,
        string fallback)
    {
        return publications
            .Select(selector)
            .Select(x => NormalizeValue(x, string.Empty))
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .GroupBy(x => x, StringComparer.OrdinalIgnoreCase)
            .OrderByDescending(g => g.Count())
            .ThenBy(g => g.Key)
            .Select(g => g.Key)
            .FirstOrDefault() ?? fallback;
    }

    private static string NormalizeValue(string? value, string fallback) =>
        string.IsNullOrWhiteSpace(value) ? fallback : value.Trim();

    private static bool MatchesAuthorSearch(AuthorReportingSummaryDto author, string term) =>
        ContainsSearchText(author.AuthorName, term)
        || ContainsSearchText(author.Affiliation, term)
        || ContainsSearchText(author.Identification, term)
        || ContainsSearchText(author.Orcid, term)
        || ContainsSearchText(author.ParticipantType, term);

    private static bool ContainsSearchText(string? value, string term) =>
        !string.IsNullOrWhiteSpace(value)
        && value.Contains(term, StringComparison.OrdinalIgnoreCase);

    private static string GetPublicationRolePillClass(AuthorPublicationDto publication) =>
        publication.IsPrimaryAuthor
            ? "reports-dw-author-role-pill reports-dw-author-role-pill--primary"
            : "reports-dw-author-role-pill";

    private string GetCoauthorFocusStateLabel(AuthorCoauthorDto coauthor) =>
        SelectedCoauthorKey == coauthor.CoauthorKey
            ? "cruce seleccionado"
            : $"{coauthor.SharedArticles:N0} artículos compartidos";

    private static string GetBarWidth(int value, int maxValue)
    {
        if (maxValue <= 0 || value <= 0)
        {
            return "0%";
        }

        var percent = Math.Clamp((value / (double)maxValue) * 100, 4, 100);
        return $"{percent:0.##}%";
    }

    private static string Shorten(string? text, int maxLength)
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            return "Sin dato";
        }

        var value = text.Trim();
        return value.Length <= maxLength ? value : $"{value[..Math.Max(0, maxLength - 1)]}...";
    }

    private sealed record HierarchyAuthorNode(
        AuthorReportingSummaryDto Author,
        int TotalArticles,
        int PrimaryArticles,
        int CoauthorArticles,
        string TopFaculty,
        IReadOnlyList<HierarchyPublicationNode> Publications,
        IReadOnlyList<HierarchySegment> FacultySegments,
        int FilteredPublicationCount,
        int DetailPublicationCount,
        bool IsExpanded,
        bool HasMorePublications)
    {
        public bool CanTogglePublicationDetail => DetailPublicationCount > VisibleHierarchyPublicationsPerAuthor || IsExpanded;

        public bool HasOfficialTotalGap => TotalArticles > DetailPublicationCount;
    }

    private sealed record HierarchyPublicationNode(
        AuthorPublicationDto Publication,
        IReadOnlyList<HierarchyCoauthorNode> Coauthors);

    private sealed record HierarchyCoauthorNode(int AuthorKey, string AuthorName);

    private sealed record HierarchySegment(string Name, int Count, string Color);

    private sealed record AuthorAlphabetGroup(char Initial, IReadOnlyList<AuthorReportingSummaryDto> Authors);
}
