@using tesisproject.shared.DTOs.Configuration

<div class="configuration-overview mb-5">
    <div class="configuration-overview__metrics">
        <div class="configuration-overview__metric">
            <i class="bi bi-ui-checks-grid"></i>
            <div>
                <div class="configuration-overview__label">Formularios</div>
                <div class="configuration-overview__value">@FormsCount</div>
                <div class="configuration-overview__helper">@ActiveFormsCount activos</div>
            </div>
        </div>
        <div class="configuration-overview__metric">
            <i class="bi bi-input-cursor-text"></i>
            <div>
                <div class="configuration-overview__label">Campos</div>
                <div class="configuration-overview__value">@FieldsCount</div>
                <div class="configuration-overview__helper">@DynamicFieldsCount dinámicos</div>
            </div>
        </div>
        <div class="configuration-overview__metric configuration-overview__metric--warm">
            <i class="bi bi-diagram-3"></i>
            <div>
                <div class="configuration-overview__label">Asignaciones</div>
                <div class="configuration-overview__value">@SelectedFormFieldsCount</div>
                <div class="configuration-overview__helper">formulario actual</div>
            </div>
        </div>
        <div class="configuration-overview__metric configuration-overview__metric--catalog">
            <i class="bi bi-tags"></i>
            <div class="min-w-0">
                <div class="configuration-overview__label">Catálogo activo</div>
                <div class="configuration-overview__value configuration-overview__value--text">@SelectedCatalogLabel</div>
                <div class="configuration-overview__helper">@CatalogItemsCount elementos</div>
            </div>
        </div>
    </div>

    <div class="configuration-tabs">
        <div class="configuration-tabs__label">Vista de configuración</div>
        <div class="configuration-tabs__track">
            @foreach (var tab in Tabs)
            {
                <button type="button"
                        class="@GetTabButtonClass(tab.Key)"
                        @onclick="() => OnTabChange.InvokeAsync(tab.Key)">
                    <i class="@tab.Icon"></i>
                    @tab.Label
                </button>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public int FormsCount { get; set; }
    [Parameter] public int ActiveFormsCount { get; set; }
    [Parameter] public int FieldsCount { get; set; }
    [Parameter] public int DynamicFieldsCount { get; set; }
    [Parameter] public int SelectedFormFieldsCount { get; set; }
    [Parameter] public string SelectedCatalogLabel { get; set; } = string.Empty;
    [Parameter] public int CatalogItemsCount { get; set; }
    [Parameter] public string ActiveTab { get; set; } = "forms";
    [Parameter] public EventCallback<string> OnTabChange { get; set; }

    private static readonly IReadOnlyList<(string Key, string Label, string Icon)> Tabs =
    [
        ("forms", "Formularios", "bi bi-ui-checks-grid"),
        ("fields", "Campos", "bi bi-input-cursor-text"),
        ("catalogs", "Catálogos", "bi bi-tags"),
        ("options", "Opciones", "bi bi-list-check")
    ];

    private string GetTabButtonClass(string tabName)
        => ActiveTab == tabName
            ? "configuration-tabs__button configuration-tabs__button--active"
            : "configuration-tabs__button";
}
