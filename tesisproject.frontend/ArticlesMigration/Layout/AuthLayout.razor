@namespace tesisproject.frontend.Layout
@inherits LayoutComponentBase

<div class="auth-layout-shell">
    <div class="auth-layout-shell__backdrop"></div>

    <section class="auth-layout-shell__hero">
        <div class="auth-layout-shell__hero-content">
            <div class="auth-layout-shell__kicker">Universidad Técnica de Ambato</div>
            <h1 class="auth-layout-shell__title">Sistema integrado para gestión y validación de artículos científicos</h1>
            <p class="auth-layout-shell__copy">
                Acceso institucional para autores, revisores UODIDE, Área Técnica y administración del sistema.
            </p>

            <div class="auth-layout-shell__badges">
                <span>Autenticación segura</span>
                <span>Workflow multinivel</span>
                <span>Trazabilidad institucional</span>
            </div>
        </div>
    </section>

    <main class="auth-layout-shell__content">
        <div class="auth-layout-shell__content-inner">
            @Body
        </div>
    </main>
</div>
